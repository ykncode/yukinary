{
  "name": "yukinary-lang",
  "displayName": "Yukinary Language",
  "description": "Syntax highlighting, multi-lingual grammar and LSP support for Yukinary (.ykn)",
  "version": "1.0.0",
  "publisher": "yuki",
  "repository": {
    "type": "git",
    "url": "https://github.com/ykncode/yukinary"
  },
  "icon": "logo.png",
  "engines": {
    "vscode": "^1.60.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets"
  ],
  "main": "./dist/extension.js",
  "scripts": {
    "build": "npx esbuild extension.js --bundle --external:vscode --format=cjs --platform=node --outfile=dist/extension.js --minify",
    "package": "npm run build && npx @vscode/vsce package --no-dependencies"
  },
  "activationEvents": [
    "onLanguage:yukinary"
  ],
  "dependencies": {
    "vscode-languageclient": "^8.1.0"
  },
  "contributes": {
    "languages": [
      {
        "id": "yukinary",
        "aliases": [
          "Yukinary",
          "ykn"
        ],
        "extensions": [
          ".ykn"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "yukinary",
        "scopeName": "source.ykn",
        "path": "./syntaxes/ykn.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "yukinary",
        "path": "./snippets.json"
      }
    ],
    "commands": [
      {
        "command": "yukinary.run",
        "title": "Run YKN File",
        "icon": "$(play)"
      }
    ],
    "menus": {
      "editor/title/run": [
        {
          "command": "yukinary.run",
          "when": "resourceLangId == yukinary",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Yukinary",
      "properties": {
        "yukinary.lspExecutable": {
          "type": "string",
          "default": "",
          "description": "Yukinary LSP executable path (if empty, ~/.yukinary/bin/ykn.exe or workspace ykn.exe is used)"
        },
        "yukinary.lspArgs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "--lsp"
          ],
          "description": "Arguments passed to Yukinary compiler for LSP mode (default: ['--lsp'])"
        }
      }
    }
  }
}
