# ============================================================
# GOREV 6.1: Register Allocation Test
# Register-yogun fonksiyonlar — iç içe aritmetik, çok değişken
# Başarı kriteri:
#   1. Tüm hesaplamalar doğru
#   2. Binary boyutu app_full_orig_test.exe'den küçük
#   3. app.exe + out.exe ile PASS
# ============================================================

isv ekrana_yaz(m: *u8) {}
isv sayiyi_yazdir(n: tamsayi) {
    degisken buf: [32]u8; degisken i: tamsayi = 0;
    eger n == 0 ise { buf[0] = 48; buf[1] = 0; ekrana_yaz(buf); dondu; }
    eger n < 0 ise {
        buf[i] = 45; i = i + 1;
        n = 0 - n;
    }
    degisken start: tamsayi = i;
    dongu n > 0 { buf[i] = (n % 10) + 48; n = n / 10; i = i + 1; }
    buf[i] = 0;
    degisken j: tamsayi = start; degisken k: tamsayi = i - 1;
    dongu j < k {
        degisken tmp: u8 = buf[j]; buf[j] = buf[k]; buf[k] = tmp;
        j = j + 1; k = k - 1;
    }
    ekrana_yaz(buf);
}

# Cok degiskenli, ic ice aritmetik — register pressure testi
isv hesapla_cok_degisken(a: tamsayi, b: tamsayi, c: tamsayi) -> tamsayi {
    degisken x1: tamsayi = a + b;
    degisken x2: tamsayi = b * c;
    degisken x3: tamsayi = a - c;
    degisken x4: tamsayi = x1 + x2;
    degisken x5: tamsayi = x4 - x3;
    degisken x6: tamsayi = x5 * 2;
    degisken x7: tamsayi = x6 + x1;
    degisken x8: tamsayi = x7 - x2;
    dondu x8;
}

# IC ICE binary op — PUSH/POP veya R10 scratch test
isv ic_ice_aritmetik(n: tamsayi) -> tamsayi {
    degisken sonuc: tamsayi = ((n + 1) * (n - 1)) - (n * n);
    # (n+1)(n-1) = n^2 - 1 → sonuc = -1 her n icin
    dondu sonuc;
}

# Dongu + cok degisken
isv dongu_hesap(n: tamsayi) -> tamsayi {
    degisken toplam: tamsayi = 0;
    degisken i: tamsayi = 1;
    dongu i <= n {
        toplam = toplam + i;
        i = i + 1;
    }
    dondu toplam;
}

# Karmasik ifade agaci
isv karmasik_ifade(a: tamsayi, b: tamsayi) -> tamsayi {
    dondu (a + b) * (a - b) + a * b - (a + b) * (a + b) / (a + 1);
}

isv ana(arguman_sayisi: tamsayi, argumanlar: **u8) -> tamsayi {

    # Test 1: Çok değişkenli
    degisken r1: tamsayi = hesapla_cok_degisken(3, 4, 2);
    # x1=7, x2=8, x3=1, x4=15, x5=14, x6=28, x7=35, x8=27
    eger r1 == 27 ise {
        ekrana_yaz("TEST RA: cok_degisken(3,4,2)=27 OK\n".ptr);
    } yoksa {
        ekrana_yaz("TEST RA: cok_degisken FAIL got=".ptr);
        sayiyi_yazdir(r1); ekrana_yaz("\n".ptr);
        dondu 1;
    }

    # Test 2: İç içe aritmetik (her n için -1 vermeli)
    degisken r2: tamsayi = ic_ice_aritmetik(5);
    eger r2 == 0 - 1 ise {
        ekrana_yaz("TEST RA: ic_ice(5)=-1 OK\n".ptr);
    } yoksa {
        ekrana_yaz("TEST RA: ic_ice FAIL got=".ptr);
        sayiyi_yazdir(r2); ekrana_yaz("\n".ptr);
        dondu 1;
    }

    # Test 3: Döngü hesabı (1+2+...+10 = 55)
    degisken r3: tamsayi = dongu_hesap(10);
    eger r3 == 55 ise {
        ekrana_yaz("TEST RA: dongu_hesap(10)=55 OK\n".ptr);
    } yoksa {
        ekrana_yaz("TEST RA: dongu FAIL got=".ptr);
        sayiyi_yazdir(r3); ekrana_yaz("\n".ptr);
        dondu 1;
    }

    # Test 4: Karmaşık ifade
    degisken r4: tamsayi = karmasik_ifade(4, 2);
    # (4+2)*(4-2) + 4*2 - (4+2)*(4+2)/(4+1)
    # = 6*2 + 8 - 36/5
    # = 12 + 8 - 7 = 13 (tamsayi bolme)
    eger r4 == 13 ise {
        ekrana_yaz("TEST RA: karmasik(4,2)=13 OK\n".ptr);
    } yoksa {
        ekrana_yaz("TEST RA: karmasik FAIL got=".ptr);
        sayiyi_yazdir(r4); ekrana_yaz("\n".ptr);
        dondu 1;
    }

    # Test 5: Çok sayıda değişken — stack frame yeterlilik
    degisken v1: tamsayi = 1; degisken v2: tamsayi = 2; degisken v3: tamsayi = 3;
    degisken v4: tamsayi = 4; degisken v5: tamsayi = 5; degisken v6: tamsayi = 6;
    degisken v7: tamsayi = 7; degisken v8: tamsayi = 8; degisken v9: tamsayi = 9;
    degisken v10: tamsayi = 10;
    degisken sum: tamsayi = v1+v2+v3+v4+v5+v6+v7+v8+v9+v10;
    eger sum == 55 ise {
        ekrana_yaz("TEST RA: 10 degisken toplam=55 OK\n".ptr);
    } yoksa {
        ekrana_yaz("TEST RA: 10 degisken FAIL got=".ptr);
        sayiyi_yazdir(sum); ekrana_yaz("\n".ptr);
        dondu 1;
    }

    ekrana_yaz("REGALLOC-PASS\n".ptr);
    dondu 0;
}
