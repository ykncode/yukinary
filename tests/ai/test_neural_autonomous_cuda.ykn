# ============================================================
# tests/ai/test_neural_autonomous_cuda.ykn
# FAZ 3: Gercek Noral Otonom Yetenekler Test Paketi (CUDA / RTX 3060)
# Mock ve sahte cevaplar tamamen sifirlanmis, 1.18 GB BitNet b1.58-2B-4T
# modeli uzerinde gercek forward pass ve token uretimi ile calisir.
#
# 3 Temel Otonom Yetenek:
#   1. Noral Kod Sentezi (#prompt)
#   2. Otonom Kod Onarimi (Self-Healing / Code Repair)
#   3. Polyglot Kod Cevirisi ve Teshis (Python -> Yukinary)
# ============================================================

ice_aktar "std/ai/gguf_types.ykn";
ice_aktar "std/ai/gguf_reader.ykn";
ice_aktar "std/ai/gguf_loader.ykn";
ice_aktar "std/ai/runtime.ykn";
ice_aktar "std/ai/model_loader.ykn";
ice_aktar "std/ai/iq2s_grid.ykn";
ice_aktar "std/ai/bitnet_iq2s.ykn";
ice_aktar "std/ai/bitnet_backend.ykn";
ice_aktar "std/ai/architecture_adapter.ykn";
ice_aktar "std/ai/attention.ykn";
ice_aktar "std/ai/sampler.ykn";
ice_aktar "std/ai/inference.ykn";
ice_aktar "std/ai/tokenizer.ykn";
ice_aktar "std/ai/transformer_forward.ykn";

harici isv bellek_tahsis_et(boyut: tamsayi) -> *u8;
harici isv ekrana_yaz(mesaj: *u8);

isv sayi_yaz(sayi: tamsayi) {
    eger sayi == 0 { ekrana_yaz("0".ptr); dondu; }
    degisken n: tamsayi = sayi;
    degisken rakamlar: [32]u8;
    degisken adet: tamsayi = 0;
    eger n < 0 { ekrana_yaz("-".ptr); n = 0 - n; }
    dongu n > 0 {
        rakamlar[adet] = 48 + (n % 10);
        adet = adet + 1;
        n = n / 10;
    }
    dongu adet > 0 {
        adet = adet - 1;
        degisken ch: [2]u8;
        ch[0] = rakamlar[adet]; ch[1] = 0;
        ekrana_yaz(ch);
    }
}

degisken G_DURUM_PTR: *GGUFDurum = 0;
degisken G_TOKEN_OFFSETS: *tamsayi = 0;
degisken G_TOKEN_LENGTHS: *tamsayi = 0;
degisken G_MERGE_OFFSETS: *tamsayi = 0;
degisken G_MERGE_LENGTHS: *tamsayi = 0;
degisken G_TOKEN_COUNT: tamsayi = 0;
degisken G_MERGE_COUNT: tamsayi = 0;
degisken G_SPEC: LLMModelSpec;
degisken G_LOADER: LLMModelLoader;
degisken G_ADAPTER: LLMArchitectureAdapter;
degisken G_ICRA: LLMTransformerExecution;

isv noral_gorev_calistir(gorev_no: tamsayi, gorev_adi: *u8, prompt_text: *u8, max_token: tamsayi) {
    ekrana_yaz("======================================================\n".ptr);
    ekrana_yaz("[GOREV ".ptr); sayi_yaz(gorev_no); ekrana_yaz("] ".ptr); ekrana_yaz(gorev_adi); ekrana_yaz("\n".ptr);
    ekrana_yaz("[GIRDI PROMPT]:\n\"".ptr); ekrana_yaz(prompt_text); ekrana_yaz("\"\n\n".ptr);

    degisken prompt_ids: [128]tamsayi;
    degisken prompt_length: tamsayi = 0;
    dongu prompt_text[prompt_length] != 0 { prompt_length = prompt_length + 1; }

    degisken prompt_count: tamsayi = bitnet_bpe_ascii_kodla(
        G_DURUM_PTR->buffer, G_TOKEN_OFFSETS, G_TOKEN_LENGTHS, G_TOKEN_COUNT,
        G_MERGE_OFFSETS, G_MERGE_LENGTHS, G_MERGE_COUNT, prompt_text, prompt_length,
        prompt_ids, 128);

    degisken full_prompt: [132]tamsayi;
    full_prompt[0] = G_SPEC.bos_token_id;
    degisken prompt_copy: tamsayi = 0;
    dongu prompt_copy < prompt_count {
        full_prompt[prompt_copy + 1] = prompt_ids[prompt_copy];
        prompt_copy = prompt_copy + 1;
    }
    full_prompt[prompt_count + 1] = G_SPEC.eos_token_id;

    # Her gorev icin sequence sifirlanir
    G_ICRA.token_konumu = 0;

    degisken generated_tokens: [128]tamsayi;
    degisken generation_request: LLMGreedyGenerationRequest;
    generation_request.icra = &G_ICRA;
    generation_request.durum = G_DURUM_PTR;
    generation_request.prompt_tokenleri = full_prompt;
    generation_request.prompt_adedi = prompt_count + 2;
    generation_request.uretilen_tokenler = generated_tokens;
    generation_request.uretilen_kapasitesi = 128;
    generation_request.max_yeni_token = max_token;

    LLM_REPETITION_PENALTY_Q16 = 75366; # 1.15x
    degisken t_gen_start: tamsayi = ykn_llm_clock_ns();
    degisken generated_count: tamsayi = llm_transformer_greedy_generate(&generation_request);
    degisken t_gen_end: tamsayi = ykn_llm_clock_ns();

    eger generated_count <= 0 {
        ekrana_yaz("HATA: Token uretim hatasi kod=".ptr);
        sayi_yaz(generated_count);
        ekrana_yaz("\n".ptr);
        dondu;
    }

    ekrana_yaz("[NORAL CIKTI (NVIDIA GeForce RTX 3060 CUDA - Orijinal BitNet)]:\n------------------------------------------------------\n".ptr);
    degisken generated_text: [8192]u8;
    degisken generated_text_len: tamsayi = 0;
    degisken token_i: tamsayi = 0;
    dongu token_i < generated_count {
        degisken piece_raw: [256]u8;
        degisken piece_raw_len: tamsayi = bitnet_token_kopyala(
            G_DURUM_PTR->buffer, G_TOKEN_OFFSETS, G_TOKEN_LENGTHS, G_TOKEN_COUNT,
            generated_tokens[token_i], piece_raw, 256);
        degisken piece_decoded: [256]u8;
        degisken piece_len: tamsayi = bitnet_gpt2_byte_decode(
            piece_raw, piece_raw_len, piece_decoded, 256);
        eger piece_raw_len > 0 ve piece_len >= 0 ve generated_text_len + piece_len < 8192 {
            degisken piece_i: tamsayi = 0;
            dongu piece_i < piece_len {
                generated_text[generated_text_len] = piece_decoded[piece_i];
                generated_text_len = generated_text_len + 1;
                piece_i = piece_i + 1;
            }
        }
        token_i = token_i + 1;
    }
    generated_text[generated_text_len] = 0;
    ekrana_yaz(generated_text.ptr);
    ekrana_yaz("\n------------------------------------------------------\n".ptr);

    degisken sure_ms: tamsayi = (t_gen_end - t_gen_start) / 1000000;
    degisken hiz_tok_s: tamsayi = 0;
    eger t_gen_end > t_gen_start {
        hiz_tok_s = (generated_count * 1000000000) / (t_gen_end - t_gen_start);
    }
    ekrana_yaz("[TELEMETRI]: Uretilen: ".ptr); sayi_yaz(generated_count);
    ekrana_yaz(" token | Sure: ".ptr); sayi_yaz(sure_ms);
    ekrana_yaz(" ms | Hiz: ".ptr); sayi_yaz(hiz_tok_s);
    ekrana_yaz(" tok/s\n\n".ptr);
}

isv ana(arguman_sayisi: tamsayi, argumanlar: **u8) -> tamsayi {
    ekrana_yaz("=== GERCEK NORAL OTONOM YETENEKLER - CUDA / RTX 3060 TESTI ===\n".ptr);
    ekrana_yaz("[DURUM] Mock veriler tamamen iptal, 1.18 GB BitNet b1.58-2B-4T calistiriliyor...\n\n".ptr);

    degisken model_yolu: *u8 = "models/bitnet-b1.58-2B-4T/ggml-model-i2_s.gguf".ptr;
    G_DURUM_PTR = bellek_tahsis_et(1024);
    eger G_DURUM_PTR == 0 { ekrana_yaz("HATA: Bellek tahsis edilemedi\n".ptr); dondu 1; }
    eger gguf_yukle(model_yolu, G_DURUM_PTR) == 0 {
        ekrana_yaz("HATA: GGUF yuklenemedi\n".ptr); dondu 2;
    }

    G_TOKEN_OFFSETS = bellek_tahsis_et(128256 * 8);
    G_TOKEN_LENGTHS = bellek_tahsis_et(128256 * 8);
    G_MERGE_OFFSETS = bellek_tahsis_et(280147 * 8);
    G_MERGE_LENGTHS = bellek_tahsis_et(280147 * 8);
    eger bitnet_tokenizer_metadata_yukle(G_DURUM_PTR, G_TOKEN_OFFSETS, G_TOKEN_LENGTHS, 128256,
           G_MERGE_OFFSETS, G_MERGE_LENGTHS, 280147, &G_TOKEN_COUNT, &G_MERGE_COUNT) == 0 {
        ekrana_yaz("HATA: Tokenizer metadata okunamadi\n".ptr); dondu 3;
    }

    llm_runtime_spec_sifirla(&G_SPEC);
    G_SPEC.model_adi = G_DURUM_PTR->mimari_adi;
    G_SPEC.mimari = LLM_MIMARI_BITNET;
    G_SPEC.quant_tipi = G_DURUM_PTR->quant_tipi;
    G_SPEC.vocab_boyutu = G_DURUM_PTR->vocab_boyutu;
    G_SPEC.gizli_boyut = G_DURUM_PTR->gizli_boyut;
    G_SPEC.katman_sayisi = G_DURUM_PTR->katman_sayisi;
    G_SPEC.context_boyutu = G_DURUM_PTR->context_boyutu;
    G_SPEC.kafa_sayisi = G_DURUM_PTR->kafa_sayisi;
    G_SPEC.kv_kafa_sayisi = G_DURUM_PTR->kv_kafa_sayisi;
    G_SPEC.kafa_boyutu = G_DURUM_PTR->kafa_boyutu;
    G_SPEC.ffn_boyutu = G_DURUM_PTR->ffn_boyutu;
    G_SPEC.rope_boyutu = G_DURUM_PTR->rope_boyutu;
    G_SPEC.rope_freq_base_q16 = G_DURUM_PTR->rope_freq_base_q16;
    G_SPEC.norm_eps_q16 = G_DURUM_PTR->norm_eps_q16;
    G_SPEC.bos_token_id = G_DURUM_PTR->bos_token_id;
    G_SPEC.eos_token_id = G_DURUM_PTR->eos_token_id;

    eger llm_model_loader_baslat(&G_LOADER, model_yolu, G_DURUM_PTR) == 0 {
        ekrana_yaz("HATA: Model loader baslatilamadi\n".ptr); dondu 4;
    }
    eger llm_architecture_adapter_kur(G_SPEC.mimari, &G_ADAPTER) == 0 {
        ekrana_yaz("HATA: Architecture adapter baslatilamadi\n".ptr); dondu 5;
    }

    degisken cache_capacity: tamsayi = 160;
    degisken hidden_bytes: tamsayi = G_SPEC.gizli_boyut * 8;
    degisken kv_width: tamsayi = G_SPEC.kv_kafa_sayisi * G_SPEC.kafa_boyutu;
    degisken kv_bytes: tamsayi = cache_capacity * G_SPEC.katman_sayisi * kv_width * 8;
    degisken max_weight_bytes: tamsayi = 8388608;
    degisken logits_bytes: tamsayi = G_SPEC.vocab_boyutu * 8;

    degisken hidden: *tamsayi = bellek_tahsis_et(hidden_bytes);
    degisken residual: *tamsayi = bellek_tahsis_et(hidden_bytes);
    degisken q: *tamsayi = bellek_tahsis_et(hidden_bytes + kv_width * 16);
    degisken key: *tamsayi = q + hidden_bytes;
    degisken value: *tamsayi = key + kv_width * 8;
    degisken attention: *tamsayi = bellek_tahsis_et(hidden_bytes);
    degisken ffn: *tamsayi = bellek_tahsis_et(G_SPEC.ffn_boyutu * 8);
    degisken logits: *tamsayi = bellek_tahsis_et(logits_bytes);
    degisken weights: *u8 = bellek_tahsis_et(max_weight_bytes);
    degisken key_cache: *tamsayi = bellek_tahsis_et(kv_bytes);
    degisken value_cache: *tamsayi = bellek_tahsis_et(kv_bytes);

    degisken paket: LLMTransformerExecution;
    paket.loader = &G_LOADER;
    paket.adapter = &G_ADAPTER;
    paket.spec = &G_SPEC;
    paket.hidden = hidden;
    paket.residual = residual;
    paket.q = q;
    paket.key = key;
    paket.value = value;
    paket.attention = attention;
    paket.ffn = ffn;
    paket.logits = logits;
    paket.logits_kapasitesi = G_SPEC.vocab_boyutu;
    paket.logits_aktif = 1;
    paket.agirlik_buffer = weights;
    paket.agirlik_kapasitesi = max_weight_bytes;
    paket.kv_anahtar = key_cache;
    paket.kv_deger = value_cache;
    paket.kafa_sayisi = G_SPEC.kafa_sayisi;
    paket.kv_kafa_sayisi = G_SPEC.kv_kafa_sayisi;
    paket.kv_kafa_boyutu = G_SPEC.kafa_boyutu;
    paket.kv_kapasitesi = cache_capacity;
    paket.token_konumu = 0;
    paket.ffn_boyutu = G_SPEC.ffn_boyutu;

    eger llm_transformer_durum_kur_paketli(&G_ICRA, &paket) == 0 {
        ekrana_yaz("HATA: Transformer durumu kurulamadi\n".ptr); dondu 6;
    }

    eger ykn_cuda_backend_start() == 0 {
        ekrana_yaz("HATA: CUDA backend baslatilamadi\n".ptr); dondu 6;
    }
    ekrana_yaz("[CUDA] Backend basariyla aktif edildi.\n".ptr);

    degisken dev_name: [256]u8;
    degisken dev_mem: tamsayi = 0;
    cuda_device_query(YKN_CUDA_CONTEXT_PTR, 0, dev_name, &dev_mem);
    ekrana_yaz("[CUDA CIHAZI] Model: ".ptr); ekrana_yaz(dev_name.ptr);
    ekrana_yaz(" | Toplam VRAM: ".ptr); sayi_yaz(dev_mem / 1048576); ekrana_yaz(" MB\n\n".ptr);

    # GÖREV 1: Nöral Kod Sentezi (#prompt)
    noral_gorev_calistir(
        1,
        "Noral Kod Sentezi (#prompt - Fonksiyon Uretimi)".ptr,
        "Human: Write a function to add two numbers in Yukinary:\nisv topla(a: tamsayi, b: tamsayi) -> tamsayi {\n\nBITNETAssistant: ".ptr,
        50
    );

    # GÖREV 2: Nöral Otonom Kod Onarımı (Self-Healing / Kod Tamiri)
    noral_gorev_calistir(
        2,
        "Noral Otonom Kod Onarimi (Self-Healing - Eksik Donus Tamiri)".ptr,
        "Human: Fix this broken code that has a syntax error:\nisv topla(a: tamsayi, b: tamsayi) { dondu a + b }\nCorrected code:\n\nBITNETAssistant: ".ptr,
        50
    );

    # GÖREV 3: Polyglot Kod Çevirisi & Uyarı (Python -> Yukinary Transpiler)
    noral_gorev_calistir(
        3,
        "Polyglot Kod Cevirisi (Python -> Yukinary Transpilation)".ptr,
        "Human: Convert this Python code to Yukinary:\ndef carp(x, y):\n    return x * y\n\nBITNETAssistant: ".ptr,
        50
    );

    ekrana_yaz("======================================================\n".ptr);
    ekrana_yaz("[CUDA STATS] Toplam Kernel: ".ptr); sayi_yaz(TRANSFORMER_CUDA_KERNEL_CALLS);
    ekrana_yaz(" | CPU Fallback: ".ptr); sayi_yaz(TRANSFORMER_CUDA_FALLBACKS);
    ekrana_yaz(" | I2S: ".ptr); sayi_yaz(YKN_CUDA_I2S_CALLS);
    ekrana_yaz(" | F16: ".ptr); sayi_yaz(YKN_CUDA_F16_CALLS);
    ekrana_yaz(" | Q1: ".ptr); sayi_yaz(YKN_CUDA_Q1_CALLS);
    ekrana_yaz(" | Cached: ".ptr); sayi_yaz(YKN_CUDA_IQ2S_WEIGHT_CACHE_COUNT);
    ekrana_yaz("\n=== TUM NORAL OTONOM YETENEKLER CUDA TESTI BASARIYLA TAMAMLANDI ===\n".ptr);

    ykn_cuda_backend_stop();
    dondu 0;
}
