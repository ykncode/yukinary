# Real BitNet chat-template BPE acceptance against the bundled GGUF vocab.
ice_aktar "std/ai/gguf_types.ykn";
ice_aktar "std/ai/gguf_reader.ykn";
ice_aktar "std/ai/gguf_loader.ykn";
ice_aktar "std/ai/tokenizer.ykn";

harici isv bellek_tahsis_et(boyut: tamsayi) -> *u8;
harici isv ekrana_yaz(mesaj: *u8);

isv sayi_yaz(sayi: tamsayi) {
    eger sayi == 0 { ekrana_yaz("0".ptr); dondu; }
    degisken n: tamsayi = sayi;
    eger n < 0 { ekrana_yaz("-".ptr); n = 0 - n; }
    degisken rakam: [32]u8;
    degisken adet: tamsayi = 0;
    dongu n > 0 { rakam[adet] = 48 + n % 10; adet = adet + 1; n = n / 10; }
    dongu adet > 0 { adet = adet - 1; degisken ch: [2]u8; ch[0] = rakam[adet]; ch[1] = 0; ekrana_yaz(ch); }
}

isv ana(argc: tamsayi, argv: **u8) -> tamsayi {
    degisken model_yolu: *u8 = "models/bitnet-b1.58-2B-4T/ggml-model-i2_s.gguf".ptr;
    degisken durum: *GGUFDurum = bellek_tahsis_et(1024);
    eger durum == 0 veya gguf_yukle(model_yolu, durum) == 0 {
        ekrana_yaz("BITNET_CHAT_TOKENIZER_FAIL GGUF\n".ptr); dondu 1;
    }
    eger durum->chat_sablon_tipi != 1 veya durum->tokenizer_add_bos != 1 {
        ekrana_yaz("BITNET_CHAT_TOKENIZER_FAIL TEMPLATE_METADATA\n".ptr); dondu 2;
    }
    degisken token_offsets: *tamsayi = bellek_tahsis_et(128256 * 8);
    degisken token_lengths: *tamsayi = bellek_tahsis_et(128256 * 8);
    degisken merge_offsets: *tamsayi = bellek_tahsis_et(280147 * 8);
    degisken merge_lengths: *tamsayi = bellek_tahsis_et(280147 * 8);
    degisken token_count: tamsayi = 0;
    degisken merge_count: tamsayi = 0;
    eger token_offsets == 0 veya token_lengths == 0 or merge_offsets == 0 or merge_lengths == 0 or
       bitnet_tokenizer_metadata_yukle(durum, token_offsets, token_lengths, 128256,
           merge_offsets, merge_lengths, 280147, &token_count, &merge_count) == 0 {
        ekrana_yaz("BITNET_CHAT_TOKENIZER_FAIL VOCAB\n".ptr); dondu 3;
    }
    degisken prompt: *u8 = "Human: Tell me a short crepe recipe.\n\nBITNETAssistant: ".ptr;
    degisken prompt_length: tamsayi = 0;
    dongu prompt[prompt_length] != 0 { prompt_length = prompt_length + 1; }
    degisken actual: [64]tamsayi;
    degisken count: tamsayi = bitnet_bpe_ascii_kodla(durum->buffer,
        token_offsets, token_lengths, token_count, merge_offsets, merge_lengths,
        merge_count, prompt, prompt_length, actual, 64);
    ekrana_yaz("ACTUAL_COUNT=".ptr); sayi_yaz(count); ekrana_yaz(" IDS=".ptr);
    degisken show_i: tamsayi = 0;
    dongu show_i < count { sayi_yaz(actual[show_i]); ekrana_yaz(" ".ptr); show_i = show_i + 1; }
    ekrana_yaz("\\n".ptr);
    degisken expected: [17]tamsayi;
    expected[0] = 35075; expected[1] = 25;
    expected[2] = 25672; expected[3] = 757;
    expected[4] = 264; expected[5] = 2875;
    expected[6] = 1922; expected[7] = 375;
    expected[8] = 11363; expected[9] = 13;
    expected[10] = 198; expected[11] = 198;
    expected[12] = 21587; expected[13] = 15734;
    expected[14] = 72803; expected[15] = 25;
    expected[16] = 220;
    eger count != 17 {
        ekrana_yaz("BITNET_CHAT_TOKENIZER_FAIL COUNT\n".ptr); dondu count;
    }
    degisken i: tamsayi = 0;
    dongu i < count {
        eger actual[i] != expected[i] {
            ekrana_yaz("BITNET_CHAT_TOKENIZER_FAIL TOKEN_ID\n".ptr); dondu 5;
        }
        i = i + 1;
    }
    ekrana_yaz("BITNET_CHAT_TOKENIZER_PASS 17_IDS_MATCH_REFERENCE\n".ptr);
    dondu 0;
}
