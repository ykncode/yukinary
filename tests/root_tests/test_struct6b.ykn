yapi Kucuk {
    f0: tamsayi;
    f1: tamsayi;
    f2: tamsayi;
    f3: tamsayi;
    f4: tamsayi;
    f5: tamsayi;
}

isv doldur(s: *Kucuk) {
    s.f0 = 10;
    s.f1 = 20;
    s.f2 = 30;
    s.f3 = 40;
    s.f4 = 50;
    s.f5 = 6;
}

isv topla(s: *Kucuk) -> tamsayi {
    dondu s.f0 + s.f1 + s.f2 + s.f3 + s.f4 + s.f5;
}

isv ana() -> tamsayi {
    degisken st: Kucuk;
    doldur(&st);
    dondu topla(&st);
}
