# Generated PE -> native F16 lm-head dot kernel fixture
harici isv ykn_llm_f16_dot_q16(packed: *u8, activation: *tamsayi, k: tamsayi) -> tamsayi;

isv ana(arguman_sayisi: tamsayi, argumanlar: **u8) -> tamsayi {
    degisken packed: [8]u8;
    degisken activation: [4]tamsayi;
    # F16 values: 1.0, -2.0, 0.5, -0.25.
    packed[0] = 0; packed[1] = 60;
    packed[2] = 0; packed[3] = 192;
    packed[4] = 0; packed[5] = 56;
    packed[6] = 0; packed[7] = 180;
    activation[0] = 65536;
    activation[1] = 65536;
    activation[2] = 131072;
    activation[3] = 262144;
    # 1 - 2 + (0.5*2) - (0.25*4) = -1, in Q16 = -65536.
    degisken result: tamsayi = ykn_llm_f16_dot_q16(packed, activation, 4);
    eger result == 0 - 65536 ise { ekrana_yaz("F16-PE-PASS".ptr); }
    yoksa { ekrana_yaz("F16-PE-FAIL".ptr); }
    dondu result;
}
