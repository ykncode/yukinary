# ============================================================
# Faz 8.3 — Gerçek model tensor payload testi
# token_embd.weight GGUF type=F16 payload'i metadata penceresinden okunur.
# ============================================================


ice_aktar "../../std/ai/gguf_types.ykn";
ice_aktar "../../std/ai/gguf_reader.ykn";
ice_aktar "../../std/ai/gguf_loader.ykn";

isv ana(arguman_sayisi: tamsayi, argumanlar: **u8) -> tamsayi {
    degisken durum: *GGUFDurum = bellek_tahsis_et(1024);
    degisken yol: *u8 = "models/bitnet-b1.58-2B-4T/ggml-model-i2_s.gguf".ptr;
    eger gguf_yukle(yol, durum) == 0 ise {
        ekrana_yaz("TEST 06 FAZ 8: FAILED (GGUF parse)\n".ptr);
        dondu 1;
    }

    degisken isim: *u8 = "token_embd.weight".ptr;
    degisken tensor: *GGUFTensorInfo = gguf_tensor_bul_adi_ile(durum, isim);
    eger tensor == 0 veya tensor->ggml_type != GGML_TYPE_F16 veya
       tensor->bayt_sayisi != 656670720 veya
       tensor->veri_offset != durum->ilk_veri_offset ise {
        ekrana_yaz("TEST 06 FAZ 8: FAILED (F16 tensor metadata)\n".ptr);
        dondu 2;
    }

    degisken veri: *u8 = durum->buffer + tensor->veri_offset;
    # Resmi dosyanin ilk F16 embedding payload byte'lari.
    eger veri[0] != 79 veya veri[1] != 183 veya veri[2] != 61 veya veri[3] != 59 ise {
        ekrana_yaz("TEST 06 FAZ 8: FAILED (payload bytes)\n".ptr);
        dondu 3;
    }

    ekrana_yaz("TEST 06 FAZ 8: GERCEK TENSOR PAYLOAD OK\n".ptr);
    dondu 0;
}
