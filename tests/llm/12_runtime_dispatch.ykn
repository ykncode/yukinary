# LLM runtime dispatch: BitNet, BitNet+MoE ve architecture adapter sözleşmesi.
ice_aktar "../../std/ai/runtime.ykn";

isv ana() -> tamsayi {
    degisken bitnet_moe: *u8 = "models/bitnet-b1.58-moe.gguf".ptr;
    degisken bitnet: *u8 = "models/bitnet-b1.58.gguf".ptr;
    degisken llama: *u8 = "models/llama-3.gguf".ptr;
    eger llm_runtime_mimari_bul(bitnet_moe, 28) != LLM_MIMARI_BITNET_MOE ise { dondu 1; }
    eger llm_runtime_backend_bul(LLM_MIMARI_BITNET_MOE) != LLM_BACKEND_BITNET_MOE_NATIVE ise { dondu 2; }
    eger llm_runtime_mimari_bul(bitnet, 24) != LLM_MIMARI_BITNET ise { dondu 3; }
    eger llm_runtime_backend_bul(LLM_MIMARI_LLAMA) != LLM_BACKEND_ARCH_ADAPTER ise { dondu 4; }
    eger llm_runtime_mimari_bul(llama, 19) != LLM_MIMARI_LLAMA ise { dondu 5; }

    degisken skorlar: [4]tamsayi;
    skorlar[0] = 10;
    skorlar[1] = 30;
    skorlar[2] = 20;
    skorlar[3] = 30;
    degisken secilen: [2]tamsayi;
    degisken adet: tamsayi = llm_runtime_moe_topk(skorlar, 4, 2, secilen);
    # Eşit skor deterministik olarak düşük index'i seçer: 1 sonra 3.
    eger adet != 2 veya secilen[0] != 1 veya secilen[1] != 3 ise { dondu 6; }

    ekrana_yaz("LLM-RUNTIME-DISPATCH-PASS\n".ptr);
    dondu 0;
}
