ice_aktar "std/koleksiyon.ykn"

isv test_nongeneric(d: tamsayi) -> tamsayi {
    dondu d;
}

isv ana() -> tamsayi {
    ekrana_yaz("merhaba\n".ptr);
    degisken d: *Dizi<tamsayi> = dizi_olustur<tamsayi>();
    degisken ptr_d: tamsayi = d;
    degisken ret: tamsayi = test_nongeneric(ptr_d);
    dondu ret;
}
