# ============================================================
# tests/stdlib/11_her_iterator.ykn
# Range (Aralik), VecIterator ve Enumerate (Sayarak) Testi
# ============================================================
ice_aktar "../../std/enum.ykn";
ice_aktar "../../std/collection/vec.ykn";
ice_aktar "../../std/iterator.ykn";

isv ana() -> tamsayi {
    # --------------------------------------------------------
    # 1. Aralik (Range: 0..10, adim=2) -> 0, 2, 4, 6, 8 (toplam=20)
    # --------------------------------------------------------
    degisken rng: *Aralik = aralik_olustur(0, 10, 2);
    degisken toplam_range: tamsayi = 0;
    degisken eleman_sayisi: tamsayi = 0;

    degisken rng_devam: tamsayi = aralik_var_mi(rng);
    degisken sec: *Secenek = 0;
    degisken svm: tamsayi = 0;
    degisken dval: tamsayi = 0;
    dongu rng_devam == 1 {
        sec = aralik_sonraki(rng);
        svm = secenek_var_mi(sec);
        eger svm == 1 ise {
            dval = secenek_deger_al(sec, 0);
            toplam_range = toplam_range + dval;
            eleman_sayisi = eleman_sayisi + 1;
        }
        rng_devam = aralik_var_mi(rng);
    }

    eger toplam_range != 20 ise {
        ekrana_yaz("FAIL: range toplami 20 olmali\n".ptr);
        dondu 1;
    }
    eger eleman_sayisi != 5 ise {
        ekrana_yaz("FAIL: range eleman sayisi 5 olmali\n".ptr);
        dondu 1;
    }

    # --------------------------------------------------------
    # 2. VecIterator ([10, 20, 30, 40] -> toplam=100)
    # --------------------------------------------------------
    degisken v: *Vec = vec_tamsayi_olustur();
    vec_push_tamsayi(v, 10);
    vec_push_tamsayi(v, 20);
    vec_push_tamsayi(v, 30);
    vec_push_tamsayi(v, 40);

    degisken it: *VecIterator = vec_iterator_olustur(v);
    degisken toplam_vec: tamsayi = 0;

    degisken vec_devam: tamsayi = vec_iterator_var_mi(it);
    dongu vec_devam == 1 {
        degisken val_sec: *Secenek = vec_iterator_sonraki(it);
        degisken vval: tamsayi = secenek_deger_al(val_sec, 0);
        toplam_vec = toplam_vec + vval;
        vec_devam = vec_iterator_var_mi(it);
    }

    eger toplam_vec != 100 ise {
        ekrana_yaz("FAIL: vec toplami 100 olmali\n".ptr);
        dondu 1;
    }

    # --------------------------------------------------------
    # 3. SayarakIterator (Enumerate: idx + val)
    # --------------------------------------------------------
    degisken sayarak: *SayarakIterator = sayarak_iterator_olustur(v);
    degisken out_idx: [1]tamsayi;
    degisken out_val: [1]tamsayi;
    degisken beklenen_idx: tamsayi = 0;

    degisken say_devam: tamsayi = sayarak_iterator_sonraki(sayarak, out_idx, out_val);
    dongu say_devam == 1 {
        eger out_idx[0] != beklenen_idx ise {
            ekrana_yaz("FAIL: enumerate index uyumsuz\n".ptr);
            dondu 1;
        }
        beklenen_idx = beklenen_idx + 1;
        say_devam = sayarak_iterator_sonraki(sayarak, out_idx, out_val);
    }

    eger beklenen_idx != 4 ise {
        ekrana_yaz("FAIL: enumerate 4 eleman gezmeliydi\n".ptr);
        dondu 1;
    }

    ekrana_yaz("HER-ITERATOR-PASS\n".ptr);
    dondu 0;
}
