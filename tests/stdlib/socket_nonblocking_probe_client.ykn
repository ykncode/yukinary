# Gerçek native nonblocking probe: boş bağlantıda recv beklemeden dönmeli.
ice_aktar "../../std/ag/soket.ykn";

isv ana(arguman_sayisi: tamsayi, argumanlar: **u8) -> tamsayi {
    degisken soket: tamsayi = istemci_olustur(ipv4_adres(127, 0, 0, 1), 18085, 1000);
    eger soket < 0 ise { dondu 86; }
    eger soket_engelsiz(soket) != 0 ise { soket_kapat(soket); dondu 87; }
    degisken tampon: [8]u8;
    degisken okunan: tamsayi = soket_al(soket, tampon, 8);
    soket_kapat(soket);
    eger okunan < 0 ise { dondu 0; }
    dondu 88;
}
