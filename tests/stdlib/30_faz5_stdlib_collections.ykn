# ============================================================
# FAZ 5: Stdlib ve Koleksiyonlar Doğrulama Testi
# F5.1: Dizi<T>, Vec, HashMap (rehash, collision)
# F5.2: UTF-8 codepoint decoding, validation, safe slicing
# ============================================================
isv ekrana_yaz(m: *u8) {}
harici isv bellek_tahsis_et(n: tamsayi) -> *u8;

ice_aktar "../../std/koleksiyon.ykn";
ice_aktar "../../std/collection/hashmap.ykn";
ice_aktar "../../std/collection/vec.ykn";
ice_aktar "../../std/metin.ykn";

isv ana() -> tamsayi {
    # --------------------------------------------------------
    # 1. Dizi<T> Testi (Dinamik Buyume ve Indeksleme)
    # --------------------------------------------------------
    degisken d: *Dizi<tamsayi> = dizi_olustur<tamsayi>();
    eger d == 0 ise {
        ekrana_yaz("FAIL: dizi_olustur\n".ptr);
        dondu 1;
    }

    # Baslangic kapasitesi 8'dir. 20 eleman ekleyerek 2x buyumeyi test et
    degisken i: tamsayi = 0;
    dongu i < 20 {
        dizi_ekle<tamsayi>(d, (i + 1) * 10);
        i = i + 1;
    }

    eger dizi_uzunluk<tamsayi>(d) != 20 ise {
        ekrana_yaz("FAIL: dizi_uzunluk != 20\n".ptr);
        dondu 1;
    }

    eger dizi_al<tamsayi>(d, 0) != 10 ise {
        ekrana_yaz("FAIL: dizi_al(0) != 10\n".ptr);
        dondu 1;
    }
    eger dizi_al<tamsayi>(d, 19) != 200 ise {
        ekrana_yaz("FAIL: dizi_al(19) != 200\n".ptr);
        dondu 1;
    }

    # Eleman sil (indeks 5)
    dizi_sil<tamsayi>(d, 5);
    eger dizi_uzunluk<tamsayi>(d) != 19 ise {
        ekrana_yaz("FAIL: silme sonrasi uzunluk\n".ptr);
        dondu 1;
    }

    dizi_serbest_birak<tamsayi>(d);

    # --------------------------------------------------------
    # 2. HashMap Testi (Cakisma ve Rehash Garantisi)
    # --------------------------------------------------------
    degisken hm: *HashMap = hashmap_olustur(16);
    eger hm == 0 ise {
        ekrana_yaz("FAIL: hashmap_olustur\n".ptr);
        dondu 1;
    }

    hashmap_ekle(hm, "elma".ptr, 100);
    hashmap_ekle(hm, "armut".ptr, 200);
    hashmap_ekle(hm, "muz".ptr, 300);
    hashmap_ekle(hm, "cilek".ptr, 400);

    eger hashmap_al(hm, "elma".ptr) != 100 ise {
        ekrana_yaz("FAIL: hashmap_al elma\n".ptr);
        dondu 1;
    }
    eger hashmap_al(hm, "muz".ptr) != 300 ise {
        ekrana_yaz("FAIL: hashmap_al muz\n".ptr);
        dondu 1;
    }

    # Rehash tetikleme: %75 kapasiteyi asacak kadar eleman ekle
    hashmap_ekle(hm, "k1".ptr, 1);
    hashmap_ekle(hm, "k2".ptr, 2);
    hashmap_ekle(hm, "k3".ptr, 3);
    hashmap_ekle(hm, "k4".ptr, 4);
    hashmap_ekle(hm, "k5".ptr, 5);
    hashmap_ekle(hm, "k6".ptr, 6);
    hashmap_ekle(hm, "k7".ptr, 7);
    hashmap_ekle(hm, "k8".ptr, 8);
    hashmap_ekle(hm, "k9".ptr, 9);
    hashmap_ekle(hm, "k10".ptr, 10);
    hashmap_ekle(hm, "k11".ptr, 11);
    hashmap_ekle(hm, "k12".ptr, 12);
    hashmap_ekle(hm, "k13".ptr, 13);

    # Rehash sonrasi eski elemanlar korunmali
    eger hashmap_al(hm, "elma".ptr) != 100 ise {
        ekrana_yaz("FAIL: rehash sonrasi elma\n".ptr);
        dondu 1;
    }
    eger hashmap_al(hm, "cilek".ptr) != 400 ise {
        ekrana_yaz("FAIL: rehash sonrasi cilek\n".ptr);
        dondu 1;
    }

    # Silme (tombstone)
    hashmap_sil(hm, "armut".ptr);
    eger hashmap_var_mi(hm, "armut".ptr) != 0 ise {
        ekrana_yaz("FAIL: silinen armut hala var\n".ptr);
        dondu 1;
    }

    # --------------------------------------------------------
    # 3. Vec Testi (Push/Pop/Index)
    # --------------------------------------------------------
    degisken v: *Vec = vec_tamsayi_olustur();
    vec_push_tamsayi(v, 111);
    vec_push_tamsayi(v, 222);
    vec_push_tamsayi(v, 333);

    eger vec_uzunluk(v) != 3 ise {
        ekrana_yaz("FAIL: vec_uzunluk\n".ptr);
        dondu 1;
    }
    eger vec_get_tamsayi(v, 1) != 222 ise {
        ekrana_yaz("FAIL: vec_get_tamsayi(1)\n".ptr);
        dondu 1;
    }
    degisken popped: tamsayi = vec_pop_tamsayi(v);
    eger popped != 333 ise {
        ekrana_yaz("FAIL: vec_pop_tamsayi\n".ptr);
        dondu 1;
    }

    # --------------------------------------------------------
    # 4. UTF-8 ve Unicode Islemleri Testi
    # --------------------------------------------------------
    degisken utf8_metin: *u8 = "YKN-Dil"; # 7 bayt, 7 karakter
    eger utf8_gecerli_mi(utf8_metin) != 1 ise {
        ekrana_yaz("FAIL: utf8_gecerli_mi ASCII\n".ptr);
        dondu 1;
    }
    eger metin_karakter_sayisi(utf8_metin) != 7 ise {
        ekrana_yaz("FAIL: metin_karakter_sayisi\n".ptr);
        dondu 1;
    }

    # Safe slice: ilk 3 karakteri al -> "YKN"
    degisken dilim: *u8 = metin_alt_dize_guvenli(utf8_metin, 0, 3);
    eger metin_uzunluk(dilim) != 3 ise {
        ekrana_yaz("FAIL: metin_alt_dize_guvenli uzunluk\n".ptr);
        dondu 1;
    }

    ekrana_yaz("FAZ5_STDLIB_PASS\n".ptr);
    dondu 0;
}
