ice_aktar "../../std/ag/soket.ykn";

isv ana(arguman_sayisi: tamsayi, argumanlar: **u8) -> tamsayi {
    ekrana_yaz("CLIENT_BEGIN\n".ptr);
    degisken s: tamsayi = istemci_olustur(ipv4_adres(127, 0, 0, 1), 18083, -1);
    eger s < 0 ise { ekrana_yaz("CLIENT_CONNECT_FAIL\n".ptr); dondu 20; }
    ekrana_yaz("CLIENT_CONNECT_OK\n".ptr);
    soket_kapat(s);
    dondu 0;
}
