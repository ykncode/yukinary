# FIX 13 — Test 3: ?*T nullable pointer null kontrolsuz erisim (negatif test)
# Bu program derleme hatasina yol acmali: TC HATA FIX13
ice_aktar "std/os/common.ykn";
isv principal(argc: tamsayi, argv: **u8) -> tamsayi {
    degisken buf: ?*u8 = os_bellek_tahsis(64);
    # HATA: null kontrol yapilmadan nullable pointer[0] erisimine izin verilmemeli
    buf[0] = 65;
    dondu 0;
}
