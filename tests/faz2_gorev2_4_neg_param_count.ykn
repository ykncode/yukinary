# FAZ 2.4 NEGATIF TEST: Parametre sayisi uyumsuz
ozellik Toplanabilir {
    isv topla(self: Self, diger: tamsayi) -> tamsayi;
}

yapi Sayac {
    deger: tamsayi;
}

uygula Toplanabilir Sayac {
    isv topla(self: Sayac) -> tamsayi {
        dondu self.deger;
    }
}

isv ana() -> tamsayi {
    dondu 0;
}
