# FAZ 2.4 NEGATIF TEST: Parametre tipi uyumsuz
ozellik Toplanabilir {
    isv topla(self: Self, diger: tamsayi) -> tamsayi;
}

yapi Sayac {
    deger: tamsayi;
}

uygula Toplanabilir Sayac {
    isv topla(self: Sayac, diger: gercek) -> tamsayi {
        dondu self.deger;
    }
}

isv ana() -> tamsayi {
    dondu 0;
}
