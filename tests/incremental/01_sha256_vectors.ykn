# ============================================================
# tests/incremental/01_sha256_vectors.ykn
# Pure YKN SHA-256 NIST Vector Validation Test
# ============================================================

harici isv bellek_tahsis_et(boyut: tamsayi) -> *u8;
harici isv ekrana_yaz(mesaj: *u8);

isv sha256_rotr(x: tamsayi, n: tamsayi) -> tamsayi {
    degisken x32: tamsayi = x & 0xffffffff;
    dondu ((x32 >> n) | (x32 << (32 - n))) & 0xffffffff;
}

isv sha256_shr(x: tamsayi, n: tamsayi) -> tamsayi {
    dondu ((x & 0xffffffff) >> n) & 0xffffffff;
}

isv sha256_ch(x: tamsayi, y: tamsayi, z: tamsayi) -> tamsayi {
    degisken x_not: tamsayi = x ^ 0xffffffff;
    degisken p1: tamsayi = x & y;
    degisken p2: tamsayi = x_not & z;
    degisken r: tamsayi = p1 ^ p2;
    dondu r & 0xffffffff;
}

isv sha256_maj(x: tamsayi, y: tamsayi, z: tamsayi) -> tamsayi {
    degisken p1: tamsayi = x & y;
    degisken p2: tamsayi = x & z;
    degisken p3: tamsayi = y & z;
    degisken r: tamsayi = p1 ^ p2 ^ p3;
    dondu r & 0xffffffff;
}

isv sha256_sigma0(x: tamsayi) -> tamsayi {
    degisken r: tamsayi = sha256_rotr(x, 2) ^ sha256_rotr(x, 13) ^ sha256_rotr(x, 22);
    dondu r & 0xffffffff;
}

isv sha256_sigma1(x: tamsayi) -> tamsayi {
    degisken r: tamsayi = sha256_rotr(x, 6) ^ sha256_rotr(x, 11) ^ sha256_rotr(x, 25);
    dondu r & 0xffffffff;
}

isv sha256_gamma0(x: tamsayi) -> tamsayi {
    degisken r: tamsayi = sha256_rotr(x, 7) ^ sha256_rotr(x, 18) ^ sha256_shr(x, 3);
    dondu r & 0xffffffff;
}

isv sha256_gamma1(x: tamsayi) -> tamsayi {
    degisken r: tamsayi = sha256_rotr(x, 17) ^ sha256_rotr(x, 19) ^ sha256_shr(x, 10);
    dondu r & 0xffffffff;
}

degisken g_sha256_k: [64]tamsayi;
degisken g_sha256_k_hazir: tamsayi = 0;

isv sha256_init_k() {
    eger g_sha256_k_hazir == 1 ise { dondu; }
    g_sha256_k[0]  = 0x428a2f98; g_sha256_k[1]  = 0x71374491; g_sha256_k[2]  = 0xb5c0fbcf; g_sha256_k[3]  = 0xe9b5dba5;
    g_sha256_k[4]  = 0x3956c25b; g_sha256_k[5]  = 0x59f111f1; g_sha256_k[6]  = 0x923f82a4; g_sha256_k[7]  = 0xab1c5ed5;
    g_sha256_k[8]  = 0xd807aa98; g_sha256_k[9]  = 0x12835b01; g_sha256_k[10] = 0x243185be; g_sha256_k[11] = 0x550c7dc3;
    g_sha256_k[12] = 0x72be5d74; g_sha256_k[13] = 0x80deb1fe; g_sha256_k[14] = 0x9bdc06a7; g_sha256_k[15] = 0xc19bf174;
    g_sha256_k[16] = 0xe49b69c1; g_sha256_k[17] = 0xefbe4786; g_sha256_k[18] = 0x0fc19dc6; g_sha256_k[19] = 0x240ca1cc;
    g_sha256_k[20] = 0x2de92c6f; g_sha256_k[21] = 0x4a7484aa; g_sha256_k[22] = 0x5cb0a9dc; g_sha256_k[23] = 0x76f988da;
    g_sha256_k[24] = 0x983e5152; g_sha256_k[25] = 0xa831c66d; g_sha256_k[26] = 0xb00327c8; g_sha256_k[27] = 0xbf597fc7;
    g_sha256_k[28] = 0xc6e00bf3; g_sha256_k[29] = 0xd5a79147; g_sha256_k[30] = 0x06ca6351; g_sha256_k[31] = 0x14292967;
    g_sha256_k[32] = 0x27b70a85; g_sha256_k[33] = 0x2e1b2138; g_sha256_k[34] = 0x4d2c6dfc; g_sha256_k[35] = 0x53380d13;
    g_sha256_k[36] = 0x650a7354; g_sha256_k[37] = 0x766a0abb; g_sha256_k[38] = 0x81c2c92e; g_sha256_k[39] = 0x92722c85;
    g_sha256_k[40] = 0xa2bfe8a1; g_sha256_k[41] = 0xa81a664b; g_sha256_k[42] = 0xc24b8b70; g_sha256_k[43] = 0xc76c51a3;
    g_sha256_k[44] = 0xd192e819; g_sha256_k[45] = 0xd6990624; g_sha256_k[46] = 0xf40e3585; g_sha256_k[47] = 0x106aa070;
    g_sha256_k[48] = 0x19a4c116; g_sha256_k[49] = 0x1e376c08; g_sha256_k[50] = 0x2748774c; g_sha256_k[51] = 0x34b0bcb5;
    g_sha256_k[52] = 0x391c0cb3; g_sha256_k[53] = 0x4ed8aa4a; g_sha256_k[54] = 0x5b9cca4f; g_sha256_k[55] = 0x682e6ff3;
    g_sha256_k[56] = 0x748f82ee; g_sha256_k[57] = 0x78a5636f; g_sha256_k[58] = 0x84c87814; g_sha256_k[59] = 0x8cc70208;
    g_sha256_k[60] = 0x90befffa; g_sha256_k[61] = 0xa4506ceb; g_sha256_k[62] = 0xbef9a3f7; g_sha256_k[63] = 0xc67178f2;
    g_sha256_k_hazir = 1;
}

isv sha256_hesapla(veri: *u8, len: tamsayi, cikti_hex: *u8) {
    sha256_init_k();

    # 1. Padded length hesapla
    # len + 1 + 8 bayt min, 64'un katina tamamla
    degisken pad_len: tamsayi = len + 1 + 8;
    degisken rem: tamsayi = pad_len % 64;
    eger rem != 0 ise {
        pad_len = pad_len + (64 - rem);
    }

    degisken buffer: *u8 = bellek_tahsis_et(pad_len);
    # Veriyi kopyala
    degisken i: tamsayi = 0;
    dongu i < len {
        buffer[i] = veri[i];
        i = i + 1;
    }
    # 0x80 biti ekle
    buffer[len] = 0x80;
    i = len + 1;
    dongu i < pad_len - 8 {
        buffer[i] = 0;
        i = i + 1;
    }

    # Son 8 bayta bit uzunlugunu big-endian olarak yaz (len * 8)
    degisken bit_len: tamsayi = len * 8;
    buffer[pad_len - 8] = ((bit_len >> 56) & 0xff);
    buffer[pad_len - 7] = ((bit_len >> 48) & 0xff);
    buffer[pad_len - 6] = ((bit_len >> 40) & 0xff);
    buffer[pad_len - 5] = ((bit_len >> 32) & 0xff);
    buffer[pad_len - 4] = ((bit_len >> 24) & 0xff);
    buffer[pad_len - 3] = ((bit_len >> 16) & 0xff);
    buffer[pad_len - 2] = ((bit_len >> 8) & 0xff);
    buffer[pad_len - 1] = (bit_len & 0xff);

    # 2. State baslat
    degisken h0: tamsayi = 0x6a09e667;
    degisken h1: tamsayi = 0xbb67ae85;
    degisken h2: tamsayi = 0x3c6ef372;
    degisken h3: tamsayi = 0xa54ff53a;
    degisken h4: tamsayi = 0x510e527f;
    degisken h5: tamsayi = 0x9b05688c;
    degisken h6: tamsayi = 0x1f83d9ab;
    degisken h7: tamsayi = 0x5be0cd19;

    degisken w: [64]tamsayi;

    # 3. Her 64 baytlik blok icin isle
    degisken block_offset: tamsayi = 0;
    dongu block_offset < pad_len {
        # W[0..15] hazirla
        degisken t: tamsayi = 0;
        dongu t < 16 {
            degisken b_idx: tamsayi = block_offset + (t * 4);
            degisken b0: tamsayi = buffer[b_idx];
            degisken b1: tamsayi = buffer[b_idx + 1];
            degisken b2: tamsayi = buffer[b_idx + 2];
            degisken b3: tamsayi = buffer[b_idx + 3];
            w[t] = ((b0 << 24) | (b1 << 16) | (b2 << 8) | b3) & 0xffffffff;
            t = t + 1;
        }
        dongu t < 64 {
            degisken s0: tamsayi = sha256_gamma0(w[t - 15]);
            degisken s1: tamsayi = sha256_gamma1(w[t - 2]);
            w[t] = (w[t - 16] + s0 + w[t - 7] + s1) & 0xffffffff;
            t = t + 1;
        }

        degisken a: tamsayi = h0;
        degisken b: tamsayi = h1;
        degisken c: tamsayi = h2;
        degisken d: tamsayi = h3;
        degisken e: tamsayi = h4;
        degisken f: tamsayi = h5;
        degisken g: tamsayi = h6;
        degisken h: tamsayi = h7;

        t = 0;
        dongu t < 64 {
            degisken s1_e: tamsayi = sha256_sigma1(e);
            degisken ch_efg: tamsayi = sha256_ch(e, f, g);
            degisken temp1: tamsayi = (h + s1_e + ch_efg + g_sha256_k[t] + w[t]) & 0xffffffff;
            degisken s0_a: tamsayi = sha256_sigma0(a);
            degisken maj_abc: tamsayi = sha256_maj(a, b, c);
            degisken temp2: tamsayi = (s0_a + maj_abc) & 0xffffffff;

            h = g;
            g = f;
            f = e;
            e = (d + temp1) & 0xffffffff;
            d = c;
            c = b;
            b = a;
            a = (temp1 + temp2) & 0xffffffff;
            t = t + 1;
        }

        h0 = (h0 + a) & 0xffffffff;
        h1 = (h1 + b) & 0xffffffff;
        h2 = (h2 + c) & 0xffffffff;
        h3 = (h3 + d) & 0xffffffff;
        h4 = (h4 + e) & 0xffffffff;
        h5 = (h5 + f) & 0xffffffff;
        h6 = (h6 + g) & 0xffffffff;
        h7 = (h7 + h) & 0xffffffff;

        block_offset = block_offset + 64;
    }

    # 4. Hex string formatla (64 karakter)
    degisken hex_chars: *u8 = "0123456789abcdef".ptr;
    degisken h_arr: [8]tamsayi;
    h_arr[0] = h0; h_arr[1] = h1; h_arr[2] = h2; h_arr[3] = h3;
    h_arr[4] = h4; h_arr[5] = h5; h_arr[6] = h6; h_arr[7] = h7;

    degisken out_idx: tamsayi = 0;
    degisken hi: tamsayi = 0;
    dongu hi < 8 {
        degisken val: tamsayi = h_arr[hi];
        degisken shift: tamsayi = 28;
        dongu shift >= 0 {
            degisken nibble: tamsayi = (val >> shift) & 0xf;
            cikti_hex[out_idx] = hex_chars[nibble];
            out_idx = out_idx + 1;
            shift = shift - 4;
        }
        hi = hi + 1;
    }
    cikti_hex[64] = 0;
}

isv str_esit_mi(a: *u8, b: *u8, len: tamsayi) -> tamsayi {
    degisken i: tamsayi = 0;
    dongu i < len {
        eger a[i] != b[i] ise { dondu 0; }
        i = i + 1;
    }
    dondu 1;
}

isv ana() -> tamsayi {
    degisken out: [128]u8;

    # Test 1: Bos string ""
    # Beklenen: e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855
    degisken bos_str: *u8 = "".ptr;
    sha256_hesapla(bos_str, 0, out);
    degisken exp1: *u8 = "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855".ptr;
    eger str_esit_mi(out, exp1, 64) == 0 ise {
        ekrana_yaz("FAIL: sha256 empty string\n".ptr);
        ekrana_yaz("Alinan:   ".ptr); ekrana_yaz(out); ekrana_yaz("\n".ptr);
        ekrana_yaz("Beklenen: ".ptr); ekrana_yaz(exp1); ekrana_yaz("\n".ptr);
        dondu 1;
    }

    # Test 2: "abc"
    # Beklenen: ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad
    degisken abc: *u8 = "abc".ptr;
    sha256_hesapla(abc, 3, out);
    degisken exp2: *u8 = "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad".ptr;
    eger str_esit_mi(out, exp2, 64) == 0 ise {
        ekrana_yaz("FAIL: sha256 'abc'\n".ptr);
        ekrana_yaz("Alinan:   ".ptr); ekrana_yaz(out); ekrana_yaz("\n".ptr);
        ekrana_yaz("Beklenen: ".ptr); ekrana_yaz(exp2); ekrana_yaz("\n".ptr);
        dondu 1;
    }

    # Test 3: "hello"
    # Beklenen: 2cf24dba5fb0a30e26e83b2ac5b9e29e1b161e5c1fa7425e73043362938b9824
    degisken hello: *u8 = "hello".ptr;
    sha256_hesapla(hello, 5, out);
    degisken exp3: *u8 = "2cf24dba5fb0a30e26e83b2ac5b9e29e1b161e5c1fa7425e73043362938b9824".ptr;
    eger str_esit_mi(out, exp3, 64) == 0 ise {
        ekrana_yaz("FAIL: sha256 'hello'\n".ptr);
        ekrana_yaz("Alinan:   ".ptr); ekrana_yaz(out); ekrana_yaz("\n".ptr);
        ekrana_yaz("Beklenen: ".ptr); ekrana_yaz(exp3); ekrana_yaz("\n".ptr);
        dondu 1;
    }

    ekrana_yaz("SHA256_NIST_VECTORS_PASS\n".ptr);
    dondu 0;
}
