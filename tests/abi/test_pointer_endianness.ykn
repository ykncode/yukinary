# ============================================================
# ABI ve Bellek Yerleşimi Doğrulama Testi
# F4.2: Pointer genişliği, Little-Endian bayt sırası, struct layout ve enum tag
# ============================================================
isv ekrana_yaz(m: *u8) {}
harici isv bellek_tahsis_et(n: tamsayi) -> *u8;

yapi TestLayout {
    a: u8;
    b: tamsayi;
}

isv ana() -> tamsayi {
    # 1. Bellek tahsis et (64 bayt)
    degisken buf: *u8 = bellek_tahsis_et(64);
    eger buf == 0 ise {
        ekrana_yaz("FAIL: bellek tahsisi\n".ptr);
        dondu 1;
    }

    # 2. Endianness Testi:
    # 0x0102030405060708 tamsayısını 64-bit olarak yaz
    # Little-endian mimaride:
    # buf[0] == 0x08, buf[1] == 0x07, ..., buf[7] == 0x01
    degisken i64_ptr: *tamsayi = buf;
    i64_ptr[0] = 72623859790382856; # 0x0102030405060708

    degisken b0: tamsayi = buf[0];
    degisken b1: tamsayi = buf[1];
    degisken b7: tamsayi = buf[7];

    eger b0 != 8 ise {
        ekrana_yaz("FAIL: Endianness LSB eslesmedi (buf[0] != 8)\n".ptr);
        dondu 1;
    }
    eger b1 != 7 ise {
        ekrana_yaz("FAIL: Endianness b1 eslesmedi (buf[1] != 7)\n".ptr);
        dondu 1;
    }
    eger b7 != 1 ise {
        ekrana_yaz("FAIL: Endianness MSB eslesmedi (buf[7] != 1)\n".ptr);
        dondu 1;
    }

    # 3. Struct Layout ve Alignment Testi:
    degisken s_ptr: *TestLayout = buf + 16;
    s_ptr.a = 42;
    s_ptr.b = 999999;

    eger s_ptr.a != 42 ise {
        ekrana_yaz("FAIL: Struct alan a okunamadi\n".ptr);
        dondu 1;
    }
    eger s_ptr.b != 999999 ise {
        ekrana_yaz("FAIL: Struct alan b okunamadi\n".ptr);
        dondu 1;
    }

    ekrana_yaz("ABI_POINTER_ENDIANNESS_PASS\n".ptr);
    dondu 0;
}
