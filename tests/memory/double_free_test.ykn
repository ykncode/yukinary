# Memory Safety Test: double-free
# Ayni pointer'i iki kez serbest birakma testi.
# Beklenen davranis: deterministik abort/panic (exit != 0)
isv ana(argc: tamsayi, argv: **u8) -> tamsayi {
    degisken ptr: *u8 = bellek_tahsis_et(64);
    eger ptr == 0 ise {
        ekrana_yaz("BELLEK TAHSIS HATASI\n".ptr);
        dondu 1;
    }
    ptr[0] = 7;
    ekrana_yaz("DOUBLE_FREE_TEST: ilk tahsis OK\n".ptr);
    bellek_serbest_birak(ptr);
    ekrana_yaz("DOUBLE_FREE_TEST: ilk serbest birakma OK\n".ptr);
    # Ikinci serbest birakma — double-free / abort beklenir
    bellek_serbest_birak(ptr);
    ekrana_yaz("DOUBLE_FREE_TEST: ULASILMAMALI\n".ptr);
    dondu 0;
}
