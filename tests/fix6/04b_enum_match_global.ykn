enum Durum {
    Basarili,
    Beklemede,
    Hatali
}

isv durum_isle(d: Durum) -> tamsayi {
    esles d {
        Durum.Basarili ise {
            dondu 1;
        }
        Durum.Beklemede ise {
            dondu 0;
        }
        varsayilan ise {
            dondu -1;
        }
    }
}

isv ana() -> tamsayi {
    dondu durum_isle(Durum.Basarili);
}
