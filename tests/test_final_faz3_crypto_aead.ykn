# ============================================================
# Yukinary Test - tests/test_final_faz3_crypto_aead.ykn
# FAZ 3 DOGRULAMA: Saf Freestanding ChaCha20 Akis Sifreleyicisi
# ============================================================

ice_aktar "std/kripto/chacha20_poly1305.ykn";
ice_aktar "std/os/common.ykn";
ice_aktar "std/bellek.ykn";

isv main() -> tamsayi {
    # 1. 256-bit (32-bayt) Test Anahtari
    degisken anahtar: [32]u8;
    degisken i: tamsayi = 0;
    dongu i < 32 {
        anahtar[i] = i as u8;
        i = i + 1;
    }
    
    # 2. 96-bit (12-bayt) Test Nonce
    degisken nonce: [12]u8;
    i = 0;
    dongu i < 12 {
        nonce[i] = (i * 3) as u8;
        i = i + 1;
    }
    
    # 3. Test Metni (Plaintext): 48 bayt
    degisken orjinal: [48]u8;
    orjinal[0] = 89;  # 'Y'
    orjinal[1] = 117; # 'u'
    orjinal[2] = 107; # 'k'
    orjinal[3] = 105; # 'i'
    orjinal[4] = 110; # 'n'
    orjinal[5] = 97;  # 'a'
    orjinal[6] = 114; # 'r'
    orjinal[7] = 121; # 'y'
    i = 8;
    dongu i < 48 {
        orjinal[i] = (65 + (i % 26)) as u8;
        i = i + 1;
    }
    
    # Calisma tamponu olustur
    degisken tampon: [48]u8;
    i = 0;
    dongu i < 48 {
        tampon[i] = orjinal[i];
        i = i + 1;
    }
    
    # 4. Sifrele (Encryption)
    chacha20_islem(anahtar, 1, nonce, tampon, 48);
    
    # Sifrelenmis metin orijinalden farkli olmali
    degisken ayni_mi: tamsayi = 1;
    i = 0;
    dongu i < 48 {
        eger tampon[i] != orjinal[i] ise {
            ayni_mi = 0;
        }
        i = i + 1;
    }
    eger ayni_mi == 1 ise {
        dondu 10; # Sifreleme basarisiz: Veri degismedi!
    }
    
    # 5. Desifre Et (Decryption - Simetrik Islem)
    # Ayni anahtar, sayac ve nonce ile tekrar calistirilir
    chacha20_islem(anahtar, 1, nonce, tampon, 48);
    
    # Desifre edilen metin orijinal ile birebir ayni olmali
    i = 0;
    dongu i < 48 {
        eger tampon[i] != orjinal[i] ise {
            dondu 20; # Desifreleme basarisiz: Bayt uyusmazligi!
        }
        i = i + 1;
    }
    
    # 6. Ilk 8 karakter 'Yukinary' mi?
    eger tampon[0] != 89 veya tampon[1] != 117 veya tampon[2] != 107 ise {
        dondu 30;
    }
    
    # Basarili!
    dondu 0;
}

