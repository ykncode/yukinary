                byte_yaz(a, 0x4C); byte_yaz(a, 0x89); byte_yaz(a, 0xF9);
                byte_yaz(a, 0xBA); int32_yaz(a, 0x40000000);
                byte_yaz(a, 0x41); byte_yaz(a, 0xB8); int32_yaz(a, 2);
                byte_yaz(a, 0x4D); byte_yaz(a, 0x31); byte_yaz(a, 0xC9);
                byte_yaz(a, 0x48); byte_yaz(a, 0xC7); byte_yaz(a, 0x44); byte_yaz(a, 0x24); byte_yaz(a, 0x20); int32_yaz(a, 2);
                byte_yaz(a, 0x48); byte_yaz(a, 0xC7); byte_yaz(a, 0x44); byte_yaz(a, 0x24); byte_yaz(a, 0x28); int32_yaz(a, 128);
                byte_yaz(a, 0x48); byte_yaz(a, 0xC7); byte_yaz(a, 0x44); byte_yaz(a, 0x24); byte_yaz(a, 0x30); int32_yaz(a, 0);
                byte_yaz(a, 0xFF); byte_yaz(a, 0x15);
                degisken iat_db_cfa2: tamsayi = g_iat_yama_adet;
                g_iat_yama_text_offset[iat_db_cfa2] = a.kullanilan;
                g_iat_yama_slot[iat_db_cfa2] = 4;
                g_iat_yama_adet = g_iat_yama_adet + 1;
                int32_yaz(a, 0);
                byte_yaz(a, 0x48); byte_yaz(a, 0x83); byte_yaz(a, 0xC4); byte_yaz(a, 0x40);
                byte_yaz(a, 0x49); byte_yaz(a, 0x89); byte_yaz(a, 0xC7);

                # WriteFile(...)
                byte_yaz(a, 0x48); byte_yaz(a, 0x83); byte_yaz(a, 0xEC); byte_yaz(a, 0x30);
                byte_yaz(a, 0x4C); byte_yaz(a, 0x89); byte_yaz(a, 0xF9);
                byte_yaz(a, 0x4C); byte_yaz(a, 0x89); byte_yaz(a, 0xF2);
                byte_yaz(a, 0x4D); byte_yaz(a, 0x89); byte_yaz(a, 0xE8);
                byte_yaz(a, 0x4C); byte_yaz(a, 0x8D); byte_yaz(a, 0x4C); byte_yaz(a, 0x24); byte_yaz(a, 0x20);
                byte_yaz(a, 0x48); byte_yaz(a, 0xC7); byte_yaz(a, 0x44); byte_yaz(a, 0x24); byte_yaz(a, 0x28); int32_yaz(a, 0);
                byte_yaz(a, 0xFF); byte_yaz(a, 0x15);
                degisken iat_db_wf: tamsayi = g_iat_yama_adet;
                g_iat_yama_text_offset[iat_db_wf] = a.kullanilan;
                g_iat_yama_slot[iat_db_wf] = 1;
                g_iat_yama_adet = g_iat_yama_adet + 1;
                int32_yaz(a, 0);
                byte_yaz(a, 0x48); byte_yaz(a, 0x83); byte_yaz(a, 0xC4); byte_yaz(a, 0x30);

                # CloseHandle(...)
                byte_yaz(a, 0x48); byte_yaz(a, 0x83); byte_yaz(a, 0xEC); byte_yaz(a, 0x20);
                byte_yaz(a, 0x4C); byte_yaz(a, 0x89); byte_yaz(a, 0xF9);
                byte_yaz(a, 0xFF); byte_yaz(a, 0x15);
                degisken iat_db_ch2: tamsayi = g_iat_yama_adet;
                g_iat_yama_text_offset[iat_db_ch2] = a.kullanilan;
                g_iat_yama_slot[iat_db_ch2] = 6;
                g_iat_yama_adet = g_iat_yama_adet + 1;
                int32_yaz(a, 0);
                byte_yaz(a, 0x48); byte_yaz(a, 0x83); byte_yaz(a, 0xC4); byte_yaz(a, 0x20);

                emit_xor_rax_rax(a); # (dondu 0)
            }

        } yoksa eger bellek_esit_mi(f_isim, "komut_satiri_arg1".ptr, 17) == 1 ise {
            byte_yaz(a, 0x48); byte_yaz(a, 0x83); byte_yaz(a, 0xEC); byte_yaz(a, 0x28); # SUB RSP, 40
            byte_yaz(a, 0xFF); byte_yaz(a, 0x15);
            degisken iat_gcla: tamsayi = g_iat_yama_adet;
            g_iat_yama_text_offset[iat_gcla] = a.kullanilan;
            g_iat_yama_slot[iat_gcla] = 7;
            g_iat_yama_adet = g_iat_yama_adet + 1;
            int32_yaz(a, 0);
            byte_yaz(a, 0x48); byte_yaz(a, 0x83); byte_yaz(a, 0xC4); byte_yaz(a, 0x28); # ADD RSP, 40
        } yoksa eger bellek_esit_mi(f_isim, "bellek_tahsis_et".ptr, 16) == 1 ise {
            degisken ba_arg: *AstDugum = dugum.sag;
            eger ba_arg != 0 ise {
                ast_kod_uret(a, ba_arg);
            } yoksa {
                emit_xor_rax_rax(a);
            }
            eger g_target_platform == 1 ise {
                # Linux: sys_mmap(NULL, size=RAX, PROT_READ|PROT_WRITE=3, MAP_PRIVATE|MAP_ANONYMOUS=34, -1, 0)
                byte_yaz(a, 0x48); byte_yaz(a, 0x89); byte_yaz(a, 0xC6); # MOV RSI, RAX (length)
                byte_yaz(a, 0x48); byte_yaz(a, 0x31); byte_yaz(a, 0xFF); # XOR RDI, RDI (addr = NULL)
                byte_yaz(a, 0x48); byte_yaz(a, 0xC7); byte_yaz(a, 0xC2); int32_yaz(a, 3); # MOV RDX, 3
                byte_yaz(a, 0x49); byte_yaz(a, 0xC7); byte_yaz(a, 0xC2); int32_yaz(a, 34); # MOV R10, 34
                byte_yaz(a, 0x49); byte_yaz(a, 0xC7); byte_yaz(a, 0xC0); int32_yaz(a, 0xFFFFFFFF); # MOV R8, -1
                byte_yaz(a, 0x4D); byte_yaz(a, 0x31); byte_yaz(a, 0xC9); # XOR R9, R9
                byte_yaz(a, 0x48); byte_yaz(a, 0xC7); byte_yaz(a, 0xC0); int32_yaz(a, 9); # MOV RAX, 9 (SYS_mmap)
                byte_yaz(a, 0x0F); byte_yaz(a, 0x05); # SYSCALL
            } yoksa eger g_target_platform == 2 ise {
                # macOS: BSD SYS_mmap(NULL, size=RSI, PROT_RW=3, MAP_PRIVATE|MAP_ANON=0x1002, -1, 0)
                byte_yaz(a, 0x48); byte_yaz(a, 0x89); byte_yaz(a, 0xC6); # MOV RSI, RAX (length)
                byte_yaz(a, 0x48); byte_yaz(a, 0x31); byte_yaz(a, 0xFF); # XOR RDI, RDI (addr = NULL)
                byte_yaz(a, 0x48); byte_yaz(a, 0xC7); byte_yaz(a, 0xC2); int32_yaz(a, 3); # MOV RDX, 3 (PROT_READ|PROT_WRITE)
                byte_yaz(a, 0x49); byte_yaz(a, 0xC7); byte_yaz(a, 0xC2); int32_yaz(a, 0x1002); # MOV R10, MAP_PRIVATE|MAP_ANON
                byte_yaz(a, 0x49); byte_yaz(a, 0xC7); byte_yaz(a, 0xC0); int32_yaz(a, 0xFFFFFFFF); # MOV R8, -1
                byte_yaz(a, 0x4D); byte_yaz(a, 0x31); byte_yaz(a, 0xC9); # XOR R9, R9
                byte_yaz(a, 0x48); byte_yaz(a, 0xC7); byte_yaz(a, 0xC0); int32_yaz(a, 0x20000C5); # MOV RAX, 0x20000C5 (BSD SYS_mmap=197)
                byte_yaz(a, 0x0F); byte_yaz(a, 0x05); # SYSCALL
            } yoksa {
                # MOV RDX, RAX  (dwSize = boyut)
                byte_yaz(a, 0x48); byte_yaz(a, 0x89); byte_yaz(a, 0xC2);
                # XOR RCX, RCX  (lpAddress = NULL)
                byte_yaz(a, 0x48); byte_yaz(a, 0x31); byte_yaz(a, 0xC9);
                # MOV R8D, 0x3000  (MEM_COMMIT|MEM_RESERVE)
                byte_yaz(a, 0x41); byte_yaz(a, 0xB8); int32_yaz(a, 0x3000);
                # MOV R9D, 0x04  (PAGE_READWRITE)
                byte_yaz(a, 0x41); byte_yaz(a, 0xB9); int32_yaz(a, 0x04);
                # SUB RSP, 40  (shadow space)
                byte_yaz(a, 0x48); byte_yaz(a, 0x83); byte_yaz(a, 0xEC); byte_yaz(a, 0x28);
                # CALL [RIP+rel32] -> VirtualAlloc IAT (slot 3)
                byte_yaz(a, 0xFF); byte_yaz(a, 0x15);
                degisken iat_va_idx: tamsayi = g_iat_yama_adet;
                g_iat_yama_text_offset[iat_va_idx] = a.kullanilan;
                g_iat_yama_slot[iat_va_idx] = 3;
                g_iat_yama_adet = g_iat_yama_adet + 1;
                int32_yaz(a, 0); # placeholder
                # ADD RSP, 40
                byte_yaz(a, 0x48); byte_yaz(a, 0x83); byte_yaz(a, 0xC4); byte_yaz(a, 0x28);
            }
        } yoksa {
            degisken arg_iter: *AstDugum = dugum.sag;
            degisken arg_sayisi: tamsayi = 0;
            dongu arg_iter != 0 {
                arg_sayisi = arg_sayisi + 1;
                arg_iter = arg_iter.sonraki;
            }
            
            degisken alloc_size: tamsayi = 32;
            eger arg_sayisi >= 4 ise {
                alloc_size = arg_sayisi * 8;
            }
            eger alloc_size % 16 != 0 ise {
                alloc_size = alloc_size + 8;
            }
            
            emit_sub_rsp(a, alloc_size);
            
            degisken arg_node: *AstDugum = dugum.sag;
            degisken curr_arg: tamsayi = 0;
            dongu arg_node != 0 {
                degisken arr_gecildi: tamsayi = 0;
                eger arg_node.tip == 4 ise {
                    degisken a_var_off: tamsayi = lokal_bul_offset(arg_node.ilk_jeton.baslangic, arg_node.ilk_jeton.uzunluk);
                    degisken a_var_dizi: tamsayi = lokal_bul_dizi(arg_node.ilk_jeton.baslangic, arg_node.ilk_jeton.uzunluk);
                    eger a_var_off != 0 ve a_var_dizi > 0 ise {
                        emit_lea_rax(a, a_var_off);
                        arr_gecildi = 1;
                    }
                }
                eger arr_gecildi == 0 ise {
                    ast_kod_uret(a, arg_node);
                }
                # MOV [RSP + curr_arg*8], RAX
                byte_yaz(a, 0x48); byte_yaz(a, 0x89); byte_yaz(a, 0x84); byte_yaz(a, 0x24);
                int32_yaz(a, curr_arg * 8);
                
                arg_node = arg_node.sonraki;
                curr_arg = curr_arg + 1;
            }
            
            # Ilk 4 argumani register'lara yukle
            eger arg_sayisi > 0 ise {
                # MOV RCX, [RSP]
                byte_yaz(a, 0x48); byte_yaz(a, 0x8B); byte_yaz(a, 0x0C); byte_yaz(a, 0x24);
            }
            eger arg_sayisi > 1 ise {
                # MOV RDX, [RSP+8]
                byte_yaz(a, 0x48); byte_yaz(a, 0x8B); byte_yaz(a, 0x54); byte_yaz(a, 0x24); byte_yaz(a, 0x08);
            }
            eger arg_sayisi > 2 ise {
                # MOV R8, [RSP+16]
                byte_yaz(a, 0x4C); byte_yaz(a, 0x8B); byte_yaz(a, 0x44); byte_yaz(a, 0x24); byte_yaz(a, 0x10);
            }
            eger arg_sayisi > 3 ise {
                # MOV R9, [RSP+24]
                byte_yaz(a, 0x4C); byte_yaz(a, 0x8B); byte_yaz(a, 0x4C); byte_yaz(a, 0x24); byte_yaz(a, 0x18);
            }
            
            # IAT slot eslesmesi kontrol et (Win32 FFI)
            degisken iat_slot_no: tamsayi = (0 - 1);
            eger g_target_platform == 0 ise {
                eger f_uzn == 11 ve bellek_esit_mi(f_isim, "ExitProcess".ptr, 11) == 1 ise { iat_slot_no = 0; }
                yoksa eger f_uzn == 9 ve bellek_esit_mi(f_isim, "WriteFile".ptr, 9) == 1 ise { iat_slot_no = 1; }
                yoksa eger f_uzn == 12 ve bellek_esit_mi(f_isim, "GetStdHandle".ptr, 12) == 1 ise { iat_slot_no = 2; }
                yoksa eger f_uzn == 12 ve bellek_esit_mi(f_isim, "VirtualAlloc".ptr, 12) == 1 ise { iat_slot_no = 3; }
                yoksa eger f_uzn == 11 ve bellek_esit_mi(f_isim, "CreateFileA".ptr, 11) == 1 ise { iat_slot_no = 4; }
                yoksa eger f_uzn == 8 ve bellek_esit_mi(f_isim, "ReadFile".ptr, 8) == 1 ise { iat_slot_no = 5; }
                yoksa eger f_uzn == 11 ve bellek_esit_mi(f_isim, "CloseHandle".ptr, 11) == 1 ise { iat_slot_no = 6; }
                yoksa eger f_uzn == 16 ve bellek_esit_mi(f_isim, "GetCommandLineA".ptr, 16) == 1 ise { iat_slot_no = 7; }
                yoksa eger f_uzn == 16 ve bellek_esit_mi(f_isim, "SetFilePointerEx".ptr, 16) == 1 ise { iat_slot_no = 8; }
            }

            eger iat_slot_no >= 0 ise {
                byte_yaz(a, 0xFF); byte_yaz(a, 0x15);
                degisken iat_idx: tamsayi = g_iat_yama_adet;
                g_iat_yama_text_offset[iat_idx] = a.kullanilan;
                g_iat_yama_slot[iat_idx] = iat_slot_no;
                g_iat_yama_adet = g_iat_yama_adet + 1;
                int32_yaz(a, 0);
            } yoksa {
                byte_yaz(a, 0xE8);
                degisken y_idx: tamsayi = g_yama_adet;
                g_yama_isim[y_idx] = f_isim;
                g_yama_uzunluk[y_idx] = f_uzn;
                g_yama_cagri_pos[y_idx] = a.kullanilan;
                g_yama_adet = g_yama_adet + 1;
                int32_yaz(a, 0);
            }
            
            emit_add_rsp(a, alloc_size);
        }
        dondu 0;
    }

    # --------------------------------------------------------
    # AST_UNARY (19): Pointer dereference *ptr => MOV RAX, [RAX]
    # --------------------------------------------------------
    eger dugum.tip == 19 ise { # AST_UNARY
        ast_kod_uret(a, dugum.sag);
        byte_yaz(a, 0x48); byte_yaz(a, 0x8B); byte_yaz(a, 0x00); # MOV RAX, [RAX]
        dondu 0;
    }

    # --------------------------------------------------------
    # AST_REFERANS (20): Adres alma &var => LEA RAX, [RBP-off]
    # --------------------------------------------------------
    eger dugum.tip == 20 ise { # AST_REFERANS
        degisken ref_sag: *AstDugum = dugum.sag;
        eger ref_sag != 0 ise {
            eger ref_sag.tip == AST_KIMLIK ise {
                degisken ref_off: tamsayi = lokal_bul_offset(ref_sag.ilk_jeton.baslangic, ref_sag.ilk_jeton.uzunluk);
                eger ref_off != 0 ise {
                    emit_lea_rax(a, ref_off);
                } yoksa {
                    degisken g_idx: tamsayi = 0 - 1;
                    degisken gi: tamsayi = 0;
                    dongu gi < g_global_sayisi {
                        eger g_global_uzunluk[gi] == ref_sag.ilk_jeton.uzunluk ise {
                            eger bellek_esit_mi(g_global_isim[gi], ref_sag.ilk_jeton.baslangic, ref_sag.ilk_jeton.uzunluk) == 1 ise {
                                g_idx = gi;
                            }
                        }
                        gi = gi + 1;
                    }
                    eger g_idx != 0 - 1 ise {
                        degisken g_addr: tamsayi = g_global_adres[g_idx];
                        byte_yaz(a, 72); byte_yaz(a, 141); byte_yaz(a, 5);
                        int32_yaz(a, g_addr - (a.kullanilan + 4));
                    }
                }
            }
        }
        dondu 0;
    }

    # --------------------------------------------------------
    # AST_YAPI_TANIMI (16): Struct tanimini g_yapi_tablosu'na kaydet
    # --------------------------------------------------------
    eger dugum.tip == 16 ise { # AST_YAPI_TANIMI
        degisken yp_idx: tamsayi = g_yapi_adet;
        g_yapi_isim[yp_idx]       = dugum.ilk_jeton.baslangic;
        g_yapi_uzunluk[yp_idx]    = dugum.ilk_jeton.uzunluk;
        g_yapi_alan_sayisi[yp_idx] = 0;
        degisken yp_alan: *AstDugum = dugum.sol;
        degisken yp_off: tamsayi = 0;
        dongu yp_alan != 0 {
            degisken ai: tamsayi = g_yapi_alan_sayisi[yp_idx];
            degisken a_idx: tamsayi = (yp_idx * 32) + ai;
            g_yapi_alan_isim[a_idx]          = yp_alan.ilk_jeton.baslangic;
            g_yapi_alan_uzunluk[a_idx]       = yp_alan.ilk_jeton.uzunluk;
            g_yapi_alan_offset[a_idx]        = yp_off;
            g_yapi_alan_sayisi[yp_idx] = ai + 1;
            eger yp_alan.dizi_boyutu > 0 ise {
                yp_off = yp_off + (yp_alan.dizi_boyutu * 8);
            } yoksa {
                yp_off = yp_off + 8;
            }
            yp_alan = yp_alan.sonraki;
        }
        g_yapi_adet = yp_idx + 1;
        g_yapi_byte_boyutu[yp_idx] = yp_off;
        dondu 0;
    }

    eger dugum.tip == AST_ICE_AKTAR ise {
        dondu 0;
    }

    # --------------------------------------------------------
    # AST_ALAN_ERISIMI (17): obj.field okuma => MOV RAX, [RAX+off]
    # --------------------------------------------------------
    eger dugum.tip == 17 ise { # AST_ALAN_ERISIMI
        degisken ae_obj:   *AstDugum = dugum.sol;
        degisken ae_field: *AstDugum = dugum.sag;
        ast_kod_uret(a, ae_obj); # RAX = nesne pointer'i
        eger ae_field != 0 ve ae_field.ilk_jeton != 0 ise {
            eger ae_field.ilk_jeton.uzunluk == 3 ise {
                degisken ptr_f: *u8 = ae_field.ilk_jeton.baslangic;
                eger ptr_f[0] == 112 ve ptr_f[1] == 116 ve ptr_f[2] == 114 ise {
                    dondu 0; # .ptr no-op! RAX zaten pointer iceriyor
                }
            }
        }
        # Nesne tipini bul (lokal tablo)
        degisken ae_t_adi: *u8 = 0;
        degisken ae_t_uzn: tamsayi = 0;
        eger ae_obj.tip == AST_ISLEV_CAGRISI ve ae_obj.sol != 0 ise {
            eger ae_obj.sol.ilk_jeton != 0 ve ae_obj.sol.ilk_jeton.uzunluk == 12 ise {
                eger bellek_esit_mi(ae_obj.sol.ilk_jeton.baslangic, "suanki_jeton".ptr, 12) == 1 ise {
                    ae_t_adi = "Jeton".ptr;
                    ae_t_uzn = 5;
                }
            }
        }
        eger ae_obj.tip == AST_KIMLIK ise {
            eger ae_obj.ilk_jeton == 0 ise {
            } yoksa {
            degisken ki: tamsayi = 0;
            degisken b_bulundu: tamsayi = 0;
            dongu ki < g_lokal_adet {
                eger g_lokal_isimleri[ki] != 0 ve g_lokal_uzunluklari[ki] == ae_obj.ilk_jeton.uzunluk ise {
                    eger bellek_esit_mi(g_lokal_isimleri[ki], ae_obj.ilk_jeton.baslangic, g_lokal_uzunluklari[ki]) == 1 ise {
                        ae_t_adi = g_lokal_tip_adlari[ki];
                        ae_t_uzn = g_lokal_tip_uzunluklari[ki];
                        b_bulundu = 1;
                    }
                }
                ki = ki + 1;
            }
            eger b_bulundu == 0 ise {
                degisken gi: tamsayi = 0;
                dongu gi < g_global_sayisi {
                    eger g_global_uzunluk[gi] == ae_obj.ilk_jeton.uzunluk ise {
                        eger bellek_esit_mi(g_global_isim[gi], ae_obj.ilk_jeton.baslangic, ae_obj.ilk_jeton.uzunluk) == 1 ise {
                            ae_t_adi = g_global_tip_adi[gi];
                            ae_t_uzn = g_global_tip_adi_uzunluk[gi];
                        }
                    }
                    gi = gi + 1;
                }
            }
            } # end eger ae_obj.ilk_jeton != 0
        }
        eger ae_obj.tip == AST_ALAN_ERISIMI ve ae_obj.sag != 0 ve ae_obj.sag.ilk_jeton != 0 ise {
            eger ae_obj.sag.ilk_jeton.uzunluk == 9 ve bellek_esit_mi(ae_obj.sag.ilk_jeton.baslangic, "ilk_jeton".ptr, 9) == 1 ise {
                ae_t_adi = "Jeton".ptr;
                ae_t_uzn = 5;
            }
            eger ae_obj.sag.ilk_jeton.uzunluk == 9 ve bellek_esit_mi(ae_obj.sag.ilk_jeton.baslangic, "son_jeton".ptr, 9) == 1 ise {
                ae_t_adi = "Jeton".ptr;
                ae_t_uzn = 5;
            }
            eger ae_obj.sag.ilk_jeton.uzunluk == 10 ve bellek_esit_mi(ae_obj.sag.ilk_jeton.baslangic, "isim_jeton".ptr, 10) == 1 ise {
                ae_t_adi = "Jeton".ptr;
                ae_t_uzn = 5;
            }
        }
        eger ae_obj.tip == AST_ISLEV_CAGRISI ve ae_field != 0 ve ae_field.ilk_jeton != 0 ise {
            eger ae_field.ilk_jeton.uzunluk == 3 ve bellek_esit_mi(ae_field.ilk_jeton.baslangic, "tip".ptr, 3) == 1 ise {
                byte_yaz(a, 0x48); byte_yaz(a, 0x8B); byte_yaz(a, 0x00);
                dondu 0;
            }
        }
        # Fallback: nested objeler (fonksiyon donusu, pointer-to-struct, baska alan erisimi) icin
        # ae_obj dugumunun kendi tip alanlarini kullan (typechecker tarafindan doldurulur)
        eger ae_t_adi == 0 veya ae_t_uzn == 0 ise {
            degisken f_tip: *u8 = ae_obj.tip_adi;
            degisken f_uzn: tamsayi = ae_obj.tip_adi_uzunluk;
            eger f_tip != 0 ve f_uzn > 0 ise {
                ae_t_adi = f_tip;
                ae_t_uzn = f_uzn;
            }
        }
        # Yapi tablosundan alan offset'ini bul
        degisken ae_field_off: tamsayi = 0 - 1;
        eger ae_field != 0 ve ae_field.ilk_jeton != 0 ise {
            eger ae_t_uzn == 5 ve ae_t_adi != 0 ise {
                eger bellek_esit_mi(ae_t_adi, "Jeton".ptr, 5) == 1 ise {
                    eger ae_field.ilk_jeton.uzunluk == 3 ve bellek_esit_mi(ae_field.ilk_jeton.baslangic, "tip".ptr, 3) == 1 ise { ae_field_off = 0; }
                    eger ae_field.ilk_jeton.uzunluk == 9 ve bellek_esit_mi(ae_field.ilk_jeton.baslangic, "baslangic".ptr, 9) == 1 ise { ae_field_off = 8; }
                    eger ae_field.ilk_jeton.uzunluk == 7 ve bellek_esit_mi(ae_field.ilk_jeton.baslangic, "uzunluk".ptr, 7) == 1 ise { ae_field_off = 16; }
                    eger ae_field.ilk_jeton.uzunluk == 5 ve bellek_esit_mi(ae_field.ilk_jeton.baslangic, "satir".ptr, 5) == 1 ise { ae_field_off = 24; }
                    eger ae_field.ilk_jeton.uzunluk == 5 ve bellek_esit_mi(ae_field.ilk_jeton.baslangic, "sutun".ptr, 5) == 1 ise { ae_field_off = 32; }
                }
            }
            eger ae_field_off == (0 - 1) ve ae_t_adi != 0 ise {
                degisken yi: tamsayi = 0;
                dongu yi < g_yapi_adet {
                    eger g_yapi_uzunluk[yi] == ae_t_uzn ise {
                        eger bellek_esit_mi(g_yapi_isim[yi], ae_t_adi, ae_t_uzn) == 1 ise {
                            degisken ai: tamsayi = 0;
                            dongu ai < g_yapi_alan_sayisi[yi] {
                                degisken a_idx: tamsayi = (yi * 32) + ai;
                                eger g_yapi_alan_uzunluk[a_idx] == ae_field.ilk_jeton.uzunluk ise {
                                    eger bellek_esit_mi(g_yapi_alan_isim[a_idx], ae_field.ilk_jeton.baslangic, g_yapi_alan_uzunluk[a_idx]) == 1 ise {
                                        ae_field_off = g_yapi_alan_offset[a_idx];
                                        dugum.tip_adi = g_yapi_alan_tip_adi[a_idx];
                                        dugum.tip_adi_uzunluk = g_yapi_alan_tip_uzn[a_idx];
                                        dugum.cozumlenmis_tip = g_yapi_alan_yildiz[a_idx];
                                    }
                                }
                                ai = ai + 1;
                            }
                        }
                    }
                    yi = yi + 1;
                }
            }
            eger ae_field_off == (0 - 1) ise {
                eger ae_field.ilk_jeton.uzunluk == 3 ve bellek_esit_mi(ae_field.ilk_jeton.baslangic, "tip".ptr, 3) == 1 ise { ae_field_off = 0; }
                eger ae_field.ilk_jeton.uzunluk == 9 ve bellek_esit_mi(ae_field.ilk_jeton.baslangic, "ilk_jeton".ptr, 9) == 1 ise { ae_field_off = 8; }
                eger ae_field.ilk_jeton.uzunluk == 9 ve bellek_esit_mi(ae_field.ilk_jeton.baslangic, "son_jeton".ptr, 9) == 1 ise { ae_field_off = 16; }
                eger ae_field.ilk_jeton.uzunluk == 3 ve bellek_esit_mi(ae_field.ilk_jeton.baslangic, "sol".ptr, 3) == 1 ise { ae_field_off = 24; }
                eger ae_field.ilk_jeton.uzunluk == 3 ve bellek_esit_mi(ae_field.ilk_jeton.baslangic, "sag".ptr, 3) == 1 ise { ae_field_off = 32; }
                eger ae_field.ilk_jeton.uzunluk == 7 ve bellek_esit_mi(ae_field.ilk_jeton.baslangic, "sonraki".ptr, 7) == 1 ise { ae_field_off = 40; }
                eger ae_field.ilk_jeton.uzunluk == 5 ve bellek_esit_mi(ae_field.ilk_jeton.baslangic, "govde".ptr, 5) == 1 ise { ae_field_off = 48; }
                eger ae_field.ilk_jeton.uzunluk == 11 ve bellek_esit_mi(ae_field.ilk_jeton.baslangic, "yoksa_govde".ptr, 11) == 1 ise { ae_field_off = 56; }
                eger ae_field.ilk_jeton.uzunluk == 12 ve bellek_esit_mi(ae_field.ilk_jeton.baslangic, "parametreler".ptr, 12) == 1 ise { ae_field_off = 64; }
                eger ae_field.ilk_jeton.uzunluk == 7 ve bellek_esit_mi(ae_field.ilk_jeton.baslangic, "tip_adi".ptr, 7) == 1 ise { ae_field_off = 72; }
                eger ae_field.ilk_jeton.uzunluk == 15 ve bellek_esit_mi(ae_field.ilk_jeton.baslangic, "tip_adi_uzunluk".ptr, 15) == 1 ise { ae_field_off = 80; }
                eger ae_field.ilk_jeton.uzunluk == 15 ve bellek_esit_mi(ae_field.ilk_jeton.baslangic, "cozumlenmis_tip".ptr, 15) == 1 ise { ae_field_off = 88; }
                eger ae_field.ilk_jeton.uzunluk == 11 ve bellek_esit_mi(ae_field.ilk_jeton.baslangic, "dizi_boyutu".ptr, 11) == 1 ise { ae_field_off = 96; }
                eger ae_field.ilk_jeton.uzunluk == 9 ve bellek_esit_mi(ae_field.ilk_jeton.baslangic, "baslangic".ptr, 9) == 1 ise { ae_field_off = 8; }
                eger ae_field.ilk_jeton.uzunluk == 7 ve bellek_esit_mi(ae_field.ilk_jeton.baslangic, "uzunluk".ptr, 7) == 1 ise { ae_field_off = 16; }
                eger ae_field.ilk_jeton.uzunluk == 5 ve bellek_esit_mi(ae_field.ilk_jeton.baslangic, "satir".ptr, 5) == 1 ise { ae_field_off = 24; }
                eger ae_field.ilk_jeton.uzunluk == 5 ve bellek_esit_mi(ae_field.ilk_jeton.baslangic, "sutun".ptr, 5) == 1 ise { ae_field_off = 32; }
                eger ae_field.ilk_jeton.uzunluk == 6 ve bellek_esit_mi(ae_field.ilk_jeton.baslangic, "kaynak".ptr, 6) == 1 ise { ae_field_off = 0; }
                eger ae_field.ilk_jeton.uzunluk == 12 ve bellek_esit_mi(ae_field.ilk_jeton.baslangic, "dosya_boyutu".ptr, 12) == 1 ise { ae_field_off = 8; }
                eger ae_field.ilk_jeton.uzunluk == 13 ve bellek_esit_mi(ae_field.ilk_jeton.baslangic, "guncel_offset".ptr, 13) == 1 ise { ae_field_off = 16; }
                eger ae_field.ilk_jeton.uzunluk == 8 ve bellek_esit_mi(ae_field.ilk_jeton.baslangic, "jetonlar".ptr, 8) == 1 ise {
                    eger ae_t_adi != 0 ve ae_t_uzn == 12 ve bellek_esit_mi(ae_t_adi, "ParserDurumu".ptr, 12) == 1 ise { ae_field_off = 0; }
                    yoksa { ae_field_off = 40; }
                }
                eger ae_field.ilk_jeton.uzunluk == 12 ve bellek_esit_mi(ae_field.ilk_jeton.baslangic, "jeton_sayisi".ptr, 12) == 1 ise {
                    eger ae_t_adi != 0 ve ae_t_uzn == 12 ve bellek_esit_mi(ae_t_adi, "ParserDurumu".ptr, 12) == 1 ise { ae_field_off = 8; }
                    yoksa { ae_field_off = 48; }
                }
                eger ae_field.ilk_jeton.uzunluk == 14 ve bellek_esit_mi(ae_field.ilk_jeton.baslangic, "jeton_kapasite".ptr, 14) == 1 ise { ae_field_off = 56; }
                eger ae_field.ilk_jeton.uzunluk == 4 ve bellek_esit_mi(ae_field.ilk_jeton.baslangic, "pool".ptr, 4) == 1 ise { ae_field_off = 64; }
                eger ae_field.ilk_jeton.uzunluk == 12 ve bellek_esit_mi(ae_field.ilk_jeton.baslangic, "guncel_index".ptr, 12) == 1 ise { ae_field_off = 16; }
                eger ae_field.ilk_jeton.uzunluk == 5 ve bellek_esit_mi(ae_field.ilk_jeton.baslangic, "arena".ptr, 5) == 1 ise {
                    eger ae_t_adi != 0 ve ae_t_uzn == 14 ve bellek_esit_mi(ae_t_adi, "GenericsMotoru".ptr, 14) == 1 ise { ae_field_off = 16; }
                    yoksa { ae_field_off = 24; }
                }
                eger ae_field.ilk_jeton.uzunluk == 6 ve bellek_esit_mi(ae_field.ilk_jeton.baslangic, "bellek".ptr, 6) == 1 ise { ae_field_off = 0; }
                eger ae_field.ilk_jeton.uzunluk == 8 ve bellek_esit_mi(ae_field.ilk_jeton.baslangic, "kapasite".ptr, 8) == 1 ise { ae_field_off = 8; }
                eger ae_field.ilk_jeton.uzunluk == 10 ve bellek_esit_mi(ae_field.ilk_jeton.baslangic, "kullanilan".ptr, 10) == 1 ise { ae_field_off = 16; }
                eger ae_field.ilk_jeton.uzunluk == 8 ve bellek_esit_mi(ae_field.ilk_jeton.baslangic, "kurallar".ptr, 8) == 1 ise { ae_field_off = 0; }
                eger ae_field.ilk_jeton.uzunluk == 12 ve bellek_esit_mi(ae_field.ilk_jeton.baslangic, "kayitli_sayi".ptr, 12) == 1 ise { ae_field_off = 16; }
                eger ae_field.ilk_jeton.uzunluk == 14 ve bellek_esit_mi(ae_field.ilk_jeton.baslangic, "sablon_listesi".ptr, 14) == 1 ise { ae_field_off = 0; }
                eger ae_field.ilk_jeton.uzunluk == 13 ve bellek_esit_mi(ae_field.ilk_jeton.baslangic, "trait_tablosu".ptr, 13) == 1 ise { ae_field_off = 8; }
                eger ae_field.ilk_jeton.uzunluk == 12 ve bellek_esit_mi(ae_field.ilk_jeton.baslangic, "ilk_talimat".ptr, 12) == 1 ise { ae_field_off = 0; }
                eger ae_field.ilk_jeton.uzunluk == 12 ve bellek_esit_mi(ae_field.ilk_jeton.baslangic, "son_talimat".ptr, 12) == 1 ise { ae_field_off = 8; }
                eger ae_field.ilk_jeton.uzunluk == 18 ve bellek_esit_mi(ae_field.ilk_jeton.baslangic, "sanal_reg_sayaci".ptr, 18) == 1 ise { ae_field_off = 16; }
            }
        }
        eger ae_field_off != (0 - 1) ise {
            eger ae_field_off <= 127 ise {
                byte_yaz(a, 0x48); byte_yaz(a, 0x8B); byte_yaz(a, 0x40);
                byte_yaz(a, ae_field_off);
            } yoksa {
                byte_yaz(a, 0x48); byte_yaz(a, 0x8B); byte_yaz(a, 0x80);
                int32_yaz(a, ae_field_off); # MOV RAX, [RAX + ae_field_off] (32-bit offset)
            }
        } yoksa {
            emit_xor_rax_rax(a); # Alan bulunamazsa 0 don
        }
        dondu 0;
    }

    # --------------------------------------------------------
    # AST_EGER (8): if/else => TEST RAX,RAX + JZ + geri yamala
    # --------------------------------------------------------
    eger dugum.tip == 8 ise { # AST_EGER
        ast_kod_uret(a, dugum.sol); # Sart -> RAX
        # TEST RAX, RAX
        byte_yaz(a, 0x48); byte_yaz(a, 0x85); byte_yaz(a, 0xC0);
        # JZ rel32 (yoksa blogu veya bitise atla)
        byte_yaz(a, 0x0F); byte_yaz(a, 0x84);
        degisken eger_jz_pos: tamsayi = a.kullanilan;
        int32_yaz(a, 0); # Yer tutucu, sonra yamalanacak
        # Eger blogu
        degisken if_body: *AstDugum = dugum.govde;
        eger if_body != 0 ise { ast_kod_uret(a, if_body); }
        eger dugum.yoksa_govde != 0 ise {
            # JMP rel32 (else blogu bittikten sonra atlayacak)
            byte_yaz(a, 0xE9);
            degisken eger_jmp_pos: tamsayi = a.kullanilan;
            int32_yaz(a, 0); # Yer tutucu
            # else_label: JZ buraya atlamali
            degisken else_label: tamsayi = a.kullanilan;
            int32_patch(a, eger_jz_pos, else_label - (eger_jz_pos + 4));
            # Yoksa blogu
            ast_kod_uret(a, dugum.yoksa_govde);
            # end_label: JMP buraya atlamali
            degisken eger_end_label: tamsayi = a.kullanilan;
            int32_patch(a, eger_jmp_pos, eger_end_label - (eger_jmp_pos + 4));
        } yoksa {
            # Yoksa yok, sadece JZ'yi bitise yamala
            degisken eger_end_label2: tamsayi = a.kullanilan;
            int32_patch(a, eger_jz_pos, eger_end_label2 - (eger_jz_pos + 4));
        }
        dondu 0;
    }

    # --------------------------------------------------------
    # AST_DONGU (9): while loop => TEST + JZ + govde + JMP geri
    # --------------------------------------------------------
    eger dugum.tip == 9 ise { # AST_DONGU
        degisken dongu_baslangic: tamsayi = a.kullanilan;

        # Dongu stack'e baslangici it
        degisken curr_loop_id: tamsayi = g_loop_stack_sp;
        g_loop_stack_bas[curr_loop_id] = dongu_baslangic;
        g_loop_stack_sp = g_loop_stack_sp + 1;
        degisken prev_durdur_adet: tamsayi = g_durdur_adet;

        degisken dongu_jz_pos: tamsayi = 0;
        # Sart varsa hesapla ve JZ ile bitise atla
        eger dugum.sol != 0 ise {
            ast_kod_uret(a, dugum.sol); # Sart -> RAX
            # TEST RAX, RAX
            byte_yaz(a, 0x48); byte_yaz(a, 0x85); byte_yaz(a, 0xC0);
            # JZ rel32 (dongu bitisine atla)
            byte_yaz(a, 0x0F); byte_yaz(a, 0x84);
            dongu_jz_pos = a.kullanilan;
            int32_yaz(a, 0); # Yer tutucu
        }
        # Dongu govdesi
        ast_kod_uret(a, dugum.govde);
        # JMP rel32 (dongu basina don)
        byte_yaz(a, 0xE9);
        degisken dongu_jmp_pos: tamsayi = a.kullanilan;
        degisken dongu_rip_after: tamsayi = dongu_jmp_pos + 4;
        int32_yaz(a, dongu_baslangic - dongu_rip_after);
        # Sart varsa JZ'yi buradaki konuma yamala
        degisken dongu_bitis: tamsayi = a.kullanilan;
        eger dugum.sol != 0 ise {
            int32_patch(a, dongu_jz_pos, dongu_bitis - (dongu_jz_pos + 4));
        }

        # Bu donguye ait DURDUR (break) atlamalarini yamala
        g_loop_stack_sp = g_loop_stack_sp - 1;
        degisken b_idx: tamsayi = prev_durdur_adet;
        dongu b_idx < g_durdur_adet {
            degisken break_ptr: tamsayi = g_durdur_yamalar[b_idx];
            int32_patch(a, break_ptr, dongu_bitis - (break_ptr + 4));
            b_idx = b_idx + 1;
        }
        g_durdur_adet = prev_durdur_adet;

        dondu 0;
    }

    # AST_DURDUR (14): break
    # --------------------------------------------------------
    eger dugum.tip == 14 ise {
        byte_yaz(a, 0xE9);
        degisken d_idx: tamsayi = g_durdur_adet;
        eger d_idx < 128 ise {
            g_durdur_yamalar[d_idx] = a.kullanilan;
            g_durdur_adet = d_idx + 1;
        }
        int32_yaz(a, 0); # Placeholder, to be patched
        dondu 0;
    }

    # AST_DEVAM_ET (15): continue
    # --------------------------------------------------------
    eger dugum.tip == 15 ise {
        byte_yaz(a, 0xE9);
        degisken loop_start: tamsayi = g_loop_stack_bas[g_loop_stack_sp - 1];
        degisken jmp_pos: tamsayi = a.kullanilan;
        int32_yaz(a, loop_start - (jmp_pos + 4));
        dondu 0;
    }

    eger dugum.sonraki != 0 ise { ast_kod_uret(a, dugum.sonraki); }
    dondu 0;
}

# ============================================================
# PE32+ Windows Executable Uretici - Import Table ile
#
# Bellek duzeni:
#   0x000 - 0x1FF  : Headers (DOS + PE + Section headers)
#   0x200 - 0x3FF  : .text   (RVA 0x1000, makine kodu)
#   0x400 - 0x5FF  : .rdata  (RVA 0x2000, import table + IAT + DLL/func isimleri)
#
# Import table icin gereken yapilar:
#   IMAGE_IMPORT_DESCRIPTOR (20 byte her DLL icin, son girdi sifir)
#   IAT (Import Address Table) - 8 byte her fonksiyon
#   INT (Import Name Table)    - 8 byte her fonksiyon  
#   Hint/Name kayitlari        - 2 byte hint + isim + null
#   DLL ismi                   - null-terminated string
#
# kernel32.dll'den 3 fonksiyon:
#   [0] ExitProcess
#   [1] WriteFile
#   [2] GetStdHandle
# ============================================================

isv int32_patch(a: *MakineKoduArenasi, pos: tamsayi, val: tamsayi) {
    degisken u: tamsayi = val;
    dongu u < 0 {
        u = u + 4294967296;
    }
    degisken b0: u8 = u % 256;
    degisken b1: u8 = (u / 256) % 256;
    degisken b2: u8 = (u / 65536) % 256;
    degisken b3: u8 = (u / 16777216) % 256;
    a.bellek[pos] = b0;
    a.bellek[pos + 1] = b1;
    a.bellek[pos + 2] = b2;
    a.bellek[pos + 3] = b3;
}

isv yamalari_uygula(a: *MakineKoduArenasi) {
    degisken i: tamsayi = 0;
    dongu i < g_yama_adet {
        degisken call_end: tamsayi = g_yama_cagri_pos[i] + 4;
        degisken j: tamsayi = 0;
        degisken bulundu: tamsayi = 0;
        dongu j < g_fonk_adet ve bulundu == 0 {
            eger g_fonk_isim[j] != 0 ve g_yama_isim[i] != 0 ise {
                eger g_fonk_uzunluk[j] == g_yama_uzunluk[i] ise {
                    eger bellek_esit_mi(g_fonk_isim[j], g_yama_isim[i], g_fonk_uzunluk[j]) == 1 ise {
                        int32_patch(a, g_yama_cagri_pos[i], g_fonk_adres[j] - call_end);
                        bulundu = 1;
                    }
                }
            }
            j = j + 1;
        }
        i = i + 1;
    }
}

isv bul_ana_adres() -> tamsayi {
    degisken j: tamsayi = 0;
    dongu j < g_fonk_adet {
        degisken f_uzn: tamsayi = g_fonk_uzunluk[j];
        degisken f_ptr: *u8 = g_fonk_isim[j];
        eger f_ptr != 0 ise {
            # Uzunluk 3: "ana" (TR), "本" (JA), "主" (ZH)
            eger f_uzn == 3 ise {
                eger bellek_esit_mi(f_ptr, "ana".ptr, 3) == 1 veya bellek_esit_mi(f_ptr, "本".ptr, 3) == 1 veya bellek_esit_mi(f_ptr, "主".ptr, 3) == 1 ise {
                    dondu 0x1000 + g_fonk_adres[j];
                }
            }
            # Uzunluk 4: "main" (EN)
            eger f_uzn == 4 ise {
                eger bellek_esit_mi(f_ptr, "main".ptr, 4) == 1 ise {
                    dondu 0x1000 + g_fonk_adres[j];
                }
            }
            # Uzunluk 6: "메인" (KO)
            eger f_uzn == 6 ise {
                eger bellek_esit_mi(f_ptr, "메인".ptr, 6) == 1 ise {
                    dondu 0x1000 + g_fonk_adres[j];
                }
            }
            # Uzunluk 9: "principal" (FR), "メイン" (JA), "主函数" (ZH)
            eger f_uzn == 9 ise {
                eger bellek_esit_mi(f_ptr, "principal".ptr, 9) == 1 veya bellek_esit_mi(f_ptr, "メイン".ptr, 9) == 1 veya bellek_esit_mi(f_ptr, "主函数".ptr, 9) == 1 ise {
                    dondu 0x1000 + g_fonk_adres[j];
                }
            }
            # Uzunluk 14: "главная" (RU)
            eger f_uzn == 14 ise {
                eger bellek_esit_mi(f_ptr, "главная".ptr, 14) == 1 ise {
                    dondu 0x1000 + g_fonk_adres[j];
                }
            }
        }
        j = j + 1;
    }
    dondu 0x1000;
}


isv baslangic_thunk_uret(a: *MakineKoduArenasi, ana_rva: tamsayi) -> tamsayi {
    degisken bas: tamsayi = a.kullanilan;
    degisken mb: *u8 = a.bellek;
    
    # 1. GetCommandLineA() cagir
    byte_yaz(a, 0x48); byte_yaz(a, 0x83); byte_yaz(a, 0xEC); byte_yaz(a, 0x28); # SUB RSP, 40
    byte_yaz(a, 0xFF); byte_yaz(a, 0x15);
    degisken iat_idx: tamsayi = g_iat_yama_adet;
    g_iat_yama_text_offset[iat_idx] = a.kullanilan;
    g_iat_yama_slot[iat_idx] = 7;
    g_iat_yama_adet = g_iat_yama_adet + 1;
    int32_yaz(a, 0);
    byte_yaz(a, 0x48); byte_yaz(a, 0x83); byte_yaz(a, 0xC4); byte_yaz(a, 0x28); # ADD RSP, 40
    
    # RCX = cmdline string
    byte_yaz(a, 0x48); byte_yaz(a, 0x89); byte_yaz(a, 0xC1); # MOV RCX, RAX

    # Loop 1: skip argv[0] (until space or NUL)
    degisken loop1_pos: tamsayi = a.kullanilan;
    byte_yaz(a, 0x80); byte_yaz(a, 0x39); byte_yaz(a, 0x00); # CMP byte [RCX], 0
    byte_yaz(a, 0x0F); byte_yaz(a, 0x84); # JE near -> no_arg
    degisken je_noarg_patch1: tamsayi = a.kullanilan;
    int32_yaz(a, 0);
    
    byte_yaz(a, 0x80); byte_yaz(a, 0x39); byte_yaz(a, 0x20); # CMP byte [RCX], ' '
    byte_yaz(a, 0x74); byte_yaz(a, 0x00); # JE -> skip_sp (patch later)
    degisken je_skipsp_patch: tamsayi = a.kullanilan - 1;
    
    byte_yaz(a, 0x48); byte_yaz(a, 0xFF); byte_yaz(a, 0xC1); # INC RCX
    byte_yaz(a, 0xEB);
    byte_yaz(a, loop1_pos - (a.kullanilan + 1)); # JMP loop1

    # skip_sp: skip spaces, also check for NUL
    degisken target_skipsp: tamsayi = a.kullanilan;
    a.bellek[je_skipsp_patch] = target_skipsp - (je_skipsp_patch + 1);
    degisken skip_sp_pos: tamsayi = a.kullanilan;
    
    byte_yaz(a, 0x80); byte_yaz(a, 0x39); byte_yaz(a, 0x00); # CMP byte [RCX], 0
    byte_yaz(a, 0x0F); byte_yaz(a, 0x84); # JE near -> no_arg
    degisken je_noarg_patch2: tamsayi = a.kullanilan;
    int32_yaz(a, 0);
    
    byte_yaz(a, 0x80); byte_yaz(a, 0x39); byte_yaz(a, 0x20); # CMP byte [RCX], ' '
    byte_yaz(a, 0x75); byte_yaz(a, 0x00); # JNE -> got_arg
    degisken jne_gotarg_patch: tamsayi = a.kullanilan - 1;
    
    byte_yaz(a, 0x48); byte_yaz(a, 0xFF); byte_yaz(a, 0xC1); # INC RCX
    byte_yaz(a, 0xEB);
    byte_yaz(a, skip_sp_pos - (a.kullanilan + 1)); # JMP skip_sp

    # got_arg: RCX = start of argv[1] string
    degisken target_gotarg: tamsayi = a.kullanilan;
    a.bellek[jne_gotarg_patch] = target_gotarg - (jne_gotarg_patch + 1);
    
    # Save argv[1] in R8, scan with RCX to null-terminate at space
    byte_yaz(a, 0x49); byte_yaz(a, 0x89); byte_yaz(a, 0xC8); # MOV R8, RCX
    degisken nul1_pos: tamsayi = a.kullanilan;
    byte_yaz(a, 0x80); byte_yaz(a, 0x39); byte_yaz(a, 0x00); # CMP byte [RCX], 0
    byte_yaz(a, 0x74); byte_yaz(a, 0x00); # JE -> done_nul
    degisken je_done_nul: tamsayi = a.kullanilan - 1;
    
    byte_yaz(a, 0x80); byte_yaz(a, 0x39); byte_yaz(a, 0x20); # CMP byte [RCX], ' '
    byte_yaz(a, 0x75); byte_yaz(a, 0x00); # JNE -> nul1_cont
    degisken jne_nul1_cont: tamsayi = a.kullanilan - 1;
    
    byte_yaz(a, 0xC6); byte_yaz(a, 0x01); byte_yaz(a, 0x00); # MOV byte [RCX], 0
    byte_yaz(a, 0xEB); byte_yaz(a, 0x00); # JMP done_nul
    degisken jmp_done2: tamsayi = a.kullanilan - 1;
    
    degisken cont_pos: tamsayi = a.kullanilan;
    a.bellek[jne_nul1_cont] = cont_pos - (jne_nul1_cont + 1);
    byte_yaz(a, 0x48); byte_yaz(a, 0xFF); byte_yaz(a, 0xC1); # INC RCX
    byte_yaz(a, 0xEB);
    byte_yaz(a, nul1_pos - (a.kullanilan + 1)); # JMP nul1
    
    degisken done_pos: tamsayi = a.kullanilan;
    a.bellek[je_done_nul] = done_pos - (je_done_nul + 1);
    a.bellek[jmp_done2] = done_pos - (jmp_done2 + 1);
    
    # Restore RCX = argv[1] start (R8)
    byte_yaz(a, 0x4C); byte_yaz(a, 0x89); byte_yaz(a, 0xC1); # MOV RCX, R8

    # Option path: --self-heal/--kendini-onar ve takip eden kaynak argumanini ilet.
    # Normal kaynak-only yolu asagida korunur.
    byte_yaz(a, 0x80); byte_yaz(a, 0x39); byte_yaz(a, 0x2D); # CMP byte [RCX], '-'
    byte_yaz(a, 0x0F); byte_yaz(a, 0x85);
    degisken jne_option_path1: tamsayi = a.kullanilan;
    int32_yaz(a, 0);
    byte_yaz(a, 0x80); byte_yaz(a, 0x79); byte_yaz(a, 0x01); byte_yaz(a, 0x2D); # CMP byte [RCX+1], '-'
    byte_yaz(a, 0x0F); byte_yaz(a, 0x85);
    degisken jne_option_path2: tamsayi = a.kullanilan;
    int32_yaz(a, 0);

    # R9 = option metninin NUL sonrasindaki kaynak argumani.
    byte_yaz(a, 0x4D); byte_yaz(a, 0x89); byte_yaz(a, 0xC1); # MOV R9,R8
    degisken option_end_scan: tamsayi = a.kullanilan;
    byte_yaz(a, 0x41); byte_yaz(a, 0x80); byte_yaz(a, 0x39); byte_yaz(a, 0x00); # CMP [R9],0
    byte_yaz(a, 0x74); byte_yaz(a, 0x00);
    degisken je_option_end_scan: tamsayi = a.kullanilan - 1;
    byte_yaz(a, 0x49); byte_yaz(a, 0xFF); byte_yaz(a, 0xC1); # INC R9
    byte_yaz(a, 0xEB);
    # EB opcode'u zaten yazildi; a.kullanilan simdi rel8 byte'ini gosteriyor.
    byte_yaz(a, option_end_scan - (a.kullanilan + 1));
    degisken option_after_flag: tamsayi = a.kullanilan;
    a.bellek[je_option_end_scan] = option_after_flag - (je_option_end_scan + 1);
    byte_yaz(a, 0x49); byte_yaz(a, 0xFF); byte_yaz(a, 0xC1); # replaced NUL'u gec

    degisken option_skip_spaces: tamsayi = a.kullanilan;
    byte_yaz(a, 0x41); byte_yaz(a, 0x80); byte_yaz(a, 0x39); byte_yaz(a, 0x20); # CMP [R9],' '
    byte_yaz(a, 0x75); byte_yaz(a, 0x00);
    degisken jne_option_source: tamsayi = a.kullanilan - 1;
    byte_yaz(a, 0x49); byte_yaz(a, 0xFF); byte_yaz(a, 0xC1); # INC R9
    byte_yaz(a, 0xEB);
    # EB opcode'u zaten yazildi; a.kullanilan simdi rel8 byte'ini gosteriyor.
    byte_yaz(a, option_skip_spaces - (a.kullanilan + 1));
    degisken option_source_start: tamsayi = a.kullanilan;
    a.bellek[jne_option_source] = option_source_start - (jne_option_source + 1);

    # Kaynak argumanini da boslukta NUL ile bitir.
    byte_yaz(a, 0x4D); byte_yaz(a, 0x31); byte_yaz(a, 0xD2); # XOR R10,R10 (cikti yok varsayimi)
    byte_yaz(a, 0x4C); byte_yaz(a, 0x89); byte_yaz(a, 0xC9); # MOV RCX,R9
    degisken option_source_scan: tamsayi = a.kullanilan;
    byte_yaz(a, 0x80); byte_yaz(a, 0x39); byte_yaz(a, 0x00); # CMP [RCX],0
    byte_yaz(a, 0x74); byte_yaz(a, 0x00);
    degisken je_option_source_done: tamsayi = a.kullanilan - 1;
    byte_yaz(a, 0x80); byte_yaz(a, 0x39); byte_yaz(a, 0x20); # CMP [RCX],' '
    byte_yaz(a, 0x74); byte_yaz(a, 0x00);
    degisken je_option_source_write: tamsayi = a.kullanilan - 1;
    byte_yaz(a, 0x48); byte_yaz(a, 0xFF); byte_yaz(a, 0xC1); # INC RCX
    byte_yaz(a, 0xEB); byte_yaz(a, 0x00);
    degisken jmp_option_source_scan: tamsayi = a.kullanilan - 1;
    degisken option_source_write: tamsayi = a.kullanilan;
    a.bellek[je_option_source_write] = option_source_write - (je_option_source_write + 1);
    byte_yaz(a, 0x49); byte_yaz(a, 0x89); byte_yaz(a, 0xCA); # MOV R10,RCX (bosluk ayirici)
    byte_yaz(a, 0x49); byte_yaz(a, 0xFF); byte_yaz(a, 0xC2); # INC R10 (cikti baslangici)
    byte_yaz(a, 0xC6); byte_yaz(a, 0x01); byte_yaz(a, 0x00); # MOV byte [RCX],0
    degisken option_source_done: tamsayi = a.kullanilan;
    a.bellek[je_option_source_done] = option_source_done - (je_option_source_done + 1);
    a.bellek[jmp_option_source_scan] = option_source_scan - (jmp_option_source_scan + 1);

    # Kaynak ayiricidan sonra gelen istege bagli cikti yolunu R10'dan al.
    byte_yaz(a, 0x4D); byte_yaz(a, 0x85); byte_yaz(a, 0xD2); # TEST R10,R10
    byte_yaz(a, 0x0F); byte_yaz(a, 0x84);
    degisken je_option_no_output0: tamsayi = a.kullanilan;
    int32_yaz(a, 0);
    byte_yaz(a, 0x41); byte_yaz(a, 0x80); byte_yaz(a, 0x3A); byte_yaz(a, 0x00); # CMP [R10],0
    byte_yaz(a, 0x0F); byte_yaz(a, 0x84);
    degisken je_option_no_output1: tamsayi = a.kullanilan;
    int32_yaz(a, 0);
    degisken option_output_skip: tamsayi = a.kullanilan;
    byte_yaz(a, 0x41); byte_yaz(a, 0x80); byte_yaz(a, 0x3A); byte_yaz(a, 0x20); # CMP [R10],' '
    byte_yaz(a, 0x0F); byte_yaz(a, 0x85);
    degisken jne_option_output_start: tamsayi = a.kullanilan;
    int32_yaz(a, 0);
    byte_yaz(a, 0x49); byte_yaz(a, 0xFF); byte_yaz(a, 0xC2); # INC R10
    byte_yaz(a, 0xEB);
    byte_yaz(a, option_output_skip - (a.kullanilan + 1));
    degisken option_output_start: tamsayi = a.kullanilan;
    int32_patch(a, jne_option_output_start, option_output_start - (jne_option_output_start + 4));
    byte_yaz(a, 0x41); byte_yaz(a, 0x80); byte_yaz(a, 0x3A); byte_yaz(a, 0x00); # CMP [R10],0
    byte_yaz(a, 0x0F); byte_yaz(a, 0x84);
    degisken je_option_no_output2: tamsayi = a.kullanilan;
    int32_yaz(a, 0);

    # argv[4] = { NULL, kaynak, flag, cikti } olustur ve ana(4,...) cagir.
    byte_yaz(a, 0x41); byte_yaz(a, 0x51); # PUSH R9
    byte_yaz(a, 0x41); byte_yaz(a, 0x50); # PUSH R8
    byte_yaz(a, 0x48); byte_yaz(a, 0x83); byte_yaz(a, 0xEC); byte_yaz(a, 0x48); # SUB RSP,72 (alignment + argv[4])
    byte_yaz(a, 0x48); byte_yaz(a, 0xC7); byte_yaz(a, 0x44); byte_yaz(a, 0x24); byte_yaz(a, 0x20); int32_yaz(a, 0);
    byte_yaz(a, 0x4C); byte_yaz(a, 0x89); byte_yaz(a, 0x4C); byte_yaz(a, 0x24); byte_yaz(a, 0x28); # argv[1]=R9 (kaynak)
    byte_yaz(a, 0x4C); byte_yaz(a, 0x89); byte_yaz(a, 0x44); byte_yaz(a, 0x24); byte_yaz(a, 0x30); # argv[2]=R8 (flag)
    byte_yaz(a, 0x4C); byte_yaz(a, 0x89); byte_yaz(a, 0x54); byte_yaz(a, 0x24); byte_yaz(a, 0x38); # argv[3]=R10 (cikti)
    byte_yaz(a, 0x48); byte_yaz(a, 0x8D); byte_yaz(a, 0x54); byte_yaz(a, 0x24); byte_yaz(a, 0x20); # LEA RDX,[RSP+32]
    byte_yaz(a, 0x48); byte_yaz(a, 0xC7); byte_yaz(a, 0xC1); int32_yaz(a, 4); # MOV RCX,4
    byte_yaz(a, 0xE8);
    degisken option_call_pos4: tamsayi = a.kullanilan;
    int32_yaz(a, ana_rva - (0x1000 + option_call_pos4 + 4));
    byte_yaz(a, 0x48); byte_yaz(a, 0x89); byte_yaz(a, 0xC5); # MOV RBP,RAX
    byte_yaz(a, 0x48); byte_yaz(a, 0x83); byte_yaz(a, 0xC4); byte_yaz(a, 0x48); # ADD RSP,72
    byte_yaz(a, 0x48); byte_yaz(a, 0x83); byte_yaz(a, 0xC4); byte_yaz(a, 0x10); # ADD RSP,16
    byte_yaz(a, 0xE9);
    degisken jmp_option_output_exit: tamsayi = a.kullanilan;
    int32_yaz(a, 0);

    # Cikti yolu yoksa eski argv[3] yolunu kullan.
    degisken option_no_output: tamsayi = a.kullanilan;
    int32_patch(a, je_option_no_output0, option_no_output - (je_option_no_output0 + 4));
    int32_patch(a, je_option_no_output1, option_no_output - (je_option_no_output1 + 4));
    int32_patch(a, je_option_no_output2, option_no_output - (je_option_no_output2 + 4));
    byte_yaz(a, 0x41); byte_yaz(a, 0x51); # PUSH R9
    byte_yaz(a, 0x41); byte_yaz(a, 0x50); # PUSH R8
    byte_yaz(a, 0x48); byte_yaz(a, 0x83); byte_yaz(a, 0xEC); byte_yaz(a, 0x38); # SUB RSP,56
    byte_yaz(a, 0x48); byte_yaz(a, 0xC7); byte_yaz(a, 0x44); byte_yaz(a, 0x24); byte_yaz(a, 0x20); int32_yaz(a, 0);
    byte_yaz(a, 0x4C); byte_yaz(a, 0x89); byte_yaz(a, 0x4C); byte_yaz(a, 0x24); byte_yaz(a, 0x28); # argv[1]=R9 (kaynak)
    byte_yaz(a, 0x4C); byte_yaz(a, 0x89); byte_yaz(a, 0x44); byte_yaz(a, 0x24); byte_yaz(a, 0x30); # argv[2]=R8 (flag)
    byte_yaz(a, 0x48); byte_yaz(a, 0x8D); byte_yaz(a, 0x54); byte_yaz(a, 0x24); byte_yaz(a, 0x20); # LEA RDX,[RSP+32]
    byte_yaz(a, 0x48); byte_yaz(a, 0xC7); byte_yaz(a, 0xC1); int32_yaz(a, 3); # MOV RCX,3
    byte_yaz(a, 0xE8);
    degisken option_call_pos3: tamsayi = a.kullanilan;
    int32_yaz(a, ana_rva - (0x1000 + option_call_pos3 + 4));
    byte_yaz(a, 0x48); byte_yaz(a, 0x89); byte_yaz(a, 0xC5); # MOV RBP,RAX
    byte_yaz(a, 0x48); byte_yaz(a, 0x83); byte_yaz(a, 0xC4); byte_yaz(a, 0x38); # ADD RSP,56
    byte_yaz(a, 0x48); byte_yaz(a, 0x83); byte_yaz(a, 0xC4); byte_yaz(a, 0x10); # ADD RSP,16

    degisken option_exit_common: tamsayi = a.kullanilan;
    int32_patch(a, jmp_option_output_exit, option_exit_common - (jmp_option_output_exit + 4));
    byte_yaz(a, 0x48); byte_yaz(a, 0x83); byte_yaz(a, 0xEC); byte_yaz(a, 0x28); # SUB RSP,40
    byte_yaz(a, 0x48); byte_yaz(a, 0x89); byte_yaz(a, 0xE9); # MOV RCX,RBP
    byte_yaz(a, 0xFF); byte_yaz(a, 0x15);
    degisken option_exit_iat: tamsayi = g_iat_yama_adet;
    g_iat_yama_text_offset[option_exit_iat] = a.kullanilan;
    g_iat_yama_slot[option_exit_iat] = 0;
    g_iat_yama_adet = g_iat_yama_adet + 1;
    int32_yaz(a, 0);

    # Normal kaynak-only yolu.
    degisken normal_option_target: tamsayi = a.kullanilan;
    int32_patch(a, jne_option_path1, normal_option_target - (jne_option_path1 + 4));
    int32_patch(a, jne_option_path2, normal_option_target - (jne_option_path2 + 4));

    # argc=2 path: call ana(2, &argv[0])
    byte_yaz(a, 0x51); # PUSH RCX
    byte_yaz(a, 0x48); byte_yaz(a, 0x83); byte_yaz(a, 0xEC); byte_yaz(a, 0x30); # SUB RSP, 48
    byte_yaz(a, 0x48); byte_yaz(a, 0xC7); byte_yaz(a, 0x44); byte_yaz(a, 0x24); byte_yaz(a, 0x20); int32_yaz(a, 0); # [RSP+32]=NULL
    byte_yaz(a, 0x48); byte_yaz(a, 0x8B); byte_yaz(a, 0x44); byte_yaz(a, 0x24); byte_yaz(a, 0x30); # MOV RAX, [RSP+48]
    byte_yaz(a, 0x48); byte_yaz(a, 0x89); byte_yaz(a, 0x44); byte_yaz(a, 0x24); byte_yaz(a, 0x28); # MOV [RSP+40], RAX
    byte_yaz(a, 0x48); byte_yaz(a, 0x8D); byte_yaz(a, 0x54); byte_yaz(a, 0x24); byte_yaz(a, 0x20); # LEA RDX, [RSP+32]
    byte_yaz(a, 0x48); byte_yaz(a, 0xC7); byte_yaz(a, 0xC1); int32_yaz(a, 2); # MOV RCX, 2
    byte_yaz(a, 0xE8); # CALL ana
    degisken call_pos: tamsayi = a.kullanilan;
    int32_yaz(a, ana_rva - (0x1000 + call_pos + 4));
    byte_yaz(a, 0x48); byte_yaz(a, 0x89); byte_yaz(a, 0xC5); # MOV RBP, RAX (save exit code)
    byte_yaz(a, 0x48); byte_yaz(a, 0x83); byte_yaz(a, 0xC4); byte_yaz(a, 0x30); # ADD RSP, 48
    byte_yaz(a, 0x59); # POP RCX
    
    # ExitProcess(RBP)
    byte_yaz(a, 0x48); byte_yaz(a, 0x83); byte_yaz(a, 0xEC); byte_yaz(a, 0x28); # SUB RSP, 40
    byte_yaz(a, 0x48); byte_yaz(a, 0x89); byte_yaz(a, 0xE9); # MOV RCX, RBP
    byte_yaz(a, 0xFF); byte_yaz(a, 0x15);
    degisken exit_iat: tamsayi = g_iat_yama_adet;
    g_iat_yama_text_offset[exit_iat] = a.kullanilan;
    g_iat_yama_slot[exit_iat] = 0;
    g_iat_yama_adet = g_iat_yama_adet + 1;
    int32_yaz(a, 0);
    
    # JMP over noarg
    byte_yaz(a, 0xEB); byte_yaz(a, 0x00);
    degisken jmp_over_noarg_patch: tamsayi = a.kullanilan - 1;

    # no_arg: call ana(1, NULL)
    degisken noarg_target: tamsayi = a.kullanilan;
    int32_patch(a, je_noarg_patch1, noarg_target - (je_noarg_patch1 + 4));
    int32_patch(a, je_noarg_patch2, noarg_target - (je_noarg_patch2 + 4));
    
    byte_yaz(a, 0x48); byte_yaz(a, 0x83); byte_yaz(a, 0xEC); byte_yaz(a, 0x28); # SUB RSP, 40
    byte_yaz(a, 0x48); byte_yaz(a, 0xC7); byte_yaz(a, 0xC1); int32_yaz(a, 1); # MOV RCX, 1
    byte_yaz(a, 0x48); byte_yaz(a, 0x31); byte_yaz(a, 0xD2); # XOR RDX, RDX
    byte_yaz(a, 0xE8); # CALL ana
    degisken noarg_call: tamsayi = a.kullanilan;
    int32_yaz(a, ana_rva - (0x1000 + noarg_call + 4));
    byte_yaz(a, 0x48); byte_yaz(a, 0x89); byte_yaz(a, 0xC1); # MOV RCX, RAX
    byte_yaz(a, 0xFF); byte_yaz(a, 0x15);
    degisken exit_iat2: tamsayi = g_iat_yama_adet;
    g_iat_yama_text_offset[exit_iat2] = a.kullanilan;
    g_iat_yama_slot[exit_iat2] = 0;
    g_iat_yama_adet = g_iat_yama_adet + 1;
    int32_yaz(a, 0);

    # Patch jmp_over_noarg
    degisken end_target: tamsayi = a.kullanilan;
    a.bellek[jmp_over_noarg_patch] = end_target - (jmp_over_noarg_patch + 1);

    dondu 0x1000 + bas;
}
isv pe32plus_uret(kod_arenasi: *MakineKoduArenasi, cikti: *MakineKoduArenasi, ep_rva: tamsayi) {

    yamalari_uygula(kod_arenasi);
    ekrana_yaz("PE: Constants calculating...\n".ptr);

    # Sabitler
    degisken IMAGE_BASE:    tamsayi = 0x400000;
    degisken SEC_ALIGN:     tamsayi = 0x1000;
    degisken FILE_ALIGN:    tamsayi = 0x200;
    degisken TEXT_RVA:      tamsayi = 0x1000;


    # .text boyutu (file-aligned)
    degisken text_raw:  tamsayi = kod_arenasi.kullanilan;
    degisken text_file: tamsayi = hizala_yukari(text_raw, FILE_ALIGN);
    degisken RDATA_RVA: tamsayi = hizala_yukari(TEXT_RVA + text_raw, SEC_ALIGN);

    # .rdata icerigi: 10-slot IAT+INT + all hint/name kayitlari.
    degisken size_rdata: tamsayi = 0x160;
    degisken size_rdata_file: tamsayi = hizala_yukari(size_rdata, FILE_ALIGN);
    degisken rdata_file: tamsayi = FILE_ALIGN + text_file;
    ekrana_yaz("PE: RVA calculating...\n".ptr);

    # RVA hesaplari (RDATA_RVA baz alinarak)
    degisken rva_idt:       tamsayi = RDATA_RVA;          # Import Descriptor Table
    degisken rva_iat:       tamsayi = RDATA_RVA + 0x28;
    degisken rva_int:       tamsayi = RDATA_RVA + 0x78;
    degisken rva_hn_exit:   tamsayi = RDATA_RVA + 0xC8;
    degisken rva_hn_write:  tamsayi = RDATA_RVA + 0xD6;
    degisken rva_hn_getstd: tamsayi = RDATA_RVA + 0xE2;
    degisken rva_hn_valloc: tamsayi = RDATA_RVA + 0xF2;
    degisken rva_hn_crtfl:  tamsayi = RDATA_RVA + 0x102;
    degisken rva_hn_rdfl:   tamsayi = RDATA_RVA + 0x110;
    degisken rva_hn_clhnd:  tamsayi = RDATA_RVA + 0x11C;
    degisken rva_hn_gcla:   tamsayi = RDATA_RVA + 0x12A;
    degisken rva_hn_sfp:    tamsayi = RDATA_RVA + 0x13C;
    degisken rva_dllname:   tamsayi = RDATA_RVA + 0x14F;

    # IAT adresleri (programdan CALL icin kullanilacak)
    # VA = IMAGE_BASE + rva
    degisken va_iat_exit:   tamsayi = IMAGE_BASE + rva_iat;
    degisken va_iat_write:  tamsayi = ((IMAGE_BASE + rva_iat) + 8);
    degisken va_iat_getstd: tamsayi = ((IMAGE_BASE + rva_iat) + 16);
    degisken image_size:    tamsayi = hizala_yukari(RDATA_RVA + SEC_ALIGN, SEC_ALIGN);
    ekrana_yaz("PE: DOS Header...\n".ptr);

    # --------------------------------------------------------
    # DOS Header (64 byte)
    # --------------------------------------------------------
    byte_yaz(cikti, 0x4D); byte_yaz(cikti, 0x5A);  # MZ
    u16_yaz(cikti, 0x90);  u16_yaz(cikti, 0x03);
    u16_yaz(cikti, 0x00);  u16_yaz(cikti, 0x04);
    u16_yaz(cikti, 0x00);  u16_yaz(cikti, 0xFFFF);
    u16_yaz(cikti, 0x00);  u16_yaz(cikti, 0xB8);
    u16_yaz(cikti, 0x00);  u16_yaz(cikti, 0x00);
    u16_yaz(cikti, 0x00);  u16_yaz(cikti, 0x40);
    u16_yaz(cikti, 0x00);
    sifir_doldur(cikti, 8);
    u16_yaz(cikti, 0x00); u16_yaz(cikti, 0x00);
    sifir_doldur(cikti, 20);
    int32_yaz(cikti, 0x40);  # e_lfanew = 0x40

    # --------------------------------------------------------
    # PE Signature
    # --------------------------------------------------------
    byte_yaz(cikti, 0x50); byte_yaz(cikti, 0x45);  # PE
    byte_yaz(cikti, 0x00); byte_yaz(cikti, 0x00);

    # --------------------------------------------------------
    # COFF File Header (20 byte)
    # --------------------------------------------------------
    u16_yaz(cikti, 0x8664);   # AMD64
    u16_yaz(cikti, 2);         # 2 section: .text + .rdata
    int32_yaz(cikti, 0);       # TimeDateStamp
    int32_yaz(cikti, 0);       # PointerToSymbolTable
    int32_yaz(cikti, 0);       # NumberOfSymbols
    u16_yaz(cikti, 0xF0);     # SizeOfOptionalHeader
    u16_yaz(cikti, 0x0022);   # Characteristics: EXE | 64-bit

    # --------------------------------------------------------
    # Optional Header PE32+ (240 byte)
    # --------------------------------------------------------
    u16_yaz(cikti, 0x020B);   # Magic PE32+
    byte_yaz(cikti, 14);       # MajorLinkerVersion
    byte_yaz(cikti, 0);        # MinorLinkerVersion
    int32_yaz(cikti, text_file);     # SizeOfCode
    int32_yaz(cikti, size_rdata_file); # SizeOfInitializedData
    int32_yaz(cikti, 0);       # SizeOfUninitializedData
    int32_yaz(cikti, ep_rva); # AddressOfEntryPoint
    int32_yaz(cikti, TEXT_RVA); # BaseOfCode
    int64_yaz(cikti, IMAGE_BASE); # ImageBase
    int32_yaz(cikti, SEC_ALIGN);  # SectionAlignment
    int32_yaz(cikti, FILE_ALIGN); # FileAlignment
    u16_yaz(cikti, 6); u16_yaz(cikti, 0);  # OS version
    u16_yaz(cikti, 0); u16_yaz(cikti, 0);  # Image version
    u16_yaz(cikti, 6); u16_yaz(cikti, 0);  # Subsystem version
    int32_yaz(cikti, 0);       # Win32VersionValue
    int32_yaz(cikti, image_size); # SizeOfImage
    int32_yaz(cikti, FILE_ALIGN); # SizeOfHeaders
    int32_yaz(cikti, 0);       # CheckSum
    u16_yaz(cikti, 3);         # Subsystem: CUI
    u16_yaz(cikti, 0x8160);   # DllCharacteristics
    int64_yaz(cikti, 0x100000); # SizeOfStackReserve
    int64_yaz(cikti, 0x1000);   # SizeOfStackCommit
    int64_yaz(cikti, 0x100000); # SizeOfHeapReserve
    int64_yaz(cikti, 0x1000);   # SizeOfHeapCommit
    int32_yaz(cikti, 0);        # LoaderFlags
    int32_yaz(cikti, 16);       # NumberOfRvaAndSizes

    # Data Directories (16 x 8 byte = 128 byte)
    # [0] Export  - bos
    int32_yaz(cikti, 0); int32_yaz(cikti, 0);
    # [1] Import  - .rdata'daki IDT
    int32_yaz(cikti, rva_idt); int32_yaz(cikti, 40);
    # [2..4] bos
    sifir_doldur(cikti, 24);
    # [5] IAT: size = 10 entries * 8 = 80 bytes
    int32_yaz(cikti, rva_iat); int32_yaz(cikti, 80);
    # [6..15] bos
    sifir_doldur(cikti, 80);

    # --------------------------------------------------------
    # Section Header 1: .text
    # --------------------------------------------------------
    byte_yaz(cikti, 0x2E); byte_yaz(cikti, 0x74); byte_yaz(cikti, 0x65); byte_yaz(cikti, 0x78);
    byte_yaz(cikti, 0x74); byte_yaz(cikti, 0x00); byte_yaz(cikti, 0x00); byte_yaz(cikti, 0x00);
    int32_yaz(cikti, text_raw);      # VirtualSize
    int32_yaz(cikti, TEXT_RVA);      # VirtualAddress
    int32_yaz(cikti, text_file);     # SizeOfRawData
    int32_yaz(cikti, FILE_ALIGN);    # PointerToRawData
    int32_yaz(cikti, 0); int32_yaz(cikti, 0);
    u16_yaz(cikti, 0); u16_yaz(cikti, 0);
    int32_yaz(cikti, 0xE0000020);    # CODE | EXECUTE | READ | WRITE

    # Section Header 2: .rdata
    byte_yaz(cikti, 0x2E); byte_yaz(cikti, 0x72); byte_yaz(cikti, 0x64); byte_yaz(cikti, 0x61);
    byte_yaz(cikti, 0x74); byte_yaz(cikti, 0x61); byte_yaz(cikti, 0x00); byte_yaz(cikti, 0x00);
    int32_yaz(cikti, size_rdata);             # VirtualSize
    int32_yaz(cikti, RDATA_RVA);              # VirtualAddress
    int32_yaz(cikti, size_rdata_file);        # SizeOfRawData
    int32_yaz(cikti, FILE_ALIGN + text_file); # PointerToRawData
    int32_yaz(cikti, 0); int32_yaz(cikti, 0);
    u16_yaz(cikti, 0); u16_yaz(cikti, 0);
    int32_yaz(cikti, 0x40000040);    # INITIALIZED_DATA | READ

    # Headers'i 0x200'e hizala
    sifir_doldur(cikti, FILE_ALIGN - cikti.kullanilan);

    # --------------------------------------------------------
    # .text section (offset 0x200)
    # --------------------------------------------------------
    degisken i: tamsayi = 0;
    dongu i < kod_arenasi.kullanilan {
        byte_yaz(cikti, kod_arenasi.bellek[i]);
        i = i + 1;
    }
    sifir_doldur(cikti, text_file - text_raw);

    # IAT rel32 placeholder'larini gercek degerlerle yamala
    degisken pi: tamsayi = 0;
    dongu pi < g_iat_yama_adet {
        degisken text_off: tamsayi = g_iat_yama_text_offset[pi];
        degisken slot: tamsayi = g_iat_yama_slot[pi];
        # slot 1=WriteFile=(rva_iat+8), slot 2=GetStdHandle=(rva_iat+16)
        degisken iat_rva: tamsayi = rva_iat + (slot * 8);
        # RIP after CALL [RIP+rel32] = TEXT_RVA + text_off + 4
        degisken rip_after: tamsayi = TEXT_RVA + text_off + 4;
        degisken rel32: tamsayi = iat_rva - rip_after;
        eger rel32 < 0 ise { rel32 = rel32 + 4294967296; }
        # Cikti'daki konumu: FILE_ALIGN + text_off
        degisken cikti_off: tamsayi = FILE_ALIGN + text_off;
        cikti.bellek[cikti_off + 0] = rel32 % 256;
        rel32 = rel32 / 256;
        cikti.bellek[cikti_off + 1] = rel32 % 256;
        rel32 = rel32 / 256;
        cikti.bellek[cikti_off + 2] = rel32 % 256;
        rel32 = rel32 / 256;
        cikti.bellek[cikti_off + 3] = rel32 % 256;
        pi = pi + 1;
    }


    # --------------------------------------------------------
    # .rdata section (offset 0x200 + text_file)
    # Import Descriptor Table (IDT)
    # --------------------------------------------------------

    # IDT[0]: kernel32.dll
    int32_yaz(cikti, rva_int);      # OriginalFirstThunk (INT RVA)
    int32_yaz(cikti, 0);            # TimeDateStamp
    int32_yaz(cikti, 0);            # ForwarderChain
    int32_yaz(cikti, rva_dllname);  # Name RVA
    int32_yaz(cikti, rva_iat);      # FirstThunk (IAT RVA)

    # IDT[1]: null terminator
    sifir_doldur(cikti, 20);

    # --------------------------------------------------------
    # IAT - Import Address Table (ofset 0x28'de)
    # Yukleme oncesi INT kopyasi, loader bunlari gercek adresle doldurur
    # --------------------------------------------------------
    # IAT: ExitProcess, WriteFile, GetStdHandle, VirtualAlloc, CreateFileA,
    #      ReadFile, CloseHandle, GetCommandLineA, SetFilePointerEx, null
    int64_yaz(cikti, rva_hn_exit);
    int64_yaz(cikti, rva_hn_write);
    int64_yaz(cikti, rva_hn_getstd);
    int64_yaz(cikti, rva_hn_valloc);
    int64_yaz(cikti, rva_hn_crtfl);
    int64_yaz(cikti, rva_hn_rdfl);
    int64_yaz(cikti, rva_hn_clhnd);
    int64_yaz(cikti, rva_hn_gcla);
    int64_yaz(cikti, rva_hn_sfp);
    int64_yaz(cikti, 0);

    # INT: ayni
    int64_yaz(cikti, rva_hn_exit);
    int64_yaz(cikti, rva_hn_write);
    int64_yaz(cikti, rva_hn_getstd);
    int64_yaz(cikti, rva_hn_valloc);
    int64_yaz(cikti, rva_hn_crtfl);
    int64_yaz(cikti, rva_hn_rdfl);
    int64_yaz(cikti, rva_hn_clhnd);
    int64_yaz(cikti, rva_hn_gcla);
    int64_yaz(cikti, rva_hn_sfp);
    int64_yaz(cikti, 0);

    # --------------------------------------------------------
    # Hint/Name kayitlari (ofset 0xC8'de)
    # --------------------------------------------------------
    # ExitProcess (ofset 0x68)
    u16_yaz(cikti, 0);
    byte_yaz(cikti, 69);  # E
    byte_yaz(cikti, 120); # x
    byte_yaz(cikti, 105); # i
    byte_yaz(cikti, 116); # t
    byte_yaz(cikti, 80);  # P
    byte_yaz(cikti, 114); # r
    byte_yaz(cikti, 111); # o
    byte_yaz(cikti, 99);  # c
    byte_yaz(cikti, 101); # e
    byte_yaz(cikti, 115); # s
    byte_yaz(cikti, 115); # s
    byte_yaz(cikti, 0);   # null

    # WriteFile (ofset 0x76)
    u16_yaz(cikti, 0);
    byte_yaz(cikti, 87);  # W
    byte_yaz(cikti, 114); # r
    byte_yaz(cikti, 105); # i
    byte_yaz(cikti, 116); # t
    byte_yaz(cikti, 101); # e
    byte_yaz(cikti, 70);  # F
    byte_yaz(cikti, 105); # i
    byte_yaz(cikti, 108); # l
    byte_yaz(cikti, 101); # e
    byte_yaz(cikti, 0);   # null

    # GetStdHandle (ofset 0x82)
    u16_yaz(cikti, 0);
    byte_yaz(cikti, 71);  # G
    byte_yaz(cikti, 101); # e
    byte_yaz(cikti, 116); # t
    byte_yaz(cikti, 83);  # S
    byte_yaz(cikti, 116); # t
    byte_yaz(cikti, 100); # d
    byte_yaz(cikti, 72);  # H
    byte_yaz(cikti, 97);  # a
    byte_yaz(cikti, 110); # n
    byte_yaz(cikti, 100); # d
    byte_yaz(cikti, 108); # l
    byte_yaz(cikti, 101); # e
    byte_yaz(cikti, 0);   # null (ends at 0xA1)
    byte_yaz(cikti, 0);   # padding -> word-aligned at 0xA2

    # VirtualAlloc Hint/Name (ofset 0xA2)
    u16_yaz(cikti, 0);
    byte_yaz(cikti, 86);  # V
    byte_yaz(cikti, 105); # i
    byte_yaz(cikti, 114); # r
    byte_yaz(cikti, 116); # t
    byte_yaz(cikti, 117); # u
    byte_yaz(cikti, 97);  # a
    byte_yaz(cikti, 108); # l
    byte_yaz(cikti, 65);  # A
    byte_yaz(cikti, 108); # l
    byte_yaz(cikti, 108); # l
    byte_yaz(cikti, 111); # o
    byte_yaz(cikti, 99);  # c
    byte_yaz(cikti, 0);   # null
    byte_yaz(cikti, 0);   # padding -> word-aligned

    # CreateFileA Hint/Name (2+11+1 = 14 byte)
    u16_yaz(cikti, 0);
    byte_yaz(cikti, 67);  # C
    byte_yaz(cikti, 114); # r
    byte_yaz(cikti, 101); # e
    byte_yaz(cikti, 97);  # a
    byte_yaz(cikti, 116); # t
    byte_yaz(cikti, 101); # e
    byte_yaz(cikti, 70);  # F
    byte_yaz(cikti, 105); # i
    byte_yaz(cikti, 108); # l
    byte_yaz(cikti, 101); # e
    byte_yaz(cikti, 65);  # A
    byte_yaz(cikti, 0);   # null

    # ReadFile Hint/Name (2+8+1+1pad = 12 byte)
    u16_yaz(cikti, 0);
    byte_yaz(cikti, 82);  # R
    byte_yaz(cikti, 101); # e
    byte_yaz(cikti, 97);  # a
    byte_yaz(cikti, 100); # d
    byte_yaz(cikti, 70);  # F
    byte_yaz(cikti, 105); # i
    byte_yaz(cikti, 108); # l
    byte_yaz(cikti, 101); # e
    byte_yaz(cikti, 0);   # null
    byte_yaz(cikti, 0);   # padding -> word-aligned

    # CloseHandle Hint/Name (2+11+1 = 14 byte)
    u16_yaz(cikti, 0);
    byte_yaz(cikti, 67);  # C
    byte_yaz(cikti, 108); # l
    byte_yaz(cikti, 111); # o
    byte_yaz(cikti, 115); # s
    byte_yaz(cikti, 101); # e
    byte_yaz(cikti, 72);  # H
    byte_yaz(cikti, 97);  # a
    byte_yaz(cikti, 110); # n
    byte_yaz(cikti, 100); # d
    byte_yaz(cikti, 108); # l
    byte_yaz(cikti, 101); # e
    byte_yaz(cikti, 0);   # null

    # GetCommandLineA Hint/Name (2+15+1 = 18 byte)
    u16_yaz(cikti, 0);
    byte_yaz(cikti, 71);  # G
    byte_yaz(cikti, 101); # e
    byte_yaz(cikti, 116); # t
    byte_yaz(cikti, 67);  # C
    byte_yaz(cikti, 111); # o
    byte_yaz(cikti, 109); # m
    byte_yaz(cikti, 109); # m
    byte_yaz(cikti, 97);  # a
    byte_yaz(cikti, 110); # n
    byte_yaz(cikti, 100); # d
    byte_yaz(cikti, 76);  # L
    byte_yaz(cikti, 105); # i
    byte_yaz(cikti, 110); # n
    byte_yaz(cikti, 101); # e
    byte_yaz(cikti, 65);  # A
    byte_yaz(cikti, 0);   # null

    # SetFilePointerEx Hint/Name (2+16+1 = 19 byte)
    u16_yaz(cikti, 0);
    byte_yaz(cikti, 83);  # S
    byte_yaz(cikti, 101); # e
    byte_yaz(cikti, 116); # t
    byte_yaz(cikti, 70);  # F
    byte_yaz(cikti, 105); # i
    byte_yaz(cikti, 108); # l
    byte_yaz(cikti, 101); # e
    byte_yaz(cikti, 80);  # P
    byte_yaz(cikti, 111); # o
    byte_yaz(cikti, 105); # i
    byte_yaz(cikti, 110); # n
    byte_yaz(cikti, 116); # t
    byte_yaz(cikti, 101); # e
    byte_yaz(cikti, 114); # r
    byte_yaz(cikti, 69);  # E
    byte_yaz(cikti, 120); # x
    byte_yaz(cikti, 0);   # null

    # DLL ismi: "KERNEL32.dll\0" (ofset 0x14F)
    byte_yaz(cikti, 75);  # K
    byte_yaz(cikti, 69);  # E
    byte_yaz(cikti, 82);  # R
    byte_yaz(cikti, 78);  # N
    byte_yaz(cikti, 69);  # E
    byte_yaz(cikti, 76);  # L
    byte_yaz(cikti, 51);  # 3
    byte_yaz(cikti, 50);  # 2
    byte_yaz(cikti, 46);  # .
    byte_yaz(cikti, 100); # d
    byte_yaz(cikti, 108); # l
    byte_yaz(cikti, 108); # l
    byte_yaz(cikti, 0);   # null

    # .rdata'yi 0x200'e hizala
    degisken rdata_kullanilan: tamsayi = cikti.kullanilan - (FILE_ALIGN + text_file);
    sifir_doldur(cikti, rdata_file - rdata_kullanilan);
}

# ============================================================
# Eski ELF uyumluluk (Linux icin)
# ============================================================
isv elf64_basligi_ve_kodu_yaz(os_arena: *MakineKoduArenasi, kod: *MakineKoduArenasi) {
    byte_yaz(os_arena, 0x7F); byte_yaz(os_arena, 0x45);
    byte_yaz(os_arena, 0x4C); byte_yaz(os_arena, 0x46);
    byte_yaz(os_arena, 0x02); byte_yaz(os_arena, 0x01);
    byte_yaz(os_arena, 0x01); byte_yaz(os_arena, 0x00);
    sifir_doldur(os_arena, 8);
    u16_yaz(os_arena, 2); u16_yaz(os_arena, 0x3E);
    int32_yaz(os_arena, 1);
    int64_yaz(os_arena, 4194424);
    int64_yaz(os_arena, 64); int64_yaz(os_arena, 0);
    int32_yaz(os_arena, 0);
    u16_yaz(os_arena, 64); u16_yaz(os_arena, 56);
    u16_yaz(os_arena, 1);  u16_yaz(os_arena, 0);
    u16_yaz(os_arena, 0);  u16_yaz(os_arena, 0);
    int32_yaz(os_arena, 1); int32_yaz(os_arena, 5);
    int64_yaz(os_arena, 0);
    int64_yaz(os_arena, 4194304); int64_yaz(os_arena, 4194304);
    int64_yaz(os_arena, 120 + kod.kullanilan);
    int64_yaz(os_arena, 120 + kod.kullanilan);
    int64_yaz(os_arena, 2097152);
    degisken k: tamsayi = 0;
    dongu k < kod.kullanilan {
        byte_yaz(os_arena, kod.bellek[k]);
        k = k + 1;
    }
}

# ============================================================
# Cross-Platform Backend Secimi (Faz 0)
# 0 = Windows PE32+ (varsayilan), 1 = Linux ELF64, 2 = macOS (planli)
# ============================================================

isv linux_baslangic_thunk_uret(a: *MakineKoduArenasi, ana_adres: tamsayi) -> tamsayi {
    # Linux _start ABI: [RSP] = argc, [RSP+8] = argv[0]
    # RCX=argc, RDX=argv olarak YKN ana() fonksiyonuna aktar.
    # Donus degeri (RAX) -> RDI, SYS_exit(60) ile bitir.
    degisken bas: tamsayi = a.kullanilan;
    byte_yaz(a, 0x48); byte_yaz(a, 0x8B); byte_yaz(a, 0x0C); byte_yaz(a, 0x24);  # MOV RCX,[RSP]
    byte_yaz(a, 0x48); byte_yaz(a, 0x8D); byte_yaz(a, 0x54); byte_yaz(a, 0x24); byte_yaz(a, 0x08);  # LEA RDX,[RSP+8]
    byte_yaz(a, 0x48); byte_yaz(a, 0x83); byte_yaz(a, 0xEC); byte_yaz(a, 0x20);  # SUB RSP, 32
    byte_yaz(a, 0xE8);  # CALL ana_adres (rel32 patch)
    degisken cagri_poz: tamsayi = a.kullanilan;
    int32_yaz(a, 0);
    # Patch: ana_adres - (cagri_poz + 4)
    degisken rel32: tamsayi = ana_adres - (cagri_poz + 4);
    degisken u: tamsayi = rel32;
    dongu u < 0 { u = u + 4294967296; }
    a.bellek[cagri_poz] = u % 256;
    a.bellek[cagri_poz + 1] = (u / 256) % 256;
    a.bellek[cagri_poz + 2] = (u / 65536) % 256;
    a.bellek[cagri_poz + 3] = (u / 16777216) % 256;
    byte_yaz(a, 0x48); byte_yaz(a, 0x83); byte_yaz(a, 0xC4); byte_yaz(a, 0x20);  # ADD RSP, 32
    byte_yaz(a, 0x48); byte_yaz(a, 0x89); byte_yaz(a, 0xC7);  # MOV RDI,RAX
    byte_yaz(a, 0x48); byte_yaz(a, 0xC7); byte_yaz(a, 0xC0); int32_yaz(a, 60);  # MOV RAX, 60 (SYS_exit)
    byte_yaz(a, 0x0F); byte_yaz(a, 0x05);  # SYSCALL
    dondu bas;
}

isv elf64_linux_uret(os_arena: *MakineKoduArenasi, kod: *MakineKoduArenasi, entry_offset: tamsayi) {
    degisken IMAGE_BASE:    tamsayi = 0x400000;
    degisken ELF_HEADER_S:  tamsayi = 64;
    degisken PROGRAM_HDR_S: tamsayi = 56;
    degisken CODE_OFF:      tamsayi = ELF_HEADER_S + PROGRAM_HDR_S;
    degisken code_s:        tamsayi = kod.kullanilan;

    yamalari_uygula(kod);

    # ELF64 Header
    byte_yaz(os_arena, 0x7F); byte_yaz(os_arena, 0x45); byte_yaz(os_arena, 0x4C); byte_yaz(os_arena, 0x46);
    byte_yaz(os_arena, 0x02); byte_yaz(os_arena, 0x01); byte_yaz(os_arena, 0x01); byte_yaz(os_arena, 0x00);
    sifir_doldur(os_arena, 8);
    u16_yaz(os_arena, 2);        # ET_EXEC
    u16_yaz(os_arena, 0x3E);     # EM_X86_64
    int32_yaz(os_arena, 1);
    int64_yaz(os_arena, IMAGE_BASE + CODE_OFF + entry_offset);
    int64_yaz(os_arena, ELF_HEADER_S);  # e_phoff
    int64_yaz(os_arena, 0);             # e_shoff = 0 (no sections)
    int32_yaz(os_arena, 0);             # e_flags
    u16_yaz(os_arena, ELF_HEADER_S);
    u16_yaz(os_arena, PROGRAM_HDR_S);
    u16_yaz(os_arena, 1);               # 1 program header
    u16_yaz(os_arena, 0); u16_yaz(os_arena, 0); u16_yaz(os_arena, 0);

    # Tek PT_LOAD segment (R/W/X)
    int32_yaz(os_arena, 1);   # PT_LOAD
    int32_yaz(os_arena, 7);   # PF_R | PF_W | PF_X
    int64_yaz(os_arena, 0);   # p_offset = 0 (header+phdr+code tek blok)
    int64_yaz(os_arena, IMAGE_BASE);
    int64_yaz(os_arena, IMAGE_BASE);
    int64_yaz(os_arena, CODE_OFF + code_s);  # p_filesz
    int64_yaz(os_arena, CODE_OFF + code_s);  # p_memsz
    int64_yaz(os_arena, 0x1000);             # p_align

    # Kodu yapistir
    degisken k: tamsayi = 0;
    dongu k < kod.kullanilan {
        byte_yaz(os_arena, kod.bellek[k]);
        k = k + 1;
    }
}

isv macos_baslangic_thunk_uret(a: *MakineKoduArenasi, ana_adres: tamsayi) -> tamsayi {
    # macOS x86-64 LC_UNIXTHREAD _start ABI: [RSP] = argc, [RSP+8] = argv[0]
    # RCX = argc, RDX = argv -> ana()
    # Donus degeri (RAX) -> RDI, SYS_exit(0x2000001) ile bitir.
    degisken bas: tamsayi = a.kullanilan;
    byte_yaz(a, 0x48); byte_yaz(a, 0x8B); byte_yaz(a, 0x0C); byte_yaz(a, 0x24);  # MOV RCX, [RSP]
    byte_yaz(a, 0x48); byte_yaz(a, 0x8D); byte_yaz(a, 0x54); byte_yaz(a, 0x24); byte_yaz(a, 0x08);  # LEA RDX, [RSP+8]
    byte_yaz(a, 0x48); byte_yaz(a, 0x83); byte_yaz(a, 0xEC); byte_yaz(a, 0x20);  # SUB RSP, 32
    byte_yaz(a, 0xE8);  # CALL ana_adres (rel32 patch)
    degisken cagri_poz: tamsayi = a.kullanilan;
    int32_yaz(a, 0);
    degisken rel32: tamsayi = ana_adres - (cagri_poz + 4);
    degisken u: tamsayi = rel32;
    dongu u < 0 { u = u + 4294967296; }
    a.bellek[cagri_poz] = u % 256;
    a.bellek[cagri_poz + 1] = (u / 256) % 256;
    a.bellek[cagri_poz + 2] = (u / 65536) % 256;
    a.bellek[cagri_poz + 3] = (u / 16777216) % 256;
    byte_yaz(a, 0x48); byte_yaz(a, 0x83); byte_yaz(a, 0xC4); byte_yaz(a, 0x20);  # ADD RSP, 32
    byte_yaz(a, 0x48); byte_yaz(a, 0x89); byte_yaz(a, 0xC7);  # MOV RDI, RAX
    byte_yaz(a, 0x48); byte_yaz(a, 0xC7); byte_yaz(a, 0xC0); int32_yaz(a, 0x2000001);  # MOV RAX, 0x2000001 (SYS_exit)
    byte_yaz(a, 0x0F); byte_yaz(a, 0x05);  # SYSCALL
    dondu bas;
}

isv macho64_macos_uret(os_arena: *MakineKoduArenasi, kod: *MakineKoduArenasi, entry_offset: tamsayi) {
    degisken MACH_HEADER_S:  tamsayi = 32;
    degisken LC_SEGMENT_S:   tamsayi = 152; # 72 (seg) + 80 (1 section)
    degisken LC_THREAD_S:    tamsayi = 184; # 16 (cmd+flavor+count) + 168 (21 regs * 8)
    degisken CODE_OFF:       tamsayi = MACH_HEADER_S + LC_SEGMENT_S + LC_THREAD_S; # 368
    degisken VMADDR_BASE:    tamsayi = 4294967296; # 0x100000000 (4GB)
    degisken code_s:         tamsayi = kod.kullanilan;
    degisken file_s:         tamsayi = CODE_OFF + code_s;

    yamalari_uygula(kod);

    # 1. Mach-O 64 Header (32 bytes)
    int32_yaz(os_arena, 0xFEEDFACF); # MH_MAGIC_64
    int32_yaz(os_arena, 0x01000007); # CPU_TYPE_X86_64
    int32_yaz(os_arena, 0x80000003); # CPU_SUBTYPE_X86_64_ALL
    int32_yaz(os_arena, 2);          # MH_EXECUTE
    int32_yaz(os_arena, 2);          # ncmds = 2 (LC_SEGMENT_64 + LC_UNIXTHREAD)
    int32_yaz(os_arena, LC_SEGMENT_S + LC_THREAD_S); # sizeofcmds = 336
    int32_yaz(os_arena, 0x00200085); # flags: MH_NOUNDEFS | MH_DYLDLINK | MH_TWOLEVEL | MH_PIE
    int32_yaz(os_arena, 0);          # reserved

    # 2. LC_SEGMENT_64 (__TEXT) (72 + 80 = 152 bytes)
    int32_yaz(os_arena, 0x19);       # LC_SEGMENT_64
    int32_yaz(os_arena, LC_SEGMENT_S); # cmdsize = 152
    # segname = "__TEXT\0..." (16 bytes)
    byte_yaz(os_arena, 0x5F); byte_yaz(os_arena, 0x5F); byte_yaz(os_arena, 0x54); byte_yaz(os_arena, 0x45);
    byte_yaz(os_arena, 0x58); byte_yaz(os_arena, 0x54); sifir_doldur(os_arena, 10);
    int64_yaz(os_arena, VMADDR_BASE); # vmaddr
    int64_yaz(os_arena, hizala_yukari(file_s, 4096)); # vmsize
    int64_yaz(os_arena, 0);          # fileoff
    int64_yaz(os_arena, file_s);     # filesize
    int32_yaz(os_arena, 7);          # maxprot (rwx)
    int32_yaz(os_arena, 7);          # initprot (rwx)
    int32_yaz(os_arena, 1);          # nsects = 1
    int32_yaz(os_arena, 0);          # flags

    # Section 1: __text (80 bytes)
    # sectname = "__text\0..." (16 bytes)
    byte_yaz(os_arena, 0x5F); byte_yaz(os_arena, 0x5F); byte_yaz(os_arena, 0x74); byte_yaz(os_arena, 0x65);
    byte_yaz(os_arena, 0x78); byte_yaz(os_arena, 0x74); sifir_doldur(os_arena, 10);
    # segname = "__TEXT\0..." (16 bytes)
    byte_yaz(os_arena, 0x5F); byte_yaz(os_arena, 0x5F); byte_yaz(os_arena, 0x54); byte_yaz(os_arena, 0x45);
    byte_yaz(os_arena, 0x58); byte_yaz(os_arena, 0x54); sifir_doldur(os_arena, 10);
    int64_yaz(os_arena, VMADDR_BASE + CODE_OFF); # addr
    int64_yaz(os_arena, code_s);     # size
    int32_yaz(os_arena, CODE_OFF);   # offset
    int32_yaz(os_arena, 4);          # align (2^4 = 16)
    int32_yaz(os_arena, 0);          # reloff
    int32_yaz(os_arena, 0);          # nreloc
    int32_yaz(os_arena, 0x80000400); # flags (S_ATTR_PURE_INSTRUCTIONS | S_ATTR_SOME_INSTRUCTIONS)
    int32_yaz(os_arena, 0);          # reserved1
    int32_yaz(os_arena, 0);          # reserved2
    int32_yaz(os_arena, 0);          # reserved3

    # 3. LC_UNIXTHREAD (184 bytes)
    int32_yaz(os_arena, 0x05);       # LC_UNIXTHREAD
    int32_yaz(os_arena, LC_THREAD_S); # cmdsize = 184
    int32_yaz(os_arena, 4);          # flavor = x86_THREAD_STATE64 (4)
    int32_yaz(os_arena, 42);         # count = 42 (42 * 4 = 168 bytes)

    # 16 general registers (RAX, RBX, RCX, RDX, RDI, RSI, RBP, RSP, R8..R15) = 16 * 8 = 128 bytes
    sifir_doldur(os_arena, 128);
    # RIP at offset 128
    int64_yaz(os_arena, VMADDR_BASE + CODE_OFF + entry_offset);
    # RFLAGS, CS, FS, GS = 4 * 8 = 32 bytes
    sifir_doldur(os_arena, 32);

    # 4. Kodu yapistir
    degisken k_m: tamsayi = 0;
    dongu k_m < kod.kullanilan {
        byte_yaz(os_arena, kod.bellek[k_m]);
        k_m = k_m + 1;
    }
}

isv linux_arm64_baslangic_thunk_uret(a: *MakineKoduArenasi, ana_adres: tamsayi) -> tamsayi {
    # Linux AArch64 _start: [SP]=argc, [SP+8]=argv[0]
    # X0 = argc, X1 = argv -> BL ana
    # X0 = exit code, MOV X8, #93 (SYS_exit), SVC #0
    degisken bas: tamsayi = a.kullanilan;
    # LDR X0, [SP] (0xF94003E0)
    byte_yaz(a, 0xE0); byte_yaz(a, 0x03); byte_yaz(a, 0x40); byte_yaz(a, 0xF9);
    # ADD X1, SP, #8 (0x910023E1)
    byte_yaz(a, 0xE1); byte_yaz(a, 0x23); byte_yaz(a, 0x00); byte_yaz(a, 0x91);
    # BL ana_adres: BL offset = (ana_adres - cur) / 4
    degisken bl_pos: tamsayi = a.kullanilan;
    degisken rel_inst: tamsayi = (ana_adres - bl_pos) / 4;
    degisken imm26: tamsayi = rel_inst;
    dongu imm26 < 0 { imm26 = imm26 + 67108864; }
    degisken opcode: tamsayi = 0x94000000 + (imm26 % 67108864);
    int32_yaz(a, opcode);
    # MOVZ X8, #93 (0xD2800BA8) (SYS_exit=93)
    byte_yaz(a, 0xA8); byte_yaz(a, 0x0B); byte_yaz(a, 0x80); byte_yaz(a, 0xD2);
    # SVC #0 (0xD4000001)
    byte_yaz(a, 0x01); byte_yaz(a, 0x00); byte_yaz(a, 0x00); byte_yaz(a, 0xD4);
    dondu bas;
}

isv elf64_arm64_uret(os_arena: *MakineKoduArenasi, kod: *MakineKoduArenasi, entry_offset: tamsayi) {
    degisken IMAGE_BASE:    tamsayi = 0x400000;
    degisken ELF_HEADER_S:  tamsayi = 64;
    degisken PROGRAM_HDR_S: tamsayi = 56;
    degisken CODE_OFF:      tamsayi = ELF_HEADER_S + PROGRAM_HDR_S;
    degisken code_s:        tamsayi = kod.kullanilan;

    yamalari_uygula(kod);

    # ELF64 Header
    byte_yaz(os_arena, 0x7F); byte_yaz(os_arena, 0x45); byte_yaz(os_arena, 0x4C); byte_yaz(os_arena, 0x46);
    byte_yaz(os_arena, 0x02); byte_yaz(os_arena, 0x01); byte_yaz(os_arena, 0x01); byte_yaz(os_arena, 0x00);
    sifir_doldur(os_arena, 8);
    u16_yaz(os_arena, 2);        # ET_EXEC
    u16_yaz(os_arena, 0xB7);     # EM_AARCH64 (183 = 0xB7)
    int32_yaz(os_arena, 1);      # EV_CURRENT
    int64_yaz(os_arena, IMAGE_BASE + CODE_OFF + entry_offset);
    int64_yaz(os_arena, ELF_HEADER_S);  # e_phoff
    int64_yaz(os_arena, 0);             # e_shoff
    int32_yaz(os_arena, 0);             # e_flags
    u16_yaz(os_arena, ELF_HEADER_S);
    u16_yaz(os_arena, PROGRAM_HDR_S);
    u16_yaz(os_arena, 1);               # 1 phdr
    u16_yaz(os_arena, 0); u16_yaz(os_arena, 0); u16_yaz(os_arena, 0);

    # PT_LOAD segment (R/W/X)
    int32_yaz(os_arena, 1);   # PT_LOAD
    int32_yaz(os_arena, 7);   # PF_R | PF_W | PF_X
    int64_yaz(os_arena, 0);
    int64_yaz(os_arena, IMAGE_BASE);
    int64_yaz(os_arena, IMAGE_BASE);
    int64_yaz(os_arena, CODE_OFF + code_s);
    int64_yaz(os_arena, CODE_OFF + code_s);
    int64_yaz(os_arena, 0x1000);

    # Kodu yapistir
    degisken k_a: tamsayi = 0;
    dongu k_a < kod.kullanilan {
        byte_yaz(os_arena, kod.bellek[k_a]);
        k_a = k_a + 1;
    }
}

isv macos_arm64_baslangic_thunk_uret(a: *MakineKoduArenasi, ana_adres: tamsayi) -> tamsayi {
    # macOS ARM64 _start: [SP]=argc, [SP+8]=argv[0]
    # X0 = argc, X1 = argv -> BL ana
    # X0 = exit code, MOV X16, #1 (SYS_exit=1), SVC #0x80
    degisken bas: tamsayi = a.kullanilan;
    # LDR X0, [SP] (0xF94003E0)
    byte_yaz(a, 0xE0); byte_yaz(a, 0x03); byte_yaz(a, 0x40); byte_yaz(a, 0xF9);
    # ADD X1, SP, #8 (0x910023E1)
    byte_yaz(a, 0xE1); byte_yaz(a, 0x23); byte_yaz(a, 0x00); byte_yaz(a, 0x91);
    # BL ana_adres
    degisken bl_pos: tamsayi = a.kullanilan;
    degisken rel_inst: tamsayi = (ana_adres - bl_pos) / 4;
    degisken imm26: tamsayi = rel_inst;
    dongu imm26 < 0 { imm26 = imm26 + 67108864; }
    degisken opcode: tamsayi = 0x94000000 + (imm26 % 67108864);
    int32_yaz(a, opcode);
    # MOVZ X16, #1 (0xD2800030) (macOS SYS_exit=1 in X16)
    byte_yaz(a, 0x30); byte_yaz(a, 0x00); byte_yaz(a, 0x80); byte_yaz(a, 0xD2);
    # SVC #0x80 (0xD4001001)
    byte_yaz(a, 0x01); byte_yaz(a, 0x10); byte_yaz(a, 0x00); byte_yaz(a, 0xD4);
    dondu bas;
}

isv macho64_arm64_uret(os_arena: *MakineKoduArenasi, kod: *MakineKoduArenasi, entry_offset: tamsayi) {
    degisken MACH_HEADER_S:  tamsayi = 32;
    degisken LC_SEGMENT_S:   tamsayi = 152;
    degisken LC_THREAD_S:    tamsayi = 288; # 16 (cmd+flavor+count) + 272 (ARM64 thread state)
    degisken CODE_OFF:       tamsayi = MACH_HEADER_S + LC_SEGMENT_S + LC_THREAD_S; # 472
    degisken VMADDR_BASE:    tamsayi = 4294967296; # 0x100000000 (4GB)
    degisken code_s:         tamsayi = kod.kullanilan;
    degisken file_s:         tamsayi = CODE_OFF + code_s;

    yamalari_uygula(kod);

    # 1. Mach-O Header ARM64
    int32_yaz(os_arena, 0xFEEDFACF); # MH_MAGIC_64
    int32_yaz(os_arena, 0x0100000C); # CPU_TYPE_ARM64
    int32_yaz(os_arena, 0x00000000); # CPU_SUBTYPE_ARM64_ALL
    int32_yaz(os_arena, 2);          # MH_EXECUTE
    int32_yaz(os_arena, 2);          # ncmds = 2
    int32_yaz(os_arena, LC_SEGMENT_S + LC_THREAD_S);
    int32_yaz(os_arena, 0x00200085); # flags
    int32_yaz(os_arena, 0);          # reserved

    # 2. LC_SEGMENT_64 (__TEXT)
    int32_yaz(os_arena, 0x19);
    int32_yaz(os_arena, LC_SEGMENT_S);
    byte_yaz(os_arena, 0x5F); byte_yaz(os_arena, 0x5F); byte_yaz(os_arena, 0x54); byte_yaz(os_arena, 0x45);
    byte_yaz(os_arena, 0x58); byte_yaz(os_arena, 0x54); sifir_doldur(os_arena, 10);
    int64_yaz(os_arena, VMADDR_BASE);
    int64_yaz(os_arena, hizala_yukari(file_s, 4096));
    int64_yaz(os_arena, 0);
    int64_yaz(os_arena, file_s);
    int32_yaz(os_arena, 7);
    int32_yaz(os_arena, 7);
    int32_yaz(os_arena, 1);
    int32_yaz(os_arena, 0);

    # Section 1: __text
    byte_yaz(os_arena, 0x5F); byte_yaz(os_arena, 0x5F); byte_yaz(os_arena, 0x74); byte_yaz(os_arena, 0x65);
    byte_yaz(os_arena, 0x78); byte_yaz(os_arena, 0x74); sifir_doldur(os_arena, 10);
    byte_yaz(os_arena, 0x5F); byte_yaz(os_arena, 0x5F); byte_yaz(os_arena, 0x54); byte_yaz(os_arena, 0x45);
    byte_yaz(os_arena, 0x58); byte_yaz(os_arena, 0x54); sifir_doldur(os_arena, 10);
    int64_yaz(os_arena, VMADDR_BASE + CODE_OFF);
    int64_yaz(os_arena, code_s);
    int32_yaz(os_arena, CODE_OFF);
    int32_yaz(os_arena, 4);
    int32_yaz(os_arena, 0);
    int32_yaz(os_arena, 0);
    int32_yaz(os_arena, 0x80000400);
    int32_yaz(os_arena, 0);
    int32_yaz(os_arena, 0);
    int32_yaz(os_arena, 0);

    # 3. LC_UNIXTHREAD ARM64
    int32_yaz(os_arena, 0x05);       # LC_UNIXTHREAD
    int32_yaz(os_arena, LC_THREAD_S);
    int32_yaz(os_arena, 6);          # ARM_THREAD_STATE64 (flavor 6)
    int32_yaz(os_arena, 68);         # count = 68 (68 * 4 = 272 bytes)

    # 29 General registers (X0..X28) = 29 * 8 = 232 bytes
    sifir_doldur(os_arena, 232);
    # FP (X29), LR (X30), SP (X31) = 3 * 8 = 24 bytes
    sifir_doldur(os_arena, 24);
    # PC (offset 256)
    int64_yaz(os_arena, VMADDR_BASE + CODE_OFF + entry_offset);
    # CPSR (4 bytes) + flags (4 bytes pad) = 8 bytes
    sifir_doldur(os_arena, 8);

    # 4. Kodu yapistir
    degisken k_ma: tamsayi = 0;
    dongu k_ma < kod.kullanilan {
        byte_yaz(os_arena, kod.bellek[k_ma]);
        k_ma = k_ma + 1;
    }
}
