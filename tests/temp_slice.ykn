# ============================================================
# Yukinary Codegen v3 - x86_64 + Windows PE32+ + Win32 Import Table
# Tamamen bagimsiz - g++, MSVC, NASM gerektirmez
# kernel32.dll: ExitProcess, WriteFile, GetStdHandle
# ============================================================

yapi MakineKoduArenasi {
    bellek: *u8;
    kapasite: tamsayi;
    kullanilan: tamsayi;
}

# ============================================================
# Ham bellek yazicilari
# ============================================================
isv byte_yaz(a: *MakineKoduArenasi, b: u8) {
    a.bellek[a.kullanilan] = b;
    a.kullanilan = a.kullanilan + 1;
}

isv u16_yaz(a: *MakineKoduArenasi, v: tamsayi) {
    byte_yaz(a, v % 256);
    byte_yaz(a, (v / 256) % 256);
}

isv int32_yaz(a: *MakineKoduArenasi, v: tamsayi) {
    degisken u: tamsayi = v;
    dongu u < 0 {
        u = u + 4294967296;
    }
    degisken b0: u8 = u % 256;
    degisken b1: u8 = (u / 256) % 256;
    degisken b2: u8 = (u / 65536) % 256;
    degisken b3: u8 = (u / 16777216) % 256;
    byte_yaz(a, b0);
    byte_yaz(a, b1);
    byte_yaz(a, b2);
    byte_yaz(a, b3);
}

isv int64_yaz(a: *MakineKoduArenasi, v: tamsayi) {
    int32_yaz(a, v);
    degisken hi: tamsayi = v / 4294967296;
    int32_yaz(a, hi);
}

isv sifir_doldur(a: *MakineKoduArenasi, adet: tamsayi) {
    degisken i: tamsayi = 0;
    dongu i < adet {
        byte_yaz(a, 0);
        i = i + 1;
    }
}

isv str_yaz(a: *MakineKoduArenasi, s: *u8) {
    degisken i: tamsayi = 0;
    dongu s[i] != 0 {
        byte_yaz(a, s[i]);
        i = i + 1;
    }
    byte_yaz(a, 0);
}

isv hizala_yukari(deger: tamsayi, hizalama: tamsayi) -> tamsayi {
    eger deger == 0 ise { dondu hizalama; }
    degisken sonuc: tamsayi = ((deger + hizalama - 1) / hizalama) * hizalama;
    dondu sonuc;
}

# ============================================================
# x86_64 Opcode uretcileri
# ============================================================
isv emit_push_rbp(a: *MakineKoduArenasi) { byte_yaz(a, 0x55); }
isv emit_pop_rbp(a: *MakineKoduArenasi)  { byte_yaz(a, 0x5D); }
isv emit_ret(a: *MakineKoduArenasi)      { byte_yaz(a, 0xC3); }

isv emit_mov_rbp_rsp(a: *MakineKoduArenasi) {
    byte_yaz(a, 0x48); byte_yaz(a, 0x89); byte_yaz(a, 0xE5);
}

isv emit_sub_rsp(a: *MakineKoduArenasi, n: tamsayi) {
    eger n <= 127 ise {
        byte_yaz(a, 0x48); byte_yaz(a, 0x83); byte_yaz(a, 0xEC); byte_yaz(a, n);
    } yoksa eger n <= 4096 ise {
        byte_yaz(a, 0x48); byte_yaz(a, 0x81); byte_yaz(a, 0xEC); int32_yaz(a, n);
    } yoksa {
        # Windows stack probe: touch each page before final SUB RSP
        # MOV RAX, RSP
        byte_yaz(a, 0x48); byte_yaz(a, 0x89); byte_yaz(a, 0xE0);
        # Emit page probes: for each 4096-byte chunk from top downward
        degisken remaining: tamsayi = n;
        dongu remaining > 0 {
            degisken chunk: tamsayi = 4096;
            eger remaining < 4096 ise { chunk = remaining; }
            # SUB RAX, chunk
            byte_yaz(a, 0x48); byte_yaz(a, 0x81); byte_yaz(a, 0xE8); int32_yaz(a, chunk);
            # MOV [RAX], RAX  (touch the page)
            byte_yaz(a, 0x48); byte_yaz(a, 0x89); byte_yaz(a, 0x00);
            remaining = remaining - chunk;
        }
        # SUB RSP, n  (actually move the stack pointer)
        byte_yaz(a, 0x48); byte_yaz(a, 0x81); byte_yaz(a, 0xEC); int32_yaz(a, n);
    }
}

isv emit_add_rsp(a: *MakineKoduArenasi, n: tamsayi) {
    eger n <= 127 ise {
        byte_yaz(a, 0x48); byte_yaz(a, 0x83); byte_yaz(a, 0xC4); byte_yaz(a, n);
    } yoksa {
        byte_yaz(a, 0x48); byte_yaz(a, 0x81); byte_yaz(a, 0xC4); int32_yaz(a, n);
    }
}

isv emit_xor_rax_rax(a: *MakineKoduArenasi) {
    byte_yaz(a, 0x33); byte_yaz(a, 0xC0);
}

isv emit_mov_rax_imm32(a: *MakineKoduArenasi, v: tamsayi) {
    eger v > 2147483647 veya v < 0 - 2147483648 ise {
        byte_yaz(a, 0x48);
        byte_yaz(a, 0xB8);
        int64_yaz(a, v);
    } yoksa {
        byte_yaz(a, 0x48); byte_yaz(a, 0xC7); byte_yaz(a, 0xC0);
        int32_yaz(a, v);
    }
}

isv emit_mov_rcx_imm32(a: *MakineKoduArenasi, v: tamsayi) {
    eger v > 2147483647 veya v < 0 - 2147483648 ise {
        byte_yaz(a, 0x48);
        byte_yaz(a, 0xB9);
        int64_yaz(a, v);
    } yoksa {
        byte_yaz(a, 0x48); byte_yaz(a, 0xC7); byte_yaz(a, 0xC1);
        int32_yaz(a, v);
    }
}

isv emit_mov_rdx_imm32(a: *MakineKoduArenasi, v: tamsayi) {
    byte_yaz(a, 0x48); byte_yaz(a, 0xC7); byte_yaz(a, 0xC2);
    int32_yaz(a, v);
}

isv emit_add_rax_rcx(a: *MakineKoduArenasi) {
    byte_yaz(a, 0x48); byte_yaz(a, 0x01); byte_yaz(a, 0xC8);
}

isv emit_sub_rax_rcx(a: *MakineKoduArenasi) {
    byte_yaz(a, 0x48); byte_yaz(a, 0x29); byte_yaz(a, 0xC8);
}

isv emit_imul_rax_rcx(a: *MakineKoduArenasi) {
    byte_yaz(a, 0x48); byte_yaz(a, 0x0F); byte_yaz(a, 0xAF); byte_yaz(a, 0xC1);
}

isv emit_div_rax_rcx(a: *MakineKoduArenasi) {
    byte_yaz(a, 0x48); byte_yaz(a, 0x99); # CQO
    byte_yaz(a, 0x48); byte_yaz(a, 0xF7); byte_yaz(a, 0xF9); # IDIV RCX
}

isv emit_mod_rax_rcx(a: *MakineKoduArenasi) {
    byte_yaz(a, 0x48); byte_yaz(a, 0x99); # CQO
    byte_yaz(a, 0x48); byte_yaz(a, 0xF7); byte_yaz(a, 0xF9); # IDIV RCX
    byte_yaz(a, 0x48); byte_yaz(a, 0x89); byte_yaz(a, 0xD0); # MOV RAX, RDX
}

# call [rip+offset32] - IAT indirect call
isv emit_call_rip_rel(a: *MakineKoduArenasi, rel32: tamsayi) {
    byte_yaz(a, 0xFF); byte_yaz(a, 0x15);
    int32_yaz(a, rel32);
}

# lea rcx, [rip+offset32] - string pointer
isv emit_lea_rcx_rip(a: *MakineKoduArenasi, rel32: tamsayi) {
    byte_yaz(a, 0x48); byte_yaz(a, 0x8D); byte_yaz(a, 0x0D);
    int32_yaz(a, rel32);
}

# mov r8d, imm32
isv emit_mov_r8d_imm32(a: *MakineKoduArenasi, v: tamsayi) {
    byte_yaz(a, 0x41); byte_yaz(a, 0xB8);
    int32_yaz(a, v);
}

# xor r9d, r9d
isv emit_xor_r9d_r9d(a: *MakineKoduArenasi) {
    byte_yaz(a, 0x45); byte_yaz(a, 0x33); byte_yaz(a, 0xC9);
}

# ============================================================
# Karsilastirma Operatorleri: CMP + SETcc + MOVZX
# CMP RAX, RCX => bayraklari ayarlar
# SETcc AL    => kosula gore AL = 0 veya 1
# MOVZX RAX, AL => AL'yi RAX'a sifir-genislet
# Sonuc: RAX = 0 (yanlis) veya 1 (dogru)
# ============================================================
isv emit_cmp_rax_rcx(a: *MakineKoduArenasi) {
    # CMP RAX, RCX  => 48 3B C1
    byte_yaz(a, 0x48); byte_yaz(a, 0x3B); byte_yaz(a, 0xC1);
}

isv emit_sete_al(a: *MakineKoduArenasi) {
    # SETE AL  => 0F 94 C0  (esitse 1, degilse 0)
    byte_yaz(a, 0x0F); byte_yaz(a, 0x94); byte_yaz(a, 0xC0);
}

isv emit_setne_al(a: *MakineKoduArenasi) {
    # SETNE AL  => 0F 95 C0  (esit degilse 1)
    byte_yaz(a, 0x0F); byte_yaz(a, 0x95); byte_yaz(a, 0xC0);
}

isv emit_setl_al(a: *MakineKoduArenasi) {
    # SETL AL  => 0F 9C C0  (isaretli kucukse 1)
    byte_yaz(a, 0x0F); byte_yaz(a, 0x9C); byte_yaz(a, 0xC0);
}

isv emit_setg_al(a: *MakineKoduArenasi) {
    # SETG AL  => 0F 9F C0  (isaretli buyukse 1)
    byte_yaz(a, 0x0F); byte_yaz(a, 0x9F); byte_yaz(a, 0xC0);
}

isv emit_setle_al(a: *MakineKoduArenasi) {
    # SETLE AL  => 0F 9E C0  (kucuk veya esitse 1)
    byte_yaz(a, 0x0F); byte_yaz(a, 0x9E); byte_yaz(a, 0xC0);
}

isv emit_setge_al(a: *MakineKoduArenasi) {
    # SETGE AL  => 0F 9D C0  (buyuk veya esitse 1)
    byte_yaz(a, 0x0F); byte_yaz(a, 0x9D); byte_yaz(a, 0xC0);
}

isv emit_movzx_rax_al(a: *MakineKoduArenasi) {
    # MOVZX RAX, AL  => 48 0F B6 C0
    byte_yaz(a, 0x48); byte_yaz(a, 0x0F); byte_yaz(a, 0xB6); byte_yaz(a, 0xC0);
}

isv emit_setb_al(a: *MakineKoduArenasi) {
    # SETB AL  => 0F 92 C0  (unsigned below / CF=1)
    byte_yaz(a, 0x0F); byte_yaz(a, 0x92); byte_yaz(a, 0xC0);
}

isv emit_setae_al(a: *MakineKoduArenasi) {
    # SETAE AL => 0F 93 C0  (unsigned above or equal / CF=0)
    byte_yaz(a, 0x0F); byte_yaz(a, 0x93); byte_yaz(a, 0xC0);
}

isv emit_setbe_al(a: *MakineKoduArenasi) {
    # SETBE AL => 0F 96 C0  (unsigned below or equal / CF=1 or ZF=1)
    byte_yaz(a, 0x0F); byte_yaz(a, 0x96); byte_yaz(a, 0xC0);
}

isv emit_seta_al(a: *MakineKoduArenasi) {
    # SETA AL  => 0F 97 C0  (unsigned above / CF=0 and ZF=0)
    byte_yaz(a, 0x0F); byte_yaz(a, 0x97); byte_yaz(a, 0xC0);
}

# ============================================================
# Yerel degisken tablosu (lokal scope takibi)
# ============================================================
yapi LokalDegisken {
    isim:         *u8;
    uzunluk:      tamsayi;
    offset:       tamsayi;
    tip_adi:      *u8;
    tip_uzunluk:  tamsayi;
}

degisken g_lokal_adet: tamsayi = 0;
degisken g_lokal_stack_offset: tamsayi = 0;

degisken g_lokal_isimleri: [4096]*u8;
degisken g_lokal_uzunluklari: [4096]tamsayi;
degisken g_lokal_offsetleri: [4096]tamsayi;
degisken g_lokal_tip_adlari: [4096]*u8;
degisken g_lokal_tip_uzunluklari: [4096]tamsayi;
degisken g_lokal_yildizlari: [4096]tamsayi;
degisken g_lokal_dizi_boyutlari: [4096]tamsayi;

degisken g_fonk_isim: [1024]*u8;
degisken g_fonk_uzunluk: [1024]tamsayi;
degisken g_fonk_adres: [1024]tamsayi;
degisken g_fonk_adet: tamsayi = 0;

# YamaTablosu flat parallel arrays (struct-of-arrays instead of array-of-structs)
degisken g_yama_isim:      [4096]*u8;
degisken g_yama_uzunluk:   [4096]tamsayi;
degisken g_yama_cagri_pos: [4096]tamsayi;
degisken g_yama_adet:      tamsayi = 0;

# IAT call patch tablosu: slot 1=WriteFile, 2=GetStdHandle
degisken g_iat_yama_text_offset: [64]tamsayi;
degisken g_iat_yama_slot: [64]tamsayi;
degisken g_iat_yama_adet: tamsayi;
degisken g_target_platform: tamsayi = 0;


isv lokal_tablo_sifirla() {
    g_lokal_adet = 0;
    g_lokal_stack_offset = 0;
}

isv lokal_bul_offset(isim: *u8, uzn: tamsayi) -> tamsayi {
    eger isim == 0 veya uzn <= 0 ise {
        dondu 0;
    }
    degisken i: tamsayi = g_lokal_adet;
    dongu i > 0 {
        i = i - 1;
        eger g_lokal_uzunluklari[i] == uzn ise {
            eger bellek_esit_mi(g_lokal_isimleri[i], isim, uzn) == 1 ise {
                dondu g_lokal_offsetleri[i];
            }
        }
    }
    dondu 0;
}

isv lokal_bul_yildiz(isim: *u8, uzn: tamsayi) -> tamsayi {
    eger isim == 0 veya uzn <= 0 ise { dondu 0; }
    degisken i: tamsayi = g_lokal_adet;
    dongu i > 0 {
        i = i - 1;
        eger g_lokal_isimleri[i] != 0 ve g_lokal_uzunluklari[i] == uzn ise {
            eger bellek_esit_mi(g_lokal_isimleri[i], isim, uzn) == 1 ise {
                dondu g_lokal_yildizlari[i];
            }
        }
    }
    dondu 0;
}

isv lokal_bul_dizi(isim: *u8, uzn: tamsayi) -> tamsayi {
    eger isim == 0 veya uzn <= 0 ise { dondu 0; }
    degisken i: tamsayi = g_lokal_adet;
    dongu i > 0 {
        i = i - 1;
        eger g_lokal_isimleri[i] != 0 ve g_lokal_uzunluklari[i] == uzn ise {
            eger bellek_esit_mi(g_lokal_isimleri[i], isim, uzn) == 1 ise {
                dondu g_lokal_dizi_boyutlari[i];
            }
        }
    }
    dondu 0;
}

isv lokal_bul_tip_uzn(isim: *u8, uzn: tamsayi) -> tamsayi {
    eger isim == 0 veya uzn <= 0 ise { dondu 0; }
    degisken i: tamsayi = g_lokal_adet;
    dongu i > 0 {
        i = i - 1;
        eger g_lokal_isimleri[i] != 0 ve g_lokal_uzunluklari[i] == uzn ise {
            eger bellek_esit_mi(g_lokal_isimleri[i], isim, uzn) == 1 ise {
                dondu g_lokal_tip_uzunluklari[i];
            }
        }
    }
    dondu 0;
}

isv lokal_bul_tip_adi(isim: *u8, uzn: tamsayi) -> *u8 {
    eger isim == 0 veya uzn <= 0 ise { dondu 0; }
    degisken i: tamsayi = g_lokal_adet;
    dongu i > 0 {
        i = i - 1;
        eger g_lokal_isimleri[i] != 0 ve g_lokal_uzunluklari[i] == uzn ise {
            eger bellek_esit_mi(g_lokal_isimleri[i], isim, uzn) == 1 ise {
                dondu g_lokal_tip_adlari[i];
            }
        }
    }
    dondu 0;
}

# u8 pointer (*u8, yildiz=1) veya [N]u8 array â†’ byte erisim (scale 1)
# **u8, *Jeton vb â†’ pointer erisim (scale 8)
isv subscript_byte_mi(isim: *u8, uzn: tamsayi, dizi_boyutu: tamsayi) -> tamsayi {
    degisken tip_adi: *u8 = lokal_bul_tip_adi(isim, uzn);
    eger tip_adi == 0 ise { dondu 0; }
    degisken tip_uzn: tamsayi = lokal_bul_tip_uzn(isim, uzn);
    eger tip_uzn != 2 ise { dondu 0; }
    eger tip_adi[0] != 117 ise { dondu 0; } # 'u'
    eger tip_adi[1] != 56 ise { dondu 0; }  # '8'
    # tip_adi == "u8": byte element if pointer depth == 1 OR stack array
    degisken yildiz: tamsayi = lokal_bul_yildiz(isim, uzn);
    eger yildiz == 1 ise { dondu 1; }
    eger dizi_boyutu > 0 ise { dondu 1; }
    dondu 0;
}

# u8 pointer (*u8, yildiz=1) veya [N]u8 array â†’ byte erisim (scale 1)
isv subscript_byte_mi_ast(arr_node: *AstDugum) -> tamsayi {
    # Check local table by identifier name
    eger arr_node.ilk_jeton != 0 ise {
        degisken tip_adi: *u8 = lokal_bul_tip_adi(arr_node.ilk_jeton.baslangic, arr_node.ilk_jeton.uzunluk);
        eger tip_adi != 0 ise {
            degisken tip_uzn: tamsayi = lokal_bul_tip_uzn(arr_node.ilk_jeton.baslangic, arr_node.ilk_jeton.uzunluk);
            eger tip_uzn == 2 ise {
                eger tip_adi[0] == 117 ise {
                    eger tip_adi[1] == 56 ise {
                        degisken yildiz: tamsayi = lokal_bul_yildiz(arr_node.ilk_jeton.baslangic, arr_node.ilk_jeton.uzunluk);
                        eger yildiz == 1 ise { dondu 1; }
                    }
                }
            }
        }
    }
    # Check arr_node.tip_adi (typechecker/parser-set type annotation)
    # Sadece *u8 (yildiz=1) veya [N]u8 (dizi_boyutu>0) icin byte erisimi
    eger arr_node.tip_adi != 0 ise {
        eger arr_node.tip_adi_uzunluk == 2 ise {
            eger arr_node.tip_adi[0] == 117 ise {
                eger arr_node.tip_adi[1] == 56 ise {
                    degisken ny: tamsayi = arr_node.cozumlenmis_tip;
                    degisken nd: tamsayi = arr_node.dizi_boyutu;
                    eger ny == 1 ise { dondu 1; }
                    eger nd > 0 ise { dondu 1; }
                }
            }
        }
    }
    dondu 0;
}

isv lokal_kaydet(isim: *u8, uzn: tamsayi, dizi_boyutu: tamsayi, tip_adi: *u8, tip_uzn: tamsayi, yildiz: tamsayi) -> tamsayi {
    eger dizi_boyutu > 0 ise {
        g_lokal_stack_offset = g_lokal_stack_offset + (dizi_boyutu * 8);
    } yoksa eger yildiz == 0 ve tip_adi != 0 ve tip_uzn > 0 ise {
        degisken byt: tamsayi = 8;
        degisken yi: tamsayi = 0;
        dongu yi < g_yapi_adet {
            eger g_yapi_uzunluk[yi] == tip_uzn ise {
                eger bellek_esit_mi(g_yapi_isim[yi], tip_adi, tip_uzn) == 1 ise {
                    byt = g_yapi_byte_boyutu[yi];
                    eger byt == 0 ise { byt = 8; }
                }
            }
            yi = yi + 1;
        }
        g_lokal_stack_offset = g_lokal_stack_offset + byt;
    } yoksa {
        g_lokal_stack_offset = g_lokal_stack_offset + 8;
    }
    degisken idx: tamsayi = g_lokal_adet;
    g_lokal_isimleri[idx] = isim;
    g_lokal_uzunluklari[idx] = uzn;
    g_lokal_offsetleri[idx] = g_lokal_stack_offset;
    g_lokal_tip_adlari[idx] = tip_adi;
    g_lokal_tip_uzunluklari[idx] = tip_uzn;
    g_lokal_yildizlari[idx] = yildiz;
    g_lokal_dizi_boyutlari[idx] = dizi_boyutu;
    g_lokal_adet = g_lokal_adet + 1;
    dondu g_lokal_stack_offset;
}

# ============================================================
# Struct (yapi) kayit tablosu
# ============================================================
degisken g_yapi_isim: [64]*u8;
degisken g_yapi_uzunluk: [64]tamsayi;
degisken g_yapi_alan_sayisi: [64]tamsayi;
degisken g_yapi_byte_boyutu: [64]tamsayi;

degisken g_yapi_alan_isim: [2048]*u8;
degisken g_yapi_alan_uzunluk: [2048]tamsayi;
degisken g_yapi_alan_offset: [2048]tamsayi;
degisken g_yapi_alan_tip_adi: [2048]*u8;
degisken g_yapi_alan_tip_uzn: [2048]tamsayi;
degisken g_yapi_alan_yildiz: [2048]tamsayi;

degisken g_yapi_adet: tamsayi = 0;

isv yapilari_topla(kok: *AstDugum) {
    degisken iter: *AstDugum = kok;
    dongu iter != 0 {
        eger iter.tip == 16 ise { # AST_YAPI_TANIMI
            degisken zaten_var: tamsayi = 0;
            degisken yi: tamsayi = 0;
            dongu yi < g_yapi_adet {
                eger g_yapi_uzunluk[yi] == iter.ilk_jeton.uzunluk ise {
                    eger bellek_esit_mi(g_yapi_isim[yi], iter.ilk_jeton.baslangic, iter.ilk_jeton.uzunluk) == 1 ise {
                        zaten_var = 1;
                    }
                }
                yi = yi + 1;
            }
            eger zaten_var == 0 ise {
                degisken yp_idx: tamsayi = g_yapi_adet;
                g_yapi_isim[yp_idx]       = iter.ilk_jeton.baslangic;
                g_yapi_uzunluk[yp_idx]    = iter.ilk_jeton.uzunluk;
                g_yapi_alan_sayisi[yp_idx] = 0;
                degisken yp_alan: *AstDugum = iter.sol;
                degisken yp_off: tamsayi = 0;
                dongu yp_alan != 0 {
                    degisken ai: tamsayi = g_yapi_alan_sayisi[yp_idx];
                    degisken a_idx: tamsayi = (yp_idx * 32) + ai;
                    g_yapi_alan_isim[a_idx]          = yp_alan.ilk_jeton.baslangic;
                    g_yapi_alan_uzunluk[a_idx]       = yp_alan.ilk_jeton.uzunluk;
                    g_yapi_alan_offset[a_idx]        = yp_off;
                    g_yapi_alan_tip_adi[a_idx]       = yp_alan.tip_adi;
                    g_yapi_alan_tip_uzn[a_idx]       = yp_alan.tip_adi_uzunluk;
                    g_yapi_alan_yildiz[a_idx]        = yp_alan.cozumlenmis_tip;
                    g_yapi_alan_sayisi[yp_idx] = ai + 1;
                    eger yp_alan.dizi_boyutu > 0 ise {
                        yp_off = yp_off + (yp_alan.dizi_boyutu * 8);
                    } yoksa {
                        yp_off = yp_off + 8;
                    }
                    yp_alan = yp_alan.sonraki;
                }
                g_yapi_adet = yp_idx + 1;
                g_yapi_byte_boyutu[yp_idx] = yp_off;
            }
        }
        iter = iter.sonraki;
    }
}

# Global tablolar paralel dizilerde tutuluyor
# g_yamalar replaced by flat arrays above
# Global yapi ve yama tablolari artik paralel dizilerde tutuluyor


yapi GlobalSabitDugum {
    isim: *u8;
    uzunluk: tamsayi;
    deger: tamsayi;
    sonraki: *GlobalSabitDugum;
}

degisken g_global_sabit_bas: *GlobalSabitDugum = 0;
degisken g_global_sabit_son: *GlobalSabitDugum = 0;

degisken g_global_isim: [1024]*u8;
degisken g_global_uzunluk: [1024]tamsayi;
degisken g_global_adres: [1024]tamsayi;
degisken g_global_tip_adi: [1024]*u8;
degisken g_global_tip_adi_uzunluk: [1024]tamsayi;
degisken g_global_is_pointer: [1024]tamsayi;
degisken g_global_dizi_boyutu: [1024]tamsayi;
degisken g_global_sayisi: tamsayi = 0;

degisken g_fonksiyon_icinde: tamsayi = 0;
degisken g_global_sabitleri_toplandi: tamsayi = 0;
degisken g_sabit_bulundu: tamsayi = 0;

isv global_sabit_ekle(isim: *u8, uzunluk: tamsayi, deger: tamsayi) {
    degisken yeni: *GlobalSabitDugum = bellek_tahsis_et(32);
    yeni.isim = isim;
    yeni.uzunluk = uzunluk;
    yeni.deger = deger;
    yeni.sonraki = 0;
    eger g_global_sabit_bas == 0 ise { g_global_sabit_bas = yeni; }
    yoksa { g_global_sabit_son.sonraki = yeni; }
    g_global_sabit_son = yeni;
}

isv global_sabit_bul(isim: *u8, uzunluk: tamsayi) -> tamsayi {
    degisken s: *GlobalSabitDugum = g_global_sabit_bas;
    dongu s != 0 {
        eger s.uzunluk == uzunluk ise {
            eger bellek_esit_mi(s.isim, isim, uzunluk) == 1 ise {
                g_sabit_bulundu = 1;
                dondu s.deger;
            }
        }
        s = s.sonraki;
    }
    g_sabit_bulundu = 0;
    dondu 0;
}

isv global_sabit_ifade_degeri(dugum: *AstDugum) -> tamsayi {
    g_sabit_bulundu = 0;
    eger dugum == 0 ise { dondu 0; }
    eger dugum.tip == AST_SAYI ise {
        g_sabit_bulundu = 1;
        dondu string_tamsayiya(dugum.ilk_jeton.baslangic, dugum.ilk_jeton.uzunluk);
    }
    eger dugum.tip == AST_GERCEK_SAYI ise {
        g_sabit_bulundu = 1;
        dondu string_gerceksayiya_ieee754(dugum.ilk_jeton.baslangic, dugum.ilk_jeton.uzunluk);
    }
    eger dugum.tip == AST_UNARY ise {
        degisken deger: tamsayi = global_sabit_ifade_degeri(dugum.sag);
        eger g_sabit_bulundu == 1 ise {
            eger dugum.ilk_jeton.tip == TIP_EKSI ise {
                dondu 0 - deger;
            }
            dondu deger;
        }
        dondu 0;
    }
    eger dugum.tip == AST_IKILI_OP ise {
        degisken sol: tamsayi = global_sabit_ifade_degeri(dugum.sol);
        eger g_sabit_bulundu == 0 ise { dondu 0; }
        degisken sag: tamsayi = global_sabit_ifade_degeri(dugum.sag);
        eger g_sabit_bulundu == 0 ise { dondu 0; }
        g_sabit_bulundu = 1;
        degisken op: tamsayi = dugum.ilk_jeton.tip;
        eger op == TIP_ARTI ise { dondu sol + sag; }
        eger op == TIP_EKSI ise { dondu sol - sag; }
        eger op == TIP_CARPI ise { dondu sol * sag; }
        eger op == TIP_BOLME ve sag != 0 ise { dondu sol / sag; }
        eger op == TIP_MODULO ve sag != 0 ise { dondu sol % sag; }
        g_sabit_bulundu = 0;
    }
    dondu 0;
}

isv global_sabitleri_topla(kok: *AstDugum, fonksiyon_icinde: tamsayi) {
    degisken iter: *AstDugum = kok;
    dongu iter != 0 {
        eger iter.tip == AST_DEGISKEN_TANIMI ise {
            degisken deger: tamsayi = global_sabit_ifade_degeri(iter.sag);
            eger g_sabit_bulundu == 1 ise {
                global_sabit_ekle(iter.ilk_jeton.baslangic, iter.ilk_jeton.uzunluk, deger);
            }
        }
        iter = iter.sonraki;
    }
}

degisken g_loop_stack_bas: [16]tamsayi;
degisken g_loop_stack_sp: tamsayi = 0;
degisken g_durdur_yamalar: [128]tamsayi;
degisken g_durdur_dongu_id: [128]tamsayi;
degisken g_devam_yamalar: [128]tamsayi;
degisken g_devam_dongu_id: [128]tamsayi;
degisken g_durdur_adet: tamsayi = 0;
degisken g_devam_adet: tamsayi = 0;

isv emit_store_rax(a: *MakineKoduArenasi, off: tamsayi) {
    eger off <= 127 ise {
        byte_yaz(a, 0x48); byte_yaz(a, 0x89); byte_yaz(a, 0x45);
        byte_yaz(a, 256 - off);
    } yoksa {
        byte_yaz(a, 0x48); byte_yaz(a, 0x89); byte_yaz(a, 0x85);
        int32_yaz(a, 0 - off);
    }
}

isv emit_load_rax(a: *MakineKoduArenasi, off: tamsayi) {
    eger off <= 127 ise {
        byte_yaz(a, 0x48); byte_yaz(a, 0x8B); byte_yaz(a, 0x45);
        byte_yaz(a, 256 - off);
    } yoksa {
        byte_yaz(a, 0x48); byte_yaz(a, 0x8B); byte_yaz(a, 0x85);
        int32_yaz(a, 0 - off);
    }
}

isv emit_lea_rax(a: *MakineKoduArenasi, off: tamsayi) {
    eger off <= 127 ise {
        byte_yaz(a, 0x48); byte_yaz(a, 0x8D); byte_yaz(a, 0x45);
        byte_yaz(a, 256 - off);
    } yoksa {
        byte_yaz(a, 0x48); byte_yaz(a, 0x8D); byte_yaz(a, 0x85);
        int32_yaz(a, 0 - off);
    }
}

# ============================================================
# AST -> x86_64 kod uretimi
# ============================================================
isv string_tamsayiya(veri: *u8, uzn: tamsayi) -> tamsayi {
    degisken sonuc: tamsayi = 0;
    degisken i: tamsayi = 0;
    degisken sign: tamsayi = 1;
    eger uzn > 0 ve veri[0] == 45 ise {
        sign = 0 - 1;
        i = 1;
    }
    eger (uzn - i) >= 2 ve veri[i] == 48 ve (veri[i + 1] == 120 veya veri[i + 1] == 88) ise {
        i = i + 2;
        dongu i < uzn {
            degisken c: u8 = veri[i];
            degisken digit: tamsayi = 0;
            eger c >= 48 ve c <= 57 ise { digit = c - 48; }
            yoksa eger c >= 97 ve c <= 102 ise { digit = (c - 97) + 10; }
            yoksa eger c >= 65 ve c <= 70 ise { digit = (c - 65) + 10; }
            sonuc = (sonuc * 16) + digit;
            i = i + 1;
        }
        dondu sign * sonuc;
    }
    dongu i < uzn {
        sonuc = (sonuc * 10) + (veri[i] - 48);
        i = i + 1;
    }
    dondu sign * sonuc;
}

isv string_gerceksayiya_ieee754(veri: *u8, uzn: tamsayi) -> tamsayi {
    degisken i: tamsayi = 0;
    degisken sign: tamsayi = 0;
    eger uzn > 0 ve veri[0] == 45 ise { # '-'
        sign = 1;
        i = 1;
    }
    degisken int_part: tamsayi = 0;
    dongu i < uzn ve veri[i] >= 48 ve veri[i] <= 57 {
        int_part = (int_part * 10) + (veri[i] - 48);
        i = i + 1;
    }
    degisken frac_part: tamsayi = 0;
    degisken frac_div: tamsayi = 1;
    eger i < uzn ve veri[i] == 46 ise { # '.'
        i = i + 1;
        dongu i < uzn ve veri[i] >= 48 ve veri[i] <= 57 {
            frac_part = (frac_part * 10) + (veri[i] - 48);
            frac_div = frac_div * 10;
            i = i + 1;
        }
    }
    eger int_part == 0 ve frac_part == 0 ise {
        eger sign == 1 ise { dondu 0 - 9223372036854775808; }
        dondu 0;
    }
    
    degisken exp: tamsayi = 1023;
    degisken mantissa: tamsayi = 0;
    
    eger int_part > 0 ise {
        degisken b: tamsayi = 0;
        degisken temp: tamsayi = int_part;
        dongu temp > 1 {
            temp = temp / 2;
            b = b + 1;
        }
        exp = 1023 + b;
        degisken shift: tamsayi = 52 - b;
        eger shift >= 0 ise {
            degisken mul: tamsayi = 1;
            degisken s_idx: tamsayi = 0;
            dongu s_idx < shift { mul = mul * 2; s_idx = s_idx + 1; }
            degisken m_int: tamsayi = int_part * mul;
            degisken m_frac: tamsayi = (frac_part * mul) / frac_div;
            mantissa = m_int + m_frac;
        } yoksa {
            degisken div: tamsayi = 1;
            degisken s_idx2: tamsayi = 0;
            dongu s_idx2 < (0 - shift) { div = div * 2; s_idx2 = s_idx2 + 1; }
            mantissa = int_part / div;
        }
        degisken bit52: tamsayi = 4503599627370496; # 2^52
        mantissa = mantissa % bit52;
    } yoksa {
        degisken shift_cnt: tamsayi = 1;
        degisken cur_f: tamsayi = frac_part * 2;
        dongu cur_f < frac_div {
            cur_f = cur_f * 2;
            shift_cnt = shift_cnt + 1;
        }
        exp = 1023 - shift_cnt;
        degisken rem_f: tamsayi = cur_f - frac_div;
        degisken mul: tamsayi = 4503599627370496; # 2^52
        mantissa = (rem_f * mul) / frac_div;
    }
    
    degisken sonuc: tamsayi = mantissa + (exp * 4503599627370496);
    eger sign == 1 ise {
        sonuc = sonuc + (0 - 9223372036854775808);
    }
    dondu sonuc;
}

isv tip_adini_coz_yerel(ad: *u8, uzunluk: tamsayi) -> tamsayi {
    eger ad == 0 veya uzunluk <= 0 ise { dondu 0; }
    eger ad[0] == 42 ise { dondu 8; } # Pointer
    
    eger uzunluk == 2 ise {
        eger ad[0] == 117 ve ad[1] == 56 ise { dondu 6; } # u8
    }
    eger uzunluk == 3 ise {
        eger bellek_esit_mi(ad, "int".ptr, 3) == 1 ise { dondu 1; }
        eger bellek_esit_mi(ad, "i64".ptr, 3) == 1 ise { dondu 1; }
        eger bellek_esit_mi(ad, "u64".ptr, 3) == 1 ise { dondu 1; }
        eger bellek_esit_mi(ad, "i32".ptr, 3) == 1 ise { dondu 1; }
        eger bellek_esit_mi(ad, "u32".ptr, 3) == 1 ise { dondu 1; }
        eger bellek_esit_mi(ad, "f32".ptr, 3) == 1 ise { dondu 2; }
        eger bellek_esit_mi(ad, "f64".ptr, 3) == 1 ise { dondu 2; }
        eger bellek_esit_mi(ad, "hic".ptr, 3) == 1 ise { dondu 5; }
        eger bellek_esit_mi(ad, "str".ptr, 3) == 1 ise { dondu 3; }
        eger bellek_esit_mi(ad, "空".ptr, 3) == 1 ise { dondu 5; }
        eger bellek_esit_mi(ad, "無".ptr, 3) == 1 ise { dondu 5; }
    }
    eger uzunluk == 4 ise {
        eger bellek_esit_mi(ad, "sayi".ptr, 4) == 1 ise { dondu 1; }
        eger bellek_esit_mi(ad, "bool".ptr, 4) == 1 ise { dondu 4; }
        eger bellek_esit_mi(ad, "char".ptr, 4) == 1 ise { dondu 6; }
        eger bellek_esit_mi(ad, "byte".ptr, 4) == 1 ise { dondu 6; }
        eger bellek_esit_mi(ad, "void".ptr, 4) == 1 ise { dondu 5; }
        eger bellek_esit_mi(ad, "null".ptr, 4) == 1 ise { dondu 5; }
    }
    eger uzunluk == 5 ise {
        eger bellek_esit_mi(ad, "metin".ptr, 5) == 1 ise { dondu 3; }
        eger bellek_esit_mi(ad, "float".ptr, 5) == 1 ise { dondu 2; }
    }
    eger uzunluk == 6 ise {
        eger bellek_esit_mi(ad, "gercek".ptr, 6) == 1 ise { dondu 2; }
        eger bellek_esit_mi(ad, "double".ptr, 6) == 1 ise { dondu 2; }
        eger bellek_esit_mi(ad, "вещ".ptr, 6) == 1 ise { dondu 2; }
        eger bellek_esit_mi(ad, "浮動".ptr, 6) == 1 ise { dondu 2; }
        eger bellek_esit_mi(ad, "小数".ptr, 6) == 1 ise { dondu 2; }
        eger bellek_esit_mi(ad, "소수".ptr, 6) == 1 ise { dondu 2; }
        eger bellek_esit_mi(ad, "mantik".ptr, 6) == 1 ise { dondu 4; }
        eger bellek_esit_mi(ad, "string".ptr, 6) == 1 ise { dondu 3; }
        eger bellek_esit_mi(ad, "整数".ptr, 6) == 1 ise { dondu 1; }
        eger bellek_esit_mi(ad, "정수".ptr, 6) == 1 ise { dondu 1; }
        eger bellek_esit_mi(ad, "字节".ptr, 6) == 1 ise { dondu 6; }
        eger bellek_esit_mi(ad, "浮点".ptr, 6) == 1 ise { dondu 2; }
        eger bellek_esit_mi(ad, "실수".ptr, 6) == 1 ise { dondu 2; }
        eger bellek_esit_mi(ad, "布尔".ptr, 6) == 1 ise { dondu 4; }
        eger bellek_esit_mi(ad, "論理".ptr, 6) == 1 ise { dondu 4; }
        eger bellek_esit_mi(ad, "없음".ptr, 6) == 1 ise { dondu 5; }
    }
    eger uzunluk == 7 ise {
        eger bellek_esit_mi(ad, "tamsayi".ptr, 7) == 1 ise { dondu 1; }
        eger bellek_esit_mi(ad, "boolean".ptr, 7) == 1 ise { dondu 4; }
        eger bellek_esit_mi(ad, "kesirli".ptr, 7) == 1 ise { dondu 2; }
        eger bellek_esit_mi(ad, "decimal".ptr, 7) == 1 ise { dondu 2; }
    }
    eger uzunluk == 8 ise {
        eger bellek_esit_mi(ad, "flottant".ptr, 8) == 1 ise { dondu 2; }
        eger bellek_esit_mi(ad, "décimal".ptr, 8) == 1 ise { dondu 2; }
    }
    eger uzunluk == 9 ise {
        eger bellek_esit_mi(ad, "kesirli32".ptr, 9) == 1 ise { dondu 2; }
        eger bellek_esit_mi(ad, "kesirli64".ptr, 9) == 1 ise { dondu 2; }
        eger bellek_esit_mi(ad, "バイト".ptr, 9) == 1 ise { dondu 6; }
        eger bellek_esit_mi(ad, "바이트".ptr, 9) == 1 ise { dondu 6; }
        eger bellek_esit_mi(ad, "불리언".ptr, 9) == 1 ise { dondu 4; }
    }
    eger uzunluk == 14 ise {
        eger bellek_esit_mi(ad, "дробное".ptr, 14) == 1 ise { dondu 2; }
    }
    dondu 0;
}

isv ast_node_is_float(d: *AstDugum) -> tamsayi {
    eger d == 0 ise { dondu 0; }
    eger d.tip == AST_GERCEK_SAYI ise { dondu 1; }
    eger d.tip == AST_SAYI veya d.tip == AST_METIN veya d.tip == AST_MANTIK ise { dondu 0; }
    eger d.tip == AST_KIMLIK ise {
        eger d.ilk_jeton == 0 ise { dondu 0; }
        degisken isim: *u8 = d.ilk_jeton.baslangic;
        degisken uzn: tamsayi = d.ilk_jeton.uzunluk;
        degisken i: tamsayi = g_lokal_adet - 1;
        dongu i >= 0 {
            eger g_lokal_uzunluklari[i] == uzn ve bellek_esit_mi(g_lokal_isimleri[i], isim, uzn) == 1 ise {
                eger g_lokal_yildizlari[i] > 0 ise { dondu 0; }
                eger g_lokal_tip_adlari[i] != 0 ve g_lokal_tip_uzunluklari[i] > 0 ise {
                    degisken tid: tamsayi = tip_adini_coz_yerel(g_lokal_tip_adlari[i], g_lokal_tip_uzunluklari[i]);
                    eger tid == 2 ise { dondu 1; }
                }
                dondu 0;
            }
            i = i - 1;
        }
        degisken gi: tamsayi = 0;
        dongu gi < g_global_sayisi {
            eger g_global_uzunluk[gi] == uzn ve bellek_esit_mi(g_global_isim[gi], isim, uzn) == 1 ise {
                eger g_global_is_pointer[gi] > 0 ise { dondu 0; }
                eger g_global_tip_adi[gi] != 0 ve g_global_tip_adi_uzunluk[gi] > 0 ise {
                    degisken gtid: tamsayi = tip_adini_coz_yerel(g_global_tip_adi[gi], g_global_tip_adi_uzunluk[gi]);
                    eger gtid == 2 ise { dondu 1; }
                }
                dondu 0;
            }
            gi = gi + 1;
        }
        dondu 0;
    }
    eger d.tip == AST_IKILI_OP ise {
        eger d.ilk_jeton != 0 ise {
            degisken op: tamsayi = d.ilk_jeton.tip;
            eger op == TIP_ESIT_MI veya op == TIP_ESIT_DEGIL veya op == TIP_KUCUK_MU veya op == TIP_BUYUK_MU veya op == TIP_KUCUK_ESIT veya op == TIP_BUYUK_ESIT ise {
                dondu 0;
            }
            eger op == TIP_VE veya op == TIP_VEYA ise { dondu 0; }
        }
        eger ast_node_is_float(d.sol) == 1 ise { dondu 1; }
        eger ast_node_is_float(d.sag) == 1 ise { dondu 1; }
        dondu 0;
    }
    eger d.tip == AST_UNARY ise {
        dondu ast_node_is_float(d.sag);
    }
    eger d.tip == 11 ise { # AST_ISLEV_CAGRISI
        eger d.ilk_jeton == 0 ise { dondu 0; }
        degisken fname: *u8 = d.ilk_jeton.baslangic;
        degisken flen: tamsayi = d.ilk_jeton.uzunluk;
        eger tip_adini_coz_yerel(fname, flen) == 2 ise { dondu 1; }
        dondu 0;
    }
    dondu 0;
}

isv ast_kod_uret(a: *MakineKoduArenasi, dugum: *AstDugum) -> tamsayi {
    eger dugum == 0 ise { dondu 0; }
    eger dugum.tip == AST_ICE_AKTAR ise { dondu 0; }
    eger g_global_sabitleri_toplandi == 0 ise {
        global_sabitleri_topla(dugum, 0);
        yapilari_topla(dugum);
        g_global_sabitleri_toplandi = 1;
    }

    eger dugum.tip == AST_SAYI ise {
        degisken sayi: tamsayi = string_tamsayiya(dugum.ilk_jeton.baslangic, dugum.ilk_jeton.uzunluk);
        emit_mov_rax_imm32(a, sayi);
        dondu 0;
    }

    eger dugum.tip == AST_GERCEK_SAYI ise {
        degisken u64val: tamsayi = string_gerceksayiya_ieee754(dugum.ilk_jeton.baslangic, dugum.ilk_jeton.uzunluk);
        byte_yaz(a, 0x48); byte_yaz(a, 0xB8);
        int64_yaz(a, u64val);
        byte_yaz(a, 0x66); byte_yaz(a, 0x48); byte_yaz(a, 0x0F); byte_yaz(a, 0x6E); byte_yaz(a, 0xC0);
        dondu 0;
    }

    # --------------------------------------------------------
    # AST_METIN: String verisini atla, RAX'a adresini LEA ile yukle
    # --------------------------------------------------------
    eger dugum.tip == AST_METIN ise {
        degisken ic_uzunluk: tamsayi = dugum.ilk_jeton.uzunluk;
        degisken ic_baslangic: *u8 = dugum.ilk_jeton.baslangic;
        
        eger ic_uzunluk >= 2 ve ic_baslangic[0] == 34 ise { # '"'
            ic_baslangic = ic_baslangic + 1;
            ic_uzunluk = ic_uzunluk - 2;
        }
        
        degisken gercek_uzunluk: tamsayi = 0;
        degisken i: tamsayi = 0;
        dongu i < ic_uzunluk {
            eger ic_baslangic[i] == 92 ve (i + 1) < ic_uzunluk ve ic_baslangic[i + 1] == 110 ise { # '\n'
                gercek_uzunluk = gercek_uzunluk + 1;
                i = i + 1;
            } yoksa {
                gercek_uzunluk = gercek_uzunluk + 1;
            }
            i = i + 1;
        }
        
        byte_yaz(a, 0xE9);
        int32_yaz(a, gercek_uzunluk + 1);
        
        degisken str_pos: tamsayi = a.kullanilan;
        i = 0;
        dongu i < ic_uzunluk {
            eger ic_baslangic[i] == 92 ve (i + 1) < ic_uzunluk ve ic_baslangic[i + 1] == 110 ise {
                byte_yaz(a, 10);
                i = i + 1;
            } yoksa {
                byte_yaz(a, ic_baslangic[i]);
            }
            i = i + 1;
        }
        byte_yaz(a, 0);
        
        byte_yaz(a, 0x48); byte_yaz(a, 0x8D); byte_yaz(a, 0x05);
        int32_yaz(a, str_pos - (a.kullanilan + 4));
        dondu 0;
    }

    # --------------------------------------------------------
    # AST_KIMLIK: Yerel degisken degerini RAX'e yukle
    # --------------------------------------------------------
    eger dugum.tip == AST_KIMLIK ise {
        eger dugum.ilk_jeton == 0 ise {
            emit_xor_rax_rax(a);
            dondu 0;
        }
        degisken off: tamsayi = lokal_bul_offset(dugum.ilk_jeton.baslangic, dugum.ilk_jeton.uzunluk);
        degisken var_dizi: tamsayi = lokal_bul_dizi(dugum.ilk_jeton.baslangic, dugum.ilk_jeton.uzunluk);
        degisken yildiz: tamsayi = lokal_bul_yildiz(dugum.ilk_jeton.baslangic, dugum.ilk_jeton.uzunluk);
        degisken is_local_struct: tamsayi = 0;
        eger yildiz == 0 ise {
            degisken tip_adi: *u8 = lokal_bul_tip_adi(dugum.ilk_jeton.baslangic, dugum.ilk_jeton.uzunluk);
            eger tip_adi != 0 ise {
                degisken tip_uzn: tamsayi = lokal_bul_tip_uzn(dugum.ilk_jeton.baslangic, dugum.ilk_jeton.uzunluk);
                degisken ji: tamsayi = 0;
                dongu ji < g_yapi_adet {
                    eger g_yapi_uzunluk[ji] == tip_uzn ise {
                        eger bellek_esit_mi(g_yapi_isim[ji], tip_adi, tip_uzn) == 1 ise {
                            is_local_struct = 1;
                        }
                    }
                    ji = ji + 1;
                }
            }
        }
        eger off != 0 ise {
            eger var_dizi > 0 veya is_local_struct == 1 ise {
                emit_lea_rax(a, off);
            } yoksa {
                emit_load_rax(a, off);
            }
        } yoksa {
            degisken g_idx: tamsayi = 0 - 1;
            degisken gi: tamsayi = 0;
            dongu gi < g_global_sayisi {
                eger g_global_uzunluk[gi] == dugum.ilk_jeton.uzunluk ise {
                    eger bellek_esit_mi(g_global_isim[gi], dugum.ilk_jeton.baslangic, dugum.ilk_jeton.uzunluk) == 1 ise {
                        g_idx = gi;
                    }
                }
                gi = gi + 1;
            }
            eger g_idx != 0 - 1 ise {
                degisken is_global_struct: tamsayi = 0;
                degisken gtip: *u8 = g_global_tip_adi[g_idx];
                degisken gt_uzn: tamsayi = g_global_tip_adi_uzunluk[g_idx];
                eger gtip != 0 ve g_global_is_pointer[g_idx] == 0 ise {
                    degisken jg: tamsayi = 0;
                    dongu jg < g_yapi_adet {
                        eger g_yapi_uzunluk[jg] == gt_uzn ise {
                            eger bellek_esit_mi(g_yapi_isim[jg], gtip, gt_uzn) == 1 ise {
                                is_global_struct = 1;
                            }
                        }
                        jg = jg + 1;
                    }
                }
                degisken g_addr: tamsayi = g_global_adres[g_idx];
                eger g_global_dizi_boyutu[g_idx] > 0 veya is_global_struct == 1 ise {
                    byte_yaz(a, 72); byte_yaz(a, 141); byte_yaz(a, 5);
                } yoksa {
                    byte_yaz(a, 72); byte_yaz(a, 139); byte_yaz(a, 5);
                }
                int32_yaz(a, g_addr - (a.kullanilan + 4));
            } yoksa {
                degisken gval: tamsayi = global_sabit_bul(dugum.ilk_jeton.baslangic, dugum.ilk_jeton.uzunluk);
                eger g_sabit_bulundu == 1 ise {
                    emit_mov_rax_imm32(a, gval);
                } yoksa {
                    emit_xor_rax_rax(a);
                }
            }
        }
        dondu 0;
    }

    # --------------------------------------------------------
    # AST_DEGISKEN_TANIMI: Stack'te yer ac, ilk degeri kaydet
    # --------------------------------------------------------
    eger dugum.tip == AST_DEGISKEN_TANIMI ise {
        eger g_fonksiyon_icinde == 0 ise {
            degisken obj_isim: *u8 = 0;
            degisken obj_uzn: tamsayi = 0;
            eger dugum.ilk_jeton != 0 ise {
                degisken j1: *Jeton = dugum.ilk_jeton;
                obj_isim = j1.baslangic;
                obj_uzn = j1.uzunluk;
            }
            degisken gval: tamsayi = 0;
            degisken gval_bulundu: tamsayi = 0;
            eger dugum.sag != 0 ve dugum.sag.tip == 1 ise {
                degisken s_j: *Jeton = dugum.sag.ilk_jeton;
                gval = string_tamsayiya(s_j.baslangic, s_j.uzunluk);
                gval_bulundu = 1;
            }
            eger gval_bulundu == 1 ise {
                global_sabit_ekle(obj_isim, obj_uzn, gval);
            }
            degisken g_size: tamsayi = 8192;
            eger dugum.dizi_boyutu > 0 ise {
                g_size = dugum.dizi_boyutu * 8;
                eger g_size < 8192 ise { g_size = 8192; }
            }
            byte_yaz(a, 233);
            int32_yaz(a, g_size);
            degisken g_addr: tamsayi = a.kullanilan;
            eger gval_bulundu == 1 ise {
                int64_yaz(a, gval);
                a.kullanilan = a.kullanilan + (g_size - 8);
            } yoksa {
                a.kullanilan = a.kullanilan + g_size;
            }
            eger g_global_sayisi < 1024 ise {
                g_global_isim[g_global_sayisi] = obj_isim;
                g_global_uzunluk[g_global_sayisi] = obj_uzn;
                g_global_adres[g_global_sayisi] = g_addr;
                g_global_tip_adi[g_global_sayisi] = dugum.tip_adi;
                g_global_tip_adi_uzunluk[g_global_sayisi] = dugum.tip_adi_uzunluk;
                g_global_is_pointer[g_global_sayisi] = dugum.cozumlenmis_tip;
                g_global_dizi_boyutu[g_global_sayisi] = dugum.dizi_boyutu;
                g_global_sayisi = g_global_sayisi + 1;
            }
            dondu 0;
        }

        # Once baslangic degerini hesapla (RAX'e)
        eger dugum.sag != 0 ise {
            ast_kod_uret(a, dugum.sag);
        } yoksa {
            emit_xor_rax_rax(a);
        }
        # Lokal tablosuna kaydet, stack offset al
        degisken off: tamsayi = lokal_kaydet(
            dugum.ilk_jeton.baslangic,
            dugum.ilk_jeton.uzunluk,
            dugum.dizi_boyutu,
            dugum.tip_adi,
            dugum.tip_adi_uzunluk,
            dugum.cozumlenmis_tip
        );
        # RAX'i [RBP - off] adresine yaz
        emit_store_rax(a, off);
        dondu 0;
    }

    # --------------------------------------------------------
    # AST_ATAMA: sag = ifade, sol = hedef (KIMLIK veya INDEKS)
    # --------------------------------------------------------
    eger dugum.tip == AST_ATAMA ise {
        ast_kod_uret(a, dugum.sag);
        degisken sol: *AstDugum = dugum.sol;
        eger sol == 0 ise {
            dondu 0;
        }
        # Basit degisken atamasi: x = ifade
        eger sol.tip == AST_KIMLIK ise {
            eger sol.ilk_jeton == 0 ise {
                dondu 0;
            }
            eger sol.ilk_jeton.baslangic == 0 veya sol.ilk_jeton.uzunluk == 0 ise {
                dondu 0;
            }
            degisken off: tamsayi = lokal_bul_offset(sol.ilk_jeton.baslangic, sol.ilk_jeton.uzunluk);
            eger off != 0 ise {
                emit_store_rax(a, off);
            } yoksa {
                degisken gi: tamsayi = 0;
                dongu gi < g_global_sayisi {
                    eger g_global_uzunluk[gi] == sol.ilk_jeton.uzunluk ise {
                        eger bellek_esit_mi(g_global_isim[gi], sol.ilk_jeton.baslangic, sol.ilk_jeton.uzunluk) == 1 ise {
                            degisken g_addr: tamsayi = g_global_adres[gi];
                            byte_yaz(a, 0x48); byte_yaz(a, 0x89); byte_yaz(a, 0x05); # MOV [RIP+rel32], RAX
                            int32_yaz(a, g_addr - (a.kullanilan + 4));
                        }
                    }
                    gi = gi + 1;
                }
            }
            dondu 0;
        }
        # Pointer dereference atamasi: *ptr = ifade  => MOV [RAX], RCX
        eger sol.tip == 19 ise { # AST_UNARY
            byte_yaz(a, 0x50); # PUSH RAX (atanacak deger)
            ast_kod_uret(a, sol.sag); # pointer adresini RAX'e al
            byte_yaz(a, 0x59); # POP RCX (atanacak deger)
            byte_yaz(a, 0x48); byte_yaz(a, 0x89); byte_yaz(a, 0x08); # MOV [RAX], RCX
            dondu 0;
        }
        # Struct alan atamasi: obj.field = ifade
        eger sol.tip == 17 ise { # AST_ALAN_ERISIMI
            byte_yaz(a, 0x50); # PUSH RAX (atanacak deger)
            degisken asgn_obj: *AstDugum = sol.sol;
            degisken asgn_field: *AstDugum = sol.sag;
            degisken asgn_var_off: tamsayi = 0;
            degisken asgn_t_adi: *u8 = 0;
            degisken asgn_t_uzn: tamsayi = 0;
            degisken obj_is_ptr: tamsayi = 0;
            degisken g_addr: tamsayi = 0;
            degisken g_found: tamsayi = 0;
            eger asgn_obj.tip == AST_KIMLIK ise {
                degisken ki: tamsayi = 0;
                degisken b_bulundu: tamsayi = 0;
                dongu ki < g_lokal_adet {
                    eger g_lokal_uzunluklari[ki] == asgn_obj.ilk_jeton.uzunluk ise {
                        eger bellek_esit_mi(g_lokal_isimleri[ki], asgn_obj.ilk_jeton.baslangic, g_lokal_uzunluklari[ki]) == 1 ise {
                            asgn_var_off = g_lokal_offsetleri[ki];
                            asgn_t_adi   = g_lokal_tip_adlari[ki];
                            asgn_t_uzn   = g_lokal_tip_uzunluklari[ki];
                            obj_is_ptr   = g_lokal_yildizlari[ki];
                            b_bulundu = 1;
                        }
                    }
                    ki = ki + 1;
                }
                eger b_bulundu == 0 ise {
                    degisken gi: tamsayi = 0;
                    dongu gi < g_global_sayisi {
                        eger g_global_uzunluk[gi] == asgn_obj.ilk_jeton.uzunluk ise {
                            eger bellek_esit_mi(g_global_isim[gi], asgn_obj.ilk_jeton.baslangic, asgn_obj.ilk_jeton.uzunluk) == 1 ise {
                                g_addr       = g_global_adres[gi];
                                asgn_t_adi   = g_global_tip_adi[gi];
                                asgn_t_uzn   = g_global_tip_adi_uzunluk[gi];
                                obj_is_ptr   = g_global_is_pointer[gi];
                                g_found      = 1;
                            }
                        }
                        gi = gi + 1;
                    }
                }
            }
            # Fallback: nested objeler icin asgn_obj dugumunun kendi tip alanlarini kullan
            eger asgn_t_adi == 0 veya asgn_t_uzn == 0 ise {
                degisken af_tip: *u8 = asgn_obj.tip_adi;
                degisken af_uzn: tamsayi = asgn_obj.tip_adi_uzunluk;
                eger af_tip != 0 ve af_uzn > 0 ise {
                    asgn_t_adi = af_tip;
                    asgn_t_uzn = af_uzn;
                }
            }
            degisken asgn_field_off: tamsayi = 0 - 1;
            eger asgn_t_adi != 0 ise {
                degisken yi: tamsayi = 0;
                dongu yi < g_yapi_adet {
                    eger g_yapi_uzunluk[yi] == asgn_t_uzn ise {
                        eger bellek_esit_mi(g_yapi_isim[yi], asgn_t_adi, asgn_t_uzn) == 1 ise {
                            degisken ai: tamsayi = 0;
                            dongu ai < g_yapi_alan_sayisi[yi] {
                                degisken a_idx: tamsayi = (yi * 32) + ai;
                                eger g_yapi_alan_uzunluk[a_idx] == asgn_field.ilk_jeton.uzunluk ise {
                                    eger bellek_esit_mi(g_yapi_alan_isim[a_idx], asgn_field.ilk_jeton.baslangic, g_yapi_alan_uzunluk[a_idx]) == 1 ise {
                                        asgn_field_off = g_yapi_alan_offset[a_idx];
                                    }
                                }
                                ai = ai + 1;
                            }
                        }
                    }
                    yi = yi + 1;
                }
            }
            eger asgn_field_off == (0 - 1) ve asgn_field != 0 ve asgn_field.ilk_jeton != 0 ise {
                degisken f_uzn: tamsayi = asgn_field.ilk_jeton.uzunluk;
                degisken f_ptr: *u8 = asgn_field.ilk_jeton.baslangic;
                eger f_uzn == 3 ve bellek_esit_mi(f_ptr, "tip".ptr, 3) == 1 ise { asgn_field_off = 0; }
                eger f_uzn == 9 ve bellek_esit_mi(f_ptr, "ilk_jeton".ptr, 9) == 1 ise { asgn_field_off = 8; }
                eger f_uzn == 9 ve bellek_esit_mi(f_ptr, "son_jeton".ptr, 9) == 1 ise { asgn_field_off = 16; }
                eger f_uzn == 3 ve bellek_esit_mi(f_ptr, "sol".ptr, 3) == 1 ise { asgn_field_off = 24; }
                eger f_uzn == 3 ve bellek_esit_mi(f_ptr, "sag".ptr, 3) == 1 ise { asgn_field_off = 32; }
                eger f_uzn == 7 ve bellek_esit_mi(f_ptr, "sonraki".ptr, 7) == 1 ise { asgn_field_off = 40; }
                eger f_uzn == 5 ve bellek_esit_mi(f_ptr, "govde".ptr, 5) == 1 ise { asgn_field_off = 48; }
                eger f_uzn == 11 ve bellek_esit_mi(f_ptr, "yoksa_govde".ptr, 11) == 1 ise { asgn_field_off = 56; }
                eger f_uzn == 12 ve bellek_esit_mi(f_ptr, "parametreler".ptr, 12) == 1 ise { asgn_field_off = 64; }
                eger f_uzn == 7 ve bellek_esit_mi(f_ptr, "tip_adi".ptr, 7) == 1 ise { asgn_field_off = 72; }
                eger f_uzn == 15 ve bellek_esit_mi(f_ptr, "tip_adi_uzunluk".ptr, 15) == 1 ise { asgn_field_off = 80; }
                eger f_uzn == 15 ve bellek_esit_mi(f_ptr, "cozumlenmis_tip".ptr, 15) == 1 ise { asgn_field_off = 88; }
                eger f_uzn == 11 ve bellek_esit_mi(f_ptr, "dizi_boyutu".ptr, 11) == 1 ise { asgn_field_off = 96; }
                eger f_uzn == 9 ve bellek_esit_mi(f_ptr, "baslangic".ptr, 9) == 1 ise { asgn_field_off = 8; }
                eger f_uzn == 7 ve bellek_esit_mi(f_ptr, "uzunluk".ptr, 7) == 1 ise { asgn_field_off = 16; }
                eger f_uzn == 5 ve bellek_esit_mi(f_ptr, "satir".ptr, 5) == 1 ise { asgn_field_off = 24; }
                eger f_uzn == 5 ve bellek_esit_mi(f_ptr, "sutun".ptr, 5) == 1 ise { asgn_field_off = 32; }
                eger f_uzn == 6 ve bellek_esit_mi(f_ptr, "kaynak".ptr, 6) == 1 ise { asgn_field_off = 0; }
                eger f_uzn == 12 ve bellek_esit_mi(f_ptr, "dosya_boyutu".ptr, 12) == 1 ise { asgn_field_off = 8; }
                eger f_uzn == 13 ve bellek_esit_mi(f_ptr, "guncel_offset".ptr, 13) == 1 ise { asgn_field_off = 16; }
                eger f_uzn == 8 ve bellek_esit_mi(f_ptr, "jetonlar".ptr, 8) == 1 ise {
                    eger asgn_t_adi != 0 ve asgn_t_uzn == 12 ve bellek_esit_mi(asgn_t_adi, "ParserDurumu".ptr, 12) == 1 ise { asgn_field_off = 0; }
                    yoksa { asgn_field_off = 40; }
                }
                eger f_uzn == 12 ve bellek_esit_mi(f_ptr, "jeton_sayisi".ptr, 12) == 1 ise {
                    eger asgn_t_adi != 0 ve asgn_t_uzn == 12 ve bellek_esit_mi(asgn_t_adi, "ParserDurumu".ptr, 12) == 1 ise { asgn_field_off = 8; }
                    yoksa { asgn_field_off = 48; }
                }
                eger f_uzn == 14 ve bellek_esit_mi(f_ptr, "jeton_kapasite".ptr, 14) == 1 ise { asgn_field_off = 56; }
                eger f_uzn == 4 ve bellek_esit_mi(f_ptr, "pool".ptr, 4) == 1 ise { asgn_field_off = 64; }
                eger f_uzn == 12 ve bellek_esit_mi(f_ptr, "guncel_index".ptr, 12) == 1 ise { asgn_field_off = 16; }
                eger f_uzn == 5 ve bellek_esit_mi(f_ptr, "arena".ptr, 5) == 1 ise {
                    eger asgn_t_adi != 0 ve asgn_t_uzn == 14 ve bellek_esit_mi(asgn_t_adi, "GenericsMotoru".ptr, 14) == 1 ise { asgn_field_off = 16; }
                    yoksa { asgn_field_off = 24; }
                }
                eger f_uzn == 6 ve bellek_esit_mi(f_ptr, "bellek".ptr, 6) == 1 ise { asgn_field_off = 0; }
                eger f_uzn == 8 ve bellek_esit_mi(f_ptr, "kapasite".ptr, 8) == 1 ise { asgn_field_off = 8; }
                eger f_uzn == 10 ve bellek_esit_mi(f_ptr, "kullanilan".ptr, 10) == 1 ise { asgn_field_off = 16; }
                eger f_uzn == 8 ve bellek_esit_mi(f_ptr, "kurallar".ptr, 8) == 1 ise { asgn_field_off = 0; }
                eger f_uzn == 12 ve bellek_esit_mi(f_ptr, "kayitli_sayi".ptr, 12) == 1 ise { asgn_field_off = 16; }
                eger f_uzn == 14 ve bellek_esit_mi(f_ptr, "sablon_listesi".ptr, 14) == 1 ise { asgn_field_off = 0; }
                eger f_uzn == 13 ve bellek_esit_mi(f_ptr, "trait_tablosu".ptr, 13) == 1 ise { asgn_field_off = 8; }
                eger f_uzn == 12 ve bellek_esit_mi(f_ptr, "ilk_talimat".ptr, 12) == 1 ise { asgn_field_off = 0; }
                eger f_uzn == 12 ve bellek_esit_mi(f_ptr, "son_talimat".ptr, 12) == 1 ise { asgn_field_off = 8; }
                eger f_uzn == 18 ve bellek_esit_mi(f_ptr, "sanal_reg_sayaci".ptr, 18) == 1 ise { asgn_field_off = 16; }
            }
            # Nesne pointer'ini RAX'e yukle: lokal degisken ise load, nested ifade ise yeniden uret
            eger asgn_var_off != 0 ise {
                eger obj_is_ptr == 1 ise {
                    emit_load_rax(a, asgn_var_off);
                } yoksa {
                    emit_lea_rax(a, asgn_var_off);
                }
            } yoksa eger g_found == 1 ise {
                eger obj_is_ptr == 1 ise {
                    byte_yaz(a, 72); byte_yaz(a, 139); byte_yaz(a, 5); # MOV RAX, [RIP+rel32]
                } yoksa {
                    byte_yaz(a, 72); byte_yaz(a, 141); byte_yaz(a, 5); # LEA RAX, [RIP+rel32]
                }
                int32_yaz(a, g_addr - (a.kullanilan + 4));
            } yoksa {
                ast_kod_uret(a, asgn_obj);
            }
            byte_yaz(a, 0x59); # POP RCX (atanacak deger)
            eger asgn_field_off != (0 - 1) ise {
                eger asgn_field_off <= 127 ise {
                    byte_yaz(a, 0x48); byte_yaz(a, 0x89); byte_yaz(a, 0x48);
                    byte_yaz(a, asgn_field_off);
                } yoksa {
                    byte_yaz(a, 0x48); byte_yaz(a, 0x89); byte_yaz(a, 0x88);
                    int32_yaz(a, asgn_field_off);
                }
            }
            dondu 0;
        }
        # Dizi indeks atamasi: arr[i] = ifade
        # ONEMLI: Once kod uret (AST_ALAN_ERISIMI tip bilgisini yazsin), sonra fallback al
        eger sol.tip == AST_INDEKS_ERISIMI ise {
            byte_yaz(a, 0x50); # PUSH RAX (atanacak deger)
            degisken arr_node: *AstDugum = sol.sol;
            degisken idx_node: *AstDugum = sol.sag;
            degisken lvar_off: tamsayi = 0;
            degisken lvar_dizi: tamsayi = 0;
            degisken lvar_yildiz: tamsayi = 0;
            degisken lvar_tip_adi: *u8 = 0;
            degisken lvar_tip_uzunluk: tamsayi = 0;
            eger arr_node.tip == AST_KIMLIK ise {
                degisken lki: tamsayi = 0;
                dongu lki < g_lokal_adet {
                    eger g_lokal_uzunluklari[lki] == arr_node.ilk_jeton.uzunluk ise {
                        eger bellek_esit_mi(g_lokal_isimleri[lki], arr_node.ilk_jeton.baslangic, g_lokal_uzunluklari[lki]) == 1 ise {
                            lvar_off = g_lokal_offsetleri[lki];
                            lvar_tip_adi = g_lokal_tip_adlari[lki];
                            lvar_tip_uzunluk = g_lokal_tip_uzunluklari[lki];
                            lvar_yildiz = g_lokal_yildizlari[lki];
                            lvar_dizi = lokal_bul_dizi(arr_node.ilk_jeton.baslangic, arr_node.ilk_jeton.uzunluk);
                        }
                    }
                    lki = lki + 1;
                }
            }
            # ADIM 1 (ONCELIKLE): Taban adresi uret/yukle
            eger lvar_off != 0 ve lvar_dizi > 0 ise {
                eger lvar_off <= 127 ise {
                    byte_yaz(a, 0x48); byte_yaz(a, 0x8D); byte_yaz(a, 0x45);
                    byte_yaz(a, 256 - lvar_off);
                } yoksa {
                    byte_yaz(a, 0x48); byte_yaz(a, 0x8D); byte_yaz(a, 0x85);
                    int32_yaz(a, 0 - lvar_off);
                }
            } yoksa {
                ast_kod_uret(a, arr_node);
            }
            # ADIM 2 (KOD URETIMINDEN SONRA): Fallback
            eger lvar_yildiz == 0 ve lvar_dizi == 0 ve lvar_tip_adi == 0 ise {
                lvar_yildiz = arr_node.cozumlenmis_tip;
                lvar_tip_adi = arr_node.tip_adi;
                lvar_tip_uzunluk = arr_node.tip_adi_uzunluk;
                lvar_dizi = arr_node.dizi_boyutu;
            }
            byte_yaz(a, 0x50); # PUSH RAX (taban adresi)
            # ADIM 3: Element olcegi
            degisken lis_byte_array: tamsayi = 0;
            degisken lelm_scale: tamsayi = 8;
            eger lvar_tip_adi != 0 ve lvar_tip_uzunluk == 2 ise {
                eger lvar_tip_adi[0] == 117 ve lvar_tip_adi[1] == 56 ise {
                    eger (lvar_dizi > 0 ve lvar_yildiz == 0) veya (lvar_dizi == 0 ve lvar_yildiz == 1) ise {
                        lis_byte_array = 1;
                        lelm_scale = 1;
                    }
                }
            }
            eger lis_byte_array == 0 ve lvar_tip_adi != 0 ve lvar_tip_uzunluk == 3 ise {
                eger lvar_tip_adi[0] == 42 ve lvar_tip_adi[1] == 117 ve lvar_tip_adi[2] == 56 ise { # "*u8"
                    eger lvar_dizi == 0 ise {
                        lis_byte_array = 1;
                        lelm_scale = 1;
                    }
                }
            }
            eger lis_byte_array == 0 ve arr_node.tip == 17 ise { # AST_ALAN_ERISIMI
                degisken fld: *AstDugum = arr_node.sag;
                eger fld != 0 ve fld.ilk_jeton != 0 ise {
                    eger fld.ilk_jeton.uzunluk == 6 ve bellek_esit_mi(fld.ilk_jeton.baslangic, "bellek".ptr, 6) == 1 ise {
                        lis_byte_array = 1;
                        lelm_scale = 1;
                    } yoksa eger fld.ilk_jeton.uzunluk == 6 ve bellek_esit_mi(fld.ilk_jeton.baslangic, "kaynak".ptr, 6) == 1 ise {
                        lis_byte_array = 1;
                        lelm_scale = 1;
                    }
                }
            }
            eger lis_byte_array == 0 ise {
                eger lvar_dizi > 0 ve lvar_tip_adi != 0 ve lvar_tip_uzunluk > 0 ise {
                    degisken lsi: tamsayi = 0;
                    dongu lsi < g_yapi_adet {
                        eger g_yapi_uzunluk[lsi] == lvar_tip_uzunluk ise {
                            eger bellek_esit_mi(g_yapi_isim[lsi], lvar_tip_adi, lvar_tip_uzunluk) == 1 ise {
                                lelm_scale = g_yapi_byte_boyutu[lsi];
                                eger lelm_scale == 0 ise { lelm_scale = 8; }
                            }
                        }
                        lsi = lsi + 1;
                    }
                }
            }
            # ADIM 4: indeks + olcek
            ast_kod_uret(a, idx_node);
            eger lis_byte_array == 0 ise {
                eger lelm_scale == 8 ise {
                    byte_yaz(a, 0x48); byte_yaz(a, 0xC1); byte_yaz(a, 0xE0); byte_yaz(a, 0x03);
                } yoksa eger lelm_scale == 16 ise {
                    byte_yaz(a, 0x48); byte_yaz(a, 0xC1); byte_yaz(a, 0xE0); byte_yaz(a, 0x04);
                } yoksa eger lelm_scale == 32 ise {
                    byte_yaz(a, 0x48); byte_yaz(a, 0xC1); byte_yaz(a, 0xE0); byte_yaz(a, 0x05);
                } yoksa eger lelm_scale == 64 ise {
                    byte_yaz(a, 0x48); byte_yaz(a, 0xC1); byte_yaz(a, 0xE0); byte_yaz(a, 0x06);
                } yoksa {
                    byte_yaz(a, 0x48); byte_yaz(a, 0x69); byte_yaz(a, 0xC0); int32_yaz(a, lelm_scale);
                }
            }
            byte_yaz(a, 0x59); # POP RCX (taban adresi)
            emit_add_rax_rcx(a); # RAX = hedef adres
            byte_yaz(a, 0x59); # POP RCX (atanacak deger)
            eger lis_byte_array == 1 ise {
                byte_yaz(a, 0x88); byte_yaz(a, 0x08); # MOV [RAX], CL
            } yoksa {
                byte_yaz(a, 0x48); byte_yaz(a, 0x89); byte_yaz(a, 0x08); # MOV [RAX], RCX
            }
            dondu 0;
        }
        dondu 0;
    }

    # --------------------------------------------------------
    # AST_REFERANS: &x => LEA RAX, [RBP - off]
    # --------------------------------------------------------
    eger dugum.tip == 20 ise { # AST_REFERANS
        degisken hedef: *AstDugum = dugum.sag;
        eger hedef != 0 ve hedef.tip == 4 ise { # AST_KIMLIK
            degisken var_off: tamsayi = 0;
            degisken lki: tamsayi = g_lokal_adet - 1;
            dongu lki >= 0 {
                eger g_lokal_uzunluklari[lki] == hedef.ilk_jeton.uzunluk ise {
                    eger bellek_esit_mi(g_lokal_isimleri[lki], hedef.ilk_jeton.baslangic, g_lokal_uzunluklari[lki]) == 1 ise {
                        var_off = g_lokal_offsetleri[lki];
                        durdur;
                    }
                }
                lki = lki - 1;
            }
            eger var_off > 0 ise {
                eger var_off <= 127 ise {
                    byte_yaz(a, 0x48); byte_yaz(a, 0x8D); byte_yaz(a, 0x45);
                    byte_yaz(a, 256 - var_off);
                } yoksa {
                    byte_yaz(a, 0x48); byte_yaz(a, 0x8D); byte_yaz(a, 0x85);
                    int32_yaz(a, 0 - var_off);
                }
                dondu 0;
            } yoksa {
                degisken obj_uzn: tamsayi = hedef.ilk_jeton.uzunluk;
                degisken obj_isim: *u8 = hedef.ilk_jeton.baslangic;
                degisken gi: tamsayi = 0;
                dongu gi < g_global_sayisi {
                    eger g_global_uzunluk[gi] == obj_uzn ise {
                        eger bellek_esit_mi(g_global_isim[gi], obj_isim, obj_uzn) == 1 ise {
                            degisken g_addr: tamsayi = g_global_adres[gi];
                            byte_yaz(a, 0x48); byte_yaz(a, 0x8D); byte_yaz(a, 0x05);
                            int32_yaz(a, g_addr - (a.kullanilan + 4));
                            dondu 0;
                        }
                    }
                    gi = gi + 1;
                }
            }
        }
        emit_xor_rax_rax(a);
        dondu 0;
    }

    # --------------------------------------------------------
    # AST_UNARY: *ptr (deref) veya -x (negate)
    # --------------------------------------------------------
    eger dugum.tip == 19 ise { # AST_UNARY
        eger dugum.ilk_jeton != 0 ve dugum.ilk_jeton.tip == TIP_CARPI ise { # *ptr (dereference)
            ast_kod_uret(a, dugum.sag);
            byte_yaz(a, 0x48); byte_yaz(a, 0x8B); byte_yaz(a, 0x00); # MOV RAX, [RAX]
            dondu 0;
        } yoksa eger dugum.ilk_jeton != 0 ve dugum.ilk_jeton.tip == TIP_EKSI ise { # -val (negate)
            ast_kod_uret(a, dugum.sag);
            eger ast_node_is_float(dugum.sag) == 1 ise {
                byte_yaz(a, 0x48); byte_yaz(a, 0xBA);
                int64_yaz(a, 0 - 9223372036854775808);
                byte_yaz(a, 0x48); byte_yaz(a, 0x31); byte_yaz(a, 0xD0); # XOR RAX, RDX
                byte_yaz(a, 0x66); byte_yaz(a, 0x48); byte_yaz(a, 0x0F); byte_yaz(a, 0x6E); byte_yaz(a, 0xC0); # MOVQ XMM0, RAX
            } yoksa {
                byte_yaz(a, 0x48); byte_yaz(a, 0xF7); byte_yaz(a, 0xD8); # NEG RAX
            }
            dondu 0;
        }
    }

    # --------------------------------------------------------
    # AST_INDEKS_ERISIMI: arr[i] => RAX = *(base + i*scale)
    # ONEMLI: Once kod uret (AST_ALAN_ERISIMI tip bilgisini yazsin), sonra fallback al
    # --------------------------------------------------------
    eger dugum.tip == AST_INDEKS_ERISIMI ise {
        degisken arr_node: *AstDugum = dugum.sol;
        degisken idx_node: *AstDugum = dugum.sag;
        degisken var_off: tamsayi = 0;
        degisken var_dizi: tamsayi = 0;
        degisken var_yildiz: tamsayi = 0;
        degisken var_tip_adi: *u8 = 0;
        degisken var_tip_uzunluk: tamsayi = 0;
        degisken jeton_dizisi_mi: tamsayi = 0;
        eger arr_node.tip == AST_KIMLIK ise {
            degisken ki: tamsayi = 0;
            dongu ki < g_lokal_adet {
                eger g_lokal_uzunluklari[ki] == arr_node.ilk_jeton.uzunluk ise {
                    eger bellek_esit_mi(g_lokal_isimleri[ki], arr_node.ilk_jeton.baslangic, g_lokal_uzunluklari[ki]) == 1 ise {
                        var_off = g_lokal_offsetleri[ki];
                        var_tip_adi = g_lokal_tip_adlari[ki];
                        var_tip_uzunluk = g_lokal_tip_uzunluklari[ki];
                        var_yildiz = g_lokal_yildizlari[ki];
                        var_dizi = lokal_bul_dizi(arr_node.ilk_jeton.baslangic, arr_node.ilk_jeton.uzunluk);
                    }
                }
                ki = ki + 1;
            }
        }
        eger arr_node.tip == AST_ALAN_ERISIMI ise {
            eger arr_node.sag != 0 ve arr_node.sag.ilk_jeton != 0 ise {
                eger arr_node.sag.ilk_jeton.uzunluk == 7 ise {
                    eger bellek_esit_mi(arr_node.sag.ilk_jeton.baslangic, "jetonlar".ptr, 7) == 1 ise {
                        jeton_dizisi_mi = 1;
                        var_yildiz = 1;
                        var_tip_adi = "Jeton".ptr;
                        var_tip_uzunluk = 5;
                    }
                }
            }
            eger jeton_dizisi_mi == 0 ve arr_node.sol != 0 ve arr_node.sol.tip == AST_KIMLIK ise {
                eger arr_node.sol.ilk_jeton != 0 ise {
                    eger arr_node.sol.ilk_jeton.uzunluk == 12 ise {
                        eger bellek_esit_mi(arr_node.sol.ilk_jeton.baslangic, "ParserDurumu".ptr, 12) == 1 ise {
                            jeton_dizisi_mi = 1;
                            var_yildiz = 1;
                            var_tip_adi = "Jeton".ptr;
                            var_tip_uzunluk = 5;
                        }
                    }
                }
            }
        }
        # ADIM 2: Taban adresi uret/yukle
        eger jeton_dizisi_mi == 1 ise {
            ast_kod_uret(a, arr_node.sol);
            byte_yaz(a, 0x48); byte_yaz(a, 0x8B); byte_yaz(a, 0x00);
        } yoksa eger var_off != 0 ve var_dizi > 0 ise {
            eger var_off <= 127 ise {
                byte_yaz(a, 0x48); byte_yaz(a, 0x8D); byte_yaz(a, 0x45);
                byte_yaz(a, 256 - var_off);
            } yoksa {
                byte_yaz(a, 0x48); byte_yaz(a, 0x8D); byte_yaz(a, 0x85);
                int32_yaz(a, 0 - var_off);
            }
        } yoksa {
            ast_kod_uret(a, arr_node);
        }
        # Fallback type info AFTER kod uretimi
        eger var_yildiz == 0 ve var_dizi == 0 ve var_tip_adi == 0 ise {
            var_yildiz = arr_node.cozumlenmis_tip;
            var_tip_adi = arr_node.tip_adi;
            var_tip_uzunluk = arr_node.tip_adi_uzunluk;
            var_dizi = arr_node.dizi_boyutu;
        }
        byte_yaz(a, 0x50); # PUSH RAX (taban adresini sakla)
        # ADIM 3: Element olcegi belirle
        degisken is_byte_array: tamsayi = 0;
        degisken elem_scale: tamsayi = 8;
        eger jeton_dizisi_mi == 1 ise { elem_scale = 40; }
        eger var_tip_adi != 0 ve var_tip_uzunluk == 2 ise {
            eger var_tip_adi[0] == 117 ve var_tip_adi[1] == 56 ise { # 'u8'
                eger (var_dizi > 0 ve var_yildiz == 0) veya (var_dizi == 0 ve var_yildiz == 1) ise {
                    is_byte_array = 1;
                    elem_scale = 1;
                }
            }
        }
        eger is_byte_array == 0 ve var_tip_adi != 0 ve var_tip_uzunluk == 3 ise {
            eger var_tip_adi[0] == 42 ve var_tip_adi[1] == 117 ve var_tip_adi[2] == 56 ise { # "*u8"
                eger var_dizi == 0 ise {
                    is_byte_array = 1;
                    elem_scale = 1;
                }
            }
        }
        eger is_byte_array == 0 ve arr_node.tip == 17 ise { # AST_ALAN_ERISIMI
            degisken fld: *AstDugum = arr_node.sag;
            eger fld != 0 ve fld.ilk_jeton != 0 ise {
                eger fld.ilk_jeton.uzunluk == 6 ve bellek_esit_mi(fld.ilk_jeton.baslangic, "bellek".ptr, 6) == 1 ise {
                    is_byte_array = 1;
                    elem_scale = 1;
                } yoksa eger fld.ilk_jeton.uzunluk == 6 ve bellek_esit_mi(fld.ilk_jeton.baslangic, "kaynak".ptr, 6) == 1 ise {
                    is_byte_array = 1;
                    elem_scale = 1;
                }
            }
        }
        eger is_byte_array == 0 ise {
            eger var_tip_adi != 0 ve var_tip_uzunluk > 0 ise {
                degisken s_idx: tamsayi = 0;
                dongu s_idx < g_yapi_adet {
                    eger g_yapi_uzunluk[s_idx] == var_tip_uzunluk ise {
                        eger bellek_esit_mi(g_yapi_isim[s_idx], var_tip_adi, var_tip_uzunluk) == 1 ise {
                            elem_scale = g_yapi_byte_boyutu[s_idx];
                            eger elem_scale == 0 ise { elem_scale = 8; }
                        }
                    }
                    s_idx = s_idx + 1;
                }
            }
        }
        # ADIM 4: indeks hesapla + olcekle
        ast_kod_uret(a, idx_node); # RAX = indeks
        eger is_byte_array == 0 ise {
            eger elem_scale == 8 ise {
                byte_yaz(a, 0x48); byte_yaz(a, 0xC1); byte_yaz(a, 0xE0); byte_yaz(a, 0x03);
            } yoksa eger elem_scale == 16 ise {
                byte_yaz(a, 0x48); byte_yaz(a, 0xC1); byte_yaz(a, 0xE0); byte_yaz(a, 0x04);
            } yoksa eger elem_scale == 32 ise {
                byte_yaz(a, 0x48); byte_yaz(a, 0xC1); byte_yaz(a, 0xE0); byte_yaz(a, 0x05);
            } yoksa eger elem_scale == 64 ise {
                byte_yaz(a, 0x48); byte_yaz(a, 0xC1); byte_yaz(a, 0xE0); byte_yaz(a, 0x06);
            } yoksa {
                byte_yaz(a, 0x48); byte_yaz(a, 0x69); byte_yaz(a, 0xC0); int32_yaz(a, elem_scale);
            }
        }
        byte_yaz(a, 0x59); # POP RCX (taban)
        emit_add_rax_rcx(a); # RAX = &elem[i]
        eger is_byte_array == 1 ise {
            byte_yaz(a, 0x48); byte_yaz(a, 0x0F); byte_yaz(a, 0xB6); byte_yaz(a, 0x00);
        } yoksa {
            degisken struct_mi: tamsayi = 0;
            eger var_tip_adi != 0 ve g_yapi_adet > 0 ise {
                degisken si_chk: tamsayi = 0;
                dongu si_chk < g_yapi_adet {
                    eger g_yapi_uzunluk[si_chk] == var_tip_uzunluk ise {
                        eger bellek_esit_mi(g_yapi_isim[si_chk], var_tip_adi, var_tip_uzunluk) == 1 ise {
                            struct_mi = 1;
                        }
                    }
                    si_chk = si_chk + 1;
                }
            }
            
            degisken pointer_struct_mi: tamsayi = 0;
            eger var_yildiz == 1 ve var_tip_adi != 0 ve var_tip_uzunluk == 5 ise {
                eger var_tip_adi[0] == 74 ve var_tip_adi[1] == 101 ve var_tip_adi[2] == 116 ve var_tip_adi[3] == 111 ve var_tip_adi[4] == 110 ise {
                    pointer_struct_mi = 1;
                }
            }
            eger var_yildiz == 1 ve struct_mi == 1 ise {
                pointer_struct_mi = 1;
            }
            eger jeton_dizisi_mi == 1 veya (struct_mi == 1 ve var_yildiz == 0) veya pointer_struct_mi == 1 ise {
                # Struct ise adres RAX'ta kalmali, dereference yapma!
            } yoksa {
                byte_yaz(a, 0x48); byte_yaz(a, 0x8B); byte_yaz(a, 0x00);
            }
        }
        dondu 0;
    }

    eger dugum.tip == AST_IKILI_OP ise {
        # Short-circuit ve (AND) and veya (OR) must be handled before evaluating both sides
        eger dugum.ilk_jeton != 0 ise {
            eger dugum.ilk_jeton.tip == TIP_VE ise {
                # LHS
                ast_kod_uret(a, dugum.sol);
                # TEST RAX, RAX
                byte_yaz(a, 0x48); byte_yaz(a, 0x85); byte_yaz(a, 0xC0);
                # JZ false_label (if LHS == 0, skip RHS)
                byte_yaz(a, 0x0F); byte_yaz(a, 0x84);
                degisken ve_jz_pos: tamsayi = a.kullanilan;
                int32_yaz(a, 0);
                # RHS
                ast_kod_uret(a, dugum.sag);
                # TEST RAX, RAX → SETNE AL → MOVZX RAX, AL
                byte_yaz(a, 0x48); byte_yaz(a, 0x85); byte_yaz(a, 0xC0);
                byte_yaz(a, 0x0F); byte_yaz(a, 0x95); byte_yaz(a, 0xC0);
                byte_yaz(a, 0x48); byte_yaz(a, 0x0F); byte_yaz(a, 0xB6); byte_yaz(a, 0xC0);
                # JMP end_label
                byte_yaz(a, 0xE9);
                degisken ve_jmp_pos: tamsayi = a.kullanilan;
                int32_yaz(a, 0);
                # false_label:
                degisken ve_false_label: tamsayi = a.kullanilan;
                int32_patch(a, ve_jz_pos, ve_false_label - (ve_jz_pos + 4));
                # XOR RAX, RAX (result = 0)
                emit_xor_rax_rax(a);
                # end_label:
                degisken ve_end_label: tamsayi = a.kullanilan;
                int32_patch(a, ve_jmp_pos, ve_end_label - (ve_jmp_pos + 4));
                dondu 0;
            }
            eger dugum.ilk_jeton.tip == TIP_VEYA ise {
                # LHS
                ast_kod_uret(a, dugum.sol);
                # TEST RAX, RAX
                byte_yaz(a, 0x48); byte_yaz(a, 0x85); byte_yaz(a, 0xC0);
                # JNZ true_label (if LHS != 0, skip RHS)
                byte_yaz(a, 0x0F); byte_yaz(a, 0x85);
                degisken veya_jnz_pos: tamsayi = a.kullanilan;
                int32_yaz(a, 0);
                # RHS
                ast_kod_uret(a, dugum.sag);
                # TEST RAX, RAX → SETNE AL → MOVZX RAX, AL
                byte_yaz(a, 0x48); byte_yaz(a, 0x85); byte_yaz(a, 0xC0);
                byte_yaz(a, 0x0F); byte_yaz(a, 0x95); byte_yaz(a, 0xC0);
                byte_yaz(a, 0x48); byte_yaz(a, 0x0F); byte_yaz(a, 0xB6); byte_yaz(a, 0xC0);
                # JMP end_label
                byte_yaz(a, 0xE9);
                degisken veya_jmp_pos: tamsayi = a.kullanilan;
                int32_yaz(a, 0);
                # true_label:
                degisken veya_true_label: tamsayi = a.kullanilan;
                int32_patch(a, veya_jnz_pos, veya_true_label - (veya_jnz_pos + 4));
                # MOV RAX, 1
                byte_yaz(a, 0x48); byte_yaz(a, 0xC7); byte_yaz(a, 0xC0); int32_yaz(a, 1);
                # end_label:
                degisken veya_end_label: tamsayi = a.kullanilan;
                int32_patch(a, veya_jmp_pos, veya_end_label - (veya_jmp_pos + 4));
                dondu 0;
            }
        }
        degisken is_flt: tamsayi = 0;
        eger ast_node_is_float(dugum.sol) == 1 ise { is_flt = 1; }
        eger ast_node_is_float(dugum.sag) == 1 ise { is_flt = 1; }
        eger is_flt == 1 ise {
            ast_kod_uret(a, dugum.sol);
            eger ast_node_is_float(dugum.sol) == 0 ise {
                # CVTSI2SD XMM0, RAX (0xF2 0x48 0x0F 0x2A 0xC0)
                byte_yaz(a, 0xF2); byte_yaz(a, 0x48); byte_yaz(a, 0x0F); byte_yaz(a, 0x2A); byte_yaz(a, 0xC0);
                # MOVQ RAX, XMM0 (0x66 0x48 0x0F 0x7E 0xC0)
                byte_yaz(a, 0x66); byte_yaz(a, 0x48); byte_yaz(a, 0x0F); byte_yaz(a, 0x7E); byte_yaz(a, 0xC0);
            }
            byte_yaz(a, 0x50); # PUSH RAX
            ast_kod_uret(a, dugum.sag);
            eger ast_node_is_float(dugum.sag) == 0 ise {
                # CVTSI2SD XMM0, RAX
                byte_yaz(a, 0xF2); byte_yaz(a, 0x48); byte_yaz(a, 0x0F); byte_yaz(a, 0x2A); byte_yaz(a, 0xC0);
                # MOVQ RAX, XMM0
                byte_yaz(a, 0x66); byte_yaz(a, 0x48); byte_yaz(a, 0x0F); byte_yaz(a, 0x7E); byte_yaz(a, 0xC0);
            }
            # MOVQ XMM1, RAX (0x66 0x48 0x0F 0x6E 0xC8)
            byte_yaz(a, 0x66); byte_yaz(a, 0x48); byte_yaz(a, 0x0F); byte_yaz(a, 0x6E); byte_yaz(a, 0xC8);
            byte_yaz(a, 0x58); # POP RAX
            # MOVQ XMM0, RAX (0x66 0x48 0x0F 0x6E 0xC0)
            byte_yaz(a, 0x66); byte_yaz(a, 0x48); byte_yaz(a, 0x0F); byte_yaz(a, 0x6E); byte_yaz(a, 0xC0);

            eger dugum.ilk_jeton != 0 ise {
                degisken op_tip: tamsayi = dugum.ilk_jeton.tip;
                eger op_tip == TIP_ARTI ise {
                    # ADDSD XMM0, XMM1 (0xF2 0x0F 0x58 0xC1)
                    byte_yaz(a, 0xF2); byte_yaz(a, 0x0F); byte_yaz(a, 0x58); byte_yaz(a, 0xC1);
                    # MOVQ RAX, XMM0 (0x66 0x48 0x0F 0x7E 0xC0)
                    byte_yaz(a, 0x66); byte_yaz(a, 0x48); byte_yaz(a, 0x0F); byte_yaz(a, 0x7E); byte_yaz(a, 0xC0);
                    dondu 0;
                }
                eger op_tip == TIP_EKSI ise {
                    # SUBSD XMM0, XMM1 (0xF2 0x0F 0x5C 0xC1)
                    byte_yaz(a, 0xF2); byte_yaz(a, 0x0F); byte_yaz(a, 0x5C); byte_yaz(a, 0xC1);
                    byte_yaz(a, 0x66); byte_yaz(a, 0x48); byte_yaz(a, 0x0F); byte_yaz(a, 0x7E); byte_yaz(a, 0xC0);
                    dondu 0;
                }
                eger op_tip == TIP_CARPI ise {
                    # MULSD XMM0, XMM1 (0xF2 0x0F 0x59 0xC1)
                    byte_yaz(a, 0xF2); byte_yaz(a, 0x0F); byte_yaz(a, 0x59); byte_yaz(a, 0xC1);
                    byte_yaz(a, 0x66); byte_yaz(a, 0x48); byte_yaz(a, 0x0F); byte_yaz(a, 0x7E); byte_yaz(a, 0xC0);
                    dondu 0;
                }
                eger op_tip == TIP_BOLME ise {
                    # DIVSD XMM0, XMM1 (0xF2 0x0F 0x5E 0xC1)
                    byte_yaz(a, 0xF2); byte_yaz(a, 0x0F); byte_yaz(a, 0x5E); byte_yaz(a, 0xC1);
                    byte_yaz(a, 0x66); byte_yaz(a, 0x48); byte_yaz(a, 0x0F); byte_yaz(a, 0x7E); byte_yaz(a, 0xC0);
                    dondu 0;
                }
                eger op_tip == TIP_ESIT_MI ise {
                    # UCOMISD XMM0, XMM1 (0x66 0x0F 0x2E 0xC1)
                    byte_yaz(a, 0x66); byte_yaz(a, 0x0F); byte_yaz(a, 0x2E); byte_yaz(a, 0xC1);
                    emit_sete_al(a); emit_movzx_rax_al(a);
                    dondu 0;
                }
                eger op_tip == TIP_ESIT_DEGIL ise {
                    byte_yaz(a, 0x66); byte_yaz(a, 0x0F); byte_yaz(a, 0x2E); byte_yaz(a, 0xC1);
                    emit_setne_al(a); emit_movzx_rax_al(a);
                    dondu 0;
                }
                eger op_tip == TIP_KUCUK_MU ise {
                    byte_yaz(a, 0x66); byte_yaz(a, 0x0F); byte_yaz(a, 0x2E); byte_yaz(a, 0xC1);
                    emit_setb_al(a); emit_movzx_rax_al(a);
                    dondu 0;
                }
                eger op_tip == TIP_BUYUK_MU ise {
                    byte_yaz(a, 0x66); byte_yaz(a, 0x0F); byte_yaz(a, 0x2E); byte_yaz(a, 0xC1);
                    emit_seta_al(a); emit_movzx_rax_al(a);
                    dondu 0;
                }
                eger op_tip == TIP_KUCUK_ESIT ise {
                    byte_yaz(a, 0x66); byte_yaz(a, 0x0F); byte_yaz(a, 0x2E); byte_yaz(a, 0xC1);
                    emit_setbe_al(a); emit_movzx_rax_al(a);
                    dondu 0;
                }
                eger op_tip == TIP_BUYUK_ESIT ise {
                    byte_yaz(a, 0x66); byte_yaz(a, 0x0F); byte_yaz(a, 0x2E); byte_yaz(a, 0xC1);
                    emit_setae_al(a); emit_movzx_rax_al(a);
                    dondu 0;
                }
            }
            dondu 0;
        }

        ast_kod_uret(a, dugum.sol);
        byte_yaz(a, 0x50); # PUSH RAX (sol sonucu stack'e kaydet)
        eger dugum.sag != 0 ise {
        } yoksa {
        }
        ast_kod_uret(a, dugum.sag);
        byte_yaz(a, 0x48); byte_yaz(a, 0x89); byte_yaz(a, 0xC1); # MOV RCX, RAX (sag = RCX)
        byte_yaz(a, 0x58); # POP RAX (sol = RAX)
        eger dugum.ilk_jeton != 0 ise {
            # Aritmetik operatorler
            eger dugum.ilk_jeton.tip == TIP_ARTI  ise { emit_add_rax_rcx(a);  dondu 0; }
            eger dugum.ilk_jeton.tip == TIP_EKSI  ise { emit_sub_rax_rcx(a);  dondu 0; }
            eger dugum.ilk_jeton.tip == TIP_CARPI ise { emit_imul_rax_rcx(a); dondu 0; }
            eger dugum.ilk_jeton.tip == TIP_BOLME ise { emit_div_rax_rcx(a); dondu 0; }
            eger dugum.ilk_jeton.tip == TIP_MODULO ise { emit_mod_rax_rcx(a); dondu 0; }
            # Karsilastirma operatorleri: CMP RAX, RCX + SETcc AL + MOVZX RAX, AL
            eger dugum.ilk_jeton.tip == TIP_ESIT_MI    ise { emit_cmp_rax_rcx(a); emit_sete_al(a);  emit_movzx_rax_al(a); dondu 0; }
            eger dugum.ilk_jeton.tip == TIP_ESIT_DEGIL ise { emit_cmp_rax_rcx(a); emit_setne_al(a); emit_movzx_rax_al(a); dondu 0; }
            eger dugum.ilk_jeton.tip == TIP_KUCUK_MU   ise { emit_cmp_rax_rcx(a); emit_setl_al(a);  emit_movzx_rax_al(a); dondu 0; }
            eger dugum.ilk_jeton.tip == TIP_BUYUK_MU   ise { emit_cmp_rax_rcx(a); emit_setg_al(a);  emit_movzx_rax_al(a); dondu 0; }
            eger dugum.ilk_jeton.tip == TIP_KUCUK_ESIT ise { emit_cmp_rax_rcx(a); emit_setle_al(a); emit_movzx_rax_al(a); dondu 0; }
            eger dugum.ilk_jeton.tip == TIP_BUYUK_ESIT ise { emit_cmp_rax_rcx(a); emit_setge_al(a); emit_movzx_rax_al(a); dondu 0; }
            # Mantiksal AND/OR: iki taraf sifir degil mi?
            eger dugum.ilk_jeton.tip == TIP_VE ise {
                # TEST RAX,RAX â†’ SETNE AL â†’ MOVZX RAX,AL
                byte_yaz(a, 0x48); byte_yaz(a, 0x85); byte_yaz(a, 0xC0);
                byte_yaz(a, 0x0F); byte_yaz(a, 0x95); byte_yaz(a, 0xC0);
                byte_yaz(a, 0x48); byte_yaz(a, 0x0F); byte_yaz(a, 0xB6); byte_yaz(a, 0xC0);
                # TEST RCX,RCX â†’ SETNE CL â†’ MOVZX RCX,CL
                byte_yaz(a, 0x48); byte_yaz(a, 0x85); byte_yaz(a, 0xC9);
                byte_yaz(a, 0x0F); byte_yaz(a, 0x95); byte_yaz(a, 0xC1);
                byte_yaz(a, 0x48); byte_yaz(a, 0x0F); byte_yaz(a, 0xB6); byte_yaz(a, 0xC9);
                # AND RAX,RCX
                byte_yaz(a, 0x48); byte_yaz(a, 0x21); byte_yaz(a, 0xC8);
                dondu 0;
            }
            eger dugum.ilk_jeton.tip == TIP_VEYA ise {
                # OR RAX,RCX â†’ SETNE AL â†’ MOVZX RAX,AL
                byte_yaz(a, 0x48); byte_yaz(a, 0x09); byte_yaz(a, 0xC8);
                byte_yaz(a, 0x0F); byte_yaz(a, 0x95); byte_yaz(a, 0xC0);
                byte_yaz(a, 0x48); byte_yaz(a, 0x0F); byte_yaz(a, 0xB6); byte_yaz(a, 0xC0);
                dondu 0;
            }
        }
        dondu 0;
    }

    eger dugum.tip == AST_DONDUR ise {
        eger dugum.sag != 0 ise { ast_kod_uret(a, dugum.sag); }
        yoksa { emit_xor_rax_rax(a); }
        byte_yaz(a, 0x48); byte_yaz(a, 0x89); byte_yaz(a, 0xEC); # MOV RSP, RBP
        byte_yaz(a, 0x5D); # POP RBP
        byte_yaz(a, 0xC3); # RET
        dondu 0;
    }

    eger dugum.tip == AST_BLOK ise {
        degisken iter: *AstDugum = dugum.sol;
        degisken blk_idx: tamsayi = 0;
        dongu iter != 0 {
            ast_kod_uret(a, iter);
            iter = iter.sonraki;
            blk_idx = blk_idx + 1;
        }
        dondu 0;
    }

    # --------------------------------------------------------
    # AST_ISLEV: Prolog + parametreler stack'e + govde + epilog
    # --------------------------------------------------------
    eger dugum.tip == AST_ISLEV ise {
        eger dugum.govde == 0 ise {
            # External prototype (extern isv) - makine kodu uretme
            dondu 0;
        }
        g_fonksiyon_icinde = 1;
        # Fonksiyonu kaydet
        degisken f_idx: tamsayi = g_fonk_adet;
        g_fonk_isim[f_idx] = dugum.ilk_jeton.baslangic;
        g_fonk_uzunluk[f_idx] = dugum.ilk_jeton.uzunluk;
        g_fonk_adres[f_idx] = a.kullanilan;
        g_fonk_adet = g_fonk_adet + 1;

        # Fonksiyon scope'unu sifirla
        g_lokal_adet = 0;
        g_lokal_stack_offset = 0;
        g_loop_stack_sp = 0;
        g_durdur_adet = 0;
        g_fonksiyon_icinde = 1;
        emit_push_rbp(a);
        emit_mov_rbp_rsp(a);
        emit_sub_rsp(a, 16384);
        
        # Parametreleri kaydet ve stack'e spill et
        degisken param: *AstDugum = dugum.parametreler;
        degisken pidx: tamsayi = 0;
        dongu param != 0 {
            degisken p_off: tamsayi = lokal_kaydet(
                param.ilk_jeton.baslangic,
                param.ilk_jeton.uzunluk,
                0,
                param.tip_adi,
                param.tip_adi_uzunluk,
                param.cozumlenmis_tip
            );
            
            eger pidx == 0 ise {
                byte_yaz(a, 0x48); byte_yaz(a, 0x89); byte_yaz(a, 0x4D); byte_yaz(a, 256 - p_off); # MOV [RBP - p_off], RCX
            } yoksa eger pidx == 1 ise {
                byte_yaz(a, 0x48); byte_yaz(a, 0x89); byte_yaz(a, 0x55); byte_yaz(a, 256 - p_off); # MOV [RBP - p_off], RDX
            } yoksa eger pidx == 2 ise {
                byte_yaz(a, 0x4C); byte_yaz(a, 0x89); byte_yaz(a, 0x45); byte_yaz(a, 256 - p_off); # MOV [RBP - p_off], R8
            } yoksa eger pidx == 3 ise {
                byte_yaz(a, 0x4C); byte_yaz(a, 0x89); byte_yaz(a, 0x4D); byte_yaz(a, 256 - p_off); # MOV [RBP - p_off], R9
            } yoksa {
                # Windows x64 ABI: push rbp sonrasinda ilk stack argumani RBP+48'ta baslar.
                degisken stack_src: tamsayi = 16 + (pidx * 8);
                byte_yaz(a, 0x48); byte_yaz(a, 0x8B); byte_yaz(a, 0x45); byte_yaz(a, stack_src); # MOV RAX, [RBP + stack_src]
                eger p_off <= 127 ise {
                    byte_yaz(a, 0x48); byte_yaz(a, 0x89); byte_yaz(a, 0x45); byte_yaz(a, 256 - p_off); # MOV [RBP - p_off], RAX
                } yoksa {
                    byte_yaz(a, 0x48); byte_yaz(a, 0x89); byte_yaz(a, 0x85); int32_yaz(a, 0 - p_off);
                }
            }
            pidx = pidx + 1;
            param = param.sonraki;
        }
        degisken govde: *AstDugum = dugum.govde;
        eger govde != 0 ise {
            ast_kod_uret(a, govde);
        }
        emit_xor_rax_rax(a);
        byte_yaz(a, 0x48); byte_yaz(a, 0x89); byte_yaz(a, 0xEC); # MOV RSP, RBP
        emit_pop_rbp(a);
        emit_ret(a);
        g_fonksiyon_icinde = 0;
        dondu 0;
    }

    eger dugum.tip == 11 ise { # AST_ISLEV_CAGRISI
        degisken f_isim: *u8 = dugum.sol.ilk_jeton.baslangic;
        degisken f_uzn: tamsayi = dugum.sol.ilk_jeton.uzunluk;

        eger tip_adini_coz_yerel(f_isim, f_uzn) == 2 ve dugum.sag != 0 ve dugum.sag.sonraki == 0 ise {
            degisken arg: *AstDugum = dugum.sag;
            ast_kod_uret(a, arg);
            eger ast_node_is_float(arg) == 0 ise {
                # CVTSI2SD XMM0, RAX (0xF2 0x48 0x0F 0x2A 0xC0)
                byte_yaz(a, 0xF2); byte_yaz(a, 0x48); byte_yaz(a, 0x0F); byte_yaz(a, 0x2A); byte_yaz(a, 0xC0);
                # MOVQ RAX, XMM0 (0x66 0x48 0x0F 0x7E 0xC0)
                byte_yaz(a, 0x66); byte_yaz(a, 0x48); byte_yaz(a, 0x0F); byte_yaz(a, 0x7E); byte_yaz(a, 0xC0);
            }
            dondu 0;
        } yoksa eger tip_adini_coz_yerel(f_isim, f_uzn) == 1 ve dugum.sag != 0 ve dugum.sag.sonraki == 0 ise {
            degisken arg: *AstDugum = dugum.sag;
            ast_kod_uret(a, arg);
            eger ast_node_is_float(arg) == 1 ise {
                # MOVQ XMM0, RAX (0x66 0x48 0x0F 0x6E 0xC0)
                byte_yaz(a, 0x66); byte_yaz(a, 0x48); byte_yaz(a, 0x0F); byte_yaz(a, 0x6E); byte_yaz(a, 0xC0);
                # CVTTSD2SI RAX, XMM0 (0xF2 0x48 0x0F 0x2C 0xC0)
                byte_yaz(a, 0xF2); byte_yaz(a, 0x48); byte_yaz(a, 0x0F); byte_yaz(a, 0x2C); byte_yaz(a, 0xC0);
            }
            dondu 0;
        } yoksa eger bellek_esit_mi(f_isim, "ekrana_yaz".ptr, 10) == 1 ise {
            degisken arg_dugum: *AstDugum = dugum.sag;
            degisken metin_dugum: *AstDugum = 0;
            eger arg_dugum != 0 ise {
                eger arg_dugum.sol != 0 ve arg_dugum.sol.tip == AST_METIN ise {
                    metin_dugum = arg_dugum.sol;
                } yoksa eger arg_dugum.tip == AST_METIN ise {
                    metin_dugum = arg_dugum;
                }
            }
            eger metin_dugum == 0 ise {
                ast_kod_uret(a, arg_dugum);
            } yoksa {
                ast_kod_uret(a, metin_dugum);
            }
            eger g_target_platform == 1 ise {
                # Linux: SYS_write(1, RAX, strlen(RAX))
                byte_yaz(a, 0x48); byte_yaz(a, 0x89); byte_yaz(a, 0xC6); # MOV RSI, RAX (buffer)
                byte_yaz(a, 0x48); byte_yaz(a, 0xC7); byte_yaz(a, 0xC7); int32_yaz(a, 1); # MOV RDI, 1 (stdout)
                byte_yaz(a, 0x48); byte_yaz(a, 0x31); byte_yaz(a, 0xD2); # XOR RDX, RDX
                byte_yaz(a, 0x80); byte_yaz(a, 0x3C); byte_yaz(a, 0x16); byte_yaz(a, 0x00); # CMP byte [RSI+RDX], 0
                byte_yaz(a, 0x74); byte_yaz(a, 0x05); # JE +5
                byte_yaz(a, 0x48); byte_yaz(a, 0xFF); byte_yaz(a, 0xC2); # INC RDX
                byte_yaz(a, 0xEB); byte_yaz(a, 0xF5); # JMP loop
                byte_yaz(a, 0x48); byte_yaz(a, 0xC7); byte_yaz(a, 0xC0); int32_yaz(a, 1); # MOV RAX, 1 (SYS_write)
                byte_yaz(a, 0x0F); byte_yaz(a, 0x05); # SYSCALL
            } yoksa eger g_target_platform == 2 ise {
                # macOS: BSD SYS_write(1, RAX, strlen(RAX))
                byte_yaz(a, 0x48); byte_yaz(a, 0x89); byte_yaz(a, 0xC6); # MOV RSI, RAX (buffer)
                byte_yaz(a, 0x48); byte_yaz(a, 0xC7); byte_yaz(a, 0xC7); int32_yaz(a, 1); # MOV RDI, 1 (stdout)
                byte_yaz(a, 0x48); byte_yaz(a, 0x31); byte_yaz(a, 0xD2); # XOR RDX, RDX
                byte_yaz(a, 0x80); byte_yaz(a, 0x3C); byte_yaz(a, 0x16); byte_yaz(a, 0x00); # CMP byte [RSI+RDX], 0
                byte_yaz(a, 0x74); byte_yaz(a, 0x05); # JE +5
                byte_yaz(a, 0x48); byte_yaz(a, 0xFF); byte_yaz(a, 0xC2); # INC RDX
                byte_yaz(a, 0xEB); byte_yaz(a, 0xF5); # JMP loop
                byte_yaz(a, 0x48); byte_yaz(a, 0xC7); byte_yaz(a, 0xC0); int32_yaz(a, 0x2000004); # MOV RAX, 0x2000004 (BSD SYS_write)
                byte_yaz(a, 0x0F); byte_yaz(a, 0x05); # SYSCALL
            } yoksa {
                # MOV R15, RAX
                byte_yaz(a, 0x49); byte_yaz(a, 0x89); byte_yaz(a, 0xC7);
                # SUB RSP, 32 (shadow space)
                byte_yaz(a, 0x48); byte_yaz(a, 0x83); byte_yaz(a, 0xEC); byte_yaz(a, 0x20);
                # MOV RCX, -11
                byte_yaz(a, 0x48); byte_yaz(a, 0xC7); byte_yaz(a, 0xC1); int32_yaz(a, 0xFFFFFFF5);
                # CALL GetStdHandle IAT (placeholder, patched in pe32plus_uret)
                byte_yaz(a, 0xFF); byte_yaz(a, 0x15);
                degisken iat_gs_idx: tamsayi = g_iat_yama_adet;
                g_iat_yama_text_offset[iat_gs_idx] = a.kullanilan;
                g_iat_yama_slot[iat_gs_idx] = 2;
                g_iat_yama_adet = g_iat_yama_adet + 1;
                int32_yaz(a, 0); # placeholder
                # ADD RSP, 32
                byte_yaz(a, 0x48); byte_yaz(a, 0x83); byte_yaz(a, 0xC4); byte_yaz(a, 0x20);
                # MOV RCX, RAX
                byte_yaz(a, 0x48); byte_yaz(a, 0x89); byte_yaz(a, 0xC1);
                # MOV RDX, R15
                byte_yaz(a, 0x4C); byte_yaz(a, 0x89); byte_yaz(a, 0xFA);
                # XOR R8, R8
                byte_yaz(a, 0x4D); byte_yaz(a, 0x31); byte_yaz(a, 0xC0);
                # CMP byte [RDX+R8], 0
                byte_yaz(a, 0x42); byte_yaz(a, 0x80); byte_yaz(a, 0x3C); byte_yaz(a, 0x02); byte_yaz(a, 0x00);
                # JE +5
                byte_yaz(a, 0x74); byte_yaz(a, 0x05);
                # INC R8
                byte_yaz(a, 0x49); byte_yaz(a, 0xFF); byte_yaz(a, 0xC0);
                # JMP -12
                byte_yaz(a, 0xEB); byte_yaz(a, 0xF4);
                # SUB RSP, 48 (shadow space + 5th arg + padding for alignment)
                byte_yaz(a, 0x48); byte_yaz(a, 0x83); byte_yaz(a, 0xEC); byte_yaz(a, 0x30);
                # LEA R9, [RSP+40] (lpNumberOfBytesWritten)
                byte_yaz(a, 0x4C); byte_yaz(a, 0x8D); byte_yaz(a, 0x4C); byte_yaz(a, 0x24); byte_yaz(a, 0x28);
                # MOV [RSP+32], 0 (pOverlapped)
                byte_yaz(a, 0x48); byte_yaz(a, 0xC7); byte_yaz(a, 0x44); byte_yaz(a, 0x24); byte_yaz(a, 0x20); int32_yaz(a, 0);
                # CALL WriteFile IAT (placeholder, patched in pe32plus_uret)
                byte_yaz(a, 0xFF); byte_yaz(a, 0x15);
                degisken iat_wf_idx: tamsayi = g_iat_yama_adet;
                g_iat_yama_text_offset[iat_wf_idx] = a.kullanilan;
                g_iat_yama_slot[iat_wf_idx] = 1;
                g_iat_yama_adet = g_iat_yama_adet + 1;
                int32_yaz(a, 0); # placeholder
                # ADD RSP, 48
                byte_yaz(a, 0x48); byte_yaz(a, 0x83); byte_yaz(a, 0xC4); byte_yaz(a, 0x30);
            }
        } yoksa eger bellek_esit_mi(f_isim, "dosya_oku_aralik".ptr, 16) == 1 ise {
            # dosya_oku_aralik(yol, ofset, buffer, boyut)
            # CreateFileA + SetFilePointerEx + ReadFile + CloseHandle.
            degisken ar_arg: *AstDugum = dugum.sag;
            ast_kod_uret(a, ar_arg);
            byte_yaz(a, 0x49); byte_yaz(a, 0x89); byte_yaz(a, 0xC7); # R15 = yol
            ar_arg = ar_arg.sonraki;
            ast_kod_uret(a, ar_arg);
            byte_yaz(a, 0x49); byte_yaz(a, 0x89); byte_yaz(a, 0xC6); # R14 = ofset
            ar_arg = ar_arg.sonraki;
            ast_kod_uret(a, ar_arg);
            byte_yaz(a, 0x49); byte_yaz(a, 0x89); byte_yaz(a, 0xC5); # R13 = buffer
            ar_arg = ar_arg.sonraki;
            ast_kod_uret(a, ar_arg);
            byte_yaz(a, 0x49); byte_yaz(a, 0x89); byte_yaz(a, 0xC4); # R12 = boyut

            eger g_target_platform == 1 ise {
                # Linux: SYS_open(path=R15, O_RDONLY=0, 0)
                byte_yaz(a, 0x4C); byte_yaz(a, 0x89); byte_yaz(a, 0xF7); # MOV RDI, R15 (yol)
                byte_yaz(a, 0x48); byte_yaz(a, 0x31); byte_yaz(a, 0xF6); # XOR RSI, RSI (O_RDONLY)
                byte_yaz(a, 0x48); byte_yaz(a, 0x31); byte_yaz(a, 0xD2); # XOR RDX, RDX
                byte_yaz(a, 0x48); byte_yaz(a, 0xC7); byte_yaz(a, 0xC0); int32_yaz(a, 2); # MOV RAX, 2 (SYS_open)
                byte_yaz(a, 0x0F); byte_yaz(a, 0x05); # SYSCALL
                byte_yaz(a, 0x49); byte_yaz(a, 0x89); byte_yaz(a, 0xC7); # MOV R15, RAX (fd)

                # SYS_lseek(fd=R15, offset=R14, whence=0)
                byte_yaz(a, 0x4C); byte_yaz(a, 0x89); byte_yaz(a, 0xFF); # MOV RDI, R15 (fd)
                byte_yaz(a, 0x4C); byte_yaz(a, 0x89); byte_yaz(a, 0xF6); # MOV RSI, R14 (ofset)
                byte_yaz(a, 0x48); byte_yaz(a, 0x31); byte_yaz(a, 0xD2); # XOR RDX, RDX (SEEK_SET=0)
                byte_yaz(a, 0x48); byte_yaz(a, 0xC7); byte_yaz(a, 0xC0); int32_yaz(a, 8); # MOV RAX, 8 (SYS_lseek)
                byte_yaz(a, 0x0F); byte_yaz(a, 0x05); # SYSCALL

                # SYS_read(fd=R15, buffer=R13, size=R12)
                byte_yaz(a, 0x48); byte_yaz(a, 0x31); byte_yaz(a, 0xC0); # MOV RAX, 0 (SYS_read)
                byte_yaz(a, 0x4C); byte_yaz(a, 0x89); byte_yaz(a, 0xFF); # MOV RDI, R15 (fd)
                byte_yaz(a, 0x4C); byte_yaz(a, 0x89); byte_yaz(a, 0xEE); # MOV RSI, R13 (buffer)
                byte_yaz(a, 0x4C); byte_yaz(a, 0x89); byte_yaz(a, 0xE2); # MOV RDX, R12 (size)
