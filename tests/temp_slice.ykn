                # SYS_write(fd=R15, buf=R14, size=R13)
                byte_yaz(a, 0x48); byte_yaz(a, 0xC7); byte_yaz(a, 0xC0); int32_yaz(a, 1);   # MOV RAX, 1 (SYS_write)
                byte_yaz(a, 0x4C); byte_yaz(a, 0x89); byte_yaz(a, 0xFF); # MOV RDI, R15 (fd)
                byte_yaz(a, 0x4C); byte_yaz(a, 0x89); byte_yaz(a, 0xF6); # MOV RSI, R14 (buf)
                byte_yaz(a, 0x4C); byte_yaz(a, 0x89); byte_yaz(a, 0xEA); # MOV RDX, R13 (size)
                byte_yaz(a, 0x0F); byte_yaz(a, 0x05); # SYSCALL
                # SYS_close(fd=R15)
                byte_yaz(a, 0x48); byte_yaz(a, 0xC7); byte_yaz(a, 0xC0); int32_yaz(a, 3);   # MOV RAX, 3 (SYS_close)
                byte_yaz(a, 0x4C); byte_yaz(a, 0x89); byte_yaz(a, 0xFF); # MOV RDI, R15 (fd)
                byte_yaz(a, 0x0F); byte_yaz(a, 0x05); # SYSCALL
                emit_xor_rax_rax(a);
            } yoksa eger g_target_platform == 2 ise {
                # macOS: BSD SYS_open(R15, O_WRONLY|O_CREAT|O_TRUNC=0x601, 0644)
