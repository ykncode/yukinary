# Yukinary generated build artifacts
/build/

# Native binaries and object files generated during local/CI builds
*.exe
*.elf
*.macho
*.o
*.obj
*.dll
*.lib
*.a
*.pdb

# Large neural model weights (downloaded externally)
*.gguf
*.bin
*.safetensors
/models/

# Python cache & VSIX packages
__pycache__/
*.pyc
*.vsix

# Root-level compiler/test logs and temporary files
*.log
*.tmp
*.bak
/*.txt

# Historical default compiler outputs
/out.exe
/out*.exe
/cikti.exe
/app.exe
/app_full.exe
/yukinary.exe

# Generated test reports (canonical reports live under build/reports)
/test_results.json
/coverage_matrix.json

# Generated bootstrap/test working directories
/tests/bootstrap/work/
/tests/bootstrap/results/
/tests/bootstrap/stage-regression-work/
/tests/bootstrap/stage-regression-results/

# Debug-session and temporary folders
/.dbg/
/.ykn_cache/
/trash/
/scratch/
