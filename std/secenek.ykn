# ============================================================
# Yukinary Secenek<T> — 16-byte tagged union runtime yardimcilari
# ============================================================
# Temsil:
#   +0  durum/discriminant (8 byte)
#   +8  payload             (8 byte)
#
# Bu modul, parser tarafindaki enum varyantlarinin ortak runtime
# temsilini saglar. Payload tek makine kelimesine sigan deger veya
# pointer olabilir; daha buyuk tipler icin pointer kullanilmalidir.

# Varyant discriminantleri enum bildirim sirasiyla 0, 1, 2... olur.
degisken SECENEK_DISCRIMINANT_BAZI = 0;
degisken SECENEK_DISCRIMINANT_HICBIRI = 1;

# 16 byte'lik tagged union olusturur.
isv secenek_olustur(durum: tamsayi, deger: tamsayi) -> *u8 {
    degisken s: *u8 = bellek_tahsis_et(16);
    degisken durum_ptr: *tamsayi = s;
    degisken deger_ptr: *tamsayi = s + 8;
    durum_ptr[0] = durum;
    deger_ptr[0] = deger;
    dondu s;
}

isv secenek_bazi(deger: tamsayi) -> *u8 {
    dondu secenek_olustur(SECENEK_DISCRIMINANT_BAZI, deger);
}

isv secenek_hicbiri() -> *u8 {
    dondu secenek_olustur(SECENEK_DISCRIMINANT_HICBIRI, 0);
}

isv secenek_durum(s: *u8) -> tamsayi {
    eger s == 0 ise { dondu 0 - 1; }
    degisken durum_ptr: *tamsayi = s;
    dondu durum_ptr[0];
}

isv secenek_deger(s: *u8) -> tamsayi {
    eger s == 0 ise { dondu 0; }
    degisken deger_ptr: *tamsayi = s + 8;
    dondu deger_ptr[0];
}

isv secenek_bazi_mi(s: *u8) -> tamsayi {
    eger s == 0 ise { dondu 0; }
    eger secenek_durum(s) == SECENEK_DISCRIMINANT_BAZI ise { dondu 1; }
    dondu 0;
}

isv secenek_hicbiri_mi(s: *u8) -> tamsayi {
    eger s == 0 ise { dondu 1; }
    eger secenek_durum(s) == SECENEK_DISCRIMINANT_HICBIRI ise { dondu 1; }
    dondu 0;
}

isv secenek_deger_veya(s: *u8, varsayilan_deger: tamsayi) -> tamsayi {
    eger secenek_bazi_mi(s) == 0 ise { dondu varsayilan_deger; }
    dondu secenek_deger(s);
}
