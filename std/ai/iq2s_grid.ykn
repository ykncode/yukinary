}
isv bitnet_iq2s_grid_bayt(indeks: tamsayi, lane: tamsayi) -> tamsayi {
    eger indeks < 0 veya indeks >= 1024 veya lane < 0 veya lane >= 8 ise { dondu 0; }
    bitnet_iq2s_grid_baslat();
    degisken kelime: tamsayi = IQ2S_GRID_ALT[indeks];
    eger lane >= 4 ise { kelime = IQ2S_GRID_UST[indeks]; lane = lane - 4; }
    degisken bolen: tamsayi = 1;
    eger lane == 1 ise { bolen = 256; }
    eger lane == 2 ise { bolen = 65536; }
    eger lane == 3 ise { bolen = 16777216; }
    dondu (kelime / bolen) % 256;
}
