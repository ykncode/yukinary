isv ykn_cuda_bitnet_i2s_ffn_fused(gate_key: tamsayi, gate_bytes: tamsayi,
                                   up_key: tamsayi, up_bytes: tamsayi,
                                   down_key: tamsayi, down_bytes: tamsayi,
                                   subnorm_key: tamsayi, subnorm_ptr: *tamsayi,
                                   N: tamsayi, K: tamsayi, eps_q16: tamsayi,
                                   activation: *tamsayi, out_hidden: *tamsayi) -> tamsayi {
        degisken g_w: [1]tamsayi; degisken g_s: [1]tamsayi;
    degisken u_w: [1]tamsayi; degisken u_s: [1]tamsayi;
    degisken d_w: [1]tamsayi; degisken d_s: [1]tamsayi;
    eger ykn_cuda_get_iq2s_cached_weight(gate_key, gate_bytes, g_w, g_s) == 0 {
        # ekrana_yaz("FUSED FAIL: gate not cached\n".ptr);
        dondu 0;
    }
    eger ykn_cuda_get_iq2s_cached_weight(up_key, up_bytes, u_w, u_s) == 0 {
        # ekrana_yaz("FUSED FAIL: up not cached\n".ptr);
        dondu 0;
    }
    eger ykn_cuda_get_iq2s_cached_weight(down_key, down_bytes, d_w, d_s) == 0 {
        # ekrana_yaz("FUSED FAIL: down not cached\n".ptr);
        dondu 0;
    }
degisken subnorm_dev: tamsayi = 0;
    degisken sn_i: tamsayi = 0;
    dongu sn_i < YKN_CUDA_SUBNORM_WEIGHT_CACHE_COUNT {
        eger YKN_CUDA_SUBNORM_WEIGHT_CACHE_KEYS[sn_i] == subnorm_key {
            subnorm_dev = YKN_CUDA_SUBNORM_WEIGHT_CACHE_PTRS[sn_i];
            durdur;
        }
        sn_i = sn_i + 1;
    }
    eger subnorm_dev == 0 {
        eger subnorm_ptr == 0 { dondu 0; }
        eger cuda_buffer_alloc(YKN_CUDA_CONTEXT_PTR, N * 8, &subnorm_dev) != CUDA_SUCCESS { dondu 0; }
        eger cuda_copy_to_device(YKN_CUDA_CONTEXT_PTR, subnorm_dev, subnorm_ptr, N * 8) != CUDA_SUCCESS {
            cuda_buffer_free(YKN_CUDA_CONTEXT_PTR, subnorm_dev);
            dondu 0;
        }
        eger YKN_CUDA_SUBNORM_WEIGHT_CACHE_COUNT < 256 {
            degisken new_sn: tamsayi = YKN_CUDA_SUBNORM_WEIGHT_CACHE_COUNT;
            YKN_CUDA_SUBNORM_WEIGHT_CACHE_KEYS[new_sn] = subnorm_key;
            YKN_CUDA_SUBNORM_WEIGHT_CACHE_PTRS[new_sn] = subnorm_dev;
            YKN_CUDA_SUBNORM_WEIGHT_CACHE_COUNT = new_sn + 1;
        }
    }

    eger YKN_CUDA_IQ2S_ACT_DEVICE == 0 or YKN_CUDA_IQ2S_ACT_CAPACITY < 65536 {
        eger YKN_CUDA_IQ2S_ACT_DEVICE != 0 { cuda_buffer_free(YKN_CUDA_CONTEXT_PTR, YKN_CUDA_IQ2S_ACT_DEVICE); }
        eger cuda_buffer_alloc(YKN_CUDA_CONTEXT_PTR, 65536, &YKN_CUDA_IQ2S_ACT_DEVICE) != CUDA_SUCCESS { dondu 0; }
        YKN_CUDA_IQ2S_ACT_CAPACITY = 65536;
        ykn_cuda_clear_act_cache();
    }
    eger YKN_CUDA_IQ2S_OUT_DEVICE == 0 or YKN_CUDA_IQ2S_OUT_CAPACITY < 131072 {
        eger YKN_CUDA_IQ2S_OUT_DEVICE != 0 { cuda_buffer_free(YKN_CUDA_CONTEXT_PTR, YKN_CUDA_IQ2S_OUT_DEVICE); }
        eger cuda_buffer_alloc(YKN_CUDA_CONTEXT_PTR, 131072, &YKN_CUDA_IQ2S_OUT_DEVICE) != CUDA_SUCCESS { dondu 0; }
        YKN_CUDA_IQ2S_OUT_CAPACITY = 131072;
    }
    YKN_CUDA_IQ2S_OUT_DEVICE_2 = YKN_CUDA_IQ2S_OUT_DEVICE + N * 8;
    eger YKN_CUDA_AMAX_DEVICE == 0 {
        eger cuda_buffer_alloc(YKN_CUDA_CONTEXT_PTR, 8, &YKN_CUDA_AMAX_DEVICE) != CUDA_SUCCESS { dondu 0; }
    }

    degisken amax_in: tamsayi = 0;
    degisken need_quant: tamsayi = 1;
    eger activation == YKN_CUDA_CACHED_ACT_PTR and K == YKN_CUDA_CACHED_ACT_K and YKN_CUDA_IQ2S_ACT_DEVICE != 0 {
        amax_in = YKN_CUDA_CACHED_ACT_AMAX;
        need_quant = 0;
    }
    eger need_quant == 1 {
        eger g_llm_native_simd_aktif == 1 {
            amax_in = ykn_llm_f16_dot_q16(activation, YKN_CUDA_I2S_QACT.ptr, K);
        } yoksa {
            degisken i: tamsayi = 0;
            dongu i < K {
                degisken x: tamsayi = activation[i];
                eger x < 0 { x = 0 - x; }
                eger x > amax_in { amax_in = x; }
                i = i + 1;
            }
            degisken amax_half: tamsayi = amax_in / 2;
            i = 0;
            dongu i < K {
                degisken x: tamsayi = activation[i];
                degisken x_abs: tamsayi = x;
                degisken sign: tamsayi = 1;
                eger x < 0 { x_abs = 0 - x; sign = 0 - 1; }
                degisken q: tamsayi = 0;
                eger amax_in > 0 {
                    q = (x_abs * 127 + amax_half) / amax_in;
                    eger q > 127 { q = 127; }
                }
                YKN_CUDA_I2S_QACT[i] = q * sign;
                i = i + 1;
            }
        }
        eger cuda_copy_to_device(YKN_CUDA_CONTEXT_PTR, YKN_CUDA_IQ2S_ACT_DEVICE, YKN_CUDA_I2S_QACT.ptr, K * 8) != CUDA_SUCCESS { dondu 0; }
    }

    degisken g_w_dev: tamsayi = g_w[0];
    degisken g_s_val: tamsayi = g_s[0];
    degisken u_w_dev: tamsayi = u_w[0];
    degisken u_s_val: tamsayi = u_s[0];
    degisken N_val: tamsayi = N;
    degisken K_val: tamsayi = K;

    degisken params_fused: [10]*u8;
    params_fused[0] = &g_w_dev;
    params_fused[1] = &u_w_dev;
    params_fused[2] = &YKN_CUDA_IQ2S_ACT_DEVICE;
    params_fused[3] = &YKN_CUDA_IQ2S_OUT_DEVICE;
    params_fused[4] = &YKN_CUDA_IQ2S_OUT_DEVICE_2;
    params_fused[5] = &K_val;
    params_fused[6] = &N_val;
    params_fused[7] = &amax_in;
    params_fused[8] = &g_s_val;
    params_fused[9] = &u_s_val;
    degisken status: tamsayi = cuda_ptx_launch_1d(YKN_CUDA_CONTEXT_PTR, ykn_cuda_bitnet_i2s_gate_up_ptx(),
        "ykn_bitnet_i2s_matvec_gate_up".ptr, params_fused, (N + 3) / 4, 128);
    eger status != CUDA_SUCCESS { dondu 0; }

    degisken eps_val: tamsayi = eps_q16;
    degisken params_srq: [8]*u8;
    params_srq[0] = &YKN_CUDA_IQ2S_OUT_DEVICE;
    params_srq[1] = &YKN_CUDA_IQ2S_OUT_DEVICE_2;
    params_srq[2] = &YKN_CUDA_SILU_LUT_DEVICE;
    params_srq[3] = &subnorm_dev;
    params_srq[4] = &YKN_CUDA_IQ2S_ACT_DEVICE;
    params_srq[5] = &YKN_CUDA_AMAX_DEVICE;
    params_srq[6] = &N_val;
    params_srq[7] = &eps_val;
    status = cuda_kernel_launch_1d(YKN_CUDA_CONTEXT_PTR, G_KER_SRQ,
        params_srq, 1, 256);
    eger status != CUDA_SUCCESS { dondu 0; }

    degisken d_w_dev: tamsayi = d_w[0];
    degisken d_s_val: tamsayi = d_s[0];
    degisken params_down: [7]*u8;
    params_down[0] = &d_w_dev;
    params_down[1] = &YKN_CUDA_IQ2S_ACT_DEVICE;
    params_down[2] = &YKN_CUDA_IQ2S_OUT_DEVICE;
    params_down[3] = &N_val;
    params_down[4] = &K_val;
    params_down[5] = &YKN_CUDA_AMAX_DEVICE;
    params_down[6] = &d_s_val;
    status = cuda_ptx_launch_1d(YKN_CUDA_CONTEXT_PTR, ykn_cuda_bitnet_i2s_dev_amax_ptx(),
        "ykn_bitnet_i2s_matvec_dev_amax".ptr, params_down, (K + 7) / 8, 128);
    eger status != CUDA_SUCCESS { dondu 0; }

    status = cuda_copy_to_host(YKN_CUDA_CONTEXT_PTR, out_hidden, YKN_CUDA_IQ2S_OUT_DEVICE, K * 8);
    eger status != CUDA_SUCCESS { dondu 0; }

    ykn_cuda_clear_act_cache();
    dondu 1;
}

