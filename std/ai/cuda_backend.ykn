isv ykn_cuda_get_or_upload_norm_weight(norm_key: tamsayi, norm_ptr: *tamsayi, N: tamsayi) -> tamsayi {
    degisken slot: tamsayi = (norm_key ^ (norm_key / 256)) & 255;
    degisken probe: tamsayi = 0;
    dongu probe < 8 {
        degisken cur: tamsayi = (slot + probe) & 255;
        eger YKN_CUDA_NORM_HASH_INIT[cur] == 1 and YKN_CUDA_NORM_HASH_KEY[cur] == norm_key {
            dondu YKN_CUDA_NORM_HASH_PTR[cur];
        }
        eger YKN_CUDA_NORM_HASH_INIT[cur] == 0 { durdur; }
        probe = probe + 1;
    }
    degisken norm_dev: tamsayi = 0;
    degisken i: tamsayi = 0;
    dongu i < YKN_CUDA_SUBNORM_WEIGHT_CACHE_COUNT {
        eger YKN_CUDA_SUBNORM_WEIGHT_CACHE_KEYS[i] == norm_key {
            dondu YKN_CUDA_SUBNORM_WEIGHT_CACHE_PTRS[i];
        }
        i = i + 1;
    }
    eger norm_ptr == 0 { dondu 0; }
    eger cuda_buffer_alloc(YKN_CUDA_CONTEXT_PTR, N * 8, &norm_dev) != CUDA_SUCCESS { dondu 0; }
    eger cuda_copy_to_device(YKN_CUDA_CONTEXT_PTR, norm_dev, norm_ptr, N * 8) != CUDA_SUCCESS {
        cuda_buffer_free(YKN_CUDA_CONTEXT_PTR, norm_dev);
        dondu 0;
    }
    probe = 0;
    dongu probe < 8 {
        degisken cur: tamsayi = (slot + probe) & 255;
        eger YKN_CUDA_NORM_HASH_INIT[cur] == 0 or YKN_CUDA_NORM_HASH_KEY[cur] == norm_key {
            YKN_CUDA_NORM_HASH_INIT[cur] = 1;
            YKN_CUDA_NORM_HASH_KEY[cur] = norm_key;
            YKN_CUDA_NORM_HASH_PTR[cur] = norm_dev;
            durdur;
        }
        probe = probe + 1;
    }
    eger YKN_CUDA_SUBNORM_WEIGHT_CACHE_COUNT < 256 {
        degisken new_idx: tamsayi = YKN_CUDA_SUBNORM_WEIGHT_CACHE_COUNT;
        YKN_CUDA_SUBNORM_WEIGHT_CACHE_KEYS[new_idx] = norm_key;
        YKN_CUDA_SUBNORM_WEIGHT_CACHE_PTRS[new_idx] = norm_dev;
        YKN_CUDA_SUBNORM_WEIGHT_CACHE_COUNT = new_idx + 1;
    }
    dondu norm_dev;
}

isv ykn_cuda_bitnet_post_attn_ffn_fused(
    attn_sub_norm_key: tamsayi, attn_sub_norm_ptr: *tamsayi,
    o_key: tamsayi, o_bytes: tamsayi,
    ffn_norm_key: tamsayi, ffn_norm_ptr: *tamsayi,
    gate_key: tamsayi, gate_bytes: tamsayi,
    up_key: tamsayi, up_bytes: tamsayi,
    ffn_sub_norm_key: tamsayi, ffn_sub_norm_ptr: *tamsayi,
    down_key: tamsayi, down_bytes: tamsayi,
    K_hidden: tamsayi, N_ffn: tamsayi, eps_q16: tamsayi,
    attn_in: *tamsayi, residual_in: *tamsayi, hidden_out: *tamsayi,
    copy_out_to_host: tamsayi) -> tamsayi {

    degisken o_w: [1]tamsayi; degisken o_s: [1]tamsayi;
    degisken g_w: [1]tamsayi; degisken g_s: [1]tamsayi;
    degisken u_w: [1]tamsayi; degisken u_s: [1]tamsayi;
    degisken d_w: [1]tamsayi; degisken d_s: [1]tamsayi;
    eger ykn_cuda_get_iq2s_cached_weight(o_key, o_bytes, o_w, o_s) == 0 { dondu 0; }
    eger ykn_cuda_get_iq2s_cached_weight(gate_key, gate_bytes, g_w, g_s) == 0 { dondu 0; }
    eger ykn_cuda_get_iq2s_cached_weight(up_key, up_bytes, u_w, u_s) == 0 { dondu 0; }
    eger ykn_cuda_get_iq2s_cached_weight(down_key, down_bytes, d_w, d_s) == 0 { dondu 0; }

    degisken attn_sn_dev: tamsayi = ykn_cuda_get_or_upload_norm_weight(attn_sub_norm_key, attn_sub_norm_ptr, K_hidden);
    eger attn_sn_dev == 0 { dondu 0; }
    degisken ffn_n_dev: tamsayi = ykn_cuda_get_or_upload_norm_weight(ffn_norm_key, ffn_norm_ptr, K_hidden);
    eger ffn_n_dev == 0 { dondu 0; }
    degisken ffn_sn_dev: tamsayi = ykn_cuda_get_or_upload_norm_weight(ffn_sub_norm_key, ffn_sub_norm_ptr, N_ffn);
    eger ffn_sn_dev == 0 { dondu 0; }

    eger YKN_CUDA_IQ2S_ACT_DEVICE == 0 or YKN_CUDA_IQ2S_ACT_CAPACITY < 65536 {
        eger YKN_CUDA_IQ2S_ACT_DEVICE != 0 { cuda_buffer_free(YKN_CUDA_CONTEXT_PTR, YKN_CUDA_IQ2S_ACT_DEVICE); }
        eger cuda_buffer_alloc(YKN_CUDA_CONTEXT_PTR, 65536, &YKN_CUDA_IQ2S_ACT_DEVICE) != CUDA_SUCCESS { dondu 0; }
        YKN_CUDA_IQ2S_ACT_CAPACITY = 65536;
        ykn_cuda_clear_act_cache();
    }
    eger YKN_CUDA_IQ2S_OUT_DEVICE == 0 or YKN_CUDA_IQ2S_OUT_CAPACITY < 131072 {
        eger YKN_CUDA_IQ2S_OUT_DEVICE != 0 { cuda_buffer_free(YKN_CUDA_CONTEXT_PTR, YKN_CUDA_IQ2S_OUT_DEVICE); }
        eger cuda_buffer_alloc(YKN_CUDA_CONTEXT_PTR, 131072, &YKN_CUDA_IQ2S_OUT_DEVICE) != CUDA_SUCCESS { dondu 0; }
        YKN_CUDA_IQ2S_OUT_CAPACITY = 131072;
    }
    YKN_CUDA_IQ2S_OUT_DEVICE_2 = YKN_CUDA_IQ2S_OUT_DEVICE + N_ffn * 8;
    eger YKN_CUDA_RESIDUAL_DEVICE == 0 or YKN_CUDA_RESIDUAL_CAPACITY < K_hidden * 8 {
        eger YKN_CUDA_RESIDUAL_DEVICE != 0 { cuda_buffer_free(YKN_CUDA_CONTEXT_PTR, YKN_CUDA_RESIDUAL_DEVICE); }
        eger cuda_buffer_alloc(YKN_CUDA_CONTEXT_PTR, K_hidden * 8, &YKN_CUDA_RESIDUAL_DEVICE) != CUDA_SUCCESS { dondu 0; }
        YKN_CUDA_RESIDUAL_CAPACITY = K_hidden * 8;
    }
    eger YKN_CUDA_AMAX_DEVICE == 0 {
        eger cuda_buffer_alloc(YKN_CUDA_CONTEXT_PTR, 8, &YKN_CUDA_AMAX_DEVICE) != CUDA_SUCCESS { dondu 0; }
    }

    # Copy attn_in only if not already on GPU
    degisken attn_src_dev: tamsayi = YKN_CUDA_IQ2S_OUT_DEVICE;
    eger YKN_CUDA_ATTN_ON_GPU == 1 {
        attn_src_dev = YKN_CUDA_IQ2S_OUT_DEVICE + 32768;
        YKN_CUDA_ATTN_ON_GPU = 0;
    } yoksa {
        eger cuda_copy_to_device(YKN_CUDA_CONTEXT_PTR, YKN_CUDA_IQ2S_OUT_DEVICE, attn_in, K_hidden * 8) != CUDA_SUCCESS { dondu 0; }
    }
    eger YKN_CUDA_HIDDEN_ON_GPU == 0 {
        eger cuda_copy_to_device(YKN_CUDA_CONTEXT_PTR, YKN_CUDA_RESIDUAL_DEVICE, residual_in, K_hidden * 8) != CUDA_SUCCESS { dondu 0; }
    }

    degisken K_val: tamsayi = K_hidden;
    degisken N_val: tamsayi = N_ffn;
    degisken eps_val: tamsayi = eps_q16;

    # 1. attn_sub_norm + quant
    degisken params_sn1: [7]*u8;
    params_sn1[0] = &attn_src_dev;
    params_sn1[1] = &attn_sn_dev;
    params_sn1[2] = &YKN_CUDA_IQ2S_OUT_DEVICE_2;
    params_sn1[3] = &YKN_CUDA_IQ2S_ACT_DEVICE;
    params_sn1[4] = &YKN_CUDA_AMAX_DEVICE;
    params_sn1[5] = &K_val;
    params_sn1[6] = &eps_val;
    degisken status: tamsayi = cuda_kernel_launch_1d(YKN_CUDA_CONTEXT_PTR, G_KER_RMSNORM_QUANT,
        params_sn1, 1, 256);
    eger status != CUDA_SUCCESS { dondu 0; }

    # 2. o_proj matvec with dev_amax
    degisken o_w_dev: tamsayi = o_w[0];
    degisken o_s_val: tamsayi = o_s[0];
    degisken params_o: [7]*u8;
    params_o[0] = &o_w_dev;
    params_o[1] = &YKN_CUDA_IQ2S_ACT_DEVICE;
    params_o[2] = &YKN_CUDA_IQ2S_OUT_DEVICE;
    params_o[3] = &K_val;
    params_o[4] = &K_val;
    params_o[5] = &YKN_CUDA_AMAX_DEVICE;
    params_o[6] = &o_s_val;
    status = cuda_kernel_launch_1d(YKN_CUDA_CONTEXT_PTR, G_KER_BITNET_I2S_DEV_AMAX,
        params_o, (K_hidden + 7) / 8, 128);
    eger status != CUDA_SUCCESS { dondu 0; }

    # 3. res_add + ffn_norm + quant
    degisken params_rn: [8]*u8;
    params_rn[0] = &YKN_CUDA_IQ2S_OUT_DEVICE;
    params_rn[1] = &YKN_CUDA_RESIDUAL_DEVICE;
    params_rn[2] = &ffn_n_dev;
    params_rn[3] = &YKN_CUDA_IQ2S_OUT_DEVICE_2;
    params_rn[4] = &YKN_CUDA_IQ2S_ACT_DEVICE;
    params_rn[5] = &YKN_CUDA_AMAX_DEVICE;
    params_rn[6] = &K_val;
    params_rn[7] = &eps_val;
    status = cuda_kernel_launch_1d(YKN_CUDA_CONTEXT_PTR, G_KER_RES_ADD_RMSNORM_QUANT,
        params_rn, 1, 256);
    eger status != CUDA_SUCCESS { dondu 0; }

    # 4. gate_up matvec with dev_amax
    degisken g_w_dev: tamsayi = g_w[0];
    degisken g_s_val: tamsayi = g_s[0];
    degisken u_w_dev: tamsayi = u_w[0];
    degisken u_s_val: tamsayi = u_s[0];
    degisken params_gu: [10]*u8;
    params_gu[0] = &g_w_dev;
    params_gu[1] = &u_w_dev;
    params_gu[2] = &YKN_CUDA_IQ2S_ACT_DEVICE;
    params_gu[3] = &YKN_CUDA_IQ2S_OUT_DEVICE;
    params_gu[4] = &YKN_CUDA_IQ2S_OUT_DEVICE_2;
    params_gu[5] = &K_val;
    params_gu[6] = &N_val;
    params_gu[7] = &YKN_CUDA_AMAX_DEVICE;
    params_gu[8] = &g_s_val;
    params_gu[9] = &u_s_val;
    status = cuda_kernel_launch_1d(YKN_CUDA_CONTEXT_PTR, G_KER_GATE_UP_DEV_AMAX,
        params_gu, (N_ffn + 7) / 8, 128);
    eger status != CUDA_SUCCESS { dondu 0; }

    # 5. SwiGLU + ffn_sub_norm + quant
    degisken params_srq: [8]*u8;
    params_srq[0] = &YKN_CUDA_IQ2S_OUT_DEVICE;
    params_srq[1] = &YKN_CUDA_IQ2S_OUT_DEVICE_2;
    params_srq[2] = &YKN_CUDA_SILU_LUT_DEVICE;
    params_srq[3] = &ffn_sn_dev;
    params_srq[4] = &YKN_CUDA_IQ2S_ACT_DEVICE;
    params_srq[5] = &YKN_CUDA_AMAX_DEVICE;
    params_srq[6] = &N_val;
    params_srq[7] = &eps_val;
    status = cuda_kernel_launch_1d(YKN_CUDA_CONTEXT_PTR, G_KER_SRQ,
        params_srq, 1, 256);
    eger status != CUDA_SUCCESS { dondu 0; }

    # 6. down_proj matvec with dev_amax + res_add (writes directly into YKN_CUDA_RESIDUAL_DEVICE!)
    degisken d_w_dev: tamsayi = d_w[0];
    degisken d_s_val: tamsayi = d_s[0];

    degisken ffn_rec_base: tamsayi = G_YKN_CUDA_CURRENT_LAYER * 20;
    eger ffn_rec_base >= 0 and ffn_rec_base < 600 {
        G_BITNET_LAYER_PARAMS[ffn_rec_base + 7] = attn_sn_dev;
        G_BITNET_LAYER_PARAMS[ffn_rec_base + 8] = o_w_dev;
        G_BITNET_LAYER_PARAMS[ffn_rec_base + 9] = o_s_val;
        G_BITNET_LAYER_PARAMS[ffn_rec_base + 10] = ffn_n_dev;
        G_BITNET_LAYER_PARAMS[ffn_rec_base + 11] = g_w_dev;
        G_BITNET_LAYER_PARAMS[ffn_rec_base + 12] = g_s_val;
        G_BITNET_LAYER_PARAMS[ffn_rec_base + 13] = u_w_dev;
        G_BITNET_LAYER_PARAMS[ffn_rec_base + 14] = u_s_val;
        G_BITNET_LAYER_PARAMS[ffn_rec_base + 15] = ffn_sn_dev;
        G_BITNET_LAYER_PARAMS[ffn_rec_base + 16] = d_w_dev;
        G_BITNET_LAYER_PARAMS[ffn_rec_base + 17] = d_s_val;
        G_BITNET_LAYER_READY[G_YKN_CUDA_CURRENT_LAYER] = 1;
    }
    degisken p_res_in1: tamsayi = YKN_CUDA_RESIDUAL_DEVICE;
    degisken p_res_out1: tamsayi = YKN_CUDA_RESIDUAL_DEVICE;
    degisken params_down: [8]*u8;
    params_down[0] = &d_w_dev;
    params_down[1] = &YKN_CUDA_IQ2S_ACT_DEVICE;
    params_down[2] = &p_res_in1;
    params_down[3] = &p_res_out1;
    params_down[4] = &N_val;
    params_down[5] = &K_val;
    params_down[6] = &YKN_CUDA_AMAX_DEVICE;
    params_down[7] = &d_s_val;
    status = cuda_kernel_launch_1d(YKN_CUDA_CONTEXT_PTR, G_KER_DEV_AMAX_RES_ADD,
        params_down, (K_hidden + 7) / 8, 128);
    eger status != CUDA_SUCCESS { dondu 0; }

    # 7. Copy out_hidden back to host only when requested (last layer)
    eger copy_out_to_host == 1 {
        status = cuda_copy_to_host(YKN_CUDA_CONTEXT_PTR, hidden_out, YKN_CUDA_RESIDUAL_DEVICE, K_hidden * 8);
        eger status != CUDA_SUCCESS { dondu 0; }
        YKN_CUDA_HIDDEN_ON_GPU = 0;
    } yoksa {
        YKN_CUDA_HIDDEN_ON_GPU = 1;
    }

    ykn_cuda_clear_act_cache();
    dondu 1;
}

isv ykn_cuda_bitnet_norm_qkv(
    attn_norm_key: tamsayi, attn_norm_ptr: *tamsayi,
    q_key: tamsayi, q_bytes: tamsayi, N_q: tamsayi, out_q: *tamsayi,
    k_key: tamsayi, k_bytes: tamsayi, N_k: tamsayi, out_k: *tamsayi,
    v_key: tamsayi, v_bytes: tamsayi, N_v: tamsayi, out_v: *tamsayi,
    hidden_in: *tamsayi, K: tamsayi, eps_q16: tamsayi) -> tamsayi {

    degisken q_w: [1]tamsayi; degisken q_s: [1]tamsayi;
    degisken k_w: [1]tamsayi; degisken k_s: [1]tamsayi;
    degisken v_w: [1]tamsayi; degisken v_s: [1]tamsayi;
    eger ykn_cuda_get_iq2s_cached_weight(q_key, q_bytes, q_w, q_s) == 0 { dondu 0; }
    eger ykn_cuda_get_iq2s_cached_weight(k_key, k_bytes, k_w, k_s) == 0 { dondu 0; }
    eger ykn_cuda_get_iq2s_cached_weight(v_key, v_bytes, v_w, v_s) == 0 { dondu 0; }

    degisken attn_n_dev: tamsayi = ykn_cuda_get_or_upload_norm_weight(attn_norm_key, attn_norm_ptr, K);
    eger attn_n_dev == 0 { dondu 0; }

    eger YKN_CUDA_IQ2S_ACT_DEVICE == 0 or YKN_CUDA_IQ2S_ACT_CAPACITY < 65536 {
        eger YKN_CUDA_IQ2S_ACT_DEVICE != 0 { cuda_buffer_free(YKN_CUDA_CONTEXT_PTR, YKN_CUDA_IQ2S_ACT_DEVICE); }
        eger cuda_buffer_alloc(YKN_CUDA_CONTEXT_PTR, 65536, &YKN_CUDA_IQ2S_ACT_DEVICE) != CUDA_SUCCESS { dondu 0; }
        YKN_CUDA_IQ2S_ACT_CAPACITY = 65536;
    }
    eger YKN_CUDA_IQ2S_OUT_DEVICE == 0 or YKN_CUDA_IQ2S_OUT_CAPACITY < 131072 {
        eger YKN_CUDA_IQ2S_OUT_DEVICE != 0 { cuda_buffer_free(YKN_CUDA_CONTEXT_PTR, YKN_CUDA_IQ2S_OUT_DEVICE); }
        eger cuda_buffer_alloc(YKN_CUDA_CONTEXT_PTR, 131072, &YKN_CUDA_IQ2S_OUT_DEVICE) != CUDA_SUCCESS { dondu 0; }
        YKN_CUDA_IQ2S_OUT_CAPACITY = 131072;
    }
    eger YKN_CUDA_RESIDUAL_DEVICE == 0 or YKN_CUDA_RESIDUAL_CAPACITY < K * 8 {
        eger YKN_CUDA_RESIDUAL_DEVICE != 0 { cuda_buffer_free(YKN_CUDA_CONTEXT_PTR, YKN_CUDA_RESIDUAL_DEVICE); }
        eger cuda_buffer_alloc(YKN_CUDA_CONTEXT_PTR, K * 8, &YKN_CUDA_RESIDUAL_DEVICE) != CUDA_SUCCESS { dondu 0; }
        YKN_CUDA_RESIDUAL_CAPACITY = K * 8;
        YKN_CUDA_HIDDEN_ON_GPU = 0;
    }
    eger YKN_CUDA_AMAX_DEVICE == 0 {
        eger cuda_buffer_alloc(YKN_CUDA_CONTEXT_PTR, 8, &YKN_CUDA_AMAX_DEVICE) != CUDA_SUCCESS { dondu 0; }
    }

    degisken t_gpu0: tamsayi = ykn_llm_clock_ns();
    eger YKN_CUDA_HIDDEN_ON_GPU == 0 {
        eger cuda_copy_to_device(YKN_CUDA_CONTEXT_PTR, YKN_CUDA_RESIDUAL_DEVICE, hidden_in, K * 8) != CUDA_SUCCESS { dondu 0; }
        YKN_CUDA_HIDDEN_ON_GPU = 1;
    }

    degisken K_val: tamsayi = K;
    degisken eps_val: tamsayi = eps_q16;
    degisken temp_dev: tamsayi = YKN_CUDA_IQ2S_OUT_DEVICE + 65536;

    # 1. attn_norm + quant from YKN_CUDA_RESIDUAL_DEVICE
    degisken params_n: [7]*u8;
    params_n[0] = &YKN_CUDA_RESIDUAL_DEVICE;
    params_n[1] = &attn_n_dev;
    params_n[2] = &temp_dev;
    params_n[3] = &YKN_CUDA_IQ2S_ACT_DEVICE;
    params_n[4] = &YKN_CUDA_AMAX_DEVICE;
    params_n[5] = &K_val;
    params_n[6] = &eps_val;
    degisken status: tamsayi = cuda_kernel_launch_1d(YKN_CUDA_CONTEXT_PTR, G_KER_RMSNORM_QUANT,
        params_n, 1, 256);
    eger status != CUDA_SUCCESS { dondu 0; }

    # 2. Q matvec with dev_amax
    degisken q_w_dev: tamsayi = q_w[0];
    degisken q_s_val: tamsayi = q_s[0];
    degisken N_q_val: tamsayi = N_q;
    degisken out_q_dev: tamsayi = YKN_CUDA_IQ2S_OUT_DEVICE;
    degisken out_k_dev: tamsayi = YKN_CUDA_IQ2S_OUT_DEVICE + N_q * 8;
    degisken out_v_dev: tamsayi = out_k_dev + N_k * 8;

    degisken params_q: [7]*u8;
    params_q[0] = &q_w_dev;
    params_q[1] = &YKN_CUDA_IQ2S_ACT_DEVICE;
    params_q[2] = &out_q_dev;
    params_q[3] = &K_val;
    params_q[4] = &N_q_val;
    params_q[5] = &YKN_CUDA_AMAX_DEVICE;
    params_q[6] = &q_s_val;
    status = cuda_kernel_launch_1d(YKN_CUDA_CONTEXT_PTR, G_KER_BITNET_I2S_DEV_AMAX,
        params_q, (N_q + 7) / 8, 128);
    eger status != CUDA_SUCCESS { dondu 0; }

    # 3. KV matvec with dev_amax
    degisken k_w_dev: tamsayi = k_w[0];
    degisken k_s_val: tamsayi = k_s[0];
    degisken v_w_dev: tamsayi = v_w[0];
    degisken v_s_val: tamsayi = v_s[0];

    degisken rec_base: tamsayi = G_YKN_CUDA_CURRENT_LAYER * 20;
    eger rec_base >= 0 and rec_base < 600 {
        G_BITNET_LAYER_PARAMS[rec_base + 0] = attn_n_dev;
        G_BITNET_LAYER_PARAMS[rec_base + 1] = q_w_dev;
        G_BITNET_LAYER_PARAMS[rec_base + 2] = q_s_val;
        G_BITNET_LAYER_PARAMS[rec_base + 3] = k_w_dev;
        G_BITNET_LAYER_PARAMS[rec_base + 4] = k_s_val;
        G_BITNET_LAYER_PARAMS[rec_base + 5] = v_w_dev;
        G_BITNET_LAYER_PARAMS[rec_base + 6] = v_s_val;
    }
    degisken N_k_val: tamsayi = N_k;
    degisken params_kv: [10]*u8;
    params_kv[0] = &k_w_dev;
    params_kv[1] = &v_w_dev;
    params_kv[2] = &YKN_CUDA_IQ2S_ACT_DEVICE;
    params_kv[3] = &out_k_dev;
    params_kv[4] = &out_v_dev;
    params_kv[5] = &K_val;
    params_kv[6] = &N_k_val;
    params_kv[7] = &YKN_CUDA_AMAX_DEVICE;
    params_kv[8] = &k_s_val;
    params_kv[9] = &v_s_val;
    status = cuda_kernel_launch_1d(YKN_CUDA_CONTEXT_PTR, G_KER_GATE_UP_DEV_AMAX,
        params_kv, (N_k + 7) / 8, 128);
    eger status != CUDA_SUCCESS { dondu 0; }

    eger YKN_CUDA_KV_K_DEVICE != 0 and YKN_CUDA_KV_V_DEVICE != 0 and
       YKN_CUDA_ROPE_COS_DEVICE != 0 and YKN_CUDA_ROPE_SIN_DEVICE != 0 {
        degisken t_gpu1_fast: tamsayi = ykn_llm_clock_ns();
        YKN_CUDA_I2S_GPU_NS = YKN_CUDA_I2S_GPU_NS + (t_gpu1_fast - t_gpu0);
        YKN_CUDA_I2S_CALLS = YKN_CUDA_I2S_CALLS + 3;
        dondu 2;
    }

    # 4. Copy Q, K, V back to host (1 call if contiguous!)
    degisken p_q: tamsayi = out_q as tamsayi;
    degisken p_k: tamsayi = out_k as tamsayi;
    degisken p_v: tamsayi = out_v as tamsayi;
    eger p_k == p_q + N_q * 8 and p_v == p_k + N_k * 8 {
        status = cuda_copy_to_host(YKN_CUDA_CONTEXT_PTR, out_q, out_q_dev, (N_q + N_k + N_v) * 8);
        eger status != CUDA_SUCCESS { dondu 0; }
    } yoksa {
        status = cuda_copy_to_host(YKN_CUDA_CONTEXT_PTR, out_q, out_q_dev, N_q * 8);
        eger status != CUDA_SUCCESS { dondu 0; }
        status = cuda_copy_to_host(YKN_CUDA_CONTEXT_PTR, out_k, out_k_dev, N_k * 8);
        eger status != CUDA_SUCCESS { dondu 0; }
        status = cuda_copy_to_host(YKN_CUDA_CONTEXT_PTR, out_v, out_v_dev, N_v * 8);
        eger status != CUDA_SUCCESS { dondu 0; }
    }

    degisken t_gpu1: tamsayi = ykn_llm_clock_ns();
    YKN_CUDA_I2S_GPU_NS = YKN_CUDA_I2S_GPU_NS + (t_gpu1 - t_gpu0);
    YKN_CUDA_I2S_CALLS = YKN_CUDA_I2S_CALLS + 3;
    dondu 1;
}

isv ykn_cuda_bitnet_final_norm(final_norm_key: tamsayi, final_norm_ptr: *tamsayi,
                               K: tamsayi, eps_q16: tamsayi) -> tamsayi {
    eger YKN_CUDA_READY != 1 or YKN_CUDA_RESIDUAL_DEVICE == 0 { dondu 0; }
    degisken fn_dev: tamsayi = ykn_cuda_get_or_upload_norm_weight(final_norm_key, final_norm_ptr, K);
    eger fn_dev == 0 { dondu 0; }
    G_FINAL_NORM_DEV = fn_dev;
    eger G_CUDA_GRAPH_HAS_FINAL_NORM == 1 { dondu 1; }
    eger YKN_CUDA_F16_ACT_DEVICE == 0 or YKN_CUDA_F16_ACT_CAPACITY < K * 8 {
        eger YKN_CUDA_F16_ACT_DEVICE != 0 { cuda_buffer_free(YKN_CUDA_CONTEXT_PTR, YKN_CUDA_F16_ACT_DEVICE); }
        eger cuda_buffer_alloc(YKN_CUDA_CONTEXT_PTR, K * 8, &YKN_CUDA_F16_ACT_DEVICE) != CUDA_SUCCESS { dondu 0; }
        YKN_CUDA_F16_ACT_CAPACITY = K * 8;
    }
    degisken params: [5]*u8;
    degisken K_val: tamsayi = K;
    degisken eps_val: tamsayi = eps_q16;
    params[0] = &YKN_CUDA_RESIDUAL_DEVICE;
    params[1] = &fn_dev;
    params[2] = &YKN_CUDA_F16_ACT_DEVICE;
    params[3] = &K_val;
    params[4] = &eps_val;
    degisken status: tamsayi = cuda_kernel_launch_config(YKN_CUDA_CONTEXT_PTR, G_KER_RMSNORM,
        params, G_CFG_1_256);
    eger status != CUDA_SUCCESS { dondu 0; }
    dondu 1;
}

isv ykn_cuda_f16_embd_to_q16_ptx() -> *u8 {
    dondu ".version 8.0\n.target sm_52\n.address_size 64\n.visible .entry ykn_f16_embd_to_q16(.param .u64 pInF16,.param .u64 pOutQ16,.param .u32 pN){\n.reg .pred %p<8>;\n.reg .b32 %r<20>;\n.reg .b64 %rd<8>;\n.reg .s64 %s<6>;\nld.param.u64 %rd0,[pInF16];\nld.param.u64 %rd1,[pOutQ16];\nld.param.u32 %r0,[pN];\nmov.u32 %r1,%tid.x;\nLOOP:\nsetp.ge.u32 %p0,%r1,%r0;\n@%p0 bra DONE;\nmul.wide.u32 %rd2,%r1,2;\nadd.u64 %rd3,%rd0,%rd2;\nld.global.u16 %r2,[%rd3];\nshr.u32 %r3,%r2,10;\nand.b32 %r3,%r3,31;\nand.b32 %r4,%r2,1023;\nsetp.eq.u32 %p1,%r3,0;\n@%p1 bra HALF_SUB;\nsetp.eq.u32 %p2,%r3,31;\n@%p2 bra HALF_ZERO;\nadd.u32 %r4,%r4,1024;\nshl.b32 %r4,%r4,6;\ncvt.s64.u32 %s0,%r4;\nsub.s32 %r5,%r3,15;\nsetp.ge.s32 %p3,%r5,0;\n@%p3 bra HALF_LEFT;\nneg.s32 %r5,%r5;\nshr.s64 %s0,%s0,%r5;\nbra HALF_SIGN;\nHALF_LEFT:\nshl.b64 %s0,%s0,%r5;\nbra HALF_SIGN;\nHALF_SUB:\nshr.u32 %r4,%r4,8;\ncvt.s64.u32 %s0,%r4;\nbra HALF_SIGN;\nHALF_ZERO:\nmov.s64 %s0,0;\nHALF_SIGN:\nshr.u32 %r6,%r2,15;\nsetp.eq.u32 %p4,%r6,0;\n@%p4 bra HALF_READY;\nneg.s64 %s0,%s0;\nHALF_READY:\nmul.wide.u32 %rd4,%r1,8;\nadd.u64 %rd5,%rd1,%rd4;\nst.global.s64 [%rd5],%s0;\nadd.u32 %r1,%r1,256;\nbra LOOP;\nDONE:\nret;\n}\n".ptr;
}

isv ykn_cuda_f16_embd_to_q16_gpu(f16_row_dev: tamsayi, K: tamsayi) -> tamsayi {
    eger YKN_CUDA_READY != 1 or f16_row_dev == 0 or K <= 0 { dondu 0; }
    eger YKN_CUDA_RESIDUAL_DEVICE == 0 or YKN_CUDA_RESIDUAL_CAPACITY < K * 8 {
        eger YKN_CUDA_RESIDUAL_DEVICE != 0 { cuda_buffer_free(YKN_CUDA_CONTEXT_PTR, YKN_CUDA_RESIDUAL_DEVICE); }
        eger cuda_buffer_alloc(YKN_CUDA_CONTEXT_PTR, K * 8, &YKN_CUDA_RESIDUAL_DEVICE) != CUDA_SUCCESS { dondu 0; }
        YKN_CUDA_RESIDUAL_CAPACITY = K * 8;
    }
    degisken row_dev: tamsayi = f16_row_dev;
    degisken K_val: tamsayi = K;
    degisken params: [3]*u8;
    params[0] = &row_dev;
    params[1] = &YKN_CUDA_RESIDUAL_DEVICE;
    params[2] = &K_val;
    eger G_KER_EMBD == 0 {
        G_KER_EMBD = cuda_ptx_get_kernel(YKN_CUDA_CONTEXT_PTR, ykn_cuda_f16_embd_to_q16_ptx(), "ykn_f16_embd_to_q16".ptr);
    }
    degisken st: tamsayi = cuda_kernel_launch_config(YKN_CUDA_CONTEXT_PTR, G_KER_EMBD, params, G_CFG_1_256);
    eger st != CUDA_SUCCESS { dondu 0; }
    YKN_CUDA_HIDDEN_ON_GPU = 1;
    dondu 1;
}

isv ykn_cuda_cache_i2s_weight(packed: *u8, K: tamsayi, N: tamsayi,
                              packed_bytes: tamsayi, cache_key: tamsayi) -> tamsayi {
    eger YKN_CUDA_READY != 1 or packed == 0 or K <= 0 or N <= 0 or packed_bytes != N * (K / 4) + 32 or cache_key == 0 { dondu 0; }
    degisken dummy_w: [1]tamsayi; degisken dummy_s: [1]tamsayi;
    eger ykn_cuda_get_iq2s_cached_weight(cache_key, packed_bytes, dummy_w, dummy_s) == 1 { dondu 1; }
    degisken scale_q16: tamsayi = bitnet_i2s_scale_q16(packed, N * K / 4);
    eger scale_q16 <= 0 { dondu 0; }
    eger YKN_CUDA_IQ2S_WEIGHT_CACHE_COUNT >= 256 { dondu 0; }
    degisken gpu_weights: tamsayi = 0;
    eger cuda_buffer_alloc(YKN_CUDA_CONTEXT_PTR, packed_bytes, &gpu_weights) != CUDA_SUCCESS { dondu 0; }
    eger cuda_copy_to_device(YKN_CUDA_CONTEXT_PTR, gpu_weights, packed, packed_bytes) != CUDA_SUCCESS {
        cuda_buffer_free(YKN_CUDA_CONTEXT_PTR, gpu_weights); dondu 0;
    }
    degisken slot: tamsayi = (cache_key ^ (cache_key / 256)) & 511;
    degisken probe: tamsayi = 0;
    dongu probe < 8 {
        degisken cur: tamsayi = (slot + probe) & 511;
        eger YKN_CUDA_WEIGHT_HASH_INIT[cur] == 0 or YKN_CUDA_WEIGHT_HASH_KEY[cur] == cache_key {
            YKN_CUDA_WEIGHT_HASH_INIT[cur] = 1;
            YKN_CUDA_WEIGHT_HASH_KEY[cur] = cache_key;
            YKN_CUDA_WEIGHT_HASH_PTR[cur] = gpu_weights;
            YKN_CUDA_WEIGHT_HASH_SCALE[cur] = scale_q16;
            durdur;
        }
        probe = probe + 1;
    }
    degisken cache_i: tamsayi = YKN_CUDA_IQ2S_WEIGHT_CACHE_COUNT;
    YKN_CUDA_IQ2S_WEIGHT_CACHE_KEYS[cache_i] = cache_key;
    YKN_CUDA_IQ2S_WEIGHT_CACHE_PTRS[cache_i] = gpu_weights;
    YKN_CUDA_IQ2S_WEIGHT_CACHE_BYTES[cache_i] = packed_bytes;
    YKN_CUDA_IQ2S_WEIGHT_CACHE_SCALES[cache_i] = scale_q16;
    YKN_CUDA_IQ2S_WEIGHT_CACHE_COUNT = cache_i + 1;
    dondu 1;
}

isv ykn_cuda_warmup_kernels() {
    eger YKN_CUDA_READY != 1 { dondu; }
    YKN_CUDA_LAUNCH_EX = YKN_CUDA_CONTEXT_PTR.cu_launch_kernel_ex;
    G_KER_RMSNORM_QUANT = cuda_ptx_get_kernel(YKN_CUDA_CONTEXT_PTR, ykn_cuda_rmsnorm_quant_i2s_ptx(), "ykn_rmsnorm_quant_i2s".ptr);
    G_KER_BITNET_I2S_DEV_AMAX = cuda_ptx_get_kernel(YKN_CUDA_CONTEXT_PTR, ykn_cuda_bitnet_i2s_dev_amax_ptx(), "ykn_bitnet_i2s_matvec_dev_amax".ptr);
    G_KER_GATE_UP_DEV_AMAX = cuda_ptx_get_kernel(YKN_CUDA_CONTEXT_PTR, ykn_cuda_bitnet_i2s_gate_up_dev_amax_ptx(), "ykn_bitnet_i2s_matvec_gate_up_dev_amax".ptr);
    G_KER_RES_ADD_RMSNORM_QUANT = cuda_ptx_get_kernel(YKN_CUDA_CONTEXT_PTR, ykn_cuda_res_add_rmsnorm_quant_i2s_ptx(), "ykn_res_add_rmsnorm_quant_i2s".ptr);
    G_KER_SRQ = cuda_ptx_get_kernel(YKN_CUDA_CONTEXT_PTR, ykn_cuda_srq_ptx(), "ykn_swiglu_rmsnorm_quant_i2s".ptr);
    G_KER_DEV_AMAX_RES_ADD = cuda_ptx_get_kernel(YKN_CUDA_CONTEXT_PTR, ykn_cuda_bitnet_i2s_dev_amax_res_add_ptx(), "ykn_bitnet_i2s_matvec_dev_amax_res_add".ptr);
    G_KER_RMSNORM = cuda_ptx_get_kernel(YKN_CUDA_CONTEXT_PTR, ykn_cuda_rmsnorm_ptx(), "ykn_rmsnorm_q16".ptr);
    G_KER_F16 = cuda_ptx_get_kernel(YKN_CUDA_CONTEXT_PTR, ykn_cuda_f16_ptx(), "ykn_f16_matvec".ptr);
    G_KER_ARGMAX = cuda_ptx_get_kernel(YKN_CUDA_CONTEXT_PTR, ykn_cuda_argmax_ptx(), "ykn_logits_rep_argmax".ptr);
    G_KER_ROPE_KV = cuda_ptx_get_kernel(YKN_CUDA_CONTEXT_PTR, ykn_cuda_rope_kv_write_ptx(), "ykn_rope_kv_write_q16".ptr);
    G_KER_KV_ATTN = cuda_ptx_get_kernel(YKN_CUDA_CONTEXT_PTR, ykn_cuda_kv_attention_ptx(), "ykn_kv_attention_q16".ptr);
    G_KER_ROPE_KV_STATIC = cuda_ptx_get_kernel(YKN_CUDA_CONTEXT_PTR, ykn_cuda_rope_kv_write_static_ptx(), "ykn_rope_kv_write_static_q16".ptr);
    G_KER_KV_ATTN_STATIC = cuda_ptx_get_kernel(YKN_CUDA_CONTEXT_PTR, ykn_cuda_kv_attention_static_ptx(), "ykn_kv_attention_static_q16".ptr);
    cuda_make_1d_config(1, 256, G_CFG_1_256);
    cuda_make_1d_config(320, 128, G_CFG_Q);
    cuda_make_1d_config(64, 128, G_CFG_KV);
    cuda_make_1d_config(20, 128, G_CFG_ATTN);
    cuda_make_1d_config(320, 128, G_CFG_O);
    cuda_make_1d_config(864, 128, G_CFG_GU);
    cuda_make_1d_config(320, 128, G_CFG_DOWN);
    cuda_make_1d_config(4008, 128, G_CFG_F16);
    G_CFG_WARMED = 1;
