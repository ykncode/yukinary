        eger scale_q16 <= 0 { YKN_CUDA_LAST_ERROR = CUDA_ERROR_BAD_ARGUMENT; dondu 0; }
        eger YKN_CUDA_IQ2S_WEIGHT_CACHE_COUNT >= 256 { YKN_CUDA_LAST_ERROR = CUDA_ERROR_OUT_OF_MEMORY; dondu 0; }
