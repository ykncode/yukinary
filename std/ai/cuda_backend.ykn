degisken YKN_CUDA_KV_V_DEVICE: tamsayi = 0;
degisken YKN_CUDA_KV_CAPACITY_BYTES: tamsayi = 0;
degisken YKN_CUDA_ROPE_COS_DEVICE: tamsayi = 0;
degisken YKN_CUDA_ROPE_SIN_DEVICE: tamsayi = 0;
degisken YKN_CUDA_ROPE_CAPACITY_BYTES: tamsayi = 0;

