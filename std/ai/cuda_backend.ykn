degisken YKN_CUDA_LMHEAD_SCALE: tamsayi = 0;
degisken YKN_CUDA_RECENT_DEVICE: tamsayi = 0;
degisken YKN_CUDA_ARGMAX_OUT_DEVICE: tamsayi = 0;
degisken YKN_CUDA_SUBNORM_WEIGHT_CACHE_KEYS: [256]tamsayi;
