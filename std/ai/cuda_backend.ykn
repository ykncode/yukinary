isv ykn_cuda_backend_start() -> tamsayi {
    eger YKN_CUDA_READY == 1 { dondu 1; }

    YKN_CUDA_CONTEXT_PTR = bellek_tahsis_et(192);
    eger YKN_CUDA_CONTEXT_PTR == 0 { YKN_CUDA_LAST_ERROR = CUDA_ERROR_OUT_OF_MEMORY; dondu 0; }

    degisken status: tamsayi = cuda_driver_init(YKN_CUDA_CONTEXT_PTR);
    eger status != CUDA_SUCCESS {
        YKN_CUDA_LAST_ERROR = status;
        dondu 0;
    }

    status = cuda_context_create(YKN_CUDA_CONTEXT_PTR, 0);
    eger status != CUDA_SUCCESS {
        YKN_CUDA_LAST_ERROR = status;
        cuda_driver_close(YKN_CUDA_CONTEXT_PTR);
        dondu 0;
    }
    eger YKN_CUDA_SILU_LUT_DEVICE == 0 {
        degisken lut_entries: tamsayi = 1048576;
        degisken lut_bytes: tamsayi = lut_entries * 4;
        degisken h_lut: *u8 = bellek_tahsis_et(lut_bytes);
        eger h_lut != 0 {
            degisken h_lut_s32: *tamsayi = h_lut;
            degisken lut_i: tamsayi = 0;
            dongu lut_i < lut_entries {
                degisken val: tamsayi = lut_i - 524288;
                degisken s: tamsayi = bitnet_q16_silu(val);
                degisken slot: tamsayi = lut_i / 2;
                degisken mod: tamsayi = lut_i % 2;
                degisken cur: tamsayi = h_lut_s32[slot];
                eger mod == 0 {
                    cur = (cur & -4294967296) | (s & 4294967295);
                } yoksa {
                    cur = (cur & 4294967295) | ((s & 4294967295) << 32);
                }
                h_lut_s32[slot] = cur;
                lut_i = lut_i + 1;
            }
            status = cuda_buffer_alloc(YKN_CUDA_CONTEXT_PTR, lut_bytes, &YKN_CUDA_SILU_LUT_DEVICE);
            eger status == CUDA_SUCCESS {
                status = cuda_copy_to_device(YKN_CUDA_CONTEXT_PTR, YKN_CUDA_SILU_LUT_DEVICE, h_lut, lut_bytes);
            }
            os_bellek_serbest(h_lut);
        }
    }
    YKN_CUDA_READY = 1;
    YKN_CUDA_LAST_ERROR = CUDA_SUCCESS;
    ykn_cuda_warmup_kernels();
    llm_cuda_preload_if_ready();
    dondu 1;
}

isv ykn_cuda_backend_stop() {
    eger YKN_CUDA_READY == 1 {
        eger YKN_CUDA_SILU_LUT_DEVICE != 0 { cuda_buffer_free(YKN_CUDA_CONTEXT_PTR, YKN_CUDA_SILU_LUT_DEVICE); YKN_CUDA_SILU_LUT_DEVICE = 0; }
        eger YKN_CUDA_IQ2S_GRID_LO != 0 { cuda_buffer_free(YKN_CUDA_CONTEXT_PTR, YKN_CUDA_IQ2S_GRID_LO); }
        eger YKN_CUDA_IQ2S_GRID_HI != 0 { cuda_buffer_free(YKN_CUDA_CONTEXT_PTR, YKN_CUDA_IQ2S_GRID_HI); }
        eger YKN_CUDA_IQ2S_ACT_DEVICE != 0 { cuda_buffer_free(YKN_CUDA_CONTEXT_PTR, YKN_CUDA_IQ2S_ACT_DEVICE); }
        eger YKN_CUDA_IQ2S_OUT_DEVICE != 0 { cuda_buffer_free(YKN_CUDA_CONTEXT_PTR, YKN_CUDA_IQ2S_OUT_DEVICE); }
        degisken cache_i: tamsayi = 0;
        dongu cache_i < YKN_CUDA_IQ2S_WEIGHT_CACHE_COUNT {
            cuda_buffer_free(YKN_CUDA_CONTEXT_PTR, YKN_CUDA_IQ2S_WEIGHT_CACHE_PTRS[cache_i]);
            cache_i = cache_i + 1;
        }
        degisken q1_cache_i: tamsayi = 0;
        dongu q1_cache_i < YKN_CUDA_Q1_WEIGHT_CACHE_COUNT {
            cuda_buffer_free(YKN_CUDA_CONTEXT_PTR, YKN_CUDA_Q1_WEIGHT_CACHE_PTRS[q1_cache_i]);
            q1_cache_i = q1_cache_i + 1;
        }
        eger YKN_CUDA_Q1_ACT_DEVICE != 0 { cuda_buffer_free(YKN_CUDA_CONTEXT_PTR, YKN_CUDA_Q1_ACT_DEVICE); }
        eger YKN_CUDA_Q1_OUT_DEVICE != 0 { cuda_buffer_free(YKN_CUDA_CONTEXT_PTR, YKN_CUDA_Q1_OUT_DEVICE); }
        eger YKN_CUDA_F16_WEIGHT_DEVICE != 0 { cuda_buffer_free(YKN_CUDA_CONTEXT_PTR, YKN_CUDA_F16_WEIGHT_DEVICE); }
        eger YKN_CUDA_F16_ACT_DEVICE != 0 { cuda_buffer_free(YKN_CUDA_CONTEXT_PTR, YKN_CUDA_F16_ACT_DEVICE); }
        eger YKN_CUDA_F16_OUT_DEVICE != 0 { cuda_buffer_free(YKN_CUDA_CONTEXT_PTR, YKN_CUDA_F16_OUT_DEVICE); }
        eger YKN_CUDA_LMHEAD_DEVICE != 0 { cuda_buffer_free(YKN_CUDA_CONTEXT_PTR, YKN_CUDA_LMHEAD_DEVICE); }
        eger YKN_CUDA_RECENT_DEVICE != 0 { cuda_buffer_free(YKN_CUDA_CONTEXT_PTR, YKN_CUDA_RECENT_DEVICE); }
        eger YKN_CUDA_ARGMAX_OUT_DEVICE != 0 { cuda_buffer_free(YKN_CUDA_CONTEXT_PTR, YKN_CUDA_ARGMAX_OUT_DEVICE); }
        cuda_driver_close(YKN_CUDA_CONTEXT_PTR);
        os_bellek_serbest(YKN_CUDA_CONTEXT_PTR);
    }
    YKN_CUDA_IQ2S_GRID_LO = 0; YKN_CUDA_IQ2S_GRID_HI = 0;
    YKN_CUDA_IQ2S_ACT_DEVICE = 0; YKN_CUDA_IQ2S_ACT_CAPACITY = 0;
    YKN_CUDA_IQ2S_OUT_DEVICE = 0; YKN_CUDA_IQ2S_OUT_CAPACITY = 0;
    YKN_CUDA_IQ2S_WEIGHT_CACHE_COUNT = 0;
    YKN_CUDA_Q1_WEIGHT_CACHE_COUNT = 0;
    YKN_CUDA_Q1_ACT_DEVICE = 0; YKN_CUDA_Q1_ACT_CAPACITY = 0;
    YKN_CUDA_Q1_OUT_DEVICE = 0; YKN_CUDA_Q1_OUT_CAPACITY = 0;
    YKN_CUDA_F16_WEIGHT_DEVICE = 0; YKN_CUDA_F16_WEIGHT_CAPACITY = 0;
    YKN_CUDA_F16_ACT_DEVICE = 0; YKN_CUDA_F16_ACT_CAPACITY = 0;
    YKN_CUDA_F16_OUT_DEVICE = 0; YKN_CUDA_F16_OUT_CAPACITY = 0;
    YKN_CUDA_LMHEAD_DEVICE = 0; YKN_CUDA_LMHEAD_OFFSET = 0; YKN_CUDA_LMHEAD_BYTES = 0; YKN_CUDA_LMHEAD_SCALE = 0;
    YKN_CUDA_RECENT_DEVICE = 0; YKN_CUDA_ARGMAX_OUT_DEVICE = 0;
    YKN_CUDA_CONTEXT_PTR = 0;
    YKN_CUDA_HIDDEN_ON_GPU = 0;
    YKN_CUDA_ATTN_ON_GPU = 0;
    YKN_CUDA_KV_K_DEVICE = 0; YKN_CUDA_KV_V_DEVICE = 0; YKN_CUDA_KV_CAPACITY_BYTES = 0;
    YKN_CUDA_ROPE_COS_DEVICE = 0; YKN_CUDA_ROPE_SIN_DEVICE = 0; YKN_CUDA_ROPE_CAPACITY_BYTES = 0;
    YKN_CUDA_READY = 0;
}

# Standard GGML IQ2_S block decoder: each 256-weight block contains d, qs,
# qh, and scales. Grid words are uploaded once and shared by all matvecs.
isv ykn_cuda_i2s_ptx() -> *u8 { dondu ".version 8.0\n.target sm_52\n.address_size 64\n.shared .align 8 .b8 shared_mem[1024];\n.visible .entry ykn_i2s_matvec(.param .u64 pW,.param .u64 pX,.param .u64 pY,.param .u64 pGL,.param .u64 pGH,.param .u32 pK,.param .u32 pN){.reg .pred %p<16>; .reg .b32 %r<40>; .reg .b64 %rd<12>; .reg .s64 %s<12>; ld.param.u64 %rd0,[pW]; ld.param.u64 %rd1,[pX]; ld.param.u64 %rd2,[pY]; ld.param.u64 %rd3,[pGL]; ld.param.u64 %rd4,[pGH]; ld.param.u32 %r0,[pK]; ld.param.u32 %r1,[pN]; mov.u32 %r5,%ctaid.x; setp.ge.u32 %p0,%r5,%r1; @%p0 bra DONE; shr.u32 %r6,%r0,8; mul.lo.u32 %r7,%r5,%r6; mov.u32 %r39,82; mul.lo.u32 %r7,%r7,%r39; mov.s64 %s0,0; mov.u32 %r8,%tid.x; LOOP: setp.ge.u32 %p1,%r8,%r0; @%p1 bra STORE; shr.u32 %r9,%r8,8; and.b32 %r10,%r8,255; shr.u32 %r11,%r10,5; and.b32 %r12,%r10,31; shr.u32 %r13,%r12,3; and.b32 %r14,%r12,7; mov.u32 %r39,82; mul.lo.u32 %r15,%r9,%r39; add.u32 %r15,%r15,%r7; cvt.u64.u32 %rd5,%r15; add.u64 %rd5,%rd0,%rd5; ld.global.u16 %r16,[%rd5]; shr.u32 %r17,%r16,10; and.b32 %r17,%r17,31; and.b32 %r18,%r16,1023; mov.s32 %r19,0; setp.eq.u32 %p2,%r17,0; @%p2 bra HALF_READY; setp.eq.u32 %p3,%r17,31; @%p3 bra HALF_READY; add.u32 %r18,%r18,1024; shl.b32 %r18,%r18,6; sub.s32 %r20,%r17,15; setp.ge.s32 %p4,%r20,0; @%p4 bra HALF_LEFT; neg.s32 %r20,%r20; HALF_RIGHT: setp.le.s32 %p5,%r20,0; @%p5 bra HALF_SIGN; shr.u32 %r18,%r18,1; sub.s32 %r20,%r20,1; bra HALF_RIGHT; HALF_LEFT: setp.le.s32 %p6,%r20,0; @%p6 bra HALF_SIGN; shl.b32 %r18,%r18,1; sub.s32 %r20,%r20,1; bra HALF_LEFT; HALF_SIGN: shr.u32 %r20,%r16,15; setp.eq.u32 %p7,%r20,0; @%p7 bra HALF_READY; neg.s32 %r18,%r18; HALF_READY: mov.s32 %r19,%r18; mul.lo.u32 %r20,%r11,4; add.u32 %r21,%r15,2; add.u32 %r21,%r21,%r20; add.u32 %r21,%r21,%r13; cvt.u64.u32 %rd6,%r21; add.u64 %rd6,%rd5,%rd6; ld.global.u8 %r22,[%rd6]; and.b32 %r22,%r22,255; add.u32 %r23,%r15,66; add.u32 %r23,%r23,%r11; cvt.u64.u32 %rd7,%r23; add.u64 %rd7,%rd5,%rd7; ld.global.u8 %r24,[%rd7]; and.b32 %r24,%r24,255; mov.u32 %r25,8; shl.b32 %r25,%r25,0; shl.b32 %r26,%r13,1; mov.u32 %r27,8; sub.u32 %r27,%r27,%r26; shl.b32 %r24,%r24,%r27; and.b32 %r24,%r24,768; add.u32 %r28,%r22,%r24; shl.b32 %r29,%r28,3; cvt.u64.u32 %rd8,%r29; and.b32 %r29,%r14,4; setp.eq.u32 %p8,%r29,0; @%p8 bra GRID_LOW; add.u64 %rd9,%rd4,%rd8; bra GRID_LOAD; GRID_LOW: add.u64 %rd9,%rd3,%rd8; GRID_LOAD: ld.global.u64 %rd10,[%rd9]; and.b32 %r30,%r14,3; shl.b32 %r30,%r30,3; shr.u64 %rd10,%rd10,%r30; and.b64 %rd10,%rd10,255; cvt.u32.u64 %r31,%rd10; add.u32 %r32,%r15,34; add.u32 %r32,%r32,%r20; add.u32 %r32,%r32,%r13; cvt.u64.u32 %rd11,%r32; add.u64 %rd11,%rd5,%rd11; ld.global.u8 %r33,[%rd11]; and.b32 %r33,%r33,255; shr.u32 %r34,%r33,%r14; and.b32 %r34,%r34,1; add.u32 %r35,%r15,74; add.u32 %r35,%r35,%r11; cvt.u64.u32 %rd11,%r35; add.u64 %rd11,%rd5,%rd11; ld.global.u8 %r36,[%rd11]; and.b32 %r36,%r36,255; shr.u32 %r37,%r36,0; and.b32 %r38,%r12,16; setp.eq.u32 %p9,%r38,0; @%p9 bra SCALE_NIBBLE; shr.u32 %r37,%r36,4; SCALE_NIBBLE: and.b32 %r37,%r37,15; shl.b32 %r38,%r37,1; add.u32 %r38,%r38,1; mul.lo.s32 %r39,%r19,%r38; shr.s32 %r39,%r39,3; mul.lo.s32 %r39,%r39,%r31; shr.s32 %r39,%r39,5; setp.eq.u32 %p10,%r34,0; @%p10 bra WEIGHT_SIGN; neg.s32 %r39,%r39; WEIGHT_SIGN: cvt.s64.s32 %s1,%r39; shl.b32 %r9,%r8,3; cvt.u64.u32 %rd11,%r9; add.u64 %rd11,%rd1,%rd11; ld.global.s64 %s3,[%rd11]; mul.lo.s64 %s4,%s3,%s1; add.s64 %s0,%s0,%s4; add.u32 %r8,%r8,128; bra LOOP; STORE: mov.u32 %r9,%tid.x; shl.b32 %r8,%r9,3; mov.u32 %r11,shared_mem; cvt.u64.u32 %rd11,%r11; cvt.u64.u32 %rd10,%r8; add.u64 %rd11,%rd11,%rd10; st.shared.s64 [%rd11],%s0; bar.sync 0; setp.ne.u32 %p11,%r9,0; @%p11 bra DONE; mov.s64 %s0,0; mov.u32 %r8,0; REDUCE: setp.ge.u32 %p12,%r8,128; @%p12 bra REDUCED; shl.b32 %r9,%r8,3; mov.u32 %r11,shared_mem; cvt.u64.u32 %rd11,%r11; cvt.u64.u32 %rd10,%r9; add.u64 %rd11,%rd11,%rd10; ld.shared.s64 %s1,[%rd11]; add.s64 %s0,%s0,%s1; add.u32 %r8,%r8,1; bra REDUCE; REDUCED: div.s64 %s0,%s0,65536; shl.b32 %r9,%r5,3; cvt.u64.u32 %rd11,%r9; add.u64 %rd11,%rd2,%rd11; st.global.s64 [%rd11],%s0; DONE: ret;}\n".ptr; }

# Q1_0 blocks are 128 values: f16 scale followed by 128 sign bits.
# Optimized: scale decoded once per 128-element block, div.s64 replaced with fast shift.
isv ykn_cuda_q1_ptx() -> *u8 { dondu ".version 8.0\n.target sm_52\n.address_size 64\n.visible .entry ykn_q1_matvec(.param .u64 pW,.param .u64 pX,.param .u64 pY,.param .u32 pK,.param .u32 pN){\n.reg .pred %p<12>;\n.reg .b32 %r<32>;\n.reg .b64 %rd<10>;\n.reg .s64 %s<8>;\nld.param.u64 %rd0,[pW];\nld.param.u64 %rd1,[pX];\nld.param.u64 %rd2,[pY];\nld.param.u32 %r0,[pK];\nld.param.u32 %r1,[pN];\nmov.u32 %r2,%ctaid.x;\nmov.u32 %r3,%ntid.x;\nmov.u32 %r4,%tid.x;\nmad.lo.u32 %r5,%r2,%r3,%r4;\nsetp.ge.u32 %p0,%r5,%r1;\n@%p0 bra DONE;\nshr.u32 %r6,%r0,7;\nmul.lo.u32 %r7,%r6,18;\nmul.lo.u32 %r7,%r5,%r7;\nmov.s64 %s0,0;\nmov.u32 %r8,0;\nBLOCK_LOOP:\nsetp.ge.u32 %p1,%r8,%r6;\n@%p1 bra STORE;\nmul.lo.u32 %r9,%r8,18;\nadd.u32 %r9,%r9,%r7;\ncvt.u64.u32 %rd3,%r9;\nadd.u64 %rd3,%rd0,%rd3;\nld.global.u8 %r10,[%rd3];\nld.global.u8 %r11,[%rd3+1];\nand.b32 %r10,%r10,255;\nand.b32 %r11,%r11,255;\nshl.b32 %r11,%r11,8;\nor.b32 %r12,%r10,%r11;\nshr.u32 %r13,%r12,10;\nand.b32 %r13,%r13,31;\nand.b32 %r14,%r12,1023;\nsetp.eq.u32 %p2,%r13,0;\n@%p2 bra HALF_SUB;\nsetp.eq.u32 %p3,%r13,31;\n@%p3 bra HALF_ZERO;\nadd.u32 %r14,%r14,1024;\nshl.b32 %r14,%r14,6;\nsub.s32 %r15,%r13,15;\nsetp.ge.s32 %p4,%r15,0;\n@%p4 bra HALF_LEFT;\nneg.s32 %r15,%r15;\nHALF_RIGHT_LOOP:\nsetp.le.s32 %p5,%r15,0;\n@%p5 bra HALF_SIGN;\nshr.u32 %r14,%r14,1;\nsub.s32 %r15,%r15,1;\nbra HALF_RIGHT_LOOP;\nHALF_LEFT:\nHALF_LEFT_LOOP:\nsetp.le.s32 %p6,%r15,0;\n@%p6 bra HALF_SIGN;\nshl.b32 %r14,%r14,1;\nsub.s32 %r15,%r15,1;\nbra HALF_LEFT_LOOP;\nHALF_SUB:\nshr.u32 %r14,%r14,8;\nbra HALF_SIGN;\nHALF_ZERO:\nmov.u32 %r14,0;\nHALF_SIGN:\nshr.u32 %r15,%r12,15;\nsetp.eq.u32 %p7,%r15,0;\n@%p7 bra HALF_READY;\nneg.s32 %r14,%r14;\nHALF_READY:\ncvt.s64.s32 %s1,%r14;\nshl.b32 %r16,%r8,7;\nmov.u32 %r17,0;\nBYTE_LOOP:\nsetp.ge.u32 %p8,%r17,16;\n@%p8 bra NEXT_BLOCK;\nadd.u32 %r18,%r17,2;\ncvt.u64.u32 %rd4,%r18;\nadd.u64 %rd4,%rd3,%rd4;\nld.global.u8 %r19,[%rd4];\nand.b32 %r19,%r19,255;\nmov.u32 %r20,0;\nBIT_LOOP:\nsetp.ge.u32 %p9,%r20,8;\n@%p9 bra NEXT_BYTE;\nshl.b32 %r21,%r17,3;\nadd.u32 %r21,%r21,%r20;\nadd.u32 %r21,%r21,%r16;\nshl.b32 %r22,%r21,3;\ncvt.u64.u32 %rd5,%r22;\nadd.u64 %rd5,%rd1,%rd5;\nld.global.s64 %s2,[%rd5];\nmul.lo.s64 %s3,%s2,%s1;\nsetp.ge.s64 %p10,%s3,0;\n@%p10 shr.s64 %s4,%s3,16;\n@!%p10 neg.s64 %s5,%s3;\n@!%p10 shr.s64 %s5,%s5,16;\n@!%p10 neg.s64 %s4,%s5;\nshr.u32 %r23,%r19,%r20;\nand.b32 %r23,%r23,1;\nsetp.eq.u32 %p11,%r23,1;\n@%p11 bra ACCUM_POS;\nneg.s64 %s4,%s4;\nACCUM_POS:\nadd.s64 %s0,%s0,%s4;\nadd.u32 %r20,%r20,1;\nbra BIT_LOOP;\nNEXT_BYTE:\nadd.u32 %r17,%r17,1;\nbra BYTE_LOOP;\nNEXT_BLOCK:\nadd.u32 %r8,%r8,1;\nbra BLOCK_LOOP;\nSTORE:\nshl.b32 %r24,%r5,3;\ncvt.u64.u32 %rd6,%r24;\nadd.u64 %rd6,%rd2,%rd6;\nst.global.s64 [%rd6],%s0;\nDONE:\nret;\n}\n".ptr; }

# packed is N contiguous IQ2_S rows; each K=256 block occupies 82 bytes.
isv ykn_cuda_i2s_matvec(packed: *u8, activation: *tamsayi,
                        output: *tamsayi, K: tamsayi, N: tamsayi,
                        packed_bytes: tamsayi, cache_key: tamsayi) -> tamsayi {
    YKN_CUDA_LAST_ERROR = CUDA_SUCCESS;
    eger YKN_CUDA_READY != 1 veya packed == 0 veya activation == 0 veya
       output == 0 veya K <= 0 veya K > 65536 veya K % 256 != 0 veya N <= 0 or
       packed_bytes != N * (K / 256) * 82 ise {
        YKN_CUDA_LAST_ERROR = CUDA_ERROR_BAD_ARGUMENT;
        dondu 0;
    }
    eger YKN_CUDA_IQ2S_GRID_LO == 0 veya YKN_CUDA_IQ2S_GRID_HI == 0 ise {
        bitnet_iq2s_grid_baslat();
        degisken grid_status: tamsayi = cuda_buffer_alloc(YKN_CUDA_CONTEXT_PTR,
            1024 * 8, &YKN_CUDA_IQ2S_GRID_LO);
        eger grid_status != CUDA_SUCCESS { YKN_CUDA_LAST_ERROR = grid_status; dondu 0; }
        grid_status = cuda_buffer_alloc(YKN_CUDA_CONTEXT_PTR,
            1024 * 8, &YKN_CUDA_IQ2S_GRID_HI);
        eger grid_status != CUDA_SUCCESS {
            YKN_CUDA_LAST_ERROR = grid_status;
            cuda_buffer_free(YKN_CUDA_CONTEXT_PTR, YKN_CUDA_IQ2S_GRID_LO);
            YKN_CUDA_IQ2S_GRID_LO = 0;
            dondu 0;
        }
        grid_status = cuda_copy_to_device(YKN_CUDA_CONTEXT_PTR,
            YKN_CUDA_IQ2S_GRID_LO, IQ2S_GRID_ALT, 1024 * 8);
        eger grid_status == CUDA_SUCCESS {
            grid_status = cuda_copy_to_device(YKN_CUDA_CONTEXT_PTR,
                YKN_CUDA_IQ2S_GRID_HI, IQ2S_GRID_UST, 1024 * 8);
        }
        eger grid_status != CUDA_SUCCESS {
            YKN_CUDA_LAST_ERROR = grid_status;
            cuda_buffer_free(YKN_CUDA_CONTEXT_PTR, YKN_CUDA_IQ2S_GRID_LO);
            cuda_buffer_free(YKN_CUDA_CONTEXT_PTR, YKN_CUDA_IQ2S_GRID_HI);
            YKN_CUDA_IQ2S_GRID_LO = 0; YKN_CUDA_IQ2S_GRID_HI = 0;
            dondu 0;
        }
    }

    degisken gpu_weights: tamsayi = 0;
    degisken cache_i: tamsayi = 0;
    degisken cache_found: tamsayi = 0;
    dongu cache_i < YKN_CUDA_IQ2S_WEIGHT_CACHE_COUNT {
        eger YKN_CUDA_IQ2S_WEIGHT_CACHE_KEYS[cache_i] == cache_key and
           YKN_CUDA_IQ2S_WEIGHT_CACHE_BYTES[cache_i] == packed_bytes {
            gpu_weights = YKN_CUDA_IQ2S_WEIGHT_CACHE_PTRS[cache_i];
            cache_found = 1;
        }
        cache_i = cache_i + 1;
    }
    degisken status: tamsayi = CUDA_SUCCESS;
    eger cache_found == 0 {
        eger YKN_CUDA_IQ2S_WEIGHT_CACHE_COUNT >= 256 {
            YKN_CUDA_LAST_ERROR = CUDA_ERROR_OUT_OF_MEMORY; dondu 0;
        }
        status = cuda_buffer_alloc(YKN_CUDA_CONTEXT_PTR, packed_bytes, &gpu_weights);
        eger status != CUDA_SUCCESS { YKN_CUDA_LAST_ERROR = status; dondu 0; }
        status = cuda_copy_to_device(YKN_CUDA_CONTEXT_PTR, gpu_weights, packed, packed_bytes);
        eger status != CUDA_SUCCESS {
            YKN_CUDA_LAST_ERROR = status;
            cuda_buffer_free(YKN_CUDA_CONTEXT_PTR, gpu_weights); dondu 0;
        }
        cache_i = YKN_CUDA_IQ2S_WEIGHT_CACHE_COUNT;
        YKN_CUDA_IQ2S_WEIGHT_CACHE_KEYS[cache_i] = cache_key;
        YKN_CUDA_IQ2S_WEIGHT_CACHE_PTRS[cache_i] = gpu_weights;
        YKN_CUDA_IQ2S_WEIGHT_CACHE_BYTES[cache_i] = packed_bytes;
        YKN_CUDA_IQ2S_WEIGHT_CACHE_COUNT = cache_i + 1;
    }
    eger YKN_CUDA_IQ2S_ACT_DEVICE == 0 or YKN_CUDA_IQ2S_ACT_CAPACITY < K * 8 {
        eger YKN_CUDA_IQ2S_ACT_DEVICE != 0 { cuda_buffer_free(YKN_CUDA_CONTEXT_PTR, YKN_CUDA_IQ2S_ACT_DEVICE); }
        status = cuda_buffer_alloc(YKN_CUDA_CONTEXT_PTR, K * 8, &YKN_CUDA_IQ2S_ACT_DEVICE);
        eger status != CUDA_SUCCESS { YKN_CUDA_LAST_ERROR = status; YKN_CUDA_IQ2S_ACT_DEVICE = 0; dondu 0; }
        YKN_CUDA_IQ2S_ACT_CAPACITY = K * 8;
    }
    eger YKN_CUDA_IQ2S_OUT_DEVICE == 0 or YKN_CUDA_IQ2S_OUT_CAPACITY < N * 8 {
        eger YKN_CUDA_IQ2S_OUT_DEVICE != 0 { cuda_buffer_free(YKN_CUDA_CONTEXT_PTR, YKN_CUDA_IQ2S_OUT_DEVICE); }
        status = cuda_buffer_alloc(YKN_CUDA_CONTEXT_PTR, N * 8, &YKN_CUDA_IQ2S_OUT_DEVICE);
        eger status != CUDA_SUCCESS { YKN_CUDA_LAST_ERROR = status; YKN_CUDA_IQ2S_OUT_DEVICE = 0; dondu 0; }
        YKN_CUDA_IQ2S_OUT_CAPACITY = N * 8;
    }
    status = cuda_copy_to_device(YKN_CUDA_CONTEXT_PTR,
        YKN_CUDA_IQ2S_ACT_DEVICE, activation, K * 8);
    eger status == CUDA_SUCCESS {
        degisken params: [7]*u8;
        params[0] = &gpu_weights; params[1] = &YKN_CUDA_IQ2S_ACT_DEVICE;
        params[2] = &YKN_CUDA_IQ2S_OUT_DEVICE; params[3] = &YKN_CUDA_IQ2S_GRID_LO;
        params[4] = &YKN_CUDA_IQ2S_GRID_HI; params[5] = &K; params[6] = &N;
        degisken grid: tamsayi = N;
        status = cuda_ptx_launch_1d(YKN_CUDA_CONTEXT_PTR, ykn_cuda_i2s_ptx(),
            "ykn_i2s_matvec".ptr, params, grid, 128);
    }
    eger status == CUDA_SUCCESS {
        status = cuda_copy_to_host(YKN_CUDA_CONTEXT_PTR, output,
            YKN_CUDA_IQ2S_OUT_DEVICE, N * 8);
    }
    YKN_CUDA_LAST_ERROR = status;
    eger status != CUDA_SUCCESS { dondu 0; }
    YKN_CUDA_I2S_CALLS = YKN_CUDA_I2S_CALLS + 1;
    dondu 1;
}

