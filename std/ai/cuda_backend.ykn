isv ykn_cuda_bitnet_i2s_matvec(packed: *u8, activation: *tamsayi,
                                output: *tamsayi, K: tamsayi, N: tamsayi,
                                packed_bytes: tamsayi, cache_key: tamsayi) -> tamsayi {
    YKN_CUDA_LAST_ERROR = CUDA_SUCCESS;
    eger YKN_CUDA_READY != 1 veya activation == 0 veya
       output == 0 veya K <= 0 veya K % 128 != 0 veya N <= 0 or
       packed_bytes != N * (K / 4) + 32 {
        YKN_CUDA_LAST_ERROR = CUDA_ERROR_BAD_ARGUMENT; dondu 0;
    }
    degisken gpu_weights: tamsayi = 0;
    degisken scale_q16: tamsayi = 0;
