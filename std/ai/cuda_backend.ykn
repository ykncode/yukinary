isv ykn_cuda_f16_matvec(packed: *u8, activation: *tamsayi,
                         output: *tamsayi, K: tamsayi, N: tamsayi,
                         packed_bytes: tamsayi) -> tamsayi {
    YKN_CUDA_LAST_ERROR = CUDA_SUCCESS;
    eger YKN_CUDA_READY != 1 veya packed == 0 veya activation == 0 veya
       output == 0 veya K <= 0 veya N <= 0 veya K > 1048576 veya N > 1048576 veya
       packed_bytes < K * N * 2 {
        YKN_CUDA_LAST_ERROR = CUDA_ERROR_BAD_ARGUMENT; dondu 0;
    }
    degisken status: tamsayi = CUDA_SUCCESS;
    eger YKN_CUDA_F16_WEIGHT_DEVICE == 0 veya YKN_CUDA_F16_WEIGHT_CAPACITY < packed_bytes {
        eger YKN_CUDA_F16_WEIGHT_DEVICE != 0 { cuda_buffer_free(YKN_CUDA_CONTEXT_PTR, YKN_CUDA_F16_WEIGHT_DEVICE); }
        status = cuda_buffer_alloc(YKN_CUDA_CONTEXT_PTR, packed_bytes, &YKN_CUDA_F16_WEIGHT_DEVICE);
        eger status != CUDA_SUCCESS { YKN_CUDA_LAST_ERROR = status; dondu 0; }
        YKN_CUDA_F16_WEIGHT_CAPACITY = packed_bytes;
    }
    eger YKN_CUDA_F16_ACT_DEVICE == 0 veya YKN_CUDA_F16_ACT_CAPACITY < K * 8 {
        eger YKN_CUDA_F16_ACT_DEVICE != 0 { cuda_buffer_free(YKN_CUDA_CONTEXT_PTR, YKN_CUDA_F16_ACT_DEVICE); }
        status = cuda_buffer_alloc(YKN_CUDA_CONTEXT_PTR, K * 8, &YKN_CUDA_F16_ACT_DEVICE);
        eger status != CUDA_SUCCESS { YKN_CUDA_LAST_ERROR = status; dondu 0; }
        YKN_CUDA_F16_ACT_CAPACITY = K * 8;
    }
    eger YKN_CUDA_F16_OUT_DEVICE == 0 veya YKN_CUDA_F16_OUT_CAPACITY < N * 8 {
        eger YKN_CUDA_F16_OUT_DEVICE != 0 { cuda_buffer_free(YKN_CUDA_CONTEXT_PTR, YKN_CUDA_F16_OUT_DEVICE); }
        status = cuda_buffer_alloc(YKN_CUDA_CONTEXT_PTR, N * 8, &YKN_CUDA_F16_OUT_DEVICE);
        eger status != CUDA_SUCCESS { YKN_CUDA_LAST_ERROR = status; dondu 0; }
        YKN_CUDA_F16_OUT_CAPACITY = N * 8;
    }
    status = cuda_copy_to_device(YKN_CUDA_CONTEXT_PTR, YKN_CUDA_F16_WEIGHT_DEVICE, packed, packed_bytes);
    eger status == CUDA_SUCCESS { status = cuda_copy_to_device(YKN_CUDA_CONTEXT_PTR, YKN_CUDA_F16_ACT_DEVICE, activation, K * 8); }
    eger status == CUDA_SUCCESS {
        degisken params: [5]*u8;
        params[0] = &YKN_CUDA_F16_WEIGHT_DEVICE; params[1] = &YKN_CUDA_F16_ACT_DEVICE;
        params[2] = &YKN_CUDA_F16_OUT_DEVICE; params[3] = &K; params[4] = &N;
        status = cuda_kernel_launch_1d(YKN_CUDA_CONTEXT_PTR, G_KER_F16,
            params, (N + 31) / 32, 128);
    }
    ekrana_yaz("[F16 MATVEC RET]: ".ptr);
    eger status == 0 { ekrana_yaz("0
".ptr); } yoksa { ekrana_yaz("ERR
".ptr); }
    ekrana_yaz("[F16 STATUS 2 MATVEC]: ".ptr);
    eger status == 0 { ekrana_yaz("OK
".ptr); } yoksa { ekrana_yaz("ERR
".ptr); }
    eger status == CUDA_SUCCESS { status = cuda_copy_to_host(YKN_CUDA_CONTEXT_PTR, output, YKN_CUDA_F16_OUT_DEVICE, N * 8); }
    YKN_CUDA_LAST_ERROR = status;
    eger status != CUDA_SUCCESS { dondu 0; }
    dondu 1;
}

isv ykn_cuda_f16_matvec_device(gpu_weights: tamsayi, activation: *tamsayi,
                               output: *tamsayi, K: tamsayi, N: tamsayi) -> tamsayi {
    YKN_CUDA_LAST_ERROR = CUDA_SUCCESS;
    eger YKN_CUDA_READY != 1 veya gpu_weights == 0 veya activation == 0 veya
       output == 0 veya K <= 0 veya N <= 0 {
        YKN_CUDA_LAST_ERROR = CUDA_ERROR_BAD_ARGUMENT; dondu 0;
    }
    degisken status: tamsayi = CUDA_SUCCESS;
    eger YKN_CUDA_F16_ACT_DEVICE == 0 veya YKN_CUDA_F16_ACT_CAPACITY < K * 8 {
        eger YKN_CUDA_F16_ACT_DEVICE != 0 { cuda_buffer_free(YKN_CUDA_CONTEXT_PTR, YKN_CUDA_F16_ACT_DEVICE); }
        status = cuda_buffer_alloc(YKN_CUDA_CONTEXT_PTR, K * 8, &YKN_CUDA_F16_ACT_DEVICE);
        eger status != CUDA_SUCCESS { YKN_CUDA_LAST_ERROR = status; dondu 0; }
        YKN_CUDA_F16_ACT_CAPACITY = K * 8;
    }
    eger YKN_CUDA_F16_OUT_DEVICE == 0 veya YKN_CUDA_F16_OUT_CAPACITY < N * 8 {
        eger YKN_CUDA_F16_OUT_DEVICE != 0 { cuda_buffer_free(YKN_CUDA_CONTEXT_PTR, YKN_CUDA_F16_OUT_DEVICE); }
        status = cuda_buffer_alloc(YKN_CUDA_CONTEXT_PTR, N * 8, &YKN_CUDA_F16_OUT_DEVICE);
        eger status != CUDA_SUCCESS { YKN_CUDA_LAST_ERROR = status; dondu 0; }
        YKN_CUDA_F16_OUT_CAPACITY = N * 8;
    }
    # degisken t_sync0: tamsayi = ykn_llm_clock_ns();
    # cuda_ctx_synchronize(YKN_CUDA_CONTEXT_PTR);
    # degisken t_sync1: tamsayi = ykn_llm_clock_ns();
    # G_TIME_NORM_NS = G_TIME_NORM_NS + (t_sync1 - t_sync0);
    degisken t_f16_0: tamsayi = ykn_llm_clock_ns();
    eger activation != 0 {
        status = cuda_copy_to_device(YKN_CUDA_CONTEXT_PTR, YKN_CUDA_F16_ACT_DEVICE, activation, K * 8);
    }
    ekrana_yaz("[F16 STATUS 1]: ".ptr);
    eger status == 0 { ekrana_yaz("OK
".ptr); } yoksa { ekrana_yaz("ERR
".ptr); }
    eger status == CUDA_SUCCESS {
        degisken params: [5]*u8;
        params[0] = &gpu_weights; params[1] = &YKN_CUDA_F16_ACT_DEVICE;
        params[2] = &YKN_CUDA_F16_OUT_DEVICE; params[3] = &K; params[4] = &N;
        status = cuda_kernel_launch_1d(YKN_CUDA_CONTEXT_PTR, G_KER_F16,
            params, (N + 31) / 32, 128);
    }
    eger status == CUDA_SUCCESS {
        status = cuda_copy_to_host(YKN_CUDA_CONTEXT_PTR, output, YKN_CUDA_F16_OUT_DEVICE, N * 8);
    }
    degisken t_f16_1: tamsayi = ykn_llm_clock_ns();
    YKN_CUDA_F16_GPU_NS = YKN_CUDA_F16_GPU_NS + (t_f16_1 - t_f16_0);
    YKN_CUDA_LAST_ERROR = status;
    eger status != CUDA_SUCCESS { dondu 0; }
    YKN_CUDA_F16_CALLS = YKN_CUDA_F16_CALLS + 1;
    dondu 1;
}

isv ykn_cuda_argmax_ptx() -> *u8 {
    dondu ".version 8.0\n.target sm_52\n.address_size 64\n.visible .entry ykn_logits_rep_argmax(.param .u64 pLogits,.param .u32 pN,.param .u64 pRecent,.param .u32 pRecentCount,.param .u32 pPenalty,.param .u64 pOut){\n.shared .align 8 .s64 sh_val[8];\n.shared .align 4 .s32 sh_idx[8];\n.reg .pred %p<12>;\n.reg .b32 %r<25>;\n.reg .b64 %rd<20>;\n.reg .s64 %s<20>,%max_val,%cur_val;\n.reg .s32 %max_idx,%cur_idx;\nld.param.u64 %rd0,[pLogits];\nld.param.u32 %r0,[pN];\nld.param.u64 %rd1,[pRecent];\nld.param.u32 %r1,[pRecentCount];\nld.param.u32 %r2,[pPenalty];\nld.param.u64 %rd2,[pOut];\nmov.u32 %r3,%tid.x;\nsetp.ne.u32 %p0,%r3,0;\n@%p0 bra SKIP_PENALTY;\nsetp.le.u32 %p1,%r2,65536;\n@%p1 bra SKIP_PENALTY;\nsetp.eq.u32 %p2,%r1,0;\n@%p2 bra SKIP_PENALTY;\nmov.u32 %r4,0;\nPENALTY_LOOP:\nsetp.ge.u32 %p3,%r4,%r1;\n@%p3 bra SKIP_PENALTY;\nshl.b32 %r5,%r4,3;\ncvt.u64.u32 %rd3,%r5;\nadd.u64 %rd4,%rd1,%rd3;\nld.global.s64 %s0,[%rd4];\nsetp.lt.s64 %p4,%s0,0;\n@%p4 bra NEXT_PENALTY;\ncvt.u32.s64 %r6,%s0;\nsetp.ge.u32 %p5,%r6,%r0;\n@%p5 bra NEXT_PENALTY;\nshl.b32 %r7,%r6,3;\ncvt.u64.u32 %rd5,%r7;\nadd.u64 %rd6,%rd0,%rd5;\nld.global.s64 %s1,[%rd6];\nsetp.gt.s64 %p6,%s1,0;\n@!%p6 bra NEG_PENALTY;\nshl.b64 %s2,%s1,16;\ncvt.u64.u32 %rd7,%r2;\ndiv.s64 %s1,%s2,%rd7;\nbra STORE_PENALTY;\nNEG_PENALTY:\ncvt.u64.u32 %rd7,%r2;\nmul.lo.s64 %s2,%s1,%rd7;\nshr.s64 %s1,%s2,16;\nSTORE_PENALTY:\nst.global.s64 [%rd6],%s1;\nNEXT_PENALTY:\nadd.u32 %r4,%r4,1;\nbra PENALTY_LOOP;\nSKIP_PENALTY:\nbar.sync 0;\nmov.b64 %max_val,0x8000000000000000;\nmov.s32 %max_idx,0;\nmov.u32 %cur_idx,%r3;\nSEARCH_LOOP:\nsetp.ge.u32 %p7,%cur_idx,%r0;\n@%p7 bra FINISH_SEARCH;\nshl.b32 %r8,%cur_idx,3;\ncvt.u64.u32 %rd8,%r8;\nadd.u64 %rd9,%rd0,%rd8;\nld.global.s64 %cur_val,[%rd9];\nsetp.gt.s64 %p8,%cur_val,%max_val;\n@%p8 mov.s64 %max_val,%cur_val;\n@%p8 mov.s32 %max_idx,%cur_idx;\nadd.u32 %cur_idx,%cur_idx,256;\nbra SEARCH_LOOP;\nFINISH_SEARCH:\nshfl.sync.down.b32 %r10,%max_idx,16,31,0xffffffff;\nmov.b64 {%r11,%r12},%max_val;\nshfl.sync.down.b32 %r13,%r11,16,31,0xffffffff;\nshfl.sync.down.b32 %r14,%r12,16,31,0xffffffff;\nmov.b64 %s3,{%r13,%r14};\nsetp.gt.s64 %p9,%s3,%max_val;\n@%p9 mov.s64 %max_val,%s3;\n@%p9 mov.s32 %max_idx,%r10;\nshfl.sync.down.b32 %r10,%max_idx,8,31,0xffffffff;\nmov.b64 {%r11,%r12},%max_val;\nshfl.sync.down.b32 %r13,%r11,8,31,0xffffffff;\nshfl.sync.down.b32 %r14,%r12,8,31,0xffffffff;\nmov.b64 %s3,{%r13,%r14};\nsetp.gt.s64 %p9,%s3,%max_val;\n@%p9 mov.s64 %max_val,%s3;\n@%p9 mov.s32 %max_idx,%r10;\nshfl.sync.down.b32 %r10,%max_idx,4,31,0xffffffff;\nmov.b64 {%r11,%r12},%max_val;\nshfl.sync.down.b32 %r13,%r11,4,31,0xffffffff;\nshfl.sync.down.b32 %r14,%r12,4,31,0xffffffff;\nmov.b64 %s3,{%r13,%r14};\nsetp.gt.s64 %p9,%s3,%max_val;\n@%p9 mov.s64 %max_val,%s3;\n@%p9 mov.s32 %max_idx,%r10;\nshfl.sync.down.b32 %r10,%max_idx,2,31,0xffffffff;\nmov.b64 {%r11,%r12},%max_val;\nshfl.sync.down.b32 %r13,%r11,2,31,0xffffffff;\nshfl.sync.down.b32 %r14,%r12,2,31,0xffffffff;\nmov.b64 %s3,{%r13,%r14};\nsetp.gt.s64 %p9,%s3,%max_val;\n@%p9 mov.s64 %max_val,%s3;\n@%p9 mov.s32 %max_idx,%r10;\nshfl.sync.down.b32 %r10,%max_idx,1,31,0xffffffff;\nmov.b64 {%r11,%r12},%max_val;\nshfl.sync.down.b32 %r13,%r11,1,31,0xffffffff;\nshfl.sync.down.b32 %r14,%r12,1,31,0xffffffff;\nmov.b64 %s3,{%r13,%r14};\nsetp.gt.s64 %p9,%s3,%max_val;\n@%p9 mov.s64 %max_val,%s3;\n@%p9 mov.s32 %max_idx,%r10;\nand.b32 %r15,%r3,31;\nshr.u32 %r16,%r3,5;\nsetp.ne.u32 %p10,%r15,0;\n@%p10 bra WAIT_WARPS;\nshl.b32 %r17,%r16,3;\nmov.u32 %r18,sh_val;\nadd.u32 %r18,%r18,%r17;\nst.shared.s64 [%r18],%max_val;\nshl.b32 %r19,%r16,2;\nmov.u32 %r20,sh_idx;\nadd.u32 %r20,%r20,%r19;\nst.shared.s32 [%r20],%max_idx;\nWAIT_WARPS:\nbar.sync 1;\nsetp.ne.u32 %p11,%r16,0;\n@%p11 bra EXIT;\nsetp.ge.u32 %p10,%r15,8;\n@%p10 mov.b64 %max_val,0x8000000000000000;\n@%p10 mov.s32 %max_idx,0;\n@!%p10 shl.b32 %r17,%r15,3;\n@!%p10 mov.u32 %r18,sh_val;\n@!%p10 add.u32 %r18,%r18,%r17;\n@!%p10 ld.shared.s64 %max_val,[%r18];\n@!%p10 shl.b32 %r19,%r15,2;\n@!%p10 mov.u32 %r20,sh_idx;\n@!%p10 add.u32 %r20,%r20,%r19;\n@!%p10 ld.shared.s32 %max_idx,[%r20];\nshfl.sync.down.b32 %r10,%max_idx,4,31,0xffffffff;\nmov.b64 {%r11,%r12},%max_val;\nshfl.sync.down.b32 %r13,%r11,4,31,0xffffffff;\nshfl.sync.down.b32 %r14,%r12,4,31,0xffffffff;\nmov.b64 %s3,{%r13,%r14};\nsetp.gt.s64 %p9,%s3,%max_val;\n@%p9 mov.s64 %max_val,%s3;\n@%p9 mov.s32 %max_idx,%r10;\nshfl.sync.down.b32 %r10,%max_idx,2,31,0xffffffff;\nmov.b64 {%r11,%r12},%max_val;\nshfl.sync.down.b32 %r13,%r11,2,31,0xffffffff;\nshfl.sync.down.b32 %r14,%r12,2,31,0xffffffff;\nmov.b64 %s3,{%r13,%r14};\nsetp.gt.s64 %p9,%s3,%max_val;\n@%p9 mov.s64 %max_val,%s3;\n@%p9 mov.s32 %max_idx,%r10;\nshfl.sync.down.b32 %r10,%max_idx,1,31,0xffffffff;\nmov.b64 {%r11,%r12},%max_val;\nshfl.sync.down.b32 %r13,%r11,1,31,0xffffffff;\nshfl.sync.down.b32 %r14,%r12,1,31,0xffffffff;\nmov.b64 %s3,{%r13,%r14};\nsetp.gt.s64 %p9,%s3,%max_val;\n@%p9 mov.s64 %max_val,%s3;\n@%p9 mov.s32 %max_idx,%r10;\nsetp.ne.u32 %p2,%r15,0;\n@%p2 bra EXIT;\ncvt.s64.s32 %s4,%max_idx;\nst.global.s64 [%rd2],%s4;\nEXIT:\nret;\n}\n".ptr;
}

isv ykn_cuda_f16_matvec_device_argmax(gpu_weights: tamsayi, activation: *tamsayi,
                                      K: tamsayi, N: tamsayi,
                                      recent_tokens: *tamsayi, recent_count: tamsayi,
                                      penalty_q16: tamsayi, out_token: *tamsayi) -> tamsayi {
    YKN_CUDA_LAST_ERROR = CUDA_SUCCESS;
    eger YKN_CUDA_READY != 1 veya gpu_weights == 0 veya
       out_token == 0 veya K <= 0 veya N <= 0 {
        YKN_CUDA_LAST_ERROR = CUDA_ERROR_BAD_ARGUMENT; dondu 0;
    }
    degisken status: tamsayi = CUDA_SUCCESS;
    eger YKN_CUDA_F16_ACT_DEVICE == 0 veya YKN_CUDA_F16_ACT_CAPACITY < K * 8 {
        eger YKN_CUDA_F16_ACT_DEVICE != 0 { cuda_buffer_free(YKN_CUDA_CONTEXT_PTR, YKN_CUDA_F16_ACT_DEVICE); }
        status = cuda_buffer_alloc(YKN_CUDA_CONTEXT_PTR, K * 8, &YKN_CUDA_F16_ACT_DEVICE);
        eger status != CUDA_SUCCESS { YKN_CUDA_LAST_ERROR = status; dondu 0; }
        YKN_CUDA_F16_ACT_CAPACITY = K * 8;
    }
    eger YKN_CUDA_F16_OUT_DEVICE == 0 veya YKN_CUDA_F16_OUT_CAPACITY < N * 8 {
        eger YKN_CUDA_F16_OUT_DEVICE != 0 { cuda_buffer_free(YKN_CUDA_CONTEXT_PTR, YKN_CUDA_F16_OUT_DEVICE); }
        status = cuda_buffer_alloc(YKN_CUDA_CONTEXT_PTR, N * 8, &YKN_CUDA_F16_OUT_DEVICE);
        eger status != CUDA_SUCCESS { YKN_CUDA_LAST_ERROR = status; dondu 0; }
        YKN_CUDA_F16_OUT_CAPACITY = N * 8;
    }
    eger YKN_CUDA_RECENT_DEVICE == 0 {
        status = cuda_buffer_alloc(YKN_CUDA_CONTEXT_PTR, 256 * 8, &YKN_CUDA_RECENT_DEVICE);
        eger status != CUDA_SUCCESS { YKN_CUDA_LAST_ERROR = status; dondu 0; }
    }
    eger YKN_CUDA_ARGMAX_OUT_DEVICE == 0 {
        status = cuda_buffer_alloc(YKN_CUDA_CONTEXT_PTR, 8, &YKN_CUDA_ARGMAX_OUT_DEVICE);
        eger status != CUDA_SUCCESS { YKN_CUDA_LAST_ERROR = status; dondu 0; }
    }

    # degisken t_sync0: tamsayi = ykn_llm_clock_ns();
    # cuda_ctx_synchronize(YKN_CUDA_CONTEXT_PTR);
    # degisken t_sync1: tamsayi = ykn_llm_clock_ns();
    # G_TIME_NORM_NS = G_TIME_NORM_NS + (t_sync1 - t_sync0);
    degisken t_f16_0: tamsayi = ykn_llm_clock_ns();
    eger activation != 0 {
        status = cuda_copy_to_device(YKN_CUDA_CONTEXT_PTR, YKN_CUDA_F16_ACT_DEVICE, activation, K * 8);
    }
    eger status == CUDA_SUCCESS {
        degisken params: [5]*u8;
        params[0] = &gpu_weights; params[1] = &YKN_CUDA_F16_ACT_DEVICE;
        params[2] = &YKN_CUDA_F16_OUT_DEVICE; params[3] = &K; params[4] = &N;
        status = cuda_kernel_launch_config(YKN_CUDA_CONTEXT_PTR, G_KER_F16,
            params, G_CFG_F16);
    }
    eger status == CUDA_SUCCESS ve recent_count > 0 ve penalty_q16 > 65536 ve recent_tokens != 0 {
        status = cuda_copy_to_device(YKN_CUDA_CONTEXT_PTR, YKN_CUDA_RECENT_DEVICE, recent_tokens, recent_count * 8);
    }
    eger status == CUDA_SUCCESS {
        degisken argmax_params: [6]*u8;
        degisken p_logits: tamsayi = YKN_CUDA_F16_OUT_DEVICE;
        degisken p_N: tamsayi = N;
        degisken p_recent: tamsayi = YKN_CUDA_RECENT_DEVICE;
        degisken p_count: tamsayi = recent_count;
        degisken p_penalty: tamsayi = penalty_q16;
        degisken p_out: tamsayi = YKN_CUDA_ARGMAX_OUT_DEVICE;
        argmax_params[0] = &p_logits;
        argmax_params[1] = &p_N;
        argmax_params[2] = &p_recent;
        argmax_params[3] = &p_count;
        argmax_params[4] = &p_penalty;
        argmax_params[5] = &p_out;
        status = cuda_kernel_launch_config(YKN_CUDA_CONTEXT_PTR, G_KER_ARGMAX,
            argmax_params, G_CFG_1_256);
    }
    eger status == CUDA_SUCCESS {
        status = cuda_copy_to_host(YKN_CUDA_CONTEXT_PTR, out_token, YKN_CUDA_ARGMAX_OUT_DEVICE, 8);
    }
    degisken t_f16_1: tamsayi = ykn_llm_clock_ns();
    YKN_CUDA_F16_GPU_NS = YKN_CUDA_F16_GPU_NS + (t_f16_1 - t_f16_0);
    YKN_CUDA_LAST_ERROR = status;
    eger status != CUDA_SUCCESS { dondu 0; }
    YKN_CUDA_F16_CALLS = YKN_CUDA_F16_CALLS + 1;
    dondu 1;
}

# Q1_0 is used by the Bonsai/Qwen GGUF. Each output row owns its packed
# 18-byte blocks; dimensions and byte bounds are checked before device reads.
isv ykn_cuda_k_matvec_packed(packed: *u8, activation: *tamsayi,
                             output: *tamsayi, K: tamsayi, N: tamsayi,
                             packed_bytes: tamsayi, block_bytes: tamsayi,
                             kernel_name: *u8) -> tamsayi {
    YKN_CUDA_LAST_ERROR = CUDA_SUCCESS;
    eger YKN_CUDA_READY != 1 veya packed == 0 veya activation == 0 or
       output == 0 or kernel_name == 0 or K <= 0 or N <= 0 or
       K > 1048576 or N > 1048576 or K % 256 != 0 or
       (block_bytes != 144 and block_bytes != 210) or
       packed_bytes < N * (K / 256) * block_bytes {
        YKN_CUDA_LAST_ERROR = CUDA_ERROR_BAD_ARGUMENT; dondu 0;
    }
    degisken gpu_weights: tamsayi = 0;
    degisken gpu_activation: tamsayi = 0;
    degisken gpu_output: tamsayi = 0;
    degisken status: tamsayi = cuda_buffer_alloc(YKN_CUDA_CONTEXT_PTR,
        packed_bytes, &gpu_weights);
    eger status != CUDA_SUCCESS { YKN_CUDA_LAST_ERROR = status; dondu 0; }
    status = cuda_buffer_alloc(YKN_CUDA_CONTEXT_PTR, K * 8, &gpu_activation);
    eger status != CUDA_SUCCESS {
        YKN_CUDA_LAST_ERROR = status;
        cuda_buffer_free(YKN_CUDA_CONTEXT_PTR, gpu_weights); dondu 0;
    }
    status = cuda_buffer_alloc(YKN_CUDA_CONTEXT_PTR, N * 8, &gpu_output);
    eger status != CUDA_SUCCESS {
        YKN_CUDA_LAST_ERROR = status;
        cuda_buffer_free(YKN_CUDA_CONTEXT_PTR, gpu_activation);
        cuda_buffer_free(YKN_CUDA_CONTEXT_PTR, gpu_weights); dondu 0;
    }
    status = cuda_copy_to_device(YKN_CUDA_CONTEXT_PTR, gpu_weights, packed, packed_bytes);
    eger status == CUDA_SUCCESS {
        status = cuda_copy_to_device(YKN_CUDA_CONTEXT_PTR, gpu_activation, activation, K * 8);
    }
    eger status == CUDA_SUCCESS {
        degisken params: [5]*u8;
        params[0] = &gpu_weights; params[1] = &gpu_activation;
        params[2] = &gpu_output; params[3] = &K; params[4] = &N;
        status = cuda_ptx_launch_1d(YKN_CUDA_CONTEXT_PTR, ykn_cuda_quant_ptx(),
            kernel_name, params, (N + 127) / 128, 128);
    }
    eger status == CUDA_SUCCESS {
        status = cuda_copy_to_host(YKN_CUDA_CONTEXT_PTR, output, gpu_output, N * 8);
    }
    cuda_buffer_free(YKN_CUDA_CONTEXT_PTR, gpu_output);
    cuda_buffer_free(YKN_CUDA_CONTEXT_PTR, gpu_activation);
    cuda_buffer_free(YKN_CUDA_CONTEXT_PTR, gpu_weights);
    YKN_CUDA_LAST_ERROR = status;
    eger status != CUDA_SUCCESS { dondu 0; }
    dondu 1;
}

isv ykn_cuda_q4_k_matvec(packed: *u8, activation: *tamsayi,
                          output: *tamsayi, K: tamsayi, N: tamsayi,
                          packed_bytes: tamsayi) -> tamsayi {
    eger ykn_cuda_k_matvec_packed(packed, activation, output, K, N,
        packed_bytes, 144, "ykn_q4_k_matvec".ptr) == 0 { dondu 0; }
    YKN_CUDA_Q4K_CALLS = YKN_CUDA_Q4K_CALLS + 1;
    dondu 1;
}

isv ykn_cuda_q6_k_matvec(packed: *u8, activation: *tamsayi,
                          output: *tamsayi, K: tamsayi, N: tamsayi,
                          packed_bytes: tamsayi) -> tamsayi {
    eger ykn_cuda_k_matvec_packed(packed, activation, output, K, N,
        packed_bytes, 210, "ykn_q6_k_matvec".ptr) == 0 { dondu 0; }
    YKN_CUDA_Q6K_CALLS = YKN_CUDA_Q6K_CALLS + 1;
    dondu 1;
}

isv ykn_cuda_q1_matvec_cached(packed: *u8, activation: *tamsayi,
                              output: *tamsayi, K: tamsayi, N: tamsayi,
                              packed_bytes: tamsayi, cache_key: tamsayi) -> tamsayi {
    YKN_CUDA_LAST_ERROR = CUDA_SUCCESS;
    eger YKN_CUDA_READY != 1 veya packed == 0 veya activation == 0 or
       output == 0 or K <= 0 or N <= 0 or K % 128 != 0 or
       packed_bytes < N * (K / 128) * 18 {
        YKN_CUDA_LAST_ERROR = CUDA_ERROR_BAD_ARGUMENT; dondu 0;
    }
    degisken gpu_weights: tamsayi = 0;
    degisken cache_i: tamsayi = 0;
    degisken cache_found: tamsayi = 0;
    eger cache_key != 0 {
        dongu cache_i < YKN_CUDA_Q1_WEIGHT_CACHE_COUNT {
            eger YKN_CUDA_Q1_WEIGHT_CACHE_KEYS[cache_i] == cache_key and
               YKN_CUDA_Q1_WEIGHT_CACHE_BYTES[cache_i] == packed_bytes {
                gpu_weights = YKN_CUDA_Q1_WEIGHT_CACHE_PTRS[cache_i];
                cache_found = 1;
            }
            cache_i = cache_i + 1;
        }
    }
    degisken status: tamsayi = CUDA_SUCCESS;
    eger cache_found == 0 {
        status = cuda_buffer_alloc(YKN_CUDA_CONTEXT_PTR, packed_bytes, &gpu_weights);
        eger status != CUDA_SUCCESS { YKN_CUDA_LAST_ERROR = status; dondu 0; }
        status = cuda_copy_to_device(YKN_CUDA_CONTEXT_PTR, gpu_weights, packed, packed_bytes);
        eger status != CUDA_SUCCESS {
            YKN_CUDA_LAST_ERROR = status;
            cuda_buffer_free(YKN_CUDA_CONTEXT_PTR, gpu_weights);
            dondu 0;
        }
        eger cache_key != 0 and YKN_CUDA_Q1_WEIGHT_CACHE_COUNT < 512 {
            cache_i = YKN_CUDA_Q1_WEIGHT_CACHE_COUNT;
            YKN_CUDA_Q1_WEIGHT_CACHE_KEYS[cache_i] = cache_key;
            YKN_CUDA_Q1_WEIGHT_CACHE_PTRS[cache_i] = gpu_weights;
            YKN_CUDA_Q1_WEIGHT_CACHE_BYTES[cache_i] = packed_bytes;
            YKN_CUDA_Q1_WEIGHT_CACHE_COUNT = cache_i + 1;
        }
    }
    eger YKN_CUDA_Q1_ACT_DEVICE == 0 or YKN_CUDA_Q1_ACT_CAPACITY < K * 8 {
        eger YKN_CUDA_Q1_ACT_DEVICE != 0 { cuda_buffer_free(YKN_CUDA_CONTEXT_PTR, YKN_CUDA_Q1_ACT_DEVICE); }
        status = cuda_buffer_alloc(YKN_CUDA_CONTEXT_PTR, K * 8, &YKN_CUDA_Q1_ACT_DEVICE);
        eger status != CUDA_SUCCESS {
            YKN_CUDA_LAST_ERROR = status;
            YKN_CUDA_Q1_ACT_DEVICE = 0;
            eger cache_found == 0 and cache_key == 0 { cuda_buffer_free(YKN_CUDA_CONTEXT_PTR, gpu_weights); }
            dondu 0;
        }
        YKN_CUDA_Q1_ACT_CAPACITY = K * 8;
    }
    eger YKN_CUDA_Q1_OUT_DEVICE == 0 or YKN_CUDA_Q1_OUT_CAPACITY < N * 8 {
        eger YKN_CUDA_Q1_OUT_DEVICE != 0 { cuda_buffer_free(YKN_CUDA_CONTEXT_PTR, YKN_CUDA_Q1_OUT_DEVICE); }
        status = cuda_buffer_alloc(YKN_CUDA_CONTEXT_PTR, N * 8, &YKN_CUDA_Q1_OUT_DEVICE);
        eger status != CUDA_SUCCESS {
            YKN_CUDA_LAST_ERROR = status;
            YKN_CUDA_Q1_OUT_DEVICE = 0;
            eger cache_found == 0 and cache_key == 0 { cuda_buffer_free(YKN_CUDA_CONTEXT_PTR, gpu_weights); }
            dondu 0;
        }
        YKN_CUDA_Q1_OUT_CAPACITY = N * 8;
    }
    status = cuda_copy_to_device(YKN_CUDA_CONTEXT_PTR, YKN_CUDA_Q1_ACT_DEVICE, activation, K * 8);
    eger status == CUDA_SUCCESS {
        degisken params: [5]*u8;
        params[0] = &gpu_weights; params[1] = &YKN_CUDA_Q1_ACT_DEVICE;
        params[2] = &YKN_CUDA_Q1_OUT_DEVICE; params[3] = &K; params[4] = &N;
        status = cuda_ptx_launch_1d(YKN_CUDA_CONTEXT_PTR, ykn_cuda_q1_ptx(),
            "ykn_q1_matvec".ptr, params, (N + 127) / 128, 128);
    }
    eger status == CUDA_SUCCESS {
        status = cuda_copy_to_host(YKN_CUDA_CONTEXT_PTR, output, YKN_CUDA_Q1_OUT_DEVICE, N * 8);
    }
    eger cache_found == 0 and cache_key == 0 {
        cuda_buffer_free(YKN_CUDA_CONTEXT_PTR, gpu_weights);
    }
    YKN_CUDA_LAST_ERROR = status;
    eger status != CUDA_SUCCESS { dondu 0; }
    YKN_CUDA_Q1_CALLS = YKN_CUDA_Q1_CALLS + 1;
    dondu 1;
}

isv ykn_cuda_q1_matvec(packed: *u8, activation: *tamsayi,
                       output: *tamsayi, K: tamsayi, N: tamsayi,
                       packed_bytes: tamsayi) -> tamsayi {
    dondu ykn_cuda_q1_matvec_cached(packed, activation, output, K, N, packed_bytes, 0);
}

isv ykn_cuda_has_weight(cache_key: tamsayi, packed_bytes: tamsayi) -> tamsayi {
    eger YKN_CUDA_READY != 1 veya cache_key == 0 { dondu 0; }
    degisken i: tamsayi = 0;
    dongu i < YKN_CUDA_IQ2S_WEIGHT_CACHE_COUNT {
        eger YKN_CUDA_IQ2S_WEIGHT_CACHE_KEYS[i] == cache_key ve
           YKN_CUDA_IQ2S_WEIGHT_CACHE_BYTES[i] == packed_bytes {
            dondu 1;
        }
        i = i + 1;
    }
    i = 0;
    dongu i < YKN_CUDA_Q1_WEIGHT_CACHE_COUNT {
        eger YKN_CUDA_Q1_WEIGHT_CACHE_KEYS[i] == cache_key ve
           YKN_CUDA_Q1_WEIGHT_CACHE_BYTES[i] == packed_bytes {
            dondu 1;
        }
        i = i + 1;
    }
    dondu 0;
