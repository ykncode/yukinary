isv ykn_cuda_bitnet_i2s_ptx() -> *u8 {
    dondu ".version 8.0\n.target sm_52\n.address_size 64\n.visible .entry ykn_bitnet_i2s_matvec(.param .u64 pW,.param .u64 pX,.param .u64 pY,.param .u32 pK,.param .u32 pN,.param .u32 pAmax,.param .u32 pScale){\n.reg .pred %p<8>;\n.reg .b32 %r<35>;\n.reg .s32 %w<4>,%a<4>,%acc;\n.reg .b64 %rd<16>;\n.reg .s64 %s<16>;\nld.param.u64 %rd0,[pW];\nld.param.u64 %rd1,[pX];\nld.param.u64 %rd2,[pY];\nld.param.u32 %r0,[pK];\nld.param.u32 %r1,[pN];\nld.param.u32 %r2,[pAmax];\nld.param.u32 %r3,[pScale];\nmov.u32 %r8,%ctaid.x;\nmov.u32 %r9,%tid.x;\nshr.u32 %r10,%r9,5;\nand.b32 %r11,%r9,31;\nshl.b32 %r12,%r8,2;\nadd.u32 %r12,%r12,%r10;\nsetp.ge.u32 %p1,%r12,%r1;\n@%p1 bra EXIT;\nshr.u32 %r13,%r0,2;\nmul.lo.u32 %r13,%r13,%r12;\ncvt.u64.u32 %rd6,%r13;\nadd.u64 %rd7,%rd0,%rd6;\ncvt.u64.u32 %rd8,%r11;\nadd.u64 %rd8,%rd7,%rd8;\nshl.b32 %r23,%r11,3;\ncvt.u64.u32 %rd4,%r23;\nadd.u64 %rd5,%rd1,%rd4;\nshr.u32 %r14,%r0,7;\nmov.u32 %r15,0;\nmov.s32 %acc,0;\nBLOCK_LOOP_2:\nadd.u32 %r26,%r15,2;\nsetp.gt.u32 %p2,%r26,%r14;\n@%p2 bra BLOCK_REMAINDER;\nld.global.u8 %r17,[%rd8];\nld.global.u8 %r25,[%rd8+32];\nadd.u64 %rd8,%rd8,64;\nld.global.s64 %s0,[%rd5];\nld.global.s64 %s1,[%rd5+256];\nld.global.s64 %s2,[%rd5+512];\nld.global.s64 %s3,[%rd5+768];\nld.global.s64 %s8,[%rd5+1024];\nld.global.s64 %s9,[%rd5+1280];\nld.global.s64 %s10,[%rd5+1536];\nld.global.s64 %s11,[%rd5+1792];\nadd.u64 %rd5,%rd5,2048;\ncvt.s32.s64 %a0,%s0;\ncvt.s32.s64 %a1,%s1;\ncvt.s32.s64 %a2,%s2;\ncvt.s32.s64 %a3,%s3;\nshr.u32 %r18,%r17,6;\nand.b32 %r18,%r18,3;\nshr.u32 %r19,%r17,4;\nand.b32 %r19,%r19,3;\nshr.u32 %r20,%r17,2;\nand.b32 %r20,%r20,3;\nand.b32 %r21,%r17,3;\nsub.s32 %w0,%r18,1;\nsetp.eq.u32 %p3,%r18,3;\n@%p3 mov.s32 %w0,0;\nsub.s32 %w1,%r19,1;\nsetp.eq.u32 %p4,%r19,3;\n@%p4 mov.s32 %w1,0;\nsub.s32 %w2,%r20,1;\nsetp.eq.u32 %p5,%r20,3;\n@%p5 mov.s32 %w2,0;\nsub.s32 %w3,%r21,1;\nsetp.eq.u32 %p6,%r21,3;\n@%p6 mov.s32 %w3,0;\nmad.lo.s32 %acc,%w0,%a0,%acc;\nmad.lo.s32 %acc,%w1,%a1,%acc;\nmad.lo.s32 %acc,%w2,%a2,%acc;\nmad.lo