hared.s64 %s2,[%r13];\nmov.u32 %r8,1;\nMAX_LOOP:\nsetp.gt.u32 %p4,%r8,%r3;\n@%p4 bra MAX_DONE;\nshl.b32 %r12,%r8,3;\nadd.u32 %r14,%r13,%r12;\nld.shared.s64 %s3,[%r14];\nsetp.gt.s64 %p5,%s3,%s2;\n@%p5 mov.s64 %s2,%s3;\nadd.u32 %r8,%r8,1;\nbra MAX_LOOP;\nMAX_DONE:\nmov.u32 %r15,sh_max;\nst.shared.s64 [%r15],%s2;\nSYNC_MAX:\nbar.sync 0;\nmov.u32 %r15,sh_max;\nld.shared.s64 %s2,[%r15];\nmov.u32 %r8,%r5;\nEXP_TOK_LOOP:\nsetp.gt.u32 %p1,%r8,%r3;\n@%p1 bra SYNC_EXP;\nshl.b32 %r12,%r8,3;\nmov.u32 %r13,sh_skor;\nadd.u32 %r13,%r13,%r12;\nld.shared.s64 %s3,[%r13];\nsub.s64 %s4,%s3,%s2;\nsetp.ge.s64 %p4,%s4,0;\n@%p4 mov.s64 %s10,65536;\n@%p4 bra EXP_STORE;\nsetp.lt.s64 %p5,%s4,-524288;\n@%p5 mov.s64 %s10,0;\n@%p5 bra EXP_STORE;\ndiv.s64 %s5,%s4,8;\nmul.lo.s64 %s6,%s5,%s5;\ndiv.s64 %s6,%s6,65536;\nmul.lo.s64 %s7,%s6,%s5;\ndiv.s64 %s7,%s7,65536;\nmul.lo.s64 %s8,%s7,%s5;\ndiv.s64 %s8,%s8,65536;\nmul.lo.s64 %s9,%s8,%s5;\ndiv.s64 %s9,%s9,65536;\nmov.s64 %s10,65536;\nadd.s64 %s10,%s10,%s5;\ndiv.s64 %s11,%s6,2;\nadd.s64 %s10,%s10,%s11;\ndiv.s64 %s11,%s7,6;\nadd.s64 %s10,%s10,%s11;\ndiv.s64 %s11,%s8,24;\nadd.s64 %s10,%s10,%s11;\ndiv.s64 %s11,%s9,120;\nadd.s64 %s10,%s10,%s11;\nsetp.lt.s64 %p6,%s10,0;\n@%p6 mov.s64 %s10,0;\nmov.s64 %s11,%s10;\nmul.lo.s64 %s10,%s10,%s11;\ndiv.s64 %s10,%s10,65536;\nmul.lo.s64 %s10,%s10,%s11;\ndiv.s64 %s10,%s10,65536;\nmul.lo.s64 %s10,%s10,%s11;\ndiv.s64 %s10,%s10,65536;\nmul.lo.s64 %s10,%s10,%s11;\ndiv.s64 %s10,%s10,65536;\nmul.lo.s64 %s10,%s10,%s11;\ndiv.s64 %s10,%s10,65536;\nmul.lo.s64 %s10,%s10,%s11;\ndiv.s64 %s10,%s10,65536;\nmul.lo.s64 %s10,%s10,%s11;\ndiv.s64 %s10,%s10,65536;\nEXP_STORE:\nmov.u32 %r14,sh_w;\nadd.u32 %r14,%r14,%r12;\nst.shared.s64 [%r14],%s10;\nadd.u32 %r8,%r8,128;\nbra EXP_TOK_LOOP;\nSYNC_EXP:\nbar.sync 0;\nsetp.ne.u32 %p3,%r5,0;\n@%p3 bra SYNC_SUM;\nmov.s64 %s12,0;\nmov.u32 %r8,0;\nmov.u32 %r14,sh_w;\nSUM_LOOP:\nsetp.gt.u32 %p4,%r8,%r3;\n@%p4 bra SUM_DONE;\nshl.b32 %r12,%r8,3;\nadd.u32 %r16,%r14,%r12;\nld.shared.s64 %s3,[%r16];\nadd.s64 %s12,%s12,%s3;\nadd.u32 %r8,%r8,1;\nbra SUM_LOOP;\nSUM_DONE:\nmov.u32 %r15,sh_sum;\nst.shared.s64 [%r15],%s12;\nSYNC_SUM:\nbar.sync 0;\nmov.u32 %r15,sh_sum;\nld.shared.s64 %s12,[%r15];\nmov.u32 %r8,%r5;\nNORM_W_LOOP:\nsetp.gt.u32 %p1,%r8,%r3;\n@%p1 bra SYNC_NORM_W;\nshl.b32 %r12,%r8,3;\nmov.u32 %r14,sh_w;\nadd.u32 %r14,%r14,%r12;\nld.shared.s64 %s3,[%r14];\nmul.lo.s64 %s3,%s3,65536;\ndiv.s64 %s3,%s3,%s12;\nst.shared.s64 [%r14],%s3;\nadd.u32 %r8,%r8,128;\nbra NORM_W_LOOP;\nSYNC_NORM_W:\nbar.sync 0;\nsetp.ge.u32 %p0,%r5,%r2;\n@%p0 bra EXIT;\nmov.s64 %s13,0;\nmov.u32 %r8,0;\nmov.u32 %r14,sh_w;\nmul.lo.u32 %r17,%r7,%r2;\nadd.u32 %r17,%r17,%r5;\nmul.wide.u32 %rd6,%r17,8;\nadd.u64 %rd7,%rd2,%rd6;\nmul.lo.u32 %r18,%r1,%r2;\nmul.wide.u32 %rd8,%r18,8;\nV_ACC_LOOP:\nsetp.gt.u32 %p4,%r8,%r3;\n@%p4 bra V_ACC_DONE;\nld.shared.s64 %s3,[%r14];\nld.global.s64 %s4,[%rd7];\nmul.lo.s64 %s5,%s3,%s4;\nadd.s64 %s13,%s13,%s5;\nadd.u32 %r14,%r14,8;\nadd.u64 %rd7,%rd7,%rd8;\nadd.u32 %r8,%r8,1;\nbra V_ACC_LOOP;\nV_ACC_DONE:\ndiv.s64 %s13,%s13,65536;\nmul.lo.u32 %r19,%r4,%r2;\nadd.u32 %r19,%r19,%r5;\nmul.wide.u32 %rd9,%r19,8;\nadd.u64 %rd10,%rd3,%rd9;\nst.global.s64 [%rd10],%s13;\nEXIT:\nret;\n}\n".ptr;
}

isv ykn_cuda_init_kv_and_rope(kv_bytes: tamsayi, h_cos: *tamsayi, h_sin: *tamsayi, rope_bytes: tamsayi) -> tamsayi {
    eger YKN_CUDA_READY != 1 or kv_bytes <= 0 or h_cos == 0 or h_sin == 0 or rope_bytes <= 0 { dondu 0; }
    eger YKN_CUDA_KV_K_DEVICE == 0 or YKN_CUDA_KV_CAPACITY_BYTES < kv_bytes {
        eger YKN_CUDA_KV_K_DEVICE != 0 { cuda_buffer_free(YKN_CUDA_CONTEXT_PTR, YKN_CUDA_KV_K_DEVICE); }
        eger YKN_CUDA_KV_V_DEVICE != 0 { cuda_buffer_free(YKN_CUDA_CONTEXT_PTR, YKN_CUDA_KV_V_DEVICE); }
        eger cuda_buffer_alloc(YKN_CUDA_CONTEXT_PTR, kv_bytes, &YKN_CUDA_KV_K_DEVICE) != CUDA_SUCCESS { YKN_CUDA_KV_K_DEVICE = 0; dondu 0; }
        eger cuda_buffer_alloc(YKN_CUDA_CONTEXT_PTR, kv_bytes, &YKN_CUDA_KV_V_DEVICE) != CUDA_SUCCESS {
            cuda_buffer_free(YKN_CUDA_CONTEXT_PTR, YKN_CUDA_KV_K_DEVICE);
            YKN_CUDA_KV_K_DEVICE = 0; YKN_CUDA_KV_V_DEVICE = 0; dondu 0;
        }
        YKN_CUDA_KV_CAPACITY_BYTES = kv_bytes;
    }
    eger YKN_CUDA_ROPE_COS_DEVICE == 0 or YKN_CUDA_ROPE_CAPACITY_BYTES < rope_bytes {
        eger YKN_CUDA_ROPE_COS_DEVICE != 0 { cuda_buffer_free(YKN_CUDA_CONTEXT_PTR, YKN_CUDA_ROPE_COS_DEVICE); }
        eger YKN_CUDA_ROPE_SIN_DEVICE != 0 { cuda_buffer_free(YKN_CUDA_CONTEXT_PTR, YKN_CUDA_ROPE_SIN_DEVICE); }
        eger cuda_buffer_alloc(YKN_CUDA_CONTEXT_PTR, rope_bytes, &YKN_CUDA_ROPE_COS_DEVICE) != CUDA_SUCCESS { YKN_CUDA_ROPE_COS_DEVICE = 0; dondu 0; }
        eger cuda_buffer_alloc(YKN_CUDA_CONTEXT_PTR, rope_bytes, &YKN_CUDA_ROPE_SIN_DEVICE) != CUDA_SUCCESS {
            cuda_buffer_free(YKN_CUDA_CONTEXT_PTR, YKN_CUDA_ROPE_COS_DEVICE);
            YKN_CUDA_ROPE_COS_DEVICE = 0; YKN_CUDA_ROPE_SIN_DEVICE = 0; dondu 0;
        }
        YKN_CUDA_ROPE_CAPACITY_BYTES = rope_bytes;
    }
    eger cuda_copy_to_device(YKN_CUDA_CONTEXT_PTR, YKN_CUDA_ROPE_COS_DEVICE, h_cos, rope_bytes) != CUDA_SUCCESS { dondu 0; }
    eger cuda_copy_to_device(YKN_CUDA_CONTEXT_PTR, YKN_CUDA_ROPE_SIN_DEVICE, h_sin, rope_bytes) != CUDA_SUCCESS { dondu 0; }
    eger YKN_CUDA_TOKEN_POS_DEVICE == 0 {
        cuda_buffer_alloc(YKN_CUDA_CONTEXT_PTR, 64, &YKN_CUDA_TOKEN_POS_DEVICE);
    }
    dondu 1;
}

isv ykn_cuda_rope_kv_attention(katman: tamsayi, token_konumu: tamsayi,
                               q_heads: tamsayi, kv_heads: tamsayi,
                               head_dim: tamsayi, kv_cap: tamsayi,
                               karekok_q16: tamsayi) -> tamsayi {
    eger YKN_CUDA_READY != 1 or YKN_CUDA_KV_K_DEVICE == 0 or YKN_CUDA_ROPE_COS_DEVICE == 0 { dondu 0; }
    degisken N_q: tamsayi = q_heads * head_dim;
    degisken N_k: tamsayi = kv_heads * head_dim;
    degisken cift: tamsayi = head_dim / 2;
    degisken out_q_dev: tamsayi = YKN_CUDA_IQ2S_OUT_DEVICE;
    degisken out_k_dev: tamsayi = YKN_CUDA_IQ2S_OUT_DEVICE + N_q * 8;
    degisken out_v_dev: tamsayi = out_k_dev + N_k * 8;
    degisken attn_out_dev: tamsayi = YKN_CUDA_IQ2S_OUT_DEVICE + 32768;

    degisken cos_dev: tamsayi = YKN_CUDA_ROPE_COS_DEVICE + token_konumu * cift * 8;
    degisken sin_dev: tamsayi = YKN_CUDA_ROPE_SIN_DEVICE + token_konumu * cift * 8;
    degisken layer_stride_bytes: tamsayi = kv_cap * N_k * 8;
    degisken k_layer_dev: tamsayi = YKN_CUDA_KV_K_DEVICE + katman * layer_stride_bytes;
    degisken v_layer_dev: tamsayi = YKN_CUDA_KV_V_DEVICE + katman * layer_stride_bytes;
    degisken k_slot_dev: tamsayi = k_layer_dev + token_konumu * N_k * 8;
    degisken v_slot_dev: tamsayi = v_layer_dev + token_konumu * N_k * 8;

    degisken qh_val: tamsayi = q_heads;
    degisken kvh_val: tamsayi = kv_heads;
    degisken hd_val: tamsayi = head_dim;
    degisken tok_val: tamsayi = token_konumu;
    degisken sqrt_val: tamsayi = karekok_q16;

    degisken params_rope: [10]*u8;
    params_rope[0] = &out_q_dev;
    params_rope[1] = &out_k_dev;
    params_rope[2] = &out_v_dev;
    params_rope[3] = &cos_dev;
    params_rope[4] = &sin_dev;
    params_rope[5] = &k_slot_dev;
    params_rope[6] = &v_slot_dev;
    params_rope[7] = &qh_val;
    params_rope[8] = &kvh_val;
    params_rope[9] = &hd_val;
    degisken st: tamsayi = cuda_kernel_launch_1d(YKN_CUDA_CONTEXT_PTR, G_KER_ROPE_KV,
        params_rope, 1, 256);
    eger st != CUDA_SUCCESS { dondu 0; }

    degisken params_attn: [9]*u8;
    params_attn[0] = &out_q_dev;
    params_attn[1] = &k_layer_dev;
    params_attn[2] = &v_layer_dev;
    params_attn[3] = &attn_out_dev;
    params_attn[4] = &qh_val;
    params_attn[5] = &kvh_val;
    params_attn[6] = &hd_val;
    params_attn[7] = &tok_val;
    params_attn[8] = &sqrt_val;
    st = cuda_kernel_launch_1d(YKN_CUDA_CONTEXT_PTR, G_KER_KV_ATTN,
        params_attn, q_heads, 128);
    eger st != CUDA_SUCCESS { dondu 0; }

    YKN_CUDA_ATTN_ON_GPU = 1;
    dondu 1;
}


isv ykn_cuda_bitnet_step_layer(katman: tamsayi, token_pos: tamsayi,
                               q_heads: tamsayi, kv_heads: tamsayi,
                               head_dim: tamsayi, kv_cap: tamsayi,
                               K: tamsayi, N_ffn: tamsayi, eps_q16: tamsayi,
                               sqrt_dim: tamsayi, hidden_in: *tamsayi) -> tamsayi {
    degisken base: tamsayi = katman * 20;
    degisken attn_n_dev: tamsayi = G_BITNET_LAYER_PARAMS[base + 0];
    degisken q_w_dev: tamsayi = G_BITNET_LAYER_PARAMS[base + 1];
    degisken q_s_val: tamsayi = G_BITNET_LAYER_PARAMS[base + 2];
    degisken k_w_dev: tamsayi = G_BITNET_LAYER_PARAMS[base + 3];
    degisken k_s_val: tamsayi = G_BITNET_LAYER_PARAMS[base + 4];
    degisken v_w_dev: tamsayi = G_BITNET_LAYER_PARAMS[base + 5];
    degisken v_s_val: tamsayi = G_BITNET_LAYER_PARAMS[base + 6];
    degisken attn_sn_dev: tamsayi = G_BITNET_LAYER_PARAMS[base + 7];
    degisken o_w_dev: tamsayi = G_BITNET_LAYER_PARAMS[base + 8];
    degisken o_s_val: tamsayi = G_BITNET_LAYER_PARAMS[base + 9];
    degisken ffn_n_dev: tamsayi = G_BITNET_LAYER_PARAMS[base + 10];
    degisken g_w_dev: tamsayi = G_BITNET_LAYER_PARAMS[base + 11];
    degisken g_s_val: tamsayi = G_BITNET_LAYER_PARAMS[base + 12];
    degisken u_w_dev: tamsayi = G_BITNET_LAYER_PARAMS[base + 13];
    degisken u_s_val: tamsayi = G_BITNET_LAYER_PARAMS[base + 14];
    degisken ffn_sn_dev: tamsayi = G_BITNET_LAYER_PARAMS[base + 15];
    degisken d_w_dev: tamsayi = G_BITNET_LAYER_PARAMS[base + 16];
    degisken d_s_val: tamsayi = G_BITNET_LAYER_PARAMS[base + 17];

    degisken K_val: tamsayi = K;
    degisken N_ffn_val: tamsayi = N_ffn;
    degisken eps_val: tamsayi = eps_q16;
    degisken N_q: tamsayi = q_heads * head_dim;
    degisken N_k: tamsayi = kv_heads * head_dim;

    eger YKN_CUDA_HIDDEN_ON_GPU == 0 {
        eger cuda_copy_to_device(YKN_CUDA_CONTEXT_PTR, YKN_CUDA_RESIDUAL_DEVICE, hidden_in, K * 8) != CUDA_SUCCESS { dondu 0; }
        YKN_CUDA_HIDDEN_ON_GPU = 1;
    }

    # 1. attn RMSNorm + Quant from YKN_CUDA_RESIDUAL_DEVICE
    degisken temp_dev: tamsayi = YKN_CUDA_IQ2S_OUT_DEVICE + 65536;
    degisken params_n: [7]*u8;
    params_n[0] = &YKN_CUDA_RESIDUAL_DEVICE;
    params_n[1] = &attn_n_dev;
    params_n[2] = &temp_dev;
    params_n[3] = &YKN_CUDA_IQ2S_ACT_DEVICE;
    params_n[4] = &YKN_CUDA_AMAX_DEVICE;
    params_n[5] = &K_val;
    params_n[6] = &eps_val;
    cuda_kernel_launch_1d(YKN_CUDA_CONTEXT_PTR, G_KER_RMSNORM_QUANT, params_n, 1, 256);

    # 2. Q MatVec
    degisken out_q_dev: tamsayi = YKN_CUDA_IQ2S_OUT_DEVICE;
    degisken out_k_dev: tamsayi = YKN_CUDA_IQ2S_OUT_DEVICE + N_q * 8;
    degisken out_v_dev: tamsayi = out_k_dev + N_k * 8;
    degisken params_q: [7]*u8;
    params_q[0] = &q_w_dev;
    params_q[1] = &YKN_CUDA_IQ2S_ACT_DEVICE;
    params_q[2] = &out_q_dev;
    params_q[3] = &K_val;
    params_q[4] = &N_q;
    params_q[5] = &YKN_CUDA_AMAX_DEVICE;
    params_q[6] = &q_s_val;
    cuda_kernel_launch_1d(YKN_CUDA_CONTEXT_PTR, G_KER_BITNET_I2S_DEV_AMAX, params_q, (N_q + 7) / 8, 128);

    # 3. KV MatVec
    degisken params_kv: [10]*u8;
    params_kv[0] = &k_w_dev;
    params_kv[1] = &v_w_dev;
    params_kv[2] = &YKN_CUDA_IQ2S_ACT_DEVICE;
    params_kv[3] = &out_k_dev;
    params_kv[4] = &out_v_dev;
    params_kv[5] = &K_val;
    params_kv[6] = &N_k;
    params_kv[7] = &YKN_CUDA_AMAX_DEVICE;
    params_kv[8] = &k_s_val;
    params_kv[9] = &v_s_val;
    cuda_kernel_launch_1d(YKN_CUDA_CONTEXT_PTR, G_KER_GATE_UP_DEV_AMAX, params_kv, (N_k + 7) / 8, 128);

    # 4. RoPE + KV Cache Write
    degisken cift: tamsayi = head_dim / 2;
    degisken cos_dev: tamsayi = YKN_CUDA_ROPE_COS_DEVICE + token_pos * cift * 8;
    degisken sin_dev: tamsayi = YKN_CUDA_ROPE_SIN_DEVICE + token_pos * cift * 8;
    degisken layer_kv_stride: tamsayi = kv_cap * N_k * 8;
    degisken k_layer_dev: tamsayi = YKN_CUDA_KV_K_DEVICE + katman * layer_kv_stride;
    degisken v_layer_dev: tamsayi = YKN_CUDA_KV_V_DEVICE + katman * layer_kv_stride;
    degisken k_slot_dev: tamsayi = k_layer_dev + token_pos * N_k * 8;
    degisken v_slot_dev: tamsayi = v_layer_dev + token_pos * N_k * 8;
    degisken qh_val: tamsayi = q_heads;
    degisken kvh_val: tamsayi = kv_heads;
    degisken hd_val: tamsayi = head_dim;

    degisken params_rope: [10]*u8;
    params_rope[0] = &out_q_dev;
    params_rope[1] = &out_k_dev;
    params_rope[2] = &out_v_dev;
    params_rope[3] = &cos_dev;
    params_rope[4] = &sin_dev;
    params_rope[5] = &k_slot_dev;
    params_rope[6] = &v_slot_dev;
    params_rope[7] = &qh_val;
    params_rope[8] = &kvh_val;
    params_rope[9] = &hd_val;
    cuda_kernel_launch_1d(YKN_CUDA_CONTEXT_PTR, G_KER_ROPE_KV, params_rope, 1, 256);

    # 5. Attention
    degisken attn_out_dev: tamsayi = YKN_CUDA_IQ2S_OUT_DEVICE + 32768;
    degisken tok_val: tamsayi = token_pos;
    degisken sqrt_val: tamsayi = sqrt_dim;
    degisken params_attn: [9]*u8;
    params_attn[0] = &out_q_dev;
    params_attn[1] = &k_layer_dev;
    params_attn[2] = &v_layer_dev;
    params_attn[3] = &attn_out_dev;
    params_attn[4] = &qh_val;
    params_attn[5] = &kvh_val;
    params_attn[6] = &hd_val;
    params_attn[7] = &tok_val;
    params_attn[8] = &sqrt_val;
    cuda_kernel_launch_1d(YKN_CUDA_CONTEXT_PTR, G_KER_KV_ATTN, params_attn, q_heads, 128);

    # 6. attn_sub_norm + quant
    degisken params_sn1: [7]*u8;
    params_sn1[0] = &attn_out_dev;
    params_sn1[1] = &attn_sn_dev;
    params_sn1[2] = &YKN_CUDA_IQ2S_OUT_DEVICE_2;
    params_sn1[3] = &YKN_CUDA_IQ2S_ACT_DEVICE;
    params_sn1[4] = &YKN_CUDA_AMAX_DEVICE;
    params_sn1[5] = &K_val;
    params_sn1[6] = &eps_val;
    cuda_kernel_launch_1d(YKN_CUDA_CONTEXT_PTR, G_KER_RMSNORM_QUANT, params_sn1, 1, 256);

    # 7. O MatVec
    degisken params_o: [7]*u8;
    params_o[0] = &o_w_dev;
    params_o[1] = &YKN_CUDA_IQ2S_ACT_DEVICE;
    params_o[2] = &YKN_CUDA_IQ2S_OUT_DEVICE;
    params_o[3] = &K_val;
    params_o[4] = &K_val;
    params_o[5] = &YKN_CUDA_AMAX_DEVICE;
    params_o[6] = &o_s_val;
    cuda_kernel_launch_1d(YKN_CUDA_CONTEXT_PTR, G_KER_BITNET_I2S_DEV_AMAX, params_o, (K + 7) / 8, 128);

    # 8. res_add + ffn_norm + quant
    degisken params_rn: [8]*u8;
    params_rn[0] = &YKN_CUDA_IQ2S_OUT_DEVICE;
    params_rn[1] = &YKN_CUDA_RESIDUAL_DEVICE;
    params_rn[2] = &ffn_n_dev;
    params_rn[3] = &YKN_CUDA_IQ2S_OUT_DEVICE_2;
    params_rn[4] = &YKN_CUDA_IQ2S_ACT_DEVICE;
    params_rn[5] = &YKN_CUDA_AMAX_DEVICE;
    params_rn[6] = &K_val;
    params_rn[7] = &eps_val;
    cuda_kernel_launch_1d(YKN_CUDA_CONTEXT_PTR, G_KER_RES_ADD_RMSNORM_QUANT, params_rn, 1, 256);

    # 9. Gate+Up MatVec
    degisken params_gu: [10]*u8;
    params_gu[0] = &g_w_dev;
    params_gu[1] = &u_w_dev;
    params_gu[2] = &YKN_CUDA_IQ2S_ACT_DEVICE;
    params_gu[3] = &YKN_CUDA_IQ2S_OUT_DEVICE;
    params_gu[4] = &YKN_CUDA_IQ2S_OUT_DEVICE_2;
    params_gu[5] = &K_val;
    params_gu[6] = &N_ffn_val;
    params_gu[7] = &YKN_CUDA_AMAX_DEVICE;
    params_gu[8] = &g_s_val;
    params_gu[9] = &u_s_val;
    cuda_kernel_launch_1d(YKN_CUDA_CONTEXT_PTR, G_KER_GATE_UP_DEV_AMAX, params_gu, (N_ffn + 7) / 8, 128);

    # 10. SwiGLU + ffn_sub_norm + quant
    degisken params_srq: [8]*u8;
    params_srq[0] = &YKN_CUDA_IQ2S_OUT_DEVICE;
    params_srq[1] = &YKN_CUDA_IQ2S_OUT_DEVICE_2;
    params_srq[2] = &YKN_CUDA_SILU_LUT_DEVICE;
    params_srq[3] = &ffn_sn_dev;
    params_srq[4] = &YKN_CUDA_IQ2S_ACT_DEVICE;
    params_srq[5] = &YKN_CUDA_AMAX_DEVICE;
    params_srq[6] = &N_ffn_val;
    params_srq[7] = &eps_val;
    cuda_kernel_launch_1d(YKN_CUDA_CONTEXT_PTR, G_KER_SRQ, params_srq, 1, 256);

    # 11. Down MatVec + res_add
    degisken p_res_in1: tamsayi = YKN_CUDA_RESIDUAL_DEVICE;
    degisken p_res_out1: tamsayi = YKN_CUDA_RESIDUAL_DEVICE;
    degisken params_down: [8]*u8;
    params_down[0] = &d_w_dev;
    params_down[1] = &YKN_CUDA_IQ2S_ACT_DEVICE;
    params_down[2] = &p_res_in1;
    params_down[3] = &p_res_out1;
    params_down[4] = &N_ffn_val;
    params_down[5] = &K_val;
    params_down[6] = &YKN_CUDA_AMAX_DEVICE;
    params_down[7] = &d_s_val;
    cuda_kernel_launch_1d(YKN_CUDA_CONTEXT_PTR, G_KER_DEV_AMAX_RES_ADD, params_down, (K + 7) / 8, 128);

    YKN_CUDA_ATTN_ON_GPU = 0;
    YKN_CUDA_HIDDEN_ON_GPU = 1;
    ykn_cuda_clear_act_cache();
    G_STEP_ALL_LAYERS_COUNT = G_STEP_ALL_LAYERS_COUNT + 1;
    dondu 1;
}

isv ykn_cuda_is_all_layers_ready(total_layers: tamsayi) -> tamsayi {
    eger total_layers <= 0 { dondu 0; }
    degisken c: tamsayi = 0;
    dongu c < total_layers {
        eger G_BITNET_LAYER_READY[c] != 1 { dondu 0; }
        c = c + 1;
    }
    dondu 1;
}

isv ykn_cuda_bitnet_step_all_layers(total_layers: tamsayi, token_pos: tamsayi,
                                    q_heads: tamsayi, kv_heads: tamsayi,
                                    head_dim: tamsayi, kv_cap: tamsayi,
                                    K: tamsayi, N_ffn: tamsayi, eps_q16: tamsayi,
                                    sqrt_dim: tamsayi, hidden_in: *tamsayi) -> tamsayi {
    G_ALL_LAYERS_CALLED = G_ALL_LAYERS_CALLED + 1;
    eger YKN_CUDA_READY != 1 or total_layers <= 0 { G_ALL_LAYERS_FAILED = 1; dondu 0; }

    eger G_CUDA_GRAPH_READY == 1 {
        degisken tok_fast: tamsayi = token_pos;
        cuda_copy_to_device_async(YKN_CUDA_CONTEXT_PTR, YKN_CUDA_TOKEN_POS_DEVICE, &tok_fast, 4, YKN_CUDA_STREAM);
        degisken gr_st: tamsayi = cuda_graph_launch(G_CUDA_GRAPH_EXEC, YKN_CUDA_STREAM);
        eger gr_st == CUDA_SUCCESS {
            YKN_CUDA_ATTN_ON_GPU = 0;
            YKN_CUDA_HIDDEN_ON_GPU = 1;
            G_STEP_ALL_LAYERS_COUNT = G_STEP_ALL_LAYERS_COUNT + 1;
            dondu 1;
        }
    }

    degisken chk: tamsayi = 0;
    dongu chk < total_layers {
        eger G_BITNET_LAYER_READY[chk] != 1 { G_ALL_LAYERS_FAILED = 2; dondu 0; }
        chk = chk + 1;
    }

    degisken K_val: tamsayi = K;
    degisken N_ffn_val: tamsayi = N_ffn;
    degisken eps_val: tamsayi = eps_q16;
    degisken N_q: tamsayi = q_heads * head_dim;
    degisken N_k: tamsayi = kv_heads * head_dim;
    degisken cift: tamsayi = head_dim / 2;
    degisken qh_val: tamsayi = q_heads;
    degisken kvh_val: tamsayi = kv_heads;
    degisken hd_val: tamsayi = head_dim;
    degisken tok_val: tamsayi = token_pos;
    degisken sqrt_val: tamsayi = sqrt_dim;

    eger YKN_CUDA_HIDDEN_ON_GPU == 0 {
        eger cuda_copy_to_device(YKN_CUDA_CONTEXT_PTR, YKN_CUDA_RESIDUAL_DEVICE, hidden_in, K * 8) != CUDA_SUCCESS { dondu 0; }
        YKN_CUDA_HIDDEN_ON_GPU = 1;
    }

    degisken tok_i32: tamsayi = token_pos;
    cuda_copy_to_device(YKN_CUDA_CONTEXT_PTR, YKN_CUDA_TOKEN_POS_DEVICE, &tok_i32, 4);

    eger YKN_CUDA_STREAM == 0 {
        cuda_stream_create(&YKN_CUDA_STREAM);
    }

    degisken cap_st: tamsayi = 1;
    eger G_CUDA_GRAPH_READY == 0 and cuda_graph_is_supported() == 1 and YKN_CUDA_STREAM != 0 {
        cap_st = cuda_graph_begin_capture(YKN_CUDA_STREAM);
    }

    degisken layer_kv_stride: tamsayi = kv_cap * N_k * 8;
    degisken temp_dev: tamsayi = YKN_CUDA_IQ2S_OUT_DEVICE + 65536;
    degisken out_q_dev: tamsayi = YKN_CUDA_IQ2S_OUT_DEVICE;
    degisken out_k_dev: tamsayi = YKN_CUDA_IQ2S_OUT_DEVICE + N_q * 8;
    degisken out_v_dev: tamsayi = out_k_dev + N_k * 8;
    degisken attn_out_dev: tamsayi = YKN_CUDA_IQ2S_OUT_DEVICE + 32768;
    YKN_CUDA_IQ2S_OUT_DEVICE_2 = YKN_CUDA_IQ2S_OUT_DEVICE + N_ffn * 8;
    eger G_CFG_WARMED != 2 {
        cuda_make_1d_config_stream(1, 256, YKN_CUDA_STREAM, G_CFG_1_256);
        cuda_make_1d_config_stream((N_q + 7) / 8, 128, YKN_CUDA_STREAM, G_CFG_Q);
        cuda_make_1d_config_stream((N_k + 7) / 8, 128, YKN_CUDA_STREAM, G_CFG_KV);
        cuda_make_1d_config_stream(qh_val, 128, YKN_CUDA_STREAM, G_CFG_ATTN);
        cuda_make_1d_config_stream((K_val + 7) / 8, 128, YKN_CUDA_STREAM, G_CFG_O);
        cuda_make_1d_config_stream((N_ffn_val + 7) / 8, 128, YKN_CUDA_STREAM, G_CFG_GU);
        cuda_make_1d_config_stream((K_val + 7) / 8, 128, YKN_CUDA_STREAM, G_CFG_DOWN);
        cuda_make_1d_config_stream(4008, 128, YKN_CUDA_STREAM, G_CFG_F16);
        G_CFG_WARMED = 2;
    }
    degisken launch_ex: *u8 = YKN_CUDA_LAUNCH_EX;
    eger launch_ex == 0 and YKN_CUDA_CONTEXT_PTR != 0 { launch_ex = YKN_CUDA_CONTEXT_PTR.cu_launch_kernel_ex; YKN_CUDA_LAUNCH_EX = launch_ex; }

    degisken kat: tamsayi = 0;
    dongu kat < total_layers {
        degisken base: tamsayi = kat * 20;
        degisken attn_n_dev: tamsayi = G_BITNET_LAYER_PARAMS[base + 0];
        degisken q_w_dev: tamsayi = G_BITNET_LAYER_PARAMS[base + 1];
        degisken q_s_val: tamsayi = G_BITNET_LAYER_PARAMS[base + 2];
        degisken k_w_dev: tamsayi = G_BITNET_LAYER_PARAMS[base + 3];
        degisken k_s_val: tamsayi = G_BITNET_LAYER_PARAMS[base + 4];
        degisken v_w_dev: tamsayi = G_BITNET_LAYER_PARAMS[base + 5];
        degisken v_s_val: tamsayi = G_BITNET_LAYER_PARAMS[base + 6];
        degisken attn_sn_dev: tamsayi = G_BITNET_LAYER_PARAMS[base + 7];
        degisken o_w_dev: tamsayi = G_BITNET_LAYER_PARAMS[base + 8];
        degisken o_s_val: tamsayi = G_BITNET_LAYER_PARAMS[base + 9];
        degisken ffn_n_dev: tamsayi = G_BITNET_LAYER_PARAMS[base + 10];
        degisken g_w_dev: tamsayi = G_BITNET_LAYER_PARAMS[base + 11];
        degisken g_s_val: tamsayi = G_BITNET_LAYER_PARAMS[base + 12];
        degisken u_w_dev: tamsayi = G_BITNET_LAYER_PARAMS[base + 13];
        degisken u_s_val: tamsayi = G_BITNET_LAYER_PARAMS[base + 14];
        degisken ffn_sn_dev: tamsayi = G_BITNET_LAYER_PARAMS[base + 15];
        degisken d_w_dev: tamsayi = G_BITNET_LAYER_PARAMS[base + 16];
        degisken d_s_val: tamsayi = G_BITNET_LAYER_PARAMS[base + 17];

        # 1. attn RMSNorm + Quant
        degisken params_n: [7]*u8;
        params_n[0] = &YKN_CUDA_RESIDUAL_DEVICE;
        params_n[1] = &attn_n_dev;
        params_n[2] = &temp_dev;
        params_n[3] = &YKN_CUDA_IQ2S_ACT_DEVICE;
        params_n[4] = &YKN_CUDA_AMAX_DEVICE;
        params_n[5] = &K_val;
        params_n[6] = &eps_val;
        ykn_dyn_call_ptr_4(launch_ex, G_CFG_1_256, G_KER_RMSNORM_QUANT, params_n, 0);

        # 2. Q MatVec
        degisken params_q: [7]*u8;
        params_q[0] = &q_w_dev;
        params_q[1] = &YKN_CUDA_IQ2S_ACT_DEVICE;
        params_q[2] = &out_q_dev;
        params_q[3] = &K_val;
        params_q[4] = &N_q;
        params_q[5] = &YKN_CUDA_AMAX_DEVICE;
        params_q[6] = &q_s_val;
        ykn_dyn_call_ptr_4(launch_ex, G_CFG_Q, G_KER_BITNET_I2S_DEV_AMAX, params_q, 0);

        # 3. KV MatVec
        degisken params_kv: [10]*u8;
        params_kv[0] = &k_w_dev;
        params_kv[1] = &v_w_dev;
        params_kv[2] = &YKN_CUDA_IQ2S_ACT_DEVICE;
        params_kv[3] = &out_k_dev;
        params_kv[4] = &out_v_dev;
        params_kv[5] = &K_val;
        params_kv[6] = &N_k;
        params_kv[7] = &YKN_CUDA_AMAX_DEVICE;
        params_kv[8] = &k_s_val;
        params_kv[9] = &v_s_val;
        ykn_dyn_call_ptr_4(launch_ex, G_CFG_KV, G_KER_GATE_UP_DEV_AMAX, params_kv, 0);

        # 4. RoPE + KV Cache Write (STATIC)
        degisken k_layer_dev: tamsayi = YKN_CUDA_KV_K_DEVICE + kat * layer_kv_stride;
        degisken v_layer_dev: tamsayi = YKN_CUDA_KV_V_DEVICE + kat * layer_kv_stride;

        degisken params_rope: [11]*u8;
        params_rope[0] = &out_q_dev;
        params_rope[1] = &out_k_dev;
        params_rope[2] = &out_v_dev;
        params_rope[3] = &YKN_CUDA_ROPE_COS_DEVICE;
        params_rope[4] = &YKN_CUDA_ROPE_SIN_DEVICE;
        params_rope[5] = &k_layer_dev;
        params_rope[6] = &v_layer_dev;
        params_rope[7] = &qh_val;
        params_rope[8] = &kvh_val;
        params_rope[9] = &hd_val;
        params_rope[10] = &YKN_CUDA_TOKEN_POS_DEVICE;
        ykn_dyn_call_ptr_4(launch_ex, G_CFG_1_256, G_KER_ROPE_KV_STATIC, params_rope, 0);

        # 5. Attention (STATIC)
        degisken params_attn: [9]*u8;
        params_attn[0] = &out_q_dev;
        params_attn[1] = &k_layer_dev;
        params_attn[2] = &v_layer_dev;
        params_attn[3] = &attn_out_dev;
        params_attn[4] = &qh_val;
        params_attn[5] = &kvh_val;
        params_attn[6] = &hd_val;
        params_attn[7] = &YKN_CUDA_TOKEN_POS_DEVICE;
        params_attn[8] = &sqrt_val;
        ykn_dyn_call_ptr_4(launch_ex, G_CFG_ATTN, G_KER_KV_ATTN_STATIC, params_attn, 0);

        # 6. attn_sub_norm + quant
        degisken params_sn1: [7]*u8;
        params_sn1[0] = &attn_out_dev;
        params_sn1[1] = &attn_sn_dev;
        params_sn1[2] = &YKN_CUDA_IQ2S_OUT_DEVICE_2;
        params_sn1[3] = &YKN_CUDA_IQ2S_ACT_DEVICE;
        params_sn1[4] = &YKN_CUDA_AMAX_DEVICE;
        params_sn1[5] = &K_val;
        params_sn1[6] = &eps_val;
        ykn_dyn_call_ptr_4(launch_ex, G_CFG_1_256, G_KER_RMSNORM_QUANT, params_sn1, 0);

        # 7. O MatVec
        degisken params_o: [7]*u8;
        params_o[0] = &o_w_dev;
        params_o[1] = &YKN_CUDA_IQ2S_ACT_DEVICE;
        params_o[2] = &YKN_CUDA_IQ2S_OUT_DEVICE;
        params_o[3] = &K_val;
        params_o[4] = &K_val;
        params_o[5] = &YKN_CUDA_AMAX_DEVICE;
        params_o[6] = &o_s_val;
        ykn_dyn_call_ptr_4(launch_ex, G_CFG_O, G_KER_BITNET_I2S_DEV_AMAX, params_o, 0);

        # 8. res_add + ffn_norm + quant
        degisken params_rn: [8]*u8;
        params_rn[0] = &YKN_CUDA_IQ2S_OUT_DEVICE;
        params_rn[1] = &YKN_CUDA_RESIDUAL_DEVICE;
        params_rn[2] = &ffn_n_dev;
        params_rn[3] = &YKN_CUDA_IQ2S_OUT_DEVICE_2;
        params_rn[4] = &YKN_CUDA_IQ2S_ACT_DEVICE;
        params_rn[5] = &YKN_CUDA_AMAX_DEVICE;
        params_rn[6] = &K_val;
        params_rn[7] = &eps_val;
        ykn_dyn_call_ptr_4(launch_ex, G_CFG_1_256, G_KER_RES_ADD_RMSNORM_QUANT, params_rn, 0);

        # 9. Gate+Up MatVec
        degisken params_gu: [10]*u8;
        params_gu[0] = &g_w_dev;
        params_gu[1] = &u_w_dev;
        params_gu[2] = &YKN_CUDA_IQ2S_ACT_DEVICE;
        params_gu[3] = &YKN_CUDA_IQ2S_OUT_DEVICE;
        params_gu[4] = &YKN_CUDA_IQ2S_OUT_DEVICE_2;
        params_gu[5] = &K_val;
        params_gu[6] = &N_ffn_val;
        params_gu[7] = &YKN_CUDA_AMAX_DEVICE;
        params_gu[8] = &g_s_val;
        params_gu[9] = &u_s_val;
        ykn_dyn_call_ptr_4(launch_ex, G_CFG_GU, G_KER_GATE_UP_DEV_AMAX, params_gu, 0);

        # 10. SwiGLU + ffn_sub_norm + quant
        degisken params_srq: [8]*u8;
        params_srq[0] = &YKN_CUDA_IQ2S_OUT_DEVICE;
        params_srq[1] = &YKN_CUDA_IQ2S_OUT_DEVICE_2;
        params_srq[2] = &YKN_CUDA_SILU_LUT_DEVICE;
        params_srq[3] = &ffn_sn_dev;
        params_srq[4] = &YKN_CUDA_IQ2S_ACT_DEVICE;
        params_srq[5] = &YKN_CUDA_AMAX_DEVICE;
        params_srq[6] = &N_ffn_val;
        params_srq[7] = &eps_val;
        ykn_dyn_call_ptr_4(launch_ex, G_CFG_1_256, G_KER_SRQ, params_srq, 0);

        # 11. Down MatVec + res_add
        degisken p_res_in3: tamsayi = YKN_CUDA_RESIDUAL_DEVICE;
        degisken p_res_out3: tamsayi = YKN_CUDA_RESIDUAL_DEVICE;
        degisken params_down: [8]*u8;
        params_down[0] = &d_w_dev;
        params_down[1] = &YKN_CUDA_IQ2S_ACT_DEVICE;
        params_down[2] = &p_res_in3;
        params_down[3] = &p_res_out3;
        params_down[4] = &N_ffn_val;
        params_down[5] = &K_val;
        params_down[6] = &YKN_CUDA_AMAX_DEVICE;
        params_down[7] = &d_s_val;
        ykn_dyn_call_ptr_4(launch_ex, G_CFG_DOWN, G_KER_DEV_AMAX_RES_ADD, params_down, 0);

        kat = kat + 1;
    }

    eger cap_st == CUDA_SUCCESS and G_FINAL_NORM_DEV != 0 {
        eger YKN_CUDA_F16_ACT_DEVICE == 0 or YKN_CUDA_F16_ACT_CAPACITY < K_val * 8 {
            eger YKN_CUDA_F16_ACT_DEVICE != 0 { cuda_buffer_free(YKN_CUDA_CONTEXT_PTR, YKN_CUDA_F16_ACT_DEVICE); }
            cuda_buffer_alloc(YKN_CUDA_CONTEXT_PTR, K_val * 8, &YKN_CUDA_F16_ACT_DEVICE);
            YKN_CUDA_F16_ACT_CAPACITY = K_val * 8;
        }
        degisken params_fn: [5]*u8;
        params_fn[0] = &YKN_CUDA_RESIDUAL_DEVICE;
        params_fn[1] = &G_FINAL_NORM_DEV;
        params_fn[2] = &YKN_CUDA_F16_ACT_DEVICE;
        params_fn[3] = &K_val;
        params_fn[4] = &eps_val;
        ykn_dyn_call_ptr_4(launch_ex, G_CFG_1_256, G_KER_RMSNORM, params_fn, 0);
        G_CUDA_GRAPH_HAS_FINAL_NORM = 1;
    }

    eger cap_st == CUDA_SUCCESS {
        degisken new_graph: tamsayi = 0;
        degisken end_st: tamsayi = cuda_graph_end_capture(YKN_CUDA_STREAM, &new_graph);
        eger end_st == CUDA_SUCCESS and new_graph != 0 {
            degisken new_exec: tamsayi = 0;
            degisken inst_st: tamsayi = cuda_graph_instantiate(&new_exec, new_graph);
            eger inst_st == CUDA_SUCCESS and new_exec != 0 {
                G_CUDA_GRAPH = new_graph;
                G_CUDA_GRAPH_EXEC = new_exec;
                G_CUDA_GRAPH_READY = 1;
                cuda_graph_launch(new_exec, YKN_CUDA_STREAM);
            }
        }
    }

    YKN_CUDA_ATTN_ON_GPU = 0;
    YKN_CUDA_HIDDEN_ON_GPU = 1;
    ykn_cuda_clear_act_cache();
    G_STEP_ALL_LAYERS_COUNT = G_STEP_ALL_LAYERS_COUNT + 1;
    dondu 1;
}

# ============================================================
# Multi-Batch GPU Slot Yönetimi
# Her batch slotu kendi bağımsız Stream, KV-Cache, Residual ve
# CUDA Graph nesnesine sahip olur; model ağırlıkları ortaktır.
# ============================================================
degisken G_BATCH_ACTIVE_SLOT: tamsayi = 0;
degisken G_BSLOT_STREAM: [8]tamsayi;
degisken G_BSLOT_GRAPH: [8]tamsayi;
degisken G_BSLOT_GRAPH_EXEC: [8]tamsayi;
degisken G_BSLOT_GRAPH_READY: [8]tamsayi;
degisken G_BSLOT_GRAPH_HAS_FINAL_NORM: [8]tamsayi;
degisken G_BSLOT_TOKEN_POS_DEVICE: [8]tamsayi;
degisken G_BSLOT_RESIDUAL_DEVICE: [8]tamsayi;
degisken G_BSLOT_RESIDUAL_CAPACITY: [8]tamsayi;
degisken G_BSLOT_HIDDEN_ON_GPU: [8]tamsayi;
degisken G_BSLOT_ATTN_ON_GPU: [8]tamsayi;
degisken G_BSLOT_KV_K_DEVICE: [8]tamsayi;
degisken G_BSLOT_KV_V_DEVICE: [8]tamsayi;
degisken G_BSLOT_KV_CAPACITY_BYTES: [8]tamsayi;
degisken G_BSLOT_IQ2S_OUT_DEVICE: [8]tamsayi;
degisken G_BSLOT_IQ2S_OUT_CAPACITY: [8]tamsayi;
degisken G_BSLOT_F16_ACT_DEVICE: [8]tamsayi;
degisken G_BSLOT_F16_ACT_CAPACITY: [8]tamsayi;
degisken G_BSLOT_F16_OUT_DEVICE: [8]tamsayi;
degisken G_BSLOT_F16_OUT_CAPACITY: [8]tamsayi;
degisken G_BSLOT_RECENT_DEVICE: [8]tamsayi;
degisken G_BSLOT_ARGMAX_OUT_DEVICE: [8]tamsayi;
degisken G_BSLOT_CFG_WARMED: [8]tamsayi;
degisken G_BSLOT_RECENT_COUNT: [8]tamsayi;
degisken G_BSLOT_RECENT_TOKENS: [2048]tamsayi;

isv ykn_cuda_save_slot_state(slot: tamsayi) {
    eger slot < 0 veya slot >= 8 { dondu; }
    G_BSLOT_RECENT_COUNT[slot] = LLM_RECENT_COUNT;
    degisken r_i: tamsayi = 0;
    dongu r_i < 256 {
        G_BSLOT_RECENT_TOKENS[slot * 256 + r_i] = LLM_RECENT_TOKENS[r_i];
        r_i = r_i + 1;
    }
    G_BSLOT_STREAM[slot] = YKN_CUDA_STREAM;
    G_BSLOT_GRAPH[slot] = G_CUDA_GRAPH;
    G_BSLOT_GRAPH_EXEC[slot] = G_CUDA_GRAPH_EXEC;
    G_BSLOT_GRAPH_READY[slot] = G_CUDA_GRAPH_READY;
    G_BSLOT_GRAPH_HAS_FINAL_NORM[slot] = G_CUDA_GRAPH_HAS_FINAL_NORM;
    G_BSLOT_TOKEN_POS_DEVICE[slot] = YKN_CUDA_TOKEN_POS_DEVICE;
    G_BSLOT_RESIDUAL_DEVICE[slot] = YKN_CUDA_RESIDUAL_DEVICE;
    G_BSLOT_RESIDUAL_CAPACITY[slot] = YKN_CUDA_RESIDUAL_CAPACITY;
    G_BSLOT_HIDDEN_ON_GPU[slot] = YKN_CUDA_HIDDEN_ON_GPU;
    G_BSLOT_ATTN_ON_GPU[slot] = YKN_CUDA_ATTN_ON_GPU;
    G_BSLOT_KV_K_DEVICE[slot] = YKN_CUDA_KV_K_DEVICE;
    G_BSLOT_KV_V_DEVICE[slot] = YKN_CUDA_KV_V_DEVICE;
    G_BSLOT_KV_CAPACITY_BYTES[slot] = YKN_CUDA_KV_CAPACITY_BYTES;
    G_BSLOT_IQ2S_OUT_DEVICE[slot] = YKN_CUDA_IQ2S_OUT_DEVICE;
    G_BSLOT_IQ2S_OUT_CAPACITY[slot] = YKN_CUDA_IQ2S_OUT_CAPACITY;
    G_BSLOT_F16_ACT_DEVICE[slot] = YKN_CUDA_F16_ACT_DEVICE;
    G_BSLOT_F16_ACT_CAPACITY[slot] = YKN_CUDA_F16_ACT_CAPACITY;
    G_BSLOT_F16_OUT_DEVICE[slot] = YKN_CUDA_F16_OUT_DEVICE;
    G_BSLOT_F16_OUT_CAPACITY[slot] = YKN_CUDA_F16_OUT_CAPACITY;
    G_BSLOT_RECENT_DEVICE[slot] = YKN_CUDA_RECENT_DEVICE;
    G_BSLOT_ARGMAX_OUT_DEVICE[slot] = YKN_CUDA_ARGMAX_OUT_DEVICE;
    G_BSLOT_CFG_WARMED[slot] = G_CFG_WARMED;
}

isv ykn_cuda_load_slot_state(slot: tamsayi) {
    eger slot < 0 veya slot >= 8 { dondu; }
    LLM_RECENT_COUNT = G_BSLOT_RECENT_COUNT[slot];
    degisken r_i2: tamsayi = 0;
    dongu r_i2 < 256 {
        LLM_RECENT_TOKENS[r_i2] = G_BSLOT_RECENT_TOKENS[slot * 256 + r_i2];
        r_i2 = r_i2 + 1;
    }
    YKN_CUDA_STREAM = G_BSLOT_STREAM[slot];
    G_CUDA_GRAPH = G_BSLOT_GRAPH[slot];
    G_CUDA_GRAPH_EXEC = G_BSLOT_GRAPH_EXEC[slot];
    G_CUDA_GRAPH_READY = G_BSLOT_GRAPH_READY[slot];
    G_CUDA_GRAPH_HAS_FINAL_NORM = G_BSLOT_GRAPH_HAS_FINAL_NORM[slot];
    YKN_CUDA_TOKEN_POS_DEVICE = G_BSLOT_TOKEN_POS_DEVICE[slot];
    YKN_CUDA_RESIDUAL_DEVICE = G_BSLOT_RESIDUAL_DEVICE[slot];
    YKN_CUDA_RESIDUAL_CAPACITY = G_BSLOT_RESIDUAL_CAPACITY[slot];
    YKN_CUDA_HIDDEN_ON_GPU = G_BSLOT_HIDDEN_ON_GPU[slot];
    YKN_CUDA_ATTN_ON_GPU = G_BSLOT_ATTN_ON_GPU[slot];
    YKN_CUDA_KV_K_DEVICE = G_BSLOT_KV_K_DEVICE[slot];
    YKN_CUDA_KV_V_DEVICE = G_BSLOT_KV_V_DEVICE[slot];
    YKN_CUDA_KV_CAPACITY_BYTES = G_BSLOT_KV_CAPACITY_BYTES[slot];
    YKN_CUDA_IQ2S_OUT_DEVICE = G_BSLOT_IQ2S_OUT_DEVICE[slot];
    YKN_CUDA_IQ2S_OUT_CAPACITY = G_BSLOT_IQ2S_OUT_CAPACITY[slot];
    YKN_CUDA_F16_ACT_DEVICE = G_BSLOT_F16_ACT_DEVICE[slot];
    YKN_CUDA_F16_ACT_CAPACITY = G_BSLOT_F16_ACT_CAPACITY[slot];
    YKN_CUDA_F16_OUT_DEVICE = G_BSLOT_F16_OUT_DEVICE[slot];
    YKN_CUDA_F16_OUT_CAPACITY = G_BSLOT_F16_OUT_CAPACITY[slot];
    YKN_CUDA_RECENT_DEVICE = G_BSLOT_RECENT_DEVICE[slot];
    YKN_CUDA_ARGMAX_OUT_DEVICE = G_BSLOT_ARGMAX_OUT_DEVICE[slot];
    G_CFG_WARMED = G_BSLOT_CFG_WARMED[slot];
    G_BATCH_ACTIVE_SLOT = slot;
}

isv ykn_cuda_set_batch_slot(slot: tamsayi) {
    eger slot == G_BATCH_ACTIVE_SLOT { dondu; }
    ykn_cuda_save_slot_state(G_BATCH_ACTIVE_SLOT);
    ykn_cuda_load_slot_state(slot);
}

isv ykn_cuda_init_batch_slot(slot: tamsayi, kv_bytes: tamsayi) -> tamsayi {
    eger slot < 0 veya slot >= 8 veya YKN_CUDA_READY != 1 { dondu 0; }
    ykn_cuda_save_slot_state(G_BATCH_ACTIVE_SLOT);

    # Stream olustur
    degisken strm: tamsayi = G_BSLOT_STREAM[slot];
    eger strm == 0 {
        cuda_stream_create(&strm);
        G_BSLOT_STREAM[slot] = strm;
    }

    # KV Cache K ve V tahsis et
    degisken k_dev: tamsayi = G_BSLOT_KV_K_DEVICE[slot];
    degisken v_dev: tamsayi = G_BSLOT_KV_V_DEVICE[slot];
    eger k_dev == 0 {
        cuda_buffer_alloc(YKN_CUDA_CONTEXT_PTR, kv_bytes, &k_dev);
        cuda_buffer_alloc(YKN_CUDA_CONTEXT_PTR, kv_bytes, &v_dev);
        G_BSLOT_KV_K_DEVICE[slot] = k_dev;
        G_BSLOT_KV_V_DEVICE[slot] = v_dev;
        G_BSLOT_KV_CAPACITY_BYTES[slot] = kv_bytes;
    }

    # Token pos device
    degisken pos_dev: tamsayi = G_BSLOT_TOKEN_POS_DEVICE[slot];
    eger pos_dev == 0 {
        cuda_buffer_alloc(YKN_CUDA_CONTEXT_PTR, 64, &pos_dev);
        G_BSLOT_TOKEN_POS_DEVICE[slot] = pos_dev;
    }

    # Residual device
    degisken res_dev: tamsayi = G_BSLOT_RESIDUAL_DEVICE[slot];
    eger res_dev == 0 {
        cuda_buffer_alloc(YKN_CUDA_CONTEXT_PTR, 2560 * 8, &res_dev);
        G_BSLOT_RESIDUAL_DEVICE[slot] = res_dev;
        G_BSLOT_RESIDUAL_CAPACITY[slot] = 2560 * 8;
    }

    # Scratch device (IQ2S out)
    degisken iq_out: tamsayi = G_BSLOT_IQ2S_OUT_DEVICE[slot];
    eger iq_out == 0 {
        cuda_buffer_alloc(YKN_CUDA_CONTEXT_PTR, 131072, &iq_out);
        G_BSLOT_IQ2S_OUT_DEVICE[slot] = iq_out;
        G_BSLOT_IQ2S_OUT_CAPACITY[slot] = 131072;
    }

    # F16 ACT device
    degisken f16_act: tamsayi = G_BSLOT_F16_ACT_DEVICE[slot];
    eger f16_act == 0 {
        cuda_buffer_alloc(YKN_CUDA_CONTEXT_PTR, 2560 * 8, &f16_act);
        G_BSLOT_F16_ACT_DEVICE[slot] = f16_act;
        G_BSLOT_F16_ACT_CAPACITY[slot] = 2560 * 8;
    }

    # F16 OUT device
    degisken f16_out: tamsayi = G_BSLOT_F16_OUT_DEVICE[slot];
    eger f16_out == 0 {
        cuda_buffer_alloc(YKN_CUDA_CONTEXT_PTR, 128256 * 8, &f16_out);
        G_BSLOT_F16_OUT_DEVICE[slot] = f16_out;
        G_BSLOT_F16_OUT_CAPACITY[slot] = 128256 * 8;
    }

    # Recent device & Argmax out device
    degisken rec_dev: tamsayi = G_BSLOT_RECENT_DEVICE[slot];
    eger rec_dev == 0 {
        cuda_buffer_alloc(YKN_CUDA_CONTEXT_PTR, 256 * 8, &rec_dev);
        G_BSLOT_RECENT_DEVICE[slot] = rec_dev;
    }
    degisken arg_dev: tamsayi = G_BSLOT_ARGMAX_OUT_DEVICE[slot];
    eger arg_dev == 0 {
        cuda_buffer_alloc(YKN_CUDA_CONTEXT_PTR, 8, &arg_dev);
        G_BSLOT_ARGMAX_OUT_DEVICE[slot] = arg_dev;
    }

    ykn_cuda_load_slot_state(G_BATCH_ACTIVE_SLOT);
    dondu 1;
}
