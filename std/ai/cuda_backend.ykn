        YKN_CUDA_IQ2S_OUT_CAPACITY = N * 8;
    }
    status = cuda_copy_to_device(YKN_CUDA_CONTEXT_PTR, YKN_CUDA_IQ2S_ACT_DEVICE, YKN_CUDA_I2S_QACT.ptr, K * 8);
    eger status == CUDA_SUCCESS {
        degisken params: [7]*u8;
        params[0] = &gpu_weights; params[1] = &YKN_CUDA_IQ2S_ACT_DEVICE;
        params[2] = &YKN_CUDA_IQ2S_OUT_DEVICE; params[3] = &K; params[4] = &N;
        params[5] = &amax; params[6] = &scale_q16;
        status = cuda_ptx_launch_1d(YKN_CUDA_CONTEXT_PTR, ykn_cuda_bitnet_i2s_ptx(),
            "ykn_bitnet_i2s_matvec".ptr, params, (N + 3) / 4, 128);
    }
    eger status == CUDA_SUCCESS {
        status = cuda_copy_to_host(YKN_CUDA_CONTEXT_PTR, output, YKN_CUDA_IQ2S_OUT_DEVICE, N * 8);
    }
    YKN_CUDA_LAST_ERROR = status;
    eger status != CUDA_SUCCESS { dondu 0; }
    YKN_CUDA_I2S_CALLS = YKN_CUDA_I2S_CALLS + 1;
    dondu 1;
}

isv ykn_cuda_get_iq2s_cached_weight(cache_key: tamsayi, packed_bytes: tamsayi,
                                    out_weights: *tamsayi, out_scale: *tamsayi) -> tamsayi {
    degisken slot: tamsayi = (cache_key ^ (cache_key / 256)) & 511;
    degisken probe: tamsayi = 0;
    dongu probe < 8 {
        degisken cur: tamsayi = (slot + probe) & 511;
        eger YKN_CUDA_WEIGHT_HASH_INIT[cur] == 1 and YKN_CUDA_WEIGHT_HASH_KEY[cur] == cache_key {
            out_weights[0] = YKN_CUDA_WEIGHT_HASH_PTR[cur];
            out_scale[0] = YKN_CUDA_WEIGHT_HASH_SCALE[cur];
            dondu 1;
        }
        eger YKN_CUDA_WEIGHT_HASH_INIT[cur] == 0 { durdur; }
        probe = probe + 1;
    }
    degisken i: tamsayi = 0;
    dongu i < YKN_CUDA_IQ2S_WEIGHT_CACHE_COUNT {
        eger YKN_CUDA_IQ2S_WEIGHT_CACHE_KEYS[i] == cache_key and
           YKN_CUDA_IQ2S_WEIGHT_CACHE_BYTES[i] == packed_bytes {
            out_weights[0] = YKN_CUDA_IQ2S_WEIGHT_CACHE_PTRS[i];
            out_scale[0] = YKN_CUDA_IQ2S_WEIGHT_CACHE_SCALES[i];
            dondu 1;
        }
        i = i + 1;
    }
    dondu 0;
}

isv ykn_cuda_bitnet_i2s_qkv(q_key: tamsayi, q_bytes: tamsayi, N_q: tamsayi, out_q: *tamsayi,
                            k_key: tamsayi, k_bytes: tamsayi, N_k: tamsayi, out_k: *tamsayi,
                            v_key: tamsayi, v_bytes: tamsayi, N_v: tamsayi, out_v: *tamsayi,
                            activation: *tamsayi, K: tamsayi) -> tamsayi {
    degisken q_w: [1]tamsayi; degisken q_s: [1]tamsayi;
    degisken k_w: [1]tamsayi; degisken k_s: [1]tamsayi;
    degisken v_w: [1]tamsayi; degisken v_s: [1]tamsayi;
    eger ykn_cuda_get_iq2s_cached_weight(q_key, q_bytes, q_w, q_s) == 0 { dondu 0; }
    eger ykn_cuda_get_iq2s_cached_weight(k_key, k_bytes, k_w, k_s) == 0 { dondu 0; }
    eger ykn_cuda_get_iq2s_cached_weight(v_key, v_bytes, v_w, v_s) == 0 { dondu 0; }

    degisken amax: tamsayi = 0;
    degisken need_quant: tamsayi = 1;
    eger activation == YKN_CUDA_CACHED_ACT_PTR and K == YKN_CUDA_CACHED_ACT_K and YKN_CUDA_IQ2S_ACT_DEVICE != 0 {
        amax = YKN_CUDA_CACHED_ACT_AMAX;
        need_quant = 0;
    }
    eger need_quant == 1 {
        degisken t_cpu0: tamsayi = ykn_llm_clock_ns();
        eger g_llm_native_simd_aktif == 1 {
            amax = ykn_llm_f16_dot_q16(activation, YKN_CUDA_I2S_QACT.ptr, K);
        } yoksa {
            degisken i: tamsayi = 0;
            dongu i < K {
                degisken x: tamsayi = activation[i];
                eger x < 0 { x = 0 - x; }
                eger x > amax { amax = x; }
                i = i + 1;
            }
            degisken amax_half: tamsayi = amax / 2;
            i = 0;
            dongu i < K {
                degisken x: tamsayi = activation[i];
                degisken x_abs: tamsayi = x;
                degisken sign: tamsayi = 1;
                eger x < 0 { x_abs = 0 - x; sign = 0 - 1; }
                degisken q: tamsayi = 0;
                eger amax > 0 {
                    q = (x_abs * 127 + amax_half) / amax;
                    eger q > 127 { q = 127; }
                }
                YKN_CUDA_I2S_QACT[i] = q * sign;
                i = i + 1;
            }
        }
        degisken t_cpu1: tamsayi = ykn_llm_clock_ns();
        YKN_CUDA_I2S_CPU_NS = YKN_CUDA_I2S_CPU_NS + (t_cpu1 - t_cpu0);
    }

    degisken status: tamsayi = CUDA_SUCCESS;
    eger YKN_CUDA_IQ2S_ACT_DEVICE == 0 or YKN_CUDA_IQ2S_ACT_CAPACITY < K * 8 {
        eger YKN_CUDA_IQ2S_ACT_DEVICE != 0 { cuda_buffer_free(YKN_CUDA_CONTEXT_PTR, YKN_CUDA_IQ2S_ACT_DEVICE); }
        status = cuda_buffer_alloc(YKN_CUDA_CONTEXT_PTR, K * 8, &YKN_CUDA_IQ2S_ACT_DEVICE);
        eger status != CUDA_SUCCESS { dondu 0; }
        YKN_CUDA_IQ2S_ACT_CAPACITY = K * 8;
        need_quant = 1;
    }
    eger YKN_CUDA_IQ2S_OUT_DEVICE == 0 or YKN_CUDA_IQ2S_OUT_CAPACITY < N_q * 8 {
        eger YKN_CUDA_IQ2S_OUT_DEVICE != 0 { cuda_buffer_free(YKN_CUDA_CONTEXT_PTR, YKN_CUDA_IQ2S_OUT_DEVICE); }
        status = cuda_buffer_alloc(YKN_CUDA_CONTEXT_PTR, N_q * 8, &YKN_CUDA_IQ2S_OUT_DEVICE);
        eger status != CUDA_SUCCESS { dondu 0; }
        YKN_CUDA_IQ2S_OUT_CAPACITY = N_q * 8;
    }
    eger YKN_CUDA_IQ2S_OUT_DEVICE_2 == 0 or YKN_CUDA_IQ2S_OUT_CAPACITY_2 < N_k * 8 {
        eger YKN_CUDA_IQ2S_OUT_DEVICE_2 != 0 { cuda_buffer_free(YKN_CUDA_CONTEXT_PTR, YKN_CUDA_IQ2S_OUT_DEVICE_2); }
        status = cuda_buffer_alloc(YKN_CUDA_CONTEXT_PTR, N_k * 8, &YKN_CUDA_IQ2S_OUT_DEVICE_2);
        eger status != CUDA_SUCCESS { dondu 0; }
        YKN_CUDA_IQ2S_OUT_CAPACITY_2 = N_k * 8;
    }
    eger YKN_CUDA_IQ2S_OUT_DEVICE_3 == 0 or YKN_CUDA_IQ2S_OUT_CAPACITY_3 < N_v * 8 {
        eger YKN_CUDA_IQ2S_OUT_DEVICE_3 != 0 { cuda_buffer_free(YKN_CUDA_CONTEXT_PTR, YKN_CUDA_IQ2S_OUT_DEVICE_3); }
        status = cuda_buffer_alloc(YKN_CUDA_CONTEXT_PTR, N_v * 8, &YKN_CUDA_IQ2S_OUT_DEVICE_3);
        eger status != CUDA_SUCCESS { dondu 0; }
        YKN_CUDA_IQ2S_OUT_CAPACITY_3 = N_v * 8;
    }

    degisken t_gpu0: tamsayi = ykn_llm_clock_ns();
    eger need_quant == 1 {
        status = cuda_copy_to_device(YKN_CUDA_CONTEXT_PTR, YKN_CUDA_IQ2S_ACT_DEVICE, YKN_CUDA_I2S_QACT.ptr, K * 8);
        eger status == CUDA_SUCCESS {
            YKN_CUDA_CACHED_ACT_PTR = activation;
            YKN_CUDA_CACHED_ACT_K = K;
            YKN_CUDA_CACHED_ACT_AMAX = amax;
        }
    }

    degisken q_w_dev: tamsayi = q_w[0];
    degisken q_s_val: tamsayi = q_s[0];
    degisken k_w_dev: tamsayi = k_w[0];
    degisken k_s_val: tamsayi = k_s[0];
    degisken v_w_dev: tamsayi = v_w[0];
    degisken v_s_val: tamsayi = v_s[0];
    degisken N_q_val: tamsayi = N_q;
    degisken N_k_val: tamsayi = N_k;
    degisken N_v_val: tamsayi = N_v;
    degisken K_val: tamsayi = K;

    degisken params_q: [7]*u8;
    params_q[0] = &q_w_dev; params_q[1] = &YKN_CUDA_IQ2S_ACT_DEVICE;
    params_q[2] = &YKN_CUDA_IQ2S_OUT_DEVICE; params_q[3] = &K_val; params_q[4] = &N_q_val;
    params_q[5] = &amax; params_q[6] = &q_s_val;
    status = cuda_ptx_launch_1d(YKN_CUDA_CONTEXT_PTR, ykn_cuda_bitnet_i2s_ptx(),
        "ykn_bitnet_i2s_matvec".ptr, params_q, (N_q + 7) / 8, 128);
    eger status != CUDA_SUCCESS { dondu 0; }

    eger N_k_val == N_v_val {
        degisken params_kv: [10]*u8;
        params_kv[0] = &k_w_dev; params_kv[1] = &v_w_dev;
        params_kv[2] = &YKN_CUDA_IQ2S_ACT_DEVICE;
        params_kv[3] = &YKN_CUDA_IQ2S_OUT_DEVICE_2; params_kv[4] = &YKN_CUDA_IQ2S_OUT_DEVICE_3;
        params_kv[5] = &K_val; params_kv[6] = &N_k_val;
        params_kv[7] = &amax;
        params_kv[8] = &k_s_val; params_kv[9] = &v_s_val;
        status = cuda_ptx_launch_1d(YKN_CUDA_CONTEXT_PTR, ykn_cuda_bitnet_i2s_gate_up_ptx(),
            "ykn_bitnet_i2s_matvec_gate_up".ptr, params_kv, (N_k + 7) / 8, 128);
        eger status != CUDA_SUCCESS { dondu 0; }
    } yoksa {
        degisken params_k: [7]*u8;
        params_k[0] = &k_w_dev; params_k[1] = &YKN_CUDA_IQ2S_ACT_DEVICE;
        params_k[2] = &YKN_CUDA_IQ2S_OUT_DEVICE_2; params_k[3] = &K_val; params_k[4] = &N_k_val;
        params_k[5] = &amax; params_k[6] = &k_s_val;
        status = cuda_ptx_launch_1d(YKN_CUDA_CONTEXT_PTR, ykn_cuda_bitnet_i2s_ptx(),
            "ykn_bitnet_i2s_matvec".ptr, params_k, (N_k + 3) / 4, 128);
        eger status != CUDA_SUCCESS { dondu 0; }

        degisken params_v: [7]*u8;
        params_v[0] = &v_w_dev; params_v[1] = &YKN_CUDA_IQ2S_ACT_DEVICE;
        params_v[2] = &YKN_CUDA_IQ2S_OUT_DEVICE_3; params_v[3] = &K_val; params_v[4] = &N_v_val;
        params_v[5] = &amax; params_v[6] = &v_s_val;
        status = cuda_ptx_launch_1d(YKN_CUDA_CONTEXT_PTR, ykn_cuda_bitnet_i2s_ptx(),
            "ykn_bitnet_i2s_matvec".ptr, params_v, (N_v + 3) / 4, 128);
        eger status != CUDA_SUCCESS { dondu 0; }
    }

    status = cuda_copy_to_host(YKN_CUDA_CONTEXT_PTR, out_q, YKN_CUDA_IQ2S_OUT_DEVICE, N_q * 8);
    eger status != CUDA_SUCCESS { dondu 0; }
    status = cuda_copy_to_host(YKN_CUDA_CONTEXT_PTR, out_k, YKN_CUDA_IQ2S_OUT_DEVICE_2, N_k * 8);
    eger status != CUDA_SUCCESS { dondu 0; }
    status = cuda_copy_to_host(YKN_CUDA_CONTEXT_PTR, out_v, YKN_CUDA_IQ2S_OUT_DEVICE_3, N_v * 8);
    eger status != CUDA_SUCCESS { dondu 0; }

    degisken t_gpu1: tamsayi = ykn_llm_clock_ns();
    YKN_CUDA_I2S_GPU_NS = YKN_CUDA_I2S_GPU_NS + (t_gpu1 - t_gpu0);
    YKN_CUDA_I2S_CALLS = YKN_CUDA_I2S_CALLS + 2;
    dondu 1;
}

isv ykn_cuda_bitnet_i2s_gate_up(gate_key: tamsayi, gate_bytes: tamsayi,
                                up_key: tamsayi, up_bytes: tamsayi,
                                N: tamsayi, out_gate: *tamsayi, out_up: *tamsayi,
                                activation: *tamsayi, K: tamsayi) -> tamsayi {
    degisken g_w: [1]tamsayi; degisken g_s: [1]tamsayi;
    degisken u_w: [1]tamsayi; degisken u_s: [1]tamsayi;
    eger ykn_cuda_get_iq2s_cached_weight(gate_key, gate_bytes, g_w, g_s) == 0 { dondu 0; }
    eger ykn_cuda_get_iq2s_cached_weight(up_key, up_bytes, u_w, u_s) == 0 { dondu 0; }

    degisken amax: tamsayi = 0;
    degisken need_quant: tamsayi = 1;
    eger activation == YKN_CUDA_CACHED_ACT_PTR and K == YKN_CUDA_CACHED_ACT_K and YKN_CUDA_IQ2S_ACT_DEVICE != 0 {
        amax = YKN_CUDA_CACHED_ACT_AMAX;
        need_quant = 0;
    }
    eger need_quant == 1 {
        degisken t_cpu0: tamsayi = ykn_llm_clock_ns();
        eger g_llm_native_simd_aktif == 1 {
            amax = ykn_llm_f16_dot_q16(activation, YKN_CUDA_I2S_QACT.ptr, K);
        } yoksa {
            degisken i: tamsayi = 0;
            dongu i < K {
                degisken x: tamsayi = activation[i];
                eger x < 0 { x = 0 - x; }
                eger x > amax { amax = x; }
                i = i + 1;
            }
            degisken amax_half: tamsayi = amax / 2;
            i = 0;
            dongu i < K {
                degisken x: tamsayi = activation[i];
                degisken x_abs: tamsayi = x;
                degisken sign: tamsayi = 1;
                eger x < 0 { x_abs = 0 - x; sign = 0 - 1; }
                degisken q: tamsayi = 0;
                eger amax > 0 {
                    q = (x_abs * 127 + amax_half) / amax;
                    eger q > 127 { q = 127; }
                }
                YKN_CUDA_I2S_QACT[i] = q * sign;
                i = i + 1;
            }
        }
        degisken t_cpu1: tamsayi = ykn_llm_clock_ns();
        YKN_CUDA_I2S_CPU_NS = YKN_CUDA_I2S_CPU_NS + (t_cpu1 - t_cpu0);
    }

    degisken status: tamsayi = CUDA_SUCCESS;
    eger YKN_CUDA_IQ2S_ACT_DEVICE == 0 or YKN_CUDA_IQ2S_ACT_CAPACITY < K * 8 {
        eger YKN_CUDA_IQ2S_ACT_DEVICE != 0 { cuda_buffer_free(YKN_CUDA_CONTEXT_PTR, YKN_CUDA_IQ2S_ACT_DEVICE); }
        status = cuda_buffer_alloc(YKN_CUDA_CONTEXT_PTR, K * 8, &YKN_CUDA_IQ2S_ACT_DEVICE);
        eger status != CUDA_SUCCESS { dondu 0; }
        YKN_CUDA_IQ2S_ACT_CAPACITY = K * 8;
        need_quant = 1;
    }
    eger YKN_CUDA_IQ2S_OUT_DEVICE == 0 or YKN_CUDA_IQ2S_OUT_CAPACITY < 2 * N * 8 {
        eger YKN_CUDA_IQ2S_OUT_DEVICE != 0 { cuda_buffer_free(YKN_CUDA_CONTEXT_PTR, YKN_CUDA_IQ2S_OUT_DEVICE); }
        status = cuda_buffer_alloc(YKN_CUDA_CONTEXT_PTR, 2 * N * 8, &YKN_CUDA_IQ2S_OUT_DEVICE);
        eger status != CUDA_SUCCESS { dondu 0; }
        YKN_CUDA_IQ2S_OUT_CAPACITY = 2 * N * 8;
    }
    YKN_CUDA_IQ2S_OUT_DEVICE_2 = YKN_CUDA_IQ2S_OUT_DEVICE + N * 8;

    degisken t_gpu0: tamsayi = ykn_llm_clock_ns();
    eger need_quant == 1 {
        status = cuda_copy_to_device(YKN_CUDA_CONTEXT_PTR, YKN_CUDA_IQ2S_ACT_DEVICE, YKN_CUDA_I2S_QACT.ptr, K * 8);
        eger status == CUDA_SUCCESS {
            YKN_CUDA_CACHED_ACT_PTR = activation;
            YKN_CUDA_CACHED_ACT_K = K;
            YKN_CUDA_CACHED_ACT_AMAX = amax;
        }
    }

    degisken g_w_dev: tamsayi = g_w[0];
    degisken g_s_val: tamsayi = g_s[0];
    degisken u_w_dev: tamsayi = u_w[0];
    degisken u_s_val: tamsayi = u_s[0];
    degisken N_val: tamsayi = N;
    degisken K_val: tamsayi = K;

    degisken params_fused: [10]*u8;
    params_fused[0] = &g_w_dev;
    params_fused[1] = &u_w_dev;
    params_fused[2] = &YKN_CUDA_IQ2S_ACT_DEVICE;
    params_fused[3] = &YKN_CUDA_IQ2S_OUT_DEVICE;
    params_fused[4] = &YKN_CUDA_IQ2S_OUT_DEVICE_2;
    params_fused[5] = &K_val;
    params_fused[6] = &N_val;
    params_fused[7] = &amax;
    params_fused[8] = &g_s_val;
    params_fused[9] = &u_s_val;
    status = cuda_ptx_launch_1d(YKN_CUDA_CONTEXT_PTR, ykn_cuda_bitnet_i2s_gate_up_ptx(),
        "ykn_bitnet_i2s_matvec_gate_up".ptr, params_fused, (N + 3) / 4, 128);
    eger status != CUDA_SUCCESS { dondu 0; }

    eger YKN_CUDA_SILU_LUT_DEVICE != 0 {
        degisken p_out1: tamsayi = YKN_CUDA_IQ2S_OUT_DEVICE;
        degisken p_out2: tamsayi = YKN_CUDA_IQ2S_OUT_DEVICE_2;
        degisken p_out3: tamsayi = YKN_CUDA_IQ2S_OUT_DEVICE;
        degisken p_silu: tamsayi = YKN_CUDA_SILU_LUT_DEVICE;
        degisken params_sw: [5]*u8;
        params_sw[0] = &p_out1;
        params_sw[1] = &p_out2;
        params_sw[2] = &p_out3;
        params_sw[3] = &p_silu;
        params_sw[4] = &N_val;
        status = cuda_ptx_launch_1d(YKN_CUDA_CONTEXT_PTR, ykn_cuda_swiglu_ptx(),
            "ykn_swiglu_lut".ptr, params_sw, (N + 255) / 256, 256);
        eger status != CUDA_SUCCESS { dondu 0; }

        status = cuda_copy_to_host(YKN_CUDA_CONTEXT_PTR, out_gate, YKN_CUDA_IQ2S_OUT_DEVICE, N * 8);
        eger status != CUDA_SUCCESS { dondu 0; }

        degisken t_gpu1: tamsayi = ykn_llm_clock_ns();
        YKN_CUDA_I2S_GPU_NS = YKN_CUDA_I2S_GPU_NS + (t_gpu1 - t_gpu0);
        YKN_CUDA_I2S_CALLS = YKN_CUDA_I2S_CALLS + 2;
        dondu 2;
    } yoksa {
        degisken p_gate: tamsayi = out_gate as tamsayi;
        degisken p_up: tamsayi = out_up as tamsayi;
        eger p_up == p_gate + N * 8 {
            status = cuda_copy_to_host(YKN_CUDA_CONTEXT_PTR, out_gate, YKN_CUDA_IQ2S_OUT_DEVICE, 2 * N * 8);
            eger status != CUDA_SUCCESS { dondu 0; }
        } yoksa {
            status = cuda_copy_to_host(YKN_CUDA_CONTEXT_PTR, out_gate, YKN_CUDA_IQ2S_OUT_DEVICE, N * 8);
            eger status != CUDA_SUCCESS { dondu 0; }
            status = cuda_copy_to_host(YKN_CUDA_CONTEXT_PTR, out_up, YKN_CUDA_IQ2S_OUT_DEVICE_2, N * 8);
            eger status != CUDA_SUCCESS { dondu 0; }
        }

        degisken t_gpu1: tamsayi = ykn_llm_clock_ns();
        YKN_CUDA_I2S_GPU_NS = YKN_CUDA_I2S_GPU_NS + (t_gpu1 - t_gpu0);
        YKN_CUDA_I2S_CALLS = YKN_CUDA_I2S_CALLS + 1;
        dondu 1;
    }
}

# F16 row-major matvec used by tied BitNet token embeddings/output projection.
# The kernel decodes half weights to Q16, accumulates full Q32 products, and
# divides once per output to minimize systematic per-lane truncation error.
isv ykn_cuda_swiglu_ptx() -> *u8 {
    dondu ".version 8.0\n.target sm_52\n.address_size 64\n.visible .entry ykn_swiglu_lut(.param .u64 pGate,.param .u64 pUp,.param .u64 pOut,.param .u64 pLut,.param .u32 pN){\n.reg .pred %p<6>;\n.reg .b32 %r<15>;\n.reg .b64 %rd<15>;\n.reg .s64 %gate,%up,%silu,%prod,%out;\n.reg .s32 %lut_val;\nld.param.u64 %rd0,[pGate];\nld.param.u64 %rd1,[pUp];\nld.param.u64 %rd2,[pOut];\nld.param.u64 %rd3,[pLut];\nld.param.u32 %r0,[pN];\nmov.u32 %r1,%ctaid.x;\nmov.u32 %r2,%ntid.x;\nmov.u32 %r3,%tid.x;\nmad.lo.u32 %r4,%r1,%r2,%r3;\nsetp.ge.u32 %p0,%r4,%r0;\n@%p0 bra EXIT;\nshl.b32 %r5,%r4,3;\ncvt.u64.u32 %rd4,%r5;\nadd.u64 %rd5,%rd0,%rd4;\nld.global.s64 %gate,[%rd5];\nadd.u64 %rd6,%rd1,%rd4;\nld.global.s64 %up,[%rd6];\nsetp.ge.s64 %p1,%gate,524288;\n@%p1 mov.s64 %silu,%gate;\n@%p1 bra MULTIPLY;\nsetp.le.s64 %p2,%gate,-524288;\n@%p2 mov.s64 %silu,0;\n@%p2 bra MULTIPLY;\ncvt.s32.s64 %r6,%gate;\nadd.s32 %r7,%r6,524288;\nshl.b32 %r8,%r7,2;\ncvt.u64.u32 %rd7,%r8;\nadd.u64 %rd8,%rd3,%rd7;\nld.global.s32 %lut_val,[%rd8];\ncvt.s64.s32 %silu,%lut_val;\nMULTIPLY:\nmul.lo.s64 %prod,%silu,%up;\nsetp.ge.s64 %p3,%prod,0;\n@%p3 shr.s64 %out,%prod,16;\n@!%p3 neg.s64 %prod,%prod;\n@!%p3 shr.s64 %prod,%prod,16;\n@!%p3 neg.s64 %out,%prod;\nadd.u64 %rd9,%rd2,%rd4;\nst.global.s64 [%rd9],%out;\nEXIT:\nret;\n}\n".ptr;
