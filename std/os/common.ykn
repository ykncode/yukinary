isv CreateThread(lpThreadAttributes: *u8, dwStackSize: tamsayi, lpStartAddress: *u8, lpParameter: *u8, dwCreationFlags: tamsayi, lpThreadId: *tamsayi) -> tamsayi { dondu 0; } # reality-audit: allow class=constant_success_body reason=IAT-signature-patched-by-target-codegen
isv Sleep(dwMilliseconds: tamsayi) {} # reality-audit: allow class=empty_body reason=IAT-signature-patched-by-target-codegen
