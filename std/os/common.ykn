# ============================================================
# Yukinary (YKN) Standart Kutuphanesi - Isletim Sistemi Birlesik Modulu
# Modul: std/os/common.ykn
# Tum platformlar (Windows, Linux, macOS) icin sabitler ve soyutlamalar.
# NOT: Sub-import kullanilmaz; tum Win32 sabitleri ve wrappers burada inline.
#
# PLATFORM DESTEK MATRISI (FIX 11):
#   DESTEKLENIYOR  : Windows x86_64 (PE32+, Win32 IAT) - runtime dogrulanmis
#   KISMI NATIVE   : Linux x86_64 (ELF64) - mmap + temel dosya/audit syscall'lari dogrulandi
#   PLANLI          : macOS x86_64 (Mach-O 64) - native execution manual-gated
#   PLANLI          : Linux ARM64 (ELF64) - native execution manual-gated
#   PLANLI          : macOS ARM64 (Mach-O 64) - native execution manual-gated
#
# NOT: "Destekleniyor" = gercek native runtime execution dogrulanmis.
#       "Deneysel artifact backend" = header/opcode dogru uretilir
#       ama native calistirma belirli bir platformda dogrulanmamistir.
#       Bkz: PLATFORM_SUPPORT.md
# ============================================================

# Platform Numaralandirma Sabitleri (Derleyici / Runtime)
degisken PLATFORM_WINDOWS          = 0;
degisken PLATFORM_LINUX_X86_64     = 1;
degisken PLATFORM_MACOS_X86_64     = 2;
degisken PLATFORM_LINUX_ARM64      = 3;
degisken PLATFORM_MACOS_ARM64      = 4;

# Ortak Dosya Arama / Konumlandirma
degisken OS_SEEK_BASLANGIC         = 0;
degisken OS_SEEK_SUANKI            = 1;
degisken OS_SEEK_SON               = 2;

# Ortak Standart Akislar
degisken OS_STDIN                  = 0;
degisken OS_STDOUT                 = 1;
degisken OS_STDERR                 = 2;

# Ortak Dosya Erisim Modlari
degisken OS_DOSYA_OKU              = 1;
degisken OS_DOSYA_YAZ              = 2;
degisken OS_DOSYA_OKU_YAZ          = 3;
degisken OS_DOSYA_EKLE             = 4;
degisken OS_DOSYA_YARAT_YENI       = 5;
degisken OS_DOSYA_YARAT_USTUNE     = 6;

# Ortak Bellek ve Sayfalama Sabitleri
degisken OS_SAYFA_BOYUTU           = 4096;
degisken OS_VARSAYILAN_TAMPON      = 65536;
degisken OS_MAKS_DOSYA_TAMPON      = 67108864;

# Ortak Hata / Durum Kodlari
degisken OS_BASARILI               = 0;
degisken OS_HATA_GENEL             = -1;
degisken OS_HATA_BULUNAMADI        = -2;
degisken OS_HATA_ERISIM_ENGEL      = -3;
degisken OS_HATA_YETERSIZ_BELLEK   = -4;
degisken OS_HATA_TAMPON_ASIMI      = -5;

# ============================================================
# Win32 Sabitleri (IAT tabanli syscall stubs icin)
# ============================================================
degisken WIN_STD_INPUT_HANDLE      = 0xfffffff6;
degisken WIN_STD_OUTPUT_HANDLE     = 0xfffffff5;
degisken WIN_STD_ERROR_HANDLE      = 0xfffffff4;
degisken WIN_GENERIC_READ          = 0x80000000;
degisken WIN_GENERIC_WRITE         = 0x40000000;
degisken WIN_FILE_SHARE_NONE       = 0;
degisken WIN_FILE_SHARE_READ       = 1;
degisken WIN_FILE_SHARE_WRITE      = 2;
degisken WIN_CREATE_NEW            = 1;
degisken WIN_CREATE_ALWAYS         = 2;
degisken WIN_OPEN_EXISTING         = 3;
degisken WIN_OPEN_ALWAYS           = 4;
degisken WIN_TRUNCATE_EXISTING     = 5;
degisken WIN_FILE_ATTRIBUTE_NORMAL = 0x80;
degisken WIN_MEM_COMMIT            = 0x1000;
degisken WIN_MEM_RESERVE           = 0x2000;
degisken WIN_MEM_COMMIT_RESERVE    = 0x3000;
degisken WIN_MEM_RELEASE           = 0x8000;
degisken WIN_PAGE_READWRITE        = 0x04;
degisken WIN_INVALID_HANDLE_VALUE  = 0xffffffffffffffff;
degisken WIN_FILE_BEGIN            = 0;
degisken WIN_FILE_CURRENT          = 1;
degisken WIN_FILE_END              = 2;

