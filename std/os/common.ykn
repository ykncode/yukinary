isv SetFilePointerEx(hFile: tamsayi, liDistanceToMove: tamsayi, lpNewFilePointer: *tamsayi, dwMoveMethod: tamsayi) -> tamsayi { dondu 0; } # reality-audit: allow class=constant_success_body reason=IAT-signature-patched-by-target-codegen
isv GetCommandLineA() -> *u8 { dondu 0; } # reality-audit: allow class=constant_success_body reason=IAT-signature-patched-by-target-codegen
