isv ykn_dyn_call_ptr_3(fn_ptr: tamsayi, a1: tamsayi, a2: tamsayi, a3: tamsayi) -> tamsayi { dondu 0; } # reality-audit: allow class=constant_success_body reason=intrinsic-stub-codegen-lowered
