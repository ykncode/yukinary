isv komut_satiri_arg1() -> *u8 { dondu 0; } # reality-audit: allow class=constant_success_body reason=intrinsic-stub-codegen-lowered

# ============================================================
# Win32 Yuksek Seviye Wrappers
# ============================================================
isv win32_bellek_tahsis(boyut: tamsayi) -> *u8 {
    dondu VirtualAlloc(0, boyut, 0x3000, 0x04);
}

isv win32_bellek_serbest(ptr: *hic) {
    eger ptr != 0 ise {
        VirtualFree(ptr, 0, 0x8000);
    }
}

isv win32_sureci_sonlandir(kod: tamsayi) {
    ExitProcess(kod);
}

isv win32_dosya_yarat(dosya_adi: *u8, erisim: tamsayi, paylasim: tamsayi, yaratma: tamsayi, nitelikler: tamsayi) -> tamsayi {
    dondu CreateFileA(dosya_adi, erisim, paylasim, 0, yaratma, nitelikler, 0);
}

isv win32_dosya_yaz(handle: tamsayi, buffer: *u8, boyut: tamsayi, yazilan: *tamsayi) -> tamsayi {
    dondu WriteFile(handle, buffer, boyut, yazilan, 0);
}

isv win32_dosya_oku(handle: tamsayi, buffer: *u8, boyut: tamsayi, okunan: *tamsayi) -> tamsayi {
    dondu ReadFile(handle, buffer, boyut, okunan, 0);
}

isv win32_dosya_kapat(handle: tamsayi) -> tamsayi {
    dondu CloseHandle(handle);
}

isv win32_dosya_konum_ayarla(handle: tamsayi, mesafe: tamsayi, yeni_konum: *tamsayi, mod: tamsayi) -> tamsayi {
    dondu SetFilePointerEx(handle, mesafe, yeni_konum, mod);
}

isv win32_standart_handle_al(std_handle: tamsayi) -> tamsayi {
    dondu GetStdHandle(std_handle);
}

isv win32_komut_satiri_argumanlari() -> *u8 {
    dondu GetCommandLineA();
}

# ============================================================
# Platform Bagimsiz OS Sarmalayicilari (Yuksek Seviye)
# Bellek primitive'i hedefe gore codegen tarafinda gercek Windows/Linux/macOS
# backend'ine iner; syscall dagilimi g_os_aktif_platform ile yonetilir.
# ============================================================
degisken g_os_aktif_platform: tamsayi = 0;

isv os_hedef_platform_ayarla(p: tamsayi) {
    g_os_aktif_platform = p;
}

isv os_hedef_platform_al() -> tamsayi {
    dondu g_os_aktif_platform;
}

# ============================================================
# POSIX / Linux / Darwin Soyutlama Katmani
# ============================================================
isv open(yol: *u8, bayraklar: tamsayi, mod: tamsayi) -> tamsayi { dondu 0 - 1; } # reality-audit: allow class=constant_success_body reason=POSIX-syscall-patched-by-target-codegen
isv read(fd: tamsayi, buf: *u8, boyut: tamsayi) -> tamsayi { dondu 0; } # reality-audit: allow class=constant_success_body reason=POSIX-syscall-patched-by-target-codegen
isv write(fd: tamsayi, buf: *u8, boyut: tamsayi) -> tamsayi { dondu 0; } # reality-audit: allow class=constant_success_body reason=POSIX-syscall-patched-by-target-codegen
isv close(fd: tamsayi) -> tamsayi { dondu 0; } # reality-audit: allow class=constant_success_body reason=POSIX-syscall-patched-by-target-codegen
isv lseek(fd: tamsayi, mesafe: tamsayi, nereden: tamsayi) -> tamsayi { dondu 0; } # reality-audit: allow class=constant_success_body reason=POSIX-syscall-patched-by-target-codegen
isv _exit(kod: tamsayi) {} # reality-audit: allow class=empty_body reason=POSIX-syscall-patched-by-target-codegen

isv posix_bellek_serbest(ptr: *hic) {
    # POSIX arena bump allocator: surec cikisinda veya munmap ile iade edilir
}

isv posix_sureci_sonlandir(kod: tamsayi) {
    _exit(kod);
}

isv posix_dosya_yarat(dosya_adi: *u8, erisim: tamsayi, paylasim: tamsayi, yaratma: tamsayi, nitelikler: tamsayi) -> tamsayi {
    eger dosya_adi == 0 ise { dondu 0 - 1; }
    # Win32 GENERIC_WRITE (0x40000000) -> O_WRONLY|O_CREAT|O_TRUNC (577), aksi halde O_RDONLY (0)
    degisken flags: tamsayi = 0;
    eger erisim == WIN_GENERIC_WRITE ise {
        eger yaratma == WIN_OPEN_ALWAYS ise {
            flags = 1089; # O_WRONLY(1) | O_CREAT(64) | O_APPEND(1024)
        } yoksa {
            flags = 577;  # O_WRONLY(1) | O_CREAT(64) | O_TRUNC(512)
        }
    }
    dondu open(dosya_adi, flags, 493); # 0755 octal = 493 (rwxr-xr-x)
}

isv posix_dosya_yaz(handle: tamsayi, buffer: *u8, boyut: tamsayi, yazilan: *tamsayi) -> tamsayi {
    eger buffer == 0 veya boyut <= 0 ise {
        eger yazilan != 0 ise { yazilan[0] = 0; }
        dondu 0;
    }
    degisken n: tamsayi = write(handle, buffer, boyut);
    eger n < 0 ise {
        eger yazilan != 0 ise { yazilan[0] = 0; }
        dondu 0;
    }
    eger yazilan != 0 ise { yazilan[0] = n; }
    dondu 1;
}

isv posix_dosya_oku(handle: tamsayi, buffer: *u8, boyut: tamsayi, okunan: *tamsayi) -> tamsayi {
    eger buffer == 0 veya boyut <= 0 ise {
        eger okunan != 0 ise { okunan[0] = 0; }
        dondu 0;
    }
    degisken n: tamsayi = read(handle, buffer, boyut);
    eger n < 0 ise {
        eger okunan != 0 ise { okunan[0] = 0; }
        dondu 0;
    }
    eger okunan != 0 ise { okunan[0] = n; }
    dondu 1;
}

isv posix_dosya_kapat(handle: tamsayi) -> tamsayi {
    eger close(handle) == 0 ise { dondu 1; }
    dondu 0;
}

isv posix_dosya_konum_ayarla(handle: tamsayi, mesafe: tamsayi, yeni_konum: *tamsayi, mod: tamsayi) -> tamsayi {
    degisken pos: tamsayi = lseek(handle, mesafe, mod);
    eger pos < 0 ise { dondu 0; }
    eger yeni_konum != 0 ise { yeni_konum[0] = pos; }
    dondu 1;
}

isv posix_standart_handle_al(std_handle: tamsayi) -> tamsayi {
    # Win32 handle'larini POSIX file descriptor'a esle:
    # WIN_STD_INPUT_HANDLE  (0xfffffff6) -> 0 (STDIN)
    # WIN_STD_OUTPUT_HANDLE (0xfffffff5) -> 1 (STDOUT)
    # WIN_STD_ERROR_HANDLE  (0xfffffff4) -> 2 (STDERR)
    eger std_handle == WIN_STD_INPUT_HANDLE veya std_handle == OS_STDIN ise { dondu 0; }
    eger std_handle == WIN_STD_OUTPUT_HANDLE veya std_handle == OS_STDOUT ise { dondu 1; }
    eger std_handle == WIN_STD_ERROR_HANDLE veya std_handle == OS_STDERR ise { dondu 2; }
    dondu std_handle;
}

isv os_bellek_tahsis(boyut: tamsayi) -> *hic {
    # Platform secimini compiler'in gercek bellek primitive'i yapar:
    # Windows'ta VirtualAlloc, Linux/macOS'ta mmap kullanilir.
    dondu bellek_tahsis_et(boyut);
}

isv os_bellek_serbest(ptr: *hic) {
    eger g_os_aktif_platform == PLATFORM_WINDOWS ise {
        win32_bellek_serbest(ptr);
    } yoksa {
        posix_bellek_serbest(ptr);
    }
}

isv os_sureci_sonlandir(kod: tamsayi) {
    eger g_os_aktif_platform == PLATFORM_WINDOWS ise {
        win32_sureci_sonlandir(kod);
    } yoksa {
        posix_sureci_sonlandir(kod);
    }
}

isv os_dosya_yarat(dosya_adi: *u8, erisim: tamsayi, paylasim: tamsayi, yaratma: tamsayi, nitelikler: tamsayi) -> tamsayi {
    eger g_os_aktif_platform == PLATFORM_WINDOWS ise {
        dondu win32_dosya_yarat(dosya_adi, erisim, paylasim, yaratma, nitelikler);
    } yoksa {
        dondu posix_dosya_yarat(dosya_adi, erisim, paylasim, yaratma, nitelikler);
    }
}

isv os_dosya_yaz(handle: tamsayi, buffer: *u8, boyut: tamsayi, yazilan: *tamsayi) -> tamsayi {
    eger g_os_aktif_platform == PLATFORM_WINDOWS ise {
        dondu win32_dosya_yaz(handle, buffer, boyut, yazilan);
    } yoksa {
        dondu posix_dosya_yaz(handle, buffer, boyut, yazilan);
    }
}

isv os_dosya_oku(handle: tamsayi, buffer: *u8, boyut: tamsayi, okunan: *tamsayi) -> tamsayi {
    eger g_os_aktif_platform == PLATFORM_WINDOWS ise {
        dondu win32_dosya_oku(handle, buffer, boyut, okunan);
    } yoksa {
        dondu posix_dosya_oku(handle, buffer, boyut, okunan);
    }
}

isv os_dosya_kapat(handle: tamsayi) -> tamsayi {
    eger g_os_aktif_platform == PLATFORM_WINDOWS ise {
        dondu win32_dosya_kapat(handle);
    } yoksa {
        dondu posix_dosya_kapat(handle);
    }
}

isv os_dosya_konum_ayarla(handle: tamsayi, mesafe: tamsayi, yeni_konum: *tamsayi, mod: tamsayi) -> tamsayi {
    eger g_os_aktif_platform == PLATFORM_WINDOWS ise {
        dondu win32_dosya_konum_ayarla(handle, mesafe, yeni_konum, mod);
    } yoksa {
        dondu posix_dosya_konum_ayarla(handle, mesafe, yeni_konum, mod);
    }
}

isv os_standart_handle_al(std_handle: tamsayi) -> tamsayi {
    eger g_os_aktif_platform == PLATFORM_WINDOWS ise {
        dondu win32_standart_handle_al(std_handle);
    } yoksa {
        dondu posix_standart_handle_al(std_handle);
    }
}

isv os_komut_satiri_argumanlari() -> *u8 {
    eger g_os_aktif_platform == PLATFORM_WINDOWS ise {
        dondu win32_komut_satiri_argumanlari();
    } yoksa {
        # POSIX ortaminda argumanlar ana(argc, argv) parametrelerinden dogrudan alinir
        dondu 0;
    }
}
