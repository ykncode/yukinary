# ============================================================
# Yukinary Standart Kutuphanesi: std/os/macho_writer.ykn
# FAZ 3: macOS Mach-O 64-Bit Ikili Dosya Format Ureteci
#
# Freestanding Mach-O 64-bit Header & Load Command Olusturucu
# x86_64 ve ARM64 (Apple Silicon) mimarilerini destekler.
# ============================================================

ice_aktar "std/os/common.ykn";
ice_aktar "std/os/os_macos.ykn";
ice_aktar "std/bellek.ykn";

# Mach-O 64 Header Boyutu = 32 bayt
# LC_SEGMENT_64 Boyutu = 72 bayt + sectionlar
# LC_MAIN Boyutu = 24 bayt

# Mach-O dosya olusturucu baglami
yapi MachoDosya {
    tampon:      *u8;
    kapasite:    tamsayi;
    boyut:       tamsayi;
    cpu_turu:    tamsayi; # MACHO_CPU_TYPE_X86_64 veya MACHO_CPU_TYPE_ARM64
}

# Yeni bir Mach-O ureticisi baslatir
isv macho_olustur(kapasite: tamsayi, cpu_turu: tamsayi) -> *MachoDosya {
    degisken m: *MachoDosya = bellek_tahsis_et(32);
    eger m == 0 ise { dondu 0; }
    degisken kap: tamsayi = kapasite;
    eger kap < 4096 ise { kap = 4096; }
    m.tampon = bellek_tahsis_et(kap);
    m.kapasite = kap;
    m.boyut = 0;
    m.cpu_turu = cpu_turu;
    dondu m;
}

# Tampona 32-bit tamsayi yazar (Little Endian)
isv macho_yaz_u32(m: *MachoDosya, val: tamsayi) {
    degisken p: *u8 = m.tampon + m.boyut;
    p[0] = (val & 0xFF) as u8;
    p[1] = ((val >> 8) & 0xFF) as u8;
    p[2] = ((val >> 16) & 0xFF) as u8;
    p[3] = ((val >> 24) & 0xFF) as u8;
    m.boyut = m.boyut + 4;
}

# Tampona 64-bit tamsayi yazar (Little Endian)
isv macho_yaz_u64(m: *MachoDosya, val: tamsayi) {
    macho_yaz_u32(m, val & 0xFFFFFFFF);
    macho_yaz_u32(m, (val >> 32) & 0xFFFFFFFF);
}

# Tampona sabit uzunlukta metin/ad yazar (16 bayt dolgu)
isv macho_yaz_isim16(m: *MachoDosya, isim: *u8) {
    degisken p: *u8 = m.tampon + m.boyut;
    bellek_doldur(p, 0 as u8, 16);
    degisken i: tamsayi = 0;
    dongu i < 16 ve isim[i] != 0 {
        p[i] = isim[i];
        i = i + 1;
    }
    m.boyut = m.boyut + 16;
}

# Standart Mach-O 64 Basligini ve Segmentlerini Uretir
isv macho_dosya_derle(m: *MachoDosya, giris_offseti: tamsayi, kod_baytlari: *u8, kod_boyutu: tamsayi) -> tamsayi {
    eger m == 0 veya m.tampon == 0 ise { dondu 0; }
    
    # 1. mach_header_64 (32 bayt)
    macho_yaz_u32(m, MACHO_MH_MAGIC_64);     # magic (0xfeedfacf)
    macho_yaz_u32(m, m.cpu_turu);            # cputype
    macho_yaz_u32(m, MACHO_CPU_SUBTYPE_ALL); # cpusubtype (3)
    macho_yaz_u32(m, MACHO_MH_EXECUTE);      # filetype (2 = EXECUTE)
    macho_yaz_u32(m, 2);                     # ncmds (2 komut: LC_SEGMENT_64 + LC_MAIN)
    macho_yaz_u32(m, 72 + 80 + 24);          # sizeofcmds (LC_SEGMENT_64 + section_64 + LC_MAIN)
    macho_yaz_u32(m, MACHO_MH_NOUNDEFS | MACHO_MH_PIE); # flags
    macho_yaz_u32(m, 0);                     # reserved
    
    # 2. LC_SEGMENT_64: __TEXT (72 bayt + 1 section 80 bayt)
    macho_yaz_u32(m, MACHO_LC_SEGMENT_64);   # cmd = 0x19
    macho_yaz_u32(m, 72 + 80);               # cmdsize = 152
    macho_yaz_isim16(m, "__TEXT".ptr);       # segname
    macho_yaz_u64(m, 0x100000000);           # vmaddr (4GB base)
    macho_yaz_u64(m, 0x1000);                # vmsize (4KB page)
    macho_yaz_u64(m, 0);                     # fileoff
    macho_yaz_u64(m, 4096);                  # filesize
    macho_yaz_u32(m, MACHO_VM_PROT_READ | MACHO_VM_PROT_EXECUTE); # maxprot (r-x = 5)
    macho_yaz_u32(m, MACHO_VM_PROT_READ | MACHO_VM_PROT_EXECUTE); # initprot (r-x = 5)
    macho_yaz_u32(m, 1);                     # nsects = 1
    macho_yaz_u32(m, 0);                     # flags
    
    # 3. section_64: __text (80 bayt)
    macho_yaz_isim16(m, "__text".ptr);       # sectname
    macho_yaz_isim16(m, "__TEXT".ptr);       # segname
    macho_yaz_u64(m, 0x100000000 + 512);     # addr (kod offseti)
    macho_yaz_u64(m, kod_boyutu);            # size
    macho_yaz_u32(m, 512);                   # offset (dosya ici)
    macho_yaz_u32(m, 4);                     # align (2^4 = 16 bayt)
    macho_yaz_u32(m, 0);                     # reloff
    macho_yaz_u32(m, 0);                     # nreloc
    macho_yaz_u32(m, 0x80000400);            # flags (S_REGULAR | S_ATTR_SOME_INSTRUCTIONS | S_ATTR_PURE_INSTRUCTIONS)
    macho_yaz_u32(m, 0);                     # reserved1
    macho_yaz_u32(m, 0);                     # reserved2
    macho_yaz_u32(m, 0);                     # reserved3
    
    # 4. LC_MAIN (24 bayt)
    macho_yaz_u32(m, MACHO_LC_MAIN);         # cmd = 0x80000028
    macho_yaz_u32(m, 24);                    # cmdsize = 24
    macho_yaz_u64(m, 512 + giris_offseti);   # entryoff (dosya baslangicindan main'e ofset)
    macho_yaz_u64(m, 0);                     # stacksize = 0 (varsayilan)
    
    # 5. Dosya 512 baytina kadar dolgula ve ardindan makine kodunu yerlestir
    degisken dolgu_sayisi: tamsayi = 512 - m.boyut;
    eger dolgu_sayisi > 0 ise {
        degisken p_pad: *u8 = m.tampon + m.boyut;
        bellek_doldur(p_pad, 0 as u8, dolgu_sayisi);
        m.boyut = 512;
    }
    
    # Kod baytlarini kopyala
    eger kod_baytlari != 0 ve kod_boyutu > 0 ise {
        degisken p_code: *u8 = m.tampon + m.boyut;
        bellek_kopyala(p_code, kod_baytlari, kod_boyutu);
        m.boyut = m.boyut + kod_boyutu;
    }
    
    dondu m.boyut;
}

# Mach-O nesnesini serbest birakir
isv macho_serbest_birak(m: *MachoDosya) {
    eger m == 0 ise { dondu; }
    eger m.tampon != 0 ise {
        os_bellek_serbest(m.tampon);
    }
    os_bellek_serbest(m as *u8);
}

