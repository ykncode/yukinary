# ============================================================
# Yukinary Standart Kutuphanesi: std/opt/chaitin_briggs_alloc.ykn
# FAZ 2: Canli Aralıklarla Chaitin-Briggs Derleyici Register Tahsisati
#
# Sanal degiskenlerin canlilik araliklarindan (Live Intervals)
# otomatik girisim grafigi kurar, K-renklendirme uygular ve
# fiziksel yazmac haritasini uretir.
# ============================================================

ice_aktar "std/opt/reg_graph.ykn";
ice_aktar "std/os/common.ykn";
ice_aktar "std/bellek.ykn";

yapi RegTahsisSonucu {
    toplam_degisken:  tamsayi;
    fiziksel_reg_adet:tamsayi;
    atanan_regler:    *tamsayi; # [v] -> fiziksel reg ID (1..K, -1: stack spill)
    spill_sayisi:     tamsayi;
}

# Canlilik araligi cakismasi kontrolu: [b1, e1] ile [b2, e2] kesisiyor mu?
isv aralik_kesisiyor_mu(b1: tamsayi, e1: tamsayi, b2: tamsayi, e2: tamsayi) -> tamsayi {
    eger e1 < b2 veya e2 < b1 ise {
        dondu 0;
    }
    dondu 1;
}

# Canlilik araliklarindan Chaitin-Briggs ile yazmac tahsisi yapar
isv chaitin_briggs_tahsis_et(canli_bas: *tamsayi, canli_bit: *tamsayi, v_adet: tamsayi, k_reg: tamsayi) -> *RegTahsisSonucu {
    eger canli_bas == 0 veya canli_bit == 0 veya v_adet <= 0 veya k_reg <= 0 ise {
        dondu 0;
    }
    
    # 1. Girisim grafi olustur
    degisken g: *GirisimGrafi = girisim_grafi_olustur(v_adet);
    eger g == 0 ise { dondu 0; }
    
    # 2. Araliklari karsilastirarak girisim kenarlarini ekle
    degisken i: tamsayi = 0;
    dongu i < v_adet {
        degisken j: tamsayi = i + 1;
        dongu j < v_adet {
            eger aralik_kesisiyor_mu(canli_bas[i], canli_bit[i], canli_bas[j], canli_bit[j]) == 1 ise {
                girisim_kenari_ekle(g, i, j);
            }
            j = j + 1;
        }
        i = i + 1;
    }
    
    # 3. Chaitin-Briggs K-renklendirmeyi calistir
    degisken spill_adet: tamsayi = girisim_grafi_renklendir(g, k_reg);
    
    # 4. Sonuc yapisini doldur
    degisken sonuc: *RegTahsisSonucu = bellek_tahsis_et(32);
    sonuc.toplam_degisken = v_adet;
    sonuc.fiziksel_reg_adet = k_reg;
    sonuc.spill_sayisi = spill_adet;
    sonuc.atanan_regler = bellek_tahsis_et(v_adet * 8);
    
    degisken dst: *tamsayi = sonuc.atanan_regler;
    degisken src: *tamsayi = g.renkler;
    i = 0;
    dongu i < v_adet {
        dst[i] = src[i];
        i = i + 1;
    }
    
    girisim_grafi_serbest_birak(g);
    dondu sonuc;
}

isv reg_tahsis_sonucu_serbest_birak(sonuc: *RegTahsisSonucu) {
    eger sonuc == 0 ise { dondu; }
    eger sonuc.atanan_regler != 0 ise {
        os_bellek_serbest(sonuc.atanan_regler as *u8);
    }
    os_bellek_serbest(sonuc as *u8);
}

