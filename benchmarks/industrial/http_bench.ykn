ice_aktar "std/metin.ykn";

harici isv ykn_llm_clock_ns() -> tamsayi;
harici isv bellek_tahsis_et(boyut: tamsayi) -> *u8;
harici isv ekrana_yaz(mesaj: *u8);

isv sayiyi_yazdir(sayi: tamsayi) {
    eger sayi == 0 { ekrana_yaz("0".ptr); dondu; }
    degisken n: tamsayi = sayi;
    degisken rakamlar: [32]u8;
    degisken adet: tamsayi = 0;
    eger n < 0 { ekrana_yaz("-".ptr); n = 0 - n; }
    dongu n > 0 {
        rakamlar[adet] = 48 + (n % 10);
        adet = adet + 1;
        n = n / 10;
    }
    dongu adet > 0 {
        adet = adet - 1;
        degisken ch: [2]u8;
        ch[0] = rakamlar[adet];
        ch[1] = 0;
        ekrana_yaz(ch.ptr);
    }
}

isv str_baslar_mi(str: *u8, on_ek: *u8) -> tamsayi {
    degisken i: tamsayi = 0;
    dongu on_ek[i] != 0 {
        eger str[i] == 0 { dondu 0; }
        eger str[i] != on_ek[i] { dondu 0; }
        i = i + 1;
    }
    dondu 1;
}

isv ana() -> tamsayi {
    degisken count: tamsayi = 100000;
    degisken samples: [3]*u8;
    samples[0] = "POST /api/v1/orders/create HTTP/1.1\r\nHost: api.yukinary.internal\r\nUser-Agent: BenchAgent/2.0\r\nContent-Length: 42\r\n\r\n{\"item_id\": 9942, \"qty\": 4, \"price\": 120}".ptr;
    samples[1] = "GET /api/v1/users/profile?id=512 HTTP/1.1\r\nHost: api.yukinary.internal\r\nUser-Agent: BenchAgent/2.0\r\nContent-Length: 0\r\n\r\n".ptr;
    samples[2] = "GET /healthz HTTP/1.1\r\nHost: api.yukinary.internal\r\nUser-Agent: BenchAgent/2.0\r\nContent-Length: 12\r\n\r\n{\"status\":\"ok\"}".ptr;

    degisken req_pool: **u8 = bellek_tahsis_et(count * 8);
    degisken i: tamsayi = 0;
    dongu i < count {
        req_pool[i] = samples[i % 3];
        i = i + 1;
    }

    degisken t1: tamsayi = ykn_llm_clock_ns();

    degisken total_bytes: tamsayi = 0;
    degisken orders_count: tamsayi = 0;
    degisken users_count: tamsayi = 0;
    degisken health_count: tamsayi = 0;

    degisken j: tamsayi = 0;
    dongu j < count {
        degisken raw: *u8 = req_pool[j];

        # Metodu atla, path'in basina git
        degisken p: tamsayi = 0;
        dongu raw[p] != 32 ve raw[p] != 0 { p = p + 1; }
        eger raw[p] == 32 { p = p + 1; }

        # Rota eslemesi
        degisken path_ptr: *u8 = raw + p;
        eger str_baslar_mi(path_ptr, "/api/v1/orders".ptr) == 1 {
            orders_count = orders_count + 1;
        }
        yoksa eger str_baslar_mi(path_ptr, "/api/v1/users".ptr) == 1 {
            users_count = users_count + 1;
        }
        yoksa eger str_baslar_mi(path_ptr, "/healthz".ptr) == 1 {
            health_count = health_count + 1;
        }

        # Content-Length oku (Optimize edilmis metin_ara)
        degisken cl_ptr: *u8 = metin_ara(raw, "Content-Length:".ptr);
        eger cl_ptr != 0 {
            total_bytes = total_bytes + tamsayiya_cevir(cl_ptr + 15);
        }

        j = j + 1;
    }

    degisken t2: tamsayi = ykn_llm_clock_ns();
    degisken elapsed_ms: tamsayi = (t2 - t1) / 1000000;

    ekrana_yaz("HTTP Yukinary (std/metin.ykn Optimize) Sonucu:\n".ptr);
    ekrana_yaz("100,000 Istek | Toplam CL: ".ptr);
    sayiyi_yazdir(total_bytes);
    ekrana_yaz(" | Orders: ".ptr);
    sayiyi_yazdir(orders_count);
    ekrana_yaz(" | Users: ".ptr);
    sayiyi_yazdir(users_count);
    ekrana_yaz(" | Health: ".ptr);
    sayiyi_yazdir(health_count);
    ekrana_yaz("\nSure: ".ptr);
    sayiyi_yazdir(elapsed_ms);
    ekrana_yaz(" ms\n".ptr);

    dondu 0;
}
