ice_aktar "std/kripto/sha256.ykn";

harici isv ykn_llm_clock_ns() -> tamsayi;
harici isv bellek_tahsis_et(boyut: tamsayi) -> *u8;
harici isv ekrana_yaz(mesaj: *u8);

isv sayiyi_yazdir(sayi: tamsayi) {
    eger sayi == 0 { ekrana_yaz("0".ptr); dondu; }
    degisken n: tamsayi = sayi;
    degisken rakamlar: [32]u8;
    degisken adet: tamsayi = 0;
    eger n < 0 { ekrana_yaz("-".ptr); n = 0 - n; }
    dongu n > 0 {
        rakamlar[adet] = 48 + (n % 10);
        adet = adet + 1;
        n = n / 10;
    }
    dongu adet > 0 {
        adet = adet - 1;
        degisken ch: [2]u8;
        ch[0] = rakamlar[adet];
        ch[1] = 0;
        ekrana_yaz(ch.ptr);
    }
}

isv ana() -> tamsayi {
    degisken boyut: tamsayi = 16 * 1024 * 1024;
    degisken tampon: *u8 = bellek_tahsis_et(boyut);
    
    degisken i: tamsayi = 0;
    dongu i < boyut {
        tampon[i] = ((i * 31 + 17) & 255);
        i = i + 1;
    }

    degisken t1: tamsayi = ykn_llm_clock_ns();

    degisken hash32: [32]u8;
    degisken res: tamsayi = sha256_hesapla(tampon, boyut, hash32.ptr);

    degisken t2: tamsayi = ykn_llm_clock_ns();

    degisken hex64: [65]u8;
    sha256_hex_formatla(hash32.ptr, hex64.ptr);

    degisken elapsed_ms: tamsayi = (t2 - t1) / 1000000;

    ekrana_yaz("SHA-256 Yukinary (std/kripto/sha256.ykn) Sonucu:\n".ptr);
    ekrana_yaz("Hash: ".ptr);
    ekrana_yaz(hex64.ptr);
    ekrana_yaz("\nBoyut: 16 MB | Sure: ".ptr);
    sayiyi_yazdir(elapsed_ms);
    ekrana_yaz(" ms | Durum Kodu: ".ptr);
    sayiyi_yazdir(res);
    ekrana_yaz("\n".ptr);

    dondu 0;
}
