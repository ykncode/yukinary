harici isv ykn_llm_clock_ns() -> tamsayi;
harici isv bellek_tahsis_et(boyut: tamsayi) -> *u8;
harici isv ekrana_yaz(mesaj: *u8);

isv sayiyi_yazdir(sayi: tamsayi) {
    eger sayi == 0 { ekrana_yaz("0".ptr); dondu; }
    degisken n: tamsayi = sayi;
    degisken rakamlar: [32]u8;
    degisken adet: tamsayi = 0;
    eger n < 0 { ekrana_yaz("-".ptr); n = 0 - n; }
    dongu n > 0 {
        rakamlar[adet] = 48 + (n % 10);
        adet = adet + 1;
        n = n / 10;
    }
    dongu adet > 0 {
        adet = adet - 1;
        degisken ch: [2]u8;
        ch[0] = rakamlar[adet];
        ch[1] = 0;
        ekrana_yaz(ch.ptr);
    }
}

isv str_bul(str: *u8, alt: *u8) -> tamsayi {
    degisken i: tamsayi = 0;
    dongu str[i] != 0 {
        degisken j: tamsayi = 0;
        degisken eslesme: tamsayi = 1;
        dongu alt[j] != 0 {
            eger str[i + j] == 0 { eslesme = 0; durdur; }
            eger str[i + j] != alt[j] { eslesme = 0; durdur; }
            j = j + 1;
        }
        eger eslesme == 1 { dondu i; }
        i = i + 1;
    }
    dondu -1;
}

isv str_tamsayi_oku(str: *u8, baslangic: tamsayi) -> tamsayi {
    degisken val: tamsayi = 0;
    degisken p: tamsayi = baslangic;
    dongu str[p] >= 48 ve str[p] <= 57 {
        val = val * 10 + (str[p] - 48);
        p = p + 1;
    }
    dondu val;
}

isv ana() -> tamsayi {
    degisken count: tamsayi = 50000;
    degisken ptr_dizisi: **u8 = bellek_tahsis_et(count * 8);

    # JSON dizelerini olustur
    degisken i: tamsayi = 0;
    dongu i < count {
        degisken buf: *u8 = bellek_tahsis_et(128);
        degisken id: tamsayi = (i * 17) % 100000;
        degisken score: tamsayi = (i * 23) % 1000;
        degisken active: tamsayi = i % 2;

        # Manuel formatlama: {"id":123,"score":456,"active":true}
        degisken pos: tamsayi = 0;
        degisken prefix: *u8 = "{\"id\":".ptr;
        degisken p_idx: tamsayi = 0;
        dongu prefix[p_idx] != 0 { buf[pos] = prefix[p_idx]; pos = pos + 1; p_idx = p_idx + 1; }

        # id yaz
        degisken temp_digits: [16]u8;
        degisken d_cnt: tamsayi = 0;
        degisken temp_id: tamsayi = id;
        eger temp_id == 0 { temp_digits[0] = 48; d_cnt = 1; }
        yoksa {
            dongu temp_id > 0 { temp_digits[d_cnt] = 48 + (temp_id % 10); d_cnt = d_cnt + 1; temp_id = temp_id / 10; }
        }
        dongu d_cnt > 0 { d_cnt = d_cnt - 1; buf[pos] = temp_digits[d_cnt]; pos = pos + 1; }

        # score yaz
        degisken mid: *u8 = ",\"score\":".ptr;
        degisken m_idx: tamsayi = 0;
        dongu mid[m_idx] != 0 { buf[pos] = mid[m_idx]; pos = pos + 1; m_idx = m_idx + 1; }
        degisken temp_sc: tamsayi = score;
        d_cnt = 0;
        eger temp_sc == 0 { temp_digits[0] = 48; d_cnt = 1; }
        yoksa {
            dongu temp_sc > 0 { temp_digits[d_cnt] = 48 + (temp_sc % 10); d_cnt = d_cnt + 1; temp_sc = temp_sc / 10; }
        }
        dongu d_cnt > 0 { d_cnt = d_cnt - 1; buf[pos] = temp_digits[d_cnt]; pos = pos + 1; }

        # active yaz
        degisken act_str: *u8 = ",\"active\":true}".ptr;
        eger active != 0 { act_str = ",\"active\":false}".ptr; }
        degisken a_idx: tamsayi = 0;
        dongu act_str[a_idx] != 0 { buf[pos] = act_str[a_idx]; pos = pos + 1; a_idx = a_idx + 1; }
        buf[pos] = 0;

        ptr_dizisi[i] = buf;
        i = i + 1;
    }

    degisken t1: tamsayi = ykn_llm_clock_ns();

    degisken sum_score: tamsayi = 0;
    degisken active_count: tamsayi = 0;

    degisken j: tamsayi = 0;
    dongu j < count {
        degisken s: *u8 = ptr_dizisi[j];
        
        # score oku
        degisken sc_pos: tamsayi = str_bul(s, "\"score\":".ptr);
        eger sc_pos >= 0 {
            sum_score = sum_score + str_tamsayi_oku(s, sc_pos + 8);
        }

        # active oku
        degisken act_pos: tamsayi = str_bul(s, "\"active\":true".ptr);
        eger act_pos >= 0 {
            active_count = active_count + 1;
        }

        j = j + 1;
    }

    degisken t2: tamsayi = ykn_llm_clock_ns();
    degisken elapsed_ms: tamsayi = (t2 - t1) / 1000000;

    ekrana_yaz("JSON Yukinary (Native Loop) Sonucu:\n".ptr);
    ekrana_yaz("50,000 JSON Kaydi | Toplam Skor: ".ptr);
    sayiyi_yazdir(sum_score);
    ekrana_yaz(" | Aktif Sayisi: ".ptr);
    sayiyi_yazdir(active_count);
    ekrana_yaz("\nSure: ".ptr);
    sayiyi_yazdir(elapsed_ms);
    ekrana_yaz(" ms\n".ptr);

    dondu 0;
}
