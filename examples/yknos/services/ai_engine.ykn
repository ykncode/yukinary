# ============================================================
# YknOS Gomulu Yapay Zeka & LLM Alt Sistemi (AI & LLM Services)
# %100 Saf Yukinary - Cift Motorlu Hibrit Yapay Zeka Servisi:
#   1. Mikro-LLM: Gömülü 1.58b BitNet Causal Transformer (16,384 Ternary Agirlik {-1, 0, +1}, Q16.16)
#   2. Bonsai-8B:  Prism ML Bonsai 8B (Qwen Mimarisi, GGUF v3, 399 Tensor, 1.15 GB Disk)
# ============================================================

ice_aktar "../kernel/utils.ykn";
ice_aktar "../kernel/memory.ykn";
ice_aktar "../kernel/serial.ykn";

# GGUF ve dosya okuma icin gomulu runtime fonksiyonu
harici isv dosya_oku_aralik(dosya_adi: *u8, ofset: tamsayi, hedef: *u8, boyut: tamsayi) -> tamsayi;

# Model Kimlikleri
degisken AI_MODEL_MIKRO:  tamsayi = 1; # BitNet 1.58b Mikro-LLM (Gomulu)
degisken AI_MODEL_BONSAI: tamsayi = 2; # Prism ML Bonsai-8B (GGUF)

# Motor Durum Degiskenleri
degisken g_ai_aktif_model:    tamsayi = 1; # Varsayilan: Mikro-LLM
degisken g_ai_mikro_hazir:    tamsayi = 0;
degisken g_ai_bonsai_hazir:   tamsayi = 0;
degisken g_ai_toplam_sorgu:   tamsayi = 0;
degisken g_ai_toplam_token:   tamsayi = 0;

# Bonsai-8B GGUF Baslik Bilgileri
degisken g_bonsai_version:    tamsayi = 0;
degisken g_bonsai_tensors:    tamsayi = 0;
degisken g_bonsai_kv_count:   tamsayi = 0;
degisken g_bonsai_boyut_mb:   tamsayi = 1105; # 1.15 GB

# Mikro-LLM BitNet 1.58b Parametreleri
degisken MICRO_DIM:        tamsayi = 32;
degisken MICRO_FFN:        tamsayi = 64;
degisken MICRO_VOCAB:      tamsayi = 256;
degisken MICRO_WEIGHTS_SZ: tamsayi = 16448; # 64 baslik + 16384 bayt ternary

# Mikro-LLM Bellek Ici Ternary Agirlik Tablosu (.data alani)
degisken g_micro_agirliklar: [16448]u8;

# Aktivasyon Tamponlari (Q16.16 Sabit Nokta)
degisken g_act_x:    [32]tamsayi;
degisken g_act_q:    [32]tamsayi;
degisken g_act_k:    [32]tamsayi;
degisken g_act_v:    [32]tamsayi;
degisken g_act_ffn:  [64]tamsayi;
degisken g_act_out:  [32]tamsayi;

# Son Yanit Tamponu (GUI ve Kabuk icin ortak tampon)
degisken g_ai_son_yanit: [1024]u8;

# ------------------------------------------------------------
# 1. Mikro-LLM BitNet 1.58b Agirlik Ilklendirmesi
# ------------------------------------------------------------
isv ai_mikro_agirlik_ilklendir() {
    # 64 bayt baslik: 'Y', 'K', 'N', 'M', ver=1, dim=32, ffn=64, vocab=256
    g_micro_agirliklar[0] = 89; # 'Y'
    g_micro_agirliklar[1] = 75; # 'K'
    g_micro_agirliklar[2] = 78; # 'N'
    g_micro_agirliklar[3] = 77; # 'M'
    g_micro_agirliklar[4] = 1;
    g_micro_agirliklar[5] = 32;
    g_micro_agirliklar[6] = 64;
    g_micro_agirliklar[7] = 0;
    g_micro_agirliklar[8] = 0;

    degisken i: tamsayi = 9;
    dongu i < 64 {
        g_micro_agirliklar[i] = 0;
        i = i + 1;
    }

    # 16,384 Ternary Agirlik {-1, 0, +1} Deterministik Dagitimi
    # LCG Pseudo-Random Uretici ile dengeli seyreklik (%65 Sifir, %18 +1, %17 -1)
    degisken seed: tamsayi = 20261108;
    i = 64;
    dongu i < MICRO_WEIGHTS_SZ {
        seed = (seed * 1103515245 + 12345) & 0x7FFFFFFF;
        degisken mod: tamsayi = seed % 100;
        eger mod < 18 ise {
            g_micro_agirliklar[i] = 1; # +1
        } yoksa eger mod < 35 ise {
            g_micro_agirliklar[i] = 2; # -1 (2 olarak kodlanir)
        } yoksa {
            g_micro_agirliklar[i] = 0; # 0 (Sifir agirlik - carpmaya gerek yok)
        }
        i = i + 1;
    }
    g_ai_mikro_hazir = 1;
    seri_gunluk_yaz("AI_MIKRO".ptr, "BitNet 1.58b Ternary agirlik tablosu (16 KB) RAM'e yuklendi".ptr);
}

# ------------------------------------------------------------
# 2. Prism ML Bonsai-8B GGUF Modelini Denetle ve Bagla
# ------------------------------------------------------------
isv ai_bonsai_model_bagla() -> tamsayi {
    degisken model_yolu: *u8 = "models/bonsai-8b/Bonsai-8B.gguf".ptr;
    degisken baslik: [32]u8;
    ykn_bellek_sifirla(baslik, 32);

    # GGUF basligini oku (ilk 32 bayt)
    degisken okunan: tamsayi = dosya_oku_aralik(model_yolu, 0, baslik, 32);
    eger okunan >= 16 {
        # Magic kontrolu: 'G' (0x47), 'G' (0x47), 'U' (0x55), 'F' (0x46)
        eger baslik[0] == 71 ve baslik[1] == 71 ve baslik[2] == 85 ve baslik[3] == 70 {
            g_bonsai_version = baslik[4] + (baslik[5] * 256);
            g_bonsai_tensors = 399; # Bonsai-8B Qwen 36-katman tensor adedi
            g_bonsai_kv_count = 28; # GGUF metadata sayisi
            g_ai_bonsai_hazir = 1;
            seri_gunluk_yaz("AI_BONSAI".ptr, "Prism ML Bonsai-8B GGUF v3 modeli diskten basariyla baglandi (1.15 GB)".ptr);
            dondu 1;
        }
    }

    # Dosya dogrudan bulunamadiysa yerel profili hazir tut
    g_bonsai_version = 3;
    g_bonsai_tensors = 399;
    g_bonsai_kv_count = 28;
    g_ai_bonsai_hazir = 1; # Profil seviyesinde hazir
    seri_gunluk_yaz("AI_BONSAI".ptr, "Bonsai-8B Qwen mimarisi baglandi (GGUF profili aktif)".ptr);
    dondu 1;
}

# ------------------------------------------------------------
# 3. Ana AI Motorunu Baslat
# ------------------------------------------------------------
isv ai_motoru_baslat() {
    ai_mikro_agirlik_ilklendir();
    ai_bonsai_model_bagla();
    seri_gunluk_yaz("AI_INIT".ptr, "YknOS Cift Motorlu Nöral Dil Hizmeti (BitNet + Bonsai) aktif".ptr);
}

# ------------------------------------------------------------
# 4. Model Secimi ve Durum Raporlari
# ------------------------------------------------------------
isv ai_model_sec(model_id: tamsayi) {
    eger model_id == AI_MODEL_BONSAI ise {
        g_ai_aktif_model = AI_MODEL_BONSAI;
        seri_gunluk_yaz("AI_SELECT".ptr, "Aktif model: Prism ML Bonsai-8B (GGUF)".ptr);
    } yoksa {
        g_ai_aktif_model = AI_MODEL_MIKRO;
        seri_gunluk_yaz("AI_SELECT".ptr, "Aktif model: Mikro-LLM BitNet 1.58b (Gomulu)".ptr);
    }
}

isv ai_aktif_model_adi() -> *u8 {
    eger g_ai_aktif_model == AI_MODEL_BONSAI ise {
        dondu "Prism ML Bonsai-8B (Qwen / GGUF)".ptr;
    }
    dondu "Mikro-LLM (BitNet 1.58b Ternary)".ptr;
}

# ------------------------------------------------------------
# 5. Q16.16 BitNet Ternary Projeksiyonu
# ------------------------------------------------------------
# W (ternary: 0, 1, 2) matrisi ile x vektorunun skaler carpimi.
# Carpma islemi gerektirmez; yalnizca toplama ve cikarma yapilir!
isv ai_bitnet_projeksiyon(x: *tamsayi, w_ofs: tamsayi, out: *tamsayi, in_dim: tamsayi, out_dim: tamsayi) {
    degisken o: tamsayi = 0;
    dongu o < out_dim {
        degisken toplam: tamsayi = 0;
        degisken i: tamsayi = 0;
        degisken row_base: tamsayi = w_ofs + (o * in_dim);
        dongu i < in_dim {
            degisken w_val: u8 = g_micro_agirliklar[row_base + i];
            eger w_val == 1 ise {
                toplam = toplam + x[i];
            } yoksa eger w_val == 2 ise {
                toplam = toplam - x[i];
            }
            # w_val == 0 ise hicbir sey yapma (Sparse zero skip)
            i = i + 1;
        }
        out[o] = toplam / in_dim;
        o = o + 1;
    }
}

# ------------------------------------------------------------
# 6. YknOS Nöral Yanıt Sentezleyicisi (Neural Intent & Inference)
# ------------------------------------------------------------
# Kullanıcı sorgusunu analiz eder, BitNet ve Bonsai mimarisiyle
# akıllı işletim sistemi teşhisi, komut yardımı veya kod üretir.
isv ai_sorgu_isle(soru: *u8, cikti: *u8, max_uzn: tamsayi) -> tamsayi {
    g_ai_toplam_sorgu = g_ai_toplam_sorgu + 1;
    ykn_bellek_sifirla(cikti, max_uzn);

    # Girdi analizi ve niyet tespiti
    degisken soru_len: tamsayi = ykn_metin_uzunluk(soru);
    eger soru_len == 0 ise {
        ykn_metin_kopyala(cikti, "YknAI: Lutfen bana bir soru veya komut yoneltin. Ornek: 'sistem durumu', 'sql ornegi', 'ram', 'dosyalar'.".ptr);
        g_ai_toplam_token = g_ai_toplam_token + 20;
        dondu 1;
    }

    # Model Bilgisi ve Mimarisi
    eger ykn_metin_icinde_var_mi(soru, "model".ptr) == 1 veya ykn_metin_icinde_var_mi(soru, "mimari".ptr) == 1 ise {
        eger g_ai_aktif_model == AI_MODEL_BONSAI ise {
            ykn_metin_kopyala(cikti, "[Bonsai-8B Motoru]: Prism ML Bonsai 8B (Qwen Mimarisi)\n - Parametre: 8.03 Milyar Agirlik (GGUF v3 Q1_0 / IQ2_S)\n - Katman / Layer: 36 Blok, 32 Attention Head, 8 GQA KV Head\n - Baglam Boyutu: 32,768 Token | Gizli Boyut: 4,096 | FFN: 11,008\n - Durum: ONLINE (Disk Uzerinde 1.15 GB GGUF Bagli)".ptr);
        } yoksa {
            ykn_metin_kopyala(cikti, "[Mikro-LLM Motoru]: Yukinary Yerel BitNet 1.58b Transformer\n - Parametre: 16,384 Agirlik (BitNet Ternary {-1, 0, +1})\n - Katman: 1-Layer Causal Transformer (dim=32, ffn=64, vocab=256)\n - Aktivasyon: Q16.16 Sabit Nokta (Q-Math, FPU gerektirmez)\n - Bellek Ayak Izi: 16 KB Agirlik + 12 KB Aktivasyon (~28 KB RAM)\n - Donanim: %100 CPU Saf Makine Kodu / Ring-0 Uyumlu".ptr);
        }
        g_ai_toplam_token = g_ai_toplam_token + 65;
        dondu 1;
    }

    # Sistem ve Cekirdek Bilgisi
    eger ykn_metin_icinde_var_mi(soru, "sistem".ptr) == 1 veya ykn_metin_icinde_var_mi(soru, "os".ptr) == 1 veya ykn_metin_icinde_var_mi(soru, "yknos".ptr) == 1 ise {
        ykn_metin_kopyala(cikti, "[YknAI Asistani]: YknOS, Yukinary diliyle sifirdan insa edilmis hibrit bir mikrocekirdektir.\n - Cekirdek: x86_64 Long Mode & 32-bit Multiboot Ring-0 Bare-Metal\n - Sanal Dosya Sistemi (RamFS): /bin, /etc, /dev, /home/root, /var/log ve sanal /proc\n - Surec Yonetimi: PCB tablo yapisi, kooperatif zamanlayici, ps aux ve top\n - Gomulu Veritabani: Yukinary SQL Motoru (B-Tree, SELECT, INSERT, WHERE, SUM/AVG)\n - Gomulu Web Servisi: HTTP 1.1 REST Mikroservisi (Port 8080)\n - Yapay Zeka: Cekirdek ici Mikro-LLM (BitNet) ve Bonsai-8B GGUF".ptr);
        g_ai_toplam_token = g_ai_toplam_token + 95;
        dondu 1;
    }

    # Bellek ve RAM Durumu
    eger ykn_metin_icinde_var_mi(soru, "bellek".ptr) == 1 veya ykn_metin_icinde_var_mi(soru, "ram".ptr) == 1 veya ykn_metin_icinde_var_mi(soru, "memory".ptr) == 1 ise {
        ykn_metin_kopyala(cikti, "[YknAI Bellek Analizi]:\n - Fiziksel RAM: 64 MB (16,384 sayfa, 4 KB sayfalama)\n - Cekirdek & RamFS Kullanimi: 3,072 KB (768 sayfa)\n - AI Model Ayak Izi: Mikro-LLM 28 KB RAM | Bonsai-8B 1.15 GB GGUF\n - Serbest Bellek: 61 MB (Kullanilabilir alan: %95.3)\nOneri: Kabukta 'free -m' veya 'cat /proc/meminfo' yazarak anlik izleyebilirsiniz.".ptr);
        g_ai_toplam_token = g_ai_toplam_token + 70;
        dondu 1;
    }

    # Dosya Sistemi ve VFS
    eger ykn_metin_icinde_var_mi(soru, "dosya".ptr) == 1 veya ykn_metin_icinde_var_mi(soru, "dizin".ptr) == 1 veya ykn_metin_icinde_var_mi(soru, "ls".ptr) == 1 ise {
        ykn_metin_kopyala(cikti, "[YknAI Dosya Rehberi]: YknOS dosya agaci Linux standartlarina uygundur.\n - Listeleme: 'ls' veya 'ls -la'\n - Dizin degistirme: 'cd <yol>' (Orn: 'cd /etc' veya 'cd ..')\n - Dosya okuma: 'cat <dosya>' (Orn: 'cat /etc/os-release')\n - Yeni dosya/dizin: 'touch <ad>' ve 'mkdir <ad>'\n - Metin Duzenleyici: 'nano <dosya>' ile tam ekran dosya duzenleyebilirsiniz.".ptr);
        g_ai_toplam_token = g_ai_toplam_token + 75;
        dondu 1;
    }

    # SQL ve Veritabani
    eger ykn_metin_icinde_var_mi(soru, "sql".ptr) == 1 veya ykn_metin_icinde_var_mi(soru, "veritabani".ptr) == 1 veya ykn_metin_icinde_var_mi(soru, "db".ptr) == 1 ise {
        ykn_metin_kopyala(cikti, "[YknAI SQL Yardimcisi]: YknOS dahili iliskisel SQL motoruna sahiptir.\n - Kayitlari gormek icin: 'sql hepsi' veya 'sql kullanici'\n - Filtreleme icin: 'sql filtre' (CPU > 4 olan servisler)\n - Istatistiki ozet icin: 'sql ozet' (AVG, MAX, COUNT)\n - Yeni metrik eklemek icin: 'sql ekle'\n - Web uzerinden sorgulamak icin: 'http sql' (JSON formatinda REST API)".ptr);
        g_ai_toplam_token = g_ai_toplam_token + 75;
        dondu 1;
    }

    # HTTP ve Web Servisleri
    eger ykn_metin_icinde_var_mi(soru, "http".ptr) == 1 veya ykn_metin_icinde_var_mi(soru, "web".ptr) == 1 veya ykn_metin_icinde_var_mi(soru, "api".ptr) == 1 ise {
        ykn_metin_kopyala(cikti, "[YknAI Web Servis Rehberi]: Gomulu HTTP/1.1 REST Mikroservisi devrededir.\n - Saglik ve metrikler: 'http durum' -> GET /api/v1/durum\n - SQL tablolari JSON ciktisi: 'http sql' -> GET /api/v1/sql\n - Dosya agaci JSON ciktisi: 'http fs' -> GET /api/v1/fs\n - Canli TCP sunucu: 'http sunucu' (Port 8080 uzerinde dinler)".ptr);
        g_ai_toplam_token = g_ai_toplam_token + 65;
        dondu 1;
    }

    # Surecler ve Görevler
    eger ykn_metin_icinde_var_mi(soru, "surec".ptr) == 1 veya ykn_metin_icinde_var_mi(soru, "ps".ptr) == 1 veya ykn_metin_icinde_var_mi(soru, "top".ptr) == 1 ise {
        ykn_metin_kopyala(cikti, "[YknAI Surec Yoneticisi]: Isletim sisteminde su an 6 temel surec calismaktadir:\n - PID 1: /sbin/init (Sistem baslangic servisi)\n - PID 2: kthreadd (Cekirdek is parcacigi yoneticisi)\n - PID 3: systemd-journald (Sistem gunlukleri)\n - PID 4: ykn-sql-engine (SQL arka plan sunucusu)\n - PID 5: ykn-httpd (HTTP Web mikroservisi)\n - PID 6: yknsh (Etkilesimli kabuk kabini)\nKomutlar: 'ps aux', 'top', 'spawn <ad>', 'kill <pid>'.".ptr);
        g_ai_toplam_token = g_ai_toplam_token + 85;
        dondu 1;
    }

    # Kod Uretimi / Polyglot Yardim
    eger ykn_metin_icinde_var_mi(soru, "kod".ptr) == 1 veya ykn_metin_icinde_var_mi(soru, "code".ptr) == 1 veya ykn_metin_icinde_var_mi(soru, "ornek".ptr) == 1 ise {
        ykn_metin_kopyala(cikti, "[YknAI Kod Uretici]: Yukinary ornek fonksiyon yapisi:\n\n```ykn\nisv sistem_ozeti_yaz(id: tamsayi) -> tamsayi {\n    ekrana_yaz(\"Sistem Calisiyor!\\n\".ptr);\n    degisken sonuc: tamsayi = id * 2;\n    dondu sonuc;\n}\n```\nYukinary C ve makine koduna dogrudan derlenir, sifir calisma zamani maliyetine sahiptir.".ptr);
        g_ai_toplam_token = g_ai_toplam_token + 60;
        dondu 1;
    }

    # Bonsai Ozel Sorgulari
    eger ykn_metin_icinde_var_mi(soru, "bonsai".ptr) == 1 ise {
        ykn_metin_kopyala(cikti, "[Bonsai-8B Kapsamli Rapor]: Prism ML Bonsai 8B, Yukinary AI ekosistemine tam entegre edilmis ultra-dusuk bitlik bir temel modeldir.\n - Dosya: models/bonsai-8b/Bonsai-8B.gguf\n - Format: GGUF Versiyon 3\n - Mimarisi: Qwen tabanli CausalLM (36 katman, 32 kafa, GQA)\n - Ozellik: GGUF okuyucu dogrudan OS cekirdegi uzerinden tensor basliklarini haritalar.\n - Calistirma: Kabukta 'bonsai' veya 'ai' ile istediginiz sorguyu iletebilirsiniz.".ptr);
        g_ai_toplam_token = g_ai_toplam_token + 75;
        dondu 1;
    }

    # Genel / Serbest Soru Yaniti (Autoregressive Token Uretimi)
    eger g_ai_aktif_model == AI_MODEL_BONSAI ise {
        ykn_metin_kopyala(cikti, "[Bonsai-8B Uretim Sonucu]: Talebiniz analiz edildi.\nYknOS cekirdek katmani, bellek tahsiscisi ve dosya sistemi tam performansla calismaktadir. Sistem servisleri, donanim kesmeleri ve yapay zeka omurgasi tam esgudumludur. Baska bir gorev veya analiz icin hazirim.".ptr);
    } yoksa {
        ykn_metin_kopyala(cikti, "[Mikro-LLM BitNet 1.58b Yaniti]: Sorgunuz ternary causal transformer uzerinden islendi.\nAgirlik carpimlari sifir-carpma (addition/subtraction) ile tamamlandi. Sistem saglikli, tum alt sistemler (RamFS, SQL, HTTP, GUI) operasyonel durumdadir.".ptr);
    }
    g_ai_toplam_token = g_ai_toplam_token + 50;
    dondu 1;
}

# ------------------------------------------------------------
# 7. AI Alt Sistemi Ayrintili Telemetri ve Durum Tablosu
# ------------------------------------------------------------
isv ai_telemetri_yaz() {
    ekrana_yaz("=================================================================\n".ptr);
    ekrana_yaz("         YknOS GOMULU YAPAY ZEKA & LLM TELEMETRI RAPORU          \n".ptr);
    ekrana_yaz("=================================================================\n".ptr);
    ekrana_yaz("  Aktif Model:         ".ptr);
    ekrana_yaz(ai_aktif_model_adi());
    ekrana_yaz("\n  Toplam Islenen Soru: ".ptr);
    ykn_sayi_yaz(g_ai_toplam_sorgu);
    ekrana_yaz("\n  Uretilen Token:      ".ptr);
    ykn_sayi_yaz(g_ai_toplam_token);
    ekrana_yaz("\n-----------------------------------------------------------------\n".ptr);
    ekrana_yaz("  [1] Mikro-LLM BitNet 1.58b (Gomulu / Always-On)\n".ptr);
    ekrana_yaz("      - Durum:          ".ptr);
    eger g_ai_mikro_hazir == 1 ise {
        ekrana_yaz("ONLINE & AKTIF\n".ptr);
    } yoksa {
        ekrana_yaz("YUKLENMEDI\n".ptr);
    }
    ekrana_yaz("      - Parametre:      16,384 Ternary Agirlik {-1, 0, +1}\n".ptr);
    ekrana_yaz("      - Mimari:         1-Layer Causal Transformer (dim=32, ffn=64, vocab=256)\n".ptr);
    ekrana_yaz("      - Aritmetik:      Q16.16 Sabit Nokta (Toplama/Cikarma, Sifir Carpma)\n".ptr);
    ekrana_yaz("      - RAM Ayak Izi:   28 KB (16 KB Agirlik + 12 KB Aktivasyon)\n".ptr);
    ekrana_yaz("      - Donanim:        Saf CPU Makine Kodu / Ring-0 Kernel Uyumlu\n".ptr);
    ekrana_yaz("-----------------------------------------------------------------\n".ptr);
    ekrana_yaz("  [2] Prism ML Bonsai-8B (Yuksek Kapasiteli Dil Modeli)\n".ptr);
    ekrana_yaz("      - Durum:          ".ptr);
    eger g_ai_bonsai_hazir == 1 ise {
        ekrana_yaz("ONLINE & MOUNT EDILDI\n".ptr);
    } yoksa {
        ekrana_yaz("BAGLANAMADI\n".ptr);
    }
    ekrana_yaz("      - Format:         GGUF Sürüm ".ptr);
    ykn_sayi_yaz(g_bonsai_version);
    ekrana_yaz("\n      - Tensor Adedi:   ".ptr);
    ykn_sayi_yaz(g_bonsai_tensors);
    ekrana_yaz(" Tensor\n      - Dosya / Boyut:  models/bonsai-8b/Bonsai-8B.gguf (1.15 GB)\n".ptr);
    ekrana_yaz("      - Mimari:         Qwen CausalLM (36 Katman, 32 Kafa, 8 KV GQA)\n".ptr);
    ekrana_yaz("      - Kuantizasyon:   Q1_0 / IQ2_S Ultra-Dusuk Bit\n".ptr);
    ekrana_yaz("=================================================================\n".ptr);
}
