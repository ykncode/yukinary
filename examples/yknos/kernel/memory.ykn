# ============================================================
# YknOS Fiziksel Sayfa ve Yigin (Heap) Bellek Yoneticisi
# 4 KB Sayfalama, free -m Raporlama ve Sayfa Tahsisi
# ============================================================

ice_aktar "utils.ykn";
ice_aktar "serial.ykn";

degisken g_toplam_ram_mb: tamsayi = 64;
degisken g_sayfa_boyutu_bayt: tamsayi = 4096; # 4 KB
degisken g_toplam_sayfa: tamsayi = 16384;      # 64 MB / 4 KB
degisken g_kullanilan_sayfa: tamsayi = 768;    # Cekirdek, RamFS ve VRAM
degisken g_tahsis_sayaci: tamsayi = 6;

isv bellek_yoneticisi_baslat(toplam_mb: tamsayi) {
    g_toplam_ram_mb = toplam_mb;
    g_toplam_sayfa = (toplam_mb * 1024 * 1024) / g_sayfa_boyutu_bayt;
    g_kullanilan_sayfa = 768;
    seri_gunluk_yaz("MMU".ptr, "Fiziksel sayfa cerceve yoneticisi (4KB) baslatildi".ptr);
}

isv bellek_sayfa_ayir(adet: tamsayi) -> tamsayi {
    eger g_kullanilan_sayfa + adet > g_toplam_sayfa ise {
        seri_gunluk_yaz("MMU_HATA".ptr, "Yetersiz fiziksel bellek!".ptr);
        dondu 0 - 1;
    }
    degisken baslangic_sayfa: tamsayi = g_kullanilan_sayfa;
    g_kullanilan_sayfa = g_kullanilan_sayfa + adet;
    g_tahsis_sayaci = g_tahsis_sayaci + 1;
    dondu baslangic_sayfa;
}

# Standart Linux 'free -m' komutu ciktisi
isv bellek_free_m_yaz() {
    degisken toplam_mb: tamsayi = g_toplam_ram_mb;
    degisken kullanilan_mb: tamsayi = (g_kullanilan_sayfa * 4) / 1024;
    degisken serbest_mb: tamsayi = toplam_mb - kullanilan_mb;
    degisken buff_cache_mb: tamsayi = 1;
    degisken avail_mb: tamsayi = serbest_mb + buff_cache_mb;

    ekrana_yaz("               total        used        free      shared  buff/cache   available\n".ptr);
    ekrana_yaz("Mem:              ".ptr);
    ykn_sayi_yaz(toplam_mb);
    ekrana_yaz("           ".ptr);
    ykn_sayi_yaz(kullanilan_mb);
    ekrana_yaz("          ".ptr);
    ykn_sayi_yaz(serbest_mb);
    ekrana_yaz("           0           ".ptr);
    ykn_sayi_yaz(buff_cache_mb);
    ekrana_yaz("          ".ptr);
    ykn_sayi_yaz(avail_mb);
    ekrana_yaz("\nSwap:              0           0           0\n".ptr);
}

isv bellek_raporu_yaz() {
    bellek_free_m_yaz();
}
