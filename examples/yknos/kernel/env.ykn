# ============================================================
# YknOS Ortam Degiskenleri Yoneticisi (Linux Environment Variables)
# env, export KEY=VAL, getenv, setenv
# ============================================================

ice_aktar "utils.ykn";

yapi OrtamDegiskeni {
    anahtar: [24]u8;
    deger:   [64]u8;
    aktif:   tamsayi;
}

degisken g_env_tablosu: [16]OrtamDegiskeni;
degisken g_env_sayisi: tamsayi = 0;

isv env_baslat() {
    g_env_sayisi = 0;
    env_set("USER".ptr, "root".ptr);
    env_set("HOME".ptr, "/home/root".ptr);
    env_set("SHELL".ptr, "/bin/yknsh".ptr);
    env_set("PATH".ptr, "/bin:/usr/bin".ptr);
    env_set("TERM".ptr, "xterm-256color".ptr);
    env_set("HOSTNAME".ptr, "yknos-box".ptr);
    env_set("OS".ptr, "GNU/Linux 6.1.0-ykn (x86_64)".ptr);
    env_set("LANG".ptr, "tr_TR.UTF-8".ptr);
}

isv env_set(anahtar: *u8, deger: *u8) {
    degisken i: tamsayi = 0;
    dongu i < g_env_sayisi {
        eger g_env_tablosu[i].aktif == 1 ve ykn_metin_esit_mi(g_env_tablosu[i].anahtar, anahtar) == 1 ise {
            ykn_metin_kopyala(g_env_tablosu[i].deger, deger);
            dondu;
        }
        i = i + 1;
    }

    eger g_env_sayisi >= 16 ise { dondu; }
    degisken idx: tamsayi = g_env_sayisi;
    ykn_metin_kopyala(g_env_tablosu[idx].anahtar, anahtar);
    ykn_metin_kopyala(g_env_tablosu[idx].deger, deger);
    g_env_tablosu[idx].aktif = 1;
    g_env_sayisi = g_env_sayisi + 1;
}

isv env_listele() {
    degisken i: tamsayi = 0;
    dongu i < g_env_sayisi {
        eger g_env_tablosu[i].aktif == 1 ise {
            ekrana_yaz(g_env_tablosu[i].anahtar);
            ekrana_yaz("=".ptr);
            ekrana_yaz(g_env_tablosu[i].deger);
            ekrana_yaz("\n".ptr);
        }
        i = i + 1;
    }
}
