# ============================================================
# Örnek 81: Win32 Hızlı Tıklama Yarışı (Click Speed Test GUI)
# ============================================================
ice_aktar "std/gui/pencere.ykn";
ice_aktar "std/gui/widget.ykn";

degisken g_tiklama_skoru: tamsayi = 0;

isv tiklandi() {
    g_tiklama_skoru = g_tiklama_skoru + 1;
    ekrana_yaz("Skor: ");
    sayiyi_ekrana_yaz(g_tiklama_skoru);
    ekrana_yaz("\n".ptr);
}

isv ana() -> tamsayi {
    degisken p_h: tamsayi = pencere_olustur("YKN Hizli Tiklama Testi".ptr, 340, 260);
    eger p_h == 0 ise { dondu 1; }

    # Ana Tiklama Butonu
    buton_olustur(p_h, "BURAYA TIKLA!".ptr, 9001, 50, 40, 220, 80);

    # Sifirla Butonu
    buton_olustur(p_h, "Skoru Sifirla".ptr, 9002, 50, 140, 220, 40);

    ekrana_yaz("Hizli tiklama oyunu hazir.\n".ptr);
    olay_dongusu_calistir();
    dondu 0;
}
