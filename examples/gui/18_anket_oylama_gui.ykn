# ============================================================
# Örnek 67: Win32 Mini Anket / Oylama Kutusu GUI
# ============================================================
ice_aktar "std/gui/pencere.ykn";
ice_aktar "std/gui/widget.ykn";

degisken g_evet_oyu: tamsayi = 0;
degisken g_hayir_oyu: tamsayi = 0;

isv oy_ver(secim: tamsayi) {
    eger secim == 1 ise {
        g_evet_oyu = g_evet_oyu + 1;
    } yoksa {
        g_hayir_oyu = g_hayir_oyu + 1;
    }

    ekrana_yaz("Guncel Oylama Sonucu -> EVET: ");
    sayiyi_ekrana_yaz(g_evet_oyu);
    ekrana_yaz(" | HAYIR: ");
    sayiyi_ekrana_yaz(g_hayir_oyu);
    ekrana_yaz("\n".ptr);
}

isv ana() -> tamsayi {
    degisken p_h: tamsayi = pencere_olustur("YKN Hızlı Oylama Sandigi".ptr, 360, 220);
    eger p_h == 0 ise { dondu 1; }

    # Evet / Hayir Butonlari
    buton_olustur(p_h, "EVET (+1)".ptr, 9701, 40, 60, 120, 60);
    buton_olustur(p_h, "HAYIR (+1)".ptr, 9702, 180, 60, 120, 60);

    ekrana_yaz("Oylama sandigi acildi. Soru: YKN dilini begendiniz mi?\n".ptr);
    olay_dongusu_calistir();
    dondu 0;
}
