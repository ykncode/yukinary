ice_aktar "sandbox_gate.ykn";
ice_aktar "hir.ykn";
ice_aktar "mir.ykn";
ice_aktar "parser.ykn";
ice_aktar "macros.ykn";
ice_aktar "generics.ykn";
ice_aktar "typechecker.ykn";
ice_aktar "ir.ykn";
ice_aktar "ir_lower.ykn";
ice_aktar "ir_codegen_x64.ykn";
ice_aktar "optimizer.ykn";
ice_aktar "codegen.ykn";
ice_aktar "codegen/peephole.ykn";
ice_aktar "context.ykn";
ice_aktar "llm.ykn";
ice_aktar "safety.ykn";
ice_aktar "lsp.ykn";
ice_aktar "formatter.ykn";
ice_aktar "repl.ykn";
ice_aktar "paket.ykn";
