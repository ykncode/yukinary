    lsp_yanit_tirnak();
    lsp_yanit_tek_ch(44);
    lsp_yanit_tirnak();
    lsp_yanit_tek_ch(95);           # _
    lsp_yanit_tirnak();
    lsp_yanit_cstr("]".ptr);
    lsp_yanit_tek_ch(125);          # } completionProvider
    lsp_yanit_tek_ch(44);
    lsp_yanit_tirnak();
    lsp_yanit_cstr("hoverProvider".ptr);
    lsp_yanit_tirnak();
    lsp_yanit_cstr(":true,".ptr);
    lsp_yanit_tirnak();
    lsp_yanit_cstr("definitionProvider".ptr);
    lsp_yanit_tirnak();
    lsp_yanit_cstr(":true,".ptr);
    lsp_yanit_tirnak();
    lsp_yanit_cstr("diagnosticProvider".ptr);
    lsp_yanit_tirnak();
    lsp_yanit_tek_ch(58);
    lsp_yanit_tek_ch(123);
    lsp_yanit_tirnak();
    lsp_yanit_cstr("interFileDependencies".ptr);
    lsp_yanit_tirnak();
    lsp_yanit_cstr(":false,".ptr);
    lsp_yanit_tirnak();
    lsp_yanit_cstr("workspaceDiagnostics".ptr);
    lsp_yanit_tirnak();
    lsp_yanit_cstr(":false".ptr);
    lsp_yanit_tek_ch(125);          # } diagnosticProvider
    lsp_yanit_tek_ch(44);
    lsp_yanit_tirnak();
    lsp_yanit_cstr("documentFormattingProvider".ptr);
    lsp_yanit_tirnak();
    lsp_yanit_cstr(":false".ptr);
    lsp_yanit_tek_ch(125);          # } capabilities
    lsp_yanit_tek_ch(125);          # } result
