}

# Completion (kod tamamlama) yaniti
isv lsp_yanit_completion(id_sayi: tamsayi) {
    lsp_yanit_sifirla();
    lsp_json_rm_rpc(id_sayi);
    lsp_yanit_tek_ch(44);
    lsp_yanit_tirnak();
    lsp_yanit_cstr("result".ptr);
    lsp_yanit_tirnak();
    lsp_yanit_tek_ch(58);
    lsp_yanit_tek_ch(123);
    lsp_yanit_tirnak();
    lsp_yanit_cstr("isIncomplete".ptr);
    lsp_yanit_tirnak();
    lsp_yanit_cstr(":false,".ptr);
    lsp_yanit_tirnak();
    lsp_yanit_cstr("items".ptr);
    lsp_yanit_tirnak();
    lsp_yanit_cstr(":[".ptr);

    degisken ilk_kez: tamsayi = 1;
    degisken idx: tamsayi = 0;
    dongu idx < g_lsp_sembol_sayisi {
        degisken s: *LspSembol = g_lsp_semboller[idx];
        eger s == 0 ise { idx = idx + 1; devam_et; }
        eger ilk_kez == 0 ise { lsp_yanit_tek_ch(44); }
        ilk_kez = 0;
        lsp_yanit_tek_ch(123);
        lsp_yanit_tirnak();
        lsp_yanit_cstr("label".ptr);
        lsp_yanit_tirnak();
        lsp_yanit_tek_ch(58);
        lsp_yanit_json_str(s.isim, s.isim_uzn);
        lsp_yanit_tek_ch(44);
        lsp_yanit_tirnak();
        lsp_yanit_cstr("kind".ptr);
        lsp_yanit_tirnak();
        lsp_yanit_tek_ch(58);
        lsp_yanit_sayi(s.tip);
        eger s.aciklama != 0 ise {
            lsp_yanit_tek_ch(44);
            lsp_yanit_tirnak();
            lsp_yanit_cstr("detail".ptr);
            lsp_yanit_tirnak();
            lsp_yanit_tek_ch(58);
            lsp_yanit_json_cstr(s.aciklama);
        }
        lsp_yanit_tek_ch(125);
        idx = idx + 1;
    }

    # Always-On Micro-LLM Intent Snippet
    eger ilk_kez == 0 ise { lsp_yanit_tek_ch(44); }
    lsp_yanit_tek_ch(123);
    lsp_yanit_tirnak();
    lsp_yanit_cstr("label".ptr);
    lsp_yanit_tirnak();
    lsp_yanit_tek_ch(58);
    lsp_yanit_tirnak();
    lsp_yanit_cstr("ai_niyet_tamamla".ptr);
    lsp_yanit_tirnak();
    lsp_yanit_tek_ch(44);
    lsp_yanit_tirnak();
    lsp_yanit_cstr("kind".ptr);
    lsp_yanit_tirnak();
    lsp_yanit_cstr(":15,".ptr);
    lsp_yanit_tirnak();
    lsp_yanit_cstr("detail".ptr);
    lsp_yanit_tirnak();
    lsp_yanit_tek_ch(58);
    lsp_yanit_tirnak();
    lsp_yanit_cstr("Yukinary Always-On BitNet Micro-LLM".ptr);
    lsp_yanit_tirnak();
    lsp_yanit_tek_ch(125);

    lsp_yanit_cstr("]".ptr);
    lsp_yanit_tek_ch(125);
    lsp_yanit_tek_ch(125);
    lsp_yanit_gonder();
}

# Hover yaniti: satir,sutun'daki sembolu bul
isv lsp_yanit_hover(id_sayi: tamsayi, d: *LspDokuman, satir: tamsayi, sutun: tamsayi) {
    lsp_yanit_sifirla();
    lsp_json_rm_rpc(id_sayi);

    degisken bulunacak: *u8 = lsp_bel_tahsis(128);
    degisken buzn: tamsayi = 0;
    eger d != 0 ve d.icerik != 0 ise {
        degisken off: tamsayi = lsp_pozisyon_offset(d.icerik, d.icerik_uzunluk, satir, sutun);
        degisken bas: tamsayi = utf8_kimlik_baslangici(d.icerik, d.icerik_uzunluk, off);
        degisken son: tamsayi = utf8_kimlik_sonu(d.icerik, d.icerik_uzunluk, off);
        eger son > bas ise {
            buzn = son - bas;
            eger buzn > 127 ise { buzn = 127; }
            lsp_str_kopyala(bulunacak, d.icerik + bas, buzn);
        }
    }
    degisken bulunan_aciklama: *u8 = 0;
    degisken idx: tamsayi = 0;
    dongu idx < g_lsp_sembol_sayisi {
        degisken s: *LspSembol = g_lsp_semboller[idx];
        eger s != 0 ve s.isim_uzn == buzn ise {
            eger buzn == 0 ise { idx = idx + 1; devam_et; }
            eger lsp_str_esit(s.isim, bulunacak, buzn) == 1 ise {
                bulunan_aciklama = s.aciklama;
                durdur;
            }
        }
        idx = idx + 1;
    }

    eger bulunan_aciklama != 0 ise {
        lsp_yanit_tek_ch(44);
        lsp_yanit_tirnak();
        lsp_yanit_cstr("result".ptr);
        lsp_yanit_tirnak();
        lsp_yanit_tek_ch(58);
        lsp_yanit_tek_ch(123);
        lsp_yanit_tirnak();
        lsp_yanit_cstr("contents".ptr);
        lsp_yanit_tirnak();
        lsp_yanit_tek_ch(58);
        lsp_yanit_tek_ch(123);
        lsp_yanit_tirnak();
        lsp_yanit_cstr("kind".ptr);
        lsp_yanit_tirnak();
        lsp_yanit_tek_ch(58);
        lsp_yanit_tirnak();
        lsp_yanit_cstr("markdown".ptr);
        lsp_yanit_tirnak();
        lsp_yanit_tek_ch(44);
        lsp_yanit_tirnak();
        lsp_yanit_cstr("value".ptr);
        lsp_yanit_tirnak();
        lsp_yanit_tek_ch(58);
        lsp_yanit_tirnak();
        lsp_yanit_cstr("**Yukinary**  ".ptr);
        lsp_yanit_iki_ch(92, 110);    # JSON icinde escaped newline.
        # markdown contents - aciklama
        lsp_yanit_cstr(bulunan_aciklama);
        lsp_yanit_tirnak();
        lsp_yanit_tek_ch(125);      # } contents
        lsp_yanit_tek_ch(125);      # } result
    } yoksa {
        lsp_yanit_tek_ch(44);
        lsp_yanit_tirnak();
        lsp_yanit_cstr("result".ptr);
        lsp_yanit_tirnak();
        lsp_yanit_cstr(":null".ptr);
    }
    lsp_yanit_tek_ch(125);
    lsp_yanit_gonder();
}

# Definition yaniti
isv lsp_yanit_definition(id_sayi: tamsayi, d: *LspDokuman, satir: tamsayi, sutun: tamsayi) {
    lsp_yanit_sifirla();
    lsp_json_rm_rpc(id_sayi);

    degisken bulunacak: *u8 = lsp_bel_tahsis(128);
    degisken buzn: tamsayi = 0;
    eger d != 0 ve d.icerik != 0 ise {
        degisken off: tamsayi = lsp_pozisyon_offset(d.icerik, d.icerik_uzunluk, satir, sutun);
        degisken bas: tamsayi = utf8_kimlik_baslangici(d.icerik, d.icerik_uzunluk, off);
        degisken son: tamsayi = utf8_kimlik_sonu(d.icerik, d.icerik_uzunluk, off);
        eger son > bas ise { buzn = son - bas; eger buzn > 127 ise { buzn = 127; } lsp_str_kopyala(bulunacak, d.icerik + bas, buzn); }
    }

    degisken bulunan: *LspSembol = 0;
    degisken idx: tamsayi = 0;
    dongu idx < g_lsp_sembol_sayisi {
        degisken s: *LspSembol = g_lsp_semboller[idx];
        eger s != 0 ve s.isim_uzn == buzn ve buzn > 0 ise {
            eger lsp_str_esit(s.isim, bulunacak, buzn) == 1 ise { bulunan = s; durdur; }
        }
        idx = idx + 1;
    }

    eger bulunan != 0 ve d != 0 ise {
        degisken hedef_uri: *u8 = d.uri;
        degisken hedef_uri_uzn: tamsayi = d.uri_uzunluk;
        eger bulunan.uri != 0 ve bulunan.uri_uzn > 0 ise {
            hedef_uri = bulunan.uri;
            hedef_uri_uzn = bulunan.uri_uzn;
        }
        lsp_yanit_tek_ch(44);
        lsp_yanit_tirnak();
        lsp_yanit_cstr("result".ptr);
        lsp_yanit_tirnak();
        lsp_yanit_tek_ch(58);
        lsp_yanit_tek_ch(123);
        lsp_yanit_tirnak();
        lsp_yanit_cstr("uri".ptr);
        lsp_yanit_tirnak();
        lsp_yanit_tek_ch(58);
        lsp_yanit_json_str(hedef_uri, hedef_uri_uzn);
        lsp_yanit_tek_ch(44);
        lsp_yanit_tirnak();
        lsp_yanit_cstr("range".ptr);
        lsp_yanit_tirnak();
        lsp_yanit_tek_ch(58);
        lsp_yanit_tek_ch(123);
        lsp_yanit_tirnak();
        lsp_yanit_cstr("start".ptr);
        lsp_yanit_tirnak();
        lsp_yanit_tek_ch(58);
        lsp_yanit_tek_ch(123);
        lsp_yanit_tirnak();
        lsp_yanit_cstr("line".ptr);
        lsp_yanit_tirnak();
        lsp_yanit_tek_ch(58);
        lsp_yanit_sayi(bulunan.satir);
        lsp_yanit_tek_ch(44);
        lsp_yanit_tirnak();
        lsp_yanit_cstr("character".ptr);
        lsp_yanit_tirnak();
        lsp_yanit_tek_ch(58);
        lsp_yanit_sayi(bulunan.sutun);
        lsp_yanit_tek_ch(125);      # } start
        lsp_yanit_tek_ch(44);
        lsp_yanit_tirnak();
        lsp_yanit_cstr("end".ptr);
        lsp_yanit_tirnak();
        lsp_yanit_tek_ch(58);
        lsp_yanit_tek_ch(123);
        lsp_yanit_tirnak();
        lsp_yanit_cstr("line".ptr);
        lsp_yanit_tirnak();
        lsp_yanit_tek_ch(58);
        lsp_yanit_sayi(bulunan.satir);
        lsp_yanit_tek_ch(44);
        lsp_yanit_tirnak();
        lsp_yanit_cstr("character".ptr);
        lsp_yanit_tirnak();
        lsp_yanit_tek_ch(58);
        lsp_yanit_sayi(bulunan.sutun + utf8_utf16_birim_sayisi(bulunan.isim, 0, bulunan.isim_uzn));
        lsp_yanit_tek_ch(125);      # } end
        lsp_yanit_tek_ch(125);      # } range
        lsp_yanit_tek_ch(125);      # } result
    } yoksa {
        lsp_yanit_tek_ch(44);
        lsp_yanit_tirnak();
        lsp_yanit_cstr("result".ptr);
        lsp_yanit_tirnak();
        lsp_yanit_cstr(":null".ptr);
    }
    lsp_yanit_tek_ch(125);
    lsp_yanit_gonder();
}

# FAZ 13.3: Sembol Yeniden Adlandirma (prepareRename / rename)
isv lsp_yanit_prepare_rename(id_sayi: tamsayi, d: *LspDokuman, satir: tamsayi, sutun: tamsayi) {
    lsp_yanit_sifirla();
    lsp_json_rm_rpc(id_sayi);
    degisken buzn: tamsayi = 0;
    degisken bas: tamsayi = 0;
    degisken son: tamsayi = 0;
    eger d != 0 ve d.icerik != 0 ise {
        degisken off: tamsayi = lsp_pozisyon_offset(d.icerik, d.icerik_uzunluk, satir, sutun);
        bas = utf8_kimlik_baslangici(d.icerik, d.icerik_uzunluk, off);
        son = utf8_kimlik_sonu(d.icerik, d.icerik_uzunluk, off);
        eger son > bas { buzn = son - bas; }
    }
    eger buzn > 0 {
        lsp_yanit_tek_ch(44);
        lsp_yanit_tirnak(); lsp_yanit_cstr("result".ptr); lsp_yanit_tirnak();
        lsp_yanit_tek_ch(58);
        lsp_yanit_tek_ch(123);
        lsp_yanit_tirnak(); lsp_yanit_cstr("range".ptr); lsp_yanit_tirnak();
        lsp_yanit_tek_ch(58);
        lsp_yanit_tek_ch(123);
        lsp_yanit_tirnak(); lsp_yanit_cstr("start".ptr); lsp_yanit_tirnak();
        lsp_yanit_tek_ch(58);
        lsp_yanit_tek_ch(123);
        lsp_yanit_tirnak(); lsp_yanit_cstr("line".ptr); lsp_yanit_tirnak();
        lsp_yanit_tek_ch(58); lsp_yanit_sayi(satir);
        lsp_yanit_tek_ch(44);
        lsp_yanit_tirnak(); lsp_yanit_cstr("character".ptr); lsp_yanit_tirnak();
        lsp_yanit_tek_ch(58); lsp_yanit_sayi(sutun);
        lsp_yanit_tek_ch(125);
        lsp_yanit_tek_ch(44);
        lsp_yanit_tirnak(); lsp_yanit_cstr("end".ptr); lsp_yanit_tirnak();
        lsp_yanit_tek_ch(58);
        lsp_yanit_tek_ch(123);
        lsp_yanit_tirnak(); lsp_yanit_cstr("line".ptr); lsp_yanit_tirnak();
        lsp_yanit_tek_ch(58); lsp_yanit_sayi(satir);
        lsp_yanit_tek_ch(44);
        lsp_yanit_tirnak(); lsp_yanit_cstr("character".ptr); lsp_yanit_tirnak();
        lsp_yanit_tek_ch(58); lsp_yanit_sayi(sutun + buzn);
        lsp_yanit_tek_ch(125);
        lsp_yanit_tek_ch(125);
        lsp_yanit_tek_ch(44);
        lsp_yanit_tirnak(); lsp_yanit_cstr("placeholder".ptr); lsp_yanit_tirnak();
        lsp_yanit_tek_ch(58);
        lsp_yanit_json_str(d.icerik + bas, buzn);
        lsp_yanit_tek_ch(125);
    } yoksa {
        lsp_yanit_tek_ch(44);
        lsp_yanit_tirnak(); lsp_yanit_cstr("result".ptr); lsp_yanit_tirnak();
        lsp_yanit_cstr(":null".ptr);
    }
    lsp_yanit_tek_ch(125);
    lsp_yanit_gonder();
}

isv lsp_offset_satir_sutun(icerik: *u8, uzn: tamsayi, hedef_off: tamsayi, out_satir: *tamsayi, out_sutun: *tamsayi) {
    degisken satir: tamsayi = 0;
    degisken sutun: tamsayi = 0;
    degisken i: tamsayi = 0;
    dongu i < hedef_off ve i < uzn {
        eger icerik[i] == 10 {
            satir = satir + 1;
            sutun = 0;
        } yoksa {
            sutun = sutun + 1;
        }
        i = i + 1;
    }
    *out_satir = satir;
    *out_sutun = sutun;
}

isv lsp_yanit_rename(id_sayi: tamsayi, d: *LspDokuman, satir: tamsayi, sutun: tamsayi, yeni_isim: *u8, yeni_uzn: tamsayi) {
    lsp_yanit_sifirla();
    lsp_json_rm_rpc(id_sayi);
    degisken buzn: tamsayi = 0;
    degisken bas: tamsayi = 0;
    degisken son: tamsayi = 0;
    eger d != 0 ve d.icerik != 0 ise {
        degisken off: tamsayi = lsp_pozisyon_offset(d.icerik, d.icerik_uzunluk, satir, sutun);
        bas = utf8_kimlik_baslangici(d.icerik, d.icerik_uzunluk, off);
        son = utf8_kimlik_sonu(d.icerik, d.icerik_uzunluk, off);
        eger son > bas { buzn = son - bas; }
    }
    eger buzn > 0 ve yeni_isim != 0 ve yeni_uzn > 0 {
        degisken eski_isim: *u8 = d.icerik + bas;
        lsp_yanit_tek_ch(44);
        lsp_yanit_tirnak(); lsp_yanit_cstr("result".ptr); lsp_yanit_tirnak();
        lsp_yanit_tek_ch(58);
        lsp_yanit_tek_ch(123);
        lsp_yanit_tirnak(); lsp_yanit_cstr("changes".ptr); lsp_yanit_tirnak();
        lsp_yanit_tek_ch(58);
        lsp_yanit_tek_ch(123);

        degisken doc_adet: tamsayi = g_lsp_dokuman_sayisi;
        eger doc_adet <= 0 { doc_adet = 1; }
        degisken emitted_doc: tamsayi = 0;

        degisken di: tamsayi = 0;
        dongu di < doc_adet {
            degisken cur_doc: *LspDokuman = d;
            eger g_lsp_dokuman_sayisi > 0 ve g_lsp_dokumanlar[di] != 0 {
                cur_doc = g_lsp_dokumanlar[di];
            }
            eger cur_doc != 0 ve cur_doc.icerik != 0 ve cur_doc.icerik_uzunluk >= buzn {
                degisken txt: *u8 = cur_doc.icerik;
                degisken txt_uzn: tamsayi = cur_doc.icerik_uzunluk;
                degisken match_sayisi: tamsayi = 0;

                # Once dokumanda kac eslesme var sayalim
                degisken ti: tamsayi = 0;
                dongu ti <= txt_uzn - buzn {
                    degisken esit: tamsayi = 1;
                    degisken bi: tamsayi = 0;
                    dongu bi < buzn {
                        eger txt[ti + bi] != eski_isim[bi] { esit = 0; durdur; }
                        bi = bi + 1;
                    }
                    eger esit == 1 {
                        degisken sol_ok: tamsayi = 1;
                        eger ti > 0 ve utf8_kimlik_kodu_mi(txt[ti - 1]) == 1 { sol_ok = 0; }
                        degisken sag_ok: tamsayi = 1;
                        eger ti + buzn < txt_uzn ve utf8_kimlik_kodu_mi(txt[ti + buzn]) == 1 { sag_ok = 0; }
                        eger sol_ok == 1 ve sag_ok == 1 {
                            match_sayisi = match_sayisi + 1;
                        }
                    }
                    ti = ti + 1;
                }

                eger match_sayisi > 0 {
                    eger emitted_doc > 0 { lsp_yanit_tek_ch(44); } # ','
                    lsp_yanit_json_str(cur_doc.uri, cur_doc.uri_uzunluk);
                    lsp_yanit_tek_ch(58);
                    lsp_yanit_tek_ch(91); # '['

                    degisken curr_m: tamsayi = 0;
                    ti = 0;
                    dongu ti <= txt_uzn - buzn {
                        degisken esit: tamsayi = 1;
                        degisken bi: tamsayi = 0;
                        dongu bi < buzn {
                            eger txt[ti + bi] != eski_isim[bi] { esit = 0; durdur; }
                            bi = bi + 1;
                        }
                        eger esit == 1 {
                            degisken sol_ok: tamsayi = 1;
                            eger ti > 0 ve utf8_kimlik_kodu_mi(txt[ti - 1]) == 1 { sol_ok = 0; }
                            degisken sag_ok: tamsayi = 1;
                            eger ti + buzn < txt_uzn ve utf8_kimlik_kodu_mi(txt[ti + buzn]) == 1 { sag_ok = 0; }
                            eger sol_ok == 1 ve sag_ok == 1 {
                                eger curr_m > 0 { lsp_yanit_tek_ch(44); } # ','
                                degisken m_sat: tamsayi = 0;
                                degisken m_sut: tamsayi = 0;
                                lsp_offset_satir_sutun(txt, txt_uzn, ti, &m_sat, &m_sut);

                                lsp_yanit_tek_ch(123);
                                lsp_yanit_tirnak(); lsp_yanit_cstr("range".ptr); lsp_yanit_tirnak();
                                lsp_yanit_tek_ch(58);
                                lsp_yanit_tek_ch(123);
                                lsp_yanit_tirnak(); lsp_yanit_cstr("start".ptr); lsp_yanit_tirnak();
                                lsp_yanit_tek_ch(58);
                                lsp_yanit_tek_ch(123);
                                lsp_yanit_tirnak(); lsp_yanit_cstr("line".ptr); lsp_yanit_tirnak();
                                lsp_yanit_tek_ch(58); lsp_yanit_sayi(m_sat);
                                lsp_yanit_tek_ch(44);
                                lsp_yanit_tirnak(); lsp_yanit_cstr("character".ptr); lsp_yanit_tirnak();
                                lsp_yanit_tek_ch(58); lsp_yanit_sayi(m_sut);
                                lsp_yanit_tek_ch(125);
                                lsp_yanit_tek_ch(44);
                                lsp_yanit_tirnak(); lsp_yanit_cstr("end".ptr); lsp_yanit_tirnak();
                                lsp_yanit_tek_ch(58);
                                lsp_yanit_tek_ch(123);
                                lsp_yanit_tirnak(); lsp_yanit_cstr("line".ptr); lsp_yanit_tirnak();
                                lsp_yanit_tek_ch(58); lsp_yanit_sayi(m_sat);
                                lsp_yanit_tek_ch(44);
                                lsp_yanit_tirnak(); lsp_yanit_cstr("character".ptr); lsp_yanit_tirnak();
                                lsp_yanit_tek_ch(58); lsp_yanit_sayi(m_sut + buzn);
                                lsp_yanit_tek_ch(125);
                                lsp_yanit_tek_ch(125);
                                lsp_yanit_tek_ch(44);
                                lsp_yanit_tirnak(); lsp_yanit_cstr("newText".ptr); lsp_yanit_tirnak();
                                lsp_yanit_tek_ch(58);
                                lsp_yanit_json_str(yeni_isim, yeni_uzn);
                                lsp_yanit_tek_ch(125);

                                curr_m = curr_m + 1;
                            }
                        }
                        ti = ti + 1;
                    }
                    lsp_yanit_tek_ch(93); # ']'
                    emitted_doc = emitted_doc + 1;
                }
            }
            di = di + 1;
        }

        lsp_yanit_tek_ch(125); # '}' changes
        lsp_yanit_tek_ch(125); # '}' result
        lsp_yanit_tek_ch(125); # '}' root
    } yoksa {
        lsp_yanit_tek_ch(44);
        lsp_yanit_tirnak(); lsp_yanit_cstr("result".ptr); lsp_yanit_tirnak();
        lsp_yanit_cstr(":null".ptr);
        lsp_yanit_tek_ch(125);
    }
    lsp_yanit_gonder();
}

isv lsp_yanit_workspace_symbols(id_sayi: tamsayi) {
    lsp_yanit_sifirla();
    lsp_json_rm_rpc(id_sayi);
    lsp_yanit_tek_ch(44);
    lsp_yanit_tirnak();
    lsp_yanit_cstr("result".ptr);
    lsp_yanit_tirnak();
    lsp_yanit_cstr(":[".ptr);

    degisken ilk: tamsayi = 1;
    degisken i: tamsayi = 0;
    dongu i < g_lsp_sembol_sayisi {
        degisken s: *LspSembol = g_lsp_semboller[i];
        eger s != 0 ve s.tip != 14 { # Anahtar kelimeleri workspace symbol aramasina dahil etme
            eger ilk == 0 ise { lsp_yanit_tek_ch(44); }
            ilk = 0;
            lsp_yanit_tek_ch(123);
            lsp_yanit_tirnak();
            lsp_yanit_cstr("name".ptr);
            lsp_yanit_tirnak();
            lsp_yanit_tek_ch(58);
            lsp_yanit_json_str(s.isim, s.isim_uzn);
            lsp_yanit_tek_ch(44);
            lsp_yanit_tirnak();
            lsp_yanit_cstr("kind".ptr);
            lsp_yanit_tirnak();
            lsp_yanit_tek_ch(58);
            lsp_yanit_sayi(s.tip);
            lsp_yanit_tek_ch(44);
            lsp_yanit_tirnak();
            lsp_yanit_cstr("location".ptr);
            lsp_yanit_tirnak();
            lsp_yanit_tek_ch(58);
            lsp_yanit_tek_ch(123);
            lsp_yanit_tirnak();
            lsp_yanit_cstr("uri".ptr);
            lsp_yanit_tirnak();
            lsp_yanit_tek_ch(58);
            degisken s_uri: *u8 = "file:///workspace".ptr;
            degisken s_uri_uzn: tamsayi = 17;
            eger s.uri != 0 ve s.uri_uzn > 0 ise {
                s_uri = s.uri;
                s_uri_uzn = s.uri_uzn;
            }
            lsp_yanit_json_str(s_uri, s_uri_uzn);
            lsp_yanit_tek_ch(44);
            lsp_yanit_tirnak();
            lsp_yanit_cstr("range".ptr);
            lsp_yanit_tirnak();
            lsp_yanit_tek_ch(58);
            lsp_yanit_tek_ch(123);
            lsp_yanit_tirnak();
            lsp_yanit_cstr("start".ptr);
            lsp_yanit_tirnak();
            lsp_yanit_tek_ch(58);
            lsp_yanit_tek_ch(123);
            lsp_yanit_tirnak();
            lsp_yanit_cstr("line".ptr);
            lsp_yanit_tirnak();
            lsp_yanit_tek_ch(58);
            lsp_yanit_sayi(s.satir);
            lsp_yanit_tek_ch(44);
            lsp_yanit_tirnak();
            lsp_yanit_cstr("character".ptr);
            lsp_yanit_tirnak();
            lsp_yanit_tek_ch(58);
            lsp_yanit_sayi(s.sutun);
            lsp_yanit_tek_ch(125);
            lsp_yanit_tek_ch(44);
            lsp_yanit_tirnak();
            lsp_yanit_cstr("end".ptr);
            lsp_yanit_tirnak();
            lsp_yanit_tek_ch(58);
            lsp_yanit_tek_ch(123);
            lsp_yanit_tirnak();
            lsp_yanit_cstr("line".ptr);
            lsp_yanit_tirnak();
            lsp_yanit_tek_ch(58);
            lsp_yanit_sayi(s.satir);
            lsp_yanit_tek_ch(44);
            lsp_yanit_tirnak();
            lsp_yanit_cstr("character".ptr);
            lsp_yanit_tirnak();
            lsp_yanit_tek_ch(58);
            lsp_yanit_sayi(s.sutun + s.isim_uzn);
            lsp_yanit_tek_ch(125);
            lsp_yanit_tek_ch(125);
            lsp_yanit_tek_ch(125);
        }
        i = i + 1;
    }
    lsp_yanit_cstr("]".ptr);
    lsp_yanit_tek_ch(125);
    lsp_yanit_gonder();
}

# publishDiagnostics notification (id'siz)
isv lsp_bildirim_diagnostics(d: *LspDokuman) {
    eger d == 0 ise { dondu; }
    lsp_yanit_sifirla();
    lsp_yanit_tek_ch(123);          # {
    lsp_yanit_tirnak();
    lsp_yanit_cstr("jsonrpc".ptr);
    lsp_yanit_tirnak();
    lsp_yanit_tek_ch(58);
    lsp_yanit_tirnak();
    lsp_yanit_cstr("2.0".ptr);
    lsp_yanit_tirnak();
    lsp_yanit_tek_ch(44);
    lsp_yanit_tirnak();
    lsp_yanit_cstr("method".ptr);
    lsp_yanit_tirnak();
    lsp_yanit_tek_ch(58);
    lsp_yanit_tirnak();
    lsp_yanit_cstr("textDocument/publishDiagnostics".ptr);
    lsp_yanit_tirnak();
    lsp_yanit_tek_ch(44);
    lsp_yanit_tirnak();
    lsp_yanit_cstr("params".ptr);
    lsp_yanit_tirnak();
    lsp_yanit_tek_ch(58);
    lsp_yanit_tek_ch(123);
    lsp_yanit_tirnak();
    lsp_yanit_cstr("uri".ptr);
    lsp_yanit_tirnak();
    lsp_yanit_tek_ch(58);
    lsp_yanit_json_str(d.uri, d.uri_uzunluk);
    lsp_yanit_tek_ch(44);
    lsp_yanit_tirnak();
    lsp_yanit_cstr("version".ptr);
    lsp_yanit_tirnak();
    lsp_yanit_tek_ch(58);
    lsp_yanit_sayi(d.surum);
    lsp_yanit_tek_ch(44);
    lsp_yanit_tirnak();
    lsp_yanit_cstr("diagnostics".ptr);
    lsp_yanit_tirnak();
    lsp_yanit_cstr(":[".ptr);

    degisken ilk_kez: tamsayi = 1;
    degisken hi: tamsayi = 0;
    dongu hi < g_lsp_hata_sayisi {
        degisken h: *LspHata = g_lsp_hatalar[hi];
        eger h == 0 ise { hi = hi + 1; devam_et; }
        eger ilk_kez == 0 ise { lsp_yanit_tek_ch(44); }
        ilk_kez = 0;

        lsp_yanit_tek_ch(123);
        lsp_yanit_tirnak();
        lsp_yanit_cstr("range".ptr);
        lsp_yanit_tirnak();
        lsp_yanit_tek_ch(58);
        lsp_yanit_tek_ch(123);
        lsp_yanit_tirnak();
        lsp_yanit_cstr("start".ptr);
        lsp_yanit_tirnak();
        lsp_yanit_tek_ch(58);
        lsp_yanit_tek_ch(123);
        lsp_yanit_tirnak();
        lsp_yanit_cstr("line".ptr);
        lsp_yanit_tirnak();
        lsp_yanit_tek_ch(58);
        lsp_yanit_sayi(h.satir);
        lsp_yanit_tek_ch(44);
        lsp_yanit_tirnak();
        lsp_yanit_cstr("character".ptr);
        lsp_yanit_tirnak();
        lsp_yanit_tek_ch(58);
        lsp_yanit_sayi(h.sutun);
        lsp_yanit_tek_ch(125);
        lsp_yanit_tek_ch(44);
        lsp_yanit_tirnak();
        lsp_yanit_cstr("end".ptr);
        lsp_yanit_tirnak();
        lsp_yanit_tek_ch(58);
        lsp_yanit_tek_ch(123);
        lsp_yanit_tirnak();
        lsp_yanit_cstr("line".ptr);
        lsp_yanit_tirnak();
        lsp_yanit_tek_ch(58);
        lsp_yanit_sayi(h.satir_son);
        lsp_yanit_tek_ch(44);
        lsp_yanit_tirnak();
        lsp_yanit_cstr("character".ptr);
        lsp_yanit_tirnak();
        lsp_yanit_tek_ch(58);
        lsp_yanit_sayi(h.sutun_son);
        lsp_yanit_tek_ch(125);
        lsp_yanit_tek_ch(125);
        lsp_yanit_tek_ch(44);
        lsp_yanit_tirnak();
        lsp_yanit_cstr("severity".ptr);
        lsp_yanit_tirnak();
        lsp_yanit_tek_ch(58);
        lsp_yanit_sayi(h.siddet);
        lsp_yanit_tek_ch(44);
        lsp_yanit_tirnak();
        lsp_yanit_cstr("source".ptr);
        lsp_yanit_tirnak();
        lsp_yanit_tek_ch(58);
        lsp_yanit_tirnak();
        lsp_yanit_cstr("yukinary".ptr);
        lsp_yanit_tirnak();
        lsp_yanit_tek_ch(44);
        lsp_yanit_tirnak();
        lsp_yanit_cstr("message".ptr);
        lsp_yanit_tirnak();
        lsp_yanit_tek_ch(58);
        lsp_yanit_json_str(h.mesaj, h.mesaj_uzn);
        lsp_yanit_tek_ch(125);
        hi = hi + 1;
    }

    lsp_yanit_cstr("]".ptr);
    lsp_yanit_tek_ch(125);
    lsp_yanit_tek_ch(125);
    lsp_yanit_gonder();
}

# ============================================================
# LSP Ana Dongusu
# ============================================================
isv lsp_sunucusu_baslat() -> tamsayi {
    # Global tamponlari ayir
    g_lsp_tampon = lsp_bel_tahsis(LSP_TAMPON_BOYUTU);
    g_lsp_json   = lsp_bel_tahsis(LSP_JSON_BOYUTU);
    g_lsp_yanit  = lsp_bel_tahsis(LSP_JSON_BOYUTU);
    g_lsp_json_ara = lsp_bel_tahsis(1024);
    eger g_lsp_tampon == 0 veya g_lsp_json == 0 veya g_lsp_yanit == 0 veya g_lsp_json_ara == 0 ise {
        lsp_log("[LSP] tampon tahsis hatasi\n".ptr);
        dondu 1;
    }

    # Tek seferlik string tamponlari (her istekte tekrar tahsis ETME - memory leak onle)
    degisken method_str: *u8 = lsp_bel_tahsis(256);
    degisken uri_str:    *u8 = lsp_bel_tahsis(2048);
    degisken text_str:   *u8 = lsp_bel_tahsis(65536);
    eger method_str == 0 veya uri_str == 0 veya text_str == 0 ise {
        lsp_log("[LSP] string tampon tahsis hatasi\n".ptr);
        dondu 1;
    }

    degisken tampon_dolu: tamsayi = 0;
    degisken calisiyor: tamsayi = 1;
    degisken initialized: tamsayi = 0;
    degisken shutdown_alindi: tamsayi = 0;

    dongu calisiyor == 1 {
        # 1) Header'i once mevcut tamponda ara, yoksa yeni veri oku.
        # Bu sira, tek ReadFile ile birden fazla frame geldiginde gereklidir.
        degisken content_len: tamsayi = 0;
        degisken header_bulundu: tamsayi = 0;
        dongu header_bulundu == 0 ve calisiyor == 1 {
            degisken cl: tamsayi = 0;
            eger lsp_header_oku(g_lsp_tampon, &tampon_dolu, &cl) == 1 ise {
                content_len = cl;
                header_bulundu = 1;
            } yoksa {
                degisken header_okunan: tamsayi = lsp_ham_oku(g_lsp_tampon + tampon_dolu, LSP_TAMPON_BOYUTU - tampon_dolu);
                eger header_okunan > 0 ise {
                    tampon_dolu = tampon_dolu + header_okunan;
                } yoksa {
                    calisiyor = 0;
                    header_bulundu = 1;
                }
            }
        }

        # 2) Header parser body'yi tamponun basina tasir; eksikse tamamla.
        degisken istek_hazir: tamsayi = 0;
        eger calisiyor == 1 ve header_bulundu == 1 ise {
            istek_hazir = 1;
            dongu tampon_dolu < content_len ve calisiyor == 1 {
                degisken oku: tamsayi = content_len - tampon_dolu;
                eger oku > (LSP_TAMPON_BOYUTU - tampon_dolu) ise { oku = LSP_TAMPON_BOYUTU - tampon_dolu; }
                eger oku > 0 ise {
                    degisken body_okunan: tamsayi = lsp_ham_oku(g_lsp_tampon + tampon_dolu, oku);
                    eger body_okunan > 0 ise {
                        tampon_dolu = tampon_dolu + body_okunan;
                    } yoksa {
                        calisiyor = 0;
                    }
                } yoksa {
                    calisiyor = 0;
                }
            }
            eger tampon_dolu < content_len ise {
                istek_hazir = 0;
                calisiyor = 0;
            }
        }

        # Body'yi g_lsp_json'a kopyala, kalan baytlari basa tasi (partial buffer tut)
        eger istek_hazir == 1 ise {
            degisken json_uzn: tamsayi = content_len;
            eger json_uzn > LSP_JSON_BOYUTU - 1 ise { json_uzn = LSP_JSON_BOYUTU - 1; }
            lsp_str_kopyala(g_lsp_json, g_lsp_tampon, json_uzn);

        # Tampondaki islenmis body'yi sil (kalan saga kaydir)
        degisken kalan: tamsayi = tampon_dolu - content_len;
        eger kalan > 0 {
            degisken ki: tamsayi = 0;
            dongu ki < kalan {
                g_lsp_tampon[ki] = g_lsp_tampon[content_len + ki];
                ki = ki + 1;
            }
        }
        tampon_dolu = kalan;

        # === ISTEK/ISLEM ===
        # Method cek (tek seferlik tamponu kullaniyoruz)
        method_str[0] = 0;
        degisken method_n: tamsayi = lsp_json_str_cek(g_lsp_json, json_uzn, "method".ptr, 6, method_str, 256);

        # id cek (int)
        degisken id_sayi: tamsayi = -1;
        degisken id_var: tamsayi = lsp_json_sayi_cek(g_lsp_json, json_uzn, "id".ptr, 2, &id_sayi);

        # uri cek (textDocument.uri icin)
        uri_str[0] = 0;
        degisken uri_n: tamsayi = lsp_json_str_cek(g_lsp_json, json_uzn, "uri".ptr, 3, uri_str, 2048);

        # textDocument icerik cek (didOpen icin: params.textDocument.text)
        text_str[0] = 0;
        degisken text_n: tamsayi = lsp_json_str_cek(g_lsp_json, json_uzn, "text".ptr, 4, text_str, 65536);

        # position line/character cek
        degisken pos_line: tamsayi = 0;
        degisken pos_char: tamsayi = 0;
        lsp_json_sayi_cek(g_lsp_json, json_uzn, "line".ptr, 4, &pos_line);
        lsp_json_sayi_cek(g_lsp_json, json_uzn, "character".ptr, 9, &pos_char);

        # METHOD ROUTING
        eger method_n > 0 {
            # ===== initialize =====
            eger method_n == 10 ve lsp_str_esit(method_str, "initialize".ptr, 10) == 1 ise {
                lsp_yanit_initialize(id_sayi);
                initialized = 1;
            }
            # ===== initialized =====
            yoksa eger method_n == 11 ve lsp_str_esit(method_str, "initialized".ptr, 11) == 1 ise {
                # notification - yanit yok
            }
            # ===== shutdown =====
            yoksa eger method_n == 8 ve lsp_str_esit(method_str, "shutdown".ptr, 8) == 1 ise {
                lsp_yanit_bos(id_sayi);
                shutdown_alindi = 1;
            }
            # ===== exit =====
            yoksa eger method_n == 4 ve lsp_str_esit(method_str, "exit".ptr, 4) == 1 ise {
                calisiyor = 0;
            }
            # ===== textDocument/didOpen =====
            yoksa eger lsp_str_icinde(method_str, method_n, "didOpen".ptr, 7) >= 0 ise {
                eger uri_n > 0 ve text_n > 0 ise {
                    degisken dok: *LspDokuman = lsp_dokuman_ekle(uri_str, uri_n, text_str, text_n);
                    eger dok != 0 ise {
                        lsp_dokuman_analiz_et(dok);
                        lsp_bildirim_diagnostics(dok);
                    }
                }
            }
            # ===== textDocument/didChange =====
            yoksa eger lsp_str_icinde(method_str, method_n, "didChange".ptr, 9) >= 0 ise {
                # text field didOpen ile ayni sekilde "text":"" altinda de olabilir degilse contentChanges dizisinden cekilmeli
                eger uri_n > 0 ise {
                    eger text_n > 0 ise {
                        lsp_dokuman_ekle(uri_str, uri_n, text_str, text_n);
                    }
                    degisken dok: *LspDokuman = lsp_dokuman_bul(uri_str, uri_n);
                    eger dok != 0 ise {
                        lsp_dokuman_analiz_et(dok);
                        lsp_bildirim_diagnostics(dok);
                    }
                }
            }
            # ===== textDocument/didSave =====
            yoksa eger lsp_str_icinde(method_str, method_n, "didSave".ptr, 7) >= 0 ise {
                degisken dok: *LspDokuman = lsp_dokuman_bul(uri_str, uri_n);
                eger dok != 0 ise {
                    lsp_dokuman_analiz_et(dok);
                    lsp_bildirim_diagnostics(dok);
                }
            }
            # ===== textDocument/completion =====
            yoksa eger lsp_str_icinde(method_str, method_n, "completion".ptr, 10) >= 0 ise {
                # Semboller didOpen/didChange sirasinda guncellenir; her completion'da yeniden parse etme.
                degisken dok: *LspDokuman = lsp_dokuman_bul(uri_str, uri_n);
                eger dok == 0 ise { lsp_analiz_sifirla(); }
                lsp_yanit_completion(id_sayi);
            }
            # ===== textDocument/hover =====
            yoksa eger lsp_str_icinde(method_str, method_n, "hover".ptr, 5) >= 0 ise {
                degisken dok: *LspDokuman = lsp_dokuman_bul(uri_str, uri_n);
                eger dok != 0 ise {
                    lsp_dokuman_analiz_et(dok);
                    lsp_yanit_hover(id_sayi, dok, pos_line, pos_char);
                } yoksa {
                    lsp_yanit_bos(id_sayi);
                }
            }
            # ===== textDocument/definition =====
            yoksa eger lsp_str_icinde(method_str, method_n, "definition".ptr, 10) >= 0 ise {
                degisken dok: *LspDokuman = lsp_dokuman_bul(uri_str, uri_n);
                eger dok != 0 ise {
                    lsp_dokuman_analiz_et(dok);
                    lsp_yanit_definition(id_sayi, dok, pos_line, pos_char);
                } yoksa {
                    lsp_yanit_bos(id_sayi);
                }
            }
            # ===== textDocument/prepareRename =====
            yoksa eger lsp_str_icinde(method_str, method_n, "prepareRename".ptr, 13) >= 0 ise {
                degisken dok: *LspDokuman = lsp_dokuman_bul(uri_str, uri_n);
                eger dok != 0 ise {
                    lsp_dokuman_analiz_et(dok);
                    lsp_yanit_prepare_rename(id_sayi, dok, pos_line, pos_char);
                } yoksa {
                    lsp_yanit_bos(id_sayi);
                }
            }
            # ===== textDocument/rename =====
            yoksa eger lsp_str_icinde(method_str, method_n, "rename".ptr, 6) >= 0 ise {
                degisken dok: *LspDokuman = lsp_dokuman_bul(uri_str, uri_n);
                eger dok != 0 ise {
                    degisken yeni_ad: [128]u8;
                    degisken yeni_uzn: tamsayi = lsp_json_str_cek(g_lsp_json, json_uzn, "newName".ptr, 7, yeni_ad, 128);
                    lsp_dokuman_analiz_et(dok);
                    lsp_yanit_rename(id_sayi, dok, pos_line, pos_char, yeni_ad, yeni_uzn);
                } yoksa {
                    lsp_yanit_bos(id_sayi);
                }
            }
            # ===== textDocument/diagnostic =====
            yoksa eger lsp_str_icinde(method_str, method_n, "diagnostic".ptr, 10) >= 0 ise {
                degisken dok: *LspDokuman = lsp_dokuman_bul(uri_str, uri_n);
                eger dok != 0 ise {
                    lsp_dokuman_analiz_et(dok);
                }
                # Pull diagnostic - inline yanit
                lsp_yanit_sifirla();
                lsp_json_rm_rpc(id_sayi);
                lsp_yanit_tek_ch(44);
                lsp_yanit_tirnak();
                lsp_yanit_cstr("result".ptr);
                lsp_yanit_tirnak();
                lsp_yanit_tek_ch(58);
                lsp_yanit_tek_ch(123);
                lsp_yanit_tirnak();
                lsp_yanit_cstr("kind".ptr);
                lsp_yanit_tirnak();
                lsp_yanit_tek_ch(58);
                lsp_yanit_tirnak();
                lsp_yanit_cstr("full".ptr);
                lsp_yanit_tirnak();
                lsp_yanit_tek_ch(44);
                lsp_yanit_tirnak();
                lsp_yanit_cstr("items".ptr);
                lsp_yanit_tirnak();
                lsp_yanit_cstr(":[".ptr);
                degisken ilk_kez: tamsayi = 1;
                degisken hi: tamsayi = 0;
                dongu hi < g_lsp_hata_sayisi {
                    degisken h: *LspHata = g_lsp_hatalar[hi];
                    eger h == 0 ise { hi = hi + 1; devam_et; }
                    eger ilk_kez == 0 ise { lsp_yanit_tek_ch(44); }
                    ilk_kez = 0;
                    lsp_yanit_tek_ch(123);
                    lsp_yanit_tirnak();
                    lsp_yanit_cstr("range".ptr);
                    lsp_yanit_tirnak();
                    lsp_yanit_tek_ch(58);
                    lsp_yanit_tek_ch(123);
                    lsp_yanit_tirnak();
                    lsp_yanit_cstr("start".ptr);
                    lsp_yanit_tirnak();
                    lsp_yanit_tek_ch(58);
                    lsp_yanit_tek_ch(123);
                    lsp_yanit_tirnak();
                    lsp_yanit_cstr("line".ptr);
                    lsp_yanit_tirnak();
                    lsp_yanit_tek_ch(58);
                    lsp_yanit_sayi(h.satir);
                    lsp_yanit_tek_ch(44);
                    lsp_yanit_tirnak();
                    lsp_yanit_cstr("character".ptr);
                    lsp_yanit_tirnak();
                    lsp_yanit_tek_ch(58);
                    lsp_yanit_sayi(h.sutun);
                    lsp_yanit_tek_ch(125);
                    lsp_yanit_tek_ch(44);
                    lsp_yanit_tirnak();
                    lsp_yanit_cstr("end".ptr);
                    lsp_yanit_tirnak();
                    lsp_yanit_tek_ch(58);
                    lsp_yanit_tek_ch(123);
                    lsp_yanit_tirnak();
                    lsp_yanit_cstr("line".ptr);
                    lsp_yanit_tirnak();
                    lsp_yanit_tek_ch(58);
                    lsp_yanit_sayi(h.satir_son);
                    lsp_yanit_tek_ch(44);
                    lsp_yanit_tirnak();
                    lsp_yanit_cstr("character".ptr);
                    lsp_yanit_tirnak();
                    lsp_yanit_tek_ch(58);
                    lsp_yanit_sayi(h.sutun_son);
                    lsp_yanit_tek_ch(125);
                    lsp_yanit_tek_ch(125);
                    lsp_yanit_tek_ch(44);
                    lsp_yanit_tirnak();
                    lsp_yanit_cstr("severity".ptr);
                    lsp_yanit_tirnak();
                    lsp_yanit_tek_ch(58);
                    lsp_yanit_sayi(h.siddet);
                    lsp_yanit_tek_ch(44);
                    lsp_yanit_tirnak();
                    lsp_yanit_cstr("message".ptr);
                    lsp_yanit_tirnak();
                    lsp_yanit_tek_ch(58);
                    lsp_yanit_json_str(h.mesaj, h.mesaj_uzn);
                    lsp_yanit_tek_ch(125);
                    hi = hi + 1;
                }
                lsp_yanit_cstr("]".ptr);
                lsp_yanit_tek_ch(125);
                lsp_yanit_tek_ch(125);
                lsp_yanit_gonder();
            }
            # ===== textDocument/didClose =====
            yoksa eger lsp_str_icinde(method_str, method_n, "didClose".ptr, 8) >= 0 ise {
                # Dokumani kayit listesinden cikar (lifecycle: textDocument/didClose)
                eger uri_n > 0 ise {
                    lsp_dokuman_kapat(uri_str, uri_n);
                }
                # didClose notification: yanit gonderilmez
            }
            # ===== workspace/didChangeConfiguration =====
            yoksa eger lsp_str_icinde(method_str, method_n, "didChangeConfiguration".ptr, 24) >= 0 ise {
                # yanit yok - notification
            }
            # ===== workspace/didChangeWatchedFiles =====
            yoksa eger lsp_str_icinde(method_str, method_n, "didChangeWatchedFiles".ptr, 22) >= 0 ise {
                # yanit yok
            }
            # ===== workspace/symbol =====
            yoksa eger lsp_str_icinde(method_str, method_n, "workspace/symbol".ptr, 16) >= 0 veya lsp_str_icinde(method_str, method_n, "symbol".ptr, 6) >= 0 ise {
                lsp_yanit_workspace_symbols(id_sayi);
            }
            yoksa {
                # Bilinmeyen method - bos yanit (notification degilse)
                eger id_var == 1 ve id_sayi >= 0 ise {
                    lsp_yanit_bos(id_sayi);
                }
            }
        } yoksa {
            # Method yoksa ama id varsa bos yanit
            eger id_var == 1 ve id_sayi >= 0 ise {
                lsp_yanit_bos(id_sayi);
            }
        }

        eger shutdown_alindi == 1 ise {
            # shutdown alindi, cikmak icin exit bekle ama burada da donebiliriz
        }
        }  # istek_hazir
    }  # ana dongu sonu

    dondu 0;
}
