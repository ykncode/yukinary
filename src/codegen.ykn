# ============================================================
# Yukinary Codegen - Ana Orkestrator Modulu
# Modul: src/codegen.ykn
# ============================================================

ice_aktar "codegen/x86_emit.ykn";
ice_aktar "codegen/arm64_emit.ykn";
ice_aktar "codegen/output_riscv.ykn";
ice_aktar "codegen/output_wasm.ykn";
ice_aktar "codegen/x86_win32.ykn";
ice_aktar "codegen/x86_linux.ykn";
ice_aktar "codegen/regalloc.ykn";
ice_aktar "codegen/raii.ykn";

# Native debug byte output used by verbose field diagnostics. This is a
# real stdout operation through the compiler's existing ekrana_yaz builtin,
# not an unresolved placeholder call.
isv byte_yaz_stdout(deger: u8) {
    degisken tampon: [2]u8;
    tampon[0] = deger;
    tampon[1] = 0;
    ekrana_yaz(tampon);
}

# ============================================================
# Yerel degisken tablosu (lokal scope takibi)
# ============================================================
yapi LokalDegisken {
    isim:         *u8;
    uzunluk:      tamsayi;
    offset:       tamsayi;
    tip_adi:      *u8;
    tip_uzunluk:  tamsayi;
}

degisken g_lokal_adet: tamsayi = 0;
degisken g_lokal_stack_offset: tamsayi = 0;

degisken g_lokal_isimleri: [16384]*u8;
degisken g_lokal_uzunluklari: [16384]tamsayi;
degisken g_lokal_offsetleri: [16384]tamsayi;
degisken g_lokal_tip_adlari: [16384]*u8;
degisken g_lokal_tip_uzunluklari: [16384]tamsayi;
degisken g_lokal_yildizlari: [16384]tamsayi;
degisken g_lokal_dizi_boyutlari: [16384]tamsayi;

degisken g_fonk_isim: [16384]*u8;
degisken g_fonk_uzunluk: [16384]tamsayi;
degisken g_fonk_adres: [16384]tamsayi;
degisken g_fonk_modul_isim: [16384]*u8;
degisken g_fonk_modul_uzunluk: [16384]tamsayi;
degisken g_fonk_adet: tamsayi = 0;
degisken g_codegen_modul_isim: *u8 = 0;
degisken g_codegen_modul_uzunluk: tamsayi = 0;

# Inline modul isimleri icin derleme boyunca yasayan byte arena.
# Heap uzerinden uretilen pointer byte yazimi Stage-1'de compiler-internal
# cagrilara bagimli kalabildigi icin burada sabit byte dizisi kullanilir.
degisken g_modul_mangle_buf: [262144]u8;
degisken g_modul_mangle_kullanilan: tamsayi = 0;

# YamaTablosu flat parallel arrays (struct-of-arrays instead of array-of-structs)
# Buyuk self-host derlemelerinde tek geciste 4096'dan fazla call/branch
# patch'i uretilir; kapasite asimi compiler'in kendi kodunu bozmasin.
degisken YAMA_TABLO_KAPASITESI = 65536;
degisken g_yama_isim:      [65536]*u8;
degisken g_yama_uzunluk:   [65536]tamsayi;
degisken g_yama_cagri_pos: [65536]tamsayi;
degisken g_yama_adres:     [65536]tamsayi;
degisken g_yama_tip:       [65536]tamsayi;
degisken g_yama_adet:      tamsayi = 0;
degisken g_yama_fonk_bas:  tamsayi = 0;

# Enum constructor lookup: parser namespace flattening'i tam adla
# kaydedilmemişse __ sonrası kısa varyantı da dene.
isv enum_codegen_varyant_bul(isim: *u8, uzn: tamsayi) -> tamsayi {
    eger isim == 0 veya uzn <= 0 ise { dondu 0 - 1; }
    degisken idx: tamsayi = enum_varyant_bul_tam(isim, uzn);
    eger idx >= 0 ise { dondu idx; }
    # Düz constructor biçimi `Deger(...)` kısa varyant adı taşır.
    idx = enum_varyant_bul_kisa(isim, uzn);
    eger idx >= 0 ise { dondu idx; }
    degisken i: tamsayi = 0;
    dongu i + 1 < uzn {
        eger bellek_esit_mi(isim + i, "__".ptr, 2) == 1 ise {
            idx = enum_varyant_bul_kisa(isim + i + 2, uzn - i - 2);
            eger idx >= 0 ise { dondu idx; }
        }
        i = i + 1;
    }
    dondu 0 - 1;
}


degisken g_target_platform: tamsayi = 0;
degisken g_bounds_check: tamsayi = 0;
# Codegen'e ulasmamasi gereken AST dugumleri sessizce yutulmaz.
degisken g_codegen_unsupported_ast_hatasi: tamsayi = 0;
degisken g_codegen_compiletime_noop_sayisi: tamsayi = 0;
# Executable-node negative mutation acceptance. Normal builds keep it inactive.
degisken g_ast_mutasyon_hedef: tamsayi = 0;
degisken g_ast_mutasyon_aktif: tamsayi = 0;
degisken g_ast_mutasyon_uygulandi: tamsayi = 0;
degisken g_suanki_islev_async: tamsayi = 0;
degisken g_suanki_islev_ana: tamsayi = 0;
ice_aktar "codegen/audit_native.ykn";

# ============================================================
# #c-lib direktifi: Bagli kutuphanelerin kaydedildigi tablo.
# Codegen aninda kaydedilir; PE/ELF yazicisi kullanabilir.
# ============================================================
degisken G_CLIB_KAPASITE = 64;
degisken g_clib_isim: [64]*u8;
degisken g_clib_uzunluk: [64]tamsayi;
degisken g_clib_adet: tamsayi = 0;

# ============================================================
# Yukinary Çalışma Zamanı (Runtime) Sözleşmesi:
# - Tamsayı Taşmaları (Integer Overflow/Underflow): x86-64 mimarisinde standart 2's complement wrapping
#   davranışına tabidir. Taşmalar açıkça tanımlı olup, panik fırlatılmaz, "wrap-around" sergiler.
# - Dizi Erişimi (Bounds Check): Sınır ihlallerinde fail-fast panik üretilir.
# - OOM & Kapasite Aşımı: VirtualAlloc veya arena kapasitesi dolduğunda panik fırlatılır.
# ============================================================



# ============================================================
# Struct (yapi) kayit tablosu
# ============================================================
# Self-hosted derleyici artık formatter/repl ve AI ABI kayıtlarıyla birlikte
# 64 yapi sınırını aşabilir. Alan tablosu 32 alan/yapi sabit stride kullanır.
degisken YAPI_TABLO_KAPASITESI = 1024;
degisken YAPI_ALAN_STRIDE = 32;
degisken YAPI_ALAN_KAPASITESI = 32768;
degisken g_yapi_isim: [1024]*u8;
degisken g_yapi_uzunluk: [1024]tamsayi;
degisken g_yapi_alan_sayisi: [1024]tamsayi;
degisken g_yapi_byte_boyutu: [1024]tamsayi;

degisken g_yapi_alan_isim: [32768]*u8;
degisken g_yapi_alan_uzunluk: [32768]tamsayi;
degisken g_yapi_alan_offset: [32768]tamsayi;
degisken g_yapi_alan_tip_adi: [32768]*u8;
degisken g_yapi_alan_tip_uzn: [32768]tamsayi;
degisken g_yapi_alan_yildiz: [32768]tamsayi;
# FIX13: nullable pointer metadata for struct fields.
degisken g_yapi_alan_nullable: [32768]tamsayi;
degisken g_yapi_alan_dizi: [32768]tamsayi;

degisken g_yapi_adet: tamsayi = 0;
degisken g_yapi_kapasite_hatasi: tamsayi = 0;

isv tip_eleman_boyutu_al(tip_adi: *u8, tip_uzn: tamsayi, yildiz: tamsayi) -> tamsayi {
    eger yildiz > 0 ise { dondu 8; }
    eger tip_adi == 0 veya tip_uzn <= 0 ise { dondu 8; }
    eger tip_adi[0] == 42 ise { # '*'
        eger tip_uzn > 1 ise {
            dondu tip_eleman_boyutu_al(tip_adi + 1, tip_uzn - 1, 0);
        }
        dondu 8;
    }
    eger tip_uzn == 2 ise {
        eger (tip_adi[0] == 117 veya tip_adi[0] == 105) ve tip_adi[1] == 56 ise { # "u8", "i8"
            dondu 1;
        }
    }
    eger tip_uzn == 4 ise {
        eger bellek_esit_mi(tip_adi, "bayt".ptr, 4) == 1 veya bellek_esit_mi(tip_adi, "bool".ptr, 4) == 1 ise {
            dondu 1;
        }
    }
    eger tip_uzn == 3 ise {
        eger (tip_adi[0] == 117 veya tip_adi[0] == 105) ve tip_adi[1] == 49 ve tip_adi[2] == 54 ise { # "u16", "i16"
            dondu 2;
        }
        eger (tip_adi[0] == 117 veya tip_adi[0] == 105 veya tip_adi[0] == 102) ve tip_adi[1] == 51 ve tip_adi[2] == 50 ise { # "u32", "i32", "f32"
            dondu 4;
        }
        eger (tip_adi[0] == 117 veya tip_adi[0] == 105 veya tip_adi[0] == 102) ve tip_adi[1] == 54 ve tip_adi[2] == 52 ise { # "u64", "i64", "f64"
            dondu 8;
        }
    }
    eger tip_uzn == 7 ise {
        eger bellek_esit_mi(tip_adi, "tamsayi".ptr, 7) == 1 veya bellek_esit_mi(tip_adi, "ondalik".ptr, 7) == 1 ise {
            dondu 8;
        }
    }
    eger tip_uzn == 9 ise {
        eger bellek_esit_mi(tip_adi, "mantiksal".ptr, 9) == 1 ise {
            dondu 8;
        }
    }
    degisken s_i: tamsayi = 0;
    dongu s_i < g_yapi_adet {
        eger g_yapi_uzunluk[s_i] == tip_uzn ise {
            eger bellek_esit_mi(g_yapi_isim[s_i], tip_adi, tip_uzn) == 1 ise {
                degisken sz: tamsayi = g_yapi_byte_boyutu[s_i];
                eger sz <= 0 ise { sz = g_yapi_alan_sayisi[s_i] * 8; }
                eger sz <= 0 ise { sz = 8; }
                dondu sz;
            }
        }
        s_i = s_i + 1;
    }
    dondu 8;
}

# Codegen tablolarinin tamaminda fail-closed kapasite durumu.
# Kod üretimi kapasite asiminda devam etmez; main.ykn bu durumu artifact
# yazmadan once tanili bir derleme hatasi olarak raporlar.
degisken g_codegen_kapasite_hatasi: tamsayi = 0;
degisken g_codegen_kapasite_kodu: tamsayi = 0;

isv codegen_kapasite_reddet(kod: tamsayi) {
    eger g_codegen_kapasite_hatasi == 0 ise {
        g_codegen_kapasite_hatasi = 1;
        g_codegen_kapasite_kodu = kod;
    }
}

isv yama_kapasite_kontrol() -> tamsayi {
    eger g_yama_adet >= YAMA_TABLO_KAPASITESI ise {
        codegen_kapasite_reddet(2);
        dondu 0;
    }
    dondu 1;
}


yapi GlobalSabitDugum {
    isim: *u8;
    uzunluk: tamsayi;
    deger: tamsayi;
    sonraki: *GlobalSabitDugum;
}

degisken g_global_sabit_bas: *GlobalSabitDugum = 0;
degisken g_global_sabit_son: *GlobalSabitDugum = 0;

degisken g_global_isim: [16384]*u8;
degisken g_global_uzunluk: [16384]tamsayi;
degisken g_global_adres: [16384]tamsayi;
degisken g_global_tip_adi: [16384]*u8;
degisken g_global_tip_adi_uzunluk: [16384]tamsayi;
degisken g_global_is_pointer: [16384]tamsayi;
degisken g_global_dizi_boyutu: [16384]tamsayi;
degisken g_global_sayisi: tamsayi = 0;

# Global storage için ayrı collection/init fazı. AST emission sırasında
# karşılaşmaya bağlı adres üretimini engeller.
degisken g_global_ast: [16384]*AstDugum;
degisken g_global_ast_sayisi: tamsayi = 0;
degisken g_global_init_sayisi: tamsayi = 0;

degisken g_fonksiyon_icinde: tamsayi = 0;
degisken g_global_sabitleri_toplandi: tamsayi = 0;
degisken g_sabit_bulundu: tamsayi = 0;

isv codegen_sifirla() {
    g_lokal_adet = 0;
    g_lokal_stack_offset = 0;
    g_fonk_adet = 0;
    g_codegen_modul_isim = 0;
    g_codegen_modul_uzunluk = 0;
    g_modul_mangle_kullanilan = 0;
    g_yama_adet = 0;
    g_yama_fonk_bas = 0;
    g_iat_yama_adet = 0;
    g_iat_simd_kullanildi = 0;
    g_iat_dynamic_kullanildi = 0;
    g_clib_adet = 0;
    g_global_sayisi = 0;
    g_global_ast_sayisi = 0;
    g_global_init_sayisi = 0;
    g_global_sabit_bas = 0;
    # g_bounds_check is a CLI-selected compilation mode; do not reset it here.
    g_global_sabit_son = 0;
    g_global_sabitleri_toplandi = 0;
    g_yapi_adet = 0;
    g_yapi_kapasite_hatasi = 0;
    g_codegen_kapasite_hatasi = 0;
    g_codegen_kapasite_kodu = 0;
    g_codegen_unsupported_ast_hatasi = 0;
    g_codegen_compiletime_noop_sayisi = 0;
    # macOS output constants are compile-time values, not unresolved calls.
    global_sabit_ekle("CG_DARWIN_SYS_WRITE".ptr, 19, 0x2000004);
    global_sabit_ekle("CG_DARWIN_SYS_OPEN".ptr, 18, 0x2000005);
    global_sabit_ekle("CG_DARWIN_SYS_LSEEK".ptr, 19, 0x20000C7);
    global_sabit_ekle("CG_DARWIN_SYS_READ".ptr, 18, 0x2000003);
    global_sabit_ekle("CG_DARWIN_SYS_CLOSE".ptr, 19, 0x2000006);
    global_sabit_ekle("CG_DARWIN_O_WRCREAT_TRUNC".ptr, 25, 0x601);
    global_sabit_ekle("CG_DARWIN_MODE_644".ptr, 18, 420);
    ra_fonksiyon_sifirla();
    raii_sifirla();


    # Builtin struct: sonuc<T> (generic, but we register concrete field layout for codegen)
    # sonuc<T> layout: basarili (8), deger (8), hata_kodu (8) = 24 bytes
    g_yapi_isim[g_yapi_adet] = "sonuc".ptr;
    g_yapi_uzunluk[g_yapi_adet] = 5;
    g_yapi_alan_sayisi[g_yapi_adet] = 3;
    g_yapi_alan_isim[g_yapi_adet * 32 + 0] = "basarili".ptr;
    g_yapi_alan_uzunluk[g_yapi_adet * 32 + 0] = 8;
    g_yapi_alan_offset[g_yapi_adet * 32 + 0] = 0;
    g_yapi_alan_isim[g_yapi_adet * 32 + 1] = "deger".ptr;
    g_yapi_alan_uzunluk[g_yapi_adet * 32 + 1] = 5;
    g_yapi_alan_offset[g_yapi_adet * 32 + 1] = 8;
    g_yapi_alan_isim[g_yapi_adet * 32 + 2] = "hata_kodu".ptr;
    g_yapi_alan_uzunluk[g_yapi_adet * 32 + 2] = 9;
    g_yapi_alan_offset[g_yapi_adet * 32 + 2] = 16;
    g_yapi_byte_boyutu[g_yapi_adet] = 24;
    g_yapi_adet = g_yapi_adet + 1;

    # GOREV 6.4: "Sonuc" (buyuk S) — std/sonuc.ykn import'unda kullanilan isim
    g_yapi_isim[g_yapi_adet] = "Sonuc".ptr;
    g_yapi_uzunluk[g_yapi_adet] = 5;
    g_yapi_alan_sayisi[g_yapi_adet] = 3;
    g_yapi_alan_isim[g_yapi_adet * 32 + 0] = "basarili".ptr;
    g_yapi_alan_uzunluk[g_yapi_adet * 32 + 0] = 8;
    g_yapi_alan_offset[g_yapi_adet * 32 + 0] = 0;
    g_yapi_alan_isim[g_yapi_adet * 32 + 1] = "deger".ptr;
    g_yapi_alan_uzunluk[g_yapi_adet * 32 + 1] = 5;
    g_yapi_alan_offset[g_yapi_adet * 32 + 1] = 8;
    g_yapi_alan_isim[g_yapi_adet * 32 + 2] = "hata_kodu".ptr;
    g_yapi_alan_uzunluk[g_yapi_adet * 32 + 2] = 9;
    g_yapi_alan_offset[g_yapi_adet * 32 + 2] = 16;
    g_yapi_byte_boyutu[g_yapi_adet] = 24;
    g_yapi_adet = g_yapi_adet + 1;

    # Builtin struct: HataKaydi (9 fields = 72 bytes)
    g_yapi_isim[g_yapi_adet] = "HataKaydi".ptr;
    g_yapi_uzunluk[g_yapi_adet] = 9;
    g_yapi_alan_sayisi[g_yapi_adet] = 9;
    g_yapi_alan_isim[g_yapi_adet * 32 + 0] = "kod".ptr;
    g_yapi_alan_uzunluk[g_yapi_adet * 32 + 0] = 3;
    g_yapi_alan_offset[g_yapi_adet * 32 + 0] = 0;
    g_yapi_alan_isim[g_yapi_adet * 32 + 1] = "dosya_adi".ptr;
    g_yapi_alan_uzunluk[g_yapi_adet * 32 + 1] = 9;
    g_yapi_alan_offset[g_yapi_adet * 32 + 1] = 8;
    g_yapi_alan_isim[g_yapi_adet * 32 + 2] = "satir".ptr;
    g_yapi_alan_uzunluk[g_yapi_adet * 32 + 2] = 5;
    g_yapi_alan_offset[g_yapi_adet * 32 + 2] = 16;
    g_yapi_alan_isim[g_yapi_adet * 32 + 3] = "sutun".ptr;
    g_yapi_alan_uzunluk[g_yapi_adet * 32 + 3] = 5;
    g_yapi_alan_offset[g_yapi_adet * 32 + 3] = 24;
    g_yapi_alan_isim[g_yapi_adet * 32 + 4] = "mesaj".ptr;
    g_yapi_alan_uzunluk[g_yapi_adet * 32 + 4] = 5;
    g_yapi_alan_offset[g_yapi_adet * 32 + 4] = 32;
    g_yapi_alan_isim[g_yapi_adet * 32 + 5] = "ipucu".ptr;
    g_yapi_alan_uzunluk[g_yapi_adet * 32 + 5] = 5;
    g_yapi_alan_offset[g_yapi_adet * 32 + 5] = 40;
    g_yapi_alan_isim[g_yapi_adet * 32 + 6] = "kaynak_satir".ptr;
    g_yapi_alan_uzunluk[g_yapi_adet * 32 + 6] = 12;
    g_yapi_alan_offset[g_yapi_adet * 32 + 6] = 48;
    g_yapi_alan_isim[g_yapi_adet * 32 + 7] = "isaret_bas".ptr;
    g_yapi_alan_uzunluk[g_yapi_adet * 32 + 7] = 10;
    g_yapi_alan_offset[g_yapi_adet * 32 + 7] = 56;
    g_yapi_alan_isim[g_yapi_adet * 32 + 8] = "isaret_uzunluk".ptr;
    g_yapi_alan_uzunluk[g_yapi_adet * 32 + 8] = 14;
    g_yapi_alan_offset[g_yapi_adet * 32 + 8] = 64;
    g_yapi_adet = g_yapi_adet + 1;
}

# Linux x86-64 socket ABI: generic harici çağrı yerine doğrudan syscall.
# sockaddr_in geçici alanı stack üzerinde oluşturulur; OS hata kodu RAX'ta
# korunur. Böylece linklenmemiş bir sembolün sessizce çağrılması mümkün olmaz.
isv linux_socket_cagrisi(a: *MakineKoduArenasi, isim: *u8, uzn: tamsayi, arg_sayisi: tamsayi) -> tamsayi {
    eger g_target_platform != 1 veya isim == 0 ise { dondu 0; }
    eger uzn == 21 ve bellek_esit_mi(isim, "yukinary_sys_net_init".ptr, 21) == 1 ise {
        eger arg_sayisi != 0 ise { dondu 0; }
        emit_xor_rax_rax(a); dondu 1;
    }
    eger uzn == 26 ve bellek_esit_mi(isim, "yukinary_sys_socket_create".ptr, 26) == 1 ise {
        eger arg_sayisi != 3 ise { dondu 0; }
        byte_yaz(a, 0x48); byte_yaz(a, 0x89); byte_yaz(a, 0xCF);
        byte_yaz(a, 0x48); byte_yaz(a, 0x89); byte_yaz(a, 0xD6);
        byte_yaz(a, 0x4C); byte_yaz(a, 0x89); byte_yaz(a, 0xC2);
        emit_mov_rax_imm32(a, CG_LINUX_SYS_SOCKET); byte_yaz(a, 0x0F); byte_yaz(a, 0x05); dondu 1;
    }
    eger (uzn == 24 ve bellek_esit_mi(isim, "yukinary_sys_socket_bind".ptr, 24) == 1) veya
          (uzn == 27 ve bellek_esit_mi(isim, "yukinary_sys_socket_connect".ptr, 27) == 1) ise {
        eger arg_sayisi != 3 ise { dondu 0; }
        emit_sub_rsp(a, 16);
        byte_yaz(a, 0x66); byte_yaz(a, 0xC7); byte_yaz(a, 0x04); byte_yaz(a, 0x24); byte_yaz(a, 2); byte_yaz(a, 0);
        byte_yaz(a, 0x66); byte_yaz(a, 0x41); byte_yaz(a, 0xC1); byte_yaz(a, 0xC8); byte_yaz(a, 8);
        byte_yaz(a, 0x66); byte_yaz(a, 0x44); byte_yaz(a, 0x89); byte_yaz(a, 0x44); byte_yaz(a, 0x24); byte_yaz(a, 2);
        byte_yaz(a, 0x89); byte_yaz(a, 0x54); byte_yaz(a, 0x24); byte_yaz(a, 4);
        byte_yaz(a, 0x48); byte_yaz(a, 0xC7); byte_yaz(a, 0x44); byte_yaz(a, 0x24); byte_yaz(a, 8); int32_yaz(a, 0);
        byte_yaz(a, 0x48); byte_yaz(a, 0xC7); byte_yaz(a, 0x44); byte_yaz(a, 0x24); byte_yaz(a, 12); int32_yaz(a, 0);
        byte_yaz(a, 0x48); byte_yaz(a, 0x89); byte_yaz(a, 0xCF);
        byte_yaz(a, 0x48); byte_yaz(a, 0x89); byte_yaz(a, 0xE6);
        byte_yaz(a, 0x48); byte_yaz(a, 0xC7); byte_yaz(a, 0xC2); int32_yaz(a, 16);
        eger uzn == 24 ise { emit_mov_rax_imm32(a, CG_LINUX_SYS_BIND); }
        yoksa { emit_mov_rax_imm32(a, CG_LINUX_SYS_CONNECT); }
        byte_yaz(a, 0x0F); byte_yaz(a, 0x05); emit_add_rsp(a, 16); dondu 1;
    }
    eger uzn == 26 ve bellek_esit_mi(isim, "yukinary_sys_socket_listen".ptr, 26) == 1 ise {
        eger arg_sayisi != 2 ise { dondu 0; }
        byte_yaz(a, 0x48); byte_yaz(a, 0x89); byte_yaz(a, 0xCF); byte_yaz(a, 0x48); byte_yaz(a, 0x89); byte_yaz(a, 0xD6);
        emit_mov_rax_imm32(a, CG_LINUX_SYS_LISTEN); byte_yaz(a, 0x0F); byte_yaz(a, 0x05); dondu 1;
    }
