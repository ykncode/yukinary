isv windows_iat_cagri(a: *MakineKoduArenasi, slot: tamsayi) {
    eger iat_yama_kapasite_kontrol() == 0 ise { dondu; }
    byte_yaz(a, 0xFF); byte_yaz(a, 0x15);
    degisken iat_idx: tamsayi = g_iat_yama_adet;
    g_iat_yama_text_offset[iat_idx] = a.kullanilan;
    g_iat_yama_slot[iat_idx] = slot;
    g_iat_yama_adet = g_iat_yama_adet + 1;
    int32_yaz(a, 0);
}

# Windows x64 generated socket ABI. All external calls are resolved through
# the ws2_32 import slots emitted by output_pe.ykn; unresolved PE calls are
# never generated.
isv windows_socket_cagrisi(a: *MakineKoduArenasi, isim: *u8, uzn: tamsayi, arg_sayisi: tamsayi) -> tamsayi {
    eger g_target_platform != 0 veya isim == 0 ise { dondu 0; }
    eger uzn == 21 ve bellek_esit_mi(isim, "yukinary_sys_net_init".ptr, 21) == 1 ise {
        eger arg_sayisi != 0 ise { dondu 0; }
        emit_sub_rsp(a, 432);
        byte_yaz(a, 0x66); byte_yaz(a, 0xC7); byte_yaz(a, 0xC1); byte_yaz(a, 2); byte_yaz(a, 2);
        byte_yaz(a, 0x48); byte_yaz(a, 0x89); byte_yaz(a, 0xE2);
