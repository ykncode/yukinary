                eger f_uzn == 12 ve bellek_esit_mi(f_ptr, "guncel_index".ptr, 12) == 1 ise { asgn_field_off = 16; }
                eger f_uzn == 5 ve bellek_esit_mi(f_ptr, "arena".ptr, 5) == 1 ise {
                    eger asgn_t_adi != 0 ve asgn_t_uzn == 14 ve bellek_esit_mi(asgn_t_adi, "GenericsMotoru".ptr, 14) == 1 ise { asgn_field_off = 24; }
                    yoksa eger asgn_t_adi != 0 ve asgn_t_uzn == 9 ve bellek_esit_mi(asgn_t_adi, "TipMotoru".ptr, 9) == 1 ise { asgn_field_off = 8; }
                    yoksa { asgn_field_off = 24; }
                }
                eger f_uzn == 4 ve bellek_esit_mi(f_ptr, "veri".ptr, 4) == 1 ise { asgn_field_off = 0; }
                eger f_uzn == 6 ve bellek_esit_mi(f_ptr, "vtable".ptr, 6) == 1 ise { asgn_field_off = 8; }
                eger f_uzn == 6 ve bellek_esit_mi(f_ptr, "bellek".ptr, 6) == 1 ise { asgn_field_off = 0; }
                eger f_uzn == 8 ve bellek_esit_mi(f_ptr, "kapasite".ptr, 8) == 1 ise { asgn_field_off = 8; }
                eger f_uzn == 10 ve bellek_esit_mi(f_ptr, "kullanilan".ptr, 10) == 1 ise { asgn_field_off = 16; }
                eger f_uzn == 8 ve bellek_esit_mi(f_ptr, "kurallar".ptr, 8) == 1 ise { asgn_field_off = 0; }
                eger f_uzn == 12 ve bellek_esit_mi(f_ptr, "kayitli_sayi".ptr, 12) == 1 ise { asgn_field_off = 24; }
                eger f_uzn == 14 ve bellek_esit_mi(f_ptr, "sablon_listesi".ptr, 14) == 1 ise { asgn_field_off = 0; }
                eger f_uzn == 17 ve bellek_esit_mi(f_ptr, "monomorph_listesi".ptr, 17) == 1 ise { asgn_field_off = 8; }
                eger f_uzn == 13 ve bellek_esit_mi(f_ptr, "trait_tablosu".ptr, 13) == 1 ise { asgn_field_off = 16; }
                eger f_uzn == 12 ve bellek_esit_mi(f_ptr, "ilk_talimat".ptr, 12) == 1 ise { asgn_field_off = 0; }
                eger f_uzn == 12 ve bellek_esit_mi(f_ptr, "son_talimat".ptr, 12) == 1 ise { asgn_field_off = 8; }
                eger f_uzn == 18 ve bellek_esit_mi(f_ptr, "sanal_reg_sayaci".ptr, 18) == 1 ise { asgn_field_off = 16; }
                # Typechecker struct fallback offsets
                eger f_uzn == 8 ve bellek_esit_mi(f_ptr, "kategori".ptr, 8) == 1 ise { asgn_field_off = 0; }
                eger f_uzn == 8 ve bellek_esit_mi(f_ptr, "temel_id".ptr, 8) == 1 ise { asgn_field_off = 8; }
                eger f_uzn == 16 ve bellek_esit_mi(f_ptr, "pointer_seviyesi".ptr, 16) == 1 ise { asgn_field_off = 16; }
                eger f_uzn == 11 ve bellek_esit_mi(f_ptr, "dizi_boyutu".ptr, 11) == 1 ise { asgn_field_off = 24; }
                eger f_uzn == 11 ve bellek_esit_mi(f_ptr, "nominal_id".ptr, 11) == 1 ise { asgn_field_off = 32; }
                eger f_uzn == 6 ve bellek_esit_mi(f_ptr, "ic_tip".ptr, 6) == 1 ise { asgn_field_off = 40; }
                eger f_uzn == 13 ve bellek_esit_mi(f_ptr, "guncel_kapsam".ptr, 13) == 1 ise { asgn_field_off = 0; }
                eger f_uzn == 5 ve bellek_esit_mi(f_ptr, "arena".ptr, 5) == 1 ise { asgn_field_off = 8; }
                eger f_uzn == 11 ve bellek_esit_mi(f_ptr, "hata_sayisi".ptr, 11) == 1 ise { asgn_field_off = 16; }
                eger f_uzn == 17 ve bellek_esit_mi(f_ptr, "guncel_donus_tipi".ptr, 17) == 1 ise { asgn_field_off = 24; }
                eger f_uzn == 11 ve bellek_esit_mi(f_ptr, "tip_tamsayi".ptr, 11) == 1 ise { asgn_field_off = 32; }
                eger f_uzn == 10 ve bellek_esit_mi(f_ptr, "tip_gercek".ptr, 10) == 1 ise { asgn_field_off = 40; }
                eger f_uzn == 9 ve bellek_esit_mi(f_ptr, "tip_metin".ptr, 9) == 1 ise { asgn_field_off = 48; }
                eger f_uzn == 10 ve bellek_esit_mi(f_ptr, "tip_mantik".ptr, 10) == 1 ise { asgn_field_off = 56; }
                eger f_uzn == 6 ve bellek_esit_mi(f_ptr, "tip_u8".ptr, 6) == 1 ise { asgn_field_off = 64; }
                eger f_uzn == 9 ve bellek_esit_mi(f_ptr, "tip_islev".ptr, 9) == 1 ise { asgn_field_off = 72; }
                eger f_uzn == 7 ve bellek_esit_mi(f_ptr, "tip_hic".ptr, 7) == 1 ise { asgn_field_off = 80; }
                eger f_uzn == 14 ve bellek_esit_mi(f_ptr, "tip_bilinmiyor".ptr, 14) == 1 ise { asgn_field_off = 88; }
                eger f_uzn == 9 ve bellek_esit_mi(f_ptr, "tip_sonuc".ptr, 9) == 1 ise { asgn_field_off = 96; }
                eger f_uzn == 20 ve bellek_esit_mi(f_ptr, "tanimsiz_hata_sayisi".ptr, 20) == 1 ise { asgn_field_off = 104; }
                eger f_uzn == 23 ve bellek_esit_mi(f_ptr, "tip_uyumsuz_hata_sayisi".ptr, 23) == 1 ise { asgn_field_off = 112; }
                eger f_uzn == 17 ve bellek_esit_mi(f_ptr, "donus_hata_sayisi".ptr, 17) == 1 ise { asgn_field_off = 120; }
                eger f_uzn == 24 ve bellek_esit_mi(f_ptr, "param_sayisi_hata_sayisi".ptr, 24) == 1 ise { asgn_field_off = 128; }
                eger f_uzn == 15 ve bellek_esit_mi(f_ptr, "self_heal_adayi".ptr, 15) == 1 ise { asgn_field_off = 136; }
                eger f_uzn == 25 ve bellek_esit_mi(f_ptr, "self_heal_deger_konteksti".ptr, 25) == 1 ise { asgn_field_off = 144; }
                eger f_uzn == 5 ve bellek_esit_mi(f_ptr, "tablo".ptr, 5) == 1 ise { asgn_field_off = 0; }
                eger f_uzn == 10 ve bellek_esit_mi(f_ptr, "ust_kapsam".ptr, 10) == 1 ise { asgn_field_off = 16; }
                eger f_uzn == 9 ve bellek_esit_mi(f_ptr, "isim_hash".ptr, 9) == 1 ise { asgn_field_off = 0; }
                eger f_uzn == 12 ve bellek_esit_mi(f_ptr, "tanim_jetonu".ptr, 12) == 1 ise { asgn_field_off = 8; }
                eger f_uzn == 9 ve bellek_esit_mi(f_ptr, "veri_tipi".ptr, 9) == 1 ise { asgn_field_off = 16; }
                eger f_uzn == 10 ve bellek_esit_mi(f_ptr, "donus_tipi".ptr, 10) == 1 ise { asgn_field_off = 24; }
                eger f_uzn == 10 ve bellek_esit_mi(f_ptr, "ast_tanimi".ptr, 10) == 1 ise { asgn_field_off = 32; }
                # GOREV 6.4: Sonuc<T> struct alanlari fallback (import edildiginde g_yapi tablosu eslesemeyebilir)
                eger f_uzn == 8 ve bellek_esit_mi(f_ptr, "basarili".ptr, 8) == 1 ise { asgn_field_off = 0; }
                eger f_uzn == 5 ve bellek_esit_mi(f_ptr, "deger".ptr, 5) == 1 ise { asgn_field_off = 8; }
                eger f_uzn == 9 ve bellek_esit_mi(f_ptr, "hata_kodu".ptr, 9) == 1 ise { asgn_field_off = 16; }
                # Import modulu icindeki yapi tablosu kayitli degilse bile
                # Arc'in ABI layout'u acik ve sabittir.
                eger asgn_t_adi != 0 ve asgn_t_uzn == 10 ve bellek_esit_mi(asgn_t_adi, "ArcKontrol".ptr, 10) == 1 ise {
                    eger f_uzn == 8 ve bellek_esit_mi(f_ptr, "veri_ptr".ptr, 8) == 1 ise { asgn_field_off = 0; }
                    eger f_uzn == 14 ve bellek_esit_mi(f_ptr, "ref_sayisi_ptr".ptr, 14) == 1 ise { asgn_field_off = 8; }
                }
                eger asgn_t_adi != 0 ve asgn_t_uzn == 3 ve bellek_esit_mi(asgn_t_adi, "Arc".ptr, 3) == 1 ise {
                    eger f_uzn == 11 ve bellek_esit_mi(f_ptr, "kontrol_ptr".ptr, 11) == 1 ise { asgn_field_off = 0; }
                }
                # Import yapi metadata'si eksikse isim bazli son fallback.
                eger f_uzn == 8 ve bellek_esit_mi(f_ptr, "veri_ptr".ptr, 8) == 1 ise { asgn_field_off = 0; }
                eger f_uzn == 14 ve bellek_esit_mi(f_ptr, "ref_sayisi_ptr".ptr, 14) == 1 ise { asgn_field_off = 8; }
                eger f_uzn == 11 ve bellek_esit_mi(f_ptr, "kontrol_ptr".ptr, 11) == 1 ise { asgn_field_off = 0; }
            }
            # Arc ABI override: imported yapi metadata'si hatali veya eksik
            # olsa bile bu alanlarin offset'i degistirilemez.
            eger asgn_field_off == (0 - 1) ve asgn_field != 0 ve asgn_field.ilk_jeton != 0 ise {
                eger asgn_field.ilk_jeton.uzunluk == 8 ve bellek_esit_mi(asgn_field.ilk_jeton.baslangic, "veri_ptr".ptr, 8) == 1 ise { asgn_field_off = 0; }
                eger asgn_field.ilk_jeton.uzunluk == 14 ve bellek_esit_mi(asgn_field.ilk_jeton.baslangic, "ref_sayisi_ptr".ptr, 14) == 1 ise { asgn_field_off = 8; }
                eger asgn_field.ilk_jeton.uzunluk == 11 ve bellek_esit_mi(asgn_field.ilk_jeton.baslangic, "kontrol_ptr".ptr, 11) == 1 ise { asgn_field_off = 0; }
            }
            # Nesne pointer'ini RAX'e yukle: lokal degisken ise load, nested ifade ise yeniden uret
            eger asgn_var_off != 0 ise {
                eger obj_is_ptr == 1 ise {
                    emit_load_rax(a, asgn_var_off);
                } yoksa {
                    emit_lea_rax(a, asgn_var_off);
                }
            } yoksa eger g_found == 1 ise {
                eger obj_is_ptr == 1 ise {
                    byte_yaz(a, 72); byte_yaz(a, 139); byte_yaz(a, 5); # MOV RAX, [RIP+rel32]
                } yoksa {
                    byte_yaz(a, 72); byte_yaz(a, 141); byte_yaz(a, 5); # LEA RAX, [RIP+rel32]
                }
                int32_yaz(a, g_addr - (a.kullanilan + 4));
            } yoksa {
                ast_kod_uret(a, asgn_obj);
            }
            byte_yaz(a, 0x59); # POP RCX (atanacak deger)
            eger asgn_field_off != (0 - 1) ise {
                eger asgn_field_elem_sz == 1 ise {
                    eger asgn_field_off <= 127 ise {
                        byte_yaz(a, 0x88); byte_yaz(a, 0x48); byte_yaz(a, asgn_field_off);
                    } yoksa {
                        byte_yaz(a, 0x88); byte_yaz(a, 0x88); int32_yaz(a, asgn_field_off);
                    }
                } yoksa eger asgn_field_elem_sz == 2 ise {
                    eger asgn_field_off <= 127 ise {
                        byte_yaz(a, 0x66); byte_yaz(a, 0x89); byte_yaz(a, 0x48); byte_yaz(a, asgn_field_off);
                    } yoksa {
                        byte_yaz(a, 0x66); byte_yaz(a, 0x89); byte_yaz(a, 0x88); int32_yaz(a, asgn_field_off);
                    }
                } yoksa eger asgn_field_elem_sz == 4 ise {
                    eger asgn_field_off <= 127 ise {
                        byte_yaz(a, 0x89); byte_yaz(a, 0x48); byte_yaz(a, asgn_field_off);
                    } yoksa {
                        byte_yaz(a, 0x89); byte_yaz(a, 0x88); int32_yaz(a, asgn_field_off);
                    }
                } yoksa {
                    eger asgn_field_off <= 127 ise {
                        byte_yaz(a, 0x48); byte_yaz(a, 0x89); byte_yaz(a, 0x48);
                        byte_yaz(a, asgn_field_off);
                    } yoksa {
                        byte_yaz(a, 0x48); byte_yaz(a, 0x89); byte_yaz(a, 0x88);
                        int32_yaz(a, asgn_field_off);
                    }
                }
            }
            dondu 0;
        }
        # Dizi indeks atamasi: arr[i] = ifade
        # ONEMLI: Once kod uret (AST_ALAN_ERISIMI tip bilgisini yazsin), sonra fallback al
        eger sol.tip == AST_INDEKS_ERISIMI ise {
            byte_yaz(a, 0x50); # PUSH RAX (atanacak deger)
            degisken arr_node: *AstDugum = sol.sol;
            degisken idx_node: *AstDugum = sol.sag;
            degisken lvar_off: tamsayi = 0;
            degisken lvar_dizi: tamsayi = 0;
            degisken lvar_yildiz: tamsayi = 0;
            degisken lvar_tip_adi: *u8 = 0;
            degisken lvar_tip_uzunluk: tamsayi = 0;
            eger arr_node.tip == AST_KIMLIK ise {
                degisken lki: tamsayi = 0;
                dongu lki < g_lokal_adet {
                    eger g_lokal_uzunluklari[lki] == arr_node.ilk_jeton.uzunluk ise {
                        eger bellek_esit_mi(g_lokal_isimleri[lki], arr_node.ilk_jeton.baslangic, g_lokal_uzunluklari[lki]) == 1 ise {
                            lvar_off = g_lokal_offsetleri[lki];
                            lvar_tip_adi = g_lokal_tip_adlari[lki];
                            lvar_tip_uzunluk = g_lokal_tip_uzunluklari[lki];
                            lvar_yildiz = g_lokal_yildizlari[lki];
                            lvar_dizi = lokal_bul_dizi(arr_node.ilk_jeton.baslangic, arr_node.ilk_jeton.uzunluk);
                        }
                    }
                    lki = lki + 1;
                }
                eger lvar_off == 0 ve lvar_tip_adi == 0 ise {
                    degisken gki: tamsayi = 0;
                    dongu gki < g_global_sayisi {
                        eger g_global_uzunluk[gki] == arr_node.ilk_jeton.uzunluk ise {
                            eger bellek_esit_mi(g_global_isim[gki], arr_node.ilk_jeton.baslangic, g_global_uzunluk[gki]) == 1 ise {
                                lvar_tip_adi = g_global_tip_adi[gki];
                                lvar_tip_uzunluk = g_global_tip_adi_uzunluk[gki];
                                lvar_yildiz = g_global_is_pointer[gki];
                                lvar_dizi = g_global_dizi_boyutu[gki];
                                durdur;
                            }
                        }
                        gki = gki + 1;
                    }
                }
            }
            # ADIM 1 (ONCELIKLE): Taban adresi uret/yukle
            eger lvar_off != 0 ve lvar_dizi > 0 ise {
                eger lvar_off <= 127 ise {
                    byte_yaz(a, 0x48); byte_yaz(a, 0x8D); byte_yaz(a, 0x45);
                    byte_yaz(a, 256 - lvar_off);
                } yoksa {
                    byte_yaz(a, 0x48); byte_yaz(a, 0x8D); byte_yaz(a, 0x85);
                    int32_yaz(a, 0 - lvar_off);
                }
            } yoksa {
                ast_kod_uret(a, arr_node);
            }
            # ADIM 2 (KOD URETIMINDEN SONRA): Fallback
            eger lvar_yildiz == 0 ve lvar_dizi == 0 ve lvar_tip_adi == 0 ise {
                lvar_yildiz = arr_node.cozumlenmis_tip;
                lvar_tip_adi = arr_node.tip_adi;
                lvar_tip_uzunluk = arr_node.tip_adi_uzunluk;
                eger arr_node.tip != 17 ise {
                    lvar_dizi = arr_node.dizi_boyutu;
                }
            }
            # ADIM 3: Element olcegi
            degisken elem_yildiz2: tamsayi = 0;
            eger lvar_dizi > 0 ise {
                elem_yildiz2 = lvar_yildiz;
            } yoksa eger lvar_yildiz > 0 ise {
                elem_yildiz2 = lvar_yildiz - 1;
            }
            degisken lelm_scale: tamsayi = tip_eleman_boyutu_al(lvar_tip_adi, lvar_tip_uzunluk, elem_yildiz2);
            degisken lis_byte_array: tamsayi = 0;
            eger lelm_scale == 1 ise { lis_byte_array = 1; }
            eger lis_byte_array == 0 ve arr_node.tip == 17 ise { # AST_ALAN_ERISIMI
                degisken fld: *AstDugum = arr_node.sag;
                eger fld != 0 ve fld.ilk_jeton != 0 ise {
                    eger fld.ilk_jeton.uzunluk == 6 ve bellek_esit_mi(fld.ilk_jeton.baslangic, "bellek".ptr, 6) == 1 ise { lis_byte_array = 1; lelm_scale = 1; }
                    yoksa eger fld.ilk_jeton.uzunluk == 6 ve bellek_esit_mi(fld.ilk_jeton.baslangic, "kaynak".ptr, 6) == 1 ise { lis_byte_array = 1; lelm_scale = 1; }
                    yoksa eger fld.ilk_jeton.uzunluk == 6 ve bellek_esit_mi(fld.ilk_jeton.baslangic, "icerik".ptr, 6) == 1 ise { lis_byte_array = 1; lelm_scale = 1; }
                    yoksa eger fld.ilk_jeton.uzunluk == 4 ve bellek_esit_mi(fld.ilk_jeton.baslangic, "veri".ptr, 4) == 1 ise { lis_byte_array = 1; lelm_scale = 1; }
                    yoksa eger fld.ilk_jeton.uzunluk == 3 ve bellek_esit_mi(fld.ilk_jeton.baslangic, "ptr".ptr, 3) == 1 ise { lis_byte_array = 1; lelm_scale = 1; }
                    yoksa eger fld.ilk_jeton.uzunluk == 9 ve bellek_esit_mi(fld.ilk_jeton.baslangic, "baslangic".ptr, 9) == 1 ise { lis_byte_array = 1; lelm_scale = 1; }
                    yoksa eger fld.ilk_jeton.uzunluk == 7 ve bellek_esit_mi(fld.ilk_jeton.baslangic, "tip_adi".ptr, 7) == 1 ise { lis_byte_array = 1; lelm_scale = 1; }
                    yoksa eger fld.ilk_jeton.uzunluk == 5 ve bellek_esit_mi(fld.ilk_jeton.baslangic, "mesaj".ptr, 5) == 1 ise { lis_byte_array = 1; lelm_scale = 1; }
                    yoksa eger fld.ilk_jeton.uzunluk == 5 ve bellek_esit_mi(fld.ilk_jeton.baslangic, "ipucu".ptr, 5) == 1 ise { lis_byte_array = 1; lelm_scale = 1; }
                    yoksa eger fld.ilk_jeton.uzunluk == 12 ve bellek_esit_mi(fld.ilk_jeton.baslangic, "kaynak_satir".ptr, 12) == 1 ise { lis_byte_array = 1; lelm_scale = 1; }
                    yoksa eger fld.ilk_jeton.uzunluk == 9 ve bellek_esit_mi(fld.ilk_jeton.baslangic, "dosya_adi".ptr, 9) == 1 ise { lis_byte_array = 1; lelm_scale = 1; }
                    yoksa eger fld.ilk_jeton.uzunluk == 8 ve bellek_esit_mi(fld.ilk_jeton.baslangic, "veri_ptr".ptr, 8) == 1 ise { lis_byte_array = 1; lelm_scale = 1; }
                    yoksa eger fld.ilk_jeton.uzunluk == 12 ve bellek_esit_mi(fld.ilk_jeton.baslangic, "arena_bellek".ptr, 12) == 1 ise { lis_byte_array = 1; lelm_scale = 1; }
                }
            }
            # SIB FAST PATH for array write (BCE Optimized):
            degisken bce_yaz_guvenli: tamsayi = 0;
            eger g_bounds_check == 0 ise {
                bce_yaz_guvenli = 1;
            } yoksa eger idx_node != 0 ve idx_node.tip == AST_SAYI ve idx_node.ilk_jeton != 0 ise {
                degisken cw_pre_idx: tamsayi = string_tamsayiya(idx_node.ilk_jeton.baslangic, idx_node.ilk_jeton.uzunluk);
                eger cw_pre_idx >= 0 ve (lvar_dizi == 0 veya cw_pre_idx < lvar_dizi) ise {
                    bce_yaz_guvenli = 1;
                }
            }
            eger bce_yaz_guvenli == 1 ise {
                eger idx_node != 0 ve idx_node.tip == AST_SAYI ve idx_node.ilk_jeton != 0 ise {
                    degisken c_idx: tamsayi = string_tamsayiya(idx_node.ilk_jeton.baslangic, idx_node.ilk_jeton.uzunluk);
                    degisken c_off: tamsayi = c_idx * lelm_scale;
                    byte_yaz(a, 0x5A); # POP RDX (atanacak deger)
                    eger lelm_scale == 1 ise {
                        eger c_off == 0 ise {
                            byte_yaz(a, 0x88); byte_yaz(a, 0x10);
                        } yoksa eger c_off <= 127 ise {
                            byte_yaz(a, 0x88); byte_yaz(a, 0x50); byte_yaz(a, c_off);
                        } yoksa {
                            byte_yaz(a, 0x88); byte_yaz(a, 0x90); int32_yaz(a, c_off);
                        }
                    } yoksa eger lelm_scale == 2 ise {
                        eger c_off == 0 ise {
                            byte_yaz(a, 0x66); byte_yaz(a, 0x89); byte_yaz(a, 0x10);
                        } yoksa eger c_off <= 127 ise {
                            byte_yaz(a, 0x66); byte_yaz(a, 0x89); byte_yaz(a, 0x50); byte_yaz(a, c_off);
                        } yoksa {
                            byte_yaz(a, 0x66); byte_yaz(a, 0x89); byte_yaz(a, 0x90); int32_yaz(a, c_off);
                        }
                    } yoksa eger lelm_scale == 4 ise {
                        eger c_off == 0 ise {
                            byte_yaz(a, 0x89); byte_yaz(a, 0x10);
                        } yoksa eger c_off <= 127 ise {
                            byte_yaz(a, 0x89); byte_yaz(a, 0x50); byte_yaz(a, c_off);
                        } yoksa {
                            byte_yaz(a, 0x89); byte_yaz(a, 0x90); int32_yaz(a, c_off);
                        }
                    } yoksa {
                        eger c_off == 0 ise {
                            byte_yaz(a, 0x48); byte_yaz(a, 0x89); byte_yaz(a, 0x10);
                        } yoksa eger c_off <= 127 ise {
                            byte_yaz(a, 0x48); byte_yaz(a, 0x89); byte_yaz(a, 0x50); byte_yaz(a, c_off);
                        } yoksa {
                            byte_yaz(a, 0x48); byte_yaz(a, 0x89); byte_yaz(a, 0x90); int32_yaz(a, c_off);
                        }
                    }
                    dondu 0;
                } yoksa eger idx_node != 0 ve idx_node.tip == AST_KIMLIK ve idx_node.ilk_jeton != 0 ise {
                    degisken f_idx_off: tamsayi = lokal_bul_offset(idx_node.ilk_jeton.baslangic, idx_node.ilk_jeton.uzunluk);
                    degisken f_idx_dizi: tamsayi = lokal_bul_dizi(idx_node.ilk_jeton.baslangic, idx_node.ilk_jeton.uzunluk);
                    eger f_idx_off != 0 ve f_idx_dizi == 0 ise {
                        byte_yaz(a, 0x5A); # POP RDX (atanacak deger)
                        eger f_idx_off <= 127 ise {
                            byte_yaz(a, 0x48); byte_yaz(a, 0x8B); byte_yaz(a, 0x4D); byte_yaz(a, 256 - f_idx_off); # MOV RCX, [RBP - off]
                        } yoksa {
                            byte_yaz(a, 0x48); byte_yaz(a, 0x8B); byte_yaz(a, 0x8D); int32_yaz(a, 0 - f_idx_off);
                        }
                        eger lelm_scale == 1 ise {
                            byte_yaz(a, 0x88); byte_yaz(a, 0x14); byte_yaz(a, 0x08); # MOV [RAX + RCX], DL
                        } yoksa eger lelm_scale == 2 ise {
                            byte_yaz(a, 0x66); byte_yaz(a, 0x89); byte_yaz(a, 0x14); byte_yaz(a, 0x48); # MOV [RAX + RCX*2], DX
                        } yoksa eger lelm_scale == 4 ise {
                            byte_yaz(a, 0x89); byte_yaz(a, 0x14); byte_yaz(a, 0x88); # MOV [RAX + RCX*4], EDX
                        } yoksa {
                            byte_yaz(a, 0x48); byte_yaz(a, 0x89); byte_yaz(a, 0x14); byte_yaz(a, 0xC8); # MOV [RAX + RCX*8], RDX
                        }
                        dondu 0;
                    }
                }
            }

            # FALLBACK PATH (slow path):
            byte_yaz(a, 0x50); # PUSH RAX (taban adresi)
            # ADIM 4: indeks + olcekle
            eger g_bounds_check == 1 ve lvar_yildiz != 0 ise { bounds_kontrol(a, 0, 1); }
            ast_kod_uret(a, idx_node);
            eger g_bounds_check == 1 ve lvar_dizi > 0 ise { bounds_kontrol(a, lvar_dizi, 0); }
            eger lelm_scale == 1 ise {
                # scale 1: no shift
            } yoksa eger lelm_scale == 2 ise {
                byte_yaz(a, 0x48); byte_yaz(a, 0xD1); byte_yaz(a, 0xE0); # SHL RAX, 1 (*2)
            } yoksa eger lelm_scale == 4 ise {
                byte_yaz(a, 0x48); byte_yaz(a, 0xC1); byte_yaz(a, 0xE0); byte_yaz(a, 0x02); # SHL RAX, 2 (*4)
            } yoksa eger lelm_scale == 8 ise {
                byte_yaz(a, 0x48); byte_yaz(a, 0xC1); byte_yaz(a, 0xE0); byte_yaz(a, 0x03); # SHL RAX, 3 (*8)
            } yoksa eger lelm_scale == 16 ise {
                byte_yaz(a, 0x48); byte_yaz(a, 0xC1); byte_yaz(a, 0xE0); byte_yaz(a, 0x04);
            } yoksa eger lelm_scale == 32 ise {
                byte_yaz(a, 0x48); byte_yaz(a, 0xC1); byte_yaz(a, 0xE0); byte_yaz(a, 0x05);
            } yoksa eger lelm_scale == 64 ise {
                byte_yaz(a, 0x48); byte_yaz(a, 0xC1); byte_yaz(a, 0xE0); byte_yaz(a, 0x06);
            } yoksa {
                byte_yaz(a, 0x48); byte_yaz(a, 0x69); byte_yaz(a, 0xC0); int32_yaz(a, lelm_scale);
            }
            byte_yaz(a, 0x59); # POP RCX (taban adresi)
            emit_add_rax_rcx(a); # RAX = hedef adres
            byte_yaz(a, 0x59); # POP RCX (atanacak deger)
            eger lelm_scale == 1 ise {
                byte_yaz(a, 0x88); byte_yaz(a, 0x08); # MOV [RAX], CL
            } yoksa eger lelm_scale == 2 ise {
                byte_yaz(a, 0x66); byte_yaz(a, 0x89); byte_yaz(a, 0x08); # MOV [RAX], CX
            } yoksa eger lelm_scale == 4 ise {
                byte_yaz(a, 0x89); byte_yaz(a, 0x08); # MOV [RAX], ECX
            } yoksa {
                byte_yaz(a, 0x48); byte_yaz(a, 0x89); byte_yaz(a, 0x08); # MOV [RAX], RCX
            }
            dondu 0;
        }
        dondu 0;
    }

    # --------------------------------------------------------
    # AST_REFERANS: &x => LEA RAX, [RBP - off]
    # --------------------------------------------------------
    eger dugum.tip == 20 ise { # AST_REFERANS
        degisken hedef: *AstDugum = dugum.sag;
        eger hedef != 0 ve hedef.tip == 4 ise { # AST_KIMLIK
            degisken var_off: tamsayi = 0;
            degisken lki: tamsayi = g_lokal_adet - 1;
            dongu lki >= 0 {
                eger g_lokal_uzunluklari[lki] == hedef.ilk_jeton.uzunluk ise {
                    eger bellek_esit_mi(g_lokal_isimleri[lki], hedef.ilk_jeton.baslangic, g_lokal_uzunluklari[lki]) == 1 ise {
                        var_off = g_lokal_offsetleri[lki];
                        durdur;
                    }
                }
                lki = lki - 1;
            }
            eger var_off > 0 ise {
                eger var_off <= 127 ise {
                    byte_yaz(a, 0x48); byte_yaz(a, 0x8D); byte_yaz(a, 0x45);
                    byte_yaz(a, 256 - var_off);
                } yoksa {
                    byte_yaz(a, 0x48); byte_yaz(a, 0x8D); byte_yaz(a, 0x85);
                    int32_yaz(a, 0 - var_off);
                }
                dondu 0;
            } yoksa {
                degisken obj_uzn: tamsayi = hedef.ilk_jeton.uzunluk;
                degisken obj_isim: *u8 = hedef.ilk_jeton.baslangic;
                degisken gi: tamsayi = 0;
                dongu gi < g_global_sayisi {
                    eger g_global_uzunluk[gi] == obj_uzn ise {
                        eger bellek_esit_mi(g_global_isim[gi], obj_isim, obj_uzn) == 1 ise {
                            degisken g_addr: tamsayi = g_global_adres[gi];
                            byte_yaz(a, 0x48); byte_yaz(a, 0x8D); byte_yaz(a, 0x05);
                            int32_yaz(a, g_addr - (a.kullanilan + 4));
                            dondu 0;
                        }
                    }
                    gi = gi + 1;
                }
            }
        }
        eger hedef != 0 ve hedef.tip == 17 ise { # AST_ALAN_ERISIMI: &d.x
            degisken ae_parent: *AstDugum = hedef.sol;
            degisken ae_field_kim: *AstDugum = hedef.sag;
            degisken ae_parent_tip_adi: *u8 = 0;
            degisken ae_parent_tip_len: tamsayi = 0;
            degisken ae_parent_yildiz: tamsayi = 0;
            degisken poff: tamsayi = 0;
            eger ae_parent != 0 ve ae_parent.tip == 4 ise {
                degisken lki: tamsayi = g_lokal_adet - 1;
                dongu lki >= 0 {
                    eger g_lokal_uzunluklari[lki] == ae_parent.ilk_jeton.uzunluk ise {
                        eger bellek_esit_mi(g_lokal_isimleri[lki], ae_parent.ilk_jeton.baslangic, g_lokal_uzunluklari[lki]) == 1 ise {
                            poff = g_lokal_offsetleri[lki];
                            ae_parent_tip_adi = g_lokal_tip_adlari[lki];
                            ae_parent_tip_len = g_lokal_tip_uzunluklari[lki];
                            ae_parent_yildiz = g_lokal_yildizlari[lki];
                            durdur;
                        }
                    }
                    lki = lki - 1;
                }
                eger poff == 0 ise {
                    degisken gi: tamsayi = 0;
                    dongu gi < g_global_sayisi {
                        eger g_global_uzunluk[gi] == ae_parent.ilk_jeton.uzunluk ise {
                            eger bellek_esit_mi(g_global_isim[gi], ae_parent.ilk_jeton.baslangic, g_global_uzunluk[gi]) == 1 ise {
                                ae_parent_tip_adi = g_global_tip_adi[gi];
                                ae_parent_tip_len = g_global_tip_adi_uzunluk[gi];
                                ae_parent_yildiz = g_global_is_pointer[gi];
                                degisken g_addr: tamsayi = g_global_adres[gi];
                                eger ae_parent_yildiz == 0 ise {
                                    byte_yaz(a, 0x48); byte_yaz(a, 0x8D); byte_yaz(a, 0x05);
                                } yoksa {
                                    byte_yaz(a, 0x48); byte_yaz(a, 0x8B); byte_yaz(a, 0x05);
                                }
                                int32_yaz(a, g_addr - (a.kullanilan + 4));
                                poff = 0 - 1;
                                durdur;
                            }
                        }
                        gi = gi + 1;
                    }
                }
                eger poff > 0 ise {
                    eger ae_parent_yildiz == 0 ise {
                        emit_lea_rax(a, poff);
                    } yoksa {
                        emit_load_rax(a, poff);
                    }
                } yoksa eger poff == 0 ise {
                    ast_kod_uret(a, ae_parent);
                }
            } yoksa {
                ast_kod_uret(a, ae_parent);
                eger ae_parent != 0 ise {
                    ae_parent_tip_adi = ae_parent.tip_adi;
                    ae_parent_tip_len = ae_parent.tip_adi_uzunluk;
                }
            }
            eger ae_parent_tip_adi != 0 ve ae_parent_tip_len > 0 ve ae_parent_tip_adi[0] == 42 ise { # '*'
                ae_parent_tip_adi = ae_parent_tip_adi + 1;
                ae_parent_tip_len = ae_parent_tip_len - 1;
            }
            degisken ae_field_off: tamsayi = 0;
            degisken ae_field_dizi: tamsayi = 0;
            degisken ae_field_elem_sz: tamsayi = 8;
            eger ae_parent_tip_adi != 0 ve ae_field_kim != 0 ve ae_field_kim.ilk_jeton != 0 ise {
                degisken yi: tamsayi = 0;
                dongu yi < g_yapi_adet {
                    eger g_yapi_uzunluk[yi] == ae_parent_tip_len ise {
                        eger bellek_esit_mi(g_yapi_isim[yi], ae_parent_tip_adi, ae_parent_tip_len) == 1 ise {
                            degisken ai: tamsayi = 0;
                            dongu ai < g_yapi_alan_sayisi[yi] {
                                degisken a_idx: tamsayi = (yi * 32) + ai;
                                eger g_yapi_alan_uzunluk[a_idx] == ae_field_kim.ilk_jeton.uzunluk ise {
                                    eger bellek_esit_mi(g_yapi_alan_isim[a_idx], ae_field_kim.ilk_jeton.baslangic, g_yapi_alan_uzunluk[a_idx]) == 1 ise {
                                        ae_field_off = g_yapi_alan_offset[a_idx];
                                        ae_field_dizi = g_yapi_alan_dizi[a_idx];
                                        ae_field_elem_sz = tip_eleman_boyutu_al(g_yapi_alan_tip_adi[a_idx], g_yapi_alan_tip_uzn[a_idx], g_yapi_alan_yildiz[a_idx]);
                                        dugum.tip_adi = g_yapi_alan_tip_adi[a_idx];
                                        dugum.tip_adi_uzunluk = g_yapi_alan_tip_uzn[a_idx];
                                        dugum.cozumlenmis_tip = g_yapi_alan_yildiz[a_idx];
                                        dugum.dizi_boyutu = g_yapi_alan_dizi[a_idx];
                                        dugum.dizi_boyutu = g_yapi_alan_dizi[a_idx];
                                        durdur;
                                    }
                                }
                                ai = ai + 1;
                            }
                            durdur;
                        }
                    }
                    yi = yi + 1;
                }
            }
            eger ae_field_off > 0 ise {
                eger ae_field_off <= 127 ise {
                    byte_yaz(a, 0x48); byte_yaz(a, 0x83); byte_yaz(a, 0xC0);
                    byte_yaz(a, ae_field_off);
                } yoksa {
                    byte_yaz(a, 0x48); byte_yaz(a, 0x05);
                    int32_yaz(a, ae_field_off);
                }
            }
            dondu 0;
        } yoksa eger hedef.tip == 18 ise { # AST_INDEKS_ERISIMI: &arr[i]
            degisken aie_arr_node: *AstDugum = hedef.sol;
            degisken aie_idx_node: *AstDugum = hedef.sag;
            degisken aie_arr_adi: *u8 = 0;
            degisken aie_arr_adi_uzn: tamsayi = 0;
            eger aie_arr_node != 0 ve aie_arr_node.tip == 4 ise {
                aie_arr_adi = aie_arr_node.ilk_jeton.baslangic;
                aie_arr_adi_uzn = aie_arr_node.ilk_jeton.uzunluk;
            }
            degisken aie_var_off: tamsayi = 0;
            degisken aie_var_dizi: tamsayi = 0;
            degisken aie_var_yildiz: tamsayi = 0;
            degisken aie_var_tip_adi: *u8 = 0;
            degisken aie_var_tip_uzunluk: tamsayi = 0;
            eger aie_arr_adi != 0 ve aie_arr_adi_uzn > 0 ise {
                degisken li: tamsayi = 0;
                dongu li < g_lokal_adet {
                    eger g_lokal_uzunluklari[li] == aie_arr_adi_uzn ise {
                        eger bellek_esit_mi(g_lokal_isimleri[li], aie_arr_adi, aie_arr_adi_uzn) == 1 ise {
                            aie_var_off = g_lokal_offsetleri[li];
                            aie_var_dizi = g_lokal_dizi_boyutlari[li];
                            aie_var_yildiz = g_lokal_yildizlari[li];
                            aie_var_tip_adi = g_lokal_tip_adlari[li];
                            aie_var_tip_uzunluk = g_lokal_tip_uzunluklari[li];
                            durdur;
                        }
                    }
                    li = li + 1;
                }
                eger aie_var_off == 0 ve aie_var_tip_adi == 0 ise {
                    degisken gi: tamsayi = 0;
                    dongu gi < g_global_sayisi {
                        eger g_global_uzunluk[gi] == aie_arr_adi_uzn ise {
                            eger bellek_esit_mi(g_global_isim[gi], aie_arr_adi, aie_arr_adi_uzn) == 1 ise {
                                aie_var_tip_adi = g_global_tip_adi[gi];
                                aie_var_tip_uzunluk = g_global_tip_adi_uzunluk[gi];
                                aie_var_yildiz = g_global_is_pointer[gi];
                                aie_var_dizi = g_global_dizi_boyutu[gi];
                                durdur;
                            }
                        }
                        gi = gi + 1;
                    }
                }
            }
            eger aie_var_yildiz == 0 ve aie_var_dizi == 0 ve aie_var_tip_adi == 0 ise {
                eger aie_arr_node != 0 ise {
                    aie_var_yildiz = aie_arr_node.cozumlenmis_tip;
                    aie_var_tip_adi = aie_arr_node.tip_adi;
                    aie_var_tip_uzunluk = aie_arr_node.tip_adi_uzunluk;
                    eger aie_arr_node.tip != 17 ise {
                        aie_var_dizi = aie_arr_node.dizi_boyutu;
                    }
                }
            }
            eger aie_var_off != 0 ve aie_var_dizi > 0 ise {
                emit_lea_rax(a, aie_var_off);
            } yoksa {
                ast_kod_uret(a, aie_arr_node);
            }
            byte_yaz(a, 0x50); # PUSH RAX
            ast_kod_uret(a, aie_idx_node);
            byte_yaz(a, 0x48); byte_yaz(a, 0x89); byte_yaz(a, 0xC1); # MOV RCX, RAX
            byte_yaz(a, 0x58); # POP RAX
            degisken aie_elem_yildiz: tamsayi = 0;
            eger aie_var_dizi > 0 ise {
                aie_elem_yildiz = aie_var_yildiz;
            } yoksa eger aie_var_yildiz > 0 ise {
                aie_elem_yildiz = aie_var_yildiz - 1;
            }
            degisken aie_elem_scale: tamsayi = tip_eleman_boyutu_al(aie_var_tip_adi, aie_var_tip_uzunluk, aie_elem_yildiz);
            eger aie_elem_scale == 1 ise {
                # no-op
            } yoksa eger aie_elem_scale == 2 ise {
                byte_yaz(a, 0x48); byte_yaz(a, 0xD1); byte_yaz(a, 0xE1); # SHL RCX, 1
            } yoksa eger aie_elem_scale == 4 ise {
                byte_yaz(a, 0x48); byte_yaz(a, 0xC1); byte_yaz(a, 0xE1); byte_yaz(a, 0x02); # SHL RCX, 2
            } yoksa eger aie_elem_scale == 8 ise {
                byte_yaz(a, 0x48); byte_yaz(a, 0xC1); byte_yaz(a, 0xE1); byte_yaz(a, 0x03); # SHL RCX, 3
            } yoksa eger aie_elem_scale == 16 ise {
                byte_yaz(a, 0x48); byte_yaz(a, 0xC1); byte_yaz(a, 0xE1); byte_yaz(a, 0x04);
            } yoksa eger aie_elem_scale == 32 ise {
                byte_yaz(a, 0x48); byte_yaz(a, 0xC1); byte_yaz(a, 0xE1); byte_yaz(a, 0x05);
            } yoksa eger aie_elem_scale == 64 ise {
                byte_yaz(a, 0x48); byte_yaz(a, 0xC1); byte_yaz(a, 0xE1); byte_yaz(a, 0x06);
            } yoksa {
                byte_yaz(a, 0x48); byte_yaz(a, 0x69); byte_yaz(a, 0xC9);
                int32_yaz(a, aie_elem_scale);
            }
            byte_yaz(a, 0x48); byte_yaz(a, 0x01); byte_yaz(a, 0xC8); # ADD RAX, RCX
            dondu 0;
        }
        emit_xor_rax_rax(a);
        dondu 0;
    }

    # --------------------------------------------------------
    # AST_UNARY: *ptr (deref), -x (negate), !x (logical NOT), ~x (bitwise NOT)
    # --------------------------------------------------------
    eger dugum.tip == 19 ise { # AST_UNARY
        eger dugum.ilk_jeton != 0 ve dugum.ilk_jeton.tip == TIP_CARPI ise { # *ptr (dereference)
            ast_kod_uret(a, dugum.sag);
            degisken u_sag: *AstDugum = dugum.sag;
            degisken is_unary_byte: tamsayi = 0;
            eger u_sag != 0 ve u_sag.tip_adi != 0 ve u_sag.tip_adi_uzunluk == 2 ise {
                eger u_sag.tip_adi[0] == 117 ve u_sag.tip_adi[1] == 56 ve u_sag.cozumlenmis_tip == 1 ise {
                    is_unary_byte = 1;
                }
            }
            eger is_unary_byte == 1 ise {
                byte_yaz(a, 0x48); byte_yaz(a, 0x0F); byte_yaz(a, 0xB6); byte_yaz(a, 0x00);
            } yoksa {
                byte_yaz(a, 0x48); byte_yaz(a, 0x8B); byte_yaz(a, 0x00); # MOV RAX, [RAX]
            }
            dondu 0;
        } yoksa eger dugum.ilk_jeton != 0 ve dugum.ilk_jeton.tip == TIP_DEGIL ise { # !val (logical NOT)
            ast_kod_uret(a, dugum.sag);
            byte_yaz(a, 0x48); byte_yaz(a, 0x85); byte_yaz(a, 0xC0); # TEST RAX, RAX
            byte_yaz(a, 0x0F); byte_yaz(a, 0x94); byte_yaz(a, 0xC0); # SETE AL
            byte_yaz(a, 0x48); byte_yaz(a, 0x0F); byte_yaz(a, 0xB6); byte_yaz(a, 0xC0); # MOVZX RAX, AL
            dondu 0;
        } yoksa eger dugum.ilk_jeton != 0 ve dugum.ilk_jeton.tip == TIP_TILDE ise { # ~val (bitwise NOT)
            ast_kod_uret(a, dugum.sag);
            byte_yaz(a, 0x48); byte_yaz(a, 0xF7); byte_yaz(a, 0xD0); # NOT RAX
            dondu 0;
        } yoksa eger dugum.ilk_jeton != 0 ve dugum.ilk_jeton.tip == TIP_EKSI ise { # -val (negate)
            ast_kod_uret(a, dugum.sag);
            eger ast_node_is_float(dugum.sag) == 1 ise {
                byte_yaz(a, 0x48); byte_yaz(a, 0xBA);
                byte_yaz(a, 0); byte_yaz(a, 0); byte_yaz(a, 0); byte_yaz(a, 0);
                byte_yaz(a, 0); byte_yaz(a, 0); byte_yaz(a, 0); byte_yaz(a, 0x80);
                byte_yaz(a, 0x48); byte_yaz(a, 0x31); byte_yaz(a, 0xD0); # XOR RAX, RDX
                byte_yaz(a, 0x66); byte_yaz(a, 0x48); byte_yaz(a, 0x0F); byte_yaz(a, 0x6E); byte_yaz(a, 0xC0); # MOVQ XMM0, RAX
            } yoksa {
                byte_yaz(a, 0x48); byte_yaz(a, 0xF7); byte_yaz(a, 0xD8); # NEG RAX
            }
            dondu 0;
        }
    }

    # --------------------------------------------------------
    # AST_COMPTIME (46): comptime { expr } / comptime expr
    # --------------------------------------------------------
    eger dugum.tip == AST_COMPTIME ise {
        ast_kod_uret(a, dugum.sol);
        dondu 0;
    }

    # --------------------------------------------------------
    # AST_DONUSUM (45): expr as Tip / expr olarak Tip
    # --------------------------------------------------------
    eger dugum.tip == AST_DONUSUM ise {
        ast_kod_uret(a, dugum.sol);
        degisken sol_float: tamsayi = ast_node_is_float(dugum.sol);
        degisken hedef_float: tamsayi = 0;
        eger dugum.cozumlenmis_tip == 0 ve dugum.tip_adi != 0 ise {
            eger tip_adini_coz_yerel(dugum.tip_adi, dugum.tip_adi_uzunluk) == 2 ise {
                hedef_float = 1;
            }
        }
        eger sol_float == 1 ve hedef_float == 0 ise {
            # Once RAX'taki float bit desenini XMM0'a aktar: MOVQ XMM0, RAX
            byte_yaz(a, 0x66); byte_yaz(a, 0x48); byte_yaz(a, 0x0F); byte_yaz(a, 0x6E); byte_yaz(a, 0xC0);
            # XMM0'i tamsayiya cevirip RAX'a yaz: CVTTSD2SI RAX, XMM0
            byte_yaz(a, 0xF2); byte_yaz(a, 0x48); byte_yaz(a, 0x0F); byte_yaz(a, 0x2C); byte_yaz(a, 0xC0);
        } yoksa eger sol_float == 0 ve hedef_float == 1 ise {
            # RAX'taki tamsayiyi XMM0'a cevir: CVTSI2SD XMM0, RAX
            byte_yaz(a, 0xF2); byte_yaz(a, 0x48); byte_yaz(a, 0x0F); byte_yaz(a, 0x2A); byte_yaz(a, 0xC0);
            # XMM0'daki float bit desenini RAX'a aktar: MOVQ RAX, XMM0
            byte_yaz(a, 0x66); byte_yaz(a, 0x48); byte_yaz(a, 0x0F); byte_yaz(a, 0x7E); byte_yaz(a, 0xC0);
        } yoksa eger dugum.cozumlenmis_tip == 0 ve dugum.tip_adi != 0 ise {
            eger dugum.tip_adi_uzunluk == 2 ve dugum.tip_adi[0] == 117 ve dugum.tip_adi[1] == 56 ise {
                byte_yaz(a, 0x48); byte_yaz(a, 0x0F); byte_yaz(a, 0xB6); byte_yaz(a, 0xC0);
            } yoksa eger dugum.tip_adi_uzunluk == 3 ve dugum.tip_adi[0] == 117 ve dugum.tip_adi[1] == 49 ve dugum.tip_adi[2] == 54 ise {
                byte_yaz(a, 0x48); byte_yaz(a, 0x0F); byte_yaz(a, 0xB7); byte_yaz(a, 0xC0);
            } yoksa eger dugum.tip_adi_uzunluk == 3 ve dugum.tip_adi[0] == 105 ve dugum.tip_adi[1] == 51 ve dugum.tip_adi[2] == 50 ise {
                byte_yaz(a, 0x48); byte_yaz(a, 0x63); byte_yaz(a, 0xC0);
            } yoksa eger dugum.tip_adi_uzunluk == 3 ve dugum.tip_adi[0] == 117 ve dugum.tip_adi[1] == 51 ve dugum.tip_adi[2] == 50 ise {
                byte_yaz(a, 0x89); byte_yaz(a, 0xC0);
            }
        }
        dondu 0;
    }

    # --------------------------------------------------------
    # AST_INDEKS_ERISIMI: arr[i] => RAX = *(base + i*scale)
    # ONEMLI: Once kod uret (AST_ALAN_ERISIMI tip bilgisini yazsin), sonra fallback al
    # --------------------------------------------------------
    eger dugum.tip == AST_INDEKS_ERISIMI ise {
        degisken arr_node: *AstDugum = dugum.sol;
        degisken idx_node: *AstDugum = dugum.sag;
        degisken var_off: tamsayi = 0;
        degisken var_dizi: tamsayi = 0;
        degisken var_yildiz: tamsayi = 0;
        degisken var_tip_adi: *u8 = 0;
        degisken var_tip_uzunluk: tamsayi = 0;
        degisken jeton_dizisi_mi: tamsayi = 0;
        eger arr_node.tip == AST_KIMLIK ise {
            degisken ki: tamsayi = 0;
            dongu ki < g_lokal_adet {
                eger g_lokal_uzunluklari[ki] == arr_node.ilk_jeton.uzunluk ise {
                    eger bellek_esit_mi(g_lokal_isimleri[ki], arr_node.ilk_jeton.baslangic, g_lokal_uzunluklari[ki]) == 1 ise {
                        var_off = g_lokal_offsetleri[ki];
                        var_tip_adi = g_lokal_tip_adlari[ki];
                        var_tip_uzunluk = g_lokal_tip_uzunluklari[ki];
                        var_yildiz = g_lokal_yildizlari[ki];
                        var_dizi = lokal_bul_dizi(arr_node.ilk_jeton.baslangic, arr_node.ilk_jeton.uzunluk);
                    }
                }
                ki = ki + 1;
            }
            eger var_off == 0 ve var_tip_adi == 0 ise {
                degisken gki: tamsayi = 0;
                dongu gki < g_global_sayisi {
                    eger g_global_uzunluk[gki] == arr_node.ilk_jeton.uzunluk ise {
                        eger bellek_esit_mi(g_global_isim[gki], arr_node.ilk_jeton.baslangic, g_global_uzunluk[gki]) == 1 ise {
                            var_tip_adi = g_global_tip_adi[gki];
                            var_tip_uzunluk = g_global_tip_adi_uzunluk[gki];
                            var_yildiz = g_global_is_pointer[gki];
                            var_dizi = g_global_dizi_boyutu[gki];
                            durdur;
                        }
                    }
                    gki = gki + 1;
                }
            }
        }
        eger arr_node.tip == AST_ALAN_ERISIMI ise {
            eger arr_node.sag != 0 ve arr_node.sag.ilk_jeton != 0 ise {
                eger arr_node.sag.ilk_jeton.uzunluk == 7 ise {
                    eger bellek_esit_mi(arr_node.sag.ilk_jeton.baslangic, "jetonlar".ptr, 7) == 1 ise {
                        jeton_dizisi_mi = 1;
                        var_yildiz = 1;
                        var_tip_adi = "Jeton".ptr;
                        var_tip_uzunluk = 5;
                    }
                }
            }
            eger jeton_dizisi_mi == 0 ve arr_node.sol != 0 ve arr_node.sol.tip == AST_KIMLIK ise {
                eger arr_node.sol.ilk_jeton != 0 ise {
                    eger arr_node.sol.ilk_jeton.uzunluk == 12 ise {
                        eger bellek_esit_mi(arr_node.sol.ilk_jeton.baslangic, "ParserDurumu".ptr, 12) == 1 ise {
                            jeton_dizisi_mi = 1;
                            var_yildiz = 1;
                            var_tip_adi = "Jeton".ptr;
                            var_tip_uzunluk = 5;
                        }
                    }
                }
            }
        }
        # ADIM 2: Taban adresi uret/yukle
        eger jeton_dizisi_mi == 1 ise {
            ast_kod_uret(a, arr_node.sol);
            byte_yaz(a, 0x48); byte_yaz(a, 0x8B); byte_yaz(a, 0x00);
        } yoksa eger var_off != 0 ve var_dizi > 0 ise {
            eger var_off <= 127 ise {
                byte_yaz(a, 0x48); byte_yaz(a, 0x8D); byte_yaz(a, 0x45);
                byte_yaz(a, 256 - var_off);
            } yoksa {
                byte_yaz(a, 0x48); byte_yaz(a, 0x8D); byte_yaz(a, 0x85);
                int32_yaz(a, 0 - var_off);
            }
        } yoksa {
            ast_kod_uret(a, arr_node);
        }
        # Fallback type info AFTER kod uretimi
        eger var_yildiz == 0 ve var_dizi == 0 ve var_tip_adi == 0 ise {
            var_yildiz = arr_node.cozumlenmis_tip;
            var_tip_adi = arr_node.tip_adi;
            var_tip_uzunluk = arr_node.tip_adi_uzunluk;
            eger arr_node.tip != 17 ise {
                var_dizi = arr_node.dizi_boyutu;
            }
        }
        # ADIM 3: Element olcegi belirle
        degisken elem_yildiz: tamsayi = 0;
        eger var_dizi > 0 ise {
            elem_yildiz = var_yildiz;
        } yoksa eger var_yildiz > 0 ise {
            elem_yildiz = var_yildiz - 1;
        }
        degisken elem_scale: tamsayi = tip_eleman_boyutu_al(var_tip_adi, var_tip_uzunluk, elem_yildiz);
        eger jeton_dizisi_mi == 1 ise { elem_scale = 40; }
        degisken is_byte_array: tamsayi = 0;
        eger elem_scale == 1 ise { is_byte_array = 1; }
        eger is_byte_array == 0 ve arr_node.tip == 17 ise { # AST_ALAN_ERISIMI
            degisken fld: *AstDugum = arr_node.sag;
            eger fld != 0 ve fld.ilk_jeton != 0 ise {
                eger fld.ilk_jeton.uzunluk == 6 ve bellek_esit_mi(fld.ilk_jeton.baslangic, "bellek".ptr, 6) == 1 ise {
                    is_byte_array = 1;
                    elem_scale = 1;
                } yoksa eger fld.ilk_jeton.uzunluk == 6 ve bellek_esit_mi(fld.ilk_jeton.baslangic, "kaynak".ptr, 6) == 1 ise {
                    is_byte_array = 1;
                    elem_scale = 1;
                } yoksa eger fld.ilk_jeton.uzunluk == 6 ve bellek_esit_mi(fld.ilk_jeton.baslangic, "icerik".ptr, 6) == 1 ise {
                    is_byte_array = 1;
                    elem_scale = 1;
                } yoksa eger fld.ilk_jeton.uzunluk == 4 ve bellek_esit_mi(fld.ilk_jeton.baslangic, "veri".ptr, 4) == 1 ise {
                    is_byte_array = 1;
                    elem_scale = 1;
                } yoksa eger fld.ilk_jeton.uzunluk == 3 ve bellek_esit_mi(fld.ilk_jeton.baslangic, "ptr".ptr, 3) == 1 ise {
                    is_byte_array = 1;
                    elem_scale = 1;
                } yoksa eger fld.ilk_jeton.uzunluk == 9 ve bellek_esit_mi(fld.ilk_jeton.baslangic, "baslangic".ptr, 9) == 1 ise {
                    is_byte_array = 1;
                    elem_scale = 1;
                } yoksa eger fld.ilk_jeton.uzunluk == 7 ve bellek_esit_mi(fld.ilk_jeton.baslangic, "tip_adi".ptr, 7) == 1 ise {
                    is_byte_array = 1;
                    elem_scale = 1;
                } yoksa eger fld.ilk_jeton.uzunluk == 5 ve bellek_esit_mi(fld.ilk_jeton.baslangic, "mesaj".ptr, 5) == 1 ise {
                    is_byte_array = 1;
                    elem_scale = 1;
                } yoksa eger fld.ilk_jeton.uzunluk == 5 ve bellek_esit_mi(fld.ilk_jeton.baslangic, "ipucu".ptr, 5) == 1 ise {
                    is_byte_array = 1;
                    elem_scale = 1;
                } yoksa eger fld.ilk_jeton.uzunluk == 12 ve bellek_esit_mi(fld.ilk_jeton.baslangic, "kaynak_satir".ptr, 12) == 1 ise {
                    is_byte_array = 1;
                    elem_scale = 1;
                } yoksa eger fld.ilk_jeton.uzunluk == 9 ve bellek_esit_mi(fld.ilk_jeton.baslangic, "dosya_adi".ptr, 9) == 1 ise {
                    is_byte_array = 1;
                    elem_scale = 1;
                } yoksa eger fld.ilk_jeton.uzunluk == 8 ve bellek_esit_mi(fld.ilk_jeton.baslangic, "veri_ptr".ptr, 8) == 1 ise {
                    is_byte_array = 1;
                    elem_scale = 1;
                } yoksa eger fld.ilk_jeton.uzunluk == 12 ve bellek_esit_mi(fld.ilk_jeton.baslangic, "arena_bellek".ptr, 12) == 1 ise {
                    is_byte_array = 1;
                    elem_scale = 1;
                }
            }
        }
        # SIB FAST PATH for array read (BCE Optimized):
        degisken bce_oku_guvenli: tamsayi = 0;
        eger g_bounds_check == 0 ise {
            bce_oku_guvenli = 1;
        } yoksa eger idx_node != 0 ve idx_node.tip == AST_SAYI ve idx_node.ilk_jeton != 0 ise {
            degisken cr_pre_idx: tamsayi = string_tamsayiya(idx_node.ilk_jeton.baslangic, idx_node.ilk_jeton.uzunluk);
            eger cr_pre_idx >= 0 ve (var_dizi == 0 veya cr_pre_idx < var_dizi) ise {
                bce_oku_guvenli = 1;
            }
        }
        eger bce_oku_guvenli == 1 ve jeton_dizisi_mi == 0 ise {
            degisken chk_struct: tamsayi = 0;
            eger var_tip_adi != 0 ve var_tip_uzunluk > 0 ise {
                degisken si_chk2: tamsayi = 0;
                dongu si_chk2 < g_yapi_adet {
                    eger g_yapi_uzunluk[si_chk2] == var_tip_uzunluk ise {
                        eger bellek_esit_mi(g_yapi_isim[si_chk2], var_tip_adi, var_tip_uzunluk) == 1 ise {
                            chk_struct = 1;
                            durdur;
                        }
                    }
                    si_chk2 = si_chk2 + 1;
                }
            }
            eger chk_struct == 0 ve (elem_scale == 8 veya elem_scale == 4 veya elem_scale == 2 veya elem_scale == 1) ise {
                eger idx_node != 0 ve idx_node.tip == AST_SAYI ve idx_node.ilk_jeton != 0 ise {
                    degisken cr_idx: tamsayi = string_tamsayiya(idx_node.ilk_jeton.baslangic, idx_node.ilk_jeton.uzunluk);
                    degisken cr_off: tamsayi = cr_idx * elem_scale;
                    eger elem_scale == 1 ise {
                        eger cr_off == 0 ise {
                            byte_yaz(a, 0x48); byte_yaz(a, 0x0F); byte_yaz(a, 0xB6); byte_yaz(a, 0x00);
                        } yoksa eger cr_off <= 127 ise {
                            byte_yaz(a, 0x48); byte_yaz(a, 0x0F); byte_yaz(a, 0xB6); byte_yaz(a, 0x40); byte_yaz(a, cr_off);
                        } yoksa {
                            byte_yaz(a, 0x48); byte_yaz(a, 0x0F); byte_yaz(a, 0xB6); byte_yaz(a, 0x80); int32_yaz(a, cr_off);
                        }
                    } yoksa eger elem_scale == 2 ise {
                        eger cr_off == 0 ise {
                            byte_yaz(a, 0x48); byte_yaz(a, 0x0F); byte_yaz(a, 0xB7); byte_yaz(a, 0x00);
                        } yoksa eger cr_off <= 127 ise {
                            byte_yaz(a, 0x48); byte_yaz(a, 0x0F); byte_yaz(a, 0xB7); byte_yaz(a, 0x40); byte_yaz(a, cr_off);
                        } yoksa {
                            byte_yaz(a, 0x48); byte_yaz(a, 0x0F); byte_yaz(a, 0xB7); byte_yaz(a, 0x80); int32_yaz(a, cr_off);
                        }
                    } yoksa eger elem_scale == 4 ise {
                        eger cr_off == 0 ise {
                            byte_yaz(a, 0x8B); byte_yaz(a, 0x00);
                        } yoksa eger cr_off <= 127 ise {
                            byte_yaz(a, 0x8B); byte_yaz(a, 0x40); byte_yaz(a, cr_off);
                        } yoksa {
                            byte_yaz(a, 0x8B); byte_yaz(a, 0x80); int32_yaz(a, cr_off);
                        }
                    } yoksa {
                        eger cr_off == 0 ise {
                            byte_yaz(a, 0x48); byte_yaz(a, 0x8B); byte_yaz(a, 0x00);
                        } yoksa eger cr_off <= 127 ise {
                            byte_yaz(a, 0x48); byte_yaz(a, 0x8B); byte_yaz(a, 0x40); byte_yaz(a, cr_off);
                        } yoksa {
                            byte_yaz(a, 0x48); byte_yaz(a, 0x8B); byte_yaz(a, 0x80); int32_yaz(a, cr_off);
                        }
                    }
                    dondu 0;
                } yoksa eger idx_node != 0 ve idx_node.tip == AST_KIMLIK ve idx_node.ilk_jeton != 0 ise {
                    degisken fr_idx_off: tamsayi = lokal_bul_offset(idx_node.ilk_jeton.baslangic, idx_node.ilk_jeton.uzunluk);
                    degisken fr_idx_dizi: tamsayi = lokal_bul_dizi(idx_node.ilk_jeton.baslangic, idx_node.ilk_jeton.uzunluk);
                    eger fr_idx_off != 0 ve fr_idx_dizi == 0 ise {
                        eger fr_idx_off <= 127 ise {
                            byte_yaz(a, 0x48); byte_yaz(a, 0x8B); byte_yaz(a, 0x4D); byte_yaz(a, 256 - fr_idx_off);
                        } yoksa {
                            byte_yaz(a, 0x48); byte_yaz(a, 0x8B); byte_yaz(a, 0x8D); int32_yaz(a, 0 - fr_idx_off);
                        }
                        eger elem_scale == 1 ise {
                            byte_yaz(a, 0x48); byte_yaz(a, 0x0F); byte_yaz(a, 0xB6); byte_yaz(a, 0x04); byte_yaz(a, 0x08);
                        } yoksa eger elem_scale == 2 ise {
                            byte_yaz(a, 0x48); byte_yaz(a, 0x0F); byte_yaz(a, 0xB7); byte_yaz(a, 0x04); byte_yaz(a, 0x48);
                        } yoksa eger elem_scale == 4 ise {
                            byte_yaz(a, 0x8B); byte_yaz(a, 0x04); byte_yaz(a, 0x88);
                        } yoksa {
                            byte_yaz(a, 0x48); byte_yaz(a, 0x8B); byte_yaz(a, 0x04); byte_yaz(a, 0xC8);
                        }
                        dondu 0;
                    }
                }
            }
        }

        # FALLBACK PATH:
        byte_yaz(a, 0x50); # PUSH RAX (taban adresini sakla)
        # ADIM 4: guvenlik kontrolu, sonra indeks hesapla + olcekle
        # Pointer tabaninin kendisi [RSP]'de saklidir.
        eger g_bounds_check == 1 ve var_yildiz != 0 ise { bounds_kontrol(a, 0, 1); }
        ast_kod_uret(a, idx_node); # RAX = indeks
        eger g_bounds_check == 1 ve var_dizi > 0 ise { bounds_kontrol(a, var_dizi, 0); }
        eger elem_scale == 1 ise {
            # scale 1: no shift
        } yoksa eger elem_scale == 2 ise {
            byte_yaz(a, 0x48); byte_yaz(a, 0xD1); byte_yaz(a, 0xE0); # SHL RAX, 1
        } yoksa eger elem_scale == 4 ise {
            byte_yaz(a, 0x48); byte_yaz(a, 0xC1); byte_yaz(a, 0xE0); byte_yaz(a, 0x02); # SHL RAX, 2
        } yoksa eger elem_scale == 8 ise {
            byte_yaz(a, 0x48); byte_yaz(a, 0xC1); byte_yaz(a, 0xE0); byte_yaz(a, 0x03); # SHL RAX, 3
        } yoksa eger elem_scale == 16 ise {
            byte_yaz(a, 0x48); byte_yaz(a, 0xC1); byte_yaz(a, 0xE0); byte_yaz(a, 0x04);
        } yoksa eger elem_scale == 32 ise {
            byte_yaz(a, 0x48); byte_yaz(a, 0xC1); byte_yaz(a, 0xE0); byte_yaz(a, 0x05);
        } yoksa eger elem_scale == 64 ise {
            byte_yaz(a, 0x48); byte_yaz(a, 0xC1); byte_yaz(a, 0xE0); byte_yaz(a, 0x06);
        } yoksa {
            byte_yaz(a, 0x48); byte_yaz(a, 0x69); byte_yaz(a, 0xC0); int32_yaz(a, elem_scale);
        }
        byte_yaz(a, 0x59); # POP RCX (taban)
        emit_add_rax_rcx(a); # RAX = &elem[i]
        degisken struct_mi: tamsayi = 0;
        eger var_tip_adi != 0 ve g_yapi_adet > 0 ise {
            degisken si_chk: tamsayi = 0;
            dongu si_chk < g_yapi_adet {
                eger g_yapi_uzunluk[si_chk] == var_tip_uzunluk ise {
                    eger bellek_esit_mi(g_yapi_isim[si_chk], var_tip_adi, var_tip_uzunluk) == 1 ise {
                        struct_mi = 1;
                        durdur;
                    }
                }
                si_chk = si_chk + 1;
            }
        }
        degisken deref_atla: tamsayi = 0;
        eger jeton_dizisi_mi == 1 ise {
            deref_atla = 1;
        } yoksa eger struct_mi == 1 ve (var_dizi == 0 veya var_yildiz == 0) ise {
            deref_atla = 1;
        }
        eger elem_scale == 1 ise {
            byte_yaz(a, 0x48); byte_yaz(a, 0x0F); byte_yaz(a, 0xB6); byte_yaz(a, 0x00);
        } yoksa eger elem_scale == 2 ise {
            byte_yaz(a, 0x48); byte_yaz(a, 0x0F); byte_yaz(a, 0xB7); byte_yaz(a, 0x00);
        } yoksa eger elem_scale == 4 ise {
            byte_yaz(a, 0x8B); byte_yaz(a, 0x00);
        } yoksa eger elem_scale == 8 ise {
            byte_yaz(a, 0x48); byte_yaz(a, 0x8B); byte_yaz(a, 0x00);
        } yoksa eger deref_atla == 0 ise {
            byte_yaz(a, 0x48); byte_yaz(a, 0x8B); byte_yaz(a, 0x00);
        }
        dondu 0;
    }
    verbose_yaz("DEBUG: checking AST_IKILI_OP, dugum.tip=".ptr);
    verbose_sayi(dugum.tip);
    verbose_yaz(" AST_IKILI_OP=".ptr);
    verbose_sayi(AST_IKILI_OP);
    verbose_yaz("\n".ptr);

    eger dugum.tip == AST_IKILI_OP ise {
            # Short-circuit ve (AND) and veya (OR) must be handled before evaluating both sides
        eger dugum.ilk_jeton != 0 ise {
            eger dugum.ilk_jeton.tip == TIP_VE ise {
                # LHS
                ast_kod_uret(a, dugum.sol);
                # TEST RAX, RAX
                byte_yaz(a, 0x48); byte_yaz(a, 0x85); byte_yaz(a, 0xC0);
                # JZ false_label (if LHS == 0, skip RHS)
                byte_yaz(a, 0x0F); byte_yaz(a, 0x84);
                degisken ve_jz_pos: tamsayi = a.kullanilan;
                int32_yaz(a, 0);
                # RHS
                ast_kod_uret(a, dugum.sag);
                # TEST RAX, RAX → SETNE AL → MOVZX RAX, AL
                byte_yaz(a, 0x48); byte_yaz(a, 0x85); byte_yaz(a, 0xC0);
                byte_yaz(a, 0x0F); byte_yaz(a, 0x95); byte_yaz(a, 0xC0);
                byte_yaz(a, 0x48); byte_yaz(a, 0x0F); byte_yaz(a, 0xB6); byte_yaz(a, 0xC0);
                # JMP end_label
                byte_yaz(a, 0xE9);
                degisken ve_jmp_pos: tamsayi = a.kullanilan;
                int32_yaz(a, 0);
                # false_label:
                degisken ve_false_label: tamsayi = a.kullanilan;
                int32_patch(a, ve_jz_pos, ve_false_label - (ve_jz_pos + 4));
                # XOR RAX, RAX (result = 0)
                emit_xor_rax_rax(a);
                # end_label:
                degisken ve_end_label: tamsayi = a.kullanilan;
                int32_patch(a, ve_jmp_pos, ve_end_label - (ve_jmp_pos + 4));
                dondu 0;
            }
            eger dugum.ilk_jeton.tip == TIP_VEYA ise {
                # LHS
                ast_kod_uret(a, dugum.sol);
                # TEST RAX, RAX
                byte_yaz(a, 0x48); byte_yaz(a, 0x85); byte_yaz(a, 0xC0);
                # JNZ true_label (if LHS != 0, skip RHS)
                byte_yaz(a, 0x0F); byte_yaz(a, 0x85);
                degisken veya_jnz_pos: tamsayi = a.kullanilan;
                int32_yaz(a, 0);
                # RHS
                ast_kod_uret(a, dugum.sag);
                # TEST RAX, RAX → SETNE AL → MOVZX RAX, AL
                byte_yaz(a, 0x48); byte_yaz(a, 0x85); byte_yaz(a, 0xC0);
                byte_yaz(a, 0x0F); byte_yaz(a, 0x95); byte_yaz(a, 0xC0);
                byte_yaz(a, 0x48); byte_yaz(a, 0x0F); byte_yaz(a, 0xB6); byte_yaz(a, 0xC0);
                # JMP end_label
                byte_yaz(a, 0xE9);
                degisken veya_jmp_pos: tamsayi = a.kullanilan;
                int32_yaz(a, 0);
                # true_label:
                degisken veya_true_label: tamsayi = a.kullanilan;
                int32_patch(a, veya_jnz_pos, veya_true_label - (veya_jnz_pos + 4));
                # MOV RAX, 1
                byte_yaz(a, 0x48); byte_yaz(a, 0xC7); byte_yaz(a, 0xC0); int32_yaz(a, 1);
                # end_label:
                degisken veya_end_label: tamsayi = a.kullanilan;
                int32_patch(a, veya_jmp_pos, veya_end_label - (veya_jmp_pos + 4));
                dondu 0;
            }
        }
        degisken is_flt: tamsayi = 0;
        eger ast_node_is_float(dugum.sol) == 1 ise { is_flt = 1; }
        eger ast_node_is_float(dugum.sag) == 1 ise { is_flt = 1; }
        eger is_flt == 1 ise {
            # GOREV 6.2: f32 mi f64 mu? Her ikisi de XMM ile ama opcode farklı
            # f32 → ADDSS/SUBSS/MULSS/DIVSS (F3 0F), f64 → ADDSD/SUBSD/MULSD/DIVSD (F2 0F)
            # f32 detection: sol veya sag dugum tip_adi "f32" ya da "kesirli32"
            degisken is_f32: tamsayi = 0;
            degisken chk_sol: *AstDugum = dugum.sol;
            degisken chk_sag: *AstDugum = dugum.sag;
            eger chk_sol != 0 ve chk_sol.tip_adi != 0 ise {
                eger chk_sol.tip_adi_uzunluk == 3 ise {
                    eger bellek_esit_mi(chk_sol.tip_adi, "f32".ptr, 3) == 1 ise { is_f32 = 1; }
                }
                eger chk_sol.tip_adi_uzunluk == 9 ise {
                    eger bellek_esit_mi(chk_sol.tip_adi, "kesirli32".ptr, 9) == 1 ise { is_f32 = 1; }
                }
            }
            eger chk_sag != 0 ve chk_sag.tip_adi != 0 ise {
                eger chk_sag.tip_adi_uzunluk == 3 ise {
                    eger bellek_esit_mi(chk_sag.tip_adi, "f32".ptr, 3) == 1 ise { is_f32 = 1; }
                }
            }
            # f32 prefix: 0xF3, f64 prefix: 0xF2
            degisken flt_pfx: tamsayi = 0xF2;
            eger is_f32 == 1 ise { flt_pfx = 0xF3; }

            ast_kod_uret(a, dugum.sol);
            eger ast_node_is_float(dugum.sol) == 0 ise {
                # CVTSI2SD XMM0, RAX (0xF2 0x48 0x0F 0x2A 0xC0)
                byte_yaz(a, 0xF2); byte_yaz(a, 0x48); byte_yaz(a, 0x0F); byte_yaz(a, 0x2A); byte_yaz(a, 0xC0);
                # MOVQ RAX, XMM0 (0x66 0x48 0x0F 0x7E 0xC0)
                byte_yaz(a, 0x66); byte_yaz(a, 0x48); byte_yaz(a, 0x0F); byte_yaz(a, 0x7E); byte_yaz(a, 0xC0);
            }
            byte_yaz(a, 0x50); # PUSH RAX
            ast_kod_uret(a, dugum.sag);
            eger ast_node_is_float(dugum.sag) == 0 ise {
                # CVTSI2SD XMM0, RAX
                byte_yaz(a, 0xF2); byte_yaz(a, 0x48); byte_yaz(a, 0x0F); byte_yaz(a, 0x2A); byte_yaz(a, 0xC0);
                # MOVQ RAX, XMM0
                byte_yaz(a, 0x66); byte_yaz(a, 0x48); byte_yaz(a, 0x0F); byte_yaz(a, 0x7E); byte_yaz(a, 0xC0);
            }
            # MOVQ XMM1, RAX (0x66 0x48 0x0F 0x6E 0xC8)
            byte_yaz(a, 0x66); byte_yaz(a, 0x48); byte_yaz(a, 0x0F); byte_yaz(a, 0x6E); byte_yaz(a, 0xC8);
            byte_yaz(a, 0x58); # POP RAX
            # MOVQ XMM0, RAX (0x66 0x48 0x0F 0x6E 0xC0)
            byte_yaz(a, 0x66); byte_yaz(a, 0x48); byte_yaz(a, 0x0F); byte_yaz(a, 0x6E); byte_yaz(a, 0xC0);

            eger dugum.ilk_jeton != 0 ise {
                degisken op_tip: tamsayi = dugum.ilk_jeton.tip;
                eger op_tip == TIP_ARTI ise {
                    # ADDSD/ADDSS XMM0, XMM1
                    byte_yaz(a, flt_pfx); byte_yaz(a, 0x0F); byte_yaz(a, 0x58); byte_yaz(a, 0xC1);
                    # MOVQ RAX, XMM0 (0x66 0x48 0x0F 0x7E 0xC0)
                    byte_yaz(a, 0x66); byte_yaz(a, 0x48); byte_yaz(a, 0x0F); byte_yaz(a, 0x7E); byte_yaz(a, 0xC0);
                    dondu 0;
                }
                eger op_tip == TIP_EKSI ise {
                    # SUBSD/SUBSS XMM0, XMM1
                    byte_yaz(a, flt_pfx); byte_yaz(a, 0x0F); byte_yaz(a, 0x5C); byte_yaz(a, 0xC1);
                    byte_yaz(a, 0x66); byte_yaz(a, 0x48); byte_yaz(a, 0x0F); byte_yaz(a, 0x7E); byte_yaz(a, 0xC0);
                    dondu 0;
                }
                eger op_tip == TIP_CARPI ise {
                    # MULSD/MULSS XMM0, XMM1
                    byte_yaz(a, flt_pfx); byte_yaz(a, 0x0F); byte_yaz(a, 0x59); byte_yaz(a, 0xC1);
                    byte_yaz(a, 0x66); byte_yaz(a, 0x48); byte_yaz(a, 0x0F); byte_yaz(a, 0x7E); byte_yaz(a, 0xC0);
                    dondu 0;
                }
                eger op_tip == TIP_BOLME ise {
                    # DIVSD/DIVSS XMM0, XMM1
                    byte_yaz(a, flt_pfx); byte_yaz(a, 0x0F); byte_yaz(a, 0x5E); byte_yaz(a, 0xC1);
                    byte_yaz(a, 0x66); byte_yaz(a, 0x48); byte_yaz(a, 0x0F); byte_yaz(a, 0x7E); byte_yaz(a, 0xC0);
                    dondu 0;
                }
                eger op_tip == TIP_ESIT_MI ise {
                    # UCOMISD XMM0, XMM1 (0x66 0x0F 0x2E 0xC1)
                    byte_yaz(a, 0x66); byte_yaz(a, 0x0F); byte_yaz(a, 0x2E); byte_yaz(a, 0xC1);
                    emit_sete_al(a); emit_movzx_rax_al(a);
                    dondu 0;
                }
                eger op_tip == TIP_ESIT_DEGIL ise {
                    byte_yaz(a, 0x66); byte_yaz(a, 0x0F); byte_yaz(a, 0x2E); byte_yaz(a, 0xC1);
                    emit_setne_al(a); emit_movzx_rax_al(a);
                    dondu 0;
                }
                eger op_tip == TIP_KUCUK_MU ise {
                    byte_yaz(a, 0x66); byte_yaz(a, 0x0F); byte_yaz(a, 0x2E); byte_yaz(a, 0xC1);
                    emit_setb_al(a); emit_movzx_rax_al(a);
                    dondu 0;
                }
                eger op_tip == TIP_BUYUK_MU ise {
                    byte_yaz(a, 0x66); byte_yaz(a, 0x0F); byte_yaz(a, 0x2E); byte_yaz(a, 0xC1);
                    emit_seta_al(a); emit_movzx_rax_al(a);
                    dondu 0;
                }
                eger op_tip == TIP_KUCUK_ESIT ise {
                    byte_yaz(a, 0x66); byte_yaz(a, 0x0F); byte_yaz(a, 0x2E); byte_yaz(a, 0xC1);
                    emit_setbe_al(a); emit_movzx_rax_al(a);
                    dondu 0;
                }
                eger op_tip == TIP_BUYUK_ESIT ise {
                    byte_yaz(a, 0x66); byte_yaz(a, 0x0F); byte_yaz(a, 0x2E); byte_yaz(a, 0xC1);
                    emit_setae_al(a); emit_movzx_rax_al(a);
                    dondu 0;
                }
            }
            dondu 0;
        }

        degisken is_str: tamsayi = 0;
        eger dugum.ilk_jeton != 0 ve dugum.ilk_jeton.tip == TIP_ARTI ise {
            eger ast_node_is_string(dugum.sol) == 1 ve ast_node_is_string(dugum.sag) == 1 ise {
                is_str = 1;
            }
        }
        eger is_str == 1 ise {
            ast_kod_uret(a, dugum.sol);
            byte_yaz(a, 0x50);
            ast_kod_uret(a, dugum.sag);
            byte_yaz(a, 0x48); byte_yaz(a, 0x89); byte_yaz(a, 0xC2);
            byte_yaz(a, 0x59);
            emit_string_concat_inline(a);
            dondu 0;
        }

        ast_kod_uret(a, dugum.sol);

        degisken sag_into_rcx: tamsayi = 0;
        degisken sag_d: *AstDugum = dugum.sag;
        eger g_target_platform < 3 ise {
        eger sag_d != 0 ve sag_d.tip == AST_SAYI ve sag_d.ilk_jeton != 0 ise {
            degisken val: tamsayi = string_tamsayiya(sag_d.ilk_jeton.baslangic, sag_d.ilk_jeton.uzunluk);
            eger val >= 0 ve val <= 2147483647 ise {
                byte_yaz(a, 0xB9); int32_yaz(a, val); # MOV ECX, imm32
                sag_into_rcx = 1;
            } yoksa eger val >= (0 - 2147483648) ve val < 0 ise {
                byte_yaz(a, 0x48); byte_yaz(a, 0xC7); byte_yaz(a, 0xC1); int32_yaz(a, val); # MOV RCX, imm32
                sag_into_rcx = 1;
            } yoksa {
                byte_yaz(a, 0x48); byte_yaz(a, 0xB9); int64_yaz(a, val); # MOV RCX, imm64
                sag_into_rcx = 1;
            }
        } yoksa eger sag_d != 0 ve sag_d.tip == AST_KIMLIK ve sag_d.ilk_jeton != 0 ise {
            degisken r_reg_sag: tamsayi = 0;
            eger g_lambda_tabani == 0 ise {
                r_reg_sag = ra_degisken_reg_bul(sag_d.ilk_jeton.baslangic, sag_d.ilk_jeton.uzunluk);
            }
            eger r_reg_sag > 0 ise {
                emit_mov_rcx_reg(a, r_reg_sag);
                sag_into_rcx = 1;
            } yoksa {
                degisken sag_off: tamsayi = lokal_bul_offset(sag_d.ilk_jeton.baslangic, sag_d.ilk_jeton.uzunluk);
                degisken sag_dizi: tamsayi = lokal_bul_dizi(sag_d.ilk_jeton.baslangic, sag_d.ilk_jeton.uzunluk);
                eger sag_off != 0 ve sag_dizi == 0 ise {
                    eger sag_off <= 127 ise {
                        byte_yaz(a, 0x48); byte_yaz(a, 0x8B); byte_yaz(a, 0x4D); byte_yaz(a, 256 - sag_off); # MOV RCX, [RBP - off]
                    } yoksa {
                        byte_yaz(a, 0x48); byte_yaz(a, 0x8B); byte_yaz(a, 0x8D); int32_yaz(a, 0 - sag_off);
                    }
                    sag_into_rcx = 1;
                } yoksa eger g_lambda_tabani > 0 ise {
                    degisken outer_sag_off: tamsayi = lokal_bul_outer_offset(sag_d.ilk_jeton.baslangic, sag_d.ilk_jeton.uzunluk);
                    eger outer_sag_off != 0 ise {
                        byte_yaz(a, 0x48); byte_yaz(a, 0x8B); byte_yaz(a, 0x55); byte_yaz(a, 0); # MOV RDX, [RBP + 0]
                        eger outer_sag_off <= 127 ise {
                            byte_yaz(a, 0x48); byte_yaz(a, 0x8B); byte_yaz(a, 0x4A); byte_yaz(a, 256 - outer_sag_off); # MOV RCX, [RDX - outer_sag_off]
                        } yoksa {
                            byte_yaz(a, 0x48); byte_yaz(a, 0x8B); byte_yaz(a, 0x8A); int32_yaz(a, 0 - outer_sag_off);
                        }
                        sag_into_rcx = 1;
                    }
                }
            }
        }

        }

        eger sag_into_rcx == 0 ise {
            ra_ikili_sol_kaydet(a);
            ast_kod_uret(a, dugum.sag);
            ra_ikili_sol_geri_yukle_rcx(a);
        }
        eger dugum.ilk_jeton != 0 ise {
            # Aritmetik operatorler
            eger dugum.ilk_jeton.tip == TIP_ARTI  ise { emit_add_rax_rcx(a);  dondu 0; }
            eger dugum.ilk_jeton.tip == TIP_EKSI  ise { emit_sub_rax_rcx(a);  dondu 0; }
            eger dugum.ilk_jeton.tip == TIP_CARPI ise {
                eger dugum.sag != 0 ve dugum.sag.tip == AST_SAYI ise {
                    degisken mul_val: tamsayi = string_tamsayiya(dugum.sag.ilk_jeton.baslangic, dugum.sag.ilk_jeton.uzunluk);
                    eger mul_val > 0 ve (mul_val & (mul_val - 1)) == 0 ise {
                        degisken shift: tamsayi = 0;
                        degisken cur_pow: tamsayi = 1;
                        dongu cur_pow < mul_val {
                            cur_pow = cur_pow * 2;
                            shift = shift + 1;
                        }
                        eger shift == 1 ise {
                            byte_yaz(a, 0x48); byte_yaz(a, 0x01); byte_yaz(a, 0xC0); # ADD RAX, RAX
                            dondu 0;
                        }
                        eger shift > 1 ve shift < 64 ise {
                            byte_yaz(a, 0x48); byte_yaz(a, 0xC1); byte_yaz(a, 0xE0); byte_yaz(a, shift); # SHL RAX, shift
                            dondu 0;
                        }
                    }
                }
                emit_imul_rax_rcx(a);
                dondu 0;
            }
            eger dugum.ilk_jeton.tip == TIP_BOLME ise {
                eger dugum.sag != 0 ve dugum.sag.tip == AST_SAYI ise {
                    degisken div_val: tamsayi = string_tamsayiya(dugum.sag.ilk_jeton.baslangic, dugum.sag.ilk_jeton.uzunluk);
                    eger div_val > 0 ve (div_val & (div_val - 1)) == 0 ise {
                        degisken shift_d: tamsayi = 0;
                        degisken cur_pow_d: tamsayi = 1;
                        dongu cur_pow_d < div_val {
                            cur_pow_d = cur_pow_d * 2;
                            shift_d = shift_d + 1;
                        }
                        eger shift_d > 0 ve shift_d < 64 ise {
                            degisken mask_d: tamsayi = div_val - 1;
                            byte_yaz(a, 0x48); byte_yaz(a, 0x99); # CQO
                            eger mask_d <= 127 ise {
                                byte_yaz(a, 0x48); byte_yaz(a, 0x83); byte_yaz(a, 0xE2); byte_yaz(a, mask_d);
                            } yoksa {
                                byte_yaz(a, 0x48); byte_yaz(a, 0x81); byte_yaz(a, 0xE2); int32_yaz(a, mask_d);
                            }
                            byte_yaz(a, 0x48); byte_yaz(a, 0x01); byte_yaz(a, 0xD0); # ADD RAX, RDX
                            byte_yaz(a, 0x48); byte_yaz(a, 0xC1); byte_yaz(a, 0xF8); byte_yaz(a, shift_d); # SAR RAX, shift
                            dondu 0;
                        }
                    }
                    eger emit_magic_div_mod(a, div_val, 0) == 1 ise {
                        dondu 0;
                    }
                }
                emit_div_rax_rcx(a);
                dondu 0;
            }
            eger dugum.ilk_jeton.tip == TIP_MODULO ise {
                eger dugum.sag != 0 ve dugum.sag.tip == AST_SAYI ise {
                    degisken mod_val: tamsayi = string_tamsayiya(dugum.sag.ilk_jeton.baslangic, dugum.sag.ilk_jeton.uzunluk);
                    eger mod_val > 1 ve (mod_val & (mod_val - 1)) == 0 ise {
                        degisken mask_m: tamsayi = mod_val - 1;
                        byte_yaz(a, 0x48); byte_yaz(a, 0x99); # CQO
                        eger mask_m <= 127 ise {
                            byte_yaz(a, 0x48); byte_yaz(a, 0x83); byte_yaz(a, 0xE2); byte_yaz(a, mask_m); # AND RDX, mask
                        } yoksa {
                            byte_yaz(a, 0x48); byte_yaz(a, 0x81); byte_yaz(a, 0xE2); int32_yaz(a, mask_m);
                        }
                        byte_yaz(a, 0x48); byte_yaz(a, 0x01); byte_yaz(a, 0xD0); # ADD RAX, RDX
                        eger mask_m <= 127 ise {
                            byte_yaz(a, 0x48); byte_yaz(a, 0x83); byte_yaz(a, 0xE0); byte_yaz(a, mask_m); # AND RAX, mask
                        } yoksa {
                            byte_yaz(a, 0x48); byte_yaz(a, 0x81); byte_yaz(a, 0xE0); int32_yaz(a, mask_m);
                        }
                        byte_yaz(a, 0x48); byte_yaz(a, 0x29); byte_yaz(a, 0xD0); # SUB RAX, RDX
                        dondu 0;
                    }
                    eger emit_magic_div_mod(a, mod_val, 1) == 1 ise {
                        dondu 0;
                    }
                }
                emit_mod_rax_rcx(a);
                dondu 0;
            }
            eger dugum.ilk_jeton.tip == TIP_XOR ise {
                # XOR RAX, RCX
                byte_yaz(a, 0x48); byte_yaz(a, 0x31); byte_yaz(a, 0xC8);
                dondu 0;
            }
            # Karsilastirma operatorleri: CMP RAX, RCX + SETcc AL + MOVZX RAX, AL
            eger dugum.ilk_jeton.tip == TIP_ESIT_MI    ise { emit_cmp_rax_rcx(a); emit_sete_al(a);  emit_movzx_rax_al(a); dondu 0; }
            eger dugum.ilk_jeton.tip == TIP_ESIT_DEGIL ise { emit_cmp_rax_rcx(a); emit_setne_al(a); emit_movzx_rax_al(a); dondu 0; }
            eger dugum.ilk_jeton.tip == TIP_KUCUK_MU   ise { emit_cmp_rax_rcx(a); emit_setl_al(a);  emit_movzx_rax_al(a); dondu 0; }
            eger dugum.ilk_jeton.tip == TIP_BUYUK_MU   ise { emit_cmp_rax_rcx(a); emit_setg_al(a);  emit_movzx_rax_al(a); dondu 0; }
            eger dugum.ilk_jeton.tip == TIP_KUCUK_ESIT ise { emit_cmp_rax_rcx(a); emit_setle_al(a); emit_movzx_rax_al(a); dondu 0; }
            eger dugum.ilk_jeton.tip == TIP_BUYUK_ESIT ise { emit_cmp_rax_rcx(a); emit_setge_al(a); emit_movzx_rax_al(a); dondu 0; }
            # Mantiksal AND/OR: iki taraf sifir degil mi?
            eger dugum.ilk_jeton.tip == TIP_VE ise {
                # TEST RAX,RAX â†’ SETNE AL â†’ MOVZX RAX,AL
                byte_yaz(a, 0x48); byte_yaz(a, 0x85); byte_yaz(a, 0xC0);
                byte_yaz(a, 0x0F); byte_yaz(a, 0x95); byte_yaz(a, 0xC0);
                byte_yaz(a, 0x48); byte_yaz(a, 0x0F); byte_yaz(a, 0xB6); byte_yaz(a, 0xC0);
                # TEST RCX,RCX â†’ SETNE CL â†’ MOVZX RCX,CL
                byte_yaz(a, 0x48); byte_yaz(a, 0x85); byte_yaz(a, 0xC9);
                byte_yaz(a, 0x0F); byte_yaz(a, 0x95); byte_yaz(a, 0xC1);
                byte_yaz(a, 0x48); byte_yaz(a, 0x0F); byte_yaz(a, 0xB6); byte_yaz(a, 0xC9);
                # AND RAX,RCX
                byte_yaz(a, 0x48); byte_yaz(a, 0x21); byte_yaz(a, 0xC8);
                dondu 0;
            }
            eger dugum.ilk_jeton.tip == TIP_VEYA ise {
                # OR RAX, RCX -> SETNE AL -> MOVZX RAX,AL
                byte_yaz(a, 0x48); byte_yaz(a, 0x09); byte_yaz(a, 0xC8);
                byte_yaz(a, 0x0F); byte_yaz(a, 0x95); byte_yaz(a, 0xC0);
                byte_yaz(a, 0x48); byte_yaz(a, 0x0F); byte_yaz(a, 0xB6); byte_yaz(a, 0xC0);
                dondu 0;
            }
            eger dugum.ilk_jeton.tip == TIP_SOL_KAYDIR ise {
                byte_yaz(a, 0x48); byte_yaz(a, 0xD3); byte_yaz(a, 0xE0);
                dondu 0;
            }
            eger dugum.ilk_jeton.tip == TIP_SAG_KAYDIR ise {
                byte_yaz(a, 0x48); byte_yaz(a, 0xD3); byte_yaz(a, 0xF8);
                dondu 0;
            }
            eger dugum.ilk_jeton.tip == TIP_DIKEY_CUBUK ise {
                byte_yaz(a, 0x48); byte_yaz(a, 0x09); byte_yaz(a, 0xC8);
                dondu 0;
            }
            eger dugum.ilk_jeton.tip == TIP_AMPERSAND ise {
                byte_yaz(a, 0x48); byte_yaz(a, 0x21); byte_yaz(a, 0xC8);
                dondu 0;
            }
        }
        dondu 0;
    }

    # asm { "..." } inline assembly
    eger dugum.tip == AST_INLINE_ASM ise {
        eger dugum.ilk_jeton != 0 ve dugum.ilk_jeton.tip == TIP_METIN ise {
            degisken asm_str: *u8 = dugum.ilk_jeton.baslangic;
            degisken asm_len: tamsayi = dugum.ilk_jeton.uzunluk;
            # "nop" -> 0x90
            eger asm_len == 3 ve asm_str[0] == 110 ve asm_str[1] == 111 ve asm_str[2] == 112 ise {
                byte_yaz(a, 0x90); dondu 0;
            }
            # "ret" -> 0xC3
            eger asm_len == 3 ve asm_str[0] == 114 ve asm_str[1] == 101 ve asm_str[2] == 116 ise {
                byte_yaz(a, 0xC3); dondu 0;
            }
            # "int3" -> 0xCC
            eger asm_len == 4 ve asm_str[0] == 105 ve asm_str[1] == 110 ve asm_str[2] == 116 ve asm_str[3] == 51 ise {
                byte_yaz(a, 0xCC); dondu 0;
            }
            # Ham hex parse: "0x90" veya "0x90 0x91" vb.
            degisken ai: tamsayi = 0;
            dongu ai < asm_len - 1 {
                eger asm_str[ai] == 48 ve asm_str[ai+1] == 120 ise { # '0' 'x'
                    degisken h1: tamsayi = asm_str[ai+2];
                    degisken h2: tamsayi = asm_str[ai+3];
                    degisken v: tamsayi = 0;
                    eger h1 >= 48 ve h1 <= 57 ise { v = (h1 - 48) * 16; }
                    yoksa eger h1 >= 97 ve h1 <= 102 ise { v = (h1 - 87) * 16; }
                    yoksa eger h1 >= 65 ve h1 <= 70 ise { v = (h1 - 55) * 16; }
                    eger h2 >= 48 ve h2 <= 57 ise { v = v + (h2 - 48); }
                    yoksa eger h2 >= 97 ve h2 <= 102 ise { v = v + (h2 - 87); }
                    yoksa eger h2 >= 65 ve h2 <= 70 ise { v = v + (h2 - 55); }
                    byte_yaz(a, v);
                    ai = ai + 4;
                } yoksa {
                    ai = ai + 1;
                }
            }
        }
        dondu 0;
    }
    eger dugum.tip == AST_DONDUR ise {
        eger dugum.sag != 0 ise { ast_kod_uret(a, dugum.sag); }
        yoksa { emit_xor_rax_rax(a); }
        raii_fonksiyon_donus_emit(a);
        eger g_suanki_islev_async == 1 ve g_suanki_islev_ana == 0 ise {
            emit_async_future_wrap(a);
        }
        # GOREV 6.3: ARM64 early return
        eger platform_arm64_mi() == 1 ise {
            arm64_emit_epilog(a);
        } yoksa eger g_target_platform == 6 ise {
            int32_yaz(a, riscv_encode_i_type(RV_OP_LOAD, 3, RV_RA, RV_SP, 248));
            int32_yaz(a, riscv_encode_i_type(RV_OP_LOAD, 3, RV_S0, RV_SP, 240));
            int32_yaz(a, riscv_encode_i_type(RV_OP_IMM, 0, RV_SP, RV_SP, 256));
            int32_yaz(a, riscv_encode_i_type(RV_OP_JALR, 0, RV_ZERO, RV_RA, 0));
        } yoksa eger g_target_platform == 5 ise {
            byte_yaz(a, 0x0F); # WASM return
        } yoksa {
            byte_yaz(a, 0x48); byte_yaz(a, 0x89); byte_yaz(a, 0xEC); # MOV RSP, RBP
            byte_yaz(a, 0x5D); # POP RBP
            ra_callee_epilog_emit(a);
            byte_yaz(a, 0xC3); # RET
        }
        dondu 0;
    }

    eger dugum.tip == 13 veya dugum.tip == AST_BLOK ise {
        degisken block_saved_local_count: tamsayi = g_lokal_adet;
        degisken block_saved_stack_offset: tamsayi = g_lokal_stack_offset;
        raii_blok_gir();
        degisken iter: *AstDugum = dugum.sol;
        degisken blk_idx: tamsayi = 0;
        dongu iter != 0 {
            ast_kod_uret(a, iter);
            iter = iter.sonraki;
            blk_idx = blk_idx + 1;
        }
        raii_blok_cik_emit(a);
        g_lokal_adet = block_saved_local_count;
        g_lokal_stack_offset = block_saved_stack_offset;
        dondu 0;
    }

    eger dugum.tip == 35 ise { # AST_MODUL
        eger dugum.govde != 0 ise {
            degisken m_iter: *AstDugum = dugum.govde.sol;
            dongu m_iter != 0 {
                ast_kod_uret(a, m_iter);
                m_iter = m_iter.sonraki;
            }
        }
        dondu 0;
    }

    # --------------------------------------------------------
    # AST_ISLEV: Prolog + parametreler stack'e + govde + epilog
    # --------------------------------------------------------
    verbose_yaz("CG_CHECK_ISLEV: tip=".ptr);
    verbose_sayi(dugum.tip);
    verbose_yaz(" AST_ISLEV=".ptr);
    verbose_sayi(AST_ISLEV);
    verbose_yaz("\n".ptr);

    eger dugum.tip == 10 veya dugum.tip == AST_ISLEV veya dugum.tip == AST_ASYNC_ISLEV veya dugum.tip == 41 ise {
        verbose_yaz("[DEBUG] AST_ISLEV/AST_ASYNC_ISLEV handler cagirildi\n".ptr);
        eger dugum.govde == 0 ise {
            # External prototype (extern isv) - makine kodu uretme
            dondu 0;
        }
        eger g_fonksiyon_icinde == 1 ise {
            # --- LAMBDA / ANONIM ISLEV IFADESI ---
            # 1. JMP after_lambda (0xE9 <int32>)
            byte_yaz(a, 0xE9);
            degisken jmp_pos: tamsayi = a.kullanilan;
            int32_yaz(a, 0); # placeholder
            
            degisken lambda_start: tamsayi = a.kullanilan;
            
            # Scope sakla
            degisken saved_taban: tamsayi = g_lambda_tabani;
            g_lambda_tabani = g_lokal_adet;
            degisken saved_stack_offset: tamsayi = g_lokal_stack_offset;
            g_lokal_stack_offset = 0;
            
            emit_push_rbp(a);
            emit_mov_rbp_rsp(a);
            # Win32 ABI hizalama (lambda da cagri yapabilir)
            eger g_target_platform == 0 ise {
                emit_and_rsp_align(a);
            }
            emit_sub_rsp(a, 4096);
            
            degisken l_param: *AstDugum = dugum.parametreler;
            degisken l_pidx: tamsayi = 0;
            dongu l_param != 0 {
                degisken lp_off: tamsayi = lokal_kaydet(
                    l_param.ilk_jeton.baslangic,
                    l_param.ilk_jeton.uzunluk,
                    0,
                    l_param.tip_adi,
                    l_param.tip_adi_uzunluk,
                    l_param.cozumlenmis_tip
                );
                eger l_pidx == 0 ise {
                    eger lp_off <= 127 ise {
                        byte_yaz(a, 0x48); byte_yaz(a, 0x89); byte_yaz(a, 0x4D); byte_yaz(a, 256 - lp_off);
                    } yoksa {
                        byte_yaz(a, 0x48); byte_yaz(a, 0x89); byte_yaz(a, 0x8D); int32_yaz(a, 0 - lp_off);
                    }
                } yoksa eger l_pidx == 1 ise {
                    eger lp_off <= 127 ise {
                        byte_yaz(a, 0x48); byte_yaz(a, 0x89); byte_yaz(a, 0x55); byte_yaz(a, 256 - lp_off);
                    } yoksa {
                        byte_yaz(a, 0x48); byte_yaz(a, 0x89); byte_yaz(a, 0x95); int32_yaz(a, 0 - lp_off);
                    }
                } yoksa eger l_pidx == 2 ise {
                    eger lp_off <= 127 ise {
                        byte_yaz(a, 0x4C); byte_yaz(a, 0x89); byte_yaz(a, 0x45); byte_yaz(a, 256 - lp_off);
                    } yoksa {
                        byte_yaz(a, 0x4C); byte_yaz(a, 0x89); byte_yaz(a, 0x85); int32_yaz(a, 0 - lp_off);
                    }
                } yoksa eger l_pidx == 3 ise {
                    eger lp_off <= 127 ise {
                        byte_yaz(a, 0x4C); byte_yaz(a, 0x89); byte_yaz(a, 0x4D); byte_yaz(a, 256 - lp_off);
                    } yoksa {
                        byte_yaz(a, 0x4C); byte_yaz(a, 0x89); byte_yaz(a, 0x8D); int32_yaz(a, 0 - lp_off);
                    }
                }
                l_pidx = l_pidx + 1;
                l_param = l_param.sonraki;
            }
            
            eger dugum.govde != 0 ise {
                ast_kod_uret(a, dugum.govde);
            }
            emit_xor_rax_rax(a);
            byte_yaz(a, 0x48); byte_yaz(a, 0x89); byte_yaz(a, 0xEC);
            emit_pop_rbp(a);
            emit_ret(a);
            
            # Scope geri yukle
            g_lokal_adet = g_lambda_tabani;
            g_lambda_tabani = saved_taban;
            g_lokal_stack_offset = saved_stack_offset;
            
            degisken after_lambda: tamsayi = a.kullanilan;
            int32_patch(a, jmp_pos, after_lambda - (jmp_pos + 4));
            
            # LEA RAX, [RIP + rel32] -> lambda_start
            byte_yaz(a, 0x48); byte_yaz(a, 0x8D); byte_yaz(a, 0x05);
            degisken lea_next: tamsayi = a.kullanilan + 4;
            int32_yaz(a, lambda_start - lea_next);
            
            dondu 0;
        }
        g_fonksiyon_icinde = 1;
        g_yama_fonk_bas = g_yama_adet;
        eger g_fonk_adet >= 16384 ise {
            codegen_kapasite_reddet(5);
            dondu 0;
        }
        degisken f_idx: tamsayi = g_fonk_adet;
        eger dugum.ilk_jeton != 0 ise {
                g_fonk_isim[f_idx] = dugum.ilk_jeton.baslangic;
            g_fonk_uzunluk[f_idx] = dugum.ilk_jeton.uzunluk;
        } yoksa {
            g_fonk_isim[f_idx] = 0;
            g_fonk_uzunluk[f_idx] = 0;
        }
        g_fonk_adres[f_idx] = a.kullanilan;
        # Inline modul flatten edildiginde parser, orijinal modul tokenini
        # sentetik metadata dugumunde; kisa uye tokenini son_jeton'da tutar.
        eger dugum.yoksa_govde != 0 ve dugum.yoksa_govde.ilk_jeton != 0 ise {
            g_fonk_modul_isim[f_idx] = dugum.yoksa_govde.ilk_jeton.baslangic;
            g_fonk_modul_uzunluk[f_idx] = dugum.yoksa_govde.ilk_jeton.uzunluk;
            eger dugum.son_jeton != 0 ise {
                g_fonk_isim[f_idx] = dugum.son_jeton.baslangic;
                g_fonk_uzunluk[f_idx] = dugum.son_jeton.uzunluk;
            }
        } yoksa {
            g_fonk_modul_isim[f_idx] = g_codegen_modul_isim;
            g_fonk_modul_uzunluk[f_idx] = g_codegen_modul_uzunluk;
            eger g_codegen_modul_isim != 0 ise {
                g_fonk_modul_isim[f_idx] = g_codegen_modul_isim;
                g_fonk_modul_uzunluk[f_idx] = g_codegen_modul_uzunluk;
            } yoksa {
                g_fonk_modul_isim[f_idx] = 0;
                g_fonk_modul_uzunluk[f_idx] = 0;

            }
        }
        g_fonk_adet = g_fonk_adet + 1;

        eger dugum.tip == AST_ASYNC_ISLEV veya dugum.tip == 41 ise {
            g_suanki_islev_async = 1;
        } yoksa {
            g_suanki_islev_async = 0;
        }
        g_suanki_islev_ana = 0;
        eger dugum.ilk_jeton != 0 ise {
            degisken is_fn_ptr: *u8 = dugum.ilk_jeton.baslangic;
            degisken is_fn_uzn: tamsayi = dugum.ilk_jeton.uzunluk;
            eger is_fn_uzn == 3 ve bellek_esit_mi(is_fn_ptr, "ana".ptr, 3) == 1 ise {
                g_suanki_islev_ana = 1;
            } yoksa eger is_fn_uzn == 4 ve bellek_esit_mi(is_fn_ptr, "main".ptr, 4) == 1 ise {
                g_suanki_islev_ana = 1;
            }
        }

        # Fonksiyon scope'unu sifirla
        g_lokal_adet = 0;
        g_lokal_stack_offset = 0;
        g_lambda_tabani = 0;
        g_loop_stack_sp = 0;
        g_durdur_adet = 0;
        g_fonksiyon_icinde = 1;
        ra_fonksiyon_sifirla(); # GOREV 6.1: RA state sifirla
        raii_sifirla();         # FAZ 9: RAII scope sifirla
        ra_degiskenleri_yazmaca_bagla(dugum.govde); # FAZ 8: degiskenleri callee-saved yazmaclara bagla

        # GOREV 6.3: ARM64 AAPCS prolog seçimi
        eger platform_arm64_mi() == 1 ise {
            # ARM64 AAPCS: STP X29,X30,[SP,#-16]! + MOV X29,SP + SUB SP,SP,#frame
            arm64_emit_prolog(a);
            arm64_emit_sub_sp(a, 256);   # 256 byte varsayilan frame
        } yoksa eger g_target_platform == 6 ise {
            int32_yaz(a, riscv_encode_i_type(RV_OP_IMM, 0, RV_SP, RV_SP, 0 - 256));
            int32_yaz(a, riscv_encode_s_type(RV_OP_STORE, 3, RV_SP, RV_RA, 248));
            int32_yaz(a, riscv_encode_s_type(RV_OP_STORE, 3, RV_SP, RV_S0, 240));
            int32_yaz(a, riscv_encode_i_type(RV_OP_IMM, 0, RV_S0, RV_SP, 256));
        } yoksa eger g_target_platform == 5 ise {
            # WebAssembly: locals declared in Section 10
        } yoksa {
            ra_callee_prolog_emit(a);
            emit_push_rbp(a);
            emit_mov_rbp_rsp(a);
            # Win32 ABI: PUSH RBP sonrasi RSP'yi 16-byte hizala
            eger g_target_platform == 0 ise {
                emit_and_rsp_align(a);
            }
            # FAZ 8: Dinamik Stack Frame Boyutlamasi (Sabit 8KB kaldirildi)
            # Local degisken, struct, dizi ve parametre ihtiyacindan dinamik hesaplanir
            degisken hesaplanan_yerel: tamsayi = frame_dugum_boyutu(dugum.govde);
            degisken param_sayisi: tamsayi = 0;
            degisken frame_param: *AstDugum = dugum.parametreler;
            dongu frame_param != 0 {
                param_sayisi = param_sayisi + 1;
                frame_param = frame_param.sonraki;
            }
            # Shadow space (32) + parametre spillleri + yereller + ara deger ve cagri marjini (256)
            degisken frame_boyutu: tamsayi = 64 + (param_sayisi * 8) + hesaplanan_yerel + 256;
            frame_boyutu = ((frame_boyutu + 15) / 16) * 16;
            eger frame_boyutu < 64 ise { frame_boyutu = 64; }
            emit_sub_rsp(a, frame_boyutu);
        }
        
        # Parametreleri kaydet ve stack'e spill et
        degisken param: *AstDugum = dugum.parametreler;
        degisken pidx: tamsayi = 0;
        dongu param != 0 {
            degisken param_abi_yildiz: tamsayi = param.cozumlenmis_tip;
            eger enum_turu_mi(param.tip_adi, param.tip_adi_uzunluk) == 1 ise {
                param_abi_yildiz = 1;
            }
            degisken p_off: tamsayi = lokal_kaydet(
                param.ilk_jeton.baslangic,
                param.ilk_jeton.uzunluk,
                0,
                param.tip_adi,
                param.tip_adi_uzunluk,
                param_abi_yildiz
            );
            
            eger platform_arm64_mi() == 1 ise {
                # ARM64 AAPCS: X0..X7 parametreleri -> STUR Xpidx, [X29, #-p_off]
                eger pidx < 8 ise {
                    degisken simm9: tamsayi = (0 - p_off) & 511;
                    degisken instr: tamsayi = 0xF8000000 + (simm9 * 4096) + (29 * 32) + pidx;
                    a64_int32_yaz(a, instr);
                }
            } yoksa eger g_target_platform == 6 ise {
                eger pidx < 8 ise {
                    degisken src_reg: tamsayi = RV_A0 + pidx;
                    int32_yaz(a, riscv_encode_s_type(RV_OP_STORE, 3, RV_S0, src_reg, 0 - p_off));
                }
            } yoksa eger g_target_platform == 5 ise {
                eger pidx < 16 ise {
                    byte_yaz(a, 0x20); wasm_leb128_u32_yaz(a, pidx);
                    degisken lidx: tamsayi = (p_off / 8) - 1;
                    byte_yaz(a, 0x21); wasm_leb128_u32_yaz(a, lidx);
                }
            } yoksa {
                eger pidx == 0 ise {
                    eger p_off <= 127 ise {
                        byte_yaz(a, 0x48); byte_yaz(a, 0x89); byte_yaz(a, 0x4D); byte_yaz(a, 256 - p_off); # MOV [RBP - p_off], RCX
                    } yoksa {
                        byte_yaz(a, 0x48); byte_yaz(a, 0x89); byte_yaz(a, 0x8D); int32_yaz(a, 0 - p_off);
                    }
                } yoksa eger pidx == 1 ise {
                    eger p_off <= 127 ise {
                        byte_yaz(a, 0x48); byte_yaz(a, 0x89); byte_yaz(a, 0x55); byte_yaz(a, 256 - p_off); # MOV [RBP - p_off], RDX
                    } yoksa {
                        byte_yaz(a, 0x48); byte_yaz(a, 0x89); byte_yaz(a, 0x95); int32_yaz(a, 0 - p_off);
                    }
                } yoksa eger pidx == 2 ise {
                    eger p_off <= 127 ise {
                        byte_yaz(a, 0x4C); byte_yaz(a, 0x89); byte_yaz(a, 0x45); byte_yaz(a, 256 - p_off); # MOV [RBP - p_off], R8
                    } yoksa {
                        byte_yaz(a, 0x4C); byte_yaz(a, 0x89); byte_yaz(a, 0x85); int32_yaz(a, 0 - p_off);
                    }
                } yoksa eger pidx == 3 ise {
                    eger p_off <= 127 ise {
                        byte_yaz(a, 0x4C); byte_yaz(a, 0x89); byte_yaz(a, 0x4D); byte_yaz(a, 256 - p_off); # MOV [RBP - p_off], R9
                    } yoksa {
                        byte_yaz(a, 0x4C); byte_yaz(a, 0x89); byte_yaz(a, 0x8D); int32_yaz(a, 0 - p_off);
                    }
                } yoksa {
                    # Windows x64 ABI: push rbp sonrasinda ilk stack argumani RBP+48'ta baslar.
                    degisken callee_pushed: tamsayi = 0;
                    eger g_ra_callee_saved_kullanildi[0] == 1 ise { callee_pushed = callee_pushed + 8; }
                    eger g_ra_callee_saved_kullanildi[1] == 1 ise { callee_pushed = callee_pushed + 8; }
                    eger g_ra_callee_saved_kullanildi[2] == 1 ise { callee_pushed = callee_pushed + 8; }
                    eger g_ra_callee_saved_kullanildi[3] == 1 ise { callee_pushed = callee_pushed + 8; }
                    eger g_ra_callee_saved_kullanildi[4] == 1 ise { callee_pushed = callee_pushed + 8; }
                    degisken stack_src: tamsayi = 16 + (pidx * 8) + callee_pushed;
                    eger stack_src <= 127 ise {
                        byte_yaz(a, 0x48); byte_yaz(a, 0x8B); byte_yaz(a, 0x45); byte_yaz(a, stack_src); # MOV RAX, [RBP + stack_src]
                    } yoksa {
                        byte_yaz(a, 0x48); byte_yaz(a, 0x8B); byte_yaz(a, 0x85); int32_yaz(a, stack_src);
                    }
                    eger p_off <= 127 ise {
                        byte_yaz(a, 0x48); byte_yaz(a, 0x89); byte_yaz(a, 0x45); byte_yaz(a, 256 - p_off); # MOV [RBP - p_off], RAX
                    } yoksa {
                        byte_yaz(a, 0x48); byte_yaz(a, 0x89); byte_yaz(a, 0x85); int32_yaz(a, 0 - p_off);
                    }
                }
            }
            pidx = pidx + 1;
            param = param.sonraki;
        }
        degisken govde: *AstDugum = dugum.govde;
        eger govde != 0 ise {
            ast_kod_uret(a, govde);
        }
        
        # Fonksiyon normal bitis: RAX=0 (deger yoksa)
        emit_xor_rax_rax(a);
        eger g_suanki_islev_async == 1 ve g_suanki_islev_ana == 0 ise {
            emit_async_future_wrap(a);
        }

        # ? operatoru hata yolu buraya atlar (RAX = hata_kodu, korunur)
        # epilog_pos: MOV RSP, RBP'dan ONCE (xor rax,rax atlandiktan sonra) yamama yapilir
        degisken epilog_pos: tamsayi = a.kullanilan;
        degisken p_idx: tamsayi = g_yama_fonk_bas;
        dongu p_idx < g_yama_adet {
            eger g_yama_tip[p_idx] == 99 ise {
                # ? operatoru JMP rel32: epilog_pos - (jmp_pos + 4)
                int32_patch(a, g_yama_adres[p_idx], epilog_pos - g_yama_adres[p_idx] - 4);
            }
            p_idx = p_idx + 1;
        }
        # GOREV 6.3: Multi-arch epilog
        eger platform_arm64_mi() == 1 ise {
            arm64_emit_movz_x0_imm(a, 0);
            arm64_emit_epilog(a);
        } yoksa eger g_target_platform == 6 ise {
            int32_yaz(a, riscv_encode_i_type(RV_OP_LOAD, 3, RV_RA, RV_SP, 248));
            int32_yaz(a, riscv_encode_i_type(RV_OP_LOAD, 3, RV_S0, RV_SP, 240));
            int32_yaz(a, riscv_encode_i_type(RV_OP_IMM, 0, RV_SP, RV_SP, 256));
            int32_yaz(a, riscv_encode_i_type(RV_OP_JALR, 0, RV_ZERO, RV_RA, 0));
        } yoksa eger g_target_platform == 5 ise {
            byte_yaz(a, 0x0B); # end
        } yoksa {
            raii_fonksiyon_donus_emit(a);
            byte_yaz(a, 0x48); byte_yaz(a, 0x89); byte_yaz(a, 0xEC); # MOV RSP, RBP
            emit_pop_rbp(a);
            ra_callee_epilog_emit(a);
            emit_ret(a);
        }
        g_fonksiyon_icinde = 0;
        dondu 0;
    }

    eger dugum.tip == 11 ise { # AST_ISLEV_CAGRISI
        # Parser namespace'leri __ ile flatten eder; enum tablosu da ayni
        # tam adi tuttugu icin normal fonksiyon sembolu aramadan once bu
        # tagged-union yolunu sec.
        degisken enum_kimlik: *AstDugum = dugum.sol;
        degisken enum_varyant: *AstDugum = 0;
        degisken enum_payload: *AstDugum = dugum.sag;
        # `Durum.Deger(42)` AST'sinde callee dugum.sol=Durum,
        # dugum.sag=Deger ve argumanlar Deger.sag altindadir.
        eger dugum.sag != 0 ve dugum.sag.ilk_jeton != 0 ise {
            enum_varyant = dugum.sag;
            enum_payload = dugum.sag.sag;
            degisken enum_idx_alan: tamsayi = enum_codegen_varyant_bul(
                dugum.sag.ilk_jeton.baslangic,
                dugum.sag.ilk_jeton.uzunluk
            );

            eger enum_idx_alan >= 0 ise { enum_kimlik = dugum.sag; }
        }
        eger enum_kimlik != 0 ve enum_kimlik.ilk_jeton != 0 ise {
            degisken enum_idx: tamsayi = enum_codegen_varyant_bul(
                enum_kimlik.ilk_jeton.baslangic,
                enum_kimlik.ilk_jeton.uzunluk
            );

            eger enum_idx >= 0 ise {
                # Sadece enum genelinde HICBIR variant'in payload'i yoksa (pure C-style enum) disc degerini doğrudan RAX'a yukle
                eger enum_varyant_has_any_payload(enum_idx) == 0 ve enum_payload == 0 ise {
                    # MOV RAX, imm64 (disc degeri)
                    degisken disc_imm: tamsayi = g_enum_var_disc[enum_idx];
                    byte_yaz(a, 0x48); byte_yaz(a, 0xC7); byte_yaz(a, 0xC0); int32_yaz(a, disc_imm); # MOV RAX, disc
                    dondu 0;
                }

                # Payload tek bir 8-byte degerdir; yoksa union alanini sifirla.
                # Sabit payload parser metadata'sinda tasiniyorsa AST linked-list
                # driftinden bagimsiz dogrudan emit et.
                eger dugum.cozumlenmis_tip == 1 ise {
                    emit_mov_rax_imm32(a, dugum.dizi_boyutu);
                } yoksa eger enum_payload != 0 ise {
                    ast_kod_uret(a, enum_payload);
                } yoksa {
                    emit_xor_rax_rax(a);
                }
                # R12 callee-saved oldugu icin payload'i ABI'den bagimsiz burada tut.
                byte_yaz(a, 0x49); byte_yaz(a, 0x89); byte_yaz(a, 0xC4); # MOV R12, RAX

                eger g_target_platform == 1 ise {
                    # Linux x86_64: mmap(NULL, 16, PROT_RW, MAP_PRIVATE|ANON, -1, 0)
                    byte_yaz(a, 0x48); byte_yaz(a, 0x31); byte_yaz(a, 0xFF); # RDI=0
                    byte_yaz(a, 0x48); byte_yaz(a, 0xC7); byte_yaz(a, 0xC6); int32_yaz(a, 16); # RSI=size
                    byte_yaz(a, 0x48); byte_yaz(a, 0xC7); byte_yaz(a, 0xC2); int32_yaz(a, 3); # RDX=PROT_READ|WRITE
                    byte_yaz(a, 0x49); byte_yaz(a, 0xC7); byte_yaz(a, 0xC2); int32_yaz(a, 34); # R10=MAP_PRIVATE|ANON
                    byte_yaz(a, 0x49); byte_yaz(a, 0xC7); byte_yaz(a, 0xC0); int32_yaz(a, 0 - 1); # R8=-1
                    byte_yaz(a, 0x4D); byte_yaz(a, 0x31); byte_yaz(a, 0xC9); # R9=0
                    byte_yaz(a, 0x48); byte_yaz(a, 0xC7); byte_yaz(a, 0xC0); int32_yaz(a, 9); # RAX=SYS_mmap
                    byte_yaz(a, 0x0F); byte_yaz(a, 0x05);
                } yoksa eger g_target_platform == 2 ise {
                    # macOS x86_64: BSD mmap (0x2000000 + 197)
                    byte_yaz(a, 0x48); byte_yaz(a, 0x31); byte_yaz(a, 0xFF); # RDI=0
                    byte_yaz(a, 0x48); byte_yaz(a, 0xC7); byte_yaz(a, 0xC6); int32_yaz(a, 16); # RSI=size
                    byte_yaz(a, 0x48); byte_yaz(a, 0xC7); byte_yaz(a, 0xC2); int32_yaz(a, 3); # RDX=PROT_READ|WRITE
                    byte_yaz(a, 0x49); byte_yaz(a, 0xC7); byte_yaz(a, 0xC2); int32_yaz(a, 0x1002); # R10=MAP_PRIVATE|ANON
                    byte_yaz(a, 0x49); byte_yaz(a, 0xC7); byte_yaz(a, 0xC0); int32_yaz(a, 0 - 1); # R8=-1
                    byte_yaz(a, 0x4D); byte_yaz(a, 0x31); byte_yaz(a, 0xC9); # R9=0
                    byte_yaz(a, 0x48); byte_yaz(a, 0xC7); byte_yaz(a, 0xC0); int32_yaz(a, 0x20000C5); # RAX=BSD mmap
                    byte_yaz(a, 0x0F); byte_yaz(a, 0x05);
                } yoksa {
                    # Windows x86_64: VirtualAlloc(NULL, 16, 0x3000, 0x04)
                    # Payload zaten stack'te; push sonrasi hizayi korumak icin
                    # 32-byte shadow space'e ek olarak 8-byte padding ayir.
                    byte_yaz(a, 0x48); byte_yaz(a, 0x31); byte_yaz(a, 0xC9); # RCX=NULL
                    byte_yaz(a, 0x48); byte_yaz(a, 0xC7); byte_yaz(a, 0xC2); int32_yaz(a, 16); # RDX=size
                    byte_yaz(a, 0x41); byte_yaz(a, 0xB8); int32_yaz(a, 0x3000); # R8=MEM_COMMIT|RESERVE
                    byte_yaz(a, 0x41); byte_yaz(a, 0xB9); int32_yaz(a, 0x04); # R9=PAGE_READWRITE
                    byte_yaz(a, 0x48); byte_yaz(a, 0x83); byte_yaz(a, 0xEC); byte_yaz(a, 0x28); # shadow + alignment
                    byte_yaz(a, 0xFF); byte_yaz(a, 0x15);
                    eger iat_yama_kapasite_kontrol() == 0 ise { dondu 0; }
                    degisken enum_iat: tamsayi = g_iat_yama_adet;
                    g_iat_yama_text_offset[enum_iat] = a.kullanilan;
                    g_iat_yama_slot[enum_iat] = 3; # VirtualAlloc
                    g_iat_yama_adet = g_iat_yama_adet + 1;
                    int32_yaz(a, 0);
                    emit_add_rsp(a, 40);
                }

                # RAX=union adresi, payload R12'de korunuyor.
                byte_yaz(a, 0x4C); byte_yaz(a, 0x89); byte_yaz(a, 0xE1); # MOV RCX, R12
                byte_yaz(a, 0x48); byte_yaz(a, 0xC7); byte_yaz(a, 0x00); int32_yaz(a, g_enum_var_disc[enum_idx]); # durum
                byte_yaz(a, 0x48); byte_yaz(a, 0x89); byte_yaz(a, 0x48); byte_yaz(a, 0x08); # deger
                dondu 0;
            }
        }

        eger dugum.sag != 0 ve dugum.sag.tip == AST_KIMLIK ve dugum.sol != 0 ve dugum.sol.ilk_jeton != 0 ise {
            degisken sol_j: *Jeton = dugum.sol.ilk_jeton;
            degisken sol_off: tamsayi = lokal_bul_offset(sol_j.baslangic, sol_j.uzunluk);
            degisken sol_t_adi: *u8 = lokal_bul_tip_adi(sol_j.baslangic, sol_j.uzunluk);
            degisken sol_t_uzn: tamsayi = lokal_bul_tip_uzn(sol_j.baslangic, sol_j.uzunluk);
            degisken sol_yildiz: tamsayi = lokal_bul_yildiz(sol_j.baslangic, sol_j.uzunluk);
            # Dynamic dispatch trait nesnesi çağrısı: sekil.ciz(...)
            eger sol_off != 0 ve sol_t_uzn > 4 ve bellek_esit_mi(sol_t_adi, "dyn ".ptr, 4) == 1 ise {
                degisken tr_ad: *u8 = sol_t_adi + 4;
                degisken tr_uzn: tamsayi = sol_t_uzn - 4;
                degisken cagri_m_j: *Jeton = dugum.sag.ilk_jeton;
                degisken method_idx: tamsayi = 0;
                degisken ti: tamsayi = 0;
                dongu ti < g_tc_trait_sayisi {
                    eger g_tc_trait_uzunluk[ti] == tr_uzn ve
                        bellek_esit_mi(g_tc_trait_isim[ti], tr_ad, tr_uzn) == 1 ise {
                        degisken mb: tamsayi = g_tc_trait_metod_bas[ti];
                        degisken ma: tamsayi = g_tc_trait_metod_adet[ti];
                        degisken mi: tamsayi = 0;
                        dongu mi < ma {
                            eger g_tc_metod_uzunluk[mb + mi] == cagri_m_j.uzunluk ve
                                bellek_esit_mi(g_tc_metod_isim[mb + mi], cagri_m_j.baslangic, cagri_m_j.uzunluk) == 1 ise {
                                method_idx = mi;
                                durdur;
                            }
                            mi = mi + 1;
                        }
                        durdur;
                    }
                    ti = ti + 1;
                }
                degisken slot_off: tamsayi = method_idx * 8;

                eger sol_yildiz == 1 ise {
                    emit_load_rax(a, sol_off);
                    byte_yaz(a, 0x48); byte_yaz(a, 0x8B); byte_yaz(a, 0x08); # MOV RCX, [RAX] (veri)
                    byte_yaz(a, 0x4C); byte_yaz(a, 0x8B); byte_yaz(a, 0x58); byte_yaz(a, 0x08); # MOV R11, [RAX + 8] (vtable)
                } yoksa {
                    emit_lea_rax(a, sol_off);
                    byte_yaz(a, 0x48); byte_yaz(a, 0x8B); byte_yaz(a, 0x08); # MOV RCX, [RAX]
                    byte_yaz(a, 0x4C); byte_yaz(a, 0x8B); byte_yaz(a, 0x58); byte_yaz(a, 0x08); # MOV R11, [RAX + 8]
                }
                eger g_target_platform == 1 ise {
                    byte_yaz(a, 0x48); byte_yaz(a, 0x89); byte_yaz(a, 0xCF); # MOV RDI, RCX (Linux ABI)
                }
                # Method index: MOV R11, [R11 + slot_off]
                eger slot_off == 0 ise {
                    byte_yaz(a, 0x4D); byte_yaz(a, 0x8B); byte_yaz(a, 0x1B); # MOV R11, [R11]
                } yoksa {
                    byte_yaz(a, 0x4D); byte_yaz(a, 0x8B); byte_yaz(a, 0x5B); byte_yaz(a, slot_off); # MOV R11, [R11 + slot_off]
                }
                degisken ek_arg: *AstDugum = dugum.sag.sag;
                eger ek_arg != 0 ise {
                    byte_yaz(a, 0x51); # PUSH RCX
                    byte_yaz(a, 0x41); byte_yaz(a, 0x53); # PUSH R11
                    ast_kod_uret(a, ek_arg);
                    byte_yaz(a, 0x48); byte_yaz(a, 0x89); byte_yaz(a, 0xC2); # MOV RDX, RAX
                    byte_yaz(a, 0x41); byte_yaz(a, 0x5B); # POP R11
                    byte_yaz(a, 0x59); # POP RCX
                }
                eger g_target_platform == 0 ise {
                    byte_yaz(a, 0x48); byte_yaz(a, 0x83); byte_yaz(a, 0xEC); byte_yaz(a, 0x20); # SUB RSP, 32
                }
                byte_yaz(a, 0x41); byte_yaz(a, 0xFF); byte_yaz(a, 0xD3); # CALL R11
                eger g_target_platform == 0 ise {
                    byte_yaz(a, 0x48); byte_yaz(a, 0x83); byte_yaz(a, 0xC4); byte_yaz(a, 0x20); # ADD RSP, 32
                }
                dondu 0;
            }
        }

        degisken f_isim: *u8 = dugum.sol.ilk_jeton.baslangic;
        degisken f_uzn: tamsayi = dugum.sol.ilk_jeton.uzunluk;

        eger f_uzn >= 10 ve bellek_esit_mi(f_isim, "vtable__".ptr, 8) == 1 ise {
            eger g_target_platform == 1 ise {
                byte_yaz(a, 0x48); byte_yaz(a, 0x31); byte_yaz(a, 0xFF);
                byte_yaz(a, 0x48); byte_yaz(a, 0xC7); byte_yaz(a, 0xC6); int32_yaz(a, 64);
                byte_yaz(a, 0x48); byte_yaz(a, 0xC7); byte_yaz(a, 0xC2); int32_yaz(a, 3);
                byte_yaz(a, 0x49); byte_yaz(a, 0xC7); byte_yaz(a, 0xC2); int32_yaz(a, 34);
                byte_yaz(a, 0x49); byte_yaz(a, 0xC7); byte_yaz(a, 0xC0); int32_yaz(a, 0 - 1);
                byte_yaz(a, 0x4D); byte_yaz(a, 0x31); byte_yaz(a, 0xC9);
                byte_yaz(a, 0x48); byte_yaz(a, 0xC7); byte_yaz(a, 0xC0); int32_yaz(a, 9);
                byte_yaz(a, 0x0F); byte_yaz(a, 0x05);
            } yoksa {
                byte_yaz(a, 0x48); byte_yaz(a, 0x31); byte_yaz(a, 0xC9);
                byte_yaz(a, 0x48); byte_yaz(a, 0xC7); byte_yaz(a, 0xC2); int32_yaz(a, 64);
                byte_yaz(a, 0x41); byte_yaz(a, 0xB8); int32_yaz(a, 0x3000);
                byte_yaz(a, 0x41); byte_yaz(a, 0xB9); int32_yaz(a, 0x04);
                byte_yaz(a, 0x48); byte_yaz(a, 0x83); byte_yaz(a, 0xEC); byte_yaz(a, 0x28);
                byte_yaz(a, 0xFF); byte_yaz(a, 0x15);
                eger iat_yama_kapasite_kontrol() == 0 ise { dondu 0; }
                degisken vt_iat: tamsayi = g_iat_yama_adet;
                g_iat_yama_text_offset[vt_iat] = a.kullanilan;
                g_iat_yama_slot[vt_iat] = 3;
                g_iat_yama_adet = g_iat_yama_adet + 1;
                int32_yaz(a, 0);
                emit_add_rsp(a, 40);
            }
            byte_yaz(a, 0x49); byte_yaz(a, 0x89); byte_yaz(a, 0xC2); # MOV R10, RAX
            degisken tip_son: tamsayi = 8;
            dongu tip_son + 1 < f_uzn {
                eger f_isim[tip_son] == 95 ve f_isim[tip_son + 1] == 95 ise { durdur; }
                tip_son = tip_son + 1;
            }
            degisken tip_len_v: tamsayi = tip_son - 8;
            degisken trait_bas: tamsayi = tip_son + 2;
            degisken trait_len_v: tamsayi = f_uzn - trait_bas;
            degisken tr_found_idx: tamsayi = 0 - 1;
            degisken ti: tamsayi = 0;
            dongu ti < g_tc_trait_sayisi {
                eger g_tc_trait_uzunluk[ti] == trait_len_v ve
                    bellek_esit_mi(g_tc_trait_isim[ti], f_isim + trait_bas, trait_len_v) == 1 ise {
                    tr_found_idx = ti;
                    durdur;
                }
                ti = ti + 1;
            }
            degisken metod_sayisi: tamsayi = 1;
            degisken m_bas: tamsayi = 0;
            eger tr_found_idx != 0 - 1 ise {
                metod_sayisi = g_tc_trait_metod_adet[tr_found_idx];
                m_bas = g_tc_trait_metod_bas[tr_found_idx];
                eger metod_sayisi <= 0 ise { metod_sayisi = 1; }
            }

            degisken mi: tamsayi = 0;
            dongu mi < metod_sayisi {
                degisken m_adi: *u8 = "ciz".ptr;
                degisken m_uzn: tamsayi = 3;
                eger tr_found_idx != 0 - 1 ise {
                    m_adi = g_tc_metod_isim[m_bas + mi];
                    m_uzn = g_tc_metod_uzunluk[m_bas + mi];
                }
                degisken h_len: tamsayi = tip_len_v + 2 + m_uzn;
                degisken h_buf: *u8 = compiler_tahsis_et(h_len + 1);
                degisken cpi: tamsayi = 0;
                dongu cpi < tip_len_v { h_buf[cpi] = f_isim[8 + cpi]; cpi = cpi + 1; }
                h_buf[cpi] = 95; cpi = cpi + 1;
                h_buf[cpi] = 95; cpi = cpi + 1;
                degisken s_idx: tamsayi = 0;
                dongu s_idx < m_uzn { h_buf[cpi] = m_adi[s_idx]; cpi = cpi + 1; s_idx = s_idx + 1; }
                h_buf[cpi] = 0;

                byte_yaz(a, 0x48); byte_yaz(a, 0x8D); byte_yaz(a, 0x05);
                eger yama_kapasite_kontrol() == 0 ise { dondu 0; }
                degisken y_vt: tamsayi = g_yama_adet;
                g_yama_isim[y_vt] = h_buf;
                g_yama_uzunluk[y_vt] = h_len;
                g_yama_adres[y_vt] = 0;
                g_yama_tip[y_vt] = 0;
                g_yama_cagri_pos[y_vt] = a.kullanilan;
                g_yama_adet = g_yama_adet + 1;
                int32_yaz(a, 0);

                degisken slot_ofs: tamsayi = mi * 8;
                eger slot_ofs == 0 ise {
                    byte_yaz(a, 0x49); byte_yaz(a, 0x89); byte_yaz(a, 0x02); # MOV [R10], RAX
                } yoksa {
                    byte_yaz(a, 0x49); byte_yaz(a, 0x89); byte_yaz(a, 0x42); byte_yaz(a, slot_ofs); # MOV [R10 + slot_ofs], RAX
                }
                mi = mi + 1;
            }
            byte_yaz(a, 0x4C); byte_yaz(a, 0x89); byte_yaz(a, 0xD0); # MOV RAX, R10
            dondu 0;
        }

        eger f_uzn == 9 ve bellek_esit_mi(f_isim, "dyn_yarat".ptr, 9) == 1 ise {
            degisken dy_arg1: *AstDugum = dugum.sag;
            degisken dy_arg2: *AstDugum = 0;
            eger dy_arg1 != 0 ise { dy_arg2 = dy_arg1.sonraki; }
            eger dy_arg1 != 0 ise { ast_kod_uret(a, dy_arg1); } yoksa { emit_xor_rax_rax(a); }
            byte_yaz(a, 0x50); # PUSH RAX (veri)
            eger dy_arg2 != 0 ise { ast_kod_uret(a, dy_arg2); } yoksa { emit_xor_rax_rax(a); }
            byte_yaz(a, 0x50); # PUSH RAX (vtable)
            eger g_target_platform == 1 ise {
                byte_yaz(a, 0x48); byte_yaz(a, 0x31); byte_yaz(a, 0xFF);
                byte_yaz(a, 0x48); byte_yaz(a, 0xC7); byte_yaz(a, 0xC6); int32_yaz(a, 16);
                byte_yaz(a, 0x48); byte_yaz(a, 0xC7); byte_yaz(a, 0xC2); int32_yaz(a, 3);
                byte_yaz(a, 0x49); byte_yaz(a, 0xC7); byte_yaz(a, 0xC2); int32_yaz(a, 34);
                byte_yaz(a, 0x49); byte_yaz(a, 0xC7); byte_yaz(a, 0xC0); int32_yaz(a, 0 - 1);
                byte_yaz(a, 0x4D); byte_yaz(a, 0x31); byte_yaz(a, 0xC9);
                byte_yaz(a, 0x48); byte_yaz(a, 0xC7); byte_yaz(a, 0xC0); int32_yaz(a, 9);
                byte_yaz(a, 0x0F); byte_yaz(a, 0x05);
            } yoksa {
                byte_yaz(a, 0x48); byte_yaz(a, 0x31); byte_yaz(a, 0xC9);
                byte_yaz(a, 0x48); byte_yaz(a, 0xC7); byte_yaz(a, 0xC2); int32_yaz(a, 16);
                byte_yaz(a, 0x41); byte_yaz(a, 0xB8); int32_yaz(a, 0x3000);
                byte_yaz(a, 0x41); byte_yaz(a, 0xB9); int32_yaz(a, 0x04);
                byte_yaz(a, 0x48); byte_yaz(a, 0x83); byte_yaz(a, 0xEC); byte_yaz(a, 0x28);
                byte_yaz(a, 0xFF); byte_yaz(a, 0x15);
                eger iat_yama_kapasite_kontrol() == 0 ise { dondu 0; }
                degisken dy_iat: tamsayi = g_iat_yama_adet;
                g_iat_yama_text_offset[dy_iat] = a.kullanilan;
                g_iat_yama_slot[dy_iat] = 3;
                g_iat_yama_adet = g_iat_yama_adet + 1;
                int32_yaz(a, 0);
                emit_add_rsp(a, 40);
            }
            byte_yaz(a, 0x41); byte_yaz(a, 0x5B); # POP R11 (vtable)
            byte_yaz(a, 0x41); byte_yaz(a, 0x5A); # POP R10 (veri)
            byte_yaz(a, 0x4C); byte_yaz(a, 0x89); byte_yaz(a, 0x10); # MOV [RAX + 0], R10 (veri)
            byte_yaz(a, 0x4C); byte_yaz(a, 0x89); byte_yaz(a, 0x58); byte_yaz(a, 8); # MOV [RAX + 8], R11 (vtable)
            dondu 0;
        }

        # --------------------------------------------------------
        # AST_SONUC_TANIM constructors: Tamam(deger) ve Hata(kod)
        # Tamam(val): *Sonuc { basarili=1, deger=val, hata_kodu=0 }
        # Hata(val):  *Sonuc { basarili=0, deger=0,   hata_kodu=val }
        # Layout: [+0: basarili(8), +8: deger(8), +16: hata_kodu(8)] = 24 bytes
        # --------------------------------------------------------
        eger f_uzn == 5 ve bellek_esit_mi(f_isim, "Tamam".ptr, 5) == 1 ise {
            # Evaluate payload arg -> RAX
            eger dugum.sag != 0 ise {
                ast_kod_uret(a, dugum.sag);
            } yoksa {
                emit_xor_rax_rax(a);
            }
            # Preserve payload safely on stack across allocator call
            byte_yaz(a, 0x50); # PUSH RAX
            # Allocate 24 bytes
            eger g_target_platform == 1 ise {
                byte_yaz(a, 0x48); byte_yaz(a, 0x31); byte_yaz(a, 0xFF); # RDI=0
                byte_yaz(a, 0x48); byte_yaz(a, 0xC7); byte_yaz(a, 0xC6); int32_yaz(a, 24); # RSI=24
                byte_yaz(a, 0x48); byte_yaz(a, 0xC7); byte_yaz(a, 0xC2); int32_yaz(a, 3);
                byte_yaz(a, 0x49); byte_yaz(a, 0xC7); byte_yaz(a, 0xC2); int32_yaz(a, 34);
                byte_yaz(a, 0x49); byte_yaz(a, 0xC7); byte_yaz(a, 0xC0); int32_yaz(a, 0 - 1);
                byte_yaz(a, 0x4D); byte_yaz(a, 0x31); byte_yaz(a, 0xC9);
                byte_yaz(a, 0x48); byte_yaz(a, 0xC7); byte_yaz(a, 0xC0); int32_yaz(a, 9);
                byte_yaz(a, 0x0F); byte_yaz(a, 0x05);
            } yoksa eger g_target_platform == 2 ise {
                byte_yaz(a, 0x48); byte_yaz(a, 0x31); byte_yaz(a, 0xFF);
                byte_yaz(a, 0x48); byte_yaz(a, 0xC7); byte_yaz(a, 0xC6); int32_yaz(a, 24);
                byte_yaz(a, 0x48); byte_yaz(a, 0xC7); byte_yaz(a, 0xC2); int32_yaz(a, 3);
                byte_yaz(a, 0x49); byte_yaz(a, 0xC7); byte_yaz(a, 0xC2); int32_yaz(a, 0x1002);
                byte_yaz(a, 0x49); byte_yaz(a, 0xC7); byte_yaz(a, 0xC0); int32_yaz(a, 0 - 1);
                byte_yaz(a, 0x4D); byte_yaz(a, 0x31); byte_yaz(a, 0xC9);
                byte_yaz(a, 0x48); byte_yaz(a, 0xC7); byte_yaz(a, 0xC0); int32_yaz(a, 0x20000C5);
                byte_yaz(a, 0x0F); byte_yaz(a, 0x05);
            } yoksa {
                byte_yaz(a, 0x48); byte_yaz(a, 0x31); byte_yaz(a, 0xC9);
                byte_yaz(a, 0x48); byte_yaz(a, 0xC7); byte_yaz(a, 0xC2); int32_yaz(a, 24);
                byte_yaz(a, 0x41); byte_yaz(a, 0xB8); int32_yaz(a, 0x3000);
                byte_yaz(a, 0x41); byte_yaz(a, 0xB9); int32_yaz(a, 0x04);
                byte_yaz(a, 0x48); byte_yaz(a, 0x83); byte_yaz(a, 0xEC); byte_yaz(a, 0x28);
                byte_yaz(a, 0xFF); byte_yaz(a, 0x15);
                eger iat_yama_kapasite_kontrol() == 0 ise { dondu 0; }
                degisken tamam_iat: tamsayi = g_iat_yama_adet;
                g_iat_yama_text_offset[tamam_iat] = a.kullanilan;
                g_iat_yama_slot[tamam_iat] = 3;
                g_iat_yama_adet = g_iat_yama_adet + 1;
                int32_yaz(a, 0);
                emit_add_rsp(a, 40);
            }
            # RAX = ptr to 24-byte block
            byte_yaz(a, 0x41); byte_yaz(a, 0x5A); # POP R10 (payload)
            # MOV QWORD [RAX+0], 1   => basarili = 1
            byte_yaz(a, 0x48); byte_yaz(a, 0xC7); byte_yaz(a, 0x00); int32_yaz(a, 1);
            # MOV [RAX+8], R10       => deger = payload
            byte_yaz(a, 0x4C); byte_yaz(a, 0x89); byte_yaz(a, 0x50); byte_yaz(a, 8);
            # MOV QWORD [RAX+16], 0  => hata_kodu = 0
            byte_yaz(a, 0x48); byte_yaz(a, 0xC7); byte_yaz(a, 0x40); byte_yaz(a, 16); int32_yaz(a, 0);
            dondu 0;
        }

        eger f_uzn == 4 ve bellek_esit_mi(f_isim, "Hata".ptr, 4) == 1 ise {
            # Evaluate error payload arg -> RAX
            eger dugum.sag != 0 ise {
                ast_kod_uret(a, dugum.sag);
            } yoksa {
                emit_xor_rax_rax(a);
            }
            # Preserve error code safely on stack across allocator call
            byte_yaz(a, 0x50); # PUSH RAX
            # Allocate 24 bytes
            eger g_target_platform == 1 ise {
                byte_yaz(a, 0x48); byte_yaz(a, 0x31); byte_yaz(a, 0xFF);
                byte_yaz(a, 0x48); byte_yaz(a, 0xC7); byte_yaz(a, 0xC6); int32_yaz(a, 24);
                byte_yaz(a, 0x48); byte_yaz(a, 0xC7); byte_yaz(a, 0xC2); int32_yaz(a, 3);
                byte_yaz(a, 0x49); byte_yaz(a, 0xC7); byte_yaz(a, 0xC2); int32_yaz(a, 34);
                byte_yaz(a, 0x49); byte_yaz(a, 0xC7); byte_yaz(a, 0xC0); int32_yaz(a, 0 - 1);
                byte_yaz(a, 0x4D); byte_yaz(a, 0x31); byte_yaz(a, 0xC9);
                byte_yaz(a, 0x48); byte_yaz(a, 0xC7); byte_yaz(a, 0xC0); int32_yaz(a, 9);
                byte_yaz(a, 0x0F); byte_yaz(a, 0x05);
            } yoksa eger g_target_platform == 2 ise {
                byte_yaz(a, 0x48); byte_yaz(a, 0x31); byte_yaz(a, 0xFF);
                byte_yaz(a, 0x48); byte_yaz(a, 0xC7); byte_yaz(a, 0xC6); int32_yaz(a, 24);
                byte_yaz(a, 0x48); byte_yaz(a, 0xC7); byte_yaz(a, 0xC2); int32_yaz(a, 3);
                byte_yaz(a, 0x49); byte_yaz(a, 0xC7); byte_yaz(a, 0xC2); int32_yaz(a, 0x1002);
                byte_yaz(a, 0x49); byte_yaz(a, 0xC7); byte_yaz(a, 0xC0); int32_yaz(a, 0 - 1);
                byte_yaz(a, 0x4D); byte_yaz(a, 0x31); byte_yaz(a, 0xC9);
                byte_yaz(a, 0x48); byte_yaz(a, 0xC7); byte_yaz(a, 0xC0); int32_yaz(a, 0x20000C5);
                byte_yaz(a, 0x0F); byte_yaz(a, 0x05);
            } yoksa {
                byte_yaz(a, 0x48); byte_yaz(a, 0x31); byte_yaz(a, 0xC9);
                byte_yaz(a, 0x48); byte_yaz(a, 0xC7); byte_yaz(a, 0xC2); int32_yaz(a, 24);
                byte_yaz(a, 0x41); byte_yaz(a, 0xB8); int32_yaz(a, 0x3000);
                byte_yaz(a, 0x41); byte_yaz(a, 0xB9); int32_yaz(a, 0x04);
                byte_yaz(a, 0x48); byte_yaz(a, 0x83); byte_yaz(a, 0xEC); byte_yaz(a, 0x28);
                byte_yaz(a, 0xFF); byte_yaz(a, 0x15);
                eger iat_yama_kapasite_kontrol() == 0 ise { dondu 0; }
                degisken hata_iat: tamsayi = g_iat_yama_adet;
                g_iat_yama_text_offset[hata_iat] = a.kullanilan;
                g_iat_yama_slot[hata_iat] = 3;
                g_iat_yama_adet = g_iat_yama_adet + 1;
                int32_yaz(a, 0);
                emit_add_rsp(a, 40);
            }
            # RAX = ptr to 24-byte block
            byte_yaz(a, 0x41); byte_yaz(a, 0x5A); # POP R10 (error payload)
            # MOV QWORD [RAX+0], 0   => basarili = 0
            byte_yaz(a, 0x48); byte_yaz(a, 0xC7); byte_yaz(a, 0x00); int32_yaz(a, 0);
            # MOV QWORD [RAX+8], 0   => deger = 0
            byte_yaz(a, 0x48); byte_yaz(a, 0xC7); byte_yaz(a, 0x40); byte_yaz(a, 8); int32_yaz(a, 0);
            # MOV [RAX+16], R10      => hata_kodu = error payload
            byte_yaz(a, 0x4C); byte_yaz(a, 0x89); byte_yaz(a, 0x50); byte_yaz(a, 16);
            dondu 0;
        }

        eger tip_adini_coz_yerel(f_isim, f_uzn) == 2 ve dugum.sag != 0 ve dugum.sag.sonraki == 0 ise {
            degisken arg: *AstDugum = dugum.sag;
            ast_kod_uret(a, arg);
            eger ast_node_is_float(arg) == 0 ise {
                # CVTSI2SD XMM0, RAX (0xF2 0x48 0x0F 0x2A 0xC0)
                byte_yaz(a, 0xF2); byte_yaz(a, 0x48); byte_yaz(a, 0x0F); byte_yaz(a, 0x2A); byte_yaz(a, 0xC0);
                # MOVQ RAX, XMM0 (0x66 0x48 0x0F 0x7E 0xC0)
                byte_yaz(a, 0x66); byte_yaz(a, 0x48); byte_yaz(a, 0x0F); byte_yaz(a, 0x7E); byte_yaz(a, 0xC0);
            }
            dondu 0;
        } yoksa eger tip_adini_coz_yerel(f_isim, f_uzn) == 1 ve dugum.sag != 0 ve dugum.sag.sonraki == 0 ise {
            degisken arg: *AstDugum = dugum.sag;
            ast_kod_uret(a, arg);
            eger ast_node_is_float(arg) == 1 ise {
                # MOVQ XMM0, RAX (0x66 0x48 0x0F 0x6E 0xC0)
                byte_yaz(a, 0x66); byte_yaz(a, 0x48); byte_yaz(a, 0x0F); byte_yaz(a, 0x6E); byte_yaz(a, 0xC0);
                # CVTTSD2SI RAX, XMM0 (0xF2 0x48 0x0F 0x2C 0xC0)
                byte_yaz(a, 0xF2); byte_yaz(a, 0x48); byte_yaz(a, 0x0F); byte_yaz(a, 0x2C); byte_yaz(a, 0xC0);
            }
            dondu 0;
        # --------------------------------------------------------
        # GOREV 6.2: FPU / SSE matematik fonksiyonlari
        # kare_kok → SQRTSD; sinus → FSIN; kosinus → FCOS
        # gercek_mutlak → ANDPD; gercek_minimum → MINSD; gercek_maksimum → MAXSD
        # --------------------------------------------------------
        } yoksa eger f_uzn == 8 ve bellek_esit_mi(f_isim, "kare_kok".ptr, 8) == 1 ise {
            # kare_kok(x: gercek) -> gercek   →   SQRTSD XMM0, XMM0
            # Arguman XMM0'da (gercek tip), sonuc da XMM0'da
            degisken arg_kr: *AstDugum = dugum.sag;
            ast_kod_uret(a, arg_kr);
            # RAX'ta IEEE754 double var, XMM0'a yukle
            byte_yaz(a, 0x66); byte_yaz(a, 0x48); byte_yaz(a, 0x0F); byte_yaz(a, 0x6E); byte_yaz(a, 0xC0); # MOVQ XMM0, RAX
            # SQRTSD XMM0, XMM0  (F2 0F 51 C0)
            byte_yaz(a, 0xF2); byte_yaz(a, 0x0F); byte_yaz(a, 0x51); byte_yaz(a, 0xC0);
            # Sonucu RAX'a geri al
            byte_yaz(a, 0x66); byte_yaz(a, 0x48); byte_yaz(a, 0x0F); byte_yaz(a, 0x7E); byte_yaz(a, 0xC0); # MOVQ RAX, XMM0
            dondu 0;
        } yoksa eger f_uzn == 4 ve bellek_esit_mi(f_isim, "sqrt".ptr, 4) == 1 ise {
            # sqrt alias — ayni kod
            degisken arg_sq: *AstDugum = dugum.sag;
            ast_kod_uret(a, arg_sq);
            byte_yaz(a, 0x66); byte_yaz(a, 0x48); byte_yaz(a, 0x0F); byte_yaz(a, 0x6E); byte_yaz(a, 0xC0);
            byte_yaz(a, 0xF2); byte_yaz(a, 0x0F); byte_yaz(a, 0x51); byte_yaz(a, 0xC0);
            byte_yaz(a, 0x66); byte_yaz(a, 0x48); byte_yaz(a, 0x0F); byte_yaz(a, 0x7E); byte_yaz(a, 0xC0);
            dondu 0;
        } yoksa eger f_uzn == 5 ve bellek_esit_mi(f_isim, "sinus".ptr, 5) == 1 ise {
            # sinus(x: gercek) -> gercek   →   x87 FSIN
            # RAX'ta IEEE754 double → ST(0) yükle → FSIN → ST(0)→RAX
            degisken arg_si: *AstDugum = dugum.sag;
            ast_kod_uret(a, arg_si);
            byte_yaz(a, 0x66); byte_yaz(a, 0x48); byte_yaz(a, 0x0F); byte_yaz(a, 0x6E); byte_yaz(a, 0xC0); # MOVQ XMM0, RAX
            # stack frame'e geçici double yaz: SUB RSP,8; MOVSD [RSP],XMM0
            byte_yaz(a, 0x48); byte_yaz(a, 0x83); byte_yaz(a, 0xEC); byte_yaz(a, 8); # SUB RSP, 8
            byte_yaz(a, 0xF2); byte_yaz(a, 0x0F); byte_yaz(a, 0x11); byte_yaz(a, 0x04); byte_yaz(a, 0x24); # MOVSD [RSP], XMM0
            # x87: FLD qword [RSP]
            byte_yaz(a, 0xDD); byte_yaz(a, 0x04); byte_yaz(a, 0x24); # FLD [RSP]
            # FSIN
            byte_yaz(a, 0xD9); byte_yaz(a, 0xFE);
            # FSTP qword [RSP]  (pop to memory)
            byte_yaz(a, 0xDD); byte_yaz(a, 0x1C); byte_yaz(a, 0x24); # FSTP [RSP]
            # MOVSD XMM0, [RSP]
            byte_yaz(a, 0xF2); byte_yaz(a, 0x0F); byte_yaz(a, 0x10); byte_yaz(a, 0x04); byte_yaz(a, 0x24); # MOVSD XMM0,[RSP]
            # ADD RSP, 8
            byte_yaz(a, 0x48); byte_yaz(a, 0x83); byte_yaz(a, 0xC4); byte_yaz(a, 8);
            # MOVQ RAX, XMM0
            byte_yaz(a, 0x66); byte_yaz(a, 0x48); byte_yaz(a, 0x0F); byte_yaz(a, 0x7E); byte_yaz(a, 0xC0);
            dondu 0;
        } yoksa eger f_uzn == 3 ve bellek_esit_mi(f_isim, "sin".ptr, 3) == 1 ise {
            # sin alias
            degisken arg_sn: *AstDugum = dugum.sag;
            ast_kod_uret(a, arg_sn);
            byte_yaz(a, 0x66); byte_yaz(a, 0x48); byte_yaz(a, 0x0F); byte_yaz(a, 0x6E); byte_yaz(a, 0xC0);
            byte_yaz(a, 0x48); byte_yaz(a, 0x83); byte_yaz(a, 0xEC); byte_yaz(a, 8);
            byte_yaz(a, 0xF2); byte_yaz(a, 0x0F); byte_yaz(a, 0x11); byte_yaz(a, 0x04); byte_yaz(a, 0x24);
            byte_yaz(a, 0xDD); byte_yaz(a, 0x04); byte_yaz(a, 0x24);
            byte_yaz(a, 0xD9); byte_yaz(a, 0xFE);
            byte_yaz(a, 0xDD); byte_yaz(a, 0x1C); byte_yaz(a, 0x24);
            byte_yaz(a, 0xF2); byte_yaz(a, 0x0F); byte_yaz(a, 0x10); byte_yaz(a, 0x04); byte_yaz(a, 0x24);
            byte_yaz(a, 0x48); byte_yaz(a, 0x83); byte_yaz(a, 0xC4); byte_yaz(a, 8);
            byte_yaz(a, 0x66); byte_yaz(a, 0x48); byte_yaz(a, 0x0F); byte_yaz(a, 0x7E); byte_yaz(a, 0xC0);
            dondu 0;
        } yoksa eger f_uzn == 7 ve bellek_esit_mi(f_isim, "kosinus".ptr, 7) == 1 ise {
            # kosinus(x: gercek) -> gercek   →   x87 FCOS
            degisken arg_ko: *AstDugum = dugum.sag;
            ast_kod_uret(a, arg_ko);
            byte_yaz(a, 0x66); byte_yaz(a, 0x48); byte_yaz(a, 0x0F); byte_yaz(a, 0x6E); byte_yaz(a, 0xC0);
            byte_yaz(a, 0x48); byte_yaz(a, 0x83); byte_yaz(a, 0xEC); byte_yaz(a, 8);
            byte_yaz(a, 0xF2); byte_yaz(a, 0x0F); byte_yaz(a, 0x11); byte_yaz(a, 0x04); byte_yaz(a, 0x24);
            byte_yaz(a, 0xDD); byte_yaz(a, 0x04); byte_yaz(a, 0x24); # FLD [RSP]
            byte_yaz(a, 0xD9); byte_yaz(a, 0xFF); # FCOS
            byte_yaz(a, 0xDD); byte_yaz(a, 0x1C); byte_yaz(a, 0x24); # FSTP [RSP]
            byte_yaz(a, 0xF2); byte_yaz(a, 0x0F); byte_yaz(a, 0x10); byte_yaz(a, 0x04); byte_yaz(a, 0x24);
            byte_yaz(a, 0x48); byte_yaz(a, 0x83); byte_yaz(a, 0xC4); byte_yaz(a, 8);
            byte_yaz(a, 0x66); byte_yaz(a, 0x48); byte_yaz(a, 0x0F); byte_yaz(a, 0x7E); byte_yaz(a, 0xC0);
            dondu 0;
        } yoksa eger f_uzn == 3 ve bellek_esit_mi(f_isim, "cos".ptr, 3) == 1 ise {
            # cos alias
            degisken arg_co: *AstDugum = dugum.sag;
            ast_kod_uret(a, arg_co);
            byte_yaz(a, 0x66); byte_yaz(a, 0x48); byte_yaz(a, 0x0F); byte_yaz(a, 0x6E); byte_yaz(a, 0xC0);
            byte_yaz(a, 0x48); byte_yaz(a, 0x83); byte_yaz(a, 0xEC); byte_yaz(a, 8);
            byte_yaz(a, 0xF2); byte_yaz(a, 0x0F); byte_yaz(a, 0x11); byte_yaz(a, 0x04); byte_yaz(a, 0x24);
            byte_yaz(a, 0xDD); byte_yaz(a, 0x04); byte_yaz(a, 0x24);
            byte_yaz(a, 0xD9); byte_yaz(a, 0xFF);
            byte_yaz(a, 0xDD); byte_yaz(a, 0x1C); byte_yaz(a, 0x24);
            byte_yaz(a, 0xF2); byte_yaz(a, 0x0F); byte_yaz(a, 0x10); byte_yaz(a, 0x04); byte_yaz(a, 0x24);
            byte_yaz(a, 0x48); byte_yaz(a, 0x83); byte_yaz(a, 0xC4); byte_yaz(a, 8);
            byte_yaz(a, 0x66); byte_yaz(a, 0x48); byte_yaz(a, 0x0F); byte_yaz(a, 0x7E); byte_yaz(a, 0xC0);
            dondu 0;
        } yoksa eger f_uzn == 13 ve bellek_esit_mi(f_isim, "gercek_mutlak".ptr, 13) == 1 ise {
            # gercek_mutlak(x) → ANDPD ile isaret bitini sifirla (IEEE754 abs)
            degisken arg_gm: *AstDugum = dugum.sag;
            ast_kod_uret(a, arg_gm);
            byte_yaz(a, 0x66); byte_yaz(a, 0x48); byte_yaz(a, 0x0F); byte_yaz(a, 0x6E); byte_yaz(a, 0xC0); # MOVQ XMM0,RAX
            # mask: 0x7FFFFFFFFFFFFFFF → XMM1, sonra ANDPD XMM0,XMM1
            # En pratik: PSLLQ XMM0,1; PSRLQ XMM0,1  (isaret bitini sifirla)
            byte_yaz(a, 0x66); byte_yaz(a, 0x0F); byte_yaz(a, 0x73); byte_yaz(a, 0xF0); byte_yaz(a, 1); # PSLLQ XMM0,1
            byte_yaz(a, 0x66); byte_yaz(a, 0x0F); byte_yaz(a, 0x73); byte_yaz(a, 0xD0); byte_yaz(a, 1); # PSRLQ XMM0,1
            byte_yaz(a, 0x66); byte_yaz(a, 0x48); byte_yaz(a, 0x0F); byte_yaz(a, 0x7E); byte_yaz(a, 0xC0); # MOVQ RAX,XMM0
            dondu 0;
        } yoksa eger f_uzn == 4 ve bellek_esit_mi(f_isim, "fabs".ptr, 4) == 1 ise {
            # fabs alias
            degisken arg_fa: *AstDugum = dugum.sag;
            ast_kod_uret(a, arg_fa);
            byte_yaz(a, 0x66); byte_yaz(a, 0x48); byte_yaz(a, 0x0F); byte_yaz(a, 0x6E); byte_yaz(a, 0xC0);
            byte_yaz(a, 0x66); byte_yaz(a, 0x0F); byte_yaz(a, 0x73); byte_yaz(a, 0xF0); byte_yaz(a, 1);
            byte_yaz(a, 0x66); byte_yaz(a, 0x0F); byte_yaz(a, 0x73); byte_yaz(a, 0xD0); byte_yaz(a, 1);
            byte_yaz(a, 0x66); byte_yaz(a, 0x48); byte_yaz(a, 0x0F); byte_yaz(a, 0x7E); byte_yaz(a, 0xC0);
            dondu 0;
        } yoksa eger f_uzn == 14 ve bellek_esit_mi(f_isim, "gercek_minimum".ptr, 14) == 1 ise {
            # gercek_minimum(a,b) → MINSD XMM0,XMM1
            degisken arg2a: *AstDugum = dugum.sag;
            degisken arg2b: *AstDugum = 0;
            eger arg2a != 0 ise { arg2b = arg2a.sonraki; }
            ast_kod_uret(a, arg2a);
            byte_yaz(a, 0x66); byte_yaz(a, 0x48); byte_yaz(a, 0x0F); byte_yaz(a, 0x6E); byte_yaz(a, 0xC0); # MOVQ XMM0,RAX
            byte_yaz(a, 0x50); # PUSH RAX (XMM0 yedekle)
            ast_kod_uret(a, arg2b);
            byte_yaz(a, 0x66); byte_yaz(a, 0x48); byte_yaz(a, 0x0F); byte_yaz(a, 0x6E); byte_yaz(a, 0xC8); # MOVQ XMM1,RAX
            byte_yaz(a, 0x58); # POP RAX
            byte_yaz(a, 0x66); byte_yaz(a, 0x48); byte_yaz(a, 0x0F); byte_yaz(a, 0x6E); byte_yaz(a, 0xC0); # MOVQ XMM0,RAX
            # MINSD XMM0, XMM1  (F2 0F 5D C1)
            byte_yaz(a, 0xF2); byte_yaz(a, 0x0F); byte_yaz(a, 0x5D); byte_yaz(a, 0xC1);
            byte_yaz(a, 0x66); byte_yaz(a, 0x48); byte_yaz(a, 0x0F); byte_yaz(a, 0x7E); byte_yaz(a, 0xC0); # MOVQ RAX,XMM0
            dondu 0;
        } yoksa eger f_uzn == 4 ve bellek_esit_mi(f_isim, "fmin".ptr, 4) == 1 ise {
            # fmin alias
            degisken fmna: *AstDugum = dugum.sag;
            degisken fmnb: *AstDugum = 0;
            eger fmna != 0 ise { fmnb = fmna.sonraki; }
            ast_kod_uret(a, fmna);
            byte_yaz(a, 0x66); byte_yaz(a, 0x48); byte_yaz(a, 0x0F); byte_yaz(a, 0x6E); byte_yaz(a, 0xC0);
            byte_yaz(a, 0x50);
            ast_kod_uret(a, fmnb);
            byte_yaz(a, 0x66); byte_yaz(a, 0x48); byte_yaz(a, 0x0F); byte_yaz(a, 0x6E); byte_yaz(a, 0xC8);
            byte_yaz(a, 0x58);
            byte_yaz(a, 0x66); byte_yaz(a, 0x48); byte_yaz(a, 0x0F); byte_yaz(a, 0x6E); byte_yaz(a, 0xC0);
            byte_yaz(a, 0xF2); byte_yaz(a, 0x0F); byte_yaz(a, 0x5D); byte_yaz(a, 0xC1);
            byte_yaz(a, 0x66); byte_yaz(a, 0x48); byte_yaz(a, 0x0F); byte_yaz(a, 0x7E); byte_yaz(a, 0xC0);
            dondu 0;
        } yoksa eger f_uzn == 15 ve bellek_esit_mi(f_isim, "gercek_maksimum".ptr, 15) == 1 ise {
            # gercek_maksimum(a,b) → MAXSD XMM0,XMM1
            degisken fmxa: *AstDugum = dugum.sag;
            degisken fmxb: *AstDugum = 0;
            eger fmxa != 0 ise { fmxb = fmxa.sonraki; }
            ast_kod_uret(a, fmxa);
            byte_yaz(a, 0x66); byte_yaz(a, 0x48); byte_yaz(a, 0x0F); byte_yaz(a, 0x6E); byte_yaz(a, 0xC0);
            byte_yaz(a, 0x50);
            ast_kod_uret(a, fmxb);
            byte_yaz(a, 0x66); byte_yaz(a, 0x48); byte_yaz(a, 0x0F); byte_yaz(a, 0x6E); byte_yaz(a, 0xC8);
            byte_yaz(a, 0x58);
