    }
    eger uzn == 26 ve bellek_esit_mi(isim, "yukinary_sys_socket_create".ptr, 26) == 1 ise {
        eger arg_sayisi != 3 ise { dondu 0; }
        windows_iat_cagri(a, 19); dondu 1;
