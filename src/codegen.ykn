                byte_yaz(a, 0x48); byte_yaz(a, 0xC7); byte_yaz(a, 0x44); byte_yaz(a, 0x24); byte_yaz(a, 0x20); int32_yaz(a, 0); # [RSP+32] = NULL (lpOverlapped)
                byte_yaz(a, 0xFF); byte_yaz(a, 0x15);
