                    byte_yaz(a, 0x48); byte_yaz(a, 0x8B); byte_yaz(a, 0x4C); byte_yaz(a, 0x24); byte_yaz(a, 0x08); # MOV RCX, [RSP+8] (YKN a1)
                    byte_yaz(a, 0x48); byte_yaz(a, 0x8B); byte_yaz(a, 0x74); byte_yaz(a, 0x24); byte_yaz(a, 0x10); # MOV RSI, [RSP+16] (SysV a2)
                    byte_yaz(a, 0x48); byte_yaz(a, 0x8B); byte_yaz(a, 0x54); byte_yaz(a, 0x24); byte_yaz(a, 0x10); # MOV RDX, [RSP+16] (YKN a2)
