            yoksa eger f_uzn == 12 ve bellek_esit_mi(f_isim, "CreateThread".ptr, 12) == 1 ise { iat_slot_no = 39; }
            yoksa eger f_uzn == 25 ve bellek_esit_mi(f_isim, "InitializeCriticalSection".ptr, 25) == 1 ise { iat_slot_no = 40; }
            yoksa eger f_uzn == 20 ve bellek_esit_mi(f_isim, "EnterCriticalSection".ptr, 20) == 1 ise { iat_slot_no = 41; }
            yoksa eger f_uzn == 20 ve bellek_esit_mi(f_isim, "LeaveCriticalSection".ptr, 20) == 1 ise { iat_slot_no = 42; }
            yoksa eger f_uzn == 22 ve bellek_esit_mi(f_isim, "CreateIoCompletionPort".ptr, 22) == 1 ise { iat_slot_no = 43; }
            yoksa eger f_uzn == 25 ve bellek_esit_mi(f_isim, "GetQueuedCompletionStatus".ptr, 25) == 1 ise { iat_slot_no = 44; }
            yoksa eger f_uzn == 5 ve bellek_esit_mi(f_isim, "Sleep".ptr, 5) == 1 ise { iat_slot_no = 45; }
            yoksa eger f_uzn == 14 ve bellek_esit_mi(f_isim, "GetTickCount64".ptr, 14) == 1 ise { iat_slot_no = 46; }

            eger iat_slot_no >= 0 ise {
                eger g_target_platform == 1 ise {
                    eger iat_slot_no == 0 ise {
                        byte_yaz(a, 0x48); byte_yaz(a, 0x89); byte_yaz(a, 0xCF); # MOV RDI, RCX
                        byte_yaz(a, 0x48); byte_yaz(a, 0xC7); byte_yaz(a, 0xC0); int32_yaz(a, 60); # MOV RAX, 60
                        byte_yaz(a, 0x0F); byte_yaz(a, 0x05); # SYSCALL
                        emit_add_rsp(a, alloc_size);
                        dondu 0;
                    }
                    eger iat_slot_no == 3 ise {
                        byte_yaz(a, 0x48); byte_yaz(a, 0x31); byte_yaz(a, 0xFF); # XOR RDI, RDI
                        byte_yaz(a, 0x48); byte_yaz(a, 0x89); byte_yaz(a, 0xD6); # MOV RSI, RDX
                        byte_yaz(a, 0x48); byte_yaz(a, 0xC7); byte_yaz(a, 0xC2); int32_yaz(a, 7); # RDX = 7 (PROT_READ|WRITE|EXEC)
                        byte_yaz(a, 0x49); byte_yaz(a, 0xC7); byte_yaz(a, 0xC2); int32_yaz(a, 34); # R10 = 34 (MAP_PRIVATE|ANON)
                        byte_yaz(a, 0x49); byte_yaz(a, 0xC7); byte_yaz(a, 0xC0); int32_yaz(a, -1); # R8 = -1
                        byte_yaz(a, 0x4D); byte_yaz(a, 0x31); byte_yaz(a, 0xC9); # XOR R9, R9
                        byte_yaz(a, 0x48); byte_yaz(a, 0xC7); byte_yaz(a, 0xC0); int32_yaz(a, 9); # RAX = 9 (sys_mmap)
                        byte_yaz(a, 0x0F); byte_yaz(a, 0x05); # SYSCALL
                        emit_add_rsp(a, alloc_size);
                        dondu 0;
                    }
                }
                # Her Win32 IAT çağrısı aynı kapasite sözleşmesine uyar.
                # Guard çağrı opcode'u ve tablo yazımından önce çalışır;
                # kapasite aşımında kısmi PE üretimi yapılmaz.
                eger iat_yama_kapasite_kontrol() == 0 ise { dondu 0; }
                byte_yaz(a, 0xFF); byte_yaz(a, 0x15);
                degisken iat_idx: tamsayi = g_iat_yama_adet;
                g_iat_yama_text_offset[iat_idx] = a.kullanilan;
                g_iat_yama_slot[iat_idx] = iat_slot_no;
                g_iat_yama_adet = g_iat_yama_adet + 1;
                int32_yaz(a, 0);
            } yoksa {
                degisken f_off: tamsayi = lokal_bul_offset(f_isim, f_uzn);
                eger f_off != 0 ise {
                    # Indirect function pointer call: MOV R11, [RBP - f_off]; CALL R11
                    eger f_off <= 127 ise {
                        byte_yaz(a, 0x4C); byte_yaz(a, 0x8B); byte_yaz(a, 0x5D); byte_yaz(a, 256 - f_off);
                    } yoksa {
                        byte_yaz(a, 0x4C); byte_yaz(a, 0x8B); byte_yaz(a, 0x9D); int32_yaz(a, 0 - f_off);
                    }
                    byte_yaz(a, 0x41); byte_yaz(a, 0xFF); byte_yaz(a, 0xD3); # CALL R11
                } yoksa eger g_lambda_tabani > 0 ise {
                    degisken outer_f_off: tamsayi = lokal_bul_outer_offset(f_isim, f_uzn);
                    eger outer_f_off != 0 ise {
                        byte_yaz(a, 0x48); byte_yaz(a, 0x8B); byte_yaz(a, 0x55); byte_yaz(a, 0); # MOV RDX, [RBP + 0]
                        eger outer_f_off <= 127 ise {
                            byte_yaz(a, 0x4C); byte_yaz(a, 0x8B); byte_yaz(a, 0x5A); byte_yaz(a, 256 - outer_f_off);
                        } yoksa {
                            byte_yaz(a, 0x4C); byte_yaz(a, 0x8B); byte_yaz(a, 0x9A); int32_yaz(a, 0 - outer_f_off);
                        }
                        byte_yaz(a, 0x41); byte_yaz(a, 0xFF); byte_yaz(a, 0xD3); # CALL R11
                    }
                } yoksa {
                    # --------------------------------------------------------
                    # GOREV 5.2: Built-in Macro Seti — codegen seviyesinde
                    # dogrula / ayikla / panik / boyut
                    # --------------------------------------------------------
                    eger f_uzn == 7 ve bellek_esit_mi(f_isim, "dogrula".ptr, 7) == 1 ise {
                        # dogrula(kosul): kosul == 0 ise ExitProcess(1)
                        # Arguman zaten RAX'te (onceki ast_kod_uret ile)
                        # TEST RAX, RAX; JNZ devam; SUB RSP,32; MOV ECX,1; CALL [RIP+rel32]; ADD RSP,32
                        byte_yaz(a, 0x48); byte_yaz(a, 0x85); byte_yaz(a, 0xC0); # TEST RAX, RAX
                        byte_yaz(a, 0x75); byte_yaz(a, 0x0F); # JNZ +15 (devam) — 4+5+6=15 bytes atla
                        # ExitProcess(1): SUB RSP,32 + MOV ECX,1 + CALL [RIP+rel32]
                        byte_yaz(a, 0x48); byte_yaz(a, 0x83); byte_yaz(a, 0xEC); byte_yaz(a, 0x20); # SUB RSP,32 (4)
                        byte_yaz(a, 0xB9); int32_yaz(a, 1); # MOV ECX, 1 (5)
                        byte_yaz(a, 0xFF); byte_yaz(a, 0x15); # CALL [RIP+rel32] ExitProcess (6)
                        degisken ep_idx: tamsayi = g_iat_yama_adet;
                        g_iat_yama_text_offset[ep_idx] = a.kullanilan;
                        g_iat_yama_slot[ep_idx] = 0;
                        g_iat_yama_adet = g_iat_yama_adet + 1;
                        int32_yaz(a, 0);
                        emit_add_rsp(a, alloc_size);
                        dondu 0;
                    }
                    eger f_uzn == 6 ve bellek_esit_mi(f_isim, "ayikla".ptr, 6) == 1 ise {
                        # ayikla(deger): sayiyi_yazdir(deger) gibi emit et
                        # Zaten arguman stack'te (alloc_size ile tahsis edildi)
                        # Sadece fonksiyon adini sayiyi_yazdir olarak coz
                        byte_yaz(a, 0xE8);
                        eger yama_kapasite_kontrol() == 0 ise { dondu 0; }
                        degisken sy_idx: tamsayi = g_yama_adet;
                        g_yama_isim[sy_idx] = "sayiyi_yazdir".ptr;
                        g_yama_uzunluk[sy_idx] = 13;
                        g_yama_adres[sy_idx] = 0;
                        g_yama_tip[sy_idx] = 0;
                        g_yama_cagri_pos[sy_idx] = a.kullanilan;
                        g_yama_adet = g_yama_adet + 1;
                        int32_yaz(a, 0);
                        emit_add_rsp(a, alloc_size);
                        dondu 0;
                    }
                    eger f_uzn == 5 ve bellek_esit_mi(f_isim, "panik".ptr, 5) == 1 ise {
                        # panik(mesaj): ekrana_yaz(mesaj) + ExitProcess(1)
                        byte_yaz(a, 0xE8);
                        eger yama_kapasite_kontrol() == 0 ise { dondu 0; }
                        degisken ey_idx: tamsayi = g_yama_adet;
                        g_yama_isim[ey_idx] = "ekrana_yaz".ptr;
                        g_yama_uzunluk[ey_idx] = 10;
                        g_yama_adres[ey_idx] = 0;
                        g_yama_tip[ey_idx] = 0;
                        g_yama_cagri_pos[ey_idx] = a.kullanilan;
                        g_yama_adet = g_yama_adet + 1;
                        int32_yaz(a, 0);
                        emit_add_rsp(a, alloc_size);
                        # ExitProcess(1)
                        emit_sub_rsp(a, 32);
                        byte_yaz(a, 0xB9); int32_yaz(a, 1);
                        byte_yaz(a, 0xFF); byte_yaz(a, 0x15);
                        eger iat_yama_kapasite_kontrol() == 0 ise { dondu 0; }
                        degisken ep2_idx: tamsayi = g_iat_yama_adet;
                        g_iat_yama_text_offset[ep2_idx] = a.kullanilan;
                        g_iat_yama_slot[ep2_idx] = 0;
                        g_iat_yama_adet = g_iat_yama_adet + 1;
                        int32_yaz(a, 0);
                        emit_add_rsp(a, 32);
                        dondu 0;
                    }
                    eger f_uzn == 5 ve bellek_esit_mi(f_isim, "boyut".ptr, 5) == 1 ise {
                        # boyut(T): tip boyutunu sabit olarak emit et
                        # Arguman dugum tipine gore karar ver
                        degisken boyut_val: tamsayi = 8; # varsayilan
                        eger dugum.sag != 0 ve dugum.sag.ilk_jeton != 0 ise {
                            degisken tip_uzn2: tamsayi = dugum.sag.ilk_jeton.uzunluk;
                            degisken tip_ptr2: *u8 = dugum.sag.ilk_jeton.baslangic;
                            eger tip_uzn2 == 2 ve bellek_esit_mi(tip_ptr2, "u8".ptr, 2) == 1 ise {
                                boyut_val = 1;
                            }
                        }
                        emit_mov_rax_imm32(a, boyut_val);
                        emit_add_rsp(a, alloc_size);
                        dondu 0;
                    }
                    byte_yaz(a, 0xE8);
                    eger yama_kapasite_kontrol() == 0 ise { dondu 0; }
                    degisken y_idx: tamsayi = g_yama_adet;
                    g_yama_isim[y_idx] = f_isim;
                    g_yama_uzunluk[y_idx] = f_uzn;
                    g_yama_adres[y_idx] = 0;
                    g_yama_tip[y_idx] = 0;
                    g_yama_cagri_pos[y_idx] = a.kullanilan;
                    g_yama_adet = g_yama_adet + 1;
                    int32_yaz(a, 0);
                }
            }
            
            emit_add_rsp(a, alloc_size);
        }
        dondu 0;
    }


    # --------------------------------------------------------
    # AST_REFERANS (20): Adres alma &var => LEA RAX, [RBP-off]
    # --------------------------------------------------------
    eger dugum.tip == 20 ise { # AST_REFERANS
        degisken ref_sag: *AstDugum = dugum.sag;
        eger ref_sag != 0 ise {
            eger ref_sag.tip == AST_KIMLIK ise {
                degisken ref_off: tamsayi = lokal_bul_offset(ref_sag.ilk_jeton.baslangic, ref_sag.ilk_jeton.uzunluk);
                eger ref_off != 0 ise {
                    emit_lea_rax(a, ref_off);
                } yoksa {
                    degisken g_idx: tamsayi = 0 - 1;
                    degisken gi: tamsayi = 0;
                    dongu gi < g_global_sayisi {
                        eger g_global_uzunluk[gi] == ref_sag.ilk_jeton.uzunluk ise {
                            eger bellek_esit_mi(g_global_isim[gi], ref_sag.ilk_jeton.baslangic, ref_sag.ilk_jeton.uzunluk) == 1 ise {
                                g_idx = gi;
                            }
                        }
                        gi = gi + 1;
                    }
                    eger g_idx != 0 - 1 ise {
                        degisken g_addr: tamsayi = g_global_adres[g_idx];
                        byte_yaz(a, 72); byte_yaz(a, 141); byte_yaz(a, 5);
                        int32_yaz(a, g_addr - (a.kullanilan + 4));
                    }
                }
            } yoksa eger ref_sag.tip == AST_ALAN_ERISIMI veya ref_sag.tip == 17 ise {
                degisken ae_parent: *AstDugum = ref_sag.sol;
                degisken ae_field_kim: *AstDugum = ref_sag.sag;
                degisken ae_parent_tip_adi: *u8 = 0;
                degisken ae_parent_tip_len: tamsayi = 0;
                degisken ae_parent_yildiz: tamsayi = 0;
                degisken poff: tamsayi = 0;
                eger ae_parent != 0 ve ae_parent.tip == AST_KIMLIK ise {
                    poff = lokal_bul_offset(ae_parent.ilk_jeton.baslangic, ae_parent.ilk_jeton.uzunluk);
                    eger poff > 0 ise {
                        ae_parent_tip_adi = lokal_bul_tip_adi(ae_parent.ilk_jeton.baslangic, ae_parent.ilk_jeton.uzunluk);
                        ae_parent_tip_len = lokal_bul_tip_uzn(ae_parent.ilk_jeton.baslangic, ae_parent.ilk_jeton.uzunluk);
                        ae_parent_yildiz = lokal_bul_yildiz(ae_parent.ilk_jeton.baslangic, ae_parent.ilk_jeton.uzunluk);
                        eger ae_parent_yildiz == 0 ise {
                            emit_lea_rax(a, poff);
                        } yoksa {
                            emit_load_rax(a, poff);
                        }
                    } yoksa {
                        degisken g_idx2: tamsayi = 0 - 1;
                        degisken gi2: tamsayi = 0;
                        dongu gi2 < g_global_sayisi {
                            eger g_global_uzunluk[gi2] == ae_parent.ilk_jeton.uzunluk ise {
                                eger bellek_esit_mi(g_global_isim[gi2], ae_parent.ilk_jeton.baslangic, ae_parent.ilk_jeton.uzunluk) == 1 ise {
                                    g_idx2 = gi2;
                                }
                            }
                            gi2 = gi2 + 1;
                        }
                        eger g_idx2 != 0 - 1 ise {
                            ae_parent_tip_adi = g_global_tip_adi[g_idx2];
                            ae_parent_tip_len = g_global_tip_adi_uzunluk[g_idx2];
                            ae_parent_yildiz = g_global_is_pointer[g_idx2];
                            degisken g_addr2: tamsayi = g_global_adres[g_idx2];
                            eger ae_parent_yildiz == 0 ise {
                                byte_yaz(a, 0x48); byte_yaz(a, 0x8D); byte_yaz(a, 0x05);
                            } yoksa {
                                byte_yaz(a, 0x48); byte_yaz(a, 0x8B); byte_yaz(a, 0x05);
                            }
                            int32_yaz(a, g_addr2 - (a.kullanilan + 4));
                        } yoksa {
                            ast_kod_uret(a, ae_parent);
                        }
                    }
                } yoksa {
                    ast_kod_uret(a, ae_parent);
                    eger ae_parent != 0 ise {
                        ae_parent_tip_adi = ae_parent.tip_adi;
                        ae_parent_tip_len = ae_parent.tip_adi_uzunluk;
                    }
                }
                dongu ae_parent_tip_adi != 0 ve ae_parent_tip_len > 0 ve (ae_parent_tip_adi[0] == 42 veya ae_parent_tip_adi[0] == 38 veya ae_parent_tip_adi[0] == 63) {
                    ae_parent_tip_adi = ae_parent_tip_adi + 1;
                    ae_parent_tip_len = ae_parent_tip_len - 1;
                }
                degisken ae_field_off: tamsayi = 0 - 1;
                eger ae_parent_tip_adi != 0 ve ae_field_kim != 0 ve ae_field_kim.ilk_jeton != 0 ise {
                    degisken yi: tamsayi = 0;
                    dongu yi < g_yapi_adet ve ae_field_off == (0 - 1) {
                        eger g_yapi_uzunluk[yi] == ae_parent_tip_len ise {
                            eger bellek_esit_mi(g_yapi_isim[yi], ae_parent_tip_adi, ae_parent_tip_len) == 1 ise {
                                degisken ai: tamsayi = 0;
                                dongu ai < g_yapi_alan_sayisi[yi] {
                                    degisken a_idx: tamsayi = (yi * 32) + ai;
                                    eger g_yapi_alan_uzunluk[a_idx] == ae_field_kim.ilk_jeton.uzunluk ise {
                                        eger bellek_esit_mi(g_yapi_alan_isim[a_idx], ae_field_kim.ilk_jeton.baslangic, g_yapi_alan_uzunluk[a_idx]) == 1 ise {
                                            ae_field_off = g_yapi_alan_offset[a_idx];
                                        }
                                    }
                                    ai = ai + 1;
                                }
                            }
                        }
                        yi = yi + 1;
                    }
                }
                eger ae_field_off == (0 - 1) ve ae_field_kim != 0 ve ae_field_kim.ilk_jeton != 0 ise {
                    degisken flen: tamsayi = ae_field_kim.ilk_jeton.uzunluk;
                    degisken fstr: *u8 = ae_field_kim.ilk_jeton.baslangic;
                    eger flen == 7 ve bellek_esit_mi(fstr, "bas_ptr".ptr, 7) == 1 ise { ae_field_off = 0; }
                    yoksa eger flen == 7 ve bellek_esit_mi(fstr, "son_ptr".ptr, 7) == 1 ise { ae_field_off = 8; }
                    yoksa eger flen == 13 ve bellek_esit_mi(fstr, "eleman_sayisi".ptr, 13) == 1 ise { ae_field_off = 16; }
                    yoksa eger flen == 14 ve bellek_esit_mi(fstr, "uretici_sayisi".ptr, 14) == 1 ise { ae_field_off = 24; }
                    yoksa eger flen == 9 ve bellek_esit_mi(fstr, "kapali_mi".ptr, 9) == 1 ise { ae_field_off = 32; }
                    yoksa eger flen == 4 ve bellek_esit_mi(fstr, "veri".ptr, 4) == 1 ise { ae_field_off = 0; }
                    yoksa eger flen == 7 ve bellek_esit_mi(fstr, "sonraki".ptr, 7) == 1 ise { ae_field_off = 8; }
                }
                eger ae_field_off > 0 ise {
                    eger ae_field_off <= 127 ise {
                        byte_yaz(a, 0x48); byte_yaz(a, 0x83); byte_yaz(a, 0xC0);
                        byte_yaz(a, ae_field_off);
                    } yoksa {
                        byte_yaz(a, 0x48); byte_yaz(a, 0x05);
                        int32_yaz(a, ae_field_off);
                    }
                }
            }
        }
        dondu 0;
    }

    # --------------------------------------------------------
    # AST_YAPI_TANIMI (16): Struct tanimi yapilari_topla tarafindan zaten kaydedildi
    # --------------------------------------------------------
    eger dugum.tip == 16 ise { # AST_YAPI_TANIMI
        dondu 0;
    }

    eger dugum.tip == AST_ICE_AKTAR ise {
        dondu 0;
    }

    # --------------------------------------------------------
    # AST_ALAN_ERISIMI (17): obj.field okuma => MOV RAX, [RAX+off]
    # --------------------------------------------------------
    eger dugum.tip == 17 ise { # AST_ALAN_ERISIMI
        degisken ae_obj:   *AstDugum = dugum.sol;
        degisken ae_field: *AstDugum = dugum.sag;
        degisken ae_field_dizi: tamsayi = 0;
        degisken ae_field_elem_sz: tamsayi = 8;
        ast_kod_uret(a, ae_obj); # RAX = nesne pointer'i
        eger ae_field != 0 ve ae_field.ilk_jeton != 0 ise {
            eger ae_field.ilk_jeton.uzunluk == 3 ise {
                degisken ptr_f: *u8 = ae_field.ilk_jeton.baslangic;
                eger ptr_f[0] == 112 ve ptr_f[1] == 116 ve ptr_f[2] == 114 ise {
                    eger ae_obj != 0 ve ae_obj.tip == 3 ise {
                        dondu 0; # .ptr string sabiti icin no-op!
                    }
                }
            }
        }
        expr_struct_type(ae_obj);
        degisken ae_t_adi: *u8 = g_expr_struct_tip_adi;
        degisken ae_t_uzn: tamsayi = g_expr_struct_tip_uzn;
        # Yapi tablosundan alan offset'ini bul
        degisken ae_field_off: tamsayi = 0 - 1;
        eger ae_t_adi != 0 ve ae_t_uzn > 0 ise {
            degisken ae_t_k: tamsayi = 0;
            eger ae_t_adi[0] == 42 ise { # '*'
                ae_t_adi = ae_t_adi + 1;
                ae_t_uzn = ae_t_uzn - 1;
            }
            dongu ae_t_k < ae_t_uzn {
                eger ae_t_adi[ae_t_k] == 60 ise { # '<'
                    ae_t_uzn = ae_t_k;
                }
                ae_t_k = ae_t_k + 1;
            }
        }
        eger ae_field != 0 ve ae_field.ilk_jeton != 0 ise {
            eger ae_t_uzn == 5 ve ae_t_adi != 0 ise {
                eger bellek_esit_mi(ae_t_adi, "Jeton".ptr, 5) == 1 ise {
                    eger ae_field.ilk_jeton.uzunluk == 3 ve bellek_esit_mi(ae_field.ilk_jeton.baslangic, "tip".ptr, 3) == 1 ise { ae_field_off = 0; }
                    eger ae_field.ilk_jeton.uzunluk == 9 ve bellek_esit_mi(ae_field.ilk_jeton.baslangic, "baslangic".ptr, 9) == 1 ise { ae_field_off = 8; }
                    eger ae_field.ilk_jeton.uzunluk == 7 ve bellek_esit_mi(ae_field.ilk_jeton.baslangic, "uzunluk".ptr, 7) == 1 ise { ae_field_off = 16; }
                    eger ae_field.ilk_jeton.uzunluk == 5 ve bellek_esit_mi(ae_field.ilk_jeton.baslangic, "satir".ptr, 5) == 1 ise { ae_field_off = 24; }
                    eger ae_field.ilk_jeton.uzunluk == 5 ve bellek_esit_mi(ae_field.ilk_jeton.baslangic, "sutun".ptr, 5) == 1 ise { ae_field_off = 32; }
                }
            }
            eger ae_field_off == (0 - 1) ve ae_t_adi != 0 ise {
                degisken yi: tamsayi = 0;
                degisken ae_f_bulundu: tamsayi = 0;
                dongu yi < g_yapi_adet {
                    eger g_yapi_uzunluk[yi] == ae_t_uzn ise {
                        eger bellek_esit_mi(g_yapi_isim[yi], ae_t_adi, ae_t_uzn) == 1 ise {
                            degisken ai: tamsayi = 0;
                            dongu ai < g_yapi_alan_sayisi[yi] {
                                degisken a_idx: tamsayi = (yi * 32) + ai;
                                eger g_yapi_alan_uzunluk[a_idx] == ae_field.ilk_jeton.uzunluk ise {
                                    eger bellek_esit_mi(g_yapi_alan_isim[a_idx], ae_field.ilk_jeton.baslangic, g_yapi_alan_uzunluk[a_idx]) == 1 ise {
                                        ae_field_off = g_yapi_alan_offset[a_idx];
