                byte_yaz(a, 0x7E); byte_yaz(a, 0x1B);                                 # JLE .cleanup_avx (+27 bytes)
                byte_yaz(a, 0x4C); byte_yaz(a, 0x8B); byte_yaz(a, 0x02);             # MOV R8, [RDX]
