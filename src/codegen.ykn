            # 3. ykn_simd_vec_add_i64(dst: *tamsayi, a: *tamsayi, b: *tamsayi, n: tamsayi) -> tamsayi
            eger f_uzn == 20 ve bellek_esit_mi(f_isim, "ykn_simd_vec_add_i64".ptr, 20) == 1 ise {
