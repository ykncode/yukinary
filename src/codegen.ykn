                    byte_yaz(a, ae_field_off);
                } yoksa {
                    byte_yaz(a, 0x48); byte_yaz(a, 0x0F); byte_yaz(a, 0xB7); byte_yaz(a, 0x80);
                    int32_yaz(a, ae_field_off);
                }
            } yoksa eger ae_field_elem_sz == 4 ise {
                eger ae_field_off == 0 ise {
                    byte_yaz(a, 0x8B); byte_yaz(a, 0x00);
                } yoksa eger ae_field_off <= 127 ise {
                    byte_yaz(a, 0x8B); byte_yaz(a, 0x40);
                    byte_yaz(a, ae_field_off);
                } yoksa {
                    byte_yaz(a, 0x8B); byte_yaz(a, 0x80);
                    int32_yaz(a, ae_field_off);
                }
            } yoksa {
                eger ae_field_off == 0 ise {
                    byte_yaz(a, 0x48); byte_yaz(a, 0x8B); byte_yaz(a, 0x00);
                } yoksa eger ae_field_off <= 127 ise {
                    byte_yaz(a, 0x48); byte_yaz(a, 0x8B); byte_yaz(a, 0x40);
                    byte_yaz(a, ae_field_off);
                } yoksa {
                    byte_yaz(a, 0x48); byte_yaz(a, 0x8B); byte_yaz(a, 0x80);
                    int32_yaz(a, ae_field_off);
                }
            }
        } yoksa {
            emit_xor_rax_rax(a); # Alan bulunamazsa 0 don
        }
        dondu 0;
    }

    # --------------------------------------------------------
    # AST_EGER (8): if/else => TEST RAX,RAX + JZ + geri yamala
    # --------------------------------------------------------
    eger dugum.tip == 8 ise { # AST_EGER
        degisken eger_jz_pos: tamsayi = emit_conditional_branch_helper(a, dugum.sol);
        # Eger blogu
        degisken if_body: *AstDugum = dugum.govde;
        eger if_body != 0 ise { ast_kod_uret(a, if_body); }
        eger dugum.yoksa_govde != 0 ise {
            # JMP rel32 (else blogu bittikten sonra atlayacak)
            byte_yaz(a, 0xE9);
            degisken eger_jmp_pos: tamsayi = a.kullanilan;
            int32_yaz(a, 0); # Yer tutucu
            # else_label: JZ buraya atlamali
            degisken else_label: tamsayi = a.kullanilan;
            int32_patch(a, eger_jz_pos, else_label - (eger_jz_pos + 4));
            # Yoksa blogu
            ast_kod_uret(a, dugum.yoksa_govde);
            # end_label: JMP buraya atlamali
            degisken eger_end_label: tamsayi = a.kullanilan;
            int32_patch(a, eger_jmp_pos, eger_end_label - (eger_jmp_pos + 4));
        } yoksa {
            # Yoksa yok, sadece JZ'yi bitise yamala
            degisken eger_end_label2: tamsayi = a.kullanilan;
            int32_patch(a, eger_jz_pos, eger_end_label2 - (eger_jz_pos + 4));
        }
        dondu 0;
    }

    # --------------------------------------------------------
    # AST_DONGU (9): while/for loop => TEST + JZ + govde + adim + JMP geri
    # --------------------------------------------------------
    eger dugum.tip == 9 ise { # AST_DONGU
        degisken dongu_baslangic: tamsayi = a.kullanilan;

        # Dongu stack'e baslangici it
        degisken curr_loop_id: tamsayi = g_loop_stack_sp;
        g_loop_stack_bas[curr_loop_id] = dongu_baslangic;
        g_loop_raii_derinlik[curr_loop_id] = g_raii_suanki_derinlik;
        g_loop_stack_sp = g_loop_stack_sp + 1;
        degisken prev_durdur_adet: tamsayi = g_durdur_adet;
        degisken prev_devam_adet: tamsayi = g_devam_adet;

        degisken dongu_jz_pos: tamsayi = 0;
        eger dugum.sol != 0 ise {
            dongu_jz_pos = emit_conditional_branch_helper(a, dugum.sol);
        }
        # Dongu govdesi
        ast_kod_uret(a, dugum.govde);
        # DEVAM_ET (continue) hedefi: varsa adim (yoksa_govde) buradan baslar
        degisken dongu_devam_hedefi: tamsayi = a.kullanilan;
        degisken c_idx: tamsayi = prev_devam_adet;
        dongu c_idx < g_devam_adet {
            degisken cont_ptr: tamsayi = g_devam_yamalar[c_idx];
            int32_patch(a, cont_ptr, dongu_devam_hedefi - (cont_ptr + 4));
            c_idx = c_idx + 1;
        }
        g_devam_adet = prev_devam_adet;
        eger dugum.yoksa_govde != 0 ise {
            ast_kod_uret(a, dugum.yoksa_govde);
        }
        # JMP rel32 (dongu basina don)
        byte_yaz(a, 0xE9);
        degisken dongu_jmp_pos: tamsayi = a.kullanilan;
        degisken dongu_rip_after: tamsayi = dongu_jmp_pos + 4;
        int32_yaz(a, dongu_baslangic - dongu_rip_after);
        # Sart varsa JZ'yi buradaki konuma yamala
        degisken dongu_bitis: tamsayi = a.kullanilan;
        eger dugum.sol != 0 ise {
            int32_patch(a, dongu_jz_pos, dongu_bitis - (dongu_jz_pos + 4));
        }

        # Bu donguye ait DURDUR (break) atlamalarini yamala
        g_loop_stack_sp = g_loop_stack_sp - 1;
        degisken b_idx: tamsayi = prev_durdur_adet;
        dongu b_idx < g_durdur_adet {
            degisken break_ptr: tamsayi = g_durdur_yamalar[b_idx];
            int32_patch(a, break_ptr, dongu_bitis - (break_ptr + 4));
            b_idx = b_idx + 1;
        }
        g_durdur_adet = prev_durdur_adet;

        dondu 0;
    }

    # AST_SORU_ISLEMI (33): ? error propagation (GOREV 3.4)
    # --------------------------------------------------------
    # std/sonuc.ykn Sonuc struct layout:
    #   offset 0:  basarili  (tamsayi, 8 bytes)
    #   offset 8:  deger     (T,       8 bytes)
    #   offset 16: hata_kodu (tamsayi, 8 bytes)
    eger dugum.tip == AST_SORU_ISLEMI ise {
        ast_kod_uret(a, dugum.sol);  # RAX = *Sonuc pointer

        # MOV RCX, RAX  -- struct pointer'i guvende tut
        byte_yaz(a, 0x48); byte_yaz(a, 0x89); byte_yaz(a, 0xC1);

        # MOV RAX, [RCX]  -- basarili (offset 0)
        byte_yaz(a, 0x48); byte_yaz(a, 0x8B); byte_yaz(a, 0x01);

        # TEST RAX, RAX
        byte_yaz(a, 0x48); byte_yaz(a, 0x85); byte_yaz(a, 0xC0);

        # JZ error_label (rel32 placeholder)
        byte_yaz(a, 0x0F); byte_yaz(a, 0x84);
        degisken q_jz_pos: tamsayi = a.kullanilan;
        int32_yaz(a, 0);

        # ---- Basari yolu: MOV RAX, [RCX+8] ----
        byte_yaz(a, 0x48); byte_yaz(a, 0x8B); byte_yaz(a, 0x41); byte_yaz(a, 8);

        # JMP past_error_block (rel32 placeholder — RAII destructors sığabilsin)
        byte_yaz(a, 0xE9);
        degisken q_jmp_pos: tamsayi = a.kullanilan;
        int32_yaz(a, 0);

        # ---- Hata yolu: JZ buraya gelecek ----
        degisken q_err_pos: tamsayi = a.kullanilan;
        int32_patch(a, q_jz_pos, q_err_pos - (q_jz_pos + 4));

        # MOV RAX, [RCX+16]  -- hata_kodu
        byte_yaz(a, 0x48); byte_yaz(a, 0x8B); byte_yaz(a, 0x41); byte_yaz(a, 16);

        # Aktif RAII nesnelerinin birak fonksiyonlarini LIFO sirasinda cagir
        raii_fonksiyon_donus_emit(a);

        # JMP fonksiyon epilog (rel32 yamama ile -- g_yama tip=99)
        byte_yaz(a, 0xE9);
        degisken q_epilog_jmp: tamsayi = a.kullanilan;
        int32_yaz(a, 0);  # epilog yamasi

        # ---- past_error_block: basari yolunun JMP hedefi ----
        degisken q_past_pos: tamsayi = a.kullanilan;
        int32_patch(a, q_jmp_pos, q_past_pos - (q_jmp_pos + 4));

        # Epilog yamasi icin g_yama listesine ekle (tip 99)
        eger yama_kapasite_kontrol() == 0 ise { dondu 0; }
        degisken y_idx: tamsayi = g_yama_adet;
        g_yama_adres[y_idx] = q_epilog_jmp;
        g_yama_tip[y_idx] = 99;
        g_yama_adet = g_yama_adet + 1;
        dondu 0;
    }

    # AST_DURDUR (14): break
    # --------------------------------------------------------
    eger dugum.tip == 14 ise {
        eger g_loop_stack_sp > 0 ise {
            degisken hedef_d: tamsayi = g_loop_raii_derinlik[g_loop_stack_sp - 1];
            raii_unwind_to_derinlik(a, hedef_d);
        }
        byte_yaz(a, 0xE9);
        degisken d_idx: tamsayi = g_durdur_adet;
        eger d_idx < 128 ise {
            g_durdur_yamalar[d_idx] = a.kullanilan;
            g_durdur_adet = d_idx + 1;
        }
        int32_yaz(a, 0); # Placeholder, to be patched
        dondu 0;
    }

    # AST_DEVAM_ET (15): continue
    # --------------------------------------------------------
    eger dugum.tip == 15 ise {
        eger g_loop_stack_sp > 0 ise {
            degisken hedef_d: tamsayi = g_loop_raii_derinlik[g_loop_stack_sp - 1];
            raii_unwind_to_derinlik(a, hedef_d);
        }
        byte_yaz(a, 0xE9);
        degisken c_idx2: tamsayi = g_devam_adet;
        eger c_idx2 < 128 ise {
            g_devam_yamalar[c_idx2] = a.kullanilan;
            g_devam_adet = c_idx2 + 1;
        }
        int32_yaz(a, 0); # Placeholder, to be patched to dongu_devam_hedefi
        dondu 0;
    }

    # --------------------------------------------------------
    # AST_GENERIC_TANIM (24): Monomorphization sonrasi bu dugum codegen'e
    # ulasmamali. Sessiz no-op yerine derleme fail-closed olur.
    # --------------------------------------------------------
    eger dugum.tip == AST_GENERIC_TANIM ise {
        codegen_unsupported_ast_reddet(dugum);
        dondu 0;
    }
    # AST_MAKRO_TANIMI (22): Makro tanimlari makro asamasinda islendi;
    # burada kod uretmez fakat bu durum olculur.
    eger dugum.tip == AST_MAKRO_TANIMI ise {
        g_codegen_compiletime_noop_sayisi = g_codegen_compiletime_noop_sayisi + 1;
        eger dugum.sonraki != 0 ise { ast_kod_uret(a, dugum.sonraki); }
        dondu 0;
    }

    # --------------------------------------------------------
    # AST_MAKRO_CAGRISI (23): Makro cagrisi makrolari_genislet
    # asamasinda genisletildi. Codegen'e ulasirsa genisletilmis
    # govdeyi emit et.
    # --------------------------------------------------------
    eger dugum.tip == 23 ise {
        eger dugum.govde != 0 ise {
            ast_kod_uret(a, dugum.govde);
        } yoksa eger dugum.sol != 0 ise {
            ast_kod_uret(a, dugum.sol);
        }
        eger dugum.sonraki != 0 ise { ast_kod_uret(a, dugum.sonraki); }
        dondu 0;
    }


    # --------------------------------------------------------
    # AST_TRAIT_TANIM (25): Trait tanimlari codegen'de no-op,
    # dispatch monomorphization asamasinda yapilir.
    # --------------------------------------------------------
    eger dugum.tip == AST_TRAIT_TANIM ise {
        g_codegen_compiletime_noop_sayisi = g_codegen_compiletime_noop_sayisi + 1;
        eger dugum.sonraki != 0 ise { ast_kod_uret(a, dugum.sonraki); }
        dondu 0;
    }

    # --------------------------------------------------------
    # AST_TRAIT_UYGULAMA (40): Trait uygulamasi kaydi, compile-time no-op.
    # AST_MANTIK (26) ile ayni kimligi kullanamaz; boolean literal'lar
    # executable codegen'e gercek deger olarak ulasir.
    # --------------------------------------------------------
    eger dugum.tip == AST_TRAIT_UYGULAMA ise {
        g_codegen_compiletime_noop_sayisi = g_codegen_compiletime_noop_sayisi + 1;
        eger dugum.sonraki != 0 ise { ast_kod_uret(a, dugum.sonraki); }
        dondu 0;
    }

    # --------------------------------------------------------
    # AST_DIREKTIF_C_LIB (29): #c-lib "libadi"
    # Kod uretmez; kutuphanenin bagli kutuphaneler listesine
    # kaydeder. PE/ELF yazicisi bu listeyi kullanabilir.
    # --------------------------------------------------------
    eger dugum.tip == 29 veya dugum.tip == 30 veya dugum.tip == 32 veya
         dugum.tip == AST_DIREKTIF_C_LIB veya dugum.tip == AST_DIREKTIF_CPP_LIB veya
         dugum.tip == AST_DIREKTIF_RS_LIB ise {
        eger dugum.ilk_jeton != 0 ise {
            eger g_clib_adet >= G_CLIB_KAPASITE ise {
                codegen_kapasite_reddet(6);
                dondu 0;
            }
            degisken lib_ptr: *u8 = dugum.ilk_jeton.baslangic;
            degisken lib_uzn: tamsayi = dugum.ilk_jeton.uzunluk;
            # Tirnakları ayıkla: "libadi" -> libadi
            eger lib_uzn >= 2 ve lib_ptr[0] == 34 ise {
                lib_ptr = lib_ptr + 1;
                lib_uzn = lib_uzn - 2;
            }
            degisken win32_lib: tamsayi = 0;
            eger lib_uzn == 8 ve bellek_esit_mi(lib_ptr, "kernel32".ptr, 8) == 1 ise { win32_lib = 1; }
            yoksa eger lib_uzn == 6 ve bellek_esit_mi(lib_ptr, "user32".ptr, 6) == 1 ise { win32_lib = 1; }
            yoksa eger lib_uzn == 8 ve bellek_esit_mi(lib_ptr, "advapi32".ptr, 8) == 1 ise { win32_lib = 1; }
            yoksa eger lib_uzn == 6 ve bellek_esit_mi(lib_ptr, "ws2_32".ptr, 6) == 1 ise { win32_lib = 1; }

            eger g_target_platform != 0 ve win32_lib == 1 ise {
                # Windows sistem kutuphanesi Linux/macOS hedefinde yoksayilir
            } yoksa {
                g_clib_isim[g_clib_adet] = lib_ptr;
                g_clib_uzunluk[g_clib_adet] = lib_uzn;
                g_clib_adet = g_clib_adet + 1;
            }
        }
        eger dugum.sonraki != 0 ise { ast_kod_uret(a, dugum.sonraki); }
        dondu 0;
    }

    # --------------------------------------------------------
    # AST_SONUC_TANIM (34): sonuc<T>/Sonuc<T,E> tip anotasyonu.
    # Bu dugum tip denetleyici tarafindan uretilir; codegen'e
    # ulasmamali, ancak ulasirsa no-op olarak gec.
    # --------------------------------------------------------
    eger dugum.tip == AST_SONUC_TANIM veya dugum.tip == AST_TIP_ALIAS veya
       dugum.tip == AST_ENUM_TANIMI veya dugum.tip == AST_DIREKTIF_CONFIG veya
       dugum.tip == AST_DIREKTIF_CONVERT veya dugum.tip == AST_DIREKTIF_PY_LIB veya
       dugum.tip == AST_DIREKTIF_PROMPT veya dugum.tip == AST_DIREKTIF_AI veya
       dugum.tip == 31 veya dugum.tip == 38 veya dugum.tip == 44 ise {
        g_codegen_compiletime_noop_sayisi = g_codegen_compiletime_noop_sayisi + 1;
        eger dugum.sonraki != 0 ise { ast_kod_uret(a, dugum.sonraki); }
        dondu 0;
    }

    # AST_MANTIK (26): true/false literal'i RAX'ta 1/0 olarak uretilir.
    # Parser dizi_boyutu alanina canonical boolean degerini yerlestirir.
    # --------------------------------------------------------
    eger dugum.tip == AST_MANTIK ise {
        emit_mov_rax_imm32(a, dugum.dizi_boyutu);
        dondu 0;
    }

    # AST_AWAIT (42): Await ifadesi Future nesnesini unwrap eder.
    # --------------------------------------------------------
    eger dugum.tip == AST_AWAIT veya dugum.tip == 42 ise {
        eger dugum.sag != 0 ise {
            ast_kod_uret(a, dugum.sag);
        } yoksa {
            emit_xor_rax_rax(a);
        }
        emit_async_await_unwrap(a);
        dondu 0;
    }

    # Bilinmeyen AST tag'leri asla varsayilan no-op/fallback olamaz.
    # Bu, parser/typechecker sonrasinda bozulmus veya yeni eklenmis ama
    # codegen'i olmayan bir dugumun sahte artifact uretmesini engeller.
    codegen_unsupported_ast_reddet(dugum);
    dondu 0;
} # ast_kod_uret sonu

isv yknllm_audit_native_append_codegen(a: *MakineKoduArenasi, dugum: *AstDugum) {
    degisken arg: *AstDugum = dugum.sag;
    ast_kod_uret(a, arg);
    byte_yaz(a, 0x49); byte_yaz(a, 0x89); byte_yaz(a, 0xC7); # R15=path
    eger arg != 0 ise { arg = arg.sonraki; }
    ast_kod_uret(a, arg);
    byte_yaz(a, 0x49); byte_yaz(a, 0x89); byte_yaz(a, 0xC6); # R14=buffer
    eger arg != 0 ise { arg = arg.sonraki; }
    ast_kod_uret(a, arg);
    byte_yaz(a, 0x49); byte_yaz(a, 0x89); byte_yaz(a, 0xC5); # R13=size
    yknllm_audit_native_append_emit(a);
}

# ============================================================
# Cikti ve Hedef Format Ureticileri
# ============================================================
ice_aktar "codegen/output_pe.ykn";
ice_aktar "codegen/output_elf.ykn";
ice_aktar "codegen/output_macho.ykn";

