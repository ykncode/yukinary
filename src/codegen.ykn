    eger (uzn == 24 ve bellek_esit_mi(isim, "yukinary_sys_socket_send".ptr, 24) == 1) veya
         (uzn == 24 ve bellek_esit_mi(isim, "yukinary_sys_socket_recv".ptr, 24) == 1) ise {
