        byte_yaz(a, 0x48); byte_yaz(a, 0xC7); byte_yaz(a, 0x44); byte_yaz(a, 0x24); byte_yaz(a, 0x28); int32_yaz(a, 1);
        byte_yaz(a, 0x48); byte_yaz(a, 0xC7); byte_yaz(a, 0xC2); int32_yaz(a, 0xFFFF);
        byte_yaz(a, 0x41); byte_yaz(a, 0xB8); int32_yaz(a, 4);
        byte_yaz(a, 0x4C); byte_yaz(a, 0x8D); byte_yaz(a, 0x4C); byte_yaz(a, 0x24); byte_yaz(a, 0x28);
        windows_iat_cagri(a, 27); byte_yaz(a, 0x48); byte_yaz(a, 0x63); byte_yaz(a, 0xC0); emit_add_rsp(a, 48); dondu 1;
    }
    eger uzn == 31 ve bellek_esit_mi(isim, "yukinary_sys_socket_set_timeout".ptr, 31) == 1 ise {
        eger arg_sayisi != 2 ise { dondu 0; }
        # setsockopt(SOL_SOCKET, SO_RCVTIMEO/SO_SNDTIMEO) Windows ABI.
        # millis'in düşük DWORD'ü timeval değil, Winsock'un DWORD timeout
        # sözleşmesine göre doğrudan option value olarak yazılır.
        emit_sub_rsp(a, 64);
        byte_yaz(a, 0x48); byte_yaz(a, 0x89); byte_yaz(a, 0x4C); byte_yaz(a, 0x24); byte_yaz(a, 48);
        byte_yaz(a, 0x89); byte_yaz(a, 0x54); byte_yaz(a, 0x24); byte_yaz(a, 40);
        byte_yaz(a, 0x48); byte_yaz(a, 0xC7); byte_yaz(a, 0x44); byte_yaz(a, 0x24); byte_yaz(a, 32); int32_yaz(a, 4);
        byte_yaz(a, 0x48); byte_yaz(a, 0x8B); byte_yaz(a, 0x4C); byte_yaz(a, 0x24); byte_yaz(a, 48);
        byte_yaz(a, 0x48); byte_yaz(a, 0xC7); byte_yaz(a, 0xC2); int32_yaz(a, 0xFFFF);
        byte_yaz(a, 0x41); byte_yaz(a, 0xB8); int32_yaz(a, 0x1006);
        byte_yaz(a, 0x4C); byte_yaz(a, 0x8D); byte_yaz(a, 0x4C); byte_yaz(a, 0x24); byte_yaz(a, 40);
        windows_iat_cagri(a, 27);
        byte_yaz(a, 0x48); byte_yaz(a, 0x63); byte_yaz(a, 0xC0);
        byte_yaz(a, 0x49); byte_yaz(a, 0x89); byte_yaz(a, 0xC2);
        byte_yaz(a, 0x48); byte_yaz(a, 0x8B); byte_yaz(a, 0x4C); byte_yaz(a, 0x24); byte_yaz(a, 48);
        byte_yaz(a, 0x48); byte_yaz(a, 0xC7); byte_yaz(a, 0xC2); int32_yaz(a, 0xFFFF);
        byte_yaz(a, 0x41); byte_yaz(a, 0xB8); int32_yaz(a, 0x1005);
        byte_yaz(a, 0x4C); byte_yaz(a, 0x8D); byte_yaz(a, 0x4C); byte_yaz(a, 0x24); byte_yaz(a, 40);
        windows_iat_cagri(a, 27);
        byte_yaz(a, 0x48); byte_yaz(a, 0x63); byte_yaz(a, 0xC0);
        byte_yaz(a, 0x4C); byte_yaz(a, 0x09); byte_yaz(a, 0xD0);
        emit_add_rsp(a, 64); dondu 1;
    }
    eger uzn == 35 ve bellek_esit_mi(isim, "yukinary_sys_socket_set_nonblocking".ptr, 35) == 1 ise {
        eger arg_sayisi != 1 ise { dondu 0; }
        # ioctlsocket(socket, FIONBIO, &mode), mode=1.
        emit_sub_rsp(a, 48);
        byte_yaz(a, 0x48); byte_yaz(a, 0xC7); byte_yaz(a, 0x44); byte_yaz(a, 0x24); byte_yaz(a, 40); int32_yaz(a, 1);
        byte_yaz(a, 0xC7); byte_yaz(a, 0xC2); int32_yaz(a, 0x8004667E);
        byte_yaz(a, 0x4C); byte_yaz(a, 0x8D); byte_yaz(a, 0x44); byte_yaz(a, 0x24); byte_yaz(a, 40);
        windows_iat_cagri(a, 28);
        byte_yaz(a, 0x48); byte_yaz(a, 0x63); byte_yaz(a, 0xC0);
        emit_add_rsp(a, 48); dondu 1;
    }
    eger uzn == 24 ve bellek_esit_mi(isim, "yukinary_sys_dns_resolve".ptr, 24) == 1 ise {
        # Legacy external resolver ABI: generated dns_coz() never reaches
        # this branch; direct callers fail closed instead of using a host shim.
        emit_mov_rax_imm32(a, 0 - 1); dondu 1;
    }
    # POSIX stubs on Windows (fail closed so linker does not fail)
    eger (uzn == 4 ve (bellek_esit_mi(isim, "pipe".ptr, 4) == 1 veya bellek_esit_mi(isim, "fork".ptr, 4) == 1 veya bellek_esit_mi(isim, "dup2".ptr, 4) == 1 veya bellek_esit_mi(isim, "read".ptr, 4) == 1)) veya
         (uzn == 5 ve (bellek_esit_mi(isim, "close".ptr, 5) == 1 veya bellek_esit_mi(isim, "write".ptr, 5) == 1 veya bellek_esit_mi(isim, "_exit".ptr, 5) == 1)) veya
         (uzn == 6 ve bellek_esit_mi(isim, "execve".ptr, 6) == 1) veya
         (uzn == 7 ve bellek_esit_mi(isim, "waitpid".ptr, 7) == 1) ise {
        emit_mov_rax_imm32(a, 0 - 1); dondu 1;
    }
    dondu 0;
}

isv lokal_tablo_sifirla() {
    g_lokal_adet = 0;
    g_lokal_stack_offset = 0;
}

isv lokal_bul_offset(isim: *u8, uzn: tamsayi) -> tamsayi {
    eger isim == 0 veya uzn <= 0 ise {
        dondu 0;
    }
    degisken taban: tamsayi = 0;
    eger g_lambda_tabani > 0 ise { taban = g_lambda_tabani; }
    degisken i: tamsayi = g_lokal_adet;
    dongu i > taban {
        i = i - 1;
        eger g_lokal_uzunluklari[i] == uzn ise {
            eger bellek_esit_mi(g_lokal_isimleri[i], isim, uzn) == 1 ise {
                dondu g_lokal_offsetleri[i];
            }
        }
    }
    dondu 0;
}

isv lokal_bul_outer_offset(isim: *u8, uzn: tamsayi) -> tamsayi {
    eger g_lambda_tabani <= 0 veya isim == 0 veya uzn <= 0 ise {
        dondu 0;
    }
    degisken i: tamsayi = g_lambda_tabani;
    dongu i > 0 {
        i = i - 1;
        eger g_lokal_uzunluklari[i] == uzn ise {
            eger bellek_esit_mi(g_lokal_isimleri[i], isim, uzn) == 1 ise {
                dondu g_lokal_offsetleri[i];
            }
        }
    }
    dondu 0;
}

isv lokal_bul_yildiz(isim: *u8, uzn: tamsayi) -> tamsayi {
    eger isim == 0 veya uzn <= 0 ise { dondu 0; }
    degisken taban: tamsayi = 0;
    eger g_lambda_tabani > 0 ise { taban = g_lambda_tabani; }
    degisken i: tamsayi = g_lokal_adet;
    dongu i > taban {
        i = i - 1;
        eger g_lokal_isimleri[i] != 0 ve g_lokal_uzunluklari[i] == uzn ise {
            eger bellek_esit_mi(g_lokal_isimleri[i], isim, uzn) == 1 ise {
                dondu g_lokal_yildizlari[i];
            }
        }
    }
    dondu 0;
}

isv lokal_bul_dizi(isim: *u8, uzn: tamsayi) -> tamsayi {
    eger isim == 0 veya uzn <= 0 ise { dondu 0; }
    degisken taban: tamsayi = 0;
    eger g_lambda_tabani > 0 ise { taban = g_lambda_tabani; }
    degisken i: tamsayi = g_lokal_adet;
    dongu i > taban {
        i = i - 1;
        eger g_lokal_isimleri[i] != 0 ve g_lokal_uzunluklari[i] == uzn ise {
            eger bellek_esit_mi(g_lokal_isimleri[i], isim, uzn) == 1 ise {
                dondu g_lokal_dizi_boyutlari[i];
            }
        }
    }
    dondu 0;
}

isv lokal_bul_tip_uzn(isim: *u8, uzn: tamsayi) -> tamsayi {
    eger isim == 0 veya uzn <= 0 ise { dondu 0; }
    degisken taban: tamsayi = 0;
    eger g_lambda_tabani > 0 ise { taban = g_lambda_tabani; }
    degisken i: tamsayi = g_lokal_adet;
    dongu i > taban {
        i = i - 1;
        eger g_lokal_isimleri[i] != 0 ve g_lokal_uzunluklari[i] == uzn ise {
            eger bellek_esit_mi(g_lokal_isimleri[i], isim, uzn) == 1 ise {
                dondu g_lokal_tip_uzunluklari[i];
            }
        }
    }
    dondu 0;
}

isv lokal_bul_tip_adi(isim: *u8, uzn: tamsayi) -> *u8 {
    eger isim == 0 veya uzn <= 0 ise { dondu 0; }
    degisken taban: tamsayi = 0;
    eger g_lambda_tabani > 0 ise { taban = g_lambda_tabani; }
    degisken i: tamsayi = g_lokal_adet;
    dongu i > taban {
        i = i - 1;
        eger g_lokal_isimleri[i] != 0 ve g_lokal_uzunluklari[i] == uzn ise {
            eger bellek_esit_mi(g_lokal_isimleri[i], isim, uzn) == 1 ise {
                dondu g_lokal_tip_adlari[i];
            }
        }
    }
    dondu 0;
}

isv lokal_bul_idx(isim: *u8, uzn: tamsayi) -> tamsayi {
    eger isim == 0 veya uzn <= 0 ise { dondu 0 - 1; }
    degisken taban: tamsayi = 0;
    eger g_lambda_tabani > 0 ise { taban = g_lambda_tabani; }
    degisken i: tamsayi = g_lokal_adet;
    dongu i > taban {
        i = i - 1;
        eger g_lokal_isimleri[i] != 0 ve g_lokal_uzunluklari[i] == uzn ise {
            eger bellek_esit_mi(g_lokal_isimleri[i], isim, uzn) == 1 ise {
                dondu i;
            }
        }
    }
    dondu 0 - 1;
}


# u8 pointer (*u8, yildiz=1) veya [N]u8 array â†’ byte erisim (scale 1)
# **u8, *Jeton vb â†’ pointer erisim (scale 8)
isv subscript_byte_mi(isim: *u8, uzn: tamsayi, dizi_boyutu: tamsayi) -> tamsayi {
    degisken tip_adi: *u8 = lokal_bul_tip_adi(isim, uzn);
    eger tip_adi == 0 ise { dondu 0; }
    degisken tip_uzn: tamsayi = lokal_bul_tip_uzn(isim, uzn);
    eger tip_uzn != 2 ise { dondu 0; }
    eger tip_adi[0] != 117 ise { dondu 0; } # 'u'
    eger tip_adi[1] != 56 ise { dondu 0; }  # '8'
    # tip_adi == "u8": byte element if pointer depth == 1 OR stack array
    degisken yildiz: tamsayi = lokal_bul_yildiz(isim, uzn);
    eger yildiz == 1 ise { dondu 1; }
    eger dizi_boyutu > 0 ise { dondu 1; }
    dondu 0;
}

# u8 pointer (*u8, yildiz=1) veya [N]u8 array â†’ byte erisim (scale 1)
isv subscript_byte_mi_ast(arr_node: *AstDugum) -> tamsayi {
    # Check local table by identifier name
    eger arr_node.ilk_jeton != 0 ise {
        degisken tip_adi: *u8 = lokal_bul_tip_adi(arr_node.ilk_jeton.baslangic, arr_node.ilk_jeton.uzunluk);
        eger tip_adi != 0 ise {
            degisken tip_uzn: tamsayi = lokal_bul_tip_uzn(arr_node.ilk_jeton.baslangic, arr_node.ilk_jeton.uzunluk);
            eger tip_uzn == 2 ise {
                eger tip_adi[0] == 117 ise {
                    eger tip_adi[1] == 56 ise {
                        degisken yildiz: tamsayi = lokal_bul_yildiz(arr_node.ilk_jeton.baslangic, arr_node.ilk_jeton.uzunluk);
                        eger yildiz == 1 ise { dondu 1; }
                    }
                }
            }
        }
    }
    # Check arr_node.tip_adi (typechecker/parser-set type annotation)
    # Sadece *u8 (yildiz=1) veya [N]u8 (dizi_boyutu>0) icin byte erisimi
    eger arr_node.tip_adi != 0 ise {
        eger arr_node.tip_adi_uzunluk == 2 ise {
            eger arr_node.tip_adi[0] == 117 ise {
                eger arr_node.tip_adi[1] == 56 ise {
                    degisken ny: tamsayi = arr_node.cozumlenmis_tip;
                    degisken nd: tamsayi = arr_node.dizi_boyutu;
                    eger ny == 1 ise { dondu 1; }
                    eger nd > 0 ise { dondu 1; }
                }
            }
        }
    }
    dondu 0;
}

isv lokal_kaydet(isim: *u8, uzn: tamsayi, dizi_boyutu: tamsayi, tip_adi: *u8, tip_uzn: tamsayi, yildiz: tamsayi) -> tamsayi {
    eger g_lokal_adet >= 16384 ise {
        codegen_kapasite_reddet(1);
        dondu 0;
    }
    degisken e_sz: tamsayi = tip_eleman_boyutu_al(tip_adi, tip_uzn, yildiz);
    eger tip_uzn > 4 ve bellek_esit_mi(tip_adi, "dyn ".ptr, 4) == 1 ise { e_sz = 16; }
    eger dizi_boyutu > 0 ise {
        degisken d_bytes: tamsayi = dizi_boyutu * e_sz;
        d_bytes = ((d_bytes + 7) / 8) * 8;
        g_lokal_stack_offset = g_lokal_stack_offset + d_bytes;
    } yoksa eger yildiz == 0 ve tip_adi != 0 ve tip_uzn > 0 ise {
        degisken byt: tamsayi = e_sz;
        byt = ((byt + 7) / 8) * 8;
        g_lokal_stack_offset = g_lokal_stack_offset + byt;
    } yoksa {
        g_lokal_stack_offset = g_lokal_stack_offset + 8;
    }
    degisken idx: tamsayi = g_lokal_adet;
    g_lokal_isimleri[idx] = isim;
    g_lokal_uzunluklari[idx] = uzn;
    g_lokal_offsetleri[idx] = g_lokal_stack_offset;
    g_lokal_tip_adlari[idx] = tip_adi;
    g_lokal_tip_uzunluklari[idx] = tip_uzn;
    g_lokal_yildizlari[idx] = yildiz;
    g_lokal_dizi_boyutlari[idx] = dizi_boyutu;
    g_lokal_adet = g_lokal_adet + 1;
    dondu g_lokal_stack_offset;
}

isv yapilari_topla(kok: *AstDugum) {
    degisken iter: *AstDugum = kok;
    dongu iter != 0 {
        eger iter.tip == 16 ise { # AST_YAPI_TANIMI
            degisken zaten_var: tamsayi = 0;
            degisken yi: tamsayi = 0;
            dongu yi < g_yapi_adet {
                eger g_yapi_uzunluk[yi] == iter.ilk_jeton.uzunluk ise {
                    eger bellek_esit_mi(g_yapi_isim[yi], iter.ilk_jeton.baslangic, iter.ilk_jeton.uzunluk) == 1 ise {
                        zaten_var = 1;
                    }
                }
                yi = yi + 1;
            }
            eger zaten_var == 0 ise {
                eger g_yapi_adet >= YAPI_TABLO_KAPASITESI ise {
                    g_yapi_kapasite_hatasi = 1;
                    codegen_kapasite_reddet(3);
                    dondu;
                }
                degisken yp_idx: tamsayi = g_yapi_adet;
                g_yapi_isim[yp_idx]       = iter.ilk_jeton.baslangic;
                g_yapi_uzunluk[yp_idx]    = iter.ilk_jeton.uzunluk;
                g_yapi_alan_sayisi[yp_idx] = 0;
                degisken yp_alan: *AstDugum = iter.sol;
                degisken yp_off: tamsayi = 0;
                dongu yp_alan != 0 {
                    degisken ai: tamsayi = g_yapi_alan_sayisi[yp_idx];
                    eger ai >= YAPI_ALAN_STRIDE veya (yp_idx * YAPI_ALAN_STRIDE) + ai >= YAPI_ALAN_KAPASITESI ise {
                        codegen_kapasite_reddet(7);
                        dondu;
                    }
                    degisken a_idx: tamsayi = (yp_idx * YAPI_ALAN_STRIDE) + ai;
                    degisken f_elem_sz: tamsayi = tip_eleman_boyutu_al(yp_alan.tip_adi, yp_alan.tip_adi_uzunluk, yp_alan.cozumlenmis_tip);
                    degisken f_boyut: tamsayi = f_elem_sz;
                    eger yp_alan.dizi_boyutu > 0 ise {
                        f_boyut = yp_alan.dizi_boyutu * f_elem_sz;
                    }
                    degisken f_align: tamsayi = f_elem_sz;
                    eger f_align > 8 ise { f_align = 8; }
                    eger f_align > 1 ise {
                        yp_off = ((yp_off + (f_align - 1)) / f_align) * f_align;
                    }
                    g_yapi_alan_isim[a_idx]          = yp_alan.ilk_jeton.baslangic;
                    g_yapi_alan_uzunluk[a_idx]       = yp_alan.ilk_jeton.uzunluk;
                    g_yapi_alan_offset[a_idx]        = yp_off;
                    g_yapi_alan_tip_adi[a_idx]       = yp_alan.tip_adi;
                    g_yapi_alan_tip_uzn[a_idx]       = yp_alan.tip_adi_uzunluk;
                    g_yapi_alan_yildiz[a_idx]        = yp_alan.cozumlenmis_tip;
                    g_yapi_alan_nullable[a_idx]      = yp_alan.nullable;
                    g_yapi_alan_dizi[a_idx]          = yp_alan.dizi_boyutu;
                    g_yapi_alan_sayisi[yp_idx] = ai + 1;
                    yp_off = yp_off + f_boyut;
                    yp_alan = yp_alan.sonraki;
                }
                yp_off = ((yp_off + 7) / 8) * 8;
                g_yapi_adet = yp_idx + 1;
                g_yapi_byte_boyutu[yp_idx] = yp_off;
            }
        }
        iter = iter.sonraki;
    }
}

isv global_sabit_ekle(isim: *u8, uzunluk: tamsayi, deger: tamsayi) {
    degisken yeni: *GlobalSabitDugum = compiler_tahsis_et(32);
    yeni.isim = isim;
    yeni.uzunluk = uzunluk;
    yeni.deger = deger;
    yeni.sonraki = 0;
    eger g_global_sabit_bas == 0 ise { g_global_sabit_bas = yeni; }
    yoksa { g_global_sabit_son.sonraki = yeni; }
    g_global_sabit_son = yeni;
}

isv global_sabit_bul(isim: *u8, uzunluk: tamsayi) -> tamsayi {
    degisken s: *GlobalSabitDugum = g_global_sabit_bas;
    dongu s != 0 {
        eger s.uzunluk == uzunluk ise {
            eger bellek_esit_mi(s.isim, isim, uzunluk) == 1 ise {
                g_sabit_bulundu = 1;
                dondu s.deger;
            }
        }
        s = s.sonraki;
    }
    g_sabit_bulundu = 0;
    dondu 0;
}


isv global_deklarasyonlarini_topla_ic(kok: *AstDugum) {
    degisken iter: *AstDugum = kok;
    dongu iter != 0 {
        eger iter.tip == AST_DEGISKEN_TANIMI ise {
            eger g_global_ast_sayisi >= 16384 ise {
                codegen_kapasite_reddet(8);
                dondu;
            }
            g_global_ast[g_global_ast_sayisi] = iter;
            g_global_ast_sayisi = g_global_ast_sayisi + 1;
        }
        eger iter.tip == AST_MODUL ve iter.govde != 0 ise {
            global_deklarasyonlarini_topla_ic(iter.govde.sol);
        }
        iter = iter.sonraki;
    }
}

isv global_deklarasyonlarini_topla(kok: *AstDugum) {
    global_deklarasyonlarini_topla_ic(kok);
    # Preserve parser/import traversal order; each compiler stage must lay out
    # globals using the same AST traversal it later resolves during codegen.
}

isv global_storage_kaydi_ekle(a: *MakineKoduArenasi, isim: *u8, uzn: tamsayi, boyut: tamsayi, dizi: tamsayi) {
    degisken mevcut: tamsayi = 0;
    degisken i: tamsayi = 0;
    dongu i < g_global_sayisi {
        eger g_global_uzunluk[i] == uzn ve bellek_esit_mi(g_global_isim[i], isim, uzn) == 1 ise { mevcut = 1; }
        i = i + 1;
    }
    eger mevcut == 0 ise {
        byte_yaz(a, 233);
        int32_yaz(a, boyut);
        degisken adres: tamsayi = a.kullanilan;
        a.kullanilan = a.kullanilan + boyut;
        eger g_global_sayisi < 16384 ise {
            g_global_isim[g_global_sayisi] = isim;
            g_global_uzunluk[g_global_sayisi] = uzn;
            g_global_adres[g_global_sayisi] = adres;
            g_global_tip_adi[g_global_sayisi] = 0;
            g_global_tip_adi_uzunluk[g_global_sayisi] = 0;
            g_global_is_pointer[g_global_sayisi] = 0;
            g_global_dizi_boyutu[g_global_sayisi] = dizi;
            g_global_sayisi = g_global_sayisi + 1;
        }
    }
}

isv global_deklarasyonlarini_uret(a: *MakineKoduArenasi) {
    # Import AST'si module wrapper'larini her zaman korumadigindan, source
    # codegen'in kendi gercek state global'leri burada adlariyla kaydedilir.
    global_storage_kaydi_ekle(a, "g_verbose".ptr, 9, 8, 0);
    global_storage_kaydi_ekle(a, "g_lokal_adet".ptr, 12, 8, 0);
    global_storage_kaydi_ekle(a, "g_lokal_stack_offset".ptr, 20, 8, 0);
    global_storage_kaydi_ekle(a, "g_lokal_isimleri".ptr, 16, 131072, 16384);
    global_storage_kaydi_ekle(a, "g_lokal_uzunluklari".ptr, 19, 131072, 16384);
    global_storage_kaydi_ekle(a, "g_lokal_offsetleri".ptr, 17, 131072, 16384);
    global_storage_kaydi_ekle(a, "g_lokal_tip_adlari".ptr, 18, 131072, 16384);
    global_storage_kaydi_ekle(a, "g_lokal_tip_uzunluklari".ptr, 23, 131072, 16384);
    global_storage_kaydi_ekle(a, "g_lokal_yildizlari".ptr, 18, 131072, 16384);
    global_storage_kaydi_ekle(a, "g_lokal_dizi_boyutlari".ptr, 22, 131072, 16384);
    degisken i: tamsayi = 0;
    dongu i < g_global_ast_sayisi {
        degisken dugum: *AstDugum = g_global_ast[i];
        eger dugum != 0 ve dugum.tip == AST_DEGISKEN_TANIMI ise {
            degisken isim: *u8 = 0;
            degisken uzn: tamsayi = 0;
            eger dugum.ilk_jeton != 0 ise {
                isim = dugum.ilk_jeton.baslangic;
                uzn = dugum.ilk_jeton.uzunluk;
            }
            degisken gval: tamsayi = 0;
            degisken gval_bulundu: tamsayi = 0;
            eger dugum.sag != 0 ve dugum.sag.tip == AST_SAYI ise {
                gval = string_tamsayiya(dugum.sag.ilk_jeton.baslangic, dugum.sag.ilk_jeton.uzunluk);
                gval_bulundu = 1;
            }

            eger gval_bulundu == 1 ise { global_sabit_ekle(isim, uzn, gval); }
            degisken e_sz: tamsayi = tip_eleman_boyutu_al(dugum.tip_adi, dugum.tip_adi_uzunluk, dugum.cozumlenmis_tip);
            degisken boyut: tamsayi = e_sz;
            eger dugum.dizi_boyutu > 0 ise {
                degisken d_cnt: tamsayi = dugum.dizi_boyutu;
                eger d_cnt > 1048576 ise { d_cnt = 1048576; }
                boyut = d_cnt * e_sz;
            }
            boyut = ((boyut + 7) / 8) * 8;
            eger boyut < 8 ise { boyut = 8; }
            byte_yaz(a, 233);
            int32_yaz(a, boyut);
            degisken adres: tamsayi = a.kullanilan;
            eger gval_bulundu == 1 ise {
                int64_yaz(a, gval);
                a.kullanilan = a.kullanilan + (boyut - 8);
            } yoksa {
                a.kullanilan = a.kullanilan + boyut;
            }
            eger g_global_sayisi >= 16384 ise {
                codegen_kapasite_reddet(4);
            } yoksa {
                g_global_isim[g_global_sayisi] = isim;
                g_global_uzunluk[g_global_sayisi] = uzn;
                g_global_adres[g_global_sayisi] = adres;
                g_global_tip_adi[g_global_sayisi] = dugum.tip_adi;
                g_global_tip_adi_uzunluk[g_global_sayisi] = dugum.tip_adi_uzunluk;
                g_global_is_pointer[g_global_sayisi] = dugum.cozumlenmis_tip;
                g_global_dizi_boyutu[g_global_sayisi] = dugum.dizi_boyutu;
                g_global_sayisi = g_global_sayisi + 1;
            }
        }
        i = i + 1;
    }
    g_global_init_sayisi = g_global_ast_sayisi;
}

isv global_sabit_ifade_degeri(dugum: *AstDugum) -> tamsayi {
    g_sabit_bulundu = 0;
    eger dugum == 0 ise { dondu 0; }
    eger dugum.tip == AST_SAYI ise {
        g_sabit_bulundu = 1;
        dondu string_tamsayiya(dugum.ilk_jeton.baslangic, dugum.ilk_jeton.uzunluk);
    }
    eger dugum.tip == AST_GERCEK_SAYI ise {
        g_sabit_bulundu = 1;
        dondu string_gerceksayiya_ieee754(dugum.ilk_jeton.baslangic, dugum.ilk_jeton.uzunluk);
    }
    eger dugum.tip == AST_UNARY ise {
        degisken deger: tamsayi = global_sabit_ifade_degeri(dugum.sag);
        eger g_sabit_bulundu == 1 ise {
            eger dugum.ilk_jeton.tip == TIP_EKSI ise {
                dondu 0 - deger;
            }
            dondu deger;
        }
        dondu 0;
    }
    eger dugum.tip == AST_IKILI_OP ise {
        degisken sol: tamsayi = global_sabit_ifade_degeri(dugum.sol);
        eger g_sabit_bulundu == 0 ise { dondu 0; }
        degisken sag: tamsayi = global_sabit_ifade_degeri(dugum.sag);
        eger g_sabit_bulundu == 0 ise { dondu 0; }
        g_sabit_bulundu = 1;
        degisken op: tamsayi = dugum.ilk_jeton.tip;
        eger op == TIP_ARTI ise { dondu sol + sag; }
        eger op == TIP_EKSI ise { dondu sol - sag; }
        eger op == TIP_CARPI ise { dondu sol * sag; }
        eger op == TIP_BOLME ve sag != 0 ise { dondu sol / sag; }
        eger op == TIP_MODULO ve sag != 0 ise { dondu sol % sag; }
        eger op == TIP_XOR ise { dondu sol ^ sag; }
        g_sabit_bulundu = 0;
    }
    dondu 0;
}

isv global_sabitleri_topla(kok: *AstDugum, fonksiyon_icinde: tamsayi) {
    degisken iter: *AstDugum = kok;
    dongu iter != 0 {
        eger iter.tip == AST_DEGISKEN_TANIMI ise {
            degisken deger: tamsayi = global_sabit_ifade_degeri(iter.sag);
            eger g_sabit_bulundu == 1 ise {
                global_sabit_ekle(iter.ilk_jeton.baslangic, iter.ilk_jeton.uzunluk, deger);
            }
        }
        iter = iter.sonraki;
    }
}

degisken g_loop_stack_bas: [16]tamsayi;
degisken g_loop_raii_derinlik: [16]tamsayi;
degisken g_loop_stack_sp: tamsayi = 0;
degisken g_durdur_yamalar: [128]tamsayi;
degisken g_durdur_dongu_id: [128]tamsayi;
degisken g_devam_yamalar: [128]tamsayi;
degisken g_devam_dongu_id: [128]tamsayi;
degisken g_durdur_adet: tamsayi = 0;
degisken g_devam_adet: tamsayi = 0;

isv emit_store_rax(a: *MakineKoduArenasi, off: tamsayi) {
    eger platform_arm64_mi() == 1 ise {
        arm64_emit_str_x0_fp(a, off);
    } yoksa eger g_target_platform == 6 ise {
        int32_yaz(a, riscv_encode_s_type(RV_OP_STORE, 3, RV_S0, RV_A0, 0 - off));
    } yoksa eger g_target_platform == 5 ise {
        degisken idx: tamsayi = (off / 8) - 1;
        eger idx < 0 ise { idx = 0; }
        eger idx > 15 ise { idx = 15; }
        byte_yaz(a, 0x21);
        wasm_leb128_u32_yaz(a, idx);
    } yoksa {
        eger off <= 127 ise {
            byte_yaz(a, 0x48); byte_yaz(a, 0x89); byte_yaz(a, 0x45);
            byte_yaz(a, 256 - off);
        } yoksa {
            byte_yaz(a, 0x48); byte_yaz(a, 0x89); byte_yaz(a, 0x85);
            int32_yaz(a, 0 - off);
        }
    }
}


isv emit_load_rax(a: *MakineKoduArenasi, off: tamsayi) {
    eger platform_arm64_mi() == 1 ise {
        arm64_emit_ldr_x0_fp(a, off);
    } yoksa eger g_target_platform == 6 ise {
        int32_yaz(a, riscv_encode_i_type(RV_OP_LOAD, 3, RV_A0, RV_S0, 0 - off));
    } yoksa eger g_target_platform == 5 ise {
        degisken idx: tamsayi = (off / 8) - 1;
        eger idx < 0 ise { idx = 0; }
        eger idx > 15 ise { idx = 15; }
        byte_yaz(a, 0x20);
        wasm_leb128_u32_yaz(a, idx);
    } yoksa {
        eger off <= 127 ise {
            byte_yaz(a, 0x48); byte_yaz(a, 0x8B); byte_yaz(a, 0x45);
            byte_yaz(a, 256 - off);
        } yoksa {
            byte_yaz(a, 0x48); byte_yaz(a, 0x8B); byte_yaz(a, 0x85);
            int32_yaz(a, 0 - off);
        }
    }
}

isv emit_lea_rax(a: *MakineKoduArenasi, off: tamsayi) {
    eger platform_arm64_mi() == 1 ise {
        degisken instr: tamsayi = 0xD1000000 + (off * 1024) + (29 * 32) + 0;
        a64_int32_yaz(a, instr);
    } yoksa eger g_target_platform == 6 ise {
        int32_yaz(a, riscv_encode_i_type(RV_OP_IMM, 0, RV_A0, RV_S0, 0 - off));
    } yoksa eger g_target_platform == 5 ise {
        byte_yaz(a, 0x41);
        wasm_leb128_u32_yaz(a, off);
    } yoksa {
        eger off <= 127 ise {
            byte_yaz(a, 0x48); byte_yaz(a, 0x8D); byte_yaz(a, 0x45);
            byte_yaz(a, 256 - off);
        } yoksa {
            byte_yaz(a, 0x48); byte_yaz(a, 0x8D); byte_yaz(a, 0x85);
            int32_yaz(a, 0 - off);
        }
    }
}

# ============================================================
# AST -> x86_64 kod uretimi
# ============================================================
isv string_tamsayiya(veri: *u8, uzn: tamsayi) -> tamsayi {
    degisken sonuc: tamsayi = 0;
    degisken i: tamsayi = 0;
    degisken sign: tamsayi = 1;
    eger uzn > 0 ve veri[0] == 45 ise {
        sign = 0 - 1;
        i = 1;
    }
    eger (uzn - i) >= 2 ve veri[i] == 48 ve (veri[i + 1] == 120 veya veri[i + 1] == 88) ise {
        i = i + 2;
        dongu i < uzn {
            degisken c: u8 = veri[i];
            eger c != 95 ise {
                degisken digit: tamsayi = 0;
                eger c >= 48 ve c <= 57 ise { digit = c - 48; }
                yoksa eger c >= 97 ve c <= 102 ise { digit = (c - 97) + 10; }
                yoksa eger c >= 65 ve c <= 70 ise { digit = (c - 65) + 10; }
                sonuc = (sonuc * 16) + digit;
            }
            i = i + 1;
        }
        dondu sign * sonuc;
    }
    eger (uzn - i) >= 2 ve veri[i] == 48 ve (veri[i + 1] == 98 veya veri[i + 1] == 66) ise {
        i = i + 2;
        dongu i < uzn {
            degisken c: u8 = veri[i];
            eger c == 48 veya c == 49 ise {
                sonuc = (sonuc * 2) + (c - 48);
            }
            i = i + 1;
        }
        dondu sign * sonuc;
    }
    eger (uzn - i) >= 2 ve veri[i] == 48 ve (veri[i + 1] == 111 veya veri[i + 1] == 79) ise {
        i = i + 2;
        dongu i < uzn {
            degisken c: u8 = veri[i];
            eger c >= 48 ve c <= 55 ise {
                sonuc = (sonuc * 8) + (c - 48);
            }
            i = i + 1;
        }
        dondu sign * sonuc;
    }
    dongu i < uzn {
        degisken c: u8 = veri[i];
        eger c >= 48 ve c <= 57 ise {
            sonuc = (sonuc * 10) + (c - 48);
        }
        i = i + 1;
    }
    dondu sign * sonuc;
}

isv string_gerceksayiya_ieee754_codegen_eski(veri: *u8, uzn: tamsayi) -> tamsayi {
    degisken i: tamsayi = 0;
    degisken sign: tamsayi = 0;
    eger uzn > 0 ve veri[0] == 45 ise { # '-'
        sign = 1;
        i = 1;
    }
    degisken int_part: tamsayi = 0;
    dongu i < uzn ve veri[i] >= 48 ve veri[i] <= 57 {
        int_part = (int_part * 10) + (veri[i] - 48);
        i = i + 1;
    }
    degisken frac_part: tamsayi = 0;
    degisken frac_div: tamsayi = 1;
    eger i < uzn ve veri[i] == 46 ise { # '.'
        i = i + 1;
        dongu i < uzn ve veri[i] >= 48 ve veri[i] <= 57 {
            frac_part = (frac_part * 10) + (veri[i] - 48);
            frac_div = frac_div * 10;
            i = i + 1;
        }
    }
    eger int_part == 0 ve frac_part == 0 ise {
        eger sign == 1 ise { dondu (0 - 9223372036854775807) - 1; }
        dondu 0;
    }
    
    degisken exp: tamsayi = 1023;
    degisken mantissa: tamsayi = 0;
    
    eger int_part > 0 ise {
        degisken b: tamsayi = 0;
        degisken temp: tamsayi = int_part;
        dongu temp > 1 {
            temp = temp / 2;
            b = b + 1;
        }
        exp = 1023 + b;
        degisken shift: tamsayi = 52 - b;
        eger shift >= 0 ise {
            degisken mul: tamsayi = 1;
            degisken s_idx: tamsayi = 0;
            dongu s_idx < shift { mul = mul * 2; s_idx = s_idx + 1; }
            degisken m_int: tamsayi = int_part * mul;
            degisken m_frac: tamsayi = (frac_part * mul) / frac_div;
            mantissa = m_int + m_frac;
        } yoksa {
            degisken div: tamsayi = 1;
            degisken s_idx2: tamsayi = 0;
            dongu s_idx2 < (0 - shift) { div = div * 2; s_idx2 = s_idx2 + 1; }
            mantissa = int_part / div;
        }
        degisken bit52: tamsayi = 4503599627370496; # 2^52
        mantissa = mantissa % bit52;
    } yoksa {
        degisken shift_cnt: tamsayi = 1;
        degisken cur_f: tamsayi = frac_part * 2;
        dongu cur_f < frac_div {
            cur_f = cur_f * 2;
            shift_cnt = shift_cnt + 1;
        }
        exp = 1023 - shift_cnt;
        degisken rem_f: tamsayi = cur_f - frac_div;
        degisken mul: tamsayi = 4503599627370496; # 2^52
        mantissa = (rem_f * mul) / frac_div;
    }
    
    degisken sonuc: tamsayi = mantissa + (exp * 4503599627370496);
    eger sign == 1 ise {
        sonuc = sonuc + ((0 - 9223372036854775807) - 1);
    }
    dondu sonuc;
}

isv tip_adini_coz_yerel(ad: *u8, uzunluk: tamsayi) -> tamsayi {
    eger ad == 0 veya uzunluk <= 0 ise { dondu 0; }
    eger ad[0] == 42 ise { dondu 8; } # Pointer
    
    eger uzunluk == 2 ise {
        eger ad[0] == 117 ve ad[1] == 56 ise { dondu 6; } # u8
    }
    eger uzunluk == 3 ise {
        eger bellek_esit_mi(ad, "int".ptr, 3) == 1 ise { dondu 1; }
        eger bellek_esit_mi(ad, "i64".ptr, 3) == 1 ise { dondu 1; }
        eger bellek_esit_mi(ad, "u64".ptr, 3) == 1 ise { dondu 1; }
        eger bellek_esit_mi(ad, "i32".ptr, 3) == 1 ise { dondu 1; }
        eger bellek_esit_mi(ad, "u32".ptr, 3) == 1 ise { dondu 1; }
        eger bellek_esit_mi(ad, "f32".ptr, 3) == 1 ise { dondu 2; }
        eger bellek_esit_mi(ad, "f64".ptr, 3) == 1 ise { dondu 2; }
        eger bellek_esit_mi(ad, "hic".ptr, 3) == 1 ise { dondu 5; }
        eger bellek_esit_mi(ad, "str".ptr, 3) == 1 ise { dondu 3; }
        eger bellek_esit_mi(ad, "空".ptr, 3) == 1 ise { dondu 5; }
        eger bellek_esit_mi(ad, "無".ptr, 3) == 1 ise { dondu 5; }
    }
    eger uzunluk == 4 ise {
        eger bellek_esit_mi(ad, "sayi".ptr, 4) == 1 ise { dondu 1; }
        eger bellek_esit_mi(ad, "bool".ptr, 4) == 1 ise { dondu 4; }
        eger bellek_esit_mi(ad, "char".ptr, 4) == 1 ise { dondu 6; }
        eger bellek_esit_mi(ad, "byte".ptr, 4) == 1 ise { dondu 6; }
        eger bellek_esit_mi(ad, "void".ptr, 4) == 1 ise { dondu 5; }
        eger bellek_esit_mi(ad, "null".ptr, 4) == 1 ise { dondu 5; }
    }
    eger uzunluk == 5 ise {
        eger bellek_esit_mi(ad, "metin".ptr, 5) == 1 ise { dondu 3; }
        eger bellek_esit_mi(ad, "float".ptr, 5) == 1 ise { dondu 2; }
    }
    eger uzunluk == 6 ise {
        eger bellek_esit_mi(ad, "gercek".ptr, 6) == 1 ise { dondu 2; }
        eger bellek_esit_mi(ad, "double".ptr, 6) == 1 ise { dondu 2; }
        eger bellek_esit_mi(ad, "вещ".ptr, 6) == 1 ise { dondu 2; }
        eger bellek_esit_mi(ad, "浮動".ptr, 6) == 1 ise { dondu 2; }
        eger bellek_esit_mi(ad, "小数".ptr, 6) == 1 ise { dondu 2; }
        eger bellek_esit_mi(ad, "소수".ptr, 6) == 1 ise { dondu 2; }
        eger bellek_esit_mi(ad, "mantik".ptr, 6) == 1 ise { dondu 4; }
        eger bellek_esit_mi(ad, "string".ptr, 6) == 1 ise { dondu 3; }
        eger bellek_esit_mi(ad, "整数".ptr, 6) == 1 ise { dondu 1; }
        eger bellek_esit_mi(ad, "정수".ptr, 6) == 1 ise { dondu 1; }
        eger bellek_esit_mi(ad, "字节".ptr, 6) == 1 ise { dondu 6; }
        eger bellek_esit_mi(ad, "浮点".ptr, 6) == 1 ise { dondu 2; }
        eger bellek_esit_mi(ad, "실수".ptr, 6) == 1 ise { dondu 2; }
        eger bellek_esit_mi(ad, "布尔".ptr, 6) == 1 ise { dondu 4; }
        eger bellek_esit_mi(ad, "論理".ptr, 6) == 1 ise { dondu 4; }
        eger bellek_esit_mi(ad, "없음".ptr, 6) == 1 ise { dondu 5; }
    }
    eger uzunluk == 7 ise {
        eger bellek_esit_mi(ad, "tamsayi".ptr, 7) == 1 ise { dondu 1; }
        eger bellek_esit_mi(ad, "boolean".ptr, 7) == 1 ise { dondu 4; }
        eger bellek_esit_mi(ad, "kesirli".ptr, 7) == 1 ise { dondu 2; }
        eger bellek_esit_mi(ad, "decimal".ptr, 7) == 1 ise { dondu 2; }
    }
    eger uzunluk == 8 ise {
        eger bellek_esit_mi(ad, "flottant".ptr, 8) == 1 ise { dondu 2; }
        eger bellek_esit_mi(ad, "décimal".ptr, 8) == 1 ise { dondu 2; }
    }
    eger uzunluk == 9 ise {
        eger bellek_esit_mi(ad, "kesirli32".ptr, 9) == 1 ise { dondu 2; }
        eger bellek_esit_mi(ad, "kesirli64".ptr, 9) == 1 ise { dondu 2; }
        eger bellek_esit_mi(ad, "バイト".ptr, 9) == 1 ise { dondu 6; }
        eger bellek_esit_mi(ad, "바이트".ptr, 9) == 1 ise { dondu 6; }
        eger bellek_esit_mi(ad, "불리언".ptr, 9) == 1 ise { dondu 4; }
    }
    eger uzunluk == 14 ise {
        eger bellek_esit_mi(ad, "дробное".ptr, 14) == 1 ise { dondu 2; }
    }
    dondu 0;
}

isv ast_node_is_float(d: *AstDugum) -> tamsayi {
    eger d == 0 ise { dondu 0; }
    eger d.tip == AST_GERCEK_SAYI ise { dondu 1; }
    eger d.tip == AST_SAYI veya d.tip == AST_METIN veya d.tip == AST_MANTIK ise { dondu 0; }
    eger d.tip == AST_KIMLIK ise {
        eger d.ilk_jeton == 0 ise { dondu 0; }
        degisken isim: *u8 = d.ilk_jeton.baslangic;
        degisken uzn: tamsayi = d.ilk_jeton.uzunluk;
        degisken i: tamsayi = g_lokal_adet - 1;
        dongu i >= 0 {
            eger g_lokal_uzunluklari[i] == uzn ve bellek_esit_mi(g_lokal_isimleri[i], isim, uzn) == 1 ise {
                eger g_lokal_yildizlari[i] > 0 ise { dondu 0; }
                eger g_lokal_tip_adlari[i] != 0 ve g_lokal_tip_uzunluklari[i] > 0 ise {
                    degisken tid: tamsayi = tip_adini_coz_yerel(g_lokal_tip_adlari[i], g_lokal_tip_uzunluklari[i]);
                    eger tid == 2 ise { dondu 1; }
                }
                dondu 0;
            }
            i = i - 1;
        }
        degisken gi: tamsayi = 0;
        dongu gi < g_global_sayisi {
            eger g_global_uzunluk[gi] == uzn ve bellek_esit_mi(g_global_isim[gi], isim, uzn) == 1 ise {
                eger g_global_is_pointer[gi] > 0 ise { dondu 0; }
                eger g_global_tip_adi[gi] != 0 ve g_global_tip_adi_uzunluk[gi] > 0 ise {
                    degisken gtid: tamsayi = tip_adini_coz_yerel(g_global_tip_adi[gi], g_global_tip_adi_uzunluk[gi]);
                    eger gtid == 2 ise { dondu 1; }
                }
                dondu 0;
            }
            gi = gi + 1;
        }
        dondu 0;
    }
    eger d.tip == AST_IKILI_OP ise {
        eger d.ilk_jeton != 0 ise {
            degisken op: tamsayi = d.ilk_jeton.tip;
            eger op == TIP_ESIT_MI veya op == TIP_ESIT_DEGIL veya op == TIP_KUCUK_MU veya op == TIP_BUYUK_MU veya op == TIP_KUCUK_ESIT veya op == TIP_BUYUK_ESIT ise {
                dondu 0;
            }
            eger op == TIP_VE veya op == TIP_VEYA ise { dondu 0; }
        }
        eger ast_node_is_float(d.sol) == 1 ise { dondu 1; }
        eger ast_node_is_float(d.sag) == 1 ise { dondu 1; }
        dondu 0;
    }
    eger d.tip == AST_UNARY ise {
        dondu ast_node_is_float(d.sag);
    }
    eger d.tip == AST_COMPTIME ise {
        dondu ast_node_is_float(d.sol);
    }
    eger d.tip == AST_DONUSUM ise {
        eger d.cozumlenmis_tip == 0 ve d.tip_adi != 0 ise {
            eger tip_adini_coz_yerel(d.tip_adi, d.tip_adi_uzunluk) == 2 ise { dondu 1; }
        }
        dondu 0;
    }
    eger d.tip == 11 ise { # AST_ISLEV_CAGRISI
        eger d.ilk_jeton == 0 ise { dondu 0; }
        degisken fname: *u8 = d.ilk_jeton.baslangic;
        degisken flen: tamsayi = d.ilk_jeton.uzunluk;
        eger tip_adini_coz_yerel(fname, flen) == 2 ise { dondu 1; }
        # GOREV 6.2: FPU fonksiyonlar gercek dondurur
        eger flen == 8 ve bellek_esit_mi(fname, "kare_kok".ptr, 8) == 1 ise { dondu 1; }
        eger flen == 4 ve bellek_esit_mi(fname, "sqrt".ptr, 4) == 1 ise { dondu 1; }
        eger flen == 5 ve bellek_esit_mi(fname, "sinus".ptr, 5) == 1 ise { dondu 1; }
        eger flen == 3 ve bellek_esit_mi(fname, "sin".ptr, 3) == 1 ise { dondu 1; }
        eger flen == 7 ve bellek_esit_mi(fname, "kosinus".ptr, 7) == 1 ise { dondu 1; }
        eger flen == 3 ve bellek_esit_mi(fname, "cos".ptr, 3) == 1 ise { dondu 1; }
        eger flen == 13 ve bellek_esit_mi(fname, "gercek_mutlak".ptr, 13) == 1 ise { dondu 1; }
        eger flen == 4 ve bellek_esit_mi(fname, "fabs".ptr, 4) == 1 ise { dondu 1; }
        eger flen == 14 ve bellek_esit_mi(fname, "gercek_minimum".ptr, 14) == 1 ise { dondu 1; }
        eger flen == 4 ve bellek_esit_mi(fname, "fmin".ptr, 4) == 1 ise { dondu 1; }
        eger flen == 15 ve bellek_esit_mi(fname, "gercek_maksimum".ptr, 15) == 1 ise { dondu 1; }
        eger flen == 4 ve bellek_esit_mi(fname, "fmax".ptr, 4) == 1 ise { dondu 1; }
        dondu 0;
    }
    dondu 0;
}

isv ast_node_is_string(d: *AstDugum) -> tamsayi {
    eger d == 0 ise { dondu 0; }
    eger d.tip == AST_METIN ise { dondu 1; }
    eger d.tip == AST_FSTRING ise { dondu 1; }
    eger d.tip == AST_SAYI veya d.tip == AST_GERCEK_SAYI veya d.tip == AST_MANTIK ise { dondu 0; }
    eger d.tip == AST_ALAN_ERISIMI ise {
        eger d.sag != 0 ve d.sag.ilk_jeton != 0 ise {
            degisken f_j: *Jeton = d.sag.ilk_jeton;
            eger f_j.uzunluk == 3 ise {
                degisken ptr_f: *u8 = f_j.baslangic;
                eger ptr_f[0] == 112 ve ptr_f[1] == 116 ve ptr_f[2] == 114 ise { # .ptr
                    dondu 1;
                }
            } yoksa eger f_j.uzunluk == 4 ise {
                degisken ptr_f: *u8 = f_j.baslangic;
                eger ptr_f[0] == 118 ve ptr_f[1] == 101 ve ptr_f[2] == 114 ve ptr_f[3] == 105 ise { # .veri
                    dondu 1;
                }
            }
        }
    }
    eger d.tip == AST_KIMLIK ise {
        eger d.ilk_jeton == 0 ise { dondu 0; }
        degisken isim: *u8 = d.ilk_jeton.baslangic;
        degisken uzn: tamsayi = d.ilk_jeton.uzunluk;
        degisken i: tamsayi = g_lokal_adet - 1;
        dongu i >= 0 {
            eger g_lokal_uzunluklari[i] == uzn ve bellek_esit_mi(g_lokal_isimleri[i], isim, uzn) == 1 ise {
                eger g_lokal_tip_adlari[i] != 0 ve g_lokal_tip_uzunluklari[i] > 0 ise {
                    degisken t_ad: *u8 = g_lokal_tip_adlari[i];
                    degisken t_len: tamsayi = g_lokal_tip_uzunluklari[i];
                    eger t_len == 3 ve t_ad[0] == 42 ve t_ad[1] == 117 ve t_ad[2] == 56 ise { dondu 1; } # *u8
                    eger t_len == 2 ve t_ad[0] == 117 ve t_ad[1] == 56 ve g_lokal_yildizlari[i] >= 1 ise { dondu 1; }
                    degisken tid: tamsayi = tip_adini_coz_yerel(t_ad, t_len);
                    eger tid == 3 ise { dondu 1; }
                    eger g_lokal_yildizlari[i] == 1 ve tid == 6 ise { dondu 1; }
                }
                dondu 0;
            }
            i = i - 1;
        }
        degisken gi: tamsayi = 0;
        dongu gi < g_global_sayisi {
            eger g_global_uzunluk[gi] == uzn ve bellek_esit_mi(g_global_isim[gi], isim, uzn) == 1 ise {
                eger g_global_tip_adi[gi] != 0 ve g_global_tip_adi_uzunluk[gi] > 0 ise {
                    degisken gt_ad: *u8 = g_global_tip_adi[gi];
                    degisken gt_len: tamsayi = g_global_tip_adi_uzunluk[gi];
                    eger gt_len == 3 ve gt_ad[0] == 42 ve gt_ad[1] == 117 ve gt_ad[2] == 56 ise { dondu 1; }
                    eger gt_len == 2 ve gt_ad[0] == 117 ve gt_ad[1] == 56 ve g_global_is_pointer[gi] >= 1 ise { dondu 1; }
                    degisken gtid: tamsayi = tip_adini_coz_yerel(gt_ad, gt_len);
                    eger gtid == 3 ise { dondu 1; }
                    eger g_global_is_pointer[gi] == 1 ve gtid == 6 ise { dondu 1; }
                }
                dondu 0;
            }
            gi = gi + 1;
        }
        dondu 0;
    }
    eger d.tip == AST_IKILI_OP ise {
        eger d.ilk_jeton != 0 ise {
            degisken op: tamsayi = d.ilk_jeton.tip;
            eger op == TIP_ARTI ise {
                eger ast_node_is_string(d.sol) == 1 veya ast_node_is_string(d.sag) == 1 ise {
                    dondu 1;
                }
            }
        }
        dondu 0;
    }
    eger d.tip == 11 ise { # AST_ISLEV_CAGRISI
        eger d.ilk_jeton == 0 ise { dondu 0; }
        degisken fname: *u8 = d.ilk_jeton.baslangic;
        degisken flen: tamsayi = d.ilk_jeton.uzunluk;
        eger tip_adini_coz_yerel(fname, flen) == 3 ise { dondu 1; }
        eger flen == 13 ve bellek_esit_mi(fname, "tamsayi_metne".ptr, 13) == 1 ise { dondu 1; }
        eger flen == 9 ve bellek_esit_mi(fname, "to_string".ptr, 9) == 1 ise { dondu 1; }
        eger flen == 4 ve bellek_esit_mi(fname, "itoa".ptr, 4) == 1 ise { dondu 1; }
        eger flen == 15 ve bellek_esit_mi(fname, "metin_birlestir".ptr, 15) == 1 ise { dondu 1; }
        eger flen == 23 ve bellek_esit_mi(fname, "metin_iki_birlestir_yeni".ptr, 23) == 1 ise { dondu 1; }
        eger flen == 8 ve bellek_esit_mi(fname, "alt_dize".ptr, 8) == 1 ise { dondu 1; }
        eger flen == 6 ve bellek_esit_mi(fname, "substr".ptr, 6) == 1 ise { dondu 1; }
        eger flen == 14 ve bellek_esit_mi(fname, "metin_kucuk_yap".ptr, 14) == 1 ise { dondu 1; }
        eger flen == 14 ve bellek_esit_mi(fname, "metin_buyuk_yap".ptr, 14) == 1 ise { dondu 1; }
        dondu 0;
    }
    dondu 0;
}

isv emit_string_concat_inline(a: *MakineKoduArenasi) {
    # On entry: RCX = str1, RDX = str2
    # Preserve string pointers safely on stack across allocator call
    byte_yaz(a, 0x51); # PUSH RCX
    byte_yaz(a, 0x52); # PUSH RDX

    # Allocate 4096 bytes
    eger g_target_platform == 1 ise {
        # Linux sys_mmap(NULL, 4096, PROT_READ_WRITE, MAP_PRIVATE_ANON, -1, 0)
        byte_yaz(a, 0x48); byte_yaz(a, 0xC7); byte_yaz(a, 0xC7); int32_yaz(a, 0);                        # RDI = 0 (addr=NULL)
        byte_yaz(a, 0x48); byte_yaz(a, 0xC7); byte_yaz(a, 0xC6); int32_yaz(a, 4096);                     # RSI = 4096
        byte_yaz(a, 0x48); byte_yaz(a, 0xC7); byte_yaz(a, 0xC2); int32_yaz(a, CG_LINUX_PROT_READ_WRITE); # RDX = PROT_READ|PROT_WRITE
        byte_yaz(a, 0x49); byte_yaz(a, 0xC7); byte_yaz(a, 0xC2); int32_yaz(a, CG_LINUX_MAP_PRIVATE_ANON); # R10 = MAP_PRIVATE|MAP_ANONYMOUS
        byte_yaz(a, 0x49); byte_yaz(a, 0xC7); byte_yaz(a, 0xC0); int32_yaz(a, CG_LINUX_MMAP_FD_NONE);    # R8 = -1 (fd, MAP_ANON)
        byte_yaz(a, 0x4D); byte_yaz(a, 0x31); byte_yaz(a, 0xC9);                                          # R9 = 0 (offset)
        byte_yaz(a, 0x48); byte_yaz(a, 0xC7); byte_yaz(a, 0xC0); int32_yaz(a, CG_LINUX_SYS_MMAP);        # RAX = SYS_mmap
        byte_yaz(a, 0x0F); byte_yaz(a, 0x05);                                                              # syscall -> RAX = buffer
    } yoksa {
        # Windows VirtualAlloc(NULL, 4096, MEM_COMMIT|MEM_RESERVE, PAGE_READWRITE)
        # Two PUSHes (RCX, RDX) maintain 16-byte alignment. SUB RSP, 32 allocates shadow space.
        byte_yaz(a, 0x48); byte_yaz(a, 0x83); byte_yaz(a, 0xEC); byte_yaz(a, 0x20);  # SUB RSP, 32
        byte_yaz(a, 0x48); byte_yaz(a, 0x31); byte_yaz(a, 0xC9);                     # XOR RCX, RCX (lpAddress=NULL)
        byte_yaz(a, 0x48); byte_yaz(a, 0xC7); byte_yaz(a, 0xC2); int32_yaz(a, 4096); # MOV RDX, 4096
        byte_yaz(a, 0x41); byte_yaz(a, 0xB8); int32_yaz(a, 0x3000);                  # MOV R8D, 0x3000
        byte_yaz(a, 0x41); byte_yaz(a, 0xB9); int32_yaz(a, 0x04);                    # MOV R9D, 0x04
        byte_yaz(a, 0xFF); byte_yaz(a, 0x15);
        eger iat_yama_kapasite_kontrol() == 0 ise { dondu 0; }
        degisken iat_idx: tamsayi = g_iat_yama_adet;
        g_iat_yama_text_offset[iat_idx] = a.kullanilan;
        g_iat_yama_slot[iat_idx] = 3; # VirtualAlloc
        g_iat_yama_adet = g_iat_yama_adet + 1;
        int32_yaz(a, 0);
        byte_yaz(a, 0x48); byte_yaz(a, 0x83); byte_yaz(a, 0xC4); byte_yaz(a, 0x20);  # ADD RSP, 32
        # RAX = new buffer
    }

    # Restore RDX (str2), RCX (str1) from stack
    byte_yaz(a, 0x5A); # POP RDX
    byte_yaz(a, 0x59); # POP RCX

    # Save buffer start in R11 (non-volatile across string copy, returned in RAX at end)
    byte_yaz(a, 0x49); byte_yaz(a, 0x89); byte_yaz(a, 0xC3); # MOV R11, RAX (buffer start)

    # R8 = write pointer (starts at buffer start)
    byte_yaz(a, 0x49); byte_yaz(a, 0x89); byte_yaz(a, 0xC0); # MOV R8, RAX

    # Copy str1 (RCX) until null:
    byte_yaz(a, 0x48); byte_yaz(a, 0x85); byte_yaz(a, 0xC9); # TEST RCX, RCX (3 bytes)
    byte_yaz(a, 0x74); byte_yaz(a, 0x13);                     # JE cp1_done (+19) (2 bytes)
    byte_yaz(a, 0x44); byte_yaz(a, 0x8A); byte_yaz(a, 0x11); # MOV R10B, [RCX] (3 bytes)
    byte_yaz(a, 0x45); byte_yaz(a, 0x84); byte_yaz(a, 0xD2); # TEST R10B, R10B (3 bytes)
    byte_yaz(a, 0x74); byte_yaz(a, 0x0B);                     # JE cp1_done (+11) (2 bytes)
    byte_yaz(a, 0x45); byte_yaz(a, 0x88); byte_yaz(a, 0x10); # MOV [R8], R10B (3 bytes)
    byte_yaz(a, 0x48); byte_yaz(a, 0xFF); byte_yaz(a, 0xC1); # INC RCX (3 bytes)
    byte_yaz(a, 0x49); byte_yaz(a, 0xFF); byte_yaz(a, 0xC0); # INC R8 (3 bytes)
    byte_yaz(a, 0xEB); byte_yaz(a, 0xED);                     # JMP cp1_loop (-19 bytes = 0xED) (2 bytes)
    # cp1_done:

    # Copy str2 (RDX) until null:
    byte_yaz(a, 0x48); byte_yaz(a, 0x85); byte_yaz(a, 0xD2); # TEST RDX, RDX (3 bytes)
    byte_yaz(a, 0x74); byte_yaz(a, 0x13);                     # JE cp2_done (+19) (2 bytes)
    byte_yaz(a, 0x44); byte_yaz(a, 0x8A); byte_yaz(a, 0x12); # MOV R10B, [RDX] (3 bytes)
    byte_yaz(a, 0x45); byte_yaz(a, 0x84); byte_yaz(a, 0xD2); # TEST R10B, R10B (3 bytes)
    byte_yaz(a, 0x74); byte_yaz(a, 0x0B);                     # JE cp2_done (+11) (2 bytes)
    byte_yaz(a, 0x45); byte_yaz(a, 0x88); byte_yaz(a, 0x10); # MOV [R8], R10B (3 bytes)
    byte_yaz(a, 0x48); byte_yaz(a, 0xFF); byte_yaz(a, 0xC2); # INC RDX
    byte_yaz(a, 0x49); byte_yaz(a, 0xFF); byte_yaz(a, 0xC0); # INC R8
    byte_yaz(a, 0xEB); byte_yaz(a, 0xED);                     # JMP cp2_loop (-19 bytes = 0xED) (2 bytes)
    # cp2_done:

    # Null terminate: MOV byte [R8], 0
    byte_yaz(a, 0x41); byte_yaz(a, 0xC6); byte_yaz(a, 0x00); byte_yaz(a, 0x00);

    # Return buffer start in RAX: MOV RAX, R11
    byte_yaz(a, 0x4C); byte_yaz(a, 0x89); byte_yaz(a, 0xD8); # MOV RAX, R11
}

isv emit_i64_to_string(a: *MakineKoduArenasi) {
    byte_yaz(a, 0x50); # PUSH RAX

    eger g_target_platform == 1 ise {
        byte_yaz(a, 0x48); byte_yaz(a, 0xC7); byte_yaz(a, 0xC7); int32_yaz(a, 0);
        byte_yaz(a, 0x48); byte_yaz(a, 0xC7); byte_yaz(a, 0xC6); int32_yaz(a, 64);
        byte_yaz(a, 0x48); byte_yaz(a, 0xC7); byte_yaz(a, 0xC2); int32_yaz(a, 3);
        byte_yaz(a, 0x49); byte_yaz(a, 0xC7); byte_yaz(a, 0xC2); int32_yaz(a, 34);
        byte_yaz(a, 0x49); byte_yaz(a, 0xC7); byte_yaz(a, 0xC0); int32_yaz(a, 0 - 1);
        byte_yaz(a, 0x4D); byte_yaz(a, 0x31); byte_yaz(a, 0xC9);
        byte_yaz(a, 0x48); byte_yaz(a, 0xC7); byte_yaz(a, 0xC0); int32_yaz(a, 9);
        byte_yaz(a, 0x0F); byte_yaz(a, 0x05);
    } yoksa {
        byte_yaz(a, 0x48); byte_yaz(a, 0x83); byte_yaz(a, 0xEC); byte_yaz(a, 0x28);
        byte_yaz(a, 0x48); byte_yaz(a, 0x31); byte_yaz(a, 0xC9);
        byte_yaz(a, 0x48); byte_yaz(a, 0xC7); byte_yaz(a, 0xC2); int32_yaz(a, 64);
        byte_yaz(a, 0x41); byte_yaz(a, 0xB8); int32_yaz(a, 0x3000);
        byte_yaz(a, 0x41); byte_yaz(a, 0xB9); int32_yaz(a, 0x04);
        byte_yaz(a, 0xFF); byte_yaz(a, 0x15);
        eger iat_yama_kapasite_kontrol() != 0 ise {
            degisken iat_idx: tamsayi = g_iat_yama_adet;
            g_iat_yama_text_offset[iat_idx] = a.kullanilan;
            g_iat_yama_slot[iat_idx] = 3; # VirtualAlloc
            g_iat_yama_adet = g_iat_yama_adet + 1;
        }
        int32_yaz(a, 0);
        byte_yaz(a, 0x48); byte_yaz(a, 0x83); byte_yaz(a, 0xC4); byte_yaz(a, 0x28);
    }

    byte_yaz(a, 0x59); # POP RCX
    byte_yaz(a, 0x49); byte_yaz(a, 0x89); byte_yaz(a, 0xC0); # MOV R8, RAX
    byte_yaz(a, 0x49); byte_yaz(a, 0x89); byte_yaz(a, 0xC1); # MOV R9, RAX

    byte_yaz(a, 0x48); byte_yaz(a, 0x85); byte_yaz(a, 0xC9); # TEST RCX, RCX
    byte_yaz(a, 0x75); degisken jnz_zero_pos: tamsayi = a.kullanilan; byte_yaz(a, 0);

    byte_yaz(a, 0xC6); byte_yaz(a, 0x00); byte_yaz(a, 48); # '0'
    byte_yaz(a, 0xC6); byte_yaz(a, 0x40); byte_yaz(a, 1); byte_yaz(a, 0);
    byte_yaz(a, 0xEB); degisken jmp_done_zero_pos: tamsayi = a.kullanilan; byte_yaz(a, 0);

    degisken b_ptr: *u8 = a.bellek;
    b_ptr[jnz_zero_pos] = a.kullanilan - (jnz_zero_pos + 1);

    byte_yaz(a, 0x48); byte_yaz(a, 0x85); byte_yaz(a, 0xC9); # TEST RCX, RCX
    byte_yaz(a, 0x79); degisken jns_pos: tamsayi = a.kullanilan; byte_yaz(a, 0);

    byte_yaz(a, 0x41); byte_yaz(a, 0xC6); byte_yaz(a, 0x01); byte_yaz(a, 45); # '-'
    byte_yaz(a, 0x49); byte_yaz(a, 0xFF); byte_yaz(a, 0xC1);                 # INC R9
    byte_yaz(a, 0x48); byte_yaz(a, 0xF7); byte_yaz(a, 0xD9);                 # NEG RCX

    b_ptr[jns_pos] = a.kullanilan - (jns_pos + 1);

    byte_yaz(a, 0x4D); byte_yaz(a, 0x89); byte_yaz(a, 0xCA); # MOV R10, R9

    degisken loop_start: tamsayi = a.kullanilan;
    byte_yaz(a, 0x48); byte_yaz(a, 0x89); byte_yaz(a, 0xC8);                 # MOV RAX, RCX
    byte_yaz(a, 0x49); byte_yaz(a, 0xC7); byte_yaz(a, 0xC3); int32_yaz(a, 10);# MOV R11, 10
    byte_yaz(a, 0x48); byte_yaz(a, 0x31); byte_yaz(a, 0xD2);                 # XOR RDX, RDX
    byte_yaz(a, 0x49); byte_yaz(a, 0xF7); byte_yaz(a, 0xF3);                 # DIV R11
    byte_yaz(a, 0x80); byte_yaz(a, 0xC2); byte_yaz(a, 48);                   # ADD DL, '0'
    byte_yaz(a, 0x41); byte_yaz(a, 0x88); byte_yaz(a, 0x11);                 # MOV [R9], DL
    byte_yaz(a, 0x49); byte_yaz(a, 0xFF); byte_yaz(a, 0xC1);                 # INC R9
    byte_yaz(a, 0x48); byte_yaz(a, 0x89); byte_yaz(a, 0xC1);                 # MOV RCX, RAX
    byte_yaz(a, 0x48); byte_yaz(a, 0x85); byte_yaz(a, 0xC9);                 # TEST RCX, RCX
    byte_yaz(a, 0x75); byte_yaz(a, loop_start - (a.kullanilan + 1));          # JNZ loop_start

    byte_yaz(a, 0x41); byte_yaz(a, 0xC6); byte_yaz(a, 0x01); byte_yaz(a, 0); # MOV byte [R9], 0

    byte_yaz(a, 0x4D); byte_yaz(a, 0x89); byte_yaz(a, 0xCB);                 # MOV R11, R9
    byte_yaz(a, 0x49); byte_yaz(a, 0xFF); byte_yaz(a, 0xCB);                 # DEC R11

    degisken rev_loop: tamsayi = a.kullanilan;
    byte_yaz(a, 0x4D); byte_yaz(a, 0x39); byte_yaz(a, 0xDA);                 # CMP R10, R11
    byte_yaz(a, 0x7D); degisken jge_rev_pos: tamsayi = a.kullanilan; byte_yaz(a, 0);

    byte_yaz(a, 0x41); byte_yaz(a, 0x8A); byte_yaz(a, 0x02);                 # MOV AL, [R10]
    byte_yaz(a, 0x41); byte_yaz(a, 0x8A); byte_yaz(a, 0x0B);                 # MOV CL, [R11]
    byte_yaz(a, 0x41); byte_yaz(a, 0x88); byte_yaz(a, 0x0A);                 # MOV [R10], CL
    byte_yaz(a, 0x41); byte_yaz(a, 0x88); byte_yaz(a, 0x03);                 # MOV [R11], AL
    byte_yaz(a, 0x49); byte_yaz(a, 0xFF); byte_yaz(a, 0xC2);                 # INC R10
    byte_yaz(a, 0x49); byte_yaz(a, 0xFF); byte_yaz(a, 0xCB);                 # DEC R11
    byte_yaz(a, 0xEB); byte_yaz(a, rev_loop - (a.kullanilan + 1));            # JMP rev_loop

    b_ptr[jge_rev_pos] = a.kullanilan - (jge_rev_pos + 1);
    b_ptr[jmp_done_zero_pos] = a.kullanilan - (jmp_done_zero_pos + 1);
    byte_yaz(a, 0x4C); byte_yaz(a, 0x89); byte_yaz(a, 0xC0);                 # MOV RAX, R8
}

isv parse_fstring_subexpr(expr_ptr: *u8, expr_uzn: tamsayi, satir: tamsayi, sutun: tamsayi) -> *AstDugum {
    degisken b: tamsayi = 0;
    dongu b < expr_uzn ve (expr_ptr[b] == 32 veya expr_ptr[b] == 9 veya expr_ptr[b] == 10 veya expr_ptr[b] == 13) {
        b = b + 1;
    }
    degisken e: tamsayi = expr_uzn;
    dongu e > b ve (expr_ptr[e - 1] == 32 veya expr_ptr[e - 1] == 9 veya expr_ptr[e - 1] == 10 veya expr_ptr[e - 1] == 13) {
        e = e - 1;
    }
    degisken c_len: tamsayi = e - b;
    eger c_len <= 0 ise { dondu 0; }
    degisken c_ptr: *u8 = expr_ptr + b;

    degisken lx: *LexerState = compiler_tahsis_et(64);
    eger lx == 0 ise { dondu 0; }
    lx.kaynak = c_ptr;
    lx.dosya_boyutu = c_len;
    lx.guncel_offset = 0;
    lx.satir = satir;
    lx.sutun = sutun;
    lx.jeton_kapasite = 128;
    lx.jeton_sayisi = 0;
    lx.jetonlar = compiler_tahsis_et(128 * 40);
    lx.pool = 0;

    tokenize_et(lx);
    eger lx.jeton_sayisi <= 0 ise { dondu 0; }

    degisken ar: *AstArena = compiler_tahsis_et(32);
    eger ar == 0 ise { dondu 0; }
    ar.bellek = compiler_tahsis_et(65536);
    ar.kapasite = 65536;
    ar.kullanilan = 0;

    degisken pd: *ParserDurumu = compiler_tahsis_et(64);
    eger pd == 0 ise { dondu 0; }
    pd.jetonlar = lx.jetonlar;
    pd.jeton_sayisi = lx.jeton_sayisi;
    pd.guncel_index = 0;
    pd.arena = ar;
    pd.hata_sayisi = 0;

    dondu parse_ifade(pd, 0);
}

# Guvenli indeksleme: basarilamazsa Windows ExitProcess(1) ile terminal panik.
isv bounds_panik_uret(a: *MakineKoduArenasi) {
    byte_yaz(a, 0x48); byte_yaz(a, 0xC7); byte_yaz(a, 0xC1); int32_yaz(a, 1);
    byte_yaz(a, 0xFF); byte_yaz(a, 0x15);
    eger iat_yama_kapasite_kontrol() == 0 ise { dondu; }
    degisken iat_idx: tamsayi = g_iat_yama_adet;
    g_iat_yama_text_offset[iat_idx] = a.kullanilan;
    g_iat_yama_slot[iat_idx] = 0; # ExitProcess
    g_iat_yama_adet = g_iat_yama_adet + 1;
    int32_yaz(a, 0);
    byte_yaz(a, 0xCC);
}

isv bounds_kontrol(a: *MakineKoduArenasi, dizi_boyutu: tamsayi, pointer_mi: tamsayi) {
    eger g_bounds_check == 0 ise { dondu; }
    degisken f1: tamsayi = 0 - 1;
    degisken f2: tamsayi = 0 - 1;
    degisken f3: tamsayi = 0 - 1;
    eger pointer_mi == 1 ise {
        # CMP qword ptr [RSP], 0; JE fail (taban adresi stack'te)
        byte_yaz(a, 0x48); byte_yaz(a, 0x83); byte_yaz(a, 0x3C); byte_yaz(a, 0x24); byte_yaz(a, 0);
        byte_yaz(a, 0x0F); byte_yaz(a, 0x84); f1 = a.kullanilan; int32_yaz(a, 0);
    }
    eger dizi_boyutu > 0 ise {
        # RAX indeks: once signed negatif, sonra unsigned >= N kontrolu.
        byte_yaz(a, 0x48); byte_yaz(a, 0x83); byte_yaz(a, 0xF8); byte_yaz(a, 0);
        byte_yaz(a, 0x0F); byte_yaz(a, 0x8C); f2 = a.kullanilan; int32_yaz(a, 0);
        byte_yaz(a, 0x48); byte_yaz(a, 0xC7); byte_yaz(a, 0xC1); int32_yaz(a, dizi_boyutu);
        byte_yaz(a, 0x48); byte_yaz(a, 0x3B); byte_yaz(a, 0xC1);
        byte_yaz(a, 0x0F); byte_yaz(a, 0x83); f3 = a.kullanilan; int32_yaz(a, 0);
    }
    eger f1 >= 0 veya f2 >= 0 veya f3 >= 0 ise {
        byte_yaz(a, 0xE9); degisken skip: tamsayi = a.kullanilan; int32_yaz(a, 0);
        degisken panic: tamsayi = a.kullanilan;
        bounds_panik_uret(a);
        int32_patch(a, skip, a.kullanilan - (skip + 4));
        eger f1 >= 0 ise { int32_patch(a, f1, panic - (f1 + 4)); }
        eger f2 >= 0 ise { int32_patch(a, f2, panic - (f2 + 4)); }
        eger f3 >= 0 ise { int32_patch(a, f3, panic - (f3 + 4)); }
    }
}

isv codegen_unsupported_ast_reddet(dugum: *AstDugum) {
    eger dugum != 0 ve (dugum.tip == AST_ASYNC_ISLEV veya dugum.tip == AST_AWAIT veya dugum.tip == 41 veya dugum.tip == 42) ise {
        dondu;
    }
    g_codegen_unsupported_ast_hatasi = 1;
    degisken hk: HataKaydi;
    degisken satir: tamsayi = 1;
    degisken sutun: tamsayi = 1;
    eger dugum != 0 ve dugum.ilk_jeton != 0 ise {
        satir = dugum.ilk_jeton.satir;
        sutun = dugum.ilk_jeton.sutun;
    }

    tani_olustur(&hk, 43, satir, sutun, "AST dugumu codegen tarafindan desteklenmiyor".ptr, 0);
    hata_kaydi_yazdir(&hk);
}

isv emit_async_future_wrap(a: *MakineKoduArenasi) {
    # RAX'taki sonucu Future ve AsyncFrame (160 bayt) nesnesine sarar
    byte_yaz(a, 0x50); # PUSH RAX
    
    eger g_target_platform == 1 ise {
        # Linux x86_64 sys_mmap (size=160)
        byte_yaz(a, 0x48); byte_yaz(a, 0x31); byte_yaz(a, 0xFF);                     # XOR RDI, RDI
        byte_yaz(a, 0x48); byte_yaz(a, 0xC7); byte_yaz(a, 0xC6); int32_yaz(a, 160);  # MOV RSI, 160
        byte_yaz(a, 0x48); byte_yaz(a, 0xC7); byte_yaz(a, 0xC2); int32_yaz(a, 3);    # MOV RDX, 3 (PROT_READ|PROT_WRITE)
        byte_yaz(a, 0x49); byte_yaz(a, 0xC7); byte_yaz(a, 0xC2); int32_yaz(a, 34);   # MOV R10, 34 (MAP_PRIVATE|MAP_ANONYMOUS)
        byte_yaz(a, 0x49); byte_yaz(a, 0xC7); byte_yaz(a, 0xC0); int32_yaz(a, -1);   # MOV R8, -1
        byte_yaz(a, 0x4D); byte_yaz(a, 0x31); byte_yaz(a, 0xC9);                     # XOR R9, R9
        byte_yaz(a, 0x48); byte_yaz(a, 0xC7); byte_yaz(a, 0xC0); int32_yaz(a, 9);    # RAX = 9 (sys_mmap)
        byte_yaz(a, 0x0F); byte_yaz(a, 0x05);                                         # syscall -> RAX = buffer
    } yoksa {
        # Windows VirtualAlloc(NULL, 160, MEM_COMMIT|MEM_RESERVE, PAGE_READWRITE)
        byte_yaz(a, 0x48); byte_yaz(a, 0x31); byte_yaz(a, 0xC9); # XOR RCX, RCX
        byte_yaz(a, 0x48); byte_yaz(a, 0xC7); byte_yaz(a, 0xC2); int32_yaz(a, 160); # MOV RDX, 160
        byte_yaz(a, 0x41); byte_yaz(a, 0xB8); int32_yaz(a, 0x3000); # MOV R8D, MEM_COMMIT|MEM_RESERVE
        byte_yaz(a, 0x41); byte_yaz(a, 0xB9); int32_yaz(a, 0x04);   # MOV R9D, PAGE_READWRITE
        byte_yaz(a, 0x48); byte_yaz(a, 0x83); byte_yaz(a, 0xEC); byte_yaz(a, 0x28); # SUB RSP, 40
        byte_yaz(a, 0xFF); byte_yaz(a, 0x15); # CALL [VirtualAlloc]
        eger iat_yama_kapasite_kontrol() != 0 ise {
            degisken ar_ba: tamsayi = g_iat_yama_adet;
            g_iat_yama_text_offset[ar_ba] = a.kullanilan;
            g_iat_yama_slot[ar_ba] = 3;
            g_iat_yama_adet = g_iat_yama_adet + 1;
        }
        int32_yaz(a, 0);
        byte_yaz(a, 0x48); byte_yaz(a, 0x83); byte_yaz(a, 0xC4); byte_yaz(a, 0x28); # ADD RSP, 40
    }
    
    # RAX = Future*, RDX = sonuc
    byte_yaz(a, 0x5A); # POP RDX

    # JMP over trampoline
    byte_yaz(a, 0xE9);
    degisken jmp_pos: tamsayi = a.kullanilan;
    int32_yaz(a, 0);

    degisken tramp_start: tamsayi = a.kullanilan;
    # --- async_poll_trampoline ---
    byte_yaz(a, 0x48); byte_yaz(a, 0x81); byte_yaz(a, 0x39); int32_yaz(a, 0x594B4E46);
    byte_yaz(a, 0x75); byte_yaz(a, 101); # JNE .poll_hata
    byte_yaz(a, 0x48); byte_yaz(a, 0x8B); byte_yaz(a, 0x41); byte_yaz(a, 0x18);
    byte_yaz(a, 0x48); byte_yaz(a, 0x83); byte_yaz(a, 0xF8); byte_yaz(a, 0x01);
    byte_yaz(a, 0x74); byte_yaz(a, 99);  # JE .poll_ret
    byte_yaz(a, 0x48); byte_yaz(a, 0x8B); byte_yaz(a, 0x51); byte_yaz(a, 0x28);
    byte_yaz(a, 0x48); byte_yaz(a, 0x85); byte_yaz(a, 0xD2);
    byte_yaz(a, 0x74); byte_yaz(a, 78);  # JZ .poll_bekliyor
    byte_yaz(a, 0x4C); byte_yaz(a, 0x8B); byte_yaz(a, 0x12);
    byte_yaz(a, 0x4D); byte_yaz(a, 0x85); byte_yaz(a, 0xD2);
    byte_yaz(a, 0x74); byte_yaz(a, 70);  # JZ .poll_bekliyor

    byte_yaz(a, 0x51); byte_yaz(a, 0x52);
    byte_yaz(a, 0x48); byte_yaz(a, 0x8B); byte_yaz(a, 0x4A); byte_yaz(a, 0x08);
    byte_yaz(a, 0x48); byte_yaz(a, 0x83); byte_yaz(a, 0xEC); byte_yaz(a, 0x28);
    byte_yaz(a, 0x41); byte_yaz(a, 0xFF); byte_yaz(a, 0xD2);
    byte_yaz(a, 0x48); byte_yaz(a, 0x83); byte_yaz(a, 0xC4); byte_yaz(a, 0x28);
    byte_yaz(a, 0x5A); byte_yaz(a, 0x59);

    byte_yaz(a, 0x48); byte_yaz(a, 0x83); byte_yaz(a, 0xF8); byte_yaz(a, 0x01);
    byte_yaz(a, 0x75); byte_yaz(a, 45);  # JNE .poll_bekliyor

    byte_yaz(a, 0x4C); byte_yaz(a, 0x8B); byte_yaz(a, 0x42); byte_yaz(a, 0x18);
    byte_yaz(a, 0x4C); byte_yaz(a, 0x89); byte_yaz(a, 0x41); byte_yaz(a, 0x20);
    byte_yaz(a, 0x48); byte_yaz(a, 0xC7); byte_yaz(a, 0x41); byte_yaz(a, 0x18); int32_yaz(a, 1);
    byte_yaz(a, 0x4C); byte_yaz(a, 0x8B); byte_yaz(a, 0x59); byte_yaz(a, 0x30);
    byte_yaz(a, 0x4D); byte_yaz(a, 0x85); byte_yaz(a, 0xDB);
    byte_yaz(a, 0x74); byte_yaz(a, 19);
    byte_yaz(a, 0x49); byte_yaz(a, 0xC7); byte_yaz(a, 0x43); byte_yaz(a, 0x10); int32_yaz(a, 1);
    byte_yaz(a, 0x4D); byte_yaz(a, 0x89); byte_yaz(a, 0x43); byte_yaz(a, 0x18);

    byte_yaz(a, 0x48); byte_yaz(a, 0xC7); byte_yaz(a, 0xC0); int32_yaz(a, 1);
    byte_yaz(a, 0xC3);

    byte_yaz(a, 0x48); byte_yaz(a, 0x31); byte_yaz(a, 0xC0); byte_yaz(a, 0xC3); # .poll_bekliyor
    byte_yaz(a, 0x48); byte_yaz(a, 0xC7); byte_yaz(a, 0xC0); int32_yaz(a, 2); byte_yaz(a, 0xC3); # .poll_hata
    byte_yaz(a, 0xC3); # .poll_ret

    degisken after_tramp: tamsayi = a.kullanilan;
    int32_patch(a, jmp_pos, after_tramp - (jmp_pos + 4));

    # LEA R10, [RIP + rel32] -> Trampoline adresi
    byte_yaz(a, 0x4C); byte_yaz(a, 0x8D); byte_yaz(a, 0x15);
    degisken lea_pos: tamsayi = a.kullanilan;
    int32_yaz(a, tramp_start - (lea_pos + 4));
    byte_yaz(a, 0x4C); byte_yaz(a, 0x89); byte_yaz(a, 0x10); # [RAX] = R10

    # LEA R8, [RAX + 80] (AsyncFrame adresi)
    byte_yaz(a, 0x4C); byte_yaz(a, 0x8D); byte_yaz(a, 0x40); byte_yaz(a, 80);
    byte_yaz(a, 0x4C); byte_yaz(a, 0x89); byte_yaz(a, 0x40); byte_yaz(a, 0x08); # [RAX+8] = R8
    byte_yaz(a, 0x48); byte_yaz(a, 0xC7); byte_yaz(a, 0x40); byte_yaz(a, 0x10); int32_yaz(a, 1); # [RAX+16] = 1
    byte_yaz(a, 0x48); byte_yaz(a, 0x89); byte_yaz(a, 0x50); byte_yaz(a, 0x18); # [RAX+24] = RDX
    byte_yaz(a, 0x48); byte_yaz(a, 0xC7); byte_yaz(a, 0x40); byte_yaz(a, 0x20); int32_yaz(a, 1); # [RAX+32] = 1
    byte_yaz(a, 0x48); byte_yaz(a, 0xC7); byte_yaz(a, 0x40); byte_yaz(a, 0x28); int32_yaz(a, 0); # [RAX+40] = 0
    byte_yaz(a, 0x4C); byte_yaz(a, 0x8D); byte_yaz(a, 0x48); byte_yaz(a, 0x18); # LEA R9, [RAX+24]
    byte_yaz(a, 0x4C); byte_yaz(a, 0x89); byte_yaz(a, 0x48); byte_yaz(a, 0x30); # [RAX+48] = R9
    byte_yaz(a, 0x48); byte_yaz(a, 0xC7); byte_yaz(a, 0x40); byte_yaz(a, 0x38); int32_yaz(a, 8); # [RAX+56] = 8
    byte_yaz(a, 0x48); byte_yaz(a, 0xC7); byte_yaz(a, 0x40); byte_yaz(a, 0x40); int32_yaz(a, 2); # [RAX+64] = 2
    byte_yaz(a, 0x4C); byte_yaz(a, 0x89); byte_yaz(a, 0x40); byte_yaz(a, 0x48); # [RAX+72] = R8

    # AsyncFrame baslatma (R8 base)
    byte_yaz(a, 0x49); byte_yaz(a, 0xC7); byte_yaz(a, 0x40); byte_yaz(a, 0x00); int32_yaz(a, 0x594B4E46);
    byte_yaz(a, 0x49); byte_yaz(a, 0xC7); byte_yaz(a, 0x40); byte_yaz(a, 0x08); int32_yaz(a, 64);
    byte_yaz(a, 0x49); byte_yaz(a, 0xC7); byte_yaz(a, 0x40); byte_yaz(a, 0x10); int32_yaz(a, 0);
    byte_yaz(a, 0x49); byte_yaz(a, 0xC7); byte_yaz(a, 0x40); byte_yaz(a, 0x18); int32_yaz(a, 1);
    byte_yaz(a, 0x49); byte_yaz(a, 0x89); byte_yaz(a, 0x50); byte_yaz(a, 0x20);
    byte_yaz(a, 0x49); byte_yaz(a, 0xC7); byte_yaz(a, 0x40); byte_yaz(a, 0x28); int32_yaz(a, 0);
    byte_yaz(a, 0x49); byte_yaz(a, 0x89); byte_yaz(a, 0x40); byte_yaz(a, 0x30);
    byte_yaz(a, 0x4D); byte_yaz(a, 0x8D); byte_yaz(a, 0x48); byte_yaz(a, 0x40);
    byte_yaz(a, 0x4D); byte_yaz(a, 0x89); byte_yaz(a, 0x48); byte_yaz(a, 0x38);
    byte_yaz(a, 0x49); byte_yaz(a, 0xC7); byte_yaz(a, 0x40); byte_yaz(a, 0x40); int32_yaz(a, 8);
}

isv emit_async_await_unwrap(a: *MakineKoduArenasi) {
    # Giris: RAX = Future*
    # Cikis: RAX = sonuc (tamsayi)
    byte_yaz(a, 0x48); byte_yaz(a, 0x85); byte_yaz(a, 0xC0);
    byte_yaz(a, 0x74); byte_yaz(a, 52); # JZ atla_null

    # .poll_loop:
    byte_yaz(a, 0x48); byte_yaz(a, 0x83); byte_yaz(a, 0x78); byte_yaz(a, 0x10); byte_yaz(a, 0x00);
    byte_yaz(a, 0x75); byte_yaz(a, 27); # JNE .poll_done
    byte_yaz(a, 0x4C); byte_yaz(a, 0x8B); byte_yaz(a, 0x10);
    byte_yaz(a, 0x4D); byte_yaz(a, 0x85); byte_yaz(a, 0xD2);
    byte_yaz(a, 0x74); byte_yaz(a, 19); # JZ .poll_done

    byte_yaz(a, 0x50);
    byte_yaz(a, 0x48); byte_yaz(a, 0x8B); byte_yaz(a, 0x48); byte_yaz(a, 0x08);
    byte_yaz(a, 0x48); byte_yaz(a, 0x83); byte_yaz(a, 0xEC); byte_yaz(a, 0x28);
    byte_yaz(a, 0x41); byte_yaz(a, 0xFF); byte_yaz(a, 0xD2);
    byte_yaz(a, 0x48); byte_yaz(a, 0x83); byte_yaz(a, 0xC4); byte_yaz(a, 0x28);
    byte_yaz(a, 0x58);
    byte_yaz(a, 0xEB); byte_yaz(a, 0xDE); # JMP .poll_loop

    # .poll_done:
    byte_yaz(a, 0x48); byte_yaz(a, 0x8B); byte_yaz(a, 0x50); byte_yaz(a, 0x30);
    byte_yaz(a, 0x48); byte_yaz(a, 0x85); byte_yaz(a, 0xD2);
    byte_yaz(a, 0x74); byte_yaz(a, 5);
    byte_yaz(a, 0x48); byte_yaz(a, 0x8B); byte_yaz(a, 0x02);
    byte_yaz(a, 0xEB); byte_yaz(a, 4);
    byte_yaz(a, 0x48); byte_yaz(a, 0x8B); byte_yaz(a, 0x40); byte_yaz(a, 0x18);
    # atla_null
}

isv frame_dugum_boyutu(dugum: *AstDugum) -> tamsayi {
    eger dugum == 0 ise { dondu 0; }
    degisken toplam: tamsayi = 0;
    eger dugum.tip == AST_DEGISKEN_TANIMI ise {
        degisken elem_sz: tamsayi = 8;
        eger dugum.tip_adi != 0 ve dugum.tip_adi_uzunluk > 0 ise {
            elem_sz = tip_eleman_boyutu_al(dugum.tip_adi, dugum.tip_adi_uzunluk, dugum.cozumlenmis_tip);
        }
        eger dugum.dizi_boyutu > 0 ise {
            toplam = dugum.dizi_boyutu * elem_sz;
        } yoksa {
            toplam = elem_sz;
        }
        dondu toplam + frame_dugum_boyutu(dugum.sag);
    }
    eger dugum.tip == AST_BLOK ise {
        degisken iter: *AstDugum = dugum.sol;
        dongu iter != 0 {
            toplam = toplam + frame_dugum_boyutu(iter);
            iter = iter.sonraki;
        }
        dondu toplam;
    }
    eger dugum.tip == AST_EGER veya dugum.tip == AST_DONGU ise {
        toplam = toplam + frame_dugum_boyutu(dugum.sol);
        toplam = toplam + frame_dugum_boyutu(dugum.govde);
        toplam = toplam + frame_dugum_boyutu(dugum.yoksa_govde);
        dondu toplam;
    }
    toplam = toplam + frame_dugum_boyutu(dugum.sol);
    toplam = toplam + frame_dugum_boyutu(dugum.sag);
    dondu toplam;
}

isv emit_magic_div_mod(a: *MakineKoduArenasi, d: tamsayi, is_modulo: tamsayi) -> tamsayi {
    eger d <= 1 veya (d & (d - 1)) == 0 ise { dondu 0; }

    degisken half: tamsayi = 4611686018427387904; # 2^62
    degisken ad: tamsayi = d;
    degisken q_two: tamsayi = (2 * (half / ad)) + ((2 * (half % ad)) / ad);
    degisken r_two: tamsayi = (2 * (half % ad)) % ad;
    degisken anc: tamsayi = 9223372036854775807 - r_two;
    degisken p: tamsayi = 63;
    degisken q1: tamsayi = 1;
    degisken r1: tamsayi = r_two + 1;
    degisken q2: tamsayi = q_two;
    degisken r2: tamsayi = r_two;

    degisken dongu_devam: tamsayi = 1;
    dongu dongu_devam == 1 {
        p = p + 1;
        q1 = 2 * q1;
        r1 = 2 * r1;
        eger r1 >= anc ise {
            q1 = q1 + 1;
            r1 = r1 - anc;
        }
        q2 = 2 * q2;
        r2 = 2 * r2;
        eger r2 >= ad ise {
            q2 = q2 + 1;
            r2 = r2 - ad;
        }
        degisken delta: tamsayi = ad - r2;
        eger q1 < delta ise {
            # continue loop
        } yoksa eger q1 == delta ve r1 == 0 ise {
            # continue loop
        } yoksa {
            dongu_devam = 0;
        }
    }
    degisken M: tamsayi = q2 + 1;
    degisken s: tamsayi = p - 64;
    eger M < 0 ise { dondu 0; } # M >= 2^63

    # Input x is in RAX
    byte_yaz(a, 0x49); byte_yaz(a, 0x89); byte_yaz(a, 0xC2); # MOV R10, RAX
    byte_yaz(a, 0x48); byte_yaz(a, 0xB8); int64_yaz(a, M); # MOV RAX, M
    byte_yaz(a, 0x49); byte_yaz(a, 0xF7); byte_yaz(a, 0xEA); # IMUL R10 (RDX:RAX = RAX * R10)
    byte_yaz(a, 0x48); byte_yaz(a, 0x89); byte_yaz(a, 0xD0); # MOV RAX, RDX
    eger s > 0 ise {
        byte_yaz(a, 0x48); byte_yaz(a, 0xC1); byte_yaz(a, 0xF8); byte_yaz(a, s); # SAR RAX, s
    }
    byte_yaz(a, 0x4C); byte_yaz(a, 0x89); byte_yaz(a, 0xD1); # MOV RCX, R10
    byte_yaz(a, 0x48); byte_yaz(a, 0xC1); byte_yaz(a, 0xF9); byte_yaz(a, 63); # SAR RCX, 63
    byte_yaz(a, 0x48); byte_yaz(a, 0x29); byte_yaz(a, 0xC8); # SUB RAX, RCX (RAX = x / d)
    eger is_modulo == 1 ise {
        eger d <= 127 ise {
            byte_yaz(a, 0x48); byte_yaz(a, 0x6B); byte_yaz(a, 0xD0); byte_yaz(a, d); # IMUL RDX, RAX, d
        } yoksa eger d <= 2147483647 ise {
            byte_yaz(a, 0x48); byte_yaz(a, 0x69); byte_yaz(a, 0xD0); int32_yaz(a, d);
        } yoksa {
            dondu 0;
        }
        byte_yaz(a, 0x4C); byte_yaz(a, 0x89); byte_yaz(a, 0xD0); # MOV RAX, R10
        byte_yaz(a, 0x48); byte_yaz(a, 0x29); byte_yaz(a, 0xD0); # SUB RAX, RDX (RAX = x % d)
    }
    dondu 1;
}

isv emit_conditional_branch_helper(a: *MakineKoduArenasi, cond: *AstDugum) -> tamsayi {
    eger cond == 0 ise { dondu 0; }
    degisken fast_cmp: tamsayi = 0;
    degisken jmp_code: tamsayi = 0x84; # default JZ

    eger cond.tip == AST_IKILI_OP ve cond.ilk_jeton != 0 ve cond.sol != 0 ve cond.sag != 0 ise {
        degisken cmp_op: tamsayi = cond.ilk_jeton.tip;
        eger cmp_op == TIP_KUCUK_MU        ise { jmp_code = 0x8D; fast_cmp = 1; } # invert: JGE
        yoksa eger cmp_op == TIP_KUCUK_ESIT ise { jmp_code = 0x8F; fast_cmp = 1; } # invert: JG
        yoksa eger cmp_op == TIP_BUYUK_MU   ise { jmp_code = 0x8E; fast_cmp = 1; } # invert: JLE
        yoksa eger cmp_op == TIP_BUYUK_ESIT ise { jmp_code = 0x8C; fast_cmp = 1; } # invert: JL
        yoksa eger cmp_op == TIP_ESIT_MI    ise { jmp_code = 0x85; fast_cmp = 1; } # invert: JNE
        yoksa eger cmp_op == TIP_ESIT_DEGIL ise { jmp_code = 0x84; fast_cmp = 1; } # invert: JE
    }

    eger fast_cmp == 1 ise {
        ast_kod_uret(a, cond.sol);
        eger cond.sag.tip == AST_SAYI ve cond.sag.ilk_jeton != 0 ise {
            degisken imm: tamsayi = string_tamsayiya(cond.sag.ilk_jeton.baslangic, cond.sag.ilk_jeton.uzunluk);
            eger imm >= (0 - 128) ve imm <= 127 ise {
                byte_yaz(a, 0x48); byte_yaz(a, 0x83); byte_yaz(a, 0xF8); byte_yaz(a, imm);
            } yoksa eger imm >= (0 - 2147483648) ve imm <= 2147483647 ise {
                byte_yaz(a, 0x48); byte_yaz(a, 0x3D); int32_yaz(a, imm);
            } yoksa {
                byte_yaz(a, 0x48); byte_yaz(a, 0xB9); int64_yaz(a, imm);
                byte_yaz(a, 0x48); byte_yaz(a, 0x39); byte_yaz(a, 0xC8);
            }
        } yoksa {
            degisken sag_into_rcx_branch: tamsayi = 0;
            eger cond.sag != 0 ve cond.sag.tip == AST_KIMLIK ve cond.sag.ilk_jeton != 0 ise {
                degisken r_reg_sag: tamsayi = ra_degisken_reg_bul(cond.sag.ilk_jeton.baslangic, cond.sag.ilk_jeton.uzunluk);
                eger r_reg_sag > 0 ise {
                    emit_mov_rcx_reg(a, r_reg_sag);
                    sag_into_rcx_branch = 1;
                } yoksa {
                    degisken sag_off: tamsayi = lokal_bul_offset(cond.sag.ilk_jeton.baslangic, cond.sag.ilk_jeton.uzunluk);
                    degisken sag_dizi: tamsayi = lokal_bul_dizi(cond.sag.ilk_jeton.baslangic, cond.sag.ilk_jeton.uzunluk);
                    eger sag_off != 0 ve sag_dizi == 0 ise {
                        eger sag_off <= 127 ise {
                            byte_yaz(a, 0x48); byte_yaz(a, 0x8B); byte_yaz(a, 0x4D); byte_yaz(a, 256 - sag_off);
                        } yoksa {
                            byte_yaz(a, 0x48); byte_yaz(a, 0x8B); byte_yaz(a, 0x8D); int32_yaz(a, 0 - sag_off);
                        }
                        sag_into_rcx_branch = 1;
                    }
                }
            }
            eger sag_into_rcx_branch == 0 ise {
                byte_yaz(a, 0x50); # PUSH RAX
                ast_kod_uret(a, cond.sag);
                byte_yaz(a, 0x48); byte_yaz(a, 0x89); byte_yaz(a, 0xC1); # MOV RCX, RAX
                byte_yaz(a, 0x58); # POP RAX
            }
            byte_yaz(a, 0x48); byte_yaz(a, 0x39); byte_yaz(a, 0xC8); # CMP RAX, RCX
        }
        byte_yaz(a, 0x0F); byte_yaz(a, jmp_code);
        degisken rel_pos: tamsayi = a.kullanilan;
        int32_yaz(a, 0);
        dondu rel_pos;
    } yoksa {
        ast_kod_uret(a, cond);
        byte_yaz(a, 0x48); byte_yaz(a, 0x85); byte_yaz(a, 0xC0); # TEST RAX, RAX
        byte_yaz(a, 0x0F); byte_yaz(a, 0x84); # JZ
        degisken rel_pos: tamsayi = a.kullanilan;
        int32_yaz(a, 0);
        dondu rel_pos;
    }
}

degisken g_expr_struct_tip_adi: *u8 = 0;
degisken g_expr_struct_tip_uzn: tamsayi = 0;

isv expr_struct_type(expr: *AstDugum) {
    g_expr_struct_tip_adi = 0;
    g_expr_struct_tip_uzn = 0;
    eger expr == 0 ise { dondu; }

    eger expr.tip == AST_KIMLIK ve expr.ilk_jeton != 0 ise {
        degisken uzn: tamsayi = expr.ilk_jeton.uzunluk;
        degisken isim: *u8 = expr.ilk_jeton.baslangic;
        degisken ki: tamsayi = 0;
        dongu ki < g_lokal_adet {
            eger g_lokal_isimleri[ki] != 0 ve g_lokal_uzunluklari[ki] == uzn ise {
                eger bellek_esit_mi(g_lokal_isimleri[ki], isim, uzn) == 1 ise {
                    g_expr_struct_tip_adi = g_lokal_tip_adlari[ki];
                    g_expr_struct_tip_uzn = g_lokal_tip_uzunluklari[ki];
                    dondu;
                }
            }
            ki = ki + 1;
        }
        degisken gi: tamsayi = 0;
        dongu gi < g_global_sayisi {
            eger g_global_uzunluk[gi] == uzn ise {
                eger bellek_esit_mi(g_global_isim[gi], isim, uzn) == 1 ise {
                    g_expr_struct_tip_adi = g_global_tip_adi[gi];
                    g_expr_struct_tip_uzn = g_global_tip_adi_uzunluk[gi];
                    dondu;
                }
            }
            gi = gi + 1;
        }
    } yoksa eger expr.tip == 20 ve expr.sag != 0 ise { # AST_REFERANS: &x
        expr_struct_type(expr.sag);
        dondu;
    } yoksa eger expr.tip == 18 ve expr.sol != 0 ise { # AST_INDEKS_ERISIMI: arr[i]
        expr_struct_type(expr.sol);
        eger g_expr_struct_tip_adi != 0 ve g_expr_struct_tip_uzn > 1 ve g_expr_struct_tip_adi[0] == 42 ise { # '*'
            g_expr_struct_tip_adi = g_expr_struct_tip_adi + 1;
            g_expr_struct_tip_uzn = g_expr_struct_tip_uzn - 1;
        }
        dondu;
    } yoksa eger expr.tip == 17 ve expr.sol != 0 ve expr.sag != 0 ise { # AST_ALAN_ERISIMI: a.b
        expr_struct_type(expr.sol);
        degisken parent_t: *u8 = g_expr_struct_tip_adi;
        degisken parent_len: tamsayi = g_expr_struct_tip_uzn;
        g_expr_struct_tip_adi = 0;
        g_expr_struct_tip_uzn = 0;
        eger parent_t != 0 ve parent_len > 0 ise {
            eger parent_t[0] == 42 ise { # '*'
                parent_t = parent_t + 1;
                parent_len = parent_len - 1;
            }
            degisken k: tamsayi = 0;
            dongu k < parent_len {
                eger parent_t[k] == 60 ise { parent_len = k; } # '<'
                k = k + 1;
            }
            eger expr.sag.ilk_jeton != 0 ise {
                degisken f_len: tamsayi = expr.sag.ilk_jeton.uzunluk;
                degisken f_isim: *u8 = expr.sag.ilk_jeton.baslangic;
                degisken yi: tamsayi = 0;
                dongu yi < g_yapi_adet {
                    eger g_yapi_uzunluk[yi] == parent_len ise {
                        eger bellek_esit_mi(g_yapi_isim[yi], parent_t, parent_len) == 1 ise {
                            degisken ai: tamsayi = 0;
                            dongu ai < g_yapi_alan_sayisi[yi] {
                                degisken a_idx: tamsayi = (yi * 32) + ai;
                                eger g_yapi_alan_uzunluk[a_idx] == f_len ise {
                                    eger bellek_esit_mi(g_yapi_alan_isim[a_idx], f_isim, f_len) == 1 ise {
                                        g_expr_struct_tip_adi = g_yapi_alan_tip_adi[a_idx];
                                        g_expr_struct_tip_uzn = g_yapi_alan_tip_uzn[a_idx];
                                        dondu;
                                    }
                                }
                                ai = ai + 1;
                            }
                        }
                    }
                    yi = yi + 1;
                }
            }
        }
    } yoksa eger expr.tip == 11 ve expr.sol != 0 ve expr.sol.ilk_jeton != 0 ise { # AST_ISLEV_CAGRISI
        degisken fn_len: tamsayi = expr.sol.ilk_jeton.uzunluk;
        degisken fn_isim: *u8 = expr.sol.ilk_jeton.baslangic;
        eger fn_len == 12 ve bellek_esit_mi(fn_isim, "suanki_jeton".ptr, 12) == 1 ise {
            g_expr_struct_tip_adi = "Jeton".ptr;
            g_expr_struct_tip_uzn = 5;
            dondu;
        }
    }
    eger g_expr_struct_tip_adi == 0 ve expr.tip_adi != 0 ve expr.tip_adi_uzunluk > 0 ise {
        g_expr_struct_tip_adi = expr.tip_adi;
        g_expr_struct_tip_uzn = expr.tip_adi_uzunluk;
    }
}

isv ast_kod_uret(a: *MakineKoduArenasi, dugum: *AstDugum) -> tamsayi {
    eger dugum == 0 ise { dondu 0; }
    eger g_ast_mutasyon_aktif == 1 ve g_ast_mutasyon_uygulandi == 0 ve
       dugum.tip == g_ast_mutasyon_hedef ise {
        dugum.tip = 255;
        g_ast_mutasyon_uygulandi = 1;
    }
    verbose_yaz("CG_NODE: tip=".ptr);
    verbose_sayi(dugum.tip);
    verbose_yaz("\n".ptr);
    eger dugum.tip == AST_MODUL ise { # AST_MODUL
        # Inline modul fonksiyonlarinin adini kopyalamak yerine module
        # bilgisini sembol tablosunda tut. Bu, self-hosted pointer byte-copy
        # farklarindan bagimsiz ve cakismasiz bir ABI eslesmesi saglar.
        eger dugum.govde != 0 ise {
            degisken eski_modul_isim: *u8 = g_codegen_modul_isim;
            degisken eski_modul_uzn: tamsayi = g_codegen_modul_uzunluk;
            g_codegen_modul_isim = dugum.ilk_jeton.baslangic;
            g_codegen_modul_uzunluk = dugum.ilk_jeton.uzunluk;
            degisken m_iter: *AstDugum = dugum.govde.sol;
            dongu m_iter != 0 {
                ast_kod_uret(a, m_iter);
                m_iter = m_iter.sonraki;
            }
            g_codegen_modul_isim = eski_modul_isim;
            g_codegen_modul_uzunluk = eski_modul_uzn;
        }
        dondu 0;
    }
    eger g_global_sabitleri_toplandi == 0 ise {
        global_sabitleri_topla(dugum, 0);
        yapilari_topla(dugum);
        g_global_sabitleri_toplandi = 1;
    }

    eger dugum.tip == AST_SAYI ise {
        degisken sayi: tamsayi = string_tamsayiya(dugum.ilk_jeton.baslangic, dugum.ilk_jeton.uzunluk);
        emit_mov_rax_imm32(a, sayi);
        dondu 0;
    }

    eger dugum.tip == AST_GERCEK_SAYI ise {
        degisken u64val: tamsayi = string_gerceksayiya_ieee754(dugum.ilk_jeton.baslangic, dugum.ilk_jeton.uzunluk);
        byte_yaz(a, 0x48); byte_yaz(a, 0xB8);
        int64_yaz(a, u64val);
        byte_yaz(a, 0x66); byte_yaz(a, 0x48); byte_yaz(a, 0x0F); byte_yaz(a, 0x6E); byte_yaz(a, 0xC0);
        dondu 0;
    }

    # --------------------------------------------------------
    # AST_METIN: String verisini atla, RAX'a adresini LEA ile yukle
    # --------------------------------------------------------
    eger dugum.tip == AST_METIN ise {
        degisken ic_uzunluk: tamsayi = dugum.ilk_jeton.uzunluk;
        degisken ic_baslangic: *u8 = dugum.ilk_jeton.baslangic;
        
        eger ic_uzunluk >= 2 ve ic_baslangic[0] == 34 ise { # '"'
            ic_baslangic = ic_baslangic + 1;
            ic_uzunluk = ic_uzunluk - 2;
        }
        
        degisken gercek_uzunluk: tamsayi = 0;
        degisken i: tamsayi = 0;
        dongu i < ic_uzunluk {
            eger ic_baslangic[i] == 92 ve (i + 1) < ic_uzunluk {
                degisken c2: tamsayi = ic_baslangic[i + 1];
                eger c2 == 110 ise { # '\n'
                    gercek_uzunluk = gercek_uzunluk + 1;
                    i = i + 1;
                } yoksa eger c2 == 114 ise { # '\r'
                    gercek_uzunluk = gercek_uzunluk + 1;
                    i = i + 1;
                } yoksa eger c2 == 116 ise { # '\t'
                    gercek_uzunluk = gercek_uzunluk + 1;
                    i = i + 1;
                } yoksa eger c2 == 101 ise { # '\e' (27)
                    gercek_uzunluk = gercek_uzunluk + 1;
                    i = i + 1;
                } yoksa eger c2 == 92 ise { # '\\'
                    gercek_uzunluk = gercek_uzunluk + 1;
                    i = i + 1;
                } yoksa eger c2 == 34 ise { # '\"'
                    gercek_uzunluk = gercek_uzunluk + 1;
                    i = i + 1;
                } yoksa eger c2 == 120 ve (i + 3) < ic_uzunluk ise { # '\xHH'
                    gercek_uzunluk = gercek_uzunluk + 1;
                    i = i + 3;
                } yoksa eger c2 == 48 ve (i + 3) < ic_uzunluk ve ic_baslangic[i + 2] >= 48 ve ic_baslangic[i + 2] <= 55 ve ic_baslangic[i + 3] >= 48 ve ic_baslangic[i + 3] <= 55 ise { # '\0oo' e.g. \033
                    gercek_uzunluk = gercek_uzunluk + 1;
                    i = i + 3;
                } yoksa {
                    gercek_uzunluk = gercek_uzunluk + 1;
                }
            } yoksa {
                gercek_uzunluk = gercek_uzunluk + 1;
            }
            i = i + 1;
        }
        
        byte_yaz(a, 0xE9);
        int32_yaz(a, gercek_uzunluk + 1);
        
        degisken str_pos: tamsayi = a.kullanilan;
        i = 0;
        dongu i < ic_uzunluk {
            eger ic_baslangic[i] == 92 ve (i + 1) < ic_uzunluk {
                degisken c2: tamsayi = ic_baslangic[i + 1];
                eger c2 == 110 ise { # '\n'
                    byte_yaz(a, 10);
                    i = i + 1;
                } yoksa eger c2 == 114 ise { # '\r'
                    byte_yaz(a, 13);
                    i = i + 1;
                } yoksa eger c2 == 116 ise { # '\t'
                    byte_yaz(a, 9);
                    i = i + 1;
                } yoksa eger c2 == 101 ise { # '\e'
                    byte_yaz(a, 27);
                    i = i + 1;
                } yoksa eger c2 == 92 ise { # '\\'
                    byte_yaz(a, 92);
                    i = i + 1;
                } yoksa eger c2 == 34 ise { # '\"'
                    byte_yaz(a, 34);
                    i = i + 1;
                } yoksa eger c2 == 120 ve (i + 3) < ic_uzunluk ise { # '\xHH'
                    degisken h1: tamsayi = ic_baslangic[i + 2];
                    degisken h2: tamsayi = ic_baslangic[i + 3];
                    degisken v1: tamsayi = 0;
                    degisken v2: tamsayi = 0;
                    eger h1 >= 48 ve h1 <= 57 ise { v1 = h1 - 48; }
                    yoksa eger h1 >= 65 ve h1 <= 70 ise { v1 = h1 - 55; }
                    yoksa eger h1 >= 97 ve h1 <= 102 ise { v1 = h1 - 87; }
                    eger h2 >= 48 ve h2 <= 57 ise { v2 = h2 - 48; }
                    yoksa eger h2 >= 65 ve h2 <= 70 ise { v2 = h2 - 55; }
                    yoksa eger h2 >= 97 ve h2 <= 102 ise { v2 = h2 - 87; }
                    byte_yaz(a, v1 * 16 + v2);
                    i = i + 3;
                } yoksa eger c2 == 48 ve (i + 3) < ic_uzunluk ve ic_baslangic[i + 2] >= 48 ve ic_baslangic[i + 2] <= 55 ve ic_baslangic[i + 3] >= 48 ve ic_baslangic[i + 3] <= 55 ise { # '\0oo' e.g. \033
                    degisken o1: tamsayi = ic_baslangic[i + 2] - 48;
                    degisken o2: tamsayi = ic_baslangic[i + 3] - 48;
                    byte_yaz(a, o1 * 8 + o2);
                    i = i + 3;
                } yoksa {
                    byte_yaz(a, ic_baslangic[i]);
                }
            } yoksa {
                byte_yaz(a, ic_baslangic[i]);
            }
            i = i + 1;
        }
        byte_yaz(a, 0);
        
        byte_yaz(a, 0x48); byte_yaz(a, 0x8D); byte_yaz(a, 0x05);
        int32_yaz(a, str_pos - (a.kullanilan + 4));
        dondu 0;
    }

    # --------------------------------------------------------
    # AST_FSTRING: f"..." interpolasyonu
    # Strateji: derleme zamaninda icerik bolunur, birlestirme emit edilir.
    # RCX=str1, RDX=str2 -> emit_string_concat_inline -> RAX=sonuc
    # --------------------------------------------------------
    eger dugum.tip == AST_FSTRING ise {
        eger dugum.ilk_jeton == 0 ise {
            # Bos f-string: bos null-terminated string emit et
            byte_yaz(a, 0xE9);
            int32_yaz(a, 1);
            byte_yaz(a, 0);
            byte_yaz(a, 0x48); byte_yaz(a, 0x8D); byte_yaz(a, 0x05);
            int32_yaz(a, 0 - 6 - 1);
            dondu 0;
        }
        degisken fs_ptr: *u8 = dugum.ilk_jeton.baslangic;
        degisken fs_uzn: tamsayi = dugum.ilk_jeton.uzunluk;

        # Oncelikle bos string olarak RAX baslatiyoruz
        # JMP rel32; '\0'; LEA RAX,[RIP-...]
        byte_yaz(a, 0xE9);
        int32_yaz(a, 1);
        byte_yaz(a, 0); # bos null-terminated string
        degisken empty_str_pos: tamsayi = a.kullanilan - 1;
        byte_yaz(a, 0x48); byte_yaz(a, 0x8D); byte_yaz(a, 0x05);
        int32_yaz(a, empty_str_pos - (a.kullanilan + 4));

        # Simdi icerik segmentlerini isle
        degisken pos: tamsayi = 0;
        dongu pos < fs_uzn {
            # Sonraki { konumuna kadar literal segment tara
            degisken seg_bas: tamsayi = pos;
            dongu pos < fs_uzn ve fs_ptr[pos] != 123 { # 123 = '{'
                pos = pos + 1;
            }
            degisken seg_uzn: tamsayi = pos - seg_bas;

            # Literal segment emit et (bos olmamali)
            eger seg_uzn > 0 ise {
                # PUSH RAX (mevcut akumule sonucu sakla)
                byte_yaz(a, 0x50);
                # Literal stringi data bolgesine gomme: JMP over; bytes; LEA RAX
                byte_yaz(a, 0xE9);
                int32_yaz(a, seg_uzn + 1);
                degisken lit_data_pos: tamsayi = a.kullanilan;
                degisken seg_i: tamsayi = seg_bas;
                dongu seg_i < seg_bas + seg_uzn {
                    byte_yaz(a, fs_ptr[seg_i]);
                    seg_i = seg_i + 1;
                }
                byte_yaz(a, 0); # null terminator
                byte_yaz(a, 0x48); byte_yaz(a, 0x8D); byte_yaz(a, 0x05);
                int32_yaz(a, lit_data_pos - (a.kullanilan + 4));
                # RAX = literal string pointer
                # MOV RDX, RAX
                byte_yaz(a, 0x48); byte_yaz(a, 0x89); byte_yaz(a, 0xC2);
                # POP RCX (str1 = onceki sonuc)
                byte_yaz(a, 0x59);
                emit_string_concat_inline(a);
                # RAX = birlesmis string
            }

            # { ifade } parcasi var mi?
            eger pos < fs_uzn ise {
                pos = pos + 1; # '{' atla (ASCII 123)
                degisken expr_bas: tamsayi = pos;
                dongu pos < fs_uzn ve fs_ptr[pos] != 125 { # 125 = '}'
                    pos = pos + 1;
                }
                degisken expr_uzn: tamsayi = pos - expr_bas;
                eger pos < fs_uzn ise { pos = pos + 1; } # '}' atla

                eger expr_uzn > 0 ise {
                    # PUSH RAX (mevcut akumule sonucu sakla)
                    byte_yaz(a, 0x50);
                    degisken syn_d: *AstDugum = parse_fstring_subexpr(fs_ptr + expr_bas, expr_uzn, dugum.ilk_jeton.satir, dugum.ilk_jeton.sutun);
                    eger syn_d != 0 ise {
                        ast_kod_uret(a, syn_d);
                        eger ast_node_is_string(syn_d) == 0 ise {
                            emit_i64_to_string(a);
                        }
                    } yoksa {
                        byte_yaz(a, 0xE9);
                        int32_yaz(a, 1);
                        byte_yaz(a, 0);
                        degisken e_pos: tamsayi = a.kullanilan - 1;
                        byte_yaz(a, 0x48); byte_yaz(a, 0x8D); byte_yaz(a, 0x05);
                        int32_yaz(a, e_pos - (a.kullanilan + 4));
                    }
                    # MOV RDX, RAX (ifade degeri = str2)
                    byte_yaz(a, 0x48); byte_yaz(a, 0x89); byte_yaz(a, 0xC2);
                    # POP RCX (str1 = onceki akumule sonuc)
                    byte_yaz(a, 0x59);
                    emit_string_concat_inline(a);
                }
            }
        }
        dondu 0;
    }

    # --------------------------------------------------------
    # AST_KIMLIK: Yerel degisken degerini RAX'e yukle
    # --------------------------------------------------------
    eger dugum.tip == AST_KIMLIK ise {
        eger dugum.ilk_jeton == 0 ise {
            emit_xor_rax_rax(a);
            dondu 0;
        }
        degisken off: tamsayi = lokal_bul_offset(dugum.ilk_jeton.baslangic, dugum.ilk_jeton.uzunluk);
        degisken var_dizi: tamsayi = lokal_bul_dizi(dugum.ilk_jeton.baslangic, dugum.ilk_jeton.uzunluk);
        degisken yildiz: tamsayi = lokal_bul_yildiz(dugum.ilk_jeton.baslangic, dugum.ilk_jeton.uzunluk);
        degisken is_local_struct: tamsayi = 0;
        eger yildiz == 0 ise {
            degisken tip_adi: *u8 = lokal_bul_tip_adi(dugum.ilk_jeton.baslangic, dugum.ilk_jeton.uzunluk);
            eger tip_adi != 0 ise {
                degisken tip_uzn: tamsayi = lokal_bul_tip_uzn(dugum.ilk_jeton.baslangic, dugum.ilk_jeton.uzunluk);
                degisken ji: tamsayi = 0;
                dongu ji < g_yapi_adet {
                    eger g_yapi_uzunluk[ji] == tip_uzn ise {
                        eger bellek_esit_mi(g_yapi_isim[ji], tip_adi, tip_uzn) == 1 ise {
                            is_local_struct = 1;
                        }
                    }
                    ji = ji + 1;
                }
                eger enum_turu_mi(tip_adi, tip_uzn) == 1 ise { is_local_struct = 2; }
            }
        }
        eger off != 0 ise {
            eger var_dizi > 0 veya is_local_struct == 1 ise {
                emit_lea_rax(a, off);
            } yoksa {
                degisken r_reg: tamsayi = 0;
                eger g_lambda_tabani == 0 ise {
                    r_reg = ra_degisken_reg_bul(dugum.ilk_jeton.baslangic, dugum.ilk_jeton.uzunluk);
                }
                eger r_reg > 0 ise {
                    emit_mov_rax_reg(a, r_reg);
                } yoksa {
                    emit_load_rax(a, off);
                }
            }
        } yoksa {
            degisken outer_off: tamsayi = lokal_bul_outer_offset(dugum.ilk_jeton.baslangic, dugum.ilk_jeton.uzunluk);
            eger outer_off != 0 ise {
                byte_yaz(a, 0x48); byte_yaz(a, 0x8B); byte_yaz(a, 0x55); byte_yaz(a, 0); # MOV RDX, [RBP + 0]
                eger outer_off <= 127 ise {
                    byte_yaz(a, 0x48); byte_yaz(a, 0x8B); byte_yaz(a, 0x42); byte_yaz(a, 256 - outer_off);
                } yoksa {
                    byte_yaz(a, 0x48); byte_yaz(a, 0x8B); byte_yaz(a, 0x82); int32_yaz(a, 0 - outer_off);
                }
                dondu 0;
            }
            degisken g_idx: tamsayi = 0 - 1;
            degisken gi: tamsayi = 0;
            dongu gi < g_global_sayisi {
                eger g_global_uzunluk[gi] == dugum.ilk_jeton.uzunluk ise {
                    eger bellek_esit_mi(g_global_isim[gi], dugum.ilk_jeton.baslangic, dugum.ilk_jeton.uzunluk) == 1 ise {
                        g_idx = gi;
                    }
                }
                gi = gi + 1;
            }
            eger g_idx != 0 - 1 ise {
                degisken is_global_struct: tamsayi = 0;
                degisken gtip: *u8 = g_global_tip_adi[g_idx];
                degisken gt_uzn: tamsayi = g_global_tip_adi_uzunluk[g_idx];
                eger gtip != 0 ve g_global_is_pointer[g_idx] == 0 ise {
                    degisken jg: tamsayi = 0;
                    dongu jg < g_yapi_adet {
                        eger g_yapi_uzunluk[jg] == gt_uzn ise {
                            eger bellek_esit_mi(g_yapi_isim[jg], gtip, gt_uzn) == 1 ise {
                                is_global_struct = 1;
                            }
                        }
                        jg = jg + 1;
                    }
                }
                degisken g_addr: tamsayi = g_global_adres[g_idx];
                eger g_global_dizi_boyutu[g_idx] > 0 veya is_global_struct == 1 ise {
                    byte_yaz(a, 72); byte_yaz(a, 141); byte_yaz(a, 5);
                } yoksa {
                    byte_yaz(a, 72); byte_yaz(a, 139); byte_yaz(a, 5);
                }
                int32_yaz(a, g_addr - (a.kullanilan + 4));
            } yoksa {
                degisken gval: tamsayi = global_sabit_bul(dugum.ilk_jeton.baslangic, dugum.ilk_jeton.uzunluk);
                eger g_sabit_bulundu == 1 ise {
                    emit_mov_rax_imm32(a, gval);
                } yoksa {
                    # Fonksiyon referansi (function pointer / LEA RAX, [RIP + rel32])
                    byte_yaz(a, 0x48); byte_yaz(a, 0x8D); byte_yaz(a, 0x05);
                    eger yama_kapasite_kontrol() == 0 ise { dondu 0; }
                    degisken y_idx: tamsayi = g_yama_adet;
                    g_yama_isim[y_idx] = dugum.ilk_jeton.baslangic;
                    g_yama_uzunluk[y_idx] = dugum.ilk_jeton.uzunluk;
                    g_yama_adres[y_idx] = 0;
                    g_yama_tip[y_idx] = 0;
                    g_yama_cagri_pos[y_idx] = a.kullanilan;
                    g_yama_adet = g_yama_adet + 1;
                    int32_yaz(a, 0);
                }
            }
        }
        dondu 0;
    }

    # --------------------------------------------------------
    # AST_DEGISKEN_TANIMI (7): Stack'te yer ac, ilk degeri kaydet
    # --------------------------------------------------------
    eger dugum.tip == 7 veya dugum.tip == AST_DEGISKEN_TANIMI ise {
        eger g_fonksiyon_icinde == 0 ise {
            # Global init collection fazı storage'ı önceden ayırdıysa AST
            # traversal aynı declaration'ı ikinci kez üretmez.
            eger dugum.ilk_jeton != 0 ise {
                degisken mevcut_global: tamsayi = 0;
                degisken mevcut_i: tamsayi = 0;
                dongu mevcut_i < g_global_sayisi {
                    eger g_global_uzunluk[mevcut_i] == dugum.ilk_jeton.uzunluk ve
                        bellek_esit_mi(g_global_isim[mevcut_i], dugum.ilk_jeton.baslangic, dugum.ilk_jeton.uzunluk) == 1 ise {
                        mevcut_global = 1;
                    }
                    mevcut_i = mevcut_i + 1;
                }
                eger mevcut_global == 1 ise { dondu 0; }
            }
            degisken obj_isim: *u8 = 0;
            degisken obj_uzn: tamsayi = 0;
            eger dugum.ilk_jeton != 0 ise {
                degisken j1: *Jeton = dugum.ilk_jeton;
                obj_isim = j1.baslangic;
                obj_uzn = j1.uzunluk;
            }
            degisken gval: tamsayi = 0;
            degisken gval_bulundu: tamsayi = 0;
            eger dugum.sag != 0 ve dugum.sag.tip == 1 ise {
                degisken s_j: *Jeton = dugum.sag.ilk_jeton;
                gval = string_tamsayiya(s_j.baslangic, s_j.uzunluk);
                gval_bulundu = 1;
            }
            eger gval_bulundu == 1 ise {
                global_sabit_ekle(obj_isim, obj_uzn, gval);
            }
            degisken g_size: tamsayi = 8192;
            eger dugum.dizi_boyutu > 0 ise {
                g_size = dugum.dizi_boyutu * 8;
                eger g_size < 8192 ise { g_size = 8192; }
            }
            byte_yaz(a, 233);
            int32_yaz(a, g_size);
            degisken g_addr: tamsayi = a.kullanilan;
            eger gval_bulundu == 1 ise {
                int64_yaz(a, gval);
                a.kullanilan = a.kullanilan + (g_size - 8);
            } yoksa {
                a.kullanilan = a.kullanilan + g_size;
            }
            eger g_global_sayisi >= 16384 ise {
                codegen_kapasite_reddet(4);
                dondu 0;
            }
            eger g_global_sayisi < 16384 ise {
                g_global_isim[g_global_sayisi] = obj_isim;
                g_global_uzunluk[g_global_sayisi] = obj_uzn;
                g_global_adres[g_global_sayisi] = g_addr;
                g_global_tip_adi[g_global_sayisi] = dugum.tip_adi;
                g_global_tip_adi_uzunluk[g_global_sayisi] = dugum.tip_adi_uzunluk;
                g_global_is_pointer[g_global_sayisi] = dugum.cozumlenmis_tip;
                g_global_dizi_boyutu[g_global_sayisi] = dugum.dizi_boyutu;
                g_global_sayisi = g_global_sayisi + 1;
            }
            dondu 0;
        }

        # Once baslangic degerini hesapla (RAX'e)
        eger dugum.sag != 0 ise {
            ast_kod_uret(a, dugum.sag);
        } yoksa {
            emit_xor_rax_rax(a);
        }
        # Lokal tablosuna kaydet, stack offset al. Enum degeri pointer ABI
        # kullandigi icin field access'te slot adresi degil pointer yuklenir.
        degisken lokal_abi_yildiz: tamsayi = dugum.cozumlenmis_tip;
        eger enum_turu_mi(dugum.tip_adi, dugum.tip_adi_uzunluk) == 1 ise {
            lokal_abi_yildiz = 1;
        }
        degisken off: tamsayi = lokal_kaydet(
            dugum.ilk_jeton.baslangic,
            dugum.ilk_jeton.uzunluk,
            dugum.dizi_boyutu,
            dugum.tip_adi,
            dugum.tip_adi_uzunluk,
            lokal_abi_yildiz
        );
        # RAX'i [RBP - off] adresine yaz. Enum constructor heap pointer
        # döndürür; inline enum ABI için iki alanı lokal slota kopyala.
        emit_store_rax(a, off);
        degisken r_reg: tamsayi = ra_degisken_reg_bul(dugum.ilk_jeton.baslangic, dugum.ilk_jeton.uzunluk);
        eger r_reg > 0 ise {
            emit_mov_reg_rax(a, r_reg);
        }
        degisken eff_t_adi: *u8 = dugum.tip_adi;
        degisken eff_t_uzn: tamsayi = dugum.tip_adi_uzunluk;
        eger (eff_t_adi == 0 veya eff_t_uzn <= 0) ve dugum.sag != 0 ise {
            degisken rhs: *AstDugum = dugum.sag;
            eger rhs.ilk_jeton != 0 ve raii_destructor_tipi_var_mi(rhs.ilk_jeton.baslangic, rhs.ilk_jeton.uzunluk) == 1 ise {
                eff_t_adi = rhs.ilk_jeton.baslangic;
                eff_t_uzn = rhs.ilk_jeton.uzunluk;
            } yoksa eger rhs.sol != 0 ve rhs.sol.ilk_jeton != 0 ve raii_destructor_tipi_var_mi(rhs.sol.ilk_jeton.baslangic, rhs.sol.ilk_jeton.uzunluk) == 1 ise {
                eff_t_adi = rhs.sol.ilk_jeton.baslangic;
                eff_t_uzn = rhs.sol.ilk_jeton.uzunluk;
            }
        }
        raii_degisken_kontrol(eff_t_adi, eff_t_uzn, off);
        dondu 0;
    }

    # --------------------------------------------------------
    # AST_ATAMA: sag = ifade, sol = hedef (KIMLIK veya INDEKS)
    # --------------------------------------------------------
    eger dugum.tip == AST_ATAMA ise {
        degisken sol: *AstDugum = dugum.sol;
        degisken sag: *AstDugum = dugum.sag;
        eger sol != 0 ve sol.tip == AST_KIMLIK ve sol.ilk_jeton != 0 ve sag != 0 ve sag.tip == AST_IKILI_OP ve sag.ilk_jeton != 0 ise {
            degisken bin_op: tamsayi = sag.ilk_jeton.tip;
            eger bin_op == TIP_ARTI veya bin_op == TIP_EKSI ise {
                eger sag.sol != 0 ve sag.sol.tip == AST_KIMLIK ve sag.sol.ilk_jeton != 0 ise {
                    eger sag.sol.ilk_jeton.uzunluk == sol.ilk_jeton.uzunluk ve bellek_esit_mi(sag.sol.ilk_jeton.baslangic, sol.ilk_jeton.baslangic, sol.ilk_jeton.uzunluk) == 1 ise {
                        degisken off: tamsayi = lokal_bul_offset(sol.ilk_jeton.baslangic, sol.ilk_jeton.uzunluk);
                        eger off != 0 ise {
                            degisken r_reg_opt: tamsayi = ra_degisken_reg_bul(sol.ilk_jeton.baslangic, sol.ilk_jeton.uzunluk);
                            eger sag.sag != 0 ve sag.sag.tip == AST_SAYI ve sag.sag.ilk_jeton != 0 ise {
                                degisken c: tamsayi = string_tamsayiya(sag.sag.ilk_jeton.baslangic, sag.sag.ilk_jeton.uzunluk);
                                eger c >= (0 - 128) ve c <= 127 ise {
                                    eger r_reg_opt > 0 ise {
                                        eger bin_op == TIP_ARTI ise {
                                            emit_add_reg_imm8(a, r_reg_opt, c);
                                        } yoksa {
                                            emit_sub_reg_imm8(a, r_reg_opt, c);
                                        }
                                    }
                                    eger bin_op == TIP_ARTI ise {
                                        eger off <= 127 ise {
                                            byte_yaz(a, 0x48); byte_yaz(a, 0x83); byte_yaz(a, 0x45);
                                            byte_yaz(a, 256 - off); byte_yaz(a, c);
                                        } yoksa {
                                            byte_yaz(a, 0x48); byte_yaz(a, 0x83); byte_yaz(a, 0x85);
                                            int32_yaz(a, 0 - off); byte_yaz(a, c);
                                        }
                                    } yoksa {
                                        eger off <= 127 ise {
                                            byte_yaz(a, 0x48); byte_yaz(a, 0x83); byte_yaz(a, 0x6D);
                                            byte_yaz(a, 256 - off); byte_yaz(a, c);
                                        } yoksa {
                                            byte_yaz(a, 0x48); byte_yaz(a, 0x83); byte_yaz(a, 0xAD);
                                            int32_yaz(a, 0 - off); byte_yaz(a, c);
                                        }
                                    }
                                    dondu 0;
                                }
                            }
                            ast_kod_uret(a, sag.sag);
                            eger r_reg_opt > 0 ise {
                                eger bin_op == TIP_ARTI ise {
                                    emit_add_reg_rax(a, r_reg_opt);
                                } yoksa {
                                    emit_sub_reg_rax(a, r_reg_opt);
                                }
                            }
                            eger bin_op == TIP_ARTI ise {
                                eger off <= 127 ise {
                                    byte_yaz(a, 0x48); byte_yaz(a, 0x01); byte_yaz(a, 0x45);
                                    byte_yaz(a, 256 - off);
                                } yoksa {
                                    byte_yaz(a, 0x48); byte_yaz(a, 0x01); byte_yaz(a, 0x85);
                                    int32_yaz(a, 0 - off);
                                }
                            } yoksa {
                                eger off <= 127 ise {
                                    byte_yaz(a, 0x48); byte_yaz(a, 0x29); byte_yaz(a, 0x45);
                                    byte_yaz(a, 256 - off);
                                } yoksa {
                                    byte_yaz(a, 0x48); byte_yaz(a, 0x29); byte_yaz(a, 0x85);
                                    int32_yaz(a, 0 - off);
                                }
                            }
                            dondu 0;
                        }
                    }
                }
            }
        }
        ast_kod_uret(a, dugum.sag);
        degisken sol: *AstDugum = dugum.sol;
        eger sol == 0 ise {
            dondu 0;
        }
        # Basit degisken atamasi: x = ifade
        eger sol.tip == AST_KIMLIK ise {
            eger sol.ilk_jeton == 0 ise {
                dondu 0;
            }
            eger sol.ilk_jeton.baslangic == 0 veya sol.ilk_jeton.uzunluk == 0 ise {
                dondu 0;
            }
            degisken off: tamsayi = lokal_bul_offset(sol.ilk_jeton.baslangic, sol.ilk_jeton.uzunluk);
            eger off != 0 ise {
                emit_store_rax(a, off);
                degisken r_reg_asgn: tamsayi = 0;
                eger g_lambda_tabani == 0 ise {
                    r_reg_asgn = ra_degisken_reg_bul(sol.ilk_jeton.baslangic, sol.ilk_jeton.uzunluk);
                }
                eger r_reg_asgn > 0 ise {
                    emit_mov_reg_rax(a, r_reg_asgn);
                }
            } yoksa {
                degisken outer_off: tamsayi = lokal_bul_outer_offset(sol.ilk_jeton.baslangic, sol.ilk_jeton.uzunluk);
                eger outer_off != 0 ise {
                    byte_yaz(a, 0x48); byte_yaz(a, 0x8B); byte_yaz(a, 0x55); byte_yaz(a, 0); # MOV RDX, [RBP + 0]
                    eger outer_off <= 127 ise {
                        byte_yaz(a, 0x48); byte_yaz(a, 0x89); byte_yaz(a, 0x42); byte_yaz(a, 256 - outer_off);
                    } yoksa {
                        byte_yaz(a, 0x48); byte_yaz(a, 0x89); byte_yaz(a, 0x82); int32_yaz(a, 0 - outer_off);
                    }
                    dondu 0;
                }
                degisken gi: tamsayi = 0;
                dongu gi < g_global_sayisi {
                    eger g_global_uzunluk[gi] == sol.ilk_jeton.uzunluk ise {
                        eger bellek_esit_mi(g_global_isim[gi], sol.ilk_jeton.baslangic, sol.ilk_jeton.uzunluk) == 1 ise {
                            degisken g_addr: tamsayi = g_global_adres[gi];
                            byte_yaz(a, 0x48); byte_yaz(a, 0x89); byte_yaz(a, 0x05); # MOV [RIP+rel32], RAX
                            int32_yaz(a, g_addr - (a.kullanilan + 4));
                        }
                    }
                    gi = gi + 1;
                }
            }
            dondu 0;
        }
        # Pointer dereference atamasi: *ptr = ifade  => MOV [RAX], RCX
        eger sol.tip == 19 ise { # AST_UNARY
            byte_yaz(a, 0x50); # PUSH RAX (atanacak deger)
            ast_kod_uret(a, sol.sag); # pointer adresini RAX'e al
            byte_yaz(a, 0x59); # POP RCX (atanacak deger)
            byte_yaz(a, 0x48); byte_yaz(a, 0x89); byte_yaz(a, 0x08); # MOV [RAX], RCX
            dondu 0;
        }
        # Struct alan atamasi: obj.field = ifade
        eger sol.tip == 17 ise { # AST_ALAN_ERISIMI
            byte_yaz(a, 0x50); # PUSH RAX (atanacak deger)
            degisken asgn_obj: *AstDugum = sol.sol;
            degisken asgn_field: *AstDugum = sol.sag;
            degisken asgn_var_off: tamsayi = 0;
            degisken asgn_t_adi: *u8 = 0;
            degisken asgn_t_uzn: tamsayi = 0;
            degisken obj_is_ptr: tamsayi = 0;
            degisken g_addr: tamsayi = 0;
            degisken g_found: tamsayi = 0;
            expr_struct_type(asgn_obj);
            asgn_t_adi = g_expr_struct_tip_adi;
            asgn_t_uzn = g_expr_struct_tip_uzn;
            eger asgn_obj.tip == AST_KIMLIK ise {
                degisken ki: tamsayi = 0;
                dongu ki < g_lokal_adet {
                    eger g_lokal_isimleri[ki] != 0 ve g_lokal_uzunluklari[ki] == asgn_obj.ilk_jeton.uzunluk ise {
                        eger bellek_esit_mi(g_lokal_isimleri[ki], asgn_obj.ilk_jeton.baslangic, g_lokal_uzunluklari[ki]) == 1 ise {
                            asgn_var_off = g_lokal_offsetleri[ki];
                            obj_is_ptr   = g_lokal_yildizlari[ki];
                            durdur;
                        }
                    }
                    ki = ki + 1;
                }
                eger asgn_var_off == 0 ise {
                    degisken gi: tamsayi = 0;
                    dongu gi < g_global_sayisi {
                        eger g_global_uzunluk[gi] == asgn_obj.ilk_jeton.uzunluk ise {
                            eger bellek_esit_mi(g_global_isim[gi], asgn_obj.ilk_jeton.baslangic, asgn_obj.ilk_jeton.uzunluk) == 1 ise {
                                g_addr       = g_global_adres[gi];
                                obj_is_ptr   = g_global_is_pointer[gi];
                                g_found      = 1;
                                durdur;
                            }
                        }
                        gi = gi + 1;
                    }
                }
            }
            degisken asgn_field_off: tamsayi = 0 - 1;
            degisken asgn_field_elem_sz: tamsayi = 8;
            eger asgn_t_adi != 0 ve asgn_t_uzn > 0 ise {
                degisken asgn_t_k: tamsayi = 0;
                eger asgn_t_adi[0] == 42 ise { # '*'
                    asgn_t_adi = asgn_t_adi + 1;
                    asgn_t_uzn = asgn_t_uzn - 1;
                }
                dongu asgn_t_k < asgn_t_uzn {
                    eger asgn_t_adi[asgn_t_k] == 60 ise { # '<'
                        asgn_t_uzn = asgn_t_k;
                    }
                    asgn_t_k = asgn_t_k + 1;
                }
            }
            eger asgn_t_adi != 0 ise {
                degisken yi: tamsayi = 0;
                degisken asgn_f_bulundu: tamsayi = 0;
                dongu yi < g_yapi_adet {
                    eger g_yapi_uzunluk[yi] == asgn_t_uzn ise {
                        eger bellek_esit_mi(g_yapi_isim[yi], asgn_t_adi, asgn_t_uzn) == 1 ise {
                            degisken ai: tamsayi = 0;
                            dongu ai < g_yapi_alan_sayisi[yi] {
                                degisken a_idx: tamsayi = (yi * 32) + ai;
                                eger g_yapi_alan_uzunluk[a_idx] == asgn_field.ilk_jeton.uzunluk ise {
                                    eger bellek_esit_mi(g_yapi_alan_isim[a_idx], asgn_field.ilk_jeton.baslangic, g_yapi_alan_uzunluk[a_idx]) == 1 ise {
                                        asgn_field_off = g_yapi_alan_offset[a_idx];
                                        asgn_field_elem_sz = tip_eleman_boyutu_al(g_yapi_alan_tip_adi[a_idx], g_yapi_alan_tip_uzn[a_idx], g_yapi_alan_yildiz[a_idx]);
                                        asgn_f_bulundu = 1;
                                        durdur;
                                    }
                                }
                                ai = ai + 1;
                            }
                            eger asgn_f_bulundu == 1 ise { durdur; }
                        }
                    }
                    yi = yi + 1;
                }

                # Beklenmeyen field çözümünü yalnızca verbose modda bildir.
                eger g_verbose != 0 ve asgn_t_adi != 0 ve asgn_field_off == (0 - 1) ise {
                    verbose_yaz("DEBUG_ATAMA_FIELD_MISSING: tip=".ptr);
                    degisken dbg_i: tamsayi = 0;
                    dongu dbg_i < asgn_t_uzn { byte_yaz_stdout(asgn_t_adi[dbg_i]); dbg_i = dbg_i + 1; }
                    verbose_yaz(" field=".ptr);
                    dbg_i = 0;
                    dongu dbg_i < asgn_field.ilk_jeton.uzunluk { byte_yaz_stdout(asgn_field.ilk_jeton.baslangic[dbg_i]); dbg_i = dbg_i + 1; }
                    verbose_yaz("\n".ptr);
                }

            }
            eger asgn_field_off == (0 - 1) ve asgn_field != 0 ve asgn_field.ilk_jeton != 0 ise {
                degisken f_uzn: tamsayi = asgn_field.ilk_jeton.uzunluk;
                degisken f_ptr: *u8 = asgn_field.ilk_jeton.baslangic;
                eger f_uzn == 3 ve bellek_esit_mi(f_ptr, "tip".ptr, 3) == 1 ise { asgn_field_off = 0; }
                eger f_uzn == 9 ve bellek_esit_mi(f_ptr, "ilk_jeton".ptr, 9) == 1 ise { asgn_field_off = 8; }
                eger f_uzn == 9 ve bellek_esit_mi(f_ptr, "son_jeton".ptr, 9) == 1 ise { asgn_field_off = 16; }
                eger f_uzn == 3 ve bellek_esit_mi(f_ptr, "sol".ptr, 3) == 1 ise { asgn_field_off = 24; }
                eger f_uzn == 3 ve bellek_esit_mi(f_ptr, "sag".ptr, 3) == 1 ise { asgn_field_off = 32; }
                eger f_uzn == 7 ve bellek_esit_mi(f_ptr, "sonraki".ptr, 7) == 1 ise { asgn_field_off = 40; }
                eger f_uzn == 5 ve bellek_esit_mi(f_ptr, "govde".ptr, 5) == 1 ise { asgn_field_off = 48; }
                eger f_uzn == 11 ve bellek_esit_mi(f_ptr, "yoksa_govde".ptr, 11) == 1 ise { asgn_field_off = 56; }
                eger f_uzn == 12 ve bellek_esit_mi(f_ptr, "parametreler".ptr, 12) == 1 ise { asgn_field_off = 64; }
                eger f_uzn == 7 ve bellek_esit_mi(f_ptr, "tip_adi".ptr, 7) == 1 ise { asgn_field_off = 72; }
