                byte_yaz(a, 0x48); byte_yaz(a, 0xC7); byte_yaz(a, 0xC6); int32_yaz(a, CG_DARWIN_O_WRCREAT_TRUNC); # MOV RSI, O_WRONLY|O_CREAT|O_TRUNC
                byte_yaz(a, 0x48); byte_yaz(a, 0xC7); byte_yaz(a, 0xC2); int32_yaz(a, CG_DARWIN_MODE_644);       # MOV RDX, 0644 (rw-r--r--)
                byte_yaz(a, 0x48); byte_yaz(a, 0xC7); byte_yaz(a, 0xC0); int32_yaz(a, CG_DARWIN_SYS_OPEN);      # MOV RAX, BSD SYS_open
                byte_yaz(a, 0x0F); byte_yaz(a, 0x05); # SYSCALL
