    eger uzn == 26 ve bellek_esit_mi(isim, "yukinary_sys_socket_listen".ptr, 26) == 1 ise {
        eger arg_sayisi != 2 ise { dondu 0; }
        windows_iat_cagri(a, 21); byte_yaz(a, 0x48); byte_yaz(a, 0x63); byte_yaz(a, 0xC0); dondu 1;
    }
    eger uzn == 26 ve bellek_esit_mi(isim, "yukinary_sys_socket_accept".ptr, 26) == 1 ise {
        eger arg_sayisi != 1 ise { dondu 0; }
        byte_yaz(a, 0x48); byte_yaz(a, 0x31); byte_yaz(a, 0xD2);
        byte_yaz(a, 0x4D); byte_yaz(a, 0x31); byte_yaz(a, 0xC0);
